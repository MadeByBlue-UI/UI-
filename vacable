                                                        arrowX = -letterWidth * 0.4
                                                        arrowY = standardHeight
                                                        arrowZ = forwardDistance + letterWidth * 0.3
                                                    elseif textIndex == 3 then
                                                        -- > Diagonale droite (alignée)
                                                        arrowX = letterWidth * 0.4
                                                        arrowY = standardHeight
                                                        arrowZ = forwardDistance + letterWidth * 0.3
                                                    else
                                                        -- > Corps EN LIGNE VERTICALE (vers le texte)
                                                        local corpIndex = textIndex - 3
                                                        arrowX = 0  -- Tous centrés
                                                        arrowY = standardHeight
                                                        arrowZ = forwardDistance - (corpIndex - 1) * letterWidth * 0.4  -- Espacés en Z = ligne vers le texte
                                                    end
                                                end
                                                
                                                local localPos = Vector3.new(arrowX, arrowY + textOffsetY, arrowZ)
                                                targetPos = centerPos + (rotCFrame * localPos)
                                                
                                                -- Rotation de la flèche : SEULEMENT rotation Y (horizontale) pour garder la flèche droite
                                                -- On ignore les rotations X et Z pour éviter le penchage
                                                local yRotationOnly = CFrame.Angles(0, math.rad(tornadoRotationY), 0)
                                                targetCF = CFrame.new(targetPos) * yRotationOnly
                                                
                                            else
                                                -- 📝 FORMATION TEXTE (toys restants) - OPTIMISÉ
                                                local adjustedTextIndex = textIndex - arrowToys
                                                local adjustedTotalToys = textTotalToys - arrowToys
                                                
                                                -- Place ce toy sur les segments
                                                local baseDistance = ((adjustedTextIndex - 1) / math.max(1, adjustedTotalToys - 1)) * totalLength
                                                
                                                -- Animation : ajoute un offset basé sur le temps
                                                local targetDistance = baseDistance
                                                if tornadoLetterMovement then
                                                    -- Chaque toy avance le long des lignes avec un offset unique
                                                    local timeOffset = tick() * tornadoLetterSpeed + (i * 0.1)  -- Décalage par toy
                                                    local animOffset = (timeOffset % (totalLength / tornadoLetterSpeed)) * tornadoLetterSpeed
                                                    targetDistance = (baseDistance + animOffset) % totalLength
                                                end
                                                
                                                -- ⚡ OPTIMISATION : Recherche optimisée au lieu de parcourir tous les segments
                                                local currentDistance = 0
                                                local foundSeg = nil
                                                local foundT = 0
                                                
                                                -- Parcourt les segments mais optimise le calcul d'angle
                                                for _, seg in ipairs(allSegments) do
                                                    if currentDistance + seg.length >= targetDistance then
                                                        -- Ce toy est sur ce segment
