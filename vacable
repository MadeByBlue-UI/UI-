    function FX_Stop()
        for _, c in ipairs(FX.Connections) do pcall(function() c:Disconnect() end) end
        FX.Connections = {}
        for _, p in ipairs(FX.Parts) do pcall(function() p:Destroy() end) end
        FX.Parts = {}
    end

    function newPart(parent, size, color, mat, shape)
        local p = Instance.new("Part")
        p.Size         = size or Vector3.new(1,1,1)
        p.Color        = color or Color3.fromRGB(255,255,255)
        p.Material     = mat or Enum.Material.Neon
        p.Shape        = shape or Enum.PartType.Block
        p.Anchored     = true
        p.CanCollide   = false
        p.CanTouch     = false
        p.CanQuery     = false
        p.Massless     = true
        p.CastShadow   = false
        p.Parent       = parent or workspace
        table.insert(FX.Parts, p)
        return p
    end

    -- -----------------------------------------------------------------------
    -- 1. Orbit Rings  arc-en-ciel automatique, taille pulse
    -- -----------------------------------------------------------------------
    function FX_OrbitRings()
        local char = Player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local COUNT = 3
        local rings = {}
        for i = 1, COUNT do
            local r = newPart(char, Vector3.new(7, .18, .18))
            table.insert(rings, { part = r, phase = (i-1)*(math.pi*2/COUNT), tilt = (i-1)*(math.pi/COUNT) })
        end
        local t = 0
        local conn = R2.Heartbeat:Connect(function(dt)
            t = t + dt * 2.5
            local h = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not h then return end
            for _, d in ipairs(rings) do
                local ang   = t + d.phase
                local pulse = 7 + math.sin(t*3 + d.phase) * 1.2
                d.part.Size   = Vector3.new(pulse, .18, .18)
                d.part.Color  = Color3.fromHSV(((t*.07 + d.phase) % (math.pi*2)) / (math.pi*2), 1, 1)
                d.part.CFrame = h.CFrame * CFrame.Angles(d.tilt,0,0) * CFrame.Angles(0,ang,0) * CFrame.new(pulse/2+.5,0,0) * CFrame.Angles(0,math.pi/2,0)
            end
        end)
        table.insert(FX.Connections, conn)
    end

    -- -----------------------------------------------------------------------
    -- 2. Lightning Body
    -- -----------------------------------------------------------------------
    function FX_Lightning()
        local char = Player.Character
        if not char then return end
        for _, name in ipairs({"HumanoidRootPart","Head","Left Arm","Right Arm","Left Leg","Right Leg"}) do
            local part = char:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                local a0 = Instance.new("Attachement"); a0.Position = Vector3.new(0, part.Size.Y/2, 0);  a0.Parent = part
                local a1 = Instance.new("Attachement"); a1.Position = Vector3.new(0,-part.Size.Y/2, 0);  a1.Parent = part
                local bolt = Instance.new("Beam")
                bolt.Attachement0 = a0; bolt.Attachement1 = a1; bolt.FaceCamera = true
                bolt.Width0 = .06; bolt.Width1 = .06; bolt.Segments = 14
                bolt.LightEmission = 1; bolt.LightInfluence = 0
                bolt.TextureLength = 1; bolt.TextureSpeed = 5
                bolt.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0,Color3.fromRGB(120,60,255)), ColorSequenceKeypoint.new(.5,Color3.fromRGB(200,160,255)), ColorSequenceKeypoint.new(1,Color3.fromRGB(120,60,255)) })
                bolt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0,.2), NumberSequenceKeypoint.new(.5,0), NumberSequenceKeypoint.new(1,.2) })
                bolt.Parent = part
                table.insert(FX.Parts, a0); table.insert(FX.Parts, a1); table.insert(FX.Parts, bolt)
                local alive = true
                table.insert(FX.Connections, { Disconnect = function() alive = false end })
                task.spawn(function()
                    while alive and bolt and bolt.Parent do
                        bolt.Segments = math.random(5,20); bolt.Width0 = math.random(3,10)/100; bolt.Width1 = bolt.Width0
                        task.wait(math.random(1,8)/100)
                    end
                end)
            end
        end
    end

