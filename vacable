                cachedParts.rightLeg = tChar2:FindFirstChild("RightUpperLeg") or tChar2:FindFirstChild("Right Leg")
            end
            
            -- 🎯 BodyPosition Predict : Prédiction de mouvement
            local myVelocity = myR.AssemblyLinearVelocity
            local predictedPos = myT.Position + (myVelocity * 0.1)
            local lockPos = predictedPos + Vector3.new(0, kickHeight, 0)
            
            -- Met à jour les movers
            if bp and bp.Parent then
                bp.Position = lockPos
            end
            if bg and bg.Parent then
                bg.CFrame = myR.CFrame
            end
            
            -- Annule la vélocité
            pcall(function()
                cachedParts.hrp.AssemblyLinearVelocity = Vector3.zero
                cachedParts.hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            
            -- 🔒 PlatformStand Lock (SANS Sit pour éviter look assis)
            pcall(function()
                tHum2.PlatformStand = true
            end)
            
            -- Ragdoll continu
            pcall(function()
                Ragdoll:FireServer(tChar2, true)
            end)
            
            -- 🎯 Ownership Head + Torso + HRP espacé (10x/sec)
            frameCounter = frameCounter + 1
            if frameCounter % 6 == 0 then  -- Toutes les 6 frames = 10x/sec
                pcall(function()
                    -- Core parties essentielles
                    SNO:FireServer(cachedParts.hrp, cachedParts.hrp.CFrame)
                    SNO:FireServer(cachedParts.head, cachedParts.head.CFrame)
                    SNO:FireServer(cachedParts.torso, cachedParts.torso.CFrame)
                    DGL:FireServer(cachedParts.hrp)
                end)
            end
            
            -- 🎯 Ownership Membres (TRÈS RÉDUIT: 2x/sec)
            if frameCounter % 30 == 0 then  -- Toutes les 30 frames = 2x/sec
                pcall(function()
                    -- Membres (moins critique, refresh lent)
                    if cachedParts.leftArm and cachedParts.leftArm.Parent then 
                        SNO:FireServer(cachedParts.leftArm, cachedParts.leftArm.CFrame)
                    end
                    if cachedParts.rightArm and cachedParts.rightArm.Parent then 
                        SNO:FireServer(cachedParts.rightArm, cachedParts.rightArm.CFrame)
                    end
                    if cachedParts.leftLeg and cachedParts.leftLeg.Parent then 
                        SNO:FireServer(cachedParts.leftLeg, cachedParts.leftLeg.CFrame)
                    end
                    if cachedParts.rightLeg and cachedParts.rightLeg.Parent then 
                        SNO:FireServer(cachedParts.rightLeg, cachedParts.rightLeg.CFrame)
                    end
                end)
            end
            
            --  🔄 Auto-Respawn Pallet Intelligent (check toutes les 2s)
            if tick() - lastPalletCheck > 2 then
                lastPalletCheck = tick()
                if not palletObj or not palletObj.Parent or not palletObj:FindFirstChild("SoundPart") then
                    palletObj = spawnPallet(myR)
                else
                    -- Check ownership
                    local sp = palletObj.SoundPart
                    local po = sp:FindFirstChild("PartOwner")
                    if not po or po.Value ~= LocalPlayer.Name then
                        -- Ownership perdu, respawn
                        pcall(function() DestroyToy:FireServer(palletObj) end)
                        palletObj = spawnPallet(myR)
                    end
                end
            end
            
            -- Pallet kick loop (1x toutes les 2.5s pour ragdoll quand le joueur se relève)
            palletTimer = palletTimer + dt
            if palletTimer > 2.5 then
                palletTimer = 0
                if palletObj and palletObj:FindFirstChild("SoundPart") then
                    local sp = palletObj.SoundPart
                    pcall(function()
                        sp.CFrame = cachedParts.hrp.CFrame
                        sp.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
                        SNO:FireServer(sp, sp.CFrame)
                    end)
                else
                    palletObj = spawnPallet(myR)
                end
            end
            
            -- ⚠️ PLUS DE TP EN BOUCLE - L'ownership est maintenu par les remotes
        end)
    end
    
