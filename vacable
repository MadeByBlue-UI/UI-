    function refreshWearButtons(id)
        local list = wearBtns[id]
        if not list then return end
        local on = worn[id] ~= nil
        for _, b in ipairs(list) do
            if b.Parent then
                b.Text = on and "Retirer" or "Wear"
                tween(b, 0.2, { BackgroundTransparency = on and 0.7 or 0.15 })
                b.TextColor3 = on and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
            end
