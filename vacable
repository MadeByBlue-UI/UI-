    -- ⌨️ Touches pour les POSES : appuie = la pose s'applique (mode Idle), ré-appuie = retour en Auto
    do
        local _poseKeys, _prevPose = {}, "Aucune"
        for _, pn in ipairs({"Bras croisés", "Mains sur les hanches", "Bras relâchés", "Mains dans le dos", "Mains derrière la tête",
                             "Coucou", "Garde (poings)", "Bras en V (victoire)", "Penseur", "Étirement", "Genou à terre", "Assis en tailleur", "Arbre (yoga)", "Arabesque", "Position du cavalier", "Fente avant", "Titanic (bras écartés)", "Accroupi (guet)", "Agrippé au mur", "Suspendu (une main)", "Conquérant (pied sur rocher)", "Superhéros"}) do
            _poseKeys[pn] = Enum.KeyCode.Unknown
            _animBlend.keyBlock:CreateKeybind({
                Name = "Touche pose : " .. pn,
                Flag = "FigurePoseKey_" .. pn,
                Default = Enum.KeyCode.Unknown,
                Callback = function(k) _poseKeys[pn] = k end
            })
        end
        local function _setPoseMode(pose, mode)
            _G._FigureIdlePose = pose
            figureAnimationMode = mode
            pcall(function() _animBlend.poseDD:Set(pose) end)
            pcall(function() _animBlend.animDD:Set(mode) end)
        end
        _TrackConn(game:GetService("UserInputService").InputBegan:Connect(function(input, gpe)
            if gpe or not animatedFigureActive then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if game:GetService("UserInputService"):GetFocusedTextBox() then return end
            for pn, k in pairs(_poseKeys) do
                if k ~= Enum.KeyCode.Unknown and input.KeyCode == k then
                    if _G._FigureIdlePose == pn and figureAnimationMode == "Idle" then
                        _setPoseMode(_prevPose, "Auto")
                    else
                        if not (figureAnimationMode == "Idle" and _G._FigureIdlePose ~= "Aucune" and _G._FigureIdlePose ~= pn) then
                            _prevPose = _G._FigureIdlePose or "Aucune"
                        end
                        _setPoseMode(pn, "Idle")
                        if _animBlend.oneShot then
                            _animBlend.shotId = _animBlend.shotId + 1
                            local _id = _animBlend.shotId
                            task.delay(_animBlend.shotDur or 4, function()
                                if _animBlend.shotId == _id and _G._FigureIdlePose == pn and figureAnimationMode == "Idle" then
                                    _setPoseMode(_prevPose, "Auto")
                                end
                            end)
                        end
                    end
                    break
                end
            end
        end))
    end
    
