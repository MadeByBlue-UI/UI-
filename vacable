    if not _WallWalkState.enabled then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        _WallWalkState.runtime.pendingDelta += Vector2.new(input.Delta.X, input.Delta.Y)
    elseif input.UserInputType == Enum.UserInputType.MouseWheel then
        _WallWalkState.runtime.camDistance = math.clamp(_WallWalkState.runtime.camDistance - input.Position.Z * _WallWalkState.config.ZOOM_STEP, 0, _WallWalkState.config.MAX_ZOOM)
    end
end))

_TrackConn(UserInputService.JumpRequest:Connect(function()
    if _WallWalkState.enabled and _WallWalkState.runtime.grounded and _WallWalkState.runtime.root and os.clock() > _WallWalkState.runtime.jumpUntil then
        _WallWalkState.runtime.jumpUntil = os.clock() + _WallWalkState.config.JUMP_TIME
        _WallWalkState.runtime.root.AssemblyLinearVelocity += _WallWalkState.runtime.up * _WallWalkState.config.JUMP_POWER
        if _WallWalkState.runtime.jumpTrack then
            if _WallWalkState.runtime.currentTrack and _WallWalkState.runtime.currentTrack ~= _WallWalkState.runtime.jumpTrack then 
                _WallWalkState.runtime.currentTrack:Stop(0.1) 
            end
            _WallWalkState.runtime.currentTrack = _WallWalkState.runtime.jumpTrack
            _WallWalkState.runtime.jumpTrack:Play(0.1)
        end
    end
end))

