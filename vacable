        for sidx, an in ipairs({ "Walk", "Walk v2", "Run", "Run v2", "Dance", "Jump", "Floss", "Floss v2", "Floss v3",
                                 "Jumping Jack", "Jumping Jack v2", "Twerk", "Disco", "Robot", "Dab", "YMCA",
                                 "Moonwalk", "Sprinkler", "Squat", "Applaudir", "Pompes", "Allongé", "Assis chaise", "Révérence", "Boxe", "Salut militaire", "Pointer du doigt", "Facepalm", "Mains jointes (prière)", "Jogging sur place", "Coups de pied", "Tai-chi", "Kazatchok", "Saut de joie", "Escrime", "Coeur", "Grimper corde", "Grimper échelle", "Traversée (bloc)", "Suspendu (barre)", "Tractions", "Rappel", "Funambule", "Zombie", "Gangnam", "Air guitar", "Moulin à bras", "Muscles", "Surf", "Ski", "Sumo" }) do
            SpdBlock:CreateSlider({
