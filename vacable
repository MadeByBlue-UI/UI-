-- STRETCHED RESOLUTION  (Fun)
-- =========================================================================
do
    local FunStretch = Tabs.World:CreateBlock({ Name = "Stretched Resolution", Side = "Left" })

    local stretchEnabled = false
    local stretchConn    = nil
    local stretchIntensity = 0.65  -- < 0.65 = très étiré, 1.0 = normal, > 1 = compress

    local PRESETS = {
        ["Normal (Off)"]  = 1.00,
        ["4:3 Stretched"] = 0.75,
        ["5:4 Stretched"] = 0.80,
        ["Hyper Stretch"] = 0.55,
        ["Ultra Wide"]    = 1.30,
        ["Custom"]        = nil,
    }

    function removeStretch()
        if stretchConn then stretchConn:Disconnect(); stretchConn = nil end
        -- Restore la caméra  la normale
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then cam.FieldOfView = 70 end
        end)
    end

    function applyStretch()
        removeStretch()
        if not stretchEnabled then return end

        -- Technique XOCU : modifier la matrice CFrame de la caméra chaque frame
        -- Le composant [6] contrle le scale vertical du rendu  en le mettant < 1
        -- l'image est squishe verticalement, ce qui simule un ratio 4:3 tir
        stretchConn = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam.CFrame = cam.CFrame * CFrame.new(
                    0, 0, 0,
                    1, 0, 0,
                    0, stretchIntensity, 0,
                    0, 0, 1
                )
            end
        end)

        _TrackConn(stretchConn)
    end

    FunStretch:CreateToggle({
        Name    = "Enable Stretched Res",
        Flag    = "StretchResEnabled",
        Default = false,
        Callback = function(v)
            stretchEnabled = v
            if v then
                applyStretch()
                Library:Notify({ Title = "Stretched Res", Content = "Activ  (intensity: " .. stretchIntensity .. ")", Duration = 3 })
            else
                removeStretch()
                Library:Notify({ Title = "Stretched Res", Content = "Désactivé.", Duration = 2 })
            end
        end
    })

    local presetNames = {}
    for k in pairs(PRESETS) do table.insert(presetNames, k) end
    table.sort(presetNames)

    FunStretch:CreateDropdown({
        Name     = "Preset",
        Flag     = "StretchPreset",
        Items    = presetNames,
        Default  = "Custom",
        Callback = function(v)
            local p = PRESETS[v]
            if p then
                stretchIntensity = p
                if stretchEnabled then applyStretch() end
            end
        end
    })

    -- Slider : 40 = très étiré (0.40), 100 = normal (1.00), 150 = ultra wide (1.50)
    FunStretch:CreateSlider({
        Name    = "Stretch Intensity",
        Flag    = "StretchIntensity",
        Min     = 30,
        Max     = 150,
        Default = 65,
        Callback = function(v)
            stretchIntensity = v / 100
            if stretchEnabled then applyStretch() end
        end
    })

    FunStretch:CreateButton({
        Name     = "Reset to Normal",
        Callback = function()
            stretchEnabled   = false
