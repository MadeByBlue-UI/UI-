-- REMOVE HEAD v2
-- Envoie ta tête TRÈS HAUT dans les airs et la maintient là
-- Évite la mort (RequiresNeck) et garde la caméra sur ton torse
-- Rig R6 requis ("Head", "Torso")
-- =========================================================================
do
    local AUTO_REAPPLY_HEAD = false  -- Contrôlé par le toggle
    local HEAD_HEIGHT = 99999        -- Hauteur de la tête
    local headConn = nil
    local camConn = nil
    local holdConn = nil

    function setRagdoll(char, state)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local events = ReplicatedStorage:FindFirstChild("CharacterEvents")
        local remote = events and events:FindFirstChild("RagdollRemote")
        if hrp and remote then
            remote:FireServer(hrp, state and 1 or 0)
        end
    end

    -- Garde la caméra sur le torse (sinon elle suit la tête)
    function lockCamera(char)
        if camConn then
            camConn:Disconnect()
            camConn = nil
        end

        camConn = RunService.RenderStepped:Connect(function()
            local cam = workspace.CurrentCamera
            local torso = char:FindFirstChild("Torso")
            if not char.Parent or not torso or not cam then
                if camConn then
                    camConn:Disconnect()
                    camConn = nil
                end
                return
            end
            if cam.CameraSubject ~= torso then
                cam.CameraSubject = torso
            end
        end)
        _TrackConn(camConn)
    end

    -- Maintient la tête en haut (sinon la gravité la fait retomber)
    function holdHead(char, head, pos)
        if holdConn then
            holdConn:Disconnect()
            holdConn = nil
        end

        local target = CFrame.new(pos)
        holdConn = RunService.Heartbeat:Connect(function()
            if not head.Parent or not char.Parent then
                if holdConn then
                    holdConn:Disconnect()
                    holdConn = nil
                end
                return
            end
            head.CFrame = target
            head.AssemblyLinearVelocity = Vector3.zero
            head.AssemblyAngularVelocity = Vector3.zero
        end)
        _TrackConn(holdConn)
    end

    function removeHead()
        local char = LocalPlayer.Character
        if not char then return end

        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if not head or not hum or not hrp then
            notify("Remove Head", "❌ 'Head', Humanoid ou HRP introuvable (R6 requis)", 3)
            return
        end

        -- Évite la mort quand le cou est coupé
        hum.RequiresNeck = false

        setRagdoll(char, true)
        task.wait(0.3)

        -- Position de la tête basée sur la hauteur du slider
        local pos = Vector3.new(hrp.Position.X, HEAD_HEIGHT, hrp.Position.Z)
        head.CFrame = CFrame.new(pos)

        task.wait(0.1)

        local torso = char:FindFirstChild("Torso")
        local grab = ReplicatedStorage:FindFirstChild("GrabEvents")
        local setOwner = grab and grab:FindFirstChild("SetNetworkOwner")
        if torso and setOwner then
            setOwner:FireServer(torso, torso.CFrame)
        end

        -- Maintient la tête à la hauteur configurée
        holdHead(char, head, pos)
        lockCamera(char)

        notify("Remove Head", "✅ Tête maintenue à Y=" .. HEAD_HEIGHT, 2)
    end

    DefenseExtra:CreateToggle({
        Name     = "Remove Head",
        Flag     = "RemoveHeadToggle",
        Default  = false,
        Callback = function(v)
            AUTO_REAPPLY_HEAD = v

            -- Déconnecte les anciennes connexions
            if headConn then
                headConn:Disconnect()
                headConn = nil
            end
            if camConn then
                camConn:Disconnect()
                camConn = nil
            end
            if holdConn then
                holdConn:Disconnect()
                holdConn = nil
            end

            if v then
                -- Exécution immédiate
                task.spawn(removeHead)

                -- Ré-applique au respawn
                headConn = LocalPlayer.CharacterAdded:Connect(function(char)
                    char:WaitForChild("Humanoid")
                    char:WaitForChild("Head")
                    task.wait(1)
                    if AUTO_REAPPLY_HEAD then
                        removeHead()
                    end
                end)
                _TrackConn(headConn)
            else
                -- Restore la caméra normale
                local cam = workspace.CurrentCamera
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if cam and hum then
                    cam.CameraSubject = hum
                end
                notify("Remove Head", "Désactivé (respawn pour récupérer la tête)", 2)
            end
        end
    })

    -- Slider pour ajuster la hauteur
    DefenseExtra:CreateSlider({
        Name     = "Hauteur Tête",
        Flag     = "HeadHeightSlider",
        Min      = -999999,
        Max      = 999999,
        Default  = 99999,
        Callback = function(v)
            HEAD_HEIGHT = v
            
            -- Si le toggle est actif, met à jour la position en temps réel
            if AUTO_REAPPLY_HEAD then
                local char = LocalPlayer.Character
                local head = char and char:FindFirstChild("Head")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if head and hrp then
                    local pos = Vector3.new(hrp.Position.X, HEAD_HEIGHT, hrp.Position.Z)
                    holdHead(char, head, pos)
                    notify("Remove Head", "Hauteur mise à jour : Y=" .. HEAD_HEIGHT, 1)
                end
            end
        end
    })
end

