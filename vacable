-- Line Lag : spam CreateGrabLine sur les joueurs ou la map (méthode Gros script)
do
    local _LL_Active   = false
    local _LL_GPS      = 60   -- grabs par seconde
    local _LL_Conns    = {}
    local _EvCreateLine = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
        and game:GetService("ReplicatedStorage").GrabEvents:FindFirstChild("CreateGrabLine")

    function stopLineLag()
        _LL_Active = false
        for _, c in ipairs(_LL_Conns) do c:Disconnect() end
        _LL_Conns = {}
    end

    function startLineLag(mode)
        if not _EvCreateLine then
            notify("Line Lag", "CreateGrabLine introuvable.", 3); return
        end
        _LL_Active = true
        local conn
        conn = game:GetService("RunService").Heartbeat:Connect(function()
            if not _LL_Active then conn:Disconnect(); return end
            if mode == "Players" then
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    local c = p.Character
                    local t = c and (c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso"))
