            hub.BackgroundColor3 = Color3.new(0, 0, 0)
            hub.BackgroundTransparency = 0.05
            hub.BorderSizePixel = 0
            hub.Parent = root
            Instance.new("UICorner", hub).CornerRadius = UDim.new(1, 0)
            local hs = Instance.new("UIStroke", hub); hs.Color = Color3.new(1, 1, 1); hs.Thickness = 1.5; hs.Transparency = 0.55

            -- rayon brillant vers l'emote visée
            local ray = Instance.new("Frame")
            ray.AnchorPoint = Vector2.new(0, 0.5)
            ray.Size = UDim2.fromOffset(0, 3)
            ray.BackgroundColor3 = Color3.new(1, 1, 1)
            ray.BorderSizePixel = 0
            ray.Visible = false
            ray.Parent = root
            Instance.new("UICorner", ray).CornerRadius = UDim.new(1, 0)
            local rg = Instance.new("UIGradient", ray)
            rg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.7, 0.35), NumberSequenceKeypoint.new(1, 0) })
            local rayGlow = Instance.new("UIStroke", ray); rayGlow.Color = Color3.new(1, 1, 1); rayGlow.Thickness = 3; rayGlow.Transparency = 0.8

            -- halo derrière l'emote visée
            local glow = Instance.new("Frame")
            glow.AnchorPoint = Vector2.new(0.5, 0.5)
            glow.Size = UDim2.fromOffset(116, 62)
            glow.BackgroundColor3 = Color3.new(1, 1, 1)
            glow.BackgroundTransparency = 0.85
            glow.BorderSizePixel = 0
            glow.Visible = false
            glow.Parent = root
            Instance.new("UICorner", glow).CornerRadius = UDim.new(0, 22)
            local gs = Instance.new("UIStroke", glow); gs.Color = Color3.new(1, 1, 1); gs.Thickness = 2; gs.Transparency = 0.6

            local center = Instance.new("TextLabel")
            center.AnchorPoint = Vector2.new(0.5, 0.5)
            center.Position = UDim2.fromOffset(0, -8)
            center.Size = UDim2.fromOffset(130, 60)
            center.BackgroundTransparency = 1
            center.TextColor3 = Color3.new(1, 1, 1)
            center.Font = Enum.Font.GothamBold
            center.TextSize = 17
            center.TextWrapped = true
            center.Parent = root
            local sub = Instance.new("TextLabel")
            sub.AnchorPoint = Vector2.new(0.5, 0.5)
            sub.Position = UDim2.fromOffset(0, 34)
            sub.Size = UDim2.fromOffset(130, 30)
            sub.BackgroundTransparency = 1
            sub.TextColor3 = Color3.fromRGB(190, 190, 190)
