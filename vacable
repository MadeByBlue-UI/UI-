-- =========================================================================
-- WALLWALK SYSTEM
-- =========================================================================
function _WallWalkProject(v, normal)
    return v - normal * v:Dot(normal)
end

function _WallWalkGetInput()
    local function key(k)
        return UserInputService:IsKeyDown(k) and 1 or 0
    end
    local x = key(Enum.KeyCode.D) - key(Enum.KeyCode.A)
    local z = key(Enum.KeyCode.W) - key(Enum.KeyCode.S)
    return x, z
end

function _WallWalkCameraBasis()
    local look = _WallWalkProject(_WallWalkState.runtime.camLook, _WallWalkState.runtime.up)
    if look.Magnitude < 0.05 then
        look = _WallWalkProject(_WallWalkState.runtime.facing, _WallWalkState.runtime.up)
    end
    look = look.Unit
    return look, look:Cross(_WallWalkState.runtime.up)
end

function _WallWalkSetCharacterHidden(hide)
    _WallWalkState.runtime.charHidden = hide
    if not (LocalPlayer.Character) then return end
    for _, d in LocalPlayer.Character:GetDescendants() do
        if d:IsA("BasePart") then
            d.LocalTransparencyModifier = hide and 1 or 0
        end
    end
end

function _WallWalkPlayTrack(track)
    if not track or _WallWalkState.runtime.currentTrack == track then return end
    if _WallWalkState.runtime.currentTrack then _WallWalkState.runtime.currentTrack:Stop(0.15) end
    _WallWalkState.runtime.currentTrack = track
    track:Play(0.15)
end

function _WallWalkUpdateCamera()
    if not (_WallWalkState.enabled and _WallWalkState.runtime.root and _WallWalkState.runtime.root.Parent) then return end

    local d = _WallWalkState.runtime.pendingDelta
    _WallWalkState.runtime.pendingDelta = Vector2.zero
    
    local cfg = _WallWalkState.config
    local camera = workspace.CurrentCamera
    local up = _WallWalkState.runtime.up

    _WallWalkState.runtime.camLook = CFrame.fromAxisAngle(up, -d.X * cfg.MOUSE_SENS):VectorToWorldSpace(_WallWalkState.runtime.camLook)
    local flat = _WallWalkProject(_WallWalkState.runtime.camLook, up)
    if flat.Magnitude < 0.01 then flat = _WallWalkProject(_WallWalkState.runtime.facing, up) end
    flat = flat.Unit
    local elev = math.asin(math.clamp(_WallWalkState.runtime.camLook:Dot(up), -1, 1))
    elev = math.clamp(elev - d.Y * cfg.MOUSE_SENS, -1.4, 1.4)
    _WallWalkState.runtime.camLook = flat * math.cos(elev) + up * math.sin(elev)

    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    UserInputService.MouseIconEnabled = false

    local root = _WallWalkState.runtime.root
    local focus = root.Position + up * cfg.HEAD_OFFSET
    local firstPerson = _WallWalkState.runtime.camDistance < 1

    if firstPerson then
        camera.CFrame = CFrame.lookAt(focus, focus + _WallWalkState.runtime.camLook, up)
    else
        local desired = focus - _WallWalkState.runtime.camLook * _WallWalkState.runtime.camDistance
        local params = _WallWalkState.runtime.raycastParams
        local hit = Workspace:Raycast(focus, desired - focus, params)
        local pos = hit and (hit.Position + hit.Normal * 0.3) or desired
        if (pos - focus).Magnitude < 0.1 then
            camera.CFrame = CFrame.lookAt(focus, focus + _WallWalkState.runtime.camLook, up)
        else
            camera.CFrame = CFrame.lookAt(pos, focus, up)
        end
    end

    if firstPerson ~= _WallWalkState.runtime.charHidden then
        _WallWalkSetCharacterHidden(firstPerson)
    end
end

function _WallWalkStartTransition(newUp, pivot, endPos)
    local up = _WallWalkState.runtime.up
    local axis = up:Cross(newUp)
    local angle = 0
    if axis.Magnitude > 1e-4 then
        axis = axis.Unit
        angle = math.acos(math.clamp(up:Dot(newUp), -1, 1))
    else
        axis = Vector3.yAxis
    end
    local startPos = _WallWalkState.runtime.root.Position
    local full = CFrame.fromAxisAngle(axis, angle)
    _WallWalkState.runtime.trans = {
        t = 0,
        alpha = 0,
        axis = axis,
        angle = angle,
        pivot = pivot,
        startPos = startPos,
        fromUp = up,
        fromFacing = _WallWalkState.runtime.facing,
        newUp = newUp,
        fullOffset = endPos - (pivot + full:VectorToWorldSpace(startPos - pivot)),
    }
end

function _WallWalkAdvanceTransition(dt)
    local tr = _WallWalkState.runtime.trans
    local cfg = _WallWalkState.config
    tr.t += dt
    local k = math.clamp(tr.t / cfg.TRANSITION_TIME, 0, 1)
    local alpha = k * k * (3 - 2 * k)

    local rot = CFrame.fromAxisAngle(tr.axis, tr.angle * alpha)
    local dRot = CFrame.fromAxisAngle(tr.axis, tr.angle * (alpha - tr.alpha))
    tr.alpha = alpha

    _WallWalkState.runtime.camLook = dRot:VectorToWorldSpace(_WallWalkState.runtime.camLook)

    local newUp = (k >= 1) and tr.newUp or rot:VectorToWorldSpace(tr.fromUp)
    _WallWalkState.runtime.up = newUp

    local pos = tr.pivot + rot:VectorToWorldSpace(tr.startPos - tr.pivot) + tr.fullOffset * alpha

    local f = _WallWalkProject(rot:VectorToWorldSpace(tr.fromFacing), newUp)
    if f.Magnitude < 0.05 then f = _WallWalkProject(_WallWalkState.runtime.camLook, newUp) end
    if f.Magnitude < 0.05 then
        local alt = math.abs(newUp.Y) < 0.9 and Vector3.yAxis or Vector3.xAxis
        f = _WallWalkProject(alt, newUp)
    end
    f = f.Unit
    _WallWalkState.runtime.facing = f

    local root = _WallWalkState.runtime.root
    local cf = CFrame.fromMatrix(pos, f:Cross(newUp), newUp, -f)
    root.CFrame = cf
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    _WallWalkState.runtime.aligner.CFrame = cf.Rotation
    _WallWalkState.runtime.gravityForce.Force = root.AssemblyMass * Workspace.Gravity * (Vector3.yAxis - newUp)
    _WallWalkState.runtime.airTime = 0

    if k >= 1 then _WallWalkState.runtime.trans = nil end
end

function _WallWalkStep(dt)
    if not (_WallWalkState.runtime.root and _WallWalkState.runtime.root.Parent and _WallWalkState.runtime.humanoid and _WallWalkState.runtime.humanoid.Health > 0) then return end

    if _WallWalkState.runtime.trans then
        _WallWalkAdvanceTransition(dt)
        return
    end

    local cfg = _WallWalkState.config
    local pos = _WallWalkState.runtime.root.Position
    local x, z = _WallWalkGetInput()
    local look, right = _WallWalkCameraBasis()
    local up = _WallWalkState.runtime.up

    local moveDir = look * z + right * x
    local moving = moveDir.Magnitude > 0
    if moving then
        moveDir = moveDir.Unit
    end

    if _WallWalkState.runtime.camDistance < 1 then
        _WallWalkState.runtime.facing = look
    elseif moving then
        _WallWalkState.runtime.facing = moveDir
    end

    local params = _WallWalkState.runtime.raycastParams
    local range = _WallWalkState.runtime.hoverDist + cfg.FORWARD_MARGIN
    local fwdHit = moving and Workspace:Raycast(pos, moveDir * range, params) or nil
    local downHit = Workspace:Raycast(pos, -up * cfg.RAY_DOWN, params)
    local edgeHit = nil
    if moving and not fwdHit and not downHit and os.clock() > _WallWalkState.runtime.jumpUntil then
        local origin = pos + moveDir * range - up * (_WallWalkState.runtime.hoverDist + 0.7)
        edgeHit = Workspace:Raycast(origin, -moveDir * range * 1.5, params)
    end

    if fwdHit and fwdHit.Normal:Dot(up) < cfg.SNAP_DOT then
        _WallWalkStartTransition(fwdHit.Normal, pos, fwdHit.Position + fwdHit.Normal * _WallWalkState.runtime.hoverDist)
        _WallWalkAdvanceTransition(dt)
        return
    elseif edgeHit and edgeHit.Normal:Dot(up) < cfg.SNAP_DOT then
        local edgePoint = edgeHit.Position + up * 0.7
        _WallWalkStartTransition(edgeHit.Normal, edgePoint, edgePoint + edgeHit.Normal * _WallWalkState.runtime.hoverDist)
        _WallWalkAdvanceTransition(dt)
        return
    end

    local targetUp = up
    if fwdHit then targetUp = fwdHit.Normal
    elseif downHit then targetUp = downHit.Normal
    elseif edgeHit then targetUp = edgeHit.Normal end

    _WallWalkState.runtime.grounded = downHit ~= nil

    if fwdHit or downHit or edgeHit then
        _WallWalkState.runtime.airTime = 0
    else
        _WallWalkState.runtime.airTime += dt
        if _WallWalkState.runtime.airTime > cfg.AIR_RESET then targetUp = Vector3.yAxis end
    end

    local prevUp = up
    up = up:Lerp(targetUp, 1 - math.exp(-cfg.TURN_SPEED * dt)).Unit
    _WallWalkState.runtime.up = up

    local axis = prevUp:Cross(up)
    if axis.Magnitude > 1e-5 then
        local angle = math.acos(math.clamp(prevUp:Dot(up), -1, 1))
        _WallWalkState.runtime.camLook = CFrame.fromAxisAngle(axis.Unit, angle):VectorToWorldSpace(_WallWalkState.runtime.camLook)
    end

    local f = _WallWalkProject(_WallWalkState.runtime.facing, up)
    if f.Magnitude < 0.05 then f = _WallWalkProject(look, up) end
    f = f.Unit
    _WallWalkState.runtime.facing = f
    _WallWalkState.runtime.aligner.CFrame = CFrame.fromMatrix(Vector3.zero, f:Cross(up), up, -f)

    _WallWalkState.runtime.gravityForce.Force = _WallWalkState.runtime.root.AssemblyMass * Workspace.Gravity * (Vector3.yAxis - up)

    if _WallWalkState.runtime.grounded and os.clock() > _WallWalkState.runtime.jumpUntil then
        if moving then
            _WallWalkPlayTrack(_WallWalkState.runtime.walkTrack)
            if _WallWalkState.runtime.walkTrack then _WallWalkState.runtime.walkTrack:AdjustSpeed(cfg.WALK_SPEED / 16) end
        else
            _WallWalkPlayTrack(_WallWalkState.runtime.idleTrack)
        end
    elseif not _WallWalkState.runtime.grounded then
        local jumping = _WallWalkState.runtime.jumpTrack and _WallWalkState.runtime.currentTrack == _WallWalkState.runtime.jumpTrack and _WallWalkState.runtime.jumpTrack.IsPlaying
        if not jumping then
            _WallWalkPlayTrack(_WallWalkState.runtime.fallTrack or _WallWalkState.runtime.idleTrack)
        end
    end

    local vel = _WallWalkState.runtime.root.AssemblyLinearVelocity
    if downHit then
        local vertical = up * vel:Dot(up)
        if os.clock() > _WallWalkState.runtime.jumpUntil then
            local diff = _WallWalkState.runtime.hoverDist - downHit.Distance
            vertical = up * math.clamp(diff * 10, -12, 12)
        end
        vel = moveDir * cfg.WALK_SPEED + vertical
    else
        vel = vel + moveDir * 40 * dt
    end
    if vel.Magnitude > 80 then
        vel = vel.Unit * 80
    end
    _WallWalkState.runtime.root.AssemblyLinearVelocity = vel
end

function _WallWalkDisable()
    _WallWalkState.enabled = false
    _WallWalkState.runtime.trans = nil
    if _WallWalkState.runtime.stepConn then 
        _WallWalkState.runtime.stepConn:Disconnect() 
        _WallWalkState.runtime.stepConn = nil 
    end
    if _WallWalkState.runtime.diedConn then 
        _WallWalkState.runtime.diedConn:Disconnect() 
        _WallWalkState.runtime.diedConn = nil 
    end
    RunService:UnbindFromRenderStep("WallWalkCamera")
    if _WallWalkState.runtime.attachment then 
        _WallWalkState.runtime.attachment:Destroy() 
        _WallWalkState.runtime.attachment = nil 
    end
    if _WallWalkState.runtime.gravityForce then 
        _WallWalkState.runtime.gravityForce:Destroy() 
        _WallWalkState.runtime.gravityForce = nil 
    end
    if _WallWalkState.runtime.aligner then 
        _WallWalkState.runtime.aligner:Destroy() 
        _WallWalkState.runtime.aligner = nil 
    end

    if _WallWalkState.runtime.walkTrack then _WallWalkState.runtime.walkTrack:Stop(0) _WallWalkState.runtime.walkTrack = nil end
    if _WallWalkState.runtime.idleTrack then _WallWalkState.runtime.idleTrack:Stop(0) _WallWalkState.runtime.idleTrack = nil end
    if _WallWalkState.runtime.jumpTrack then _WallWalkState.runtime.jumpTrack:Stop(0) _WallWalkState.runtime.jumpTrack = nil end
    if _WallWalkState.runtime.fallTrack then _WallWalkState.runtime.fallTrack:Stop(0) _WallWalkState.runtime.fallTrack = nil end
    _WallWalkState.runtime.currentTrack = nil
    if _WallWalkState.runtime.animate and _WallWalkState.runtime.animate.Parent then 
        _WallWalkState.runtime.animate.Enabled = true 
    end
    _WallWalkState.runtime.animate = nil

    _WallWalkSetCharacterHidden(false)
    workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true

    local humanoid = _WallWalkState.runtime.humanoid
    local root = _WallWalkState.runtime.root
    if humanoid and humanoid.Parent then
        humanoid.PlatformStand = false
        if humanoid.Health > 0 then
            if root and root.Parent then
                local flat = Vector3.new(_WallWalkState.runtime.facing.X, 0, _WallWalkState.runtime.facing.Z)
                if flat.Magnitude < 0.05 then flat = Vector3.zAxis end
                root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
            end
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

function _WallWalkEnable()
    local character = LocalPlayer.Character
    _WallWalkState.runtime.humanoid = character and character:FindFirstChildOfClass("Humanoid")
    _WallWalkState.runtime.root = character and character:FindFirstChild("HumanoidRootPart")
    if not (_WallWalkState.runtime.humanoid and _WallWalkState.runtime.root) then return end

    _WallWalkState.enabled = true
    _WallWalkState.runtime.raycastParams.FilterDescendantsInstances = { character }
    _WallWalkState.runtime.up = Vector3.yAxis
    _WallWalkState.runtime.facing = _WallWalkProject(_WallWalkState.runtime.root.CFrame.LookVector, Vector3.yAxis)
    _WallWalkState.runtime.airTime = 0
    _WallWalkState.runtime.jumpUntil = 0
    _WallWalkState.runtime.trans = nil

    local h = Workspace:Raycast(_WallWalkState.runtime.root.Position, Vector3.new(0, -10, 0), _WallWalkState.runtime.raycastParams)
    _WallWalkState.runtime.hoverDist = h and h.Distance or (_WallWalkState.runtime.humanoid.HipHeight + _WallWalkState.runtime.root.Size.Y / 2)

    _WallWalkState.runtime.attachment = Instance.new("Attachment")
    _WallWalkState.runtime.attachment.Parent = _WallWalkState.runtime.root

    _WallWalkState.runtime.gravityForce = Instance.new("VectorForce")
    _WallWalkState.runtime.gravityForce.Attachment0 = _WallWalkState.runtime.attachment
    _WallWalkState.runtime.gravityForce.RelativeTo = Enum.ActuatorRelativeTo.World
    _WallWalkState.runtime.gravityForce.ApplyAtCenterOfMass = true
    _WallWalkState.runtime.gravityForce.Parent = _WallWalkState.runtime.root

    _WallWalkState.runtime.aligner = Instance.new("AlignOrientation")
    _WallWalkState.runtime.aligner.Mode = Enum.OrientationAlignmentMode.OneAttachment
    _WallWalkState.runtime.aligner.Attachment0 = _WallWalkState.runtime.attachment
    _WallWalkState.runtime.aligner.RigidityEnabled = false
    _WallWalkState.runtime.aligner.MaxTorque = math.huge
    _WallWalkState.runtime.aligner.Responsiveness = 40
    _WallWalkState.runtime.aligner.CFrame = _WallWalkState.runtime.root.CFrame.Rotation
    _WallWalkState.runtime.aligner.Parent = _WallWalkState.runtime.root

    _WallWalkState.runtime.humanoid.PlatformStand = true

    _WallWalkState.runtime.animate = character:FindFirstChild("Animate")
    local animator = _WallWalkState.runtime.humanoid:FindFirstChildOfClass("Animator")
    _WallWalkState.runtime.walkTrack, _WallWalkState.runtime.idleTrack, _WallWalkState.runtime.jumpTrack, _WallWalkState.runtime.fallTrack, _WallWalkState.runtime.currentTrack = nil, nil, nil, nil, nil
    if _WallWalkState.runtime.animate and animator then
        _WallWalkState.runtime.animate.Enabled = false
        for _, t in animator:GetPlayingAnimationTracks() do t:Stop(0) end
        function load(folderName, animName)
            local folder = _WallWalkState.runtime.animate:FindFirstChild(folderName)
            local anim = folder and folder:FindFirstChild(animName)
            return anim and animator:LoadAnimation(anim) or nil
        end
        _WallWalkState.runtime.walkTrack = load("walk", "WalkAnim")
        _WallWalkState.runtime.idleTrack = load("idle", "Animation1")
        _WallWalkState.runtime.jumpTrack = load("jump", "JumpAnim")
        _WallWalkState.runtime.fallTrack = load("fall", "FallAnim")
    end

    local camera = workspace.CurrentCamera
    _WallWalkState.runtime.camLook = camera.CFrame.LookVector
    local focus = _WallWalkState.runtime.root.Position + Vector3.yAxis * _WallWalkState.config.HEAD_OFFSET
    _WallWalkState.runtime.camDistance = math.clamp((camera.CFrame.Position - focus).Magnitude, 0, _WallWalkState.config.MAX_ZOOM)
    _WallWalkState.runtime.pendingDelta = Vector2.zero
    camera.CameraType = Enum.CameraType.Scriptable
    RunService:BindToRenderStep("WallWalkCamera", Enum.RenderPriority.Camera.Value + 1, _WallWalkUpdateCamera)

    _WallWalkState.runtime.diedConn = _WallWalkState.runtime.humanoid.Died:Connect(function()
        if _WallWalkState.enabled then _WallWalkDisable() end
    end)
    _WallWalkState.runtime.stepConn = RunService.Heartbeat:Connect(_WallWalkStep)
end

