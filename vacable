                                                        local row1Index = textIndex - 1  -- 1, 2, 3
                                                        arrowX = (row1Index - 2) * letterWidth * 0.35  -- Spacing amélioré
                                                        arrowY = standardHeight
                                                        arrowZ = forwardDistance + letterWidth * 1
