    -- 🏠 FONCTION TELEPORT VERS PLOT (basée sur Auto Plot script)
    function teleportToMyPlot()
        local char = Player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if not root then
            notify("Auto TP House", "❌ Personnage non trouvé", 2)
            return false
        end
        
        -- Trouve ton plot d'abord
        local plots = workspace:FindFirstChild("Plots")
        if not plots then
            notify("Auto TP House", "❌ Plots non trouvés", 2)
            return false
        end
        
        -- Cherche dans tous les plots (1 à 5)
        for i = 1, 5 do
            local plot = plots:FindFirstChild("Plot" .. i)
            if plot then
                local sign = plot:FindFirstChild("PlotSign")
                local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                
                if owners then
                    for _, ownerValue in ipairs(owners:GetChildren()) do
                        if ownerValue.Value == Player.Name then
                            -- Plot trouvé ! Utilise la méthode du script Auto Plot
                            local teleportPos
                            
                            -- Positions fixes fiables pour chaque plot (comme Auto Plot)
                            local plotPositions = {
                                [1] = Vector3.new(-200, 10, -200),  -- Plot1 (estimé)
                                [2] = Vector3.new(0, 10, -200),     -- Plot2 (estimé)
                                [3] = Vector3.new(200, 10, -200),   -- Plot3 (estimé)
                                [4] = Vector3.new(-100, 10, 0),     -- Plot4 (estimé)
                                [5] = Vector3.new(100, 10, 0),      -- Plot5 (estimé)
                            }
                            
                            -- Si on a une position fixe pour ce plot, l'utilise
                            teleportPos = plotPositions[i]
                            
                            -- Sinon, essaye de détecter automatiquement
                            if not teleportPos then
                                local plotArea = plot:FindFirstChild("PlotArea")
                                if plotArea then
                                    teleportPos = plotArea.Position + Vector3.new(0, 5, 0)
                                else
                                    teleportPos = Vector3.new(0, 10, 0) -- Fallback
                                end
                            end
                            
                            -- Téléportation comme Auto Plot (simple et direct)
                            pcall(function()
                                root.CFrame = CFrame.new(teleportPos)
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                            end)
                            
                            notify("Auto TP House", "✅ TP vers Plot" .. i .. " (" .. tostring(teleportPos) .. ")", 3)
                            return true
                        end
                    end
                end
            end
        end
        
        notify("Auto TP House", "❌ Aucun plot trouvé pour " .. Player.Name, 3)
        return false
    end
    
