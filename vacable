    -- Fonction fireproximityprompt (copiée de RealBlitz)
    function fireproximityprompt(proximityPrompt)
        if proximityPrompt.Name ~= 'ProximityPrompt' then
            return false
        end
        
        local originalHoldDuration = proximityPrompt.HoldDuration
        local originalMaxDistance = proximityPrompt.MaxActivationDistance
        
        proximityPrompt.MaxActivationDistance = math.huge
        proximityPrompt.HoldDuration = 0
        
        proximityPrompt:InputHoldBegin()
        proximityPrompt:InputHoldEnd()
        
        proximityPrompt.HoldDuration = originalHoldDuration
        proximityPrompt.MaxActivationDistance = originalMaxDistance
        
        return true
    end
    
    -- Fonction TeleportPlayer (copiée de RealBlitz)
    function TeleportPlayer(targetCFrame, priority)
        priority = priority or 0
        local playerCharacter = LocalPlayer.Character
        if playerCharacter and playerCharacter:FindFirstChild('HumanoidRootPart') then
            playerCharacter.HumanoidRootPart.CFrame = targetCFrame
        end
    end
    
    -- Fonction SpawnToy (basée sur RealBlitz)
    function SpawnToy(toyData)
        pcall(function()
            SpawnToyRF:InvokeServer(unpack(toyData))
        end)
    end
    
    -- Trouve ou spawn un blobman
    function ensureBlobman()
        -- Cherche d'abord dans le dossier du joueur (comme Xocu)
        local playerFolder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if playerFolder then
            local existingBlob = playerFolder:FindFirstChild("CreatureBlobman")
            if existingBlob and existingBlob:FindFirstChild('VehicleSeat') then
                blobmanToy = existingBlob
                notify("Blobman Auto", "📍 Blobman du dossier trouvé", 1)
                return blobmanToy
            end
        end
        
        -- Cherche dans workspace général
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == 'CreatureBlobman' and obj:FindFirstChild('VehicleSeat') then
                local vehicleSeat = obj:FindFirstChild('VehicleSeat')
                if vehicleSeat and not vehicleSeat.Occupant then -- Vérifie qu'il n'est pas occupé
                    blobmanToy = obj
                    notify("Blobman Auto", "📍 Blobman libre trouvé", 1)
                    return blobmanToy
                end
            end
        end
        
        -- Spawn un nouveau blobman
        notify("Blobman Auto", "🏭 Spawn d'un nouveau blobman...", 2)
        
        local playerPos = LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.new(0, 5, 0)
        local spawnData = {
            'CreatureBlobman',
            CFrame.new(playerPos + Vector3.new(0, 5, 0)),
            Vector3.new(0, 97.69000244140625, 0)
        }
        
        SpawnToy(spawnData)
        BuyToy:InvokeServer('CreatureBlobman')
        
        -- Attend que le blobman apparaisse dans le dossier du joueur
        for attempt = 1, 25 do
            task.wait(0.2)
            local folder = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            if folder then
                local newBlob = folder:FindFirstChild("CreatureBlobman")
                if newBlob and newBlob:FindFirstChild('VehicleSeat') then
                    blobmanToy = newBlob
                    notify("Blobman Auto", "✅ Nouveau blobman spawné!", 2)
                    return blobmanToy
                end
            end
        end
        
        notify("Blobman Auto", "❌ Timeout: blobman non spawné", 3)
        return nil
    end
    
    -- S'asseoir sur le blobman (méthode mixte inspirée de Bloody + Gros script)
    function sitOnBlobman(blobman)
        if not blobman or not blobman.Parent then return false end
        
        local vehicleSeat = blobman:FindFirstChild('VehicleSeat')
        if not vehicleSeat then return false end
        
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
        if not humanoid then return false end
        
        -- Vérifie que le joueur n'est pas mort
        if humanoid:GetState() == Enum.HumanoidStateType.Dead or humanoid.Health <= 0 then
            return false
        end
        
        -- Méthode Bloody/Gros script : assise directe
        vehicleSeat:Sit(humanoid)
        task.wait(0.3)
        
        -- Vérification
        if humanoid.Sit and humanoid.SeatPart and tostring(humanoid.SeatPart.Parent) == 'CreatureBlobman' then
            notify("Blobman Auto", "✅ Assis sur le blobman!", 2)
            return true
        end
        
        notify("Blobman Auto", "⚠️ Échec de l'assise", 3)
        return false
    end
    
    -- Téléporte le blobman sur un joueur
    function teleportBlobmanToPlayer(playerName)
        local targetPlayer = Players:FindFirstChild(playerName)
        if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild('HumanoidRootPart') then
            notify("Blobman Auto", "❌ Joueur " .. playerName .. " introuvable", 3)
            return false
        end
        
        if not blobmanToy or not blobmanToy.Parent then
            notify("Blobman Auto", "❌ Aucun blobman disponible", 3)
            return false
        end
        
        local targetPos = targetPlayer.Character.HumanoidRootPart.Position
        local blobmanSeat = blobmanToy:FindFirstChild('VehicleSeat')
        
        if blobmanSeat then
            -- Téléporte le blobman près du joueur
            blobmanSeat.CFrame = CFrame.new(targetPos + Vector3.new(5, 0, 0))
            task.wait(0.2)
            
            notify("Blobman Auto", "📍 Blobman téléporté sur " .. targetPlayer.DisplayName, 2)
            return true
        end
        
        return false
    end
    
    -- Relâche le joueur du blobman et supprime le blobman
    function releasePlayerAndCleanup(playerName)
        local targetPlayer = Players:FindFirstChild(playerName)
        if not targetPlayer or not targetPlayer.Character then return false end
        
        -- Vérifie qu'on est toujours sur le blobman
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
        if humanoid and humanoid.SeatPart and tostring(humanoid.SeatPart.Parent) == 'CreatureBlobman' then
            local blobmanParent = humanoid.SeatPart.Parent
            
            -- Utilise CreatureDrop pour relâcher le joueur
            if blobmanParent:FindFirstChild('BlobmanSeatAndOwnerScript') then
                local creatureDrop = blobmanParent.BlobmanSeatAndOwnerScript:FindFirstChild('CreatureDrop')
                if creatureDrop then
                    local dropData = {
                        blobmanParent:FindFirstChild('LeftDetector'),
                        targetPlayer.Character:FindFirstChild('HumanoidRootPart'),
                        blobmanParent:FindFirstChild('LeftDetector') and blobmanParent.LeftDetector:FindFirstChild('LeftWeld')
                    }
                    
                    if dropData[1] and dropData[2] and dropData[3] then
                        creatureDrop:FireServer(unpack(dropData))
                        notify("Blobman Auto", "📤 " .. targetPlayer.DisplayName .. " relâché", 2)
                        task.wait(0.5)
                    end
                end
            end
            
            -- Supprime le blobman
            pcall(function()
                game:GetService("ReplicatedStorage").MenuToys.DestroyToy:FireServer(blobmanToy)
            end)
            
            -- Se déconnecte du blobman
            humanoid.Sit = false
            task.wait(0.2)
            
            notify("Blobman Auto", "🗑️ Blobman supprimé", 2)
            blobmanToy = nil
            return true
        end
        
        return false
    end
    function grabPlayerWithBlobman(playerName)
        local targetPlayer = Players:FindFirstChild(playerName)
        if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild('HumanoidRootPart') then
            return false
        end
        
        -- Vérifie qu'on est assis sur le blobman
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass('Humanoid')
        if not humanoid or not humanoid.SeatPart or tostring(humanoid.SeatPart.Parent) ~= 'CreatureBlobman' then
            return false
        end
        
        local blobmanParent = humanoid.SeatPart.Parent
        if blobmanParent:WaitForChild('BlobmanSeatAndOwnerScript') and blobmanParent.BlobmanSeatAndOwnerScript:WaitForChild('CreatureGrab') then
            local creatureGrab = blobmanParent.BlobmanSeatAndOwnerScript.CreatureGrab
            local grabData = {
                blobmanParent:FindFirstChild('LeftDetector'),
                targetPlayer.Character:FindFirstChild('HumanoidRootPart'),
                blobmanParent:FindFirstChild('LeftDetector') and blobmanParent.LeftDetector:FindFirstChild('LeftWeld')
            }
            
            if grabData[1] and grabData[2] and grabData[3] then
                creatureGrab:FireServer(unpack(grabData))
                
                -- Attend que le grab soit effectif
                task.wait(0.8)
                
                -- Modifie les stats du joueur grabbé
                if targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass('Humanoid') then
                    local targetHumanoid = targetPlayer.Character:FindFirstChildOfClass('Humanoid')
                    targetHumanoid.WalkSpeed = grabbedWalkSpeed
                    targetHumanoid.JumpPower = grabbedJumpPower
                    
                    notify("Blobman Auto", string.format("✅ %s grabbé! Speed=%d Jump=%d", 
                        targetPlayer.DisplayName, grabbedWalkSpeed, grabbedJumpPower), 3)
                    
                    -- Attendre un peu puis relâcher et nettoyer
                    task.wait(1)
                    releasePlayerAndCleanup(playerName)
                    
                    return true
                end
            end
        end
        
        return false
    end
    
    -- Processus complet automatique
    function executeAutoBlobman()
        if not selectedPlayer or selectedPlayer == "" then
            notify("Blobman Auto", "❌ Aucun joueur sélectionné", 3)
            return
        end
        
        notify("Blobman Auto", "🤖 Démarrage du processus automatique...", 2)
        
        -- 1. Assure qu'on a un blobman
        local blobman = ensureBlobman()
        if not blobman then
            notify("Blobman Auto", "❌ Impossible de spawner un blobman", 3)
            return
        end
        
        -- 2. S'asseoir sur le blobman
        if not sitOnBlobman(blobman) then
            notify("Blobman Auto", "❌ Impossible de s'asseoir sur le blobman", 3)
            return
        end
        
        notify("Blobman Auto", "✅ Assis sur le blobman", 2)
        
        -- 3. Téléporter le blobman sur le joueur
        if not teleportBlobmanToPlayer(selectedPlayer) then
            return
        end
        
        -- 4. Grab le joueur et modifier ses stats
        task.wait(1)
        if grabPlayerWithBlobman(selectedPlayer) then
            notify("Blobman Auto", "🎯 Processus terminé avec succès!", 3)
        else
            notify("Blobman Auto", "⚠️ Échec du grab du joueur", 3)
        end
    end
    
