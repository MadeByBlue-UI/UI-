                    local d = s * (l1 + l2)
                    if d <= l1 then
                        local v = K - a
                        return a + v * (d / math.max(l1, 1e-4)), v
                    end
                    local v = F - K
                    return K + v * ((d - l1) / math.max(l2, 1e-4)), v
                end

