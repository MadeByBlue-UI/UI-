    function TPAndDestroyToy(toy, savedPos)
        if not toy or not toy.Parent then return false end
        
        local mainPart = toy:IsA("Model") and (toy:FindFirstChild("Main") or toy:FindFirstChild("SoundPart") or toy.PrimaryPart) or toy
        if not mainPart or not mainPart:IsA("BasePart") then return false end
        
        local myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return false end
        
        local success = pcall(function()
            local SetNetworkOwner = game:GetService("ReplicatedStorage").GrabEvents.SetNetworkOwner
            
            -- TP vers le toy
            myRoot.CFrame = mainPart.CFrame + Vector3.new(0, 8, 0)
            task.wait(0.08)
            
            -- Grab ownership
            SetNetworkOwner:FireServer(mainPart, mainPart.CFrame)
            task.wait(0.04)
            
            if _G.ToyDestroyerMethod == "Fling" then
                -- Fling vers l'enfer
                mainPart.CFrame = CFrame.new(mainPart.Position.X, -10000, mainPart.Position.Z)
                mainPart.AssemblyLinearVelocity = Vector3.new(0, -2000, 0)
            else
                -- Delete via remote
                local DestroyToy = game:GetService("ReplicatedStorage").MenuToys.DestroyToy
                DestroyToy:FireServer(toy)
            end
            
            task.wait(0.02)
        end)
        
        return success
    end
    
