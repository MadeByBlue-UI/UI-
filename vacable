    -- Transparence des objets portés : réglage global (S.wornAlpha) + slider propre à chaque objet (adj[id].tr)
    function applyWornAlpha(acc, id)
        if not acc then return end
        -- Utiliser l'ID passé en paramètre ou le récupérer de l'attribut
        id = id or acc:GetAttribute("CatId")
        local a = id and adj[tostring(id)]
        local own = (a and a.tr) or 0
        local k = 1 - (1 - S.wornAlpha) * (1 - own)
        acc:SetAttribute("CatAlphaK", k)  -- valeur voulue, relue par les gardes ci-dessous

        local function targetOf(d)
            local o = d:GetAttribute("OrigT") or 0
            local kk = acc:GetAttribute("CatAlphaK") or 0
            return o + (1 - o) * kk
        end

        local function setup(d)
            if not d:IsA("BasePart") then return end
            if d:GetAttribute("OrigT") == nil then d:SetAttribute("OrigT", d.Transparency) end
            local t = targetOf(d)
            if d.Transparency ~= t then d.Transparency = t end
            -- Sur ton vrai perso, le jeu / un autre script peut remettre Transparency à sa valeur d'origine :
            -- on surveille la propriété et on remet la transparence voulue (une seule fois par pièce).
            if not d:GetAttribute("CatAlphaGuard") then
                d:SetAttribute("CatAlphaGuard", true)
                _TrackConn(d:GetPropertyChangedSignal("Transparency"):Connect(function()
                    if (acc:GetAttribute("CatAlphaK") or 0) <= 0 then return end
                    local want = targetOf(d)
                    if math.abs(d.Transparency - want) > 0.001 then d.Transparency = want end
                end))
            end
        end

        for _, d in ipairs(acc:GetDescendants()) do setup(d) end

        -- pièces ajoutées plus tard à l'accessoire (le jeu ou le chargement peuvent en créer)
        if not acc:GetAttribute("CatAlphaHook") then
            acc:SetAttribute("CatAlphaHook", true)
            _TrackConn(acc.DescendantAdded:Connect(function(d)
                task.defer(setup, d)
            end))
        end
    end

