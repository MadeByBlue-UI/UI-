        -- Highlight system for selection with text
        function updateSelectionHighlight()
            if not breakPartMode then return end
            
            local target = Mouse.Target
            
            -- Remove old highlight and text
            if selectionHighlight and (not target or selectionHighlight.Adornee ~= target) then
                pcall(function() selectionHighlight:Destroy() end)
                selectionHighlight = nil
            end
            if textGui and (not target or textGui.Parent ~= target) then
                pcall(function() textGui:Destroy() end)
                textGui = nil
            end
            
            -- Create new highlight and text
            if target and target:IsA("BasePart") and not selectionHighlight then
                -- Highlight
                local highlight = Instance.new("Highlight")
                highlight.FillColor = Color3.fromRGB(138, 43, 226) -- Violet neon
                highlight.FillTransparency = 0.75 -- 75% transparence
                highlight.OutlineColor = Color3.fromRGB(186, 85, 211) -- Violet plus clair pour outline
                highlight.OutlineTransparency = 0.5
                highlight.Adornee = target
                highlight.Parent = target
                selectionHighlight = highlight
                _TrackPart(highlight)
                
                -- Text GUI on the part
                local billboardGui = Instance.new("BillboardGui")
                billboardGui.Size = UDim2.new(0, 200, 0, 50)
                billboardGui.Adornee = target
                billboardGui.Parent = target
                
