-- ANTI-BANANA (Remove Right Leg)
-- Retire uniquement ta jambe droite pour éviter les bananes
-- Rig R6 requis ("Right Leg", "Torso")
-- =========================================================================
do
    local AUTO_REAPPLY = false  -- Contrôlé par le toggle
    local rightLegConn = nil

    function setRagdoll(char, state)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local events = ReplicatedStorage:FindFirstChild("CharacterEvents")
        local remote = events and events:FindFirstChild("RagdollRemote")
        if hrp and remote then
            remote:FireServer(hrp, state and 1 or 0)
        end
    end

    function removeRightLeg()
        local char = LocalPlayer.Character
        if not char then return end

        local leg = char:FindFirstChild("Right Leg")
        if not leg then
            notify("Anti-Banana", "❌ 'Right Leg' introuvable (R6 requis)", 3)
            return
        end

        setRagdoll(char, true)
        task.wait(0.3)

        leg.CFrame = CFrame.new(0, -99999, 0)
        task.wait(0.1)

        local torso = char:FindFirstChild("Torso")
        local grab = ReplicatedStorage:FindFirstChild("GrabEvents")
        local setOwner = grab and grab:FindFirstChild("SetNetworkOwner")
        if torso and setOwner then
            setOwner:FireServer(torso, torso.CFrame)
        end

        notify("Anti-Banana", "✅ Jambe droite retirée !", 2)
    end

    DefenseExtra:CreateToggle({
        Name     = "Anti-Banana (Right Leg)",
        Flag     = "AntiBananaToggle",
        Default  = false,
        Callback = function(v)
            AUTO_REAPPLY = v

            -- Déconnecte l'ancienne connexion
            if rightLegConn then
                rightLegConn:Disconnect()
                rightLegConn = nil
            end

            if v then
                -- Exécution immédiate
                task.spawn(removeRightLeg)

                -- Ré-applique au respawn
                rightLegConn = LocalPlayer.CharacterAdded:Connect(function(char)
                    char:WaitForChild("Humanoid")
                    char:WaitForChild("Right Leg")
                    task.wait(1)
                    if AUTO_REAPPLY then
                        removeRightLeg()
                    end
                end)
                _TrackConn(rightLegConn)
            else
                notify("Anti-Banana", "Désactivé (respawn pour récupérer la jambe)", 2)
            end
        end
    })
end

-- =========================================================================
-- NINJA KUNAI (Stick on Self)
-- Colle un kunai sur toi - Code original du panel sans modification
-- =========================================================================
do
    local setOwner   = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
    local stickyEvt  = ReplicatedStorage:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
    local spawnToy   = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local destroyToy = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    local canSpawn   = LocalPlayer:WaitForChild("CanSpawnToy")

    local TOY_NAME = "NinjaKunai"
    local MY_NAME  = "MyKunai"

    -- Réglages (identiques au panel original)
    local cfg = { px = 0.5, py = -0.9, pz = 0, rx = 0, ry = 90, rz = 90 }
    local active = false
    local dirty = false
    local kunai = nil
    local kunaiConn = nil

    function getStickCFrame()
        return CFrame.new(cfg.px, cfg.py, cfg.pz)
            * CFrame.Angles(math.rad(cfg.rx), math.rad(cfg.ry), math.rad(cfg.rz))
    end

    function getInv()
        return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    end

    function getStickyPart(model)
        if not model then return nil end
        return model:FindFirstChild("StickyPart") or model:FindFirstChild("StickyPart", true)
    end

    function isAttached(model)
        local sp = getStickyPart(model)
        if not sp then return false end
        local weld = sp:FindFirstChild("StickyWeld")
        return weld ~= nil and weld.Part1 ~= nil
    end

    function getFirePart()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        return hrp and hrp:FindFirstChild("FirePlayerPart"), hrp
    end

    -- (Re)colle le kunai avec le CFrame actuel (code original)
    function applyStick()
        if not kunai or not kunai.Parent then return end
        local firePart = getFirePart()
        local sp = getStickyPart(kunai)
        if not firePart or not sp then return end
        pcall(function() setOwner:FireServer(sp, sp.CFrame) end)
        pcall(function() stickyEvt:FireServer(sp, firePart, getStickCFrame()) end)
    end

    function removeKunai()
        if kunai and kunai.Parent then
            pcall(function() destroyToy:FireServer(kunai) end)
        end
        kunai = nil
    end

    function spawnKunai()
        local firePart, hrp = getFirePart()
        if not firePart or not hrp then return end

        local inv = getInv()
        if not inv then return end

        if not canSpawn.Value then
            local t = tick()
            repeat task.wait(0.05) until canSpawn.Value or tick() - t > 3
        end

        task.spawn(function()
            pcall(function()
                spawnToy:InvokeServer(TOY_NAME, hrp.CFrame * CFrame.new(0, 9, 20), Vector3.zero)
            end)
        end)

        task.wait(0.15)

        local toy = inv:FindFirstChild(TOY_NAME)
        if not toy then
            notify("Kunai", "❌ Kunai introuvable après le spawn", 3)
            return
        end

        toy.Name = MY_NAME
        kunai = toy

        for _, obj in ipairs(toy:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanTouch = false
                obj.CanCollide = false
                obj.CanQuery = false
            end
        end

        applyStick()
    end

    -- Boucle de surveillance : respawn si détruit / détaché / mort (code original)
    task.spawn(function()
        local lastSpawn = 0
        local __rid = _G.HelperOtherRunId; while _G.HelperOtherRunId == __rid do
            task.wait(0.25)
            if active then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and getFirePart() then
                    if not kunai or not kunai.Parent then
                        if tick() - lastSpawn > 1 then
                            lastSpawn = tick()
                            spawnKunai()
                        end
                    elseif dirty or not isAttached(kunai) then
                        dirty = false
                        applyStick()
                    end
                end
            end
        end
    end)

    DefenseExtra:CreateToggle({
        Name     = "Ninja Kunai (Stick)",
        Flag     = "NinjaKunaiToggle",
        Default  = false,
        Callback = function(v)
            active = v

            if kunaiConn then
                kunaiConn:Disconnect()
                kunaiConn = nil
            end

            if v then
                -- Ré-applique au respawn
                kunaiConn = LocalPlayer.CharacterAdded:Connect(function()
                    kunai = nil -- l'ancien est perdu avec l'ancien perso, la boucle respawn
                end)
                _TrackConn(kunaiConn)
            else
                removeKunai()
                notify("Kunai", "Désactivé", 2)
            end
        end
    })
end

