    _G._FigureFreeJumpReset = function()
        local fj = _G._FigureFJ
        if fj then
            fj.y, fj.vy, fj.air, fj.req = nil, 0, false, false
            fj.jumped, fj.vy0, fj.airT, fj.landT, fj.landV, fj.noHitT, fj.bufT = false, 0, 0, 99, 0, 0, nil
        end
    end

    -- Facteur "jambes repliées" 0..1 pour les anciennes animations "Jump" (autres formations) :
    -- en Saut Libre il suit le VRAI saut (0 au décollage / à la réception, 1 au sommet), sinon on garde la boucle d'origine.
    function _G._FigureJumpK(fallback)
        local fj = _G._FigureFJ
        if _G._FigureGroundMethod == "Saut Libre" and fj and fj.air and (tick() - (fj.t or 0)) < 0.5 then
            local u = math.clamp((fj.vy or 0) / math.max(fj.vy0 or 0, 20), -1, 1)
            local x = math.clamp((1 - math.abs(u)) * 1.7, 0, 1)
            return x * x * (3 - 2 * x)
        end
        return fallback
    end

    -- Mode Superman actif ? (vol "Face Camera" : Ground Snap coupé, OU Saut Libre pendant un vol)
    function _G._FigureIsSuperman()
