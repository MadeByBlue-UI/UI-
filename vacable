    -- Mexican Wave (La Ola)
    function AnimateMexicanWave(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        
        for i, data in ipairs(toys) do
            local angle = (i / #toys) * math.pi * 2
            local waveOffset = math.sin(time * speed + i * 0.5) * 8 * intensity
            
            local x = math.cos(angle) * 15
            local z = math.sin(angle) * 15
            local y = waveOffset
            
            local pos = rootPos + Vector3.new(x, y + 5, z)
            data.bodyPos.Position = pos
            data.bodyGyro.CFrame = CFrame.new(pos) * CFrame.Angles(0, time, 0)
        end
    end
    
    -- Fireworks (Feux d'artifice)
    function AnimateFireworks(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        local phase = math.floor(time * speed / 3) % 2
        
        for i, data in ipairs(toys) do
            if phase == 0 then
                -- Montée
                local progress = (time * speed % 3) / 3
                local y = progress * 30 * intensity
                data.bodyPos.Position = rootPos + Vector3.new(0, y + 5, 0)
            else
                -- Explosion
                local progress = (time * speed % 3) / 3
                local angle = (i / #toys) * math.pi * 2
                local radius = progress * 20 * intensity
                
                local x = math.cos(angle) * radius
                local z = math.sin(angle) * radius
                local y = 25 * intensity - progress * 10
                
                data.bodyPos.Position = rootPos + Vector3.new(x, y, z)
                data.bodyGyro.CFrame = CFrame.new(data.bodyPos.Position) * CFrame.Angles(time * 5, time * 3, time * 7)
            end
        end
    end
    
    -- DNA Spin (Double hélice qui tourne)
    function AnimateDNASpin(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        local char = Player.Character
        local rootCF = char and char.HumanoidRootPart.CFrame or CFrame.new()
        
        for i, data in ipairs(toys) do
            local strand = (i % 2 == 0) and 1 or -1  -- Deux brins
            local progress = (i / #toys) * math.pi * 4
            
            local angle = progress + time * speed
            local x = math.cos(angle) * 8 * intensity * strand
            local y = (i / #toys) * 15 - 7.5
            local z = math.sin(angle) * 8 * intensity * strand
            
            local offset = rootCF:VectorToWorldSpace(Vector3.new(x, y, z))
            data.bodyPos.Position = rootPos + offset
            data.bodyGyro.CFrame = CFrame.lookAt(data.bodyPos.Position, rootPos)
        end
    end
    
    -- Tornado Chaos (Tornado chaotique)
    function AnimateTornadoChaos(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        
        for i, data in ipairs(toys) do
            local angle = (i / #toys) * math.pi * 2 + time * speed
            local chaos = math.sin(time * 3 + i) * 3
            local radius = 12 + chaos * intensity
            local height = math.sin(time * 2 + i * 0.3) * 10 * intensity
            
            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius
            
            data.bodyPos.Position = rootPos + Vector3.new(x, height + 5, z)
            data.bodyGyro.CFrame = CFrame.new(data.bodyPos.Position) * CFrame.Angles(
                time * 2 + i,
                time * 3 - i,
                time * 1.5 + i
            )
        end
    end
    
    -- Morphing Shapes (Formes qui changent)
    function AnimateMorphingShapes(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        local shape = math.floor(time * speed / 4) % 4
        
        for i, data in ipairs(toys) do
            local angle = (i / #toys) * math.pi * 2
            local pos
            
            if shape == 0 then
                -- Cercle
                local x = math.cos(angle) * 12
                local z = math.sin(angle) * 12
                pos = rootPos + Vector3.new(x, 5, z)
                
            elseif shape == 1 then
                -- Carré
                local side = math.floor(i / (#toys / 4))
                local progress = (i % (#toys / 4)) / (#toys / 4)
                if side == 0 then
                    pos = rootPos + Vector3.new(progress * 20 - 10, 5, -10)
                elseif side == 1 then
                    pos = rootPos + Vector3.new(10, 5, progress * 20 - 10)
                elseif side == 2 then
                    pos = rootPos + Vector3.new(10 - progress * 20, 5, 10)
                else
                    pos = rootPos + Vector3.new(-10, 5, 10 - progress * 20)
                end
                
            elseif shape == 2 then
                -- Triangle
                local corners = {
                    Vector3.new(0, 5, -15),
                    Vector3.new(13, 5, 7.5),
                    Vector3.new(-13, 5, 7.5)
                }
                local corner = math.floor(i / (#toys / 3)) % 3 + 1
                local nextCorner = (corner % 3) + 1
                local progress = (i % (#toys / 3)) / (#toys / 3)
                pos = rootPos + corners[corner]:Lerp(corners[nextCorner], progress)
                
            else
                -- Étoile à 5 branches
                local starAngle = angle * 2.5
                local radius = (i % 2 == 0) and 15 or 7
                local x = math.cos(starAngle) * radius
                local z = math.sin(starAngle) * radius
                pos = rootPos + Vector3.new(x, 5, z)
            end
            
            data.bodyPos.Position = pos * intensity
            data.bodyGyro.CFrame = CFrame.new(pos) * CFrame.Angles(0, time * 2, 0)
        end
    end
    
    -- Pulse Wave (Onde de choc pulsante)
    function AnimatePulseWave(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        local pulse = math.abs(math.sin(time * speed)) * intensity
        
        for i, data in ipairs(toys) do
            local angle = (i / #toys) * math.pi * 2
            local radius = 10 + pulse * 15
            
            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius
            local y = pulse * 5
            
            data.bodyPos.Position = rootPos + Vector3.new(x, y + 5, z)
            
            -- Scale visuel (simule avec rotation)
            local scale = 1 + pulse
            data.bodyGyro.CFrame = CFrame.new(data.bodyPos.Position) * CFrame.Angles(
                0,
                time * 2,
                0
            )
        end
    end
    
    -- Orbital Dance (Danse orbitale)
    function AnimateOrbitalDance(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        
        for i, data in ipairs(toys) do
            local layer = math.floor(i / 4)
            local angleInLayer = ((i % 4) / 4) * math.pi * 2
            
            local orbit1 = angleInLayer + time * speed
            local orbit2 = layer * math.pi / 2 + time * speed * 0.5
            
            local radius = 8 + layer * 4
            local x = math.cos(orbit1) * radius
            local z = math.sin(orbit1) * radius
            local y = math.sin(orbit2) * 6 * intensity
            
            data.bodyPos.Position = rootPos + Vector3.new(x, y + 5, z)
            data.bodyGyro.CFrame = CFrame.lookAt(data.bodyPos.Position, rootPos) * 
                CFrame.Angles(time, time * 1.5, time * 0.5)
        end
    end
    
    -- Lightning Storm (Tempête d'éclairs)
    function AnimateLightningStorm(toys, time, speed, intensity)
        local rootPos = Player.Character and Player.Character.HumanoidRootPart.Position or Vector3.zero
        
        for i, data in ipairs(toys) do
            -- Mouvement erratique style éclair
            local baseAngle = (i / #toys) * math.pi * 2
            local chaos1 = math.sin(time * 10 + i * 10) * 5 * intensity
            local chaos2 = math.cos(time * 12 + i * 7) * 5 * intensity
            
            local radius = 12 + chaos1
            local x = math.cos(baseAngle + time * speed) * radius + chaos2
            local z = math.sin(baseAngle + time * speed) * radius + chaos1
            local y = math.abs(math.sin(time * 15 + i)) * 10 * intensity
            
            data.bodyPos.Position = rootPos + Vector3.new(x, y + 5, z)
            data.bodyGyro.CFrame = CFrame.new(data.bodyPos.Position) * CFrame.Angles(
                math.random() * math.pi,
                math.random() * math.pi,
                math.random() * math.pi
            )
        end
    end
    
    -- =====================================================================
    -- BOUCLE PRINCIPALE D'ANIMATION
    -- =====================================================================
    function StartAnimationLoop()
        task.spawn(function()
            while _G.ToyAnimationActive do
                local char = Player.Character
                local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                
                if rootPart then
                    -- Initialise les toys si pas encore fait
                    if #AnimatedToys == 0 then
                        local inventoryFolder = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                        
                        if inventoryFolder then
                            for _, toy in ipairs(inventoryFolder:GetChildren()) do
                                if toy:IsA("Model") then
                                    local mainPart = toy:FindFirstChild("Main") or toy:FindFirstChild("SoundPart")
                                    if mainPart and mainPart:IsA("BasePart") then
                                        local bodyPos = Instance.new("BodyPosition")
                                        bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                        bodyPos.P = 15000
                                        bodyPos.D = 800
                                        bodyPos.Parent = mainPart
                                        
                                        local bodyGyro = Instance.new("BodyGyro")
                                        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                                        bodyGyro.P = 15000
                                        bodyGyro.D = 800
                                        bodyGyro.Parent = mainPart
                                        
                                        local particles = CreateParticlesForToy(mainPart)
                                        local light = CreateLightForToy(mainPart)
                                        
                                        table.insert(AnimatedToys, {
                                            part = mainPart,
                                            bodyPos = bodyPos,
                                            bodyGyro = bodyGyro,
                                            particles = particles,
                                            light = light,
                                            index = #AnimatedToys + 1
                                        })
                                    end
                                end
                            end
                            
                            notify("Animation Studio", "🎬 " .. #AnimatedToys .. " toys animés en mode: " .. _G.ToyAnimationType, 3)
                        end
                    end
                    
                    -- Update animation
                    AnimationTime = AnimationTime + (0.016 * _G.ToyAnimationSpeed)
                    
                    -- Applique l'animation selon le type
                    if _G.ToyAnimationType == "Wave" then
                        AnimateMexicanWave(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    elseif _G.ToyAnimationType == "Fireworks" then
                        AnimateFireworks(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    elseif _G.ToyAnimationType == "DNA Spin" then
                        AnimateDNASpin(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    elseif _G.ToyAnimationType == "Tornado Chaos" then
                        AnimateTornadoChaos(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    elseif _G.ToyAnimationType == "Morphing Shapes" then
                        AnimateMorphingShapes(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    elseif _G.ToyAnimationType == "Pulse Wave" then
                        AnimatePulseWave(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    elseif _G.ToyAnimationType == "Orbital Dance" then
                        AnimateOrbitalDance(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    elseif _G.ToyAnimationType == "Lightning Storm" then
                        AnimateLightningStorm(AnimatedToys, AnimationTime, _G.ToyAnimationSpeed, _G.ToyAnimationIntensity)
                    end
                    
                    -- Update couleurs rainbow
                    if _G.ToyAnimationRainbow then
                        for i, data in ipairs(AnimatedToys) do
                            local color = GetRainbowColor(AnimationTime + i * 0.3)
                            if data.light then
                                data.light.Color = color
                            end
                            if data.particles then
                                for _, particle in ipairs(data.particles) do
                                    particle.Color = ColorSequence.new(color)
                                end
                            end
                        end
                    end
                    
                    -- Grab ownership pour stabilité
                    for _, data in ipairs(AnimatedToys) do
                        pcall(function()
                            RS.GrabEvents.SetNetworkOwner:FireServer(data.part, data.part.CFrame)
                        end)
                    end
                end
                
                task.wait(0.016)  -- ~60 FPS
            end
            
            CleanupAnimations()
        end)
    end
    
