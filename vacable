        Callback = function(v)
            pcldOutlineTrans = v / 100
            for _, d in pairs(pcldItems) do
                if d.outline then d.outline.Transparency = pcldOutlineTrans end
            end
        end,
    })

    PCLDBlock:CreateSlider({
        Name     = "Epaisseur Outline",
