do
    local RS3        = game:GetService("ReplicatedStorage")
    local plr3       = game:GetService("Players").LocalPlayer

    -- Items disponibles
    local V2_ITEMS = {
        { display = "Japanese Lantern", internal = "JapaneseLantern" },
        { display = "Spray Can",        internal = "SprayCanWD"      },
        { display = "Spooky Candle",    internal = "SpookyCandle1"   },
        { display = "Clock Alarm",      internal = "ClockAlarm"      },
        { display = "Flying UFO",       internal = "FlyingToyUfo"    },
    }

    -- Helpers partags
    function V2_SNO(part)
        pcall(function()
            RS3.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
        end)
    end

    function V2_IsOwner(part)
        local po = part:FindFirstChild("PartOwner")
        return po and po.Value == plr3.Name
    end

    function V2_SpawnItem(internalName)
        local CanSpawn = plr3:FindFirstChild("CanSpawnToy")
        if CanSpawn and not CanSpawn.Value then
            local t = tick()
            repeat task.wait(0.05) until CanSpawn.Value or tick()-t > 5
        end
        local char = plr3.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local inv = workspace:FindFirstChild(plr3.Name.."SpawnedInToys")
        if not inv then return nil end
        local spawned = nil
        local conn = inv.ChildAdded:Connect(function(c)
            if c.Name == internalName then spawned = c end
        end)
        task.spawn(function()
            pcall(function()
                RS3.MenuToys.SpawnToyRemoteFunction:InvokeServer(
                    internalName,
                    hrp.CFrame * CFrame.new(0, 14, 20),
                    Vector3.zero
                )
            end)
        end)
        local t = tick()
        repeat task.wait(0.05) until spawned or tick()-t > 5
        conn:Disconnect()
        return spawned
    end

    function V2_Destroy(item)
        pcall(function()
            RS3.MenuToys.DestroyToy:FireServer(item)
        end)
    end

    -- Cre un toggle par item
    for _, itemDef in ipairs(V2_ITEMS) do
        local active = false
        local tag    = "V2_" .. itemDef.internal

        DefenseExtra:CreateToggle({
            Name    = itemDef.display,
            Flag    = tag,
            Default = false,
            Callback = function(on)
                active = on
                if not on then return end

                task.spawn(function()
                    local item       = nil
                    local hitbox     = nil

                    while active do
                        local char      = plr3.Character
                        local hrp       = char and char:FindFirstChild("HumanoidRootPart")
                        local hum       = char and char:FindFirstChild("Humanoid")
                        local inv       = workspace:FindFirstChild(plr3.Name.."SpawnedInToys")

                        if not hrp or not hum or hum.Health <= 0 or not inv then
                            task.wait(0.1)
                            continue
                        end

                        -- Cherche ou respawn l'item
                        item   = inv:FindFirstChild(tag)
                        hitbox = item and item:FindFirstChild("Hitbox")

                        if not item or not hitbox then
                            -- Nettoie les restes
                            for _, v in pairs(inv:GetChildren()) do
                                if v.Name == tag then V2_Destroy(v) end
                            end
                            item = V2_SpawnItem(itemDef.internal)
                            if not item then task.wait(0.2) continue end

                            -- Attend le Hitbox
                            local t0 = tick()
                            repeat task.wait(0.05) until item:FindFirstChild("Hitbox") or tick()-t0 > 3
                            hitbox = item:FindFirstChild("Hitbox")
                            if not hitbox then task.wait(0.2) continue end

                            -- Claim ownership
                            V2_SNO(hitbox)

                            -- No collision mais visible
                            for _, v in pairs(item:GetDescendants()) do
                                if v:IsA("BasePart") then
v.CanCollide = false
                                end
                            end

                            -- Highlight cyan outline
                            local oldHL = item:FindFirstChild("AntiKickHighlight")
                            if oldHL then oldHL:Destroy() end
                            local hl = Instance.new("Highlight")
                            hl.Name                = "AntiKickHighlight"
                            hl.Adornee             = item
                            hl.FillTransparency    = 1
                            hl.OutlineTransparency = 0
                            hl.OutlineColor        = Color3.fromRGB(0, 255, 255)
                            hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent              = item

                            item.Name = tag

                            -- Notification + son bulles
                            Library:Notify({ Title = "Anti-Kick V2", Content = itemDef.display .. "  Attache ", Duration = 2 })
                            local s = Instance.new("Sound")
                            s.SoundId = _G.GetCustomPalletSound and _G.GetCustomPalletSound() or "rbxassetid://132948338000932"
                            s.Volume  = 0.63
                            s.Parent  = workspace
                            s:Play()
                            game:GetService("Debris"):AddItem(s, 3)
                        end

                        -- Renouvelle ownership si perdu
                        if not V2_IsOwner(hitbox) then
                            V2_SNO(hitbox)
                        end

                        -- Colle sur FirePlayerPart ou HRP
                        local anchor = hrp:FindFirstChild("FirePlayerPart") or hrp

                        if itemDef.internal == "FlyingToyUfo" then
                            -- UFO : position (0, -0.5, 0) par rapport au HRP, orientation fixe
                            hitbox.CFrame = hrp.CFrame
    * CFrame.new(0, -0.5, 0)
    * CFrame.Angles(0, math.rad(0), math.rad(-90))
                        else
                            hitbox.CFrame = anchor.CFrame
                        end

                        hitbox.AssemblyLinearVelocity  = Vector3.zero
                        hitbox.AssemblyAngularVelocity = Vector3.zero

                        task.wait()
                    end

                    -- Nettoyage  l'arrt
                    local inv = workspace:FindFirstChild(plr3.Name.."SpawnedInToys")
                    if inv then
                        for _, v in pairs(inv:GetChildren()) do
                            if v.Name == tag then V2_Destroy(v) end
                        end
                    end
                end)
            end
        })
    end

    -- Redémarre les items actifs après respawn
    _TrackConn(plr3.CharacterAdded:Connect(function(char)
        char:WaitForChild("HumanoidRootPart", 10)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        local t = tick()
        repeat task.wait(0.1) until hum.Health > 0 or tick()-t > 5
        repeat task.wait(0.1) until char:FindFirstChild("HumanoidRootPart") and
            char.HumanoidRootPart:FindFirstChild("FirePlayerPart") or tick()-t > 8
        -- Les toggles actifs relancent automatiquement leur loop via `active`
    end))
end

