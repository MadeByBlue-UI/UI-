                                    end
                                    
                                    -- Mouvement : Instant ou Smooth Follow
                                    if tornadoSmoothFollow then
                                        -- Mode SMOOTH : les toys rattrapent progressivement leur position
                                        -- Conversion slider 1-30 vers lerp 1.0-0.03 (inversé)
                                        -- 1 = instant (lerp 1.0), 30 = ultra smooth (lerp 0.03)
                                        local lerpValue = 1.0 / tornadoSmoothness
                                        part.CFrame = part.CFrame:Lerp(targetCF, lerpValue)
                                    else
                                        -- Mode INSTANT : téléportation directe (comme avant)
                                        part.CFrame = targetCF
                                    end
                                    
                                    part.AssemblyLinearVelocity = Vector3.zero
                                    
                                    -- 🚨 TRIPLE DESYNC DETECTION pour être sûr à 100%
                                    local isDesync = false
                                    
                                    -- Check 1 : Distance du toy vs position cible
                                    local distanceFromTarget = (part.Position - targetPos).Magnitude
                                    if distanceFromTarget > (tornadoRadius * 2.5) then
                                        isDesync = true  -- Trop loin = probablement grab
                                    end
                                    
                                    -- Check 2 : Vélocité excessive (toy qui part rapidement)
                                    if part.AssemblyLinearVelocity.Magnitude > 50 then
                                        isDesync = true  -- Bouge trop vite = quelqu'un le tire
                                    end
                                    
                                    -- Check 3 : Re-check ownership après mouvement
                                    local finalOwner = part:FindFirstChild("PartOwner")
                                    if finalOwner and finalOwner.Value ~= Player.Name then
                                        isDesync = true  -- Ownership perdu pendant le mouvement
                                    end
                                    
                                    -- Si ANY check échoue = DESYNC, on skip
                                    if isDesync then
                                        continue
                                    end
                                    
                                    --  🔥 Network sync limité à 1x/0.5s pour éviter le ping spike
                                    -- IMPORTANT : On envoie la position TARGET (formation) pas la position actuelle
                                    if shouldUpdateNetwork and SetNetworkOwner_Tornado then
                                        pcall(function()
                                            SetNetworkOwner_Tornado:FireServer(part, targetCF)
                                        end)
                                    end
                                end
                            end
                        end
                        
                        angle = angle + (tornadoSpeedEnabled and (tornadoSpeed * dt) or 0)
                    end)
                    
                    -- Attend la désactivation puis déconnecte
                    while toyTornadoActive do
                        task.wait(0.1)
                    end
                    
                    if tornadoConn then
                        tornadoConn:Disconnect()
                    end
                    
                    if grabDetectionConn then
                        grabDetectionConn:Disconnect()
                    end
                end)
                
                notify("Toy Tornado", "🌪️ Tornado activé ! Formation : " .. tornadoFormation, 3)
            else
                notify("Toy Tornado", "Désactivé", 2)
            end
        end
    })

