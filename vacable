                                            targetPos = centerPos + (rotCFrame * localPos)
                                        end
                                    end
                                    
                                    -- Calcul de la rotation (Face Center = regarde vers le centre)
                                    if tornadoFormation == "Train" then
                                        -- 🐍 MODE SERPENT : rotation spéciale basée sur la direction de mouvement
                                        local char = Player.Character
                                        local root = char and char:FindFirstChild("HumanoidRootPart")
                                        
                                        if root then
                                            -- Cherche l'index de la position de ce toy dans l'historique
                                            local targetDistance = i * tornadoTrainSpacing
