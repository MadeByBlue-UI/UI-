                Barrier = Barrier:FindFirstChild("PoisonBigHole")
                if Barrier then
                    Barrier = Barrier:FindFirstChild("ExtinguishPart")
                end
            end
            if not Barrier then return end 
            if Barrier:FindFirstChild("Tex") then 
                Barrier.Tex:Destroy()
            end
            local OldPos = Barrier.Position
            _TrackConn(FireDebounce:GetPropertyChangedSignal("Value"):Connect(function()
                FireDebounce = hum and hum:FindFirstChild("FireDebounce")
                if FireDebounce and FireDebounce.Value then  
                    Barrier.Transparency = 1
