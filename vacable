                        end
                    end
                    
                    -- Monitoring
                    local lastCheck = 0
                    local checkInterval = 0.25
                    
                    local monitorConn = RunService.Heartbeat:Connect(function()
                        if not NK_TARGET_Active then return end
                        
                        local now = tick()
                        if now - lastCheck < checkInterval then return end
                        lastCheck = now
                        
                        local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                        if not inv then return end
                        
                        local foundKunai = {}
                        for _, kunai in pairs(inv:GetChildren()) do
                            if kunai.Name:match("^NK_Target_") and NK_TARGET_Active then
                                local playerName = kunai.Name:gsub("^NK_Target_", "")
                                
                                -- Si le joueur n'est plus sélectionné, détruire le kunai
                                if not NK_TARGET_Players[playerName] then
                                    pcall(function() destroyToy_NK:FireServer(kunai) end)
                                    continue
                                end
                                
                                local targetPlayer = Players:FindFirstChild(playerName)
                                
                                if targetPlayer and targetPlayer.Character then
                                    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    
                                    if targetHRP then
                                        foundKunai[playerName] = true
                                        
                                        -- Si dans plot, détruire
                                        if IsPlayerInPlot_NK(targetPlayer) then
                                            pcall(function() destroyToy_NK:FireServer(kunai) end)
                                            reattachCooldowns[kunai.Name] = nil
