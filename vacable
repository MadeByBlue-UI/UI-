    -- =====================================================================
    -- 🦴 COU FIXE + 🎭 GESTES DE TÊTE (Oui / Non / Haussement d'épaules / Incliner)
    -- Tout est stocké dans _animBlend (pas de nouveaux "local" -> pas de risque de limite Lua)
    -- =====================================================================
    do
        _animBlend.neckPivot = false      -- cou fixe : retiré de l'UI (reste toujours désactivé)
        _animBlend.neckLen = 1.0          -- pivot = base du cou (1.0 = au niveau du toy du cou, x 1.5 studs x échelle)
        _animBlend.neckBend = 0.5         -- souplesse : le toy du cou se plie vers la tête (0 = rigide)
        _animBlend.neckLimit = 65         -- inclinaison max haut/bas de la tête (degrés)
        _animBlend.gestAmp = 1            -- amplitude des gestes
        _animBlend.gestSpeed = 1          -- vitesse des gestes
        _animBlend.gestSel = "Oui"
        _animBlend.gest = nil             -- geste en cours { name, t0, dur }
        _animBlend.curShrug = 0           -- intensité du haussement d'épaules (0..1.6), lue par la boucle des toys

        local GEST_DUR = { ["Oui"] = 1.3, ["Non"] = 1.5, ["Haussement d'épaules"] = 1.7, ["Incliner la tête"] = 2.0,
            ["Regarder à gauche"] = 1.8, ["Regarder à droite"] = 1.8, ["Oui lent"] = 1.7, ["Non lent"] = 2.0,
            ["Tête basse (triste)"] = 2.6, ["Tête haute (fier)"] = 2.0, ["Surpris"] = 1.3, ["Rire"] = 1.7 }
        local GEST_LIST = _animBlend.gestNames or {"Oui", "Non", "Haussement d'épaules", "Incliner la tête", "Regarder à gauche", "Regarder à droite", "Oui lent", "Non lent", "Tête basse (triste)", "Tête haute (fier)", "Surpris", "Rire"}

        local function sstep(t) t = math.clamp(t, 0, 1); return t * t * (3 - 2 * t) end
        -- enveloppe : monte jusqu'à u=a, tient, redescend à partir de u=b
        local function hold(u, a, b) return sstep(u / a) * (1 - sstep((u - b) / (1 - b))) end

        function _animBlend.PlayGesture(name)
            if not GEST_DUR[name] then return end
            if not animatedFigureActive then
                notify("Geste de tête", "Active d'abord 🚶 Animated Figure", 3)
                return
            end
            _animBlend.gest = { name = name, t0 = os.clock(), dur = GEST_DUR[name] / math.max(_animBlend.gestSpeed or 1, 0.1) }
        end

        -- Renvoie : pitch, yaw, roll (radians), dip (studs, à multiplier par l'échelle), shrug (0..1.6)
        -- Le geste se joue UNE fois (u va de 0 à 1) puis disparaît : rien ne boucle.
        function _animBlend.GestureEval()
            local g = _animBlend.gest
            if not g then _animBlend.curShrug = 0; return 0, 0, 0, 0, 0 end
            local u = (os.clock() - g.t0) / g.dur
            if u >= 1 then
                _animBlend.gest = nil
                _animBlend.curShrug = 0
                return 0, 0, 0, 0, 0
            end
            local A = _animBlend.gestAmp or 1
            local name = g.name
            local tau = math.pi * 2
            _animBlend.curShrug = 0
            if name == "Oui" then
                -- 2 hochements : la tête descend puis remonte, deux fois
                local d = 0.5 - 0.5 * math.cos(tau * 2 * u)
                return -math.rad(24) * A * d, 0, 0, 0, 0
            elseif name == "Non" then
                -- 2 allers-retours gauche/droite, avec fondu au début et à la fin
                local e = sstep(math.min(u, 1 - u) / 0.15)
                return 0, math.rad(34) * A * e * math.sin(tau * 2 * u), 0, 0, 0
            elseif name == "Haussement d'épaules" then
                -- épaules qui montent vite, tiennent, puis redescendent ; tête qui s'enfonce et s'incline
                local w = sstep(u / 0.22) * (1 - sstep((u - 0.62) / 0.38))
                local sw = math.min(w * A, 1.6)
                _animBlend.curShrug = sw
                return 0, 0, math.rad(9) * A * w, 0.6 * A * w, sw
            elseif name == "Regarder à gauche" then
                return 0, math.rad(55) * A * hold(u, 0.2, 0.7), 0, 0, 0
            elseif name == "Regarder à droite" then
                return 0, -math.rad(55) * A * hold(u, 0.2, 0.7), 0, 0, 0
            elseif name == "Oui lent" then
                -- un seul hochement lent et ample
                return -math.rad(22) * A * (0.5 - 0.5 * math.cos(tau * u)), 0, 0, 0, 0
            elseif name == "Non lent" then
                -- un seul va-et-vient lent (désapprobation)
                local e = sstep(math.min(u, 1 - u) / 0.2)
                return 0, math.rad(40) * A * e * math.sin(tau * u), 0, 0, 0
            elseif name == "Tête basse (triste)" then
                local w = hold(u, 0.3, 0.75)
                return -math.rad(35) * A * w, 0, math.rad(4) * A * w, 0.3 * A * w, 0
            elseif name == "Tête haute (fier)" then
                local w = hold(u, 0.25, 0.7)
                return math.rad(22) * A * w, 0, 0, -0.2 * A * w, 0
            elseif name == "Surpris" then
                -- sursaut rapide : la tête part en arrière et monte, les épaules se contractent un peu
                local w = hold(u, 0.1, 0.5)
                local sw = math.min(0.5 * w * A, 1.6)
                _animBlend.curShrug = sw
                return math.rad(18) * A * w, 0, 0, -0.3 * A * w, sw
            elseif name == "Rire" then
                -- secousses de la tête + épaules qui sautillent
                local e = sstep(math.min(u, 1 - u) / 0.15)
                local sh = math.sin(tau * 5 * u)
                local sw = math.min(0.55 * e * (0.5 + 0.5 * sh) * A, 1.6)
                _animBlend.curShrug = sw
                return math.rad(10) * A * e * sh, 0, 0, 0.25 * A * e * math.abs(sh), sw
            else -- "Incliner la tête"
                local w = sstep(u / 0.25) * (1 - sstep((u - 0.7) / 0.3))
                return 0, math.rad(8) * A * w, math.rad(20) * A * w, 0, 0
            end
        end

        -- Limite l'inclinaison haut/bas du regard (un humain ne plie pas la nuque à 90°)
        function _animBlend.ClampLook(look)
            local lim = math.rad(_animBlend.neckLimit or 65)
            local pitch = math.asin(math.clamp(look.Y, -1, 1))
            if math.abs(pitch) <= lim then return look end
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 1e-3 then
                local up = workspace.CurrentCamera.CFrame.UpVector
                flat = Vector3.new(up.X, 0, up.Z) * (look.Y > 0 and -1 or 1)
                if flat.Magnitude < 1e-3 then return look end
            end
            flat = flat.Unit
            local cp = math.clamp(pitch, -lim, lim)
            return flat * math.cos(cp) + Vector3.new(0, math.sin(cp), 0)
        end

