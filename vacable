    -- =========================================================================
    -- 👁️ VUE 1RE PERSONNE SUR LA TÊTE DE LA FORMATION
    -- La caméra se place sur la tête de la formation (la souris oriente toujours le regard, la caméra suit la direction
    -- choisie par le jeu). La tête est cachée sur TON écran seulement (LocalTransparencyModifier).
    -- =========================================================================
    _G._FigureFP = _G._FigureFP or { on = false, fwd = 0.9, up = 0.2, hidden = {} }
    do
        local FP = _G._FigureFP
        local function setHeadHidden(toy, hide)
            if not toy or not toy.Parent then return end
            local parts = { toy }
            for _, d in ipairs(toy:GetDescendants()) do
                if d:IsA("BasePart") then parts[#parts + 1] = d end
            end
            for _, pt in ipairs(parts) do
                if pt:IsA("BasePart") then pcall(function() pt.LocalTransparencyModifier = hide and 1 or 0 end) end
            end
        end
        local function stopFP()
            pcall(function() RunService:UnbindFromRenderStep("FigureFirstPerson") end)
            setHeadHidden(FP.lastToy, false)
            FP.lastToy = nil
            pcall(function() Player.CameraMode = Enum.CameraMode.Classic end)
        end
        function _G._FigureFPSet(on)
            FP.on = on and true or false
            stopFP()
            if not FP.on then return end
            pcall(function() Player.CameraMode = Enum.CameraMode.LockFirstPerson end)   -- souris verrouillée, regard libre
            RunService:BindToRenderStep("FigureFirstPerson", Enum.RenderPriority.Camera.Value + 1, function()
                local cam = workspace.CurrentCamera
                local cf, toy = _G._FigureHeadCF, _G._FigureHeadToy
                if not (FP.on and animatedFigureActive and cam and cf and toy and toy.Parent) or (os.clock() - (_G._FigureHeadT or 0)) > 0.5 then
                    if FP.lastToy then setHeadHidden(FP.lastToy, false); FP.lastToy = nil end   -- formation arrêtée : la vue normale revient
                    return
                end
                if FP.lastToy ~= toy then
                    setHeadHidden(FP.lastToy, false)
                    FP.lastToy = toy
                end
                setHeadHidden(toy, true)
                -- la caméra garde l'orientation (souris) du jeu, seule sa position est ramenée sur les yeux de la formation
                local rot = cam.CFrame - cam.CFrame.Position
                local eye = cf.Position + cf.LookVector * (FP.fwd * figureScale) + Vector3.new(0, FP.up * figureScale, 0)
                cam.CFrame = CFrame.new(eye) * rot
                cam.Focus = CFrame.new(eye + rot.LookVector * 10)
            end)
        end
    end

