    function autoSpawnAndBreakPart(Part)
        if not Part or not Part:IsA('BasePart') then 
            notify("Combat", "❌ Invalid part!", 2)
            return 
        end
        
        -- Check for existing shurikens first
        local playerToys = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not playerToys then
            notify("Combat", "❌ No SpawnedInToys folder found!", 2)
            return
        end
        
        local shurikens = {}
        for _, v in pairs(playerToys:GetChildren()) do
            if v:IsA("Model") and v.Name:find("Shuriken") then
                table.insert(shurikens, v)
            end
        end
        
        -- If no shurikens, spawn one automatically and then break
        if #shurikens == 0 then
            notify("Combat", "🔄 No shurikens found, spawning and breaking...", 2)
            
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then
                notify("Combat", "❌ No character found!", 2)
                return
            end
            
            local MenuToys = ReplicatedStorage:FindFirstChild("MenuToys")
            local SpawnToyRemote = MenuToys and MenuToys:FindFirstChild("SpawnToyRemoteFunction")
            if not SpawnToyRemote then
                notify("Combat", "❌ SpawnToyRemoteFunction not found!", 2)
                return
            end
            
            -- Spawn shuriken
            task.spawn(function()
                SpawnToyRemote:InvokeServer("NinjaShuriken", CFrame.new(hrp.Position) + Vector3.new(5, 0, 20), Vector3.new())
            end)
            
            -- Wait for it to appear and get ready
            local spawnedShuriken = nil
            local startTime = tick()
            local connection
            
            connection = playerToys.ChildAdded:Connect(function(child)
                if child:IsA("Model") and child.Name:find("Shuriken") then
                    spawnedShuriken = child
                    connection:Disconnect()
                end
            end)
            
            -- Wait up to 3 seconds for spawn
            while not spawnedShuriken and (tick() - startTime) < 3 do
                task.wait(0.1)
            end
            
            if connection then connection:Disconnect() end
            
            if not spawnedShuriken then
                notify("Combat", "❌ Failed to spawn shuriken!", 2)
                return
            end
            
            -- Wait for StickyPart to be ready
            local stickyPart = spawnedShuriken:WaitForChild("StickyPart", 2)
            if not stickyPart then
                notify("Combat", "❌ StickyPart not found!", 2)
                return
            end
            
            -- Small wait to ensure shuriken is fully ready
            task.wait(0.5)
            
            shurikens = {spawnedShuriken}
            notify("Combat", "✅ Shuriken ready, breaking part...", 1)
        end
        
        -- Now break the part with available shurikens
