    -- STICKY TOYS RGB
    -- =====================================================
    local stickyRGBActive = false
    local stickyRGBConn = nil
    local rgbHue = 0
    
    PCLDBlock:CreateToggle({
        Name     = "Sticky Toys RGB",
        Flag     = "StickyToysRGB",
        Default  = false,
        Callback = function(v)
            stickyRGBActive = v
            
            if v then
                -- Démarre la boucle RGB
                stickyRGBConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
                    if not stickyRGBActive then return end
                    
                    -- Incrémente la teinte (0 à 360)
                    rgbHue = (rgbHue + dt * 120) % 360  -- Vitesse de changement
                    
                    -- Convertir HSV vers RGB
                    local rgbColor = Color3.fromHSV(rgbHue / 360, 1, 1)
                    
                    -- Applique à tous les sticky toys dans TON inventaire uniquement
                    local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                    if inv then
                        for _, item in pairs(inv:GetChildren()) do
                            -- Cherche StickyPart dans l'item ET ses descendants
                            for _, descendant in pairs(item:GetDescendants()) do
                                if descendant.Name == "StickyPart" and descendant:IsA("BasePart") then
                                    descendant.Color = rgbColor
                                    descendant.Material = Enum.Material.Neon
                                end
                            end
                            
                            -- Aussi chercher directement au premier niveau
                            local stickyPart = item:FindFirstChild("StickyPart")
                            if stickyPart and stickyPart:IsA("BasePart") then
                                stickyPart.Color = rgbColor
                                stickyPart.Material = Enum.Material.Neon
                            end
                        end
                    end
                end)
                
                notify("PCLD ESP", "🌈 Sticky Toys RGB activé", 2)
            else
                -- Arrête la boucle et restaure la couleur originale
                if stickyRGBConn then
                    stickyRGBConn:Disconnect()
                    stickyRGBConn = nil
                end
                
                -- Réinitialise les couleurs (optionnel)
                local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                if inv then
                    for _, item in pairs(inv:GetChildren()) do
                        for _, descendant in pairs(item:GetDescendants()) do
                            if descendant.Name == "StickyPart" and descendant:IsA("BasePart") then
                                -- Restaure à blanc par défaut
                                descendant.Color = Color3.fromRGB(255, 255, 255)
                                descendant.Material = Enum.Material.Plastic
                            end
                        end
                        
                        local stickyPart = item:FindFirstChild("StickyPart")
                        if stickyPart and stickyPart:IsA("BasePart") then
                            -- Restaure à blanc par défaut
                            stickyPart.Color = Color3.fromRGB(255, 255, 255)
                            stickyPart.Material = Enum.Material.Plastic
                        end
                    end
                end
                
                notify("PCLD ESP", "Sticky Toys RGB désactivé", 2)
            end
        end,
    })
end

