            return ge and ge:FindFirstChild("SetNetworkOwner")
        end
        function getInv()
            return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        end
        function getPlanes()
            local inv = getInv(); if not inv then return {} end
            local t = {}
            for _, c in ipairs(inv:GetChildren()) do
                if c.Name == PLANE_NAME then table.insert(t, c) end
            end
            return t
        end

        -- -- FORMATION A RIENNE ------------------------------------------
        local formSpacing   = 10
        local formAltitude  = 0
        local formRotOffset = 0   -- rotation extra appliqu e   tous les avions (degr s)
        local formSmooth    = 6   -- vitesse de smooth (plus = plus rapide)

        FunPlane:CreateSlider({
            Name = "Espacement", Flag = "PlaneFormSpacing",
            Min = 4, Max = 60, Default = 10,
            Callback = function(v) formSpacing = v end,
        })
        FunPlane:CreateSlider({
            Name = "Altitude Offset", Flag = "PlaneFormAlt",
            Min = -20, Max = 50, Default = 0,
            Callback = function(v) formAltitude = v end,
        })
        FunPlane:CreateSlider({
            Name = "Rotation Avions", Flag = "PlaneFormRot",
            Min = -180, Max = 180, Default = 0,
            Callback = function(v) formRotOffset = v end,
        })
        FunPlane:CreateSlider({
            Name = "Smooth Repositionnement", Flag = "PlaneFormSmooth",
            Min = 1, Max = 30, Default = 6,
            Callback = function(v) formSmooth = v end,
        })

        FunPlane:CreateToggle({
            Name    = "Formation V",
            Flag    = "PlaneFormToggle",
            Default = false,
            Callback = function(v)
                planeFormActive = v
                if planeFormConn then planeFormConn:Disconnect(); planeFormConn = nil end

                if not v then
                    for _, plane in ipairs(getPlanes()) do
                        local root = plane:FindFirstChild("HoldPart") or plane:FindFirstChildWhichIsA("BasePart")
                        if root then
                            local bv = root:FindFirstChild("_PlaneBV")
                            local bg = root:FindFirstChild("_PlaneBG")
                            if bv then bv:Destroy() end
                            if bg then bg:Destroy() end
                        end
                    end
                    return
                end

                local SNO      = getSNO()
                local snoTimer = 0
                local fpsTimer = 0

                planeFormConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
                    if not planeFormActive then return end

                    fpsTimer = fpsTimer + dt
                    if fpsTimer < 0.033 then return end
                    local dtEff = fpsTimer
                    fpsTimer = 0

                    local char = LocalPlayer.Character
                    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end

                    local formRef = _G._formRefPart
                    local refCF   = (formRef and formRef.Parent) and formRef.CFrame or hrp.CFrame
                    local refPart = formRef  -- la part   exclure de la formation

                    local allPlanes = getPlanes()
                    -- Exclure l'objet contr l  de la formation
                    local planes = {}
                    for _, plane in ipairs(allPlanes) do
                        local root = plane:FindFirstChild("HoldPart") or plane:FindFirstChildWhichIsA("BasePart")
                        if root and root ~= refPart and not (refPart and root:IsDescendantOf(refPart.Parent or refPart)) then
                            table.insert(planes, plane)
                        end
                    end
                    if #planes == 0 then return end

                    local forward = refCF.LookVector
                    local right   = refCF.RightVector
                    local myPos   = refCF.Position
                    local smoothF = 1 - math.exp(-formSmooth * dtEff)

                    for i, plane in ipairs(planes) do
                        local root = plane:FindFirstChild("HoldPart") or plane:FindFirstChildWhichIsA("BasePart")
                        if not root then continue end

                        -- Formation V : derri re + gauche/droite altern s
                        local row  = math.ceil(i / 2)
                        local side = (i % 2 == 1) and -1 or 1
                        local targetPos = myPos
                            - forward * (row * formSpacing)
                            + right   * (side * row * formSpacing)
                            + Vector3.new(0, formAltitude, 0)

                        -- BodyVelocity smooth
                        local bv = root:FindFirstChild("_PlaneBV")
                        if not bv then
                            bv = Instance.new("BodyVelocity")
                            bv.Name     = "_PlaneBV"
                            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bv.Velocity = Vector3.zero
                            bv.Parent   = root
                        end
                        local dir  = targetPos - root.Position
                        local dist = dir.Magnitude
                        if dist > 0.5 then
                            bv.Velocity = bv.Velocity:Lerp(dir.Unit * math.min(150, dist * 12), smoothF)
                        else
                            bv.Velocity = bv.Velocity:Lerp(Vector3.zero, smoothF)
                        end

                        -- BodyGyro : direction + rotation custom
                        local bg = root:FindFirstChild("_PlaneBG")
                        if not bg then
                            bg = Instance.new("BodyGyro")
                            bg.Name      = "_PlaneBG"
                            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                            bg.D = 100; bg.P = 8000
                            bg.Parent = root
                        end
                        bg.CFrame = CFrame.new(root.Position, root.Position + forward)
                            * CFrame.Angles(0, math.rad(formRotOffset), -(_G._formBankAngle or 0))
                    end

                    -- SNO toutes les 2s
                    snoTimer = snoTimer + dtEff
                    if snoTimer >= 2 and SNO then
                        snoTimer = 0
                        for _, plane in ipairs(planes) do
                            local r = plane:FindFirstChild("HoldPart") or plane:FindFirstChildWhichIsA("BasePart")
                            if r then pcall(function() SNO:FireServer(r, r.CFrame) end) end
                        end
                    end
                end)
            end,
        })

    end

