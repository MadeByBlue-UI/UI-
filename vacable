        if _G._ObjCtrlFlying == true then return true end   -- 🛠️ vol actif (R) : le corps suit en pose de vol, même avec Ground Snap (Ground Offset/Snap)
        local fj = _G._FigureFJ
        return (_G._FigureGroundMethod == "Saut Libre" and fj and fj.flying and (tick() - (fj.t or 0)) < 0.5) and true or false
    end

    -- =========================================================================
    -- 🧗 ESCALADE AUTOMATIQUE : dès que tu te colles à un mur (en marchant vers lui, ou en l'air), le Stick Man s'y plaque,
    -- bras et jambes écartés qui alternent, et MONTE le long du mur. Arrivé près du haut, un rebord à portée déclenche la
    -- traction, le genou sur le rebord et le redressement SUR le rebord.
    --   Espace = sauter du mur · S = redescendre · Maj = lâcher
    -- Nécessite : Animated Figure, Stick Man (13+ toys), Animation = Auto, Ground Snap actif. Inactif en vol / Wall Walk.
    -- Tout est automatique (aucun slider). État dans _G._FigureClimb (aucune nouvelle variable locale).
    -- =========================================================================
    -- =========================================================================
    -- 🛠️ FIX GRAB : avec le Ground Snap, la tête de la formation était renvoyée au serveur (SetNetworkOwner) À CHAQUE FRAME.
    -- Ce spam occupait la remote de grab du jeu : ton propre clic (CreateGrabLine / SetNetworkOwner) ne prenait plus rien.
    -- Maintenant : 4 envois par seconde (comme les toys du corps) et AUCUN envoi pendant que tu cliques ou que tu tiens
    -- quelque chose avec la grab line du jeu (le toy reste à toi, sa position est écrite en local et se réplique seule).
    -- =========================================================================
    -- 🛠️ Filtre de rayon du sol (Ground Snap par défaut) : ignore TOUS les persos + TOUS les toys (comme le mode Saut Libre),
    -- sinon la formation se collait sur un toy / un joueur / une pièce invisible au moment d'arriver sur le rebord.
    function _G._FigureGroundFilter()
        local now = os.clock()
        if not _G._FigureGF or now - (_G._FigureGFT or -9) > 1 then
            _G._FigureGFT = now
            local list = {}
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr.Character then list[#list + 1] = plr.Character end
            end
            for _, ch in ipairs(workspace:GetChildren()) do
                if string.sub(ch.Name, -13) == "SpawnedInToys" then list[#list + 1] = ch end
            end
            _G._FigureGF = list
        end
        return _G._FigureGF
    end

    _G._FigureNetState = _G._FigureNetState or { last = 0, gripT = -9, chkT = -9 }
    -- 🛠️ FIX GRAB (suite) : true tant que tu cliques / tiens quelque chose avec la grab line du jeu (+0.4 s).
    -- Sert aussi aux toys du CORPS : leurs SetNetworkOwner (13+ toys, toutes les 0.5 s + reprise toutes les 2 s) saturaient
    -- la remote du grab et le faisaient lâcher au bout de 2-3 s.
    function _G._FigureGripBusy()
        local S = _G._FigureNetState
        local now = os.clock()
        if now - (S.chkT or -9) >= 0.05 then
            S.chkT = now
            local UIS = game:GetService("UserInputService")
            local mine = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
            local grabbing = false
            local gps = workspace:FindFirstChild("GrabParts")
            local gpart = gps and gps:FindFirstChild("GrabPart")
            local weld = gpart and gpart:FindFirstChild("WeldConstraint")
            local held = weld and weld.Part1
            if held and not (mine and held:IsDescendantOf(mine)) then grabbing = true end
            local clicking = (UIS:GetFocusedTextBox() == nil) and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            if grabbing or clicking then S.gripT = now end
        end
        return (now - S.gripT) < 0.4
    end
    function _G._FigureHeadNetOk(headToy)
