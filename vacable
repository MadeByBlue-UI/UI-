                            elseif PZ then
                                -- deux poings / paumes plantés au sol (Aigle : très écartés)
                                local ty = max(YF, S.Y - 5.3)
                                local tx = (PZ == "Aigle") and (S.X + side * 2.4) or (S.X * 1.1)
