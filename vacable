                    if e > 0.25 or not cam then conn:Disconnect() return end
                    local k = (1 - e / 0.25) * 0.5
                    cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
                end)
