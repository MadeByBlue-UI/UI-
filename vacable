                                            local bodyProgress = (bodyIndex - 1) / bodyToys
                                            
                                            -- Corps serpentin qui ondule
                                            local segmentAngle = bodyProgress * math.pi * 4  -- 4 ondulations
                                            local amplitude = 10 * (1 - bodyProgress * 0.5)  -- Amplitude diminue vers la queue
                                            
                                            local x = math.sin(segmentAngle) * amplitude
                                            local y = tornadoHeight + dragonLength * 0.5 - bodyProgress * 20
                                            local z = dragonLength * 0.7 - bodyProgress * dragonLength
                                            
                                            -- Animation ondulation
                                            local waveTime = tick() * 2 + bodyProgress * math.pi * 2
                                            x = x + math.cos(waveTime) * 3
                                            
                                            targetPos = centerPos + (rotCFrame * Vector3.new(x, y, z))
                                        end
                                    
                                    elseif tornadoFormation == "Shield" then
