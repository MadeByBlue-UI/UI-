            self.page, self.sel, self.isOpen, self.offset, self.fadeId = 1, nil, false, Vector2.zero, 0
            self.buttons, self.conns = {}, {}

            -- style des panels du script : fond noir, gros arrondis, contour blanc, dégradé "shine", Gotham
            local gui = Instance.new("ScreenGui")
