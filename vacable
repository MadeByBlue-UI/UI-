    local function spawnPallet()
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then notify("Pallet FX", "Pas de personnage", 3) return end

        local menu   = RS:FindFirstChild("MenuToys")
        local rSpawn = menu and menu:FindFirstChild("SpawnToyRemoteFunction")
        if not rSpawn then notify("Pallet FX", "Remote de spawn introuvable", 3) return end

        -- Si un pallet FX existe déjà, on le supprime d'abord
        if S.pallet and S.pallet.Parent then
            local rDestroy = menu:FindFirstChild("DestroyToy")
            if rDestroy then pcall(function() rDestroy:FireServer(S.pallet) end) end
            clearFX()
            S.pallet, S.part = nil, nil
        end

        local inv = getInv()
        local before = {}
        if inv then
            for _, c in ipairs(inv:GetChildren()) do before[c] = true end
        end

        pcall(function()
            rSpawn:InvokeServer(TOY_NAME, hrp.CFrame * CFrame.new(0, 5, -5), Vector3.zero)
        end)
        _TrackItem(TOY_NAME)

        inv = inv or workspace:WaitForChild(LP.Name .. "SpawnedInToys", 5)
        if not inv then notify("Pallet FX", "Inventaire introuvable", 3) return end

        local found
        local t0 = tick()
        repeat
            task.wait(0.05)
            for _, c in ipairs(inv:GetChildren()) do
                if c.Name == TOY_NAME and not before[c] then found = c break end
            end
        until found or tick() - t0 > 5

        if not found then notify("Pallet FX", "Pallet non trouvé", 3) return end

        S.pallet = found
        S.part   = getMainPart(found)
        buildFX()
        notify("Pallet FX", "Palletbrown spawn avec effets !", 3)
    end

    local function removePallet()
        if S.pallet and S.pallet.Parent then
            local menu = RS:FindFirstChild("MenuToys")
            local rDestroy = menu and menu:FindFirstChild("DestroyToy")
            if rDestroy then pcall(function() rDestroy:FireServer(S.pallet) end) end
        end
        clearFX()
        S.pallet, S.part = nil, nil
    end

    -- ---------------------------------------------------------------
    -- BOUCLE : arc-en-ciel / pulsation / flottement
    -- ---------------------------------------------------------------
    local hue, angle, lastOwner = 0, 0, 0
    _TrackConn(RunService.Heartbeat:Connect(function(dt)
        local model = S.pallet
        if not model then return end
        if not model.Parent then
            -- pallet détruit (ex. par un autre module) : on nettoie
            clearFX()
            S.pallet, S.part = nil, nil
            return
        end

        local t = tick()

        if S.rainbow then
            hue = (hue + dt * 0.25 * S.rainbowSpeed) % 1
            paint(Color3.fromHSV(hue, 1, 1))
        end

        if S.pulse then
            local a = 0.25 + 0.25 * (math.sin(t * 4) + 1) / 2
            for _, p in ipairs(fx.parts) do
                if p.Parent then p.Transparency = a end
            end
        end

        if S.float and S.part and S.part.Parent then
            local char = LP.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                angle = angle + dt * S.spin
                if t - lastOwner > 1 then
                    lastOwner = t
                    pcall(function()
                        RS.GrabEvents.SetNetworkOwner:FireServer(S.part, S.part.CFrame)
                    end)
                end
                S.part.CFrame = hrp.CFrame * CFrame.new(0, S.floatH, -5) * CFrame.Angles(0, angle, 0)
                S.part.AssemblyLinearVelocity  = Vector3.zero
                S.part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end))

