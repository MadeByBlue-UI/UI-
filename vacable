-- CUSTOM BLACK HOLE  (Fun)
-- =========================================================================
do
    local BHBlock = Tabs.Toys:CreateBlock({ Name = "Black Hole", Side = "Left" })

    -- ---- IDs disponibles (ajoute tes IDs ici après test) ----
    local BH_PRESETS = {
        ["Default (111278758469077)"] = "rbxassetid://111278758469077",
        -- Ajoute d'autres ici après test :
        -- ["Mon Custom 2"] = "rbxassetid://TONIDICI",
    }

    local BH_presetNames = {}
    for k in pairs(BH_PRESETS) do table.insert(BH_presetNames, k) end
    table.sort(BH_presetNames)

    -- ---- Fonctions copies de BlackHoleCustom ----
    local BH_RunService   = game:GetService("RunService")
    local BH_targetAsset  = BH_PRESETS["Default (111278758469077)"]
    local BH_loadedModel  = nil
    local BH_loadedAssetId = nil   -- track quel asset est charg
    local BH_Active       = false
    local BH_Watcher      = nil  -- connexion workspace.DescendantAdded

    -- Charge le modle (recharge si l'asset a chang)
    function BH_LoadModel()
        if BH_loadedModel and BH_loadedAssetId == BH_targetAsset then return end
        BH_loadedModel  = nil
        BH_loadedAssetId = BH_targetAsset
        local ok, result = pcall(function()
            return game:GetObjects(BH_targetAsset)[1]
        end)
        if ok and result then
            BH_loadedModel = result
            Library:Notify({ Title = "Black Hole", Content = "Modle charg ", Duration = 2 })
        else
            Library:Notify({ Title = "Black Hole", Content = "Impossible de charger cet asset !", Duration = 4 })
        end
    end

    function BH_scaleNS(ns, mul)
        if not ns then return end
        local kps = {}
        for _, kp in ipairs(ns.Keypoints) do
            table.insert(kps, NumberSequenceKeypoint.new(kp.Time, kp.Value * mul, kp.Envelope * mul))
        end
        return NumberSequence.new(kps)
    end

    function BH_scaleNR(nr, mul)
        if not nr then return end
        return NumberRange.new(nr.Min * mul, nr.Max * mul)
    end

    function BH_watchForDrone(holeObj)
        for _, c in pairs(holeObj:GetDescendants()) do
            if c.Name == "Drone" then
                task.defer(function() if c and c.Parent then c:Destroy() end end)
            end
        end
        _TrackConn(holeObj.DescendantAdded:Connect(function(c)
            if c.Name == "Drone" then
                task.defer(function() if c and c.Parent then c:Destroy() end end)
            end
        end))
    end

    function BH_applyChanges(child)
        if child.Name == "Drone" then
            task.defer(function() if child and child.Parent then child:Destroy() end end)
            return
        end

        if child.Name == "BillboardGui" and child:IsA("BillboardGui") then
            function hideGui()
                child.Enabled = false
                for _, el in pairs(child:GetDescendants()) do
                    pcall(function() el.BackgroundTransparency = 1 end)
                    pcall(function() el.TextTransparency       = 1 end)
                    pcall(function() el.ImageTransparency      = 1 end)
                end
            end
            hideGui()
            _TrackConn(child.Changed:Connect(hideGui))
            _TrackConn(child.DescendantAdded:Connect(hideGui))

        elseif child.Name == "Hole" and child:IsA("BasePart") then
            task.wait(0.1)
            child.Transparency = 1
            _TrackConn(child:GetPropertyChangedSignal("Transparency"):Connect(function()
                if child.Transparency ~= 1 then child.Transparency = 1 end
            end))

            if BH_loadedModel and not child:GetAttribute("HasCustomHole") then
                child:SetAttribute("HasCustomHole", true)

                local clone = BH_loadedModel:Clone()
                clone.Name  = "CustomHoleModel"
                clone.Parent = workspace

                local rotOff    = CFrame.Angles(math.rad(90), 0, 0)
                local origProps = {}

                function saveProps(obj)
                    if obj:IsA("BasePart") then
                        origProps[obj] = { Size = obj.Size }
                    elseif obj:IsA("SpecialMesh") or obj:IsA("BlockMesh") or obj:IsA("CylinderMesh") then
                        origProps[obj] = { Scale = obj.Scale }
                    elseif obj:IsA("Attachement") then
                        origProps[obj] = { Position = obj.Position }
                    elseif obj:IsA("ParticleEmitter") then
                        origProps[obj] = { Size = obj.Size, Speed = obj.Speed }
                    elseif obj:IsA("Beam") then
                        origProps[obj] = { Width0 = obj.Width0, Width1 = obj.Width1, CurveSize0 = obj.CurveSize0, CurveSize1 = obj.CurveSize1 }
                    elseif obj:IsA("Trail") then
                        origProps[obj] = { WidthScale = obj.WidthScale }
                    elseif obj:IsA("PointLight") or obj:IsA("SurfaceLight") or obj:IsA("SpotLight") then
                        origProps[obj] = { Range = obj.Range }
                    end
                end

                if clone:IsA("Model") then
                    local cf = clone:GetBoundingBox()
                    for _, part in pairs(clone:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Anchored    = false
                            part.CanCollide  = false
                            local offset     = cf:ToObjectSpace(part.CFrame)
                            part.CFrame      = (child.CFrame * rotOff) * offset
                            local weld       = Instance.new("WeldConstraint")
                            weld.Part0       = part; weld.Part1 = child; weld.Parent = part
                            for _, att in pairs(part:GetChildren()) do
                                if att:IsA("Attachement") then att.CFrame = rotOff * att.CFrame end
                            end
                        end
                        if part:IsA("Script") then
                            part.Disabled = true
                            local ns = Instance.new("Script")
                            ns.Source = "local part=script.Parent\nlocal s=0.015\nwhile task.wait()do\npart.CFrame=part.CFrame*CFrame.Angles(0,s,0)\nend"
                            ns.Parent = part.Parent
                        end
                    end
                    for _, obj in pairs(clone:GetDescendants()) do
                        if obj:IsA("Script") and not obj.Disabled then
                            obj.Disabled = true
                            local ns = Instance.new("Script")
                            ns.Source = "local part=script.Parent\nlocal s=0.015\nwhile task.wait()do\npart.CFrame=part.CFrame*CFrame.Angles(0,s,0)\nend"
                            ns.Parent = obj.Parent
                        end
                    end
                elseif clone:IsA("BasePart") then
                    clone.Anchored   = false
                    clone.CanCollide = false
                    clone.CFrame     = child.CFrame * rotOff
                    for _, att in pairs(clone:GetChildren()) do
                        if att:IsA("Attachement") then att.CFrame = rotOff * att.CFrame end
                    end
                    local weld  = Instance.new("WeldConstraint")
                    weld.Part0  = clone; weld.Part1 = child; weld.Parent = clone
                end

                -- Son
                local soundPart = clone:IsA("BasePart") and clone or clone:FindFirstChildWhichIsA("BasePart", true)
                local bhSound
                if soundPart then
                    bhSound = Instance.new("Sound")
                    bhSound.SoundId           = "rbxassetid://110446451982239"
                    bhSound.PlaybackSpeed     = 0.5
                    bhSound.Volume            = 1.8
                    bhSound.Looped            = true
                    bhSound.RollOffMaxDistance= 130
                    bhSound.RollOffMinDistance= 15
                    bhSound.Parent            = soundPart
                    bhSound:Play()
                end

                saveProps(clone)
                for _, obj in pairs(clone:GetDescendants()) do saveProps(obj) end

                local isDestroying = false
                local shrinkAlpha  = 1
                local shrinkSpeed  = 1

                function onHoleDestroyed()
                    if isDestroying then return end
                    isDestroying = true
                    for _, obj in pairs(clone:GetDescendants()) do
                        if obj:IsA("BasePart") then obj.Anchored = true end
                    end
                    if clone:IsA("BasePart") then clone.Anchored = true end
                end

                _TrackConn(child.AncestryChanged:Connect(function(_, newParent)
                    if not newParent then onHoleDestroyed() end
                end))

                local conn
                conn = BH_RunService.Heartbeat:Connect(function(dt)
                    if not clone or not clone.Parent then conn:Disconnect(); return end
                    if isDestroying then
                        shrinkAlpha = shrinkAlpha - (dt * shrinkSpeed)
                        if shrinkAlpha <= 0 then
                            shrinkAlpha = 0
                            conn:Disconnect()
                            clone:Destroy()
                            return
                        end
                        if bhSound then bhSound.Volume = 2 * shrinkAlpha end
                    end

                    local bpScale = 0.5 * shrinkAlpha
                    local fxScale = shrinkAlpha

                    for obj, props in pairs(origProps) do
                        if obj:IsA("BasePart") then
                            obj.Size = props.Size * bpScale
                        elseif obj:IsA("SpecialMesh") or obj:IsA("BlockMesh") or obj:IsA("CylinderMesh") then
                            obj.Scale = props.Scale * bpScale
                        elseif obj:IsA("Attachement") then
                            obj.Position = props.Position * bpScale
                        elseif obj:IsA("ParticleEmitter") then
                            obj.Size = BH_scaleNS(props.Size, fxScale)
                            if props.Speed then obj.Speed = BH_scaleNR(props.Speed, fxScale) end
                        elseif obj:IsA("Beam") then
                            obj.Width0 = props.Width0 * fxScale; obj.Width1 = props.Width1 * fxScale
                            if props.CurveSize0 then obj.CurveSize0 = props.CurveSize0 * fxScale; obj.CurveSize1 = props.CurveSize1 * fxScale end
                        elseif obj:IsA("Trail") then
                            obj.WidthScale = BH_scaleNS(props.WidthScale, fxScale)
                        elseif obj:IsA("PointLight") or obj:IsA("SurfaceLight") or obj:IsA("SpotLight") then
                            obj.Range = props.Range * fxScale
                        end
                    end
                end)
            end
        end
    end

    function BH_handleBlackHoleKick(obj)
        for _, d in pairs(obj:GetDescendants()) do
            if d.Name == "Hole" and d:IsA("BasePart") then BH_watchForDrone(d) end
        end
        _TrackConn(obj.DescendantAdded:Connect(function(d)
            if d.Name == "Hole" and d:IsA("BasePart") then BH_watchForDrone(d) end
        end))
        for _, d in pairs(obj:GetDescendants()) do BH_applyChanges(d) end
        _TrackConn(obj.DescendantAdded:Connect(BH_applyChanges))
    end

    function BH_Start()
        BH_LoadModel()
        -- Applique aux BlackHoleKick déjà présents
        for _, d in pairs(workspace:GetDescendants()) do
            if d.Name == "BlackHoleKick" then BH_handleBlackHoleKick(d) end
        end
        -- Connecte le watcher
        BH_Watcher = workspace.DescendantAdded:Connect(function(d)
            if BH_Active and d.Name == "BlackHoleKick" then
                BH_handleBlackHoleKick(d)
            end
        end)
        _TrackConn(BH_Watcher)
    end

    function BH_Stop()
        BH_Active = false
        if BH_Watcher then
            pcall(function() BH_Watcher:Disconnect() end)
            BH_Watcher = nil
        end
    end

    -- Toggle UI + slecteur d'asset
    BHBlock:CreateDropdown({
        Name     = "Preset Asset",
        Flag     = "BHPresetDropdown",
        Items    = BH_presetNames,
        Default  = BH_presetNames[1],
        Callback = function(v)
            local id = BH_PRESETS[v]
            if id then
                BH_targetAsset  = id
                BH_loadedModel  = nil  -- force rechargement
                BH_loadedAssetId = nil
                if BH_Active then
                    -- Recharge et reconnecte  chaud
                    if BH_Watcher then pcall(function() BH_Watcher:Disconnect() end); BH_Watcher = nil end
                    BH_Start()
                end
            end
        end
    })

    BHBlock:CreateInput({
        Name        = "Custom Asset ID",
        Flag        = "BHCustomID",
        Placeholder = "ex: 111278758469077",
        Callback    = function(v)
            if not v or v == "" then return end
            -- Retire le prfixe si l'utilisateur l'a coll entier
            local numId = v:match("rbxassetid://(.+)") or v:match("%d+")
            if not numId then
                Library:Notify({ Title = "Black Hole", Content = "Format invalide. Entre juste les chiffres.", Duration = 3 })
                return
            end
            BH_targetAsset  = "rbxassetid://" .. numId
            BH_loadedModel  = nil
            BH_loadedAssetId = nil
            -- Test de chargement immdiat
            task.spawn(function()
                local ok, result = pcall(function()
                    return game:GetObjects(BH_targetAsset)[1]
                end)
                if ok and result then
                    BH_loadedModel   = result
                    BH_loadedAssetId = BH_targetAsset
                    -- Vérifie s'il y a bien des BasePart
                    local hasPart = result:IsA("BasePart") or result:FindFirstChildWhichIsA("BasePart", true) ~= nil
                    if hasPart then
