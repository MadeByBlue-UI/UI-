        -- ---- aperçu 3D qui tourne (corps seul, même rig que ton perso) ----
        local function buildPreview(e)
            local nReal = 0
            for _, g in ipairs({ "torso", "larm", "rarm", "lleg", "rleg" }) do
                if X.groupMode(e, g) == "r6" then nReal += 1 end
            end
            local src, usedR15 = nil, false
            if X.myRigName() == "R6" and nReal < 3 then
                src = X.bodyRig(e, "R15") or e.R6   -- personnage R15 : on montre son vrai look
                usedR15 = (src ~= e.R6)
            else
                src = e[X.myRigName()] or e.R15 or e.R6
            end
            if not src then return end
            local m = src:Clone()
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("LuaSourceContainer") then d:Destroy() end
            end
            -- ACCESSOIRES / VÊTEMENTS du personnage (antennes, cornes, chapeaux, armures...)
            -- Replacés à la main avec leur soudure d'origine, puis figés (sans physique) :
            -- plus d'objet qui part flotter loin du corps. Fait AVANT le changement de tête.
            local placedAcc = {}
            for _, acc in ipairs(m:GetChildren()) do
                if acc:IsA("Accessory") then
                    local okA, placed = pcall(function()
                        local handle = acc:FindFirstChild("Handle")
                        if not (handle and handle:IsA("BasePart")) then return false end
                        local done = false
                        -- 1) la soudure d'origine donne la vraie position
                        for _, w in ipairs(handle:GetChildren()) do
                            if (w:IsA("Weld") or w:IsA("Motor6D")) and w.Part1 == handle and w.Part0 and w.Part0:IsDescendantOf(m) then
                                handle.CFrame = w.Part0.CFrame * w.C0 * w.C1:Inverse()
                                done = true
                                break
                            end
                        end
                        -- 2) sinon : points d'attache portant le même nom
                        if not done then
                            local att = handle:FindFirstChildWhichIsA("Attachment")
                            if att then
                                for _, d in ipairs(m:GetDescendants()) do
                                    if d:IsA("Attachment") and d.Name == att.Name and d.Parent ~= handle
                                        and d.Parent:IsA("BasePart") and not d:IsDescendantOf(acc) then
                                        handle.CFrame = d.Parent.CFrame * d.CFrame * att.CFrame:Inverse()
                                        done = true
                                        break
                                    end
                                end
                            end
                        end
                        for _, w in ipairs(handle:GetChildren()) do
                            if w:IsA("JointInstance") or w:IsA("WeldConstraint") then w:Destroy() end
                        end
                        handle.Anchored = true
                        return done
                    end)
                    if okA and placed then
                        table.insert(placedAcc, acc)
                    else
                        acc:Destroy()   -- impossible à placer : on ne le montre pas
                    end
                end
            end
            -- TÊTE : on montre celle qui sera VRAIMENT appliquée sur ton corps R6
            -- (ex : personnage sans tête / tête spéciale), pas la tête R15 de base
            if usedR15 and X.groupMode(e, "head") == "r6" and e.R6 then
                local h6 = e.R6:FindFirstChild("Head")
                local h15 = m:FindFirstChild("Head")
                if h6 and h15 and h6:IsA("BasePart") and h15:IsA("BasePart") then
                    local nh = h6:Clone()
                    for _, d in ipairs(nh:GetDescendants()) do
                        if d:IsA("LuaSourceContainer") or d:IsA("JointInstance") then d:Destroy() end
                    end
                    nh.Anchored = true
                    nh.CFrame = h15.CFrame
                    nh.Name = "Head"
                    h15:Destroy()
                    nh.Parent = m
                end
            end
            local root = m:FindFirstChild("HumanoidRootPart")
            if root then root.Anchored = true end
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
            local wm = Instance.new("WorldModel")
            wm.Parent = pv
            m.Parent = wm
            local bMin, bMax
            for _, d in ipairs(m:GetChildren()) do
                if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
                    local lo, hi = boundsOf(d)
                    bMin = bMin and bMin:Min(lo) or lo
                    bMax = bMax and bMax:Max(hi) or hi
                end
            end
            for _, acc in ipairs(placedAcc) do
                local hd = acc:FindFirstChild("Handle")
                if hd and hd:IsA("BasePart") and bMin and bMax then
                    local lo, hi = boundsOf(hd)
                    bMin = bMin:Min(lo)
                    bMax = bMax:Max(hi)
                end
            end
            local center, size
            if bMin and bMax then
                center, size = (bMin + bMax) / 2, bMax - bMin
            else
                local cf0, sz0 = m:GetBoundingBox()
                center, size = cf0.Position, sz0
            end
            size = Vector3.new(math.max(size.X, 1), math.max(size.Y, 1), math.max(size.Z, 1))
            local lv = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
            lv = Vector3.new(lv.X, 0, lv.Z)
            if lv.Magnitude < 0.01 then lv = Vector3.new(0, 0, -1) end
            lv = lv.Unit
            local dist = size.Y * 1.3 / (2 * math.tan(math.rad(pcam.FieldOfView / 2)))
            local ang = 0
            if conn then conn:Disconnect() end
            conn = RunS.Heartbeat:Connect(function(dt)
                if not pv:IsDescendantOf(game) then return end
                ang += dt * 0.9
                local dir = CFrame.Angles(0, ang, 0):VectorToWorldSpace(lv)
                pcam.CFrame = CFrame.lookAt(center + dir * dist + Vector3.new(0, size.Y * 0.04, 0), center)
            end)
            tween(th, 0.5, { ImageTransparency = 1 })
        end

        -- ---- chargement ----
        local function load()
            if not alive then return end
            loaded = nil
            retry.Visible = false
            setInfo("Chargement du personnage...")
            task.spawn(function()
                local e, err = X.loadBundle(id, name)
                if not alive then return end
                if e then
                    loaded = e
                    pcall(X.analyse, e)
                    local n, listOK = 0, {}
                    for _, d in ipairs(PARTS) do
                        local okp = X.groupMode(e, d[1]) ~= nil
                        partRec[d[1]].avail = okp
                        partRec[d[1]].b.BackgroundTransparency = okp and 0.88 or 0.96
                        partRec[d[1]].b.TextTransparency = okp and 0 or 0.65
                        if okp then n += 1; table.insert(listOK, string.lower(d[2])) end
                    end
                    local conv = 0
                    for _, d in ipairs(PARTS) do
                        if X.groupMode(e, d[1]) == "r15" then conv += 1 end
                    end
                    local hw = e.mode and e.mode.headWhy
                    local hh = e.R6 and e.R6:FindFirstChild("Head")
                    local hinfo = hw and (" Tête : " .. hw .. ((hh and hh.Transparency > 0.9) and " (invisible)" or "") .. ".") or ""
                    if n < 6 then
                        changesL.Text = "Utilisables : " .. table.concat(listOK, ", ") .. "." .. hinfo
                    elseif conv > 0 then
                        changesL.Text = conv .. " partie(s) R15 converties pour ton corps R6." .. hinfo
                    else
                        changesL.Text = "Toutes les parties sont utilisables." .. hinfo
                    end
                    setInfo("Prêt : choisis tout le personnage ou une seule partie.")
                    local okPv, errPv = pcall(buildPreview, e)
                    if not okPv then
                        setInfo("Aperçu 3D impossible : " .. tostring(errPv), RED)
                        th.ImageTransparency = 0
                    end
                    paint()
                else
                    setInfo("Échec du chargement : " .. tostring(err), RED)
                    retry.Visible = true
                end
            end)
        end
        _TrackConn(retry.MouseButton1Click:Connect(function()
            sfx("click")
            load()
        end))
        load()
    end

