task.wait(0.05)
                                end
                                task.wait(0.2)
                                jumping = false
                            end)
                        end
                    end
                end)

                -- Saut en boucle : hold Space = saute d s qu'il touche le sol
                local jumpConn = _RS2.Heartbeat:Connect(function()
                    if not _G_ObjCtrl.active or flyActive or jumping then return end
                    if _G._FigChargeLock and _G._FigChargeLock() then return end   -- 🌀 immobile pendant la charge du lancer
                    if _UIS2:GetFocusedTextBox() then return end  -- stop si chat ouvert
                    if not _UIS2:IsKeyDown(Enum.KeyCode.Space) then return end
                    local velY = targetPart.AssemblyLinearVelocity.Y
                    if math.abs(velY) < 5 then
                        jumping = true
                        targetPart.AssemblyLinearVelocity = Vector3.new(
                            targetPart.AssemblyLinearVelocity.X,
                            objJumpPower,
                            targetPart.AssemblyLinearVelocity.Z
                        )
                        task.spawn(function()
                            task.wait(0.3)
                            while targetPart.Parent and targetPart.AssemblyLinearVelocity.Y > 0 do
                                task.wait(0.05)
                            end
                            task.wait(0.15)
                            jumping = false
                        end)
                    end
                end)

                local camConn = cam.Changed:Connect(function(prop)
                    if prop == "CameraSubject" then cam.CameraSubject = camPivot end
                end)

                -- Mouvement via touches directes + caméra 3me personne déverrouille
                LocalPlayer.CameraMode            = Enum.CameraMode.Classic
                LocalPlayer.CameraMaxZoomDistance = 50
                LocalPlayer.CameraMinZoomDistance = 5
                _UIS2.MouseBehavior = Enum.MouseBehavior.LockCenter

                local moveConn = _RS2.Heartbeat:Connect(function(dt)
                    if not _G_ObjCtrl.active then return end
                    
                    -- Object WallWalk : si activé, utiliser sa logique
                    if _ObjectWallWalk and _ObjectWallWalk.enabled and targetPart == _G_ObjCtrl.part then
                        _ObjectWallWalk:step(dt, bv, bg, objSpeed)
                        camPivot.Position = targetPart.Position
                        return
                    end
                    -- Stop mouvement si le joueur  crit dans le chat
                    if _UIS2:GetFocusedTextBox() then
                        _UIS2.MouseBehavior = Enum.MouseBehavior.Default
                        -- 🛑 Anti "avance tout seul" : sans ça, la dernière vitesse (et le boost Ctrl / FOV) restait figée tant qu'une zone de texte avait le focus
                        boostHeldTime = 0
                        pcall(function()
                            bv.Velocity = bv.Velocity:Lerp(Vector3.new(), 0.25)
                            if _planeEffects then
                                local c = workspace.CurrentCamera
                                c.FieldOfView = c.FieldOfView + (_baseFOV - c.FieldOfView) * 0.1
                                _lastFovSet = c.FieldOfView
                            end
                        end)
                        return
                    end
                    _UIS2.MouseBehavior = Enum.MouseBehavior.LockCenter
                    _snowTimer = (_snowTimer or 0) + dt

                -- Detection grab desactivee (utilise Y pour relancer manuellement)
                local grabConn = nil

                    local cam     = workspace.CurrentCamera
                    local lookDir = cam.CFrame.LookVector

                    -- Mise   jour du camPivot selon le mode de vue
                    do
                        local pos = targetPart.Position
                        local cf  = targetPart.CFrame
                        local activeView = lookBackHeld and "Derrière" or camViewMode
                        local basePos
                        if activeView == "Normal" then
                            basePos = pos
                        elseif activeView == "Droite" then
                            basePos = pos + cf.RightVector * 8
                        elseif activeView == "Gauche" then
                            basePos = pos - cf.RightVector * 8
                        elseif activeView == "Dessus" then
                            basePos = pos + Vector3.new(0, 12, 0)
                        elseif activeView == "Derrière" then
                            basePos = pos - cf.LookVector * 8
                        elseif activeView == "Perso Joueur" then
                            -- Vue fixe derri re le personnage, ind pendante de l'objet
                            local hrpCam = localHRP or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
                            basePos = hrpCam and hrpCam.Position or pos
                        else
                            basePos = pos
                        end
                        -- Applique l'offset XYZ personnalis  en espace local
                        local finalPos = basePos
                            + cf.RightVector   * _camOffX
                            + cf.UpVector      * _camOffY
                            + cf.LookVector    * _camOffZ
                        camPivot.CFrame = CFrame.new(finalPos)
                    end

                    -- Calcul vitesse et mise   jour HUD (toutes les 0.1s)
                    do
                        local curPos = targetPart.Position
                        if _prevPos then
                            _speedTimer = _speedTimer + dt
                            if _speedTimer >= 0.1 then
                                local dist  = (curPos - _prevPos).Magnitude
                                local speed = math.floor(dist / _speedTimer)
                                if _G._HudSpeedLabel then
                                    local col
                                    if speed < 60 then
                                        col = Color3.fromRGB(140, 255, 200)
                                    elseif speed < 200 then
                                        col = Color3.fromRGB(255, 220, 80)
                                    else
                                        col = Color3.fromRGB(255, 110, 110)
                                    end
                                    _G._HudSpeedLabel.Text = speed .. " st/s"
                                    -- Transition couleur fluide
                                    game:GetService("TweenService"):Create(
                                        _G._HudSpeedLabel,
                                        TweenInfo.new(0.3, Enum.EasingStyle.Linear),
                                        { TextColor3 = col }
                                    ):Play()
                                end
                                _prevPos    = curPos
                                _speedTimer = 0
                            end
                        else
                            _prevPos = curPos
                        end
                    end

                    local flat    = Vector3.new(lookDir.X, 0, lookDir.Z)
                    if flat.Magnitude > 0.01 then flat = flat.Unit end
                    local right   = flat:Cross(Vector3.new(0, 1, 0))
                    if right.Magnitude > 0.01 then right = right.Unit end

                    local fwd  = _UIS2:IsKeyDown(Enum.KeyCode.W) or _UIS2:IsKeyDown(Enum.KeyCode.Up)
                    local back = _UIS2:IsKeyDown(Enum.KeyCode.S) or _UIS2:IsKeyDown(Enum.KeyCode.Down)
                    local lft  = _UIS2:IsKeyDown(Enum.KeyCode.A) or _UIS2:IsKeyDown(Enum.KeyCode.Left)
                    local rgt  = _UIS2:IsKeyDown(Enum.KeyCode.D) or _UIS2:IsKeyDown(Enum.KeyCode.Right)
                    -- 🌀 LANCER CHARGÉ (toggle « animation de début de lancer ») : on ne peut plus bouger pendant la charge / l'armement
                    local _chLock = _G._FigChargeLock and _G._FigChargeLock()
                    if _chLock then fwd, back, lft, rgt = false, false, false, false end

                    local boostMult = 1

                    -- Boost Ctrl gauche : x1   x4 en 5 secondes
                    local ctrl = _UIS2:IsKeyDown(Enum.KeyCode.LeftControl)
                    if ctrl then
                        boostHeldTime = math.min(boostHeldTime + dt, 5)
                    else
                        boostHeldTime = math.max(boostHeldTime - dt * 2, 0)
                    end
                    -- 🧗 FIX ESCALADE : pendant l'escalade (et 0.35 s après la traction), le boost Ctrl du déplacement est remis à zéro et la
                    -- vitesse du toy coupée. Avant, il montait jusqu'à x4 contre le mur, puis à l'arrivée sur le rebord la figure repartait
                    -- en grande vitesse = "téléportation en avant". (Le boost Ctrl de la VITESSE DE MONTÉE, lui, reste actif : C.boostT.)
                    do
                        local _FCb = _G._FigureClimb
                        if _FCb and (_FCb.active or (_FCb.endT and os.clock() - _FCb.endT < 0.35)) then
                            boostHeldTime = 0
                            pcall(function() bv.Velocity = Vector3.new() end)
                        end
                    end
                    local ctrlMult = (1 + (boostHeldTime / 5) * 3) * (_G._FigureSpeedMult or 1)  -- 1x   4x (÷4 pendant le Moonwalk)

                    -- 🔭 Ta FOV reste la tienne : si elle a été changée ailleurs (slider, config...), on l'adopte comme nouvelle base
                    do
                        local _camF = workspace.CurrentCamera
                        if math.abs(_camF.FieldOfView - _lastFovSet) > 0.6 then
                            _baseFOV = _camF.FieldOfView - (_planeEffects and (boostHeldTime / 5) * 20 or 0)
                        end
                    end

                    -- Effet visuel boost : vignette + FOV proportionnels   boostHeldTime
                    if _planeEffects then
                        local t = boostHeldTime / 5
                        local smoothE = 0.1
                        local vigTarget = 1 - (t * 0.65)
                        _vigFrame.ImageTransparency = _vigFrame.ImageTransparency
                            + (vigTarget - _vigFrame.ImageTransparency) * smoothE
                        local fovTarget = _baseFOV + t * 20
                        workspace.CurrentCamera.FieldOfView = workspace.CurrentCamera.FieldOfView
                            + (fovTarget - workspace.CurrentCamera.FieldOfView) * smoothE
                        _lastFovSet = workspace.CurrentCamera.FieldOfView
                        local speed = bv.Velocity.Magnitude
                        local targetPitch = 0.8 + (speed / (objSpeed * 4)) * 1.2
                        _jetSound.PlaybackSpeed = _jetSound.PlaybackSpeed
                            + (math.clamp(targetPitch, 0.8, 2.0) - _jetSound.PlaybackSpeed) * 0.05
                        _trail.Enabled = t > 0.3
                        _speedLabel.Text = "SPD  " .. math.floor(speed)
                        _altLabel.Text   = "ALT  " .. math.floor(targetPart.Position.Y)
                        _horizonFrame.Rotation = math.deg(_bankAngle) * -1

                        -- -- COMPAS ----------------------------------------
                        local yaw = math.deg(math.atan2(targetPart.CFrame.LookVector.X, targetPart.CFrame.LookVector.Z))
                        yaw = (yaw + 360) % 360  -- 0-360
                        local dirs = {"N","NE","E","SE","S","SO","O","NO"}
                        local compassText = ""
                        for i = -4, 4 do
                            local angle = (yaw + i * 10) % 360
                            local mark = math.floor(angle / 45)
                            local sub   = angle % 45
                            if sub < 5 or sub > 40 then
                                compassText = compassText .. dirs[mark+1] .. "  "
                            else
                                compassText = compassText .. math.floor(angle) .. "  "
                            end
                        end
                        _compassStrip.Text = compassText
                        local scrollX = ((yaw % 10) / 10) * -32
                        _compassStrip.Position = UDim2.new(0, scrollX - 160, 0, 0)

                        -- -- VARIOM TRE ------------------------------------
                        local curAlt   = targetPart.Position.Y
                        local vario    = curAlt - (_prevAltForVario or curAlt)
                        _prevAltForVario = curAlt
                        local varioVal = math.floor(vario * 10)  -- studs/frame * 10
                        if vario > 0.5 then
                            _varioArrow.Text = "?"; _varioArrow.TextColor3 = Color3.fromRGB(0,255,100)
                            _varioLabel.Text = "+" .. varioVal
                        elseif vario < -0.5 then
                            _varioArrow.Text = "?"; _varioArrow.TextColor3 = Color3.fromRGB(255,80,80)
                            _varioLabel.Text = tostring(varioVal)
                            _varioLabel.TextColor3 = Color3.fromRGB(255,80,80)
                        else
                            _varioArrow.Text = "?"; _varioArrow.TextColor3 = Color3.fromRGB(0,255,100)
                            _varioLabel.Text = "  0"
                            _varioLabel.TextColor3 = Color3.fromRGB(0,255,100)
                        end

                        -- -- G-FORCE ---------------------------------------
                        local bankG  = 1 / math.max(math.cos(math.abs(_bankAngle)), 0.1)
                        local speedG = math.clamp(bv.Velocity.Magnitude / (objSpeed * 2), 0, 3)
                        local rawG   = math.clamp(bankG + speedG * 0.5, 1, 9)
                        _prevGForce  = _prevGForce and (_prevGForce + (rawG - _prevGForce) * 0.1) or rawG
                        local gText  = string.format("%.1f G", _prevGForce)
                        _gforceLabel.Text = gText
                        if _prevGForce > 4 then
                            _gforceLabel.TextColor3 = Color3.fromRGB(255,80,80)
                        elseif _prevGForce > 2 then
                            _gforceLabel.TextColor3 = Color3.fromRGB(255,220,80)
                        else
                            _gforceLabel.TextColor3 = Color3.fromRGB(0,255,100)
                        end
                        -- R ticule : pointe vers o  regarde l'avion (LookVector de l'objet)
                        local planeLook = targetPart.CFrame.LookVector
                        local cam2      = workspace.CurrentCamera
                        -- Projette la direction de l'avion dans l'espace cam ra
                        local camSpace  = cam2.CFrame:VectorToObjectSpace(planeLook)
                        -- camSpace.X = gauche/droite, camSpace.Y = haut/bas sur l' cran
                        local targetLag = Vector2.new(camSpace.X * 200, -camSpace.Y * 200)
                        -- Clamp pour pas sortir de l' cran
                        targetLag = Vector2.new(
                            math.clamp(targetLag.X, -400, 400),
                            math.clamp(targetLag.Y, -300, 300)
                        )
                        _retLag = _retLag:Lerp(targetLag, 0.12)
                        _reticuleFrame.Position = UDim2.new(0.5, _retLag.X, 0.5, _retLag.Y)
                        local gForce = math.clamp(math.abs(_bankAngle) / math.rad(45), 0, 1)
                        _gFrame.ImageTransparency = _gFrame.ImageTransparency
                            + ((1 - gForce * 0.7) - _gFrame.ImageTransparency) * 0.15
                    else
                        workspace.CurrentCamera.FieldOfView = workspace.CurrentCamera.FieldOfView
                            + (_baseFOV - workspace.CurrentCamera.FieldOfView) * 0.1
                        _lastFovSet = workspace.CurrentCamera.FieldOfView
                    end

                    local mX = (rgt  and 1 or 0) - (lft  and 1 or 0)
                    local mZ = (fwd  and 1 or 0) - (back and 1 or 0)

                    -- Dash : appliqué avant fly/normal pour pas être écrasé
                    if _dashVelPending then
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Velocity = _dashVelPending
                        _dashVelPending = nil
                    elseif flyActive then
                        -- Mode Seat Simple en vol
                        if _seatMode then
                            local seatPos = targetPart.Position + Vector3.new(0, _seatHeight, 0)
                            if localHRP then
                                localHRP.CFrame = CFrame.new(seatPos)
                            end
                        end
                        
                        -- Logique de vol normale
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        local lookFull  = cam.CFrame.LookVector
                        local rightFull = cam.CFrame.RightVector
                        local up_key    = _UIS2:IsKeyDown(Enum.KeyCode.Space) and not _chLock
                        local down_key  = (_UIS2:IsKeyDown(Enum.KeyCode.LeftShift) or _UIS2:IsKeyDown(Enum.KeyCode.RightShift)) and not _chLock
                        local moveDir   = Vector3.new()
                        if flyMode == "FaceCamera" or (_G._FigureFaceCamFly and _G._FigureFaceCamFly()) then
                            if fwd  then moveDir = moveDir + lookFull end
                            if back then moveDir = moveDir - lookFull end
                            if rgt  then moveDir = moveDir + rightFull end
                            if lft  then moveDir = moveDir - rightFull end
                        else
                            -- Mode Normal : horizontal seulement via ZQSD + espace/shift pour Y
                            local flatFull = Vector3.new(lookFull.X, 0, lookFull.Z)
                            if flatFull.Magnitude > 0.01 then flatFull = flatFull.Unit end
                            local rightFlat = flatFull:Cross(Vector3.new(0, 1, 0))
                            if rightFlat.Magnitude > 0.01 then rightFlat = rightFlat.Unit end
                            if fwd  then moveDir = moveDir + flatFull end
                            if back then moveDir = moveDir - flatFull end
                            if rgt  then moveDir = moveDir + rightFlat end
                            if lft  then moveDir = moveDir - rightFlat end
                        end
                        -- Espace = monte, Shift = descend (pour les 2 modes)
                        if up_key   then moveDir = moveDir + Vector3.new(0, 1, 0) end
                        if down_key then moveDir = moveDir - Vector3.new(0, 1, 0) end
                        if moveDir.Magnitude > 0.01 then moveDir = moveDir.Unit end
                        local targetVel = moveDir * objSpeed * boostMult * ctrlMult
                        local inertia = _planeEffects and (1 - math.exp(-2.5 * dt)) or 0.06
                        if _driftMode then
                            -- Drift : plus _driftStrength est grand = plus le glisse dure longtemps
                            local driftInertia = 1 - math.exp(-(1 / _driftStrength) * dt)
                            local fwd  = targetVel.Magnitude > 0 and targetVel.Unit or flat
                            local curFwd  = fwd * fwd:Dot(bv.Velocity)
                            local curSide = bv.Velocity - curFwd
                            local newFwd  = curFwd:Lerp(targetVel, inertia)
                            local newSide = curSide:Lerp(Vector3.new(), driftInertia)
                            bv.Velocity = newFwd + newSide
                        else
                            bv.Velocity = bv.Velocity:Lerp(targetVel, inertia)
                        end
                    else
                        bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
                        local targetVel = Vector3.new(
                            (flat * mZ + right * mX).X * objSpeed * boostMult * ctrlMult,
                            0,
                            (flat * mZ + right * mX).Z * objSpeed * boostMult * ctrlMult
                        )
                        local inertia = _planeEffects and (1 - math.exp(-2.5 * dt)) or 0.06
                        if _driftMode then
                            local driftInertia = 1 - math.exp(-(1 / _driftStrength) * dt)
                            local fwd  = targetVel.Magnitude > 0 and targetVel.Unit or flat
                            local curFwd  = fwd * fwd:Dot(bv.Velocity)
                            local curSide = bv.Velocity - curFwd
                            local newFwd  = curFwd:Lerp(targetVel, inertia)
                            local newSide = curSide:Lerp(Vector3.new(), driftInertia)
                            bv.Velocity = newFwd + newSide
                        else
                            bv.Velocity = bv.Velocity:Lerp(targetVel, inertia)
                        end
                    end

                    -- Accumule l'angle de tonneau
                    if _barrelHeld then
                        _barrelAngle = _barrelAngle - math.rad(_barrelSpeed * dt)
                    else
                        _barrelAngle = 0  -- reset quand rel ch 
                    end

                    -- Rotation selon le mode de vol
                    if flyActive and flyMode == "FaceCamera" then
                        local lookDir = cam.CFrame.LookVector
                        local camY = math.atan2(lookDir.X, lookDir.Z)
                        local turnRate = camY - _prevCamY
                        if turnRate > math.pi  then turnRate = turnRate - 2*math.pi  end
                        if turnRate < -math.pi then turnRate = turnRate + 2*math.pi  end
                        _prevCamY = camY
                        local smoothF = 1 - math.exp(-4 * dt)
                        if bankingMode then
                            local targetBank = turnRate * bankingSens
                            _bankAngle = _bankAngle + (targetBank - _bankAngle) * smoothF
                            _bankAngle = math.clamp(_bankAngle, -math.rad(100), math.rad(100))
                        else
                            _bankAngle = _bankAngle + (0 - _bankAngle) * smoothF
                        end
                        _G._formBankAngle = _bankAngle

                        bg.CFrame = CFrame.new(targetPart.Position, targetPart.Position + lookDir)
                            * CFrame.Angles(
                                math.rad(_G_ObjCtrl.rotX or 0),
                                math.rad(_G_ObjCtrl.rotY or 0),
                                math.rad(_G_ObjCtrl.rotZ or 0) + _bankAngle
                            )
                            * CFrame.Angles(_barrelAngle, 0, 0)  -- tonneau sur X (looping en face)
                    elseif flat.Magnitude > 0.01 then
                        bg.CFrame = CFrame.new(targetPart.Position, targetPart.Position + flat)
                            * CFrame.Angles(
                                math.rad(_G_ObjCtrl.rotX or 0),
                                math.rad(_G_ObjCtrl.rotY or 0),
                                math.rad(_G_ObjCtrl.rotZ or 0)
                            )
                            * CFrame.Angles(_barrelAngle, 0, 0)
                    end

                    -- Cabrage (hold) : rotX monte, revient   0 quand rel ch 
                    if _cabrageHeld then
                        _G_ObjCtrl.rotX = math.clamp(_G_ObjCtrl.rotX + _cabrageSpeed * dt, -90, 90)
                    else
                        if _G_ObjCtrl.rotX > 0 then
                            _G_ObjCtrl.rotX = math.max(0, _G_ObjCtrl.rotX - _cabrageSpeed * dt)
                        end
                    end

                    -- -- SPIN 360  (hold) : rotation Y compl te -----------
                    if _spinActive then
                        _spinAngle = (_spinAngle + 300 * dt) % 360
                        _G_ObjCtrl.rotY = _spinAngle
                    end

                    -- -- SNAP DIRECTION : oriente l'objet vers le joueur cibl 
                    if _snapTarget and _snapTarget.Character then
                        local tHRP = _snapTarget.Character:FindFirstChild("HumanoidRootPart")
                        if tHRP then
                            local dir = (tHRP.Position - targetPart.Position)
                            if dir.Magnitude > 0.5 then
                                local snapCF = CFrame.new(targetPart.Position, targetPart.Position + dir.Unit)
                                bg.CFrame = snapCF * CFrame.Angles(
                                    math.rad(_G_ObjCtrl.rotX or 0),
                                    math.rad(_G_ObjCtrl.rotY or 0),
                                    math.rad(_G_ObjCtrl.rotZ or 0)
                                )
                            end
                        end
                    end

                    -- Gravité pente : incline l'objet selon la normale du sol
                    if gravityMode and not flyActive then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterDescendantsInstances = {targetPart.Parent or targetPart}
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        local res = workspace:Raycast(
                            targetPart.Position,
                            Vector3.new(0, -10, 0),
                            rayParams
                        )
                        if res then
                            local normal = res.Normal  -- normale de la surface
                            -- Construit un CFrame aligné sur la normale + direction de l'objet
                            local lookDir = bg.CFrame.LookVector
                            local flatLook = (lookDir - normal * lookDir:Dot(normal))
                            if flatLook.Magnitude > 0.01 then
                                flatLook = flatLook.Unit
                                local rightVec = flatLook:Cross(normal)
                                if rightVec.Magnitude > 0.01 then
                                    rightVec = rightVec.Unit
                                    bg.CFrame = CFrame.fromMatrix(
                                        targetPart.Position,
                                        rightVec,
                                        normal,
                                        -flatLook
                                    ) * CFrame.Angles(
                                        math.rad(_G_ObjCtrl.rotX or 0),
                                        math.rad(_G_ObjCtrl.rotY or 0),
                                        math.rad(_G_ObjCtrl.rotZ or 0)
                                    )
                                end
                            end
                        end
                    end

                    -- Wall Mode : gravite vers la surface la plus proche
                    -- Le mouvement ET l orientation s adaptent a la surface
                    if wallMode then
                        local wpRay = RaycastParams.new()
                        wpRay.FilterDescendantsInstances = {targetPart.Parent or targetPart}
                        wpRay.FilterType = Enum.RaycastFilterType.Exclude
                        -- Raycast dans toutes les directions, prend la plus proche
                        local dirs6 = {
                            Vector3.new(0,-1,0), Vector3.new(0,1,0),
                            Vector3.new(1,0,0),  Vector3.new(-1,0,0),
                            Vector3.new(0,0,1),  Vector3.new(0,0,-1),
                        }
                        local bestRes, bestDist = nil, math.huge
                        for _, dir in ipairs(dirs6) do
                            local r = workspace:Raycast(targetPart.Position, dir * 6, wpRay)
                            if r and r.Distance < bestDist then
                                bestRes = r; bestDist = r.Distance
                            end
                        end
                        if bestRes then
                            local normal = bestRes.Normal  -- pointe VERS l objet depuis la surface
                            -- 1. Colle l objet a la surface (force vers la surface)
                            local distToSurface = bestDist
                            local wantedDist = 2  -- studs de distance cible
                            if distToSurface > wantedDist then
                                -- Attire vers la surface
                                bv.Velocity = bv.Velocity - normal * (distToSurface - wantedDist) * 20 * dt
                            elseif distToSurface < wantedDist - 0.1 then
                                -- Repousse si trop proche
                                bv.Velocity = bv.Velocity + normal * (wantedDist - distToSurface) * 20 * dt
                            end
                            -- 2. Oriente l objet perpendiculairement a la surface
                            local lookDir = bg.CFrame.LookVector
                            local proj = lookDir - normal * lookDir:Dot(normal)
                            if proj.Magnitude < 0.01 then
                                proj = bg.CFrame.RightVector - normal * bg.CFrame.RightVector:Dot(normal)
                            end
                            if proj.Magnitude > 0.01 then
                                proj = proj.Unit
                                local rVec = proj:Cross(normal)
                                if rVec.Magnitude > 0.01 then
                                    bg.CFrame = CFrame.fromMatrix(targetPart.Position, rVec.Unit, normal, -proj)
                                        * CFrame.Angles(math.rad(_G_ObjCtrl.rotX or 0), math.rad(_G_ObjCtrl.rotY or 0), math.rad(_G_ObjCtrl.rotZ or 0))
                                    -- 3. Redirige le mouvement sur le plan de la surface
                                    local camLook = cam.CFrame.LookVector
                                    local fwdOnSurf = (camLook - normal * camLook:Dot(normal))
                                    if fwdOnSurf.Magnitude > 0.01 then fwdOnSurf = fwdOnSurf.Unit end
                                    local rightOnSurf = fwdOnSurf:Cross(normal)
                                    if rightOnSurf.Magnitude > 0.01 then rightOnSurf = rightOnSurf.Unit end
                                    local fwd2  = _UIS2:IsKeyDown(Enum.KeyCode.W) or _UIS2:IsKeyDown(Enum.KeyCode.Up)
                                    local back2 = _UIS2:IsKeyDown(Enum.KeyCode.S) or _UIS2:IsKeyDown(Enum.KeyCode.Down)
                                    local lft2  = _UIS2:IsKeyDown(Enum.KeyCode.A) or _UIS2:IsKeyDown(Enum.KeyCode.Left)
                                    local rgt2  = _UIS2:IsKeyDown(Enum.KeyCode.D) or _UIS2:IsKeyDown(Enum.KeyCode.Right)
                                    local wallMove = Vector3.zero
                                    if fwd2  then wallMove = wallMove + fwdOnSurf  end
                                    if back2 then wallMove = wallMove - fwdOnSurf  end
                                    if rgt2  then wallMove = wallMove + rightOnSurf end
                                    if lft2  then wallMove = wallMove - rightOnSurf end
                                    if wallMove.Magnitude > 0.01 then
                                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                        bv.Velocity = bv.Velocity:Lerp(wallMove * objSpeed, 0.15)
                                    end
                                end
                            end
                        end
                    end


                    -- Align Velocity : oriente l objet dans sa direction de mouvement
                    if alignVelMode and bv.Velocity.Magnitude > 2 then
                        local velDir = bv.Velocity.Unit
                        local flatVel = Vector3.new(velDir.X, 0, velDir.Z)
                        if flatVel.Magnitude > 0.01 then
                            bg.CFrame = CFrame.new(targetPart.Position, targetPart.Position + flatVel)
                                * CFrame.Angles(math.rad(_G_ObjCtrl.rotX or 0), math.rad(_G_ObjCtrl.rotY or 0), math.rad(_G_ObjCtrl.rotZ or 0))
                        end
                    end

                    -- Flottaison : oscillation verticale douce
                    if floatMode then
                        _floatTime = _floatTime + dt
                        local floatOffset = math.sin(_floatTime * 1.5) * 0.3
                        bv.Velocity = Vector3.new(bv.Velocity.X, floatOffset * 10, bv.Velocity.Z)
                    end

                    -- Suiveur de sol : reste a floorFollowHeight studs du sol
                    if floorFollowMode then
                        local flrRay = RaycastParams.new()
                        flrRay.FilterDescendantsInstances = {targetPart.Parent or targetPart}
                        flrRay.FilterType = Enum.RaycastFilterType.Exclude
                        local flrRes = workspace:Raycast(targetPart.Position, Vector3.new(0, -100, 0), flrRay)
                        if flrRes then
                            local targetY = flrRes.Position.Y + floorFollowHeight
                            local diffY   = targetY - targetPart.Position.Y
                            bv.MaxForce   = Vector3.new(math.huge, math.huge, math.huge)
                            bv.Velocity   = Vector3.new(bv.Velocity.X, diffY * 15, bv.Velocity.Z)
                        end
                    end

                    -- SNOWship toutes les 2 secondes
                    if _snowTimer >= 2 then
                        SNOWshipOnce(targetPart)
                        _snowTimer = 0

                        -- Renouvelle ownership sur les wagons en suivi
                        if _trainWagons then
                            for _, wr in ipairs(_trainWagons) do
                                if wr and wr.Parent then
                                    SNOWshipOnce(wr)
                                end
                            end
                        end
                    end

                    -- Suivi des autres TractorGreen en chenille derriere le toy controle (AMÉLIO RÉ)
                    if _trainActive and _trainWagons and targetPart.Name == "TractorGreen" then
                        for i, wRoot in ipairs(_trainWagons) do
                            if not wRoot or not wRoot.Parent then continue end
                            
                            -- Référence : wagon précédent ou leader
                            local refPos = (i == 1) and targetPart.Position
                                or (_trainWagons[i-1] and _trainWagons[i-1].Parent
                                    and _trainWagons[i-1].Position
                                    or targetPart.Position)
                            
                            local myPos  = wRoot.Position
                            local toRef  = Vector3.new(refPos.X - myPos.X, 0, refPos.Z - myPos.Z)
                            local dist   = toRef.Magnitude

                            -- BodyVelocity pour mouvement
                            local wbv = wRoot:FindFirstChild("_TrainBV")
                            if not wbv then
                                wbv = Instance.new("BodyVelocity")
                                wbv.Name     = "_TrainBV"
                                wbv.MaxForce = Vector3.new(9e9, 0, 9e9)  -- Y = 0 pour laisser la gravité
                                wbv.Velocity = Vector3.zero
                                wbv.Parent   = wRoot
                            end
                            
                            -- BodyGyro pour rotation (regarde le wagon précédent)
                            local wbg = wRoot:FindFirstChild("_TrainBG")
                            if not wbg then
                                wbg = Instance.new("BodyGyro")
                                wbg.Name      = "_TrainBG"
                                wbg.MaxTorque = Vector3.new(0, 9e9, 0)  -- Rotation Y seulement
                                wbg.D = 1000
                                wbg.P = 10000
                                wbg.CFrame = wRoot.CFrame
                                wbg.Parent = wRoot
                            end

                            -- Rotation vers le wagon précédent (amélioration)
                            if dist > 1 then
                                local lookCF = CFrame.new(myPos, Vector3.new(refPos.X, myPos.Y, refPos.Z))
                                wbg.CFrame = lookCF
                            end
                            
                            -- Mouvement vers le wagon précédent (espacement amélioré)
                            local targetDist = _trainSpacing or 15
                            if dist > targetDist + 2 then
                                -- Trop loin : avance vite
                                local speed = math.clamp((dist - targetDist) * 8, 5, 80)
                                wbv.Velocity = toRef.Unit * speed
                            elseif dist < targetDist - 2 then
                                -- Trop proche : recule
                                local speed = math.clamp((targetDist - dist) * 5, 3, 40)
                                wbv.Velocity = -toRef.Unit * speed
                            else
                                -- Parfait espacement : ralentit
                                wbv.Velocity = toRef.Unit * 2
                            end
                        end
                    end
                end)

                while targetPart.Parent and _G_ObjCtrl.active
                    and localChar and localChar.Parent do
                    if localHRP and localHRP.Parent then
                        -- Verifie si quelqu'un d'autre grab le toy
                        local grabParts = workspace:FindFirstChild("GrabParts")
                        if grabParts then
                            local gp   = grabParts:FindFirstChild("GrabPart")
                            local weld = gp and gp:FindFirstChild("WeldConstraint")
                            local held = weld and weld.Part1
                            if held and held:IsDescendantOf(targetPart.Parent or targetPart) then
                                local owner = held:FindFirstChild("PartOwner")
                                if owner and owner.Value ~= LocalPlayer.Name then
                                    -- Quelqu'un d'autre grab le toy : reprend l'ownership immediatement
                                    SNOWshipOnce(targetPart)
                                    SNOWshipOnce(held)
                                end
                            end
                        end

                        -- Mode Seat Simple : juste se mettre au-dessus de l'objet
                        if _seatMode then
                            local seatPos = targetPart.Position + Vector3.new(0, _seatHeight, 0)
                            if localHRP then
                                localHRP.CFrame = CFrame.new(seatPos)
                            end
                        -- VC normal
                        elseif _vcHeld or _vcToggle then
                            -- Calcul offset selon position choisie
                            local vcOffset
                            local d = _vcDist
                            if _vcPos == "Dessous" then
                                vcOffset = Vector3.new(0, -d, 0)
                            elseif _vcPos == "Droite" then
                                vcOffset = targetPart.CFrame.RightVector * d
                            elseif _vcPos == "Gauche" then
                                vcOffset = -targetPart.CFrame.RightVector * d
                            elseif _vcPos == "Derrière" then
                                vcOffset = -targetPart.CFrame.LookVector * d
                            elseif _vcPos == "Devant" then
                                vcOffset = targetPart.CFrame.LookVector * d
                            else
                                vcOffset = Vector3.new(0, -d, 0)
                            end

                            if _vcMethod == "UFO -dist" then
                                -- M thode 1 (principale) : m me que -50 UFO, juste offset
                                targetPos = targetPart.Position + vcOffset

                            elseif _vcMethod == "Position fixe + offset" then
                                -- M thode 2 : reste   la position fixe mais l g rement d cal 
                                targetPos = objFixedPos + vcOffset

                            elseif _vcMethod == "Sous la map" then
                                -- M thode 3 : tp directement sous la map (-500 Y)
                                targetPos = Vector3.new(
                                    targetPart.Position.X,
                                    -500,
                                    targetPart.Position.Z
                                )

                            elseif _vcMethod == "Dans l'objet" then
                                -- M thode 4 : tp exactement   la position de l'objet (dans l'objet)
                                targetPos = targetPart.Position

                            elseif _vcMethod == "Suivi smooth" then
                                -- M thode 5 : HRP lerp vers l'objet + offset, mouvement fluide
                                local wantedPos = targetPart.Position + vcOffset
                                local currentPos = localHRP.Position
                                targetPos = currentPos:Lerp(wantedPos, 0.15)

                            elseif _vcMethod == "Orbit" then
                                -- M thode 6 : orbite autour de l'objet,  vite les collisions
                                local orbitAngle = tick() * 1.5  -- 1.5 rad/s
                                targetPos = targetPart.Position + Vector3.new(
                                    math.cos(orbitAngle) * d,
                                    -2,
                                    math.sin(orbitAngle) * d
                                )

                            elseif _vcMethod == "Sol sous objet" then
                                -- M thode 7 : Raycast vers le sol sous l'objet, perso pos  dessus
                                local rayOrigin = targetPart.Position
                                local rayDir    = Vector3.new(0, -200, 0)
                                local rayParams = RaycastParams.new()
                                rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent or targetPart}
                                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                local result = workspace:Raycast(rayOrigin, rayDir, rayParams)
                                if result then
                                    targetPos = result.Position + Vector3.new(0, 3, 0)  -- 3 studs au dessus du sol
                                else
                                    targetPos = targetPart.Position + Vector3.new(0, -d, 0)
                                end

                            elseif _vcMethod == "Miroir cam ra" then
                                -- M thode 8 : perso en miroir de la cam ra par rapport   l'objet
                                local camDir = (workspace.CurrentCamera.CFrame.Position - targetPart.Position)
                                if camDir.Magnitude > 0.01 then
                                    targetPos = targetPart.Position - camDir.Unit * d
                                else
                                    targetPos = targetPart.Position + Vector3.new(0, -d, 0)
                                end

                            elseif _vcMethod == "Dans le sol" then
                                -- M thode 9 : juste sous la surface du sol (cach  sous la texture)
                                local rayParams2 = RaycastParams.new()
                                rayParams2.FilterDescendantsInstances = {LocalPlayer.Character}
                                rayParams2.FilterType = Enum.RaycastFilterType.Exclude
                                local res2 = workspace:Raycast(
                                    targetPart.Position,
                                    Vector3.new(0, -200, 0),
                                    rayParams2
                                )
                                if res2 then
                                    targetPos = res2.Position - Vector3.new(0, 3, 0)  -- 3 studs sous la surface
                                else
                                    targetPos = targetPart.Position + Vector3.new(0, -d, 0)
                                end

                            elseif _vcMethod == "Hors map" then
                                -- M thode 10 : tp tr s loin hors de la map, m me XZ que l'objet
                                -- La voix porte quand m me si dans le rayon Roblox (~60 studs)
                                -- Mais le perso est hors de la zone visible
                                targetPos = targetPart.Position
                                    + Vector3.new(0, -500, 0)  -- sous la map + XZ identique = invisible + voix OK
                            end
                        else
                            if objTpMode == "Position fixe" then
                                targetPos = objFixedPos
                            else
                                targetPos = targetPart.Position + Vector3.new(0, objHideOffset, 0)
                            end
                        end
                        if _vcHeld then
                            -- VC : noclip + rotation neutre pour éviter de toucher l'objet
                            if localChar and not _vcCollSaved then
                                _vcCollSaved = {}
                                for _, p in ipairs(localChar:GetDescendants()) do
                                    if p:IsA("BasePart") then
                                        _vcCollSaved[p] = p.CanCollide
                                        p.CanCollide = false
                                    end
                                end
                            end
                            localHRP.CFrame = CFrame.new(targetPos)
                            task.wait()
                            if localHRP.Parent then
                                localHRP.CFrame = CFrame.new(targetPos)
                            end
                        else
                            -- Restaure les collisions originales quand N relâché
                            if _vcCollSaved then
                                for p, v in pairs(_vcCollSaved) do
                                    if p and p.Parent then p.CanCollide = v end
                                end
                                _vcCollSaved = nil
                            end
                            localHRP.CFrame = localHRP.CFrame.Rotation + targetPos
                            task.wait()
                            if localHRP.Parent then
                                localHRP.CFrame = localHRP.CFrame.Rotation + targetPos
                            end
                        end
                    end
                    task.wait()
                end

                -- Nettoyage
                jumpConn:Disconnect()
                camConn:Disconnect()
                moveConn:Disconnect()
                flyConn:Disconnect()
                if grabConn then grabConn:Disconnect() end

                -- Restaure les collisions du perso si VC était actif
                if _vcCollSaved then
                    for p, v in pairs(_vcCollSaved) do
                        if p and p.Parent then p.CanCollide = v end
                    end
                    _vcCollSaved = nil
                end
                -- Restaure chaque part à son état CanCollide original (pas juste tout à true)
                if _charCollSaved then
                    for p, v in pairs(_charCollSaved) do
                        if p and p.Parent then p.CanCollide = v end
                    end
                    _charCollSaved = nil
                end

                -- Reset vélocité  de l'objet pour  viter qu'il saute   la sortie
                pcall(function()
                    targetPart.AssemblyLinearVelocity = Vector3.zero
                end)
                if _vcObjCollSaved then
                    for p, v in pairs(_vcObjCollSaved) do
                        if p and p.Parent then pcall(function() p.CollisionGroup = v end) end
                    end
                    _vcObjCollSaved = nil
                end

                local finalPos = targetPart.Position

                if bv.Parent    then bv:Destroy()     end
                if bg.Parent    then bg:Destroy()     end
                -- Zero la vélocité du HRP avant de détruire bvLocal
                -- pour éviter que le perso continue de "voler" en première personne
                if localHRP and localHRP.Parent then
                    localHRP.AssemblyLinearVelocity = Vector3.zero
                end
                if bvLocal.Parent then bvLocal:Destroy() end
                if camPivot and camPivot.Parent then camPivot:Destroy() end
                -- Nettoie vignette et restaure FOV
                if _hudGui and _hudGui.Parent then _hudGui:Destroy() end
                workspace.CurrentCamera.FieldOfView = _baseFOV
                if _jetSound and _jetSound.Parent then _jetSound:Destroy() end
                if _cabinSound and _cabinSound.Parent then _cabinSound:Destroy() end

                cam.CameraSubject = localHum
                -- makeCharacterGrabbable comme RealBlitz
                if localChar then
                    for _, v in ipairs(localChar:GetChildren()) do
                        if v:IsA("BasePart") then v.CanQuery = true end
                    end
                end
                -- Tp le perso  la position de l'objet
                if localHRP and localHRP.Parent then
                    localHRP.CFrame = CFrame.new(finalPos + Vector3.new(0, 3, 0))
                end
                if localHRP then localHRP.AssemblyLinearVelocity = Vector3.zero end
                LocalPlayer.CameraMode            = Enum.CameraMode.Classic
                LocalPlayer.CameraMaxZoomDistance = 400
                LocalPlayer.CameraMinZoomDistance = 0.5
                _UIS2.MouseBehavior = Enum.MouseBehavior.Default
                _G_ObjCtrl.active  = false
                _G._formRefPart    = nil
                _G._formBankAngle  = 0
                _G._ObjCtrlFlying  = false
                -- Nettoie les wagons train
                if _trainWagons then
                    for _, wr in ipairs(_trainWagons) do
                        if wr and wr.Parent then
                            local bv = wr:FindFirstChild("_TrainBV")
                            local bg = wr:FindFirstChild("_TrainBG")
                            if bv then bv:Destroy() end
                            if bg then bg:Destroy() end
                            pcall(function() wr.AssemblyLinearVelocity = Vector3.zero end)
                        end
                    end
                    _trainWagons = nil
                end
                cam.CameraType     = Enum.CameraType.Custom  -- restaure si looping  tait actif
                -- Cache la bulle vitesse
                if _G._HudSpeedFrame then
                    _G._HudSpeedFrame.Visible = false
                    if _G._HudSpeedLabel then _G._HudSpeedLabel.Text = "0 st/s" end
                end
                fxObjOut(targetPart)
                _G_ObjCtrl.objPart = nil
            end

