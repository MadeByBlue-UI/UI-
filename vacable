                        game:GetService("TweenService"):Create(p, TweenInfo.new(0.6), { Transparency = 1 }):Play()
                        game:GetService("Debris"):AddItem(p, 0.8)
                    end)
                end
            end)
        end

        function FG.buryStart(C)
            if C.bury or not (C.root and C.root.Parent) then return end
            local style = FG.buryStyles[FG.action]
            if not style then return end
            local char = C.root.Parent
            local ign = {}
            if LP.Character then ign[#ign + 1] = LP.Character end
            ign[#ign + 1] = char
            local inv = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
            if inv then ign[#ign + 1] = inv end
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = ign
            local pos = C.root.Position
            local hit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -400, 0), rp)
            local gy = hit and hit.Position.Y or (pos.Y - 3)
            -- le joueur : noclip + massless (local, on est owner de ses parts)
            local saved = {}
            for _, q in ipairs(char:GetDescendants()) do
                if q:IsA("BasePart") then saved[q] = { q.CanCollide, q.Massless }; q.CanCollide = false; q.Massless = true end
            end
            local rot0 = C.root.CFrame - C.root.CFrame.Position
            local _, yaw = rot0:ToOrientation()
            local h = math.max(2.5, ((C.hum and C.hum.HipHeight) or 2) + C.root.Size.Y / 2)
FG.toyNoclip(true)
FG.buryLock(true)   -- 🔒 plus aucun mouvement possible pendant toute l'animation
local gcol = Color3.fromRGB(120, 92, 62)    -- couleur de la terre / poussière : celle du sol sous le joueur
pcall(function()
    local gi = hit and hit.Instance
    if gi and gi:IsA("BasePart") and not gi:IsA("Terrain") then gcol = gi.Color end
end)
C.bury = { t0 = os.clock(), gy = gy, x = pos.X, z = pos.Z, y0 = pos.Y, saved = saved, style = style,
           dur = math.max(FG.buryDur or 6, 5), rot0 = rot0, yaw = yaw, rest = style.rest or h,
           name = C.plr.Name, fx = style.big and { parts = {}, col = gcol } or nil }
-- la formation passe en pose « genou à terre » (genou opposé au bras qui tient) et se tourne vers le joueur
local hs = (C.hand == 7) and -1 or 1
local hrp0 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
local f0 = hrp0 and Vector3.new(hrp0.CFrame.LookVector.X, 0, hrp0.CFrame.LookVector.Z) or Vector3.new(0, 0, 1)
f0 = (f0.Magnitude > 0.05) and f0.Unit or Vector3.new(0, 0, 1)
local _oldBY = _G._FigureBury
if not _oldBY then
    C.bury.prevMode = figureAnimationMode
    figureAnimationMode = "Bury"
elseif _oldBY.out then
    C.bury.prevMode = _oldBY.prev      -- il se relevait encore : on garde l'animation d'avant le tout premier enterrement
end
if _oldBY and not _oldBY.out then C.bury.prevMode = _oldBY.prev0 end   -- 2e joueur enterré en même temps : même animation d'origine
-- vp = position regardée dès la 1re frame : la tête est pilotée par l'animation tout de suite (jamais par la caméra)
_G._FigureBury = { t0 = os.clock(), kneel = -hs, push = 0, fwd = f0, right = f0:Cross(Vector3.yAxis), vp = pos, prev0 = C.bury.prevMode, big = style.big }
notify("Grab Figure", "⚰️ " .. C.plr.Name .. " : genou à terre, regard " .. (FG.buryStare or 2) .. " s, puis enfoncement (" .. math.floor(C.bury.dur) .. " s)", 3)
        end

        -- position + rotation du joueur à cet instant : montée -> claque au sol -> enfoncement par à-coups -> maintien
        function FG.buryStep(C)
            -- ⚰️ ENTERREMENT (version simple) : 1) il monte  2) il flotte, la formation le regarde  3) claque au sol  4) s'enfonce droit  5) maintien puis relâché
            -- Aucun tremblement ajouté : seul le mouvement vertical + la rotation du style. La formation fait face au joueur (BY.fwd), la tête le regarde.
            local B = C.bury
            local e, D, st = os.clock() - B.t0, B.dur, B.style
            local tA, tL, tS = 0.7, (FG.buryStare or 2), 0.35        -- montée / regard / claque ; ensuite l'enfoncement dure D
            local function ease(k) k = math.clamp(k, 0, 1); return k * k * (3 - 2 * k) end
            local standY = B.gy + B.rest                              -- hauteur du joueur posé sur le sol
            local depth  = st.dRel and (B.rest + st.dRel) or (FG.burySink or 20)   -- profondeur finale
            local hover  = standY + 1.8                               -- hauteur où il flotte
            local x, z = B.x, B.z

            -- rotation : de la rotation d'origine vers celle du style (debout / tête en bas / à plat / dos / côté)
            local yawCF = CFrame.Angles(0, B.yaw, 0)
            local tgt = yawCF
            if st.rot == "inv" then tgt = yawCF * CFrame.Angles(math.pi, 0, 0)
            elseif st.rot == "flat" then tgt = yawCF * CFrame.Angles(-math.pi / 2, 0, 0)
            elseif st.rot == "back" then tgt = yawCF * CFrame.Angles(math.pi / 2, 0, 0)
            elseif st.rot == "side" then tgt = yawCF * CFrame.Angles(0, 0, math.pi / 2) end
            local rot = B.rot0:Lerp(tgt, ease(e / tA))

            local BY = _G._FigureBury
            local y, push, ez, k = standY, 0, 0, 0
            if e < tA then
                y = B.y0 + (hover - B.y0) * ease(e / tA)                       -- 1) montée
            elseif e < tA + tL then
                y = hover                                                       -- 2) il flotte (la formation le regarde)
            elseif e < tA + tL + tS then
                push = (e - tA - tL) / tS
                y = hover - (hover - standY) * push * push                      -- 3) claque au sol
            else
                push = 1
                if not B.hit then B.hit = true; FG.buryFx(Vector3.new(B.x, B.gy, B.z)) end
                k = math.clamp((e - tA - tL - tS) / math.max(D, 0.5), 0, 1)
                ez = ease(k)
                y = standY - depth * ez                                         -- 4) enfoncement droit, fluide
                if st.rot == "spin" then rot = rot * CFrame.Angles(0, ez * math.pi * 16, 0) end   -- tire-bouchon
            end
            B.k, B.ez = k, ez

            if BY then
                -- la formation se tourne en douceur vers le joueur (indépendant du framerate)
                local now = os.clock()
                local dtb = math.min(now - (B.lt or now), 0.1); B.lt = now
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = Vector3.new(B.x - hrp.Position.X, 0, B.z - hrp.Position.Z)
                    if d.Magnitude > 0.8 then
                        local f = (BY.fwd or d.Unit):Lerp(d.Unit, 1 - math.exp(-8 * dtb))
                        if f.Magnitude > 0.05 then f = f.Unit; BY.fwd, BY.right = f, f:Cross(Vector3.yAxis) end
                    end
                end
                BY.push, BY.sunk = push, ez          -- push : 0 = regard · 0→1 = claque · 1 = enfoncement ; sunk : 0→1 = enfoncé
                BY.vp = Vector3.new(x, y, z)          -- point regardé par la tête = le joueur
            end
            if B.fx then FG.buryBigStep(B, e, tA, tA + tL + tS) end        -- 🎆 effets de la « Grande cérémonie »
            return Vector3.new(x, y, z), rot, (not (FG.buryKeep or st.hold)) and e > tA + tL + tS + D + 1.0   -- 5) maintenu 1 s puis relâché
        end

        function FG.buryEnd(C, release, msg)
            local B = C and C.bury
            if not B then return end
            C.bury = nil
            if B.fx then FG.buryFxClear(B, release and 5 or 0.3) end      -- 🎆 la tombe reste 5 s puis s'efface
-- (noclip par pas physique retiré)
            for q, v in pairs(B.saved) do pcall(function() if q.Parent then q.CanCollide = v[1]; q.Massless = v[2] end end) end
            if not ((FG.captured and FG.captured.bury) or (FG.captured2 and FG.captured2.bury)) then
                FG.toyNoclip(false)
                -- plus personne n'est enterré : la formation se relève et reprend son animation d'avant
                local BYo = _G._FigureBury
                if BYo and not BYo.out then
                    BYo.out, BYo.prev = os.clock(), B.prevMode      -- 🧍 il se relève proprement (0,75 s) avant de reprendre son animation
                    task.delay(0.8, function()
                        if _G._FigureBury == BYo then
                            _G._FigureBury = nil
                            if figureAnimationMode == "Bury" then figureAnimationMode = (BYo.prev and BYo.prev ~= "Bury") and BYo.prev or "Auto" end
                            FG.buryLock(false)                      -- 🔓 tu peux de nouveau bouger
                        end
                    end)
                elseif not BYo then
                    FG.buryLock(false)
                end
            end
            if release then
                FG.noCaptureUntil = os.clock() + 1
                FG.releaseOne(C, msg)
            end
        end

        -- =====================================================================================================================
        -- 🎭 ANIMATION DU JOUEUR TENU : change la façon dont la formation tient le joueur (dropdown « Animation du joueur tenu »).
        -- « Normal » = comportement d'origine (le joueur garde sa rotation). Les autres poses forcent une rotation + un décalage.
        -- (Pas de nouvelle variable locale ici : on est dans un bloc déjà gros, tout passe par la table FG.)
        -- =====================================================================================================================
        FG.holdPose  = FG.holdPose or "Normal"
        FG.poseNames = { "Normal", "Debout face à moi", "Porté dans les bras", "Tête en bas", "Pendu par le col", "Toupie", "Flotte" }

        function FG.poseApply(C, keepRot, hand)
            C.poseOff = Vector3.zero
            local mode = FG.holdPose
            if not mode or mode == "Normal" then return keepRot end

            -- fondu : la pose s'installe pendant la phase « il glisse jusqu'à la main », pleine quand il est tenu
            local ph, pk = FG.capPhase(C)
            local w = (ph == 3) and 1 or ((ph == 2) and (1 - (1 - pk) ^ 3) or 0)
            if w <= 0 then return keepRot end

            local t  = os.clock()
            local h1, h2 = figureBodyCache[_G._FigHandIdx(7)], figureBodyCache[_G._FigHandIdx(10)]
            local ctr = (h1 and h2 and h1.Parent and h2.Parent) and ((h1.Position + h2.Position) / 2) or hand.Position
            local d = ctr - C.root.Position
            d = Vector3.new(d.X, 0, d.Z)
            local face
            if d.Magnitude > 0.3 then
                face = CFrame.lookAt(Vector3.zero, d.Unit)          -- il regarde le corps de la formation
            else
                local _, yaw = keepRot:ToOrientation()
                face = CFrame.Angles(0, yaw, 0)
            end
            if C.poseFace then face = C.poseFace:Lerp(face, 0.25) end   -- lissé : pas de tremblement
            C.poseFace = face

            local rot, off
            if mode == "Debout face à moi" then
                rot, off = face, Vector3.zero
            elseif mode == "Porté dans les bras" then
                rot, off = face * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(90), 0, 0), Vector3.new(0, 0.4, 0)
            elseif mode == "Tête en bas" then
                rot, off = face * CFrame.Angles(math.pi, 0, 0), Vector3.new(0, -1.5, 0)
            elseif mode == "Pendu par le col" then
                rot, off = face * CFrame.Angles(math.rad(-8) + math.sin(t * 2) * 0.14, 0, math.sin(t * 1.3) * 0.1), Vector3.new(0, -0.8, 0)
            elseif mode == "Toupie" then
                rot, off = CFrame.Angles(0, t * 7, 0), Vector3.zero
            elseif mode == "Flotte" then
                rot, off = face * CFrame.Angles(math.rad(-15), 0, math.sin(t * 1.7) * 0.2), Vector3.new(0, 0.35 + math.sin(t * 2.4) * 0.55, 0)
            else
                return keepRot
            end
            C.poseOff = off * w
            return keepRot:Lerp(rot, w)
        end

        -- =====================================================================================================================
        -- 🔒 CAGE : quand je tiens 1 ou 2 joueurs (prise par la formation OU grab line normale), 6 pallets spawn et se referment
        -- autour d'eux (un cube : 4 murs + sol + toit). Slider = distance du centre aux pallets. Avec 2 joueurs la cage englobe
        -- les deux (centre = milieu, et on ajoute la moitié de leur écart). Les pallets sont exclues de la formation, et détruites
        -- quand je lâche / lance / coupe le toggle.
        -- =====================================================================================================================
        FG.cageOn     = FG.cageOn or false
        FG.cageSize   = FG.cageSize or 6
        FG.cage       = FG.cage or { plates = nil, spawning = false, born = 0, lastTarget = 0, retryAt = 0 }
        FG.cageNormals = {
            Vector3.new( 1, 0, 0), Vector3.new(-1, 0, 0),
            Vector3.new( 0, 1, 0), Vector3.new( 0,-1, 0),
            Vector3.new( 0, 0, 1), Vector3.new( 0, 0,-1),
        }

        -- racines des joueurs que je tiens (max 2)
        function FG.cageTargets()
            local list, seen = {}, {}
            if FG.ownOn then
                for _, C in ipairs({ FG.captured or false, FG.captured2 or false }) do
                    if C and C.root and C.root.Parent and C.hum and C.hum.Health > 0 then
                        seen[C.root] = true
                        list[#list + 1] = C.root
                    end
                end
            end
            local _, _, hch = heldPlayer()
            local hr = hch and hch:FindFirstChild("HumanoidRootPart")
            if hr and not seen[hr] and #list < 2 then list[#list + 1] = hr end
            return list
        end

        function FG.cageClear()
            local pl = FG.cage.plates
            FG.cage.plates = nil
            if not pl then return end
            local mt = REP:FindFirstChild("MenuToys")
            local rDestroy = mt and mt:FindFirstChild("DestroyToy")
            for _, P in ipairs(pl) do
                if rDestroy and P.model and P.model.Parent then
                    pcall(function() rDestroy:FireServer(P.model) end)
                end
            end
        end

        function FG.cageSpawn()
            local cage = FG.cage
            if cage.spawning or cage.plates or ragBusy then return end
            local mt     = REP:FindFirstChild("MenuToys")
            local rSpawn = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
            local inv    = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not (rSpawn and inv and myRoot) then
                cage.retryAt = os.clock() + 3
                notify("Cage", "Impossible (toys, remote ou personnage introuvables)", 2)
                return
            end
            cage.spawning = true
            task.spawn(function()
                -- instantané : toute nouvelle pallet est exclue de la formation dès son apparition
                local snap = {}
                for _, m in ipairs(inv:GetChildren()) do snap[m] = true end
                _G._FigRagSnap, _G._FigRagBusy = snap, true
                _G._FigureExclude = _G._FigureExclude or setmetatable({}, { __mode = "k" })

                local found = {}
                local can = LP:FindFirstChild("CanSpawnToy")
                for _ = 1, 6 do
                    if not FG.cageOn then break end
                    if can and not can.Value then
                        local w0 = os.clock()
                        repeat task.wait(0.05) until can.Value or (os.clock() - w0) > 2
                    end
                    local r0 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") or myRoot
                    pcall(function() rSpawn:InvokeServer("PalletLightBrown", r0.CFrame * CFrame.new(0, 5, 0), Vector3.zero) end)
                    local new
                    local w1 = os.clock()
                    repeat
                        for _, m in ipairs(inv:GetChildren()) do
                            if m.Name == "PalletLightBrown" and not snap[m] then new = m break end
                        end
                        if not new then task.wait(0.05) end
                    until new or (os.clock() - w1) > 2
                    if new then
                        _G._FigureExclude[new] = true
                        snap[new] = true
                        found[#found + 1] = new
                    end
                end
                _G._FigRagBusy = false

                -- cage coupée pendant le spawn : on nettoie
                if not FG.cageOn then
                    local rD = mt:FindFirstChild("DestroyToy")
                    for _, m in ipairs(found) do if rD then pcall(function() rD:FireServer(m) end) end end
                    cage.spawning = false
                    return
                end

                local plates = {}
                for _, model in ipairs(found) do
                    local pp = model:FindFirstChild("SoundPart") or model:FindFirstChildWhichIsA("BasePart")
                    if pp then
                        -- la pallet est un plateau : on repère son axe le plus fin pour le mettre perpendiculaire à chaque face de la cage
                        local rel, k = CFrame.new(), 3
                        local ok, bcf, bsz = pcall(function() return model:GetBoundingBox() end)
                        if ok and bcf and bsz then
                            rel = pp.CFrame:ToObjectSpace(bcf)
                            k = (bsz.X <= bsz.Y and bsz.X <= bsz.Z) and 1 or ((bsz.Y <= bsz.Z) and 2 or 3)
                        end
                        -- pas de collision CHEZ MOI (elles ne poussent pas ma formation) ; pour les autres elles restent solides
                        for _, p in ipairs(model:GetDescendants()) do
                            if p:IsA("BasePart") then p.CanCollide = false end
                        end
                        plates[#plates + 1] = { model = model, pp = pp, rel = rel, k = k, n = FG.cageNormals[#plates + 1], lastOwn = 0 }
                    end
                end
                if #plates == 0 then
                    cage.retryAt = os.clock() + 3
                    cage.spawning = false
                    notify("Cage", "Aucune pallet n'a spawn", 2)
                    return
                end
                cage.plates, cage.born, cage.spawning = plates, os.clock(), false
                if #plates < 6 then notify("Cage", "⚠️ Seulement " .. #plates .. "/6 pallets (limite de toys ?)", 3) end
            end)
        end

        _TrackConn(RunSvc.Heartbeat:Connect(function()
            local cage = FG.cage
            local now  = os.clock()
            local on   = FG.cageOn and animatedFigureActive
            local tg   = on and FG.cageTargets() or {}
            if #tg > 0 then cage.lastTarget = now end

            if not on then
                if cage.plates then FG.cageClear() end
                return
            end
            if #tg == 0 then
                -- plus personne de tenu (lâché / lancé) : la cage disparaît après un court délai
                if cage.plates and (now - cage.lastTarget) > 0.35 then FG.cageClear() end
                return
            end
            if not cage.plates then
                if not cage.spawning and now >= cage.retryAt then FG.cageSpawn() end
                return
            end
            for _, P in ipairs(cage.plates) do
                if not (P.model.Parent and P.pp.Parent) then
                    FG.cageClear()
                    cage.retryAt = now + 2
                    return
                end
            end

            -- centre de la cage : le joueur, ou le milieu des deux
            local p1 = tg[1].Position
            local p2 = tg[2] and tg[2].Position or p1
            local c  = (p1 + p2) / 2
            local hf = (p1 - p2) / 2
            local R  = FG.cageSize or 6
            -- formation : les pallets arrivent de loin (x3) et se referment en douceur sur 0,45 s
            local k  = math.clamp((now - cage.born) / 0.45, 0, 1)
            local grow = 1 + 2 * (1 - k) ^ 3

            local ge  = REP:FindFirstChild("GrabEvents")
            local sno = ge and ge:FindFirstChild("SetNetworkOwner")
            for _, P in ipairs(cage.plates) do
                local n   = P.n
                local ext = (R + math.abs(hf:Dot(n))) * grow
                local up  = (math.abs(n.Y) > 0.9) and Vector3.xAxis or Vector3.yAxis
                local rot = CFrame.lookAt(Vector3.zero, n, up)
                if P.k == 2 then rot = rot * CFrame.Angles(math.pi / 2, 0, 0)
                elseif P.k == 1 then rot = rot * CFrame.Angles(0, -math.pi / 2, 0) end
                local cf = CFrame.new(c + n * ext) * rot * P.rel:Inverse()
                pcall(function()
                    P.pp.CFrame = cf
                    P.pp.AssemblyLinearVelocity  = Vector3.zero
                    P.pp.AssemblyAngularVelocity = Vector3.zero
                end)
                -- ownership : seulement si perdue, 10 fois / seconde max
                local po = P.pp:FindFirstChild("PartOwner")
                if sno and not (po and po.Value == LP.Name) and (now - P.lastOwn) > 0.1 then
                    P.lastOwn = now
                    pcall(function() sno:FireServer(P.pp, P.pp.CFrame) end)
                end
            end
        end))

        -- =====================================================================================================================
        -- 🌀 LANCER CHARGÉ : maintiens le clic droit en tenant un joueur -> la formation le balance en cercle de plus en plus vite
        -- pendant que la jauge se remplit (vert -> rouge). Relâche = le joueur part dans la direction de la caméra avec la puissance
        -- de la jauge (max FG.chargeMax, 1000 par défaut). État dans FG.charge = { t0, side, ang, p }.
        -- =====================================================================================================================
        FG.chargeOn  = false
        FG.throwStyle = FG.throwStyle or "Cercle"   -- Cercle / Moulinet / Lasso / Catapulte / Marteau / Tornade / Huit / Yo-yo / Pendule / Vague / Roue côté
        FG.windupOn  = false                        -- 🎬 animation de début de lancer + immobilisé pendant la charge
        FG.chargeDur = FG.chargeDur or 4        -- secondes pour remplir la jauge
        FG.arcOn, FG.trailOn, FG.camFx = true, true, true     -- 🏹 arc prévisionnel / ☄️ trail / 🎥 shake + FOV
        FG.fxK = FG.fxK or 1                                  -- intensité du shake / FOV
        FG.sweetOn = true                                     -- ⭐ zone de timing parfait
        FG.sweetPos, FG.sweetBonus, FG.sweetW = FG.sweetPos or 78, FG.sweetBonus or 40, 0.12
        FG.boomMax = FG.boomMax or 260                        -- vitesse max du boomerang (studs/s)
        FG.chargeMax = FG.chargeMax or 1000     -- puissance à jauge pleine (studs/s)
        FG.charge    = nil

        function FG.chargeGuiHide()
            if FG.arcHide then FG.arcHide() end
            if FG.gui then pcall(function() FG.gui.Enabled = false end) end
        end

        function FG.chargeGuiUpdate(p)
            if not (FG.gui and FG.gui.Parent) then
                local pg = LP:FindFirstChildOfClass("PlayerGui")
                if not pg then return end
                local g = Instance.new("ScreenGui")
                g.Name, g.ResetOnSpawn, g.IgnoreGuiInset, g.DisplayOrder = "FigThrowCharge", false, true, 9000
                local back = Instance.new("Frame")
                back.Name = "Back"
                back.AnchorPoint = Vector2.new(0.5, 0.5)
                back.Position = UDim2.fromScale(0.5, 0.84)
                back.Size = UDim2.fromOffset(340, 26)
                back.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
                back.BackgroundTransparency = 0.2
                back.BorderSizePixel = 0
                back.Parent = g
                local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 13); bc.Parent = back
                local bs = Instance.new("UIStroke"); bs.Color = Color3.fromRGB(255, 255, 255); bs.Thickness = 2; bs.Transparency = 0.45; bs.Parent = back
                local fill = Instance.new("Frame")
                fill.Name = "Fill"
                fill.Size = UDim2.new(0, 0, 1, 0)
                fill.BorderSizePixel = 0
                fill.BackgroundColor3 = Color3.fromRGB(60, 220, 80)
                fill.Parent = back
                local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 13); fc.Parent = fill
                local lbl = Instance.new("TextLabel")
                lbl.Name = "Lbl"
                lbl.AnchorPoint = Vector2.new(0.5, 1)
                lbl.Position = UDim2.new(0.5, 0, 0, -5)
                lbl.Size = UDim2.fromOffset(340, 22)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 17
                lbl.TextColor3 = Color3.new(1, 1, 1)
                lbl.TextStrokeTransparency = 0.4
                lbl.Text = ""
                lbl.Parent = back
                g.Enabled = false
                g.Parent = pg
                FG.gui = g
            end
            local back = FG.gui:FindFirstChild("Back")
            local fill = back and back:FindFirstChild("Fill")
            local lbl  = back and back:FindFirstChild("Lbl")
            if not (fill and lbl) then return end
            FG.gui.Enabled = true
            fill.Size = UDim2.new(math.max(p, 0.02), 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromHSV(0.33 * (1 - p), 0.85, 1)          -- vert -> jaune -> rouge
            local full = p >= 0.999
            lbl.Text = full and ("💥 MAX  " .. math.floor(FG.chargeMax)) or ("PUISSANCE  " .. math.floor(p * FG.chargeMax))
            back.Position = full and UDim2.fromScale(0.5 + (math.random() - 0.5) * 0.004, 0.84 + (math.random() - 0.5) * 0.004) or UDim2.fromScale(0.5, 0.84)
            -- ⭐ zone de timing parfait (dorée) : relâche dedans = bonus de puissance
            local zone = back:FindFirstChild("Zone")
            if not zone then
                zone = Instance.new("Frame")
                zone.Name, zone.BorderSizePixel, zone.ZIndex = "Zone", 0, 5
                zone.BackgroundColor3, zone.BackgroundTransparency = Color3.fromRGB(255, 255, 255), 0.55
                local zs = Instance.new("UIStroke"); zs.Color = Color3.fromRGB(255, 225, 60); zs.Thickness = 2; zs.Parent = zone
                zone.Parent = back
            end
            local lo, wz = (FG.sweetPos or 78) / 100, (FG.sweetW or 0.12)
            zone.Visible = FG.sweetOn == true
            zone.Position, zone.Size = UDim2.new(lo, 0, 0, 0), UDim2.new(wz, 0, 1, 0)
            local inZ = FG.isPerfect(p)
            zone.BackgroundColor3 = inZ and Color3.fromRGB(255, 235, 80) or Color3.fromRGB(255, 255, 255)
            zone.BackgroundTransparency = inZ and 0.1 or 0.55
            if inZ then lbl.Text = "⭐ PARFAIT !  " .. math.floor(FG.releasePower(p)) end
        end

        -- 🔒 vrai pendant la charge (et l'armement) si le toggle « animation de début de lancer » est activé : le contrôle d'objet est gelé
        function _G._FigChargeLock()
            return FG.windupOn == true and (FG.charge ~= nil or FG.throwAnim ~= nil)
        end

        -- 🚀 envoie un joueur tenu : sa vitesse est imposée un moment (FG.thrown pour le 1er, FG.thrown2 pour le 2e)
        -- ⭐ zone de timing parfait : relâcher la jauge dans la zone dorée donne un bonus de puissance
        function FG.isPerfect(p)
            local lo = (FG.sweetPos or 78) / 100
            return FG.sweetOn == true and p >= lo and p <= lo + (FG.sweetW or 0.12)
        end
        function FG.releasePower(p)
            local base = math.max(40, p * (FG.chargeMax or 1000))
            if FG.isPerfect(p) then base = base * (1 + (FG.sweetBonus or 40) / 100) end
            return base
        end

        -- direction du lancer : caméra (+ un peu de hauteur), ou vers le BAS pour le Slam
        function FG.throwDir()
            local cam = workspace.CurrentCamera
            local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
            if FG.throwStyle == "Slam" then
                local fl = Vector3.new(look.X, 0, look.Z)
                fl = (fl.Magnitude > 0.01) and fl.Unit or Vector3.new(0, 0, -1)
                return (fl * 0.3 + Vector3.new(0, -1, 0)).Unit
            end
            return (look + Vector3.new(0, 0.2, 0)).Unit
        end

        -- options propres au style (Boomerang : durée de l'aller ; Slam : arrêt au sol)
        function FG.launchEx(p)
            local s = FG.throwStyle
            if s == "Boomerang" then return { p = p, boom = 0.45 + 0.75 * p } end
            if s == "Slam" then return { p = p, slam = true } end
            return { p = p }
        end

        -- ☄️ trail coloré derrière le joueur lancé (local : visible seulement chez toi)
        function FG.trailAdd(root, p, dur)
            if not (FG.trailOn and root and root.Parent) then return end
            pcall(function()
                local a0 = Instance.new("Attachment"); a0.Name = "FigTrailA0"; a0.Position = Vector3.new(0, 1.2, 0); a0.Parent = root
                local a1 = Instance.new("Attachment"); a1.Name = "FigTrailA1"; a1.Position = Vector3.new(0, -1.2, 0); a1.Parent = root
                local tr = Instance.new("Trail")
                tr.Attachment0, tr.Attachment1 = a0, a1
                tr.Lifetime, tr.MinLength, tr.FaceCamera, tr.LightEmission = 0.55, 0.05, true, 1
                tr.Color = ColorSequence.new(Color3.fromHSV(0.33 * (1 - math.clamp(p or 0.3, 0, 1)), 0.85, 1), Color3.new(1, 1, 1))
                tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
                tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
                tr.Parent = root
                task.delay((dur or 1) + 0.8, function()
                    pcall(function() tr:Destroy(); a0:Destroy(); a1:Destroy() end)
                end)
            end)
        end

        -- 🚀 envoie un joueur tenu : sa vitesse est imposée un moment (FG.thrown pour le 1er, FG.thrown2 pour le 2e)
        -- ex (optionnel) = { p, boom = durée de l'aller, slam = true } (voir FG.launchEx)
        function FG.launch(C, vel, spin, dur, ex)
            local rec = { root = C.root, vel = vel, spin = spin, t = os.clock(), dur = dur }
            if ex and ex.boom then
                rec.vel = vel.Unit * math.min(vel.Magnitude, FG.boomMax or 260)
                rec.boom = { tOut = ex.boom }
                rec.dur = ex.boom + 3.5                                  -- aller + retour max
            elseif ex and ex.slam then
                local sp = math.clamp(vel.Magnitude * 0.4, 70, 170)
                local dn = vel.Unit
                rec.vel = dn * sp
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = { LP.Character, C.root.Parent }
                local hit = workspace:Raycast(C.root.Position, Vector3.new(0, -300, 0), rp)
                local dist = hit and (C.root.Position.Y - hit.Position.Y) or 40
                rec.dur = math.clamp(dist / math.max(sp * math.abs(dn.Y), 1) * 0.95, 0.12, 0.6)   -- on s'arrête AU sol (pas de traversée)
                rec.slam = true
                rec.impact = hit and hit.Position or nil
            end
            if not FG.thrown then FG.thrown = rec else FG.thrown2 = rec end
            FG.trailAdd(C.root, ex and ex.p or 0.3, rec.dur)
        end

        -- vitesse imposée pendant le vol (Boomerang : après l'aller, le joueur se dirige vers toi puis s'arrête près de toi)
        function FG.thrownVel(T)
            local B = T.boom
            if not B or (os.clock() - T.t) < B.tOut then return T.vel end
            local hr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hr then return T.vel end
            local dl = (hr.Position + Vector3.new(0, 2, 0)) - T.root.Position
            if dl.Magnitude < 8 then T.t = -1e9; return Vector3.zero end
            local want = dl.Unit * math.clamp(dl.Magnitude * 5, 35, T.vel.Magnitude)
            T.cur = (T.cur or T.vel):Lerp(want, 0.18)
            return T.cur
        end

        -- 💥 impact du Slam : onde de choc + secousse
        function FG.slamImpact(T)
            FG.kick = math.max(FG.kick or 0, 1.2)
            local pos = T.impact or (T.root and T.root.Position)
            if not pos then return end
            task.spawn(function()
                pcall(function()
                    local ring = Instance.new("Part")
                    ring.Shape, ring.Material, ring.Color = Enum.PartType.Cylinder, Enum.Material.Neon, Color3.fromRGB(255, 200, 80)
                    ring.Size, ring.Transparency = Vector3.new(0.4, 2, 2), 0.15
                    ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch, ring.CastShadow = true, false, false, false, false
                    ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
                    ring.Parent = workspace.CurrentCamera
                    game:GetService("TweenService"):Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                        { Size = Vector3.new(0.4, 46, 46), Transparency = 1 }):Play()
                    task.wait(0.55)
                    ring:Destroy()
                end)
            end)
        end

        -- effets au lâcher : secousse + message si lancer parfait
        function FG.releaseFx(p, perfect)
            FG.kick = math.max(FG.kick or 0, perfect and 1.4 or (0.4 + 0.6 * (p or 0)))
            if perfect then notify("Grab Figure", "⭐ LANCER PARFAIT ! (+" .. tostring(FG.sweetBonus or 40) .. "% de puissance)", 2) end
        end

        -- 🏹 arc de trajectoire prévisionnel pendant la charge (points néon locaux ; s'arrête au premier obstacle)
        function FG.arcHide()
            if FG.arcParts then
                for _, q in ipairs(FG.arcParts) do q.Transparency = 1 end
            end
        end

        function FG.arcUpdate(CH)
            local C = FG.captured
            if not (FG.arcOn and C and C.root and C.root.Parent) then FG.arcHide() return end
            local N = 34
            if not (FG.arcParts and FG.arcParts[1] and FG.arcParts[1].Parent) then
                FG.arcParts = {}
                for i = 1, N do
                    local q = Instance.new("Part")
                    q.Name, q.Shape, q.Material = "FigArcDot", Enum.PartType.Ball, Enum.Material.Neon
                    q.Anchored, q.CanCollide, q.CanQuery, q.CanTouch, q.CastShadow = true, false, false, false, false
                    q.Transparency, q.Size = 1, Vector3.new(0.5, 0.5, 0.5)
                    q.Parent = workspace.CurrentCamera
                    FG.arcParts[i] = q
                end
            end
            local p = CH.p or 0
            local perfect = FG.isPerfect(p)
            local cur = FG.throwDir() * FG.releasePower(p)
            local boom = (FG.throwStyle == "Boomerang") and (0.45 + 0.75 * p) or nil
            local slam = FG.throwStyle == "Slam"
            local dur = 0.35 + 0.4 * p
            if boom then cur = cur.Unit * math.min(cur.Magnitude, FG.boomMax or 260)
            elseif slam then cur = cur.Unit * math.clamp(cur.Magnitude * 0.4, 70, 170) end
            local vmax = cur.Magnitude
            local pos, t, step, g = C.root.Position, 0, 0.06, workspace.Gravity
            local hr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = { LP.Character, C.root.Parent, workspace.CurrentCamera }
            local col = perfect and Color3.fromRGB(255, 225, 60) or Color3.fromHSV(0.33 * (1 - p), 0.85, 1)
            local ended = false
            for i = 1, N do
                local q = FG.arcParts[i]
                if ended then
                    q.Transparency = 1
                else
                    local np
                    if boom and t >= boom and hr then
                        local dl = (hr.Position + Vector3.new(0, 2, 0)) - pos
                        local want = (dl.Magnitude > 0.1) and dl.Unit * math.clamp(dl.Magnitude * 5, 35, vmax) or Vector3.zero
                        cur = cur:Lerp(want, 1 - 0.82 ^ (step * 60))
                        np = pos + cur * step
                        if dl.Magnitude < 8 then ended = true end
                    elseif (boom and t < boom) or (not boom and (slam or t < dur)) then
                        np = pos + cur * step
                    else
                        cur = cur + Vector3.new(0, -g * step, 0)
                        np = pos + cur * step
                    end
                    local isEnd = false
                    local hit = workspace:Raycast(pos, np - pos, rp)
                    if hit then np = hit.Position; ended = true; isEnd = true end
                    q.Position = np
                    q.Color = isEnd and Color3.fromRGB(255, 70, 60) or col
                    q.Size = isEnd and Vector3.new(1.3, 1.3, 1.3) or Vector3.one * (0.6 - 0.3 * (i / N))
                    q.Transparency = isEnd and 0.1 or (0.15 + 0.7 * (i / N))
                    pos, t = np, t + step
                end
            end
        end

        -- 🎥 shake + FOV qui montent avec la jauge (et secousse à l'impact / au lâcher) ; appliqué APRÈS le script de caméra
        do
            local myRid = _G.HelperOtherRunId
            local nm = "FigChargeFx"
            pcall(function() RunSvc:UnbindFromRenderStep(nm) end)
            RunSvc:BindToRenderStep(nm, Enum.RenderPriority.Camera.Value + 1, function(dt)
                if _G.HelperOtherRunId ~= myRid then pcall(function() RunSvc:UnbindFromRenderStep(nm) end) return end
                local cam = workspace.CurrentCamera
                if not cam then return end
                local CH = FG.charge
                local target = (FG.camFx and CH) and (CH.p or 0) or 0
                local a = FG.fxAmt or 0
                a = a + (target - a) * math.min(1, dt * ((target > a) and 8 or 5))
                if a < 0.002 then a = 0 end
                FG.fxAmt = a
                FG.kick = math.max(0, (FG.kick or 0) - dt * 3)
                local kick = FG.camFx and FG.kick or 0
                if a == 0 and kick == 0 then FG.fovApplied = nil return end
                if FG.fovApplied == nil or math.abs(cam.FieldOfView - FG.fovApplied) > 0.01 then FG.fovBase = cam.FieldOfView end
                local k = FG.fxK or 1
                cam.FieldOfView = FG.fovBase + 22 * (a ^ 1.5) * k
                FG.fovApplied = cam.FieldOfView
                local amp = (0.45 * a * a + 0.9 * kick * kick) * k
                if amp > 0.001 then
                    cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * amp, (math.random() - 0.5) * amp, 0)
                        * CFrame.Angles(0, 0, (math.random() - 0.5) * amp * 0.03)
                end
            end)
        end

        -- relâchement du clic droit : le(s) joueur(s) tenu(s) part(ent) avec la puissance de la jauge
        function FG.chargeRelease()
            local CH = FG.charge
            if not CH then return end
            FG.charge = nil
            FG.chargeGuiHide()
            local p = CH.p or 0
            local perfect = FG.isPerfect(p)
            local power = FG.releasePower(p)          -- inclut le bonus « parfait »
            local dir = FG.throwDir()                 -- caméra, ou vers le bas pour le Slam
            -- 🎬 animation de début de lancer : au lieu de partir tout de suite, le bras s'arme puis fouette, et les joueurs partent en plein fouet
            if FG.windupOn then
                local C1 = FG.captured
                if FG.ownOn and C1 and C1.root and C1.root.Parent and not FG.throwAnim then
                    FG.throwAnim = { t0 = os.clock(), dur = 0.6, side = (C1.hand == 7) and -1 or 1, fired = false,
                        power = power, p = p, perfect = perfect, tdur = 0.35 + 0.4 * p, spinK = 1 + p * 3 }
                end
                return
            end
            local names = {}
            for _, Cc in ipairs({ FG.captured or false, FG.captured2 or false }) do
                if FG.ownOn and Cc and Cc.root and Cc.root.Parent then
                    FG.launch(Cc, dir * power,
                        Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8)) * (1 + p * 3),
                        0.35 + 0.4 * p, FG.launchEx(p))   -- plus c'est puissant, plus on impose longtemps la vitesse (le jeu ne l'écrase pas)
                    names[#names + 1] = Cc.plr.Name
                end
            end
            if #names == 0 then return end
            FG.releaseFx(p, perfect)
            FG.noCaptureUntil = os.clock() + 1
            FG.captured, FG.captured2 = nil, nil
            notify("Grab Figure", "🚀 " .. table.concat(names, " + ") .. " lancé(s) à " .. math.floor(power) .. " !", 2)
        end

        local rid, acc = _G.HelperOtherRunId, 0
        _TrackConn(RunSvc.Heartbeat:Connect(function(dt)
            if _G.HelperOtherRunId ~= rid then return end
            -- 🧲🧲 si le 1er joueur est parti, le 2e prend sa place (FG.captured = toujours le « principal »)
            if not FG.captured and FG.captured2 then FG.captured, FG.captured2 = FG.captured2, nil end
            styleUpdate()
            -- ⚰️ plus aucun enterrement en cours : les toys de la formation retrouvent leurs collisions
            if FG._tnc and not ((FG.captured and FG.captured.bury) or (FG.captured2 and FG.captured2.bury)) then FG.toyNoclip(false) end
            if FG._bLock and not _G._FigureBury then FG.buryLock(false) end   -- 🔓 sécurité : jamais bloqué si l'enterrement a disparu

            -- 🌀 LANCER CHARGÉ : avance la jauge et la vitesse de rotation (annulé si la prise est perdue / le toggle coupé)
            do
                local CH = FG.charge
                if CH then
                    local Cc = FG.captured
                    if not (FG.chargeOn and FG.ownOn and Cc and Cc.root and Cc.root.Parent) then
                        FG.charge = nil
                        FG.chargeGuiHide()
                    else
                        CH.p = math.clamp((os.clock() - CH.t0) / math.max(FG.chargeDur or 4, 0.3), 0, 1)
                        local w = 4 + 20 * (CH.p ^ 1.3)               -- vitesse de rotation (rad/s) : de 4 à 24
                        CH.ang = (CH.ang or 0) + w * dt
                        FG.chargeGuiUpdate(CH.p)
                        FG.arcUpdate(CH)
                    end
                end
            end

            -- 🚀 LANCER : pendant ~0.35 s on impose la vitesse au joueur lancé (et on garde l'ownership) pour que le jeu ne l'écrase pas
            -- 🎬 Séquence de lancer : armement -> fouet du bras -> le joueur est lâché en plein fouet (mi-animation)
            local TA = FG.throwAnim
            if TA then
                local el = os.clock() - TA.t0
                if not TA.fired then
                    local Cc = FG.captured
                    if not (FG.ownOn and Cc and Cc.root and Cc.root.Parent) then
                        FG.throwAnim = nil
                    elseif el >= TA.dur * 0.5 then
                        TA.fired = true
                        local cam = workspace.CurrentCamera
                        local dir = TA.p and FG.throwDir() or (cam and (cam.CFrame.LookVector + Vector3.new(0, 0.25, 0)).Unit or Vector3.new(0, 0.3, -1).Unit)
                        local _nm = {}
                        for _, C9 in ipairs({ FG.captured or false, FG.captured2 or false }) do   -- 🧲🧲 les deux joueurs partent ensemble
                            if C9 and C9.root and C9.root.Parent then
                                FG.launch(C9, dir * (TA.power or FG.power or 120),
                                    Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8)) * (TA.spinK or 1), TA.tdur, TA.p and FG.launchEx(TA.p) or nil)
                                _nm[#_nm + 1] = C9.plr.Name
                            end
                        end
                        FG.noCaptureUntil = os.clock() + 1
                        FG.captured, FG.captured2 = nil, nil          -- 🛑 la prise s'arrête : plus aucun spam d'ownership
                        notify("Grab Figure", "🚀 " .. table.concat(_nm, " + ") .. " lancé(s) !", 2)
                        if TA.p then FG.releaseFx(TA.p, TA.perfect) end
                    end
                elseif el >= TA.dur then
                    FG.throwAnim = nil
                end
            end

            for _, _tk in ipairs({ "thrown", "thrown2" }) do
                local T = FG[_tk]
                if T then
                    if (os.clock() - T.t) > (T.dur or 0.45) or not (T.root and T.root.Parent) then
                        if T.slam then FG.slamImpact(T) end
                        FG[_tk] = nil
                    else
                        pcall(function()
                            T.root.AssemblyLinearVelocity  = FG.thrownVel(T)
                            T.root.AssemblyAngularVelocity = T.spin
                        end)
                        -- ownership : seulement si on l'a perdue, et au plus 10 fois / seconde (avant : à CHAQUE frame)
                        local po = T.root:FindFirstChild("PartOwner")
                        if not (po and po.Value == LP.Name) and (os.clock() - (T.lastSno or 0)) > 0.1 then
                            T.lastSno = os.clock()
                            local ge  = REP:FindFirstChild("GrabEvents")
                            local sno = ge and ge:FindFirstChild("SetNetworkOwner")
                            if sno then pcall(function() sno:FireServer(T.root, T.root.CFrame) end) end
                        end
                        -- 🦴 pendant le lancer : membres (ragdoll) pris aussi et lancés à la même vitesse que le corps
                        if FG.limbsOn then
                            pcall(function()
                                local asm = T.root.AssemblyRootPart
                                if (os.clock() - (T.lastLimb or 0)) > 0.1 then
                                    T.lastLimb = os.clock()
                                    local ge  = REP:FindFirstChild("GrabEvents")
                                    FG.limbRequest(T, ge and ge:FindFirstChild("SetNetworkOwner"), FG.rootOwned(T.root.Parent, T.root))
                                end
                                if T.limbs then
                                    local v = T.root.AssemblyLinearVelocity
                                    for _, p in ipairs(T.limbs) do
                                        if p.Parent and p.AssemblyRootPart ~= asm and FG.ownedBy(p) then
                                            p.AssemblyLinearVelocity = v
                                        end
                                    end
                                end
                            end)
                        end
                    end
                end
            end

            -- 🤲 extension du bras pour la PRISE PAR LA FORMATION (Bras progressif) : se tend à la prise, revient après le lâcher / lancer
            do
                local C0 = FG.ownOn and FG.captured
                if C0 then FG.capHand = C0.hand end
                local want = C0 and 1 or 0
                if FG.smoothArm then
                    local e, sp = FG.capExt or 0, FG.extSpeed or 5
                    if want > e then e = math.min(1, e + dt * sp) else e = math.max(0, e - dt * sp) end
                    FG.capExt = e
                    FG.capE = e * e * (3 - 2 * e)
                else
                    FG.capExt, FG.capE = want, want
                end
            end
            if not (FG.armOn or FG.ownOn) then FG.holdPos = nil; FG.armExt, FG.armE = 0, 0; FG.capExt, FG.capE = 0, 0; return end
            if not animatedFigureActive then FG.holdPos = nil; FG.armExt, FG.armE = 0, 0; return end

            -- ===== détection du joueur que JE tiens =====
            local part, plr, char = heldPlayer()
            if part then
                FG.holdPos, FG.holdT = part.Position, os.clock()
                local cam = workspace.CurrentCamera
                if cam then FG.side = (cam.CFrame:PointToObjectSpace(part.Position).X < 0) and -1 or 1 end

                -- TOGGLE 2 : je tiens quelqu'un -> la formation le "prend" et je lâche ma grab line
                -- 🧲🧲 mode « 2 joueurs » : une 2e prise est possible tant qu'un bras est libre (et que ce n'est pas le même joueur)
                local _c1, _c2 = FG.captured, FG.captured2
                local _free = (not _c1) or (FG.dual and not _c2)
                local _same = (_c1 and _c1.plr == plr) or (_c2 and _c2.plr == plr)
                if FG.ownOn and _free and not _same and char and os.clock() >= (FG.noCaptureUntil or 0) and (FG.autoCap or FG.wantCap) then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    local hum  = char:FindFirstChildOfClass("Humanoid")
                    if root and hum and #figureBodyCache >= 13 then
                        -- 📡 garde-fous : distance max + ownership CONFIRMÉE par le serveur (sinon on laisse la grab line normale du jeu)
                        local _myR  = FG.myRoot()
                        local _dist = _myR and (root.Position - _myR.Position).Magnitude or 0
                        local _own  = (not FG.strict) or FG.rootOwned(char, root)
                        if _dist > (FG.maxDist or 25) then
                            if os.clock() - (FG.warnT or 0) > 2 then
                                FG.warnT = os.clock()
                                notify("Grab Figure", "📏 " .. plr.Name .. " est trop loin (" .. math.floor(_dist) .. " studs, max " .. math.floor(FG.maxDist or 25) .. ") : prise refusée", 2)
                            end
                        elseif not _own then
                            -- la grab line du jeu le tient encore : on attend que le serveur confirme (PartOwner) avant de la remplacer
                            FG.pendT = FG.pendT or os.clock()
                            if os.clock() - FG.pendT > 1.5 and os.clock() - (FG.warnT or 0) > 2 then
                                FG.warnT = os.clock()
                                notify("Grab Figure", "📡 Ownership de " .. plr.Name .. " non confirmée par le serveur : prise en attente", 2)
                            end
                        else
                            FG.pendT = nil
                            local _other = _c1 or _c2
                            local _hand = _other and ((_other.hand == 7) and 10 or 7) or ((FG.side < 0) and 7 or 10)   -- l'autre main que celle déjà occupée
                            local rec = { plr = plr, root = root, hum = hum, hand = _hand, since = os.clock(), far = 0, from = root.CFrame, ownT = os.clock(), own = true }
                            if not _c1 then FG.captured = rec else FG.captured2 = rec end
                            FG.wantCap = false
                            local ge  = REP:FindFirstChild("GrabEvents")
                            local dgl = ge and ge:FindFirstChild("DestroyGrabLine")
                            if dgl then pcall(function() dgl:FireServer(root) end) end
                            notify("Grab Figure", "🧲 " .. plr.Name .. " est tenu par la formation (" .. math.floor(_dist) .. " studs)", 2)
                            if FG.autoRag then ragdollPallet(char) end   -- 💥 ragdoll auto à la prise (option)
                        end
                    end
                end
            else
                FG.holdPos = nil
            end

            -- 🤲 extension du bras : progressive (toggle « Bras progressif ») ou instantanée (0 / 1)
            if FG.armOn then
                local want = FG.holdPos and 1 or 0
                if FG.holdPos then FG.armTarget = FG.holdPos end   -- après le lâcher, le bras revient depuis la dernière position tenue
                if FG.smoothArm then
                    local sp = FG.extSpeed or 5
                    local e  = FG.armExt or 0
                    if want > e then e = math.min(1, e + dt * sp) else e = math.max(0, e - dt * sp) end
                    FG.armExt = e
                    FG.armE   = e * e * (3 - 2 * e)               -- ease in/out
                else
                    FG.armExt, FG.armE = want, want
                end
            else
                FG.armExt, FG.armE = 0, 0
            end

            -- ===== TOGGLE 2 : la formation tient le(s) joueur(s) (spam d'ownership + placement sur la main) =====
            -- 🧲🧲 une boucle sur les 2 prises possibles (une par main)
            for _, C in ipairs({ FG.captured or false, FG.captured2 or false }) do
              if FG.ownOn and C then
                local hand = figureBodyCache[_G._FigHandIdx(C.hand)]
                if not (C.plr.Parent and C.root and C.root.Parent and C.hum and C.hum.Health > 0) then
                    FG.releaseOne(C, "Cible perdue : relâchée")
                elseif not (hand and hand.Parent) or #figureBodyCache < 13 then
                    FG.releaseOne(C, "Main de la formation introuvable : relâchée")
                else
                    -- 📡 le serveur confirme-t-il que le joueur est bien à moi ? (PartOwner) + distance entre lui et moi
                    local ownNow = (not FG.strict) or FG.rootOwned(C.root.Parent, C.root)
                    C.own = ownNow
                    if ownNow then C.ownT = os.clock() end
                    local phC = FG.capPhase(C)
                    local _myR = FG.myRoot()
                    local dMe = _myR and (C.root.Position - _myR.Position).Magnitude or 0
                    local tooFar = dMe > (FG.maxDist or 25) and (phC < 3 or not ownNow)
                    if tooFar then
                        FG.releaseOne(C, "📏 " .. C.plr.Name .. " est trop loin (" .. math.floor(dMe) .. " studs, max " .. math.floor(FG.maxDist or 25) .. ") : relâché")
                    end

                    -- ownership : on le redemande en boucle (comme une grab line permanente) ; non confirmée -> beaucoup plus vite
                    C.acc = (C.acc or 0) + dt
                    local step = 1 / math.max(FG.rate, 1)
                    if not ownNow or (FG.limbsOn and C.limbMissing) then step = math.min(step, 0.05) end   -- membre pas encore à moi : 20 demandes/s
                    if C.acc >= step then
                        C.acc = 0
                        local ge  = REP:FindFirstChild("GrabEvents")
                        local sno = ge and ge:FindFirstChild("SetNetworkOwner")
                        if sno then
                            pcall(function() sno:FireServer(C.root, C.root.CFrame) end)
                            FG.limbRequest(C, sno, ownNow)      -- 🦴 + tous les membres (ragdoll = assemblages séparés)
                        end
                    end

                    if tooFar then
                        -- déjà relâché (trop loin) : rien à faire cette frame
                    elseif FG.strict and not ownNow then
                        -- ❌ pas confirmé : on NE déplace PAS le joueur (sinon il n'est déplacé que chez moi, le serveur le laisse partir)
                        C.from = C.root.CFrame
                        if not C.hold3 then C.since = os.clock() end        -- la prise ne démarre (bras / glissement) qu'une fois l'ownership confirmée
                        if os.clock() - (C.ownT or 0) > 1.2 then
                            FG.releaseOne(C, "📡 Ownership non confirmée par le serveur : relâché")
                        end
                    else
                    -- placement sur la main (rotation du joueur conservée)
                    local keepRot = C.root.CFrame - C.root.CFrame.Position
                    keepRot = FG.poseApply(C, keepRot, hand)   -- 🎭 animation choisie dans le dropdown (Normal = comportement d'avant)
                    -- 🌀 lancer chargé : le joueur est couché et tourne face à sa trajectoire (balancé comme une poupée)
                    do
                        local CHs = FG.charge
                        if CHs then
                            local _tn = (C.hand == ((CHs.side < 0) and 7 or 10)) and FG.chargeTan or FG.chargeTan2
                            if _tn and _tn.Magnitude > 0.01 then
                                local k = math.clamp((os.clock() - CHs.t0) / 0.4, 0, 1)
                                local tgt = CFrame.lookAt(Vector3.zero, _tn.Unit) * CFrame.Angles(math.rad(-75), 0, 0)
                                keepRot = keepRot:Lerp(tgt, k)
                            end
                        end
                    end
                    local anchor = hand.Position
                    local hh = FG.handHold and FG.handHold[C.hand]
                    if hh and (os.clock() - hh.t) < 0.3 then anchor = hh.p end   -- bout du bras (pose de prise)
                    local goalHold = anchor + Vector3.new(0, -1, 0) + (C.poseOff or Vector3.zero)
                    local goal = goalHold
                    -- 🤲 1 : le bras s'étend vers le joueur (il reste sur place)  ·  2 : le joueur glisse (ease out) jusqu'à la main  ·  3 : tenu
                    local ph, pk = FG.capPhase(C)
                    if ph == 3 then C.hold3 = true end
                    if C.from then
                        if ph == 1 then
                            goal = C.from.Position
                        elseif ph == 2 then
                            local a = 1 - (1 - pk) ^ 3
                            goal = C.from.Position:Lerp(goalHold, a)
                        end
                    end
-- ⚰️ enterrement en cours : position / rotation pilotées par l'animation (noclip, 5 s minimum)
if C.bury then
