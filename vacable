-- =========================================================================
-- TELEPORT PANEL (milieu-droit de l'écran - style compact avec features avancées)
-- =========================================================================
-- 📍 FEATURES :
--   • Clic gauche → Téléporter à cette position
--   • Clic droit → Renommer le bouton
--   • Clic molette → Sauvegarder ta position actuelle sur ce bouton
--   • Sauvegarde automatique dans un fichier
-- 
-- 💾 Les modifications sont sauvegardées automatiquement dans :
--    "HelperOther_Config/teleport_locations.json"
-- =========================================================================
do
    local _TS      = game:GetService("TweenService")
    local _Players = game:GetService("Players")
    local _RunService = game:GetService("RunService")
    local _HttpService = game:GetService("HttpService")
    local _UIS = game:GetService("UserInputService")
    
    -- Chemin du fichier de sauvegarde
    local SAVE_FILE = "HelperOther_Config/teleport_locations.json"
    
    -- Fonction pour sauvegarder les positions
    -- (JSONEncode ne sait pas encoder un Vector3 : on stocke x/y/z puis on reconvertit au chargement)
    function saveTeleportData()
        if not writefile then 
            notify("⚠️ TP Panel", "writefile non disponible", 2)
            return 
        end
        
        local success, err = pcall(function()
            if isfolder and makefolder and not isfolder("HelperOther_Config") then
                makefolder("HelperOther_Config")
            end
            local out = {}
            for _, loc in ipairs(_G.TeleportLocations) do
                local p = loc.position
                if typeof(p) == "Vector3" then
                    table.insert(out, { name = loc.name, icon = loc.icon, x = p.X, y = p.Y, z = p.Z })
                end
            end
            writefile(SAVE_FILE, _HttpService:JSONEncode(out))
        end)
        
        if success then
            notify("✅ TP Panel", "Positions sauvegardées! (" .. #_G.TeleportLocations .. " emplacements)", 3)
        else
            notify("⚠️ TP Panel", "Sauvegarde échouée: " .. tostring(err), 3)
        end
    end
    
    -- Fonction pour charger les positions sauvegardées
    function loadTeleportData()
        if not isfile or not readfile then 
            notify("⚠️ TP Panel", "Fonctions de fichier non disponibles", 2)
            return false 
        end
        
        if isfile(SAVE_FILE) then
            local success, result = pcall(function()
                return _HttpService:JSONDecode(readfile(SAVE_FILE))
            end)
            
            if success and type(result) == "table" then
                local list = {}
                for _, d in ipairs(result) do
                    if type(d) == "table" and d.name and tonumber(d.x) and tonumber(d.y) and tonumber(d.z) then
                        table.insert(list, {
                            name = tostring(d.name),
                            icon = tostring(d.icon or "📍"),
                            position = Vector3.new(d.x, d.y, d.z),
                        })
                    end
                end
                _G.TeleportLocations = list
                notify("✅ TP Panel", tostring(#list) .. " positions chargées!", 3)
                return true
            else
                notify("⚠️ TP Panel", "Erreur chargement: " .. tostring(result), 3)
            end
        else
            notify("ℹ️ TP Panel", "Aucune sauvegarde trouvée, positions par défaut chargées", 3)
        end
        return false
    end
    
    -- Liste par défaut si aucune sauvegarde
    local defaultLocations = {
        {name = "Spawn", position = Vector3.new(0, 5, 0), icon = "🏠"},
        {name = "Plaza", position = Vector3.new(50, 5, 50), icon = "🏛"},
