-- =========================================================================
-- TAB REALBLITZ - Système Tornado Aura Avancé + TOY AURA MASTER
-- =========================================================================
do
    local RealBlitzTab = Tabs.RealBlitz
    local TornadoBlock = RealBlitzTab:CreateBlock({ Name = "🌪️ Tornado Aura", Side = "Left" })
    local ToyAuraMasterBlock = RealBlitzTab:CreateBlock({ Name = "⭐ TOY AURA MASTER", Side = "Right" })
    local DetectionBlock = RealBlitzTab:CreateBlock({ Name = "🔍 Detection System", Side = "Right" })
    local SettingsBlock = RealBlitzTab:CreateBlock({ Name = "⚙️ Tornado Settings", Side = "Left" })
    
    -- =====================================================================
    -- VARIABLES GLOBALES (inspirées de RealBlitz)
    -- =====================================================================
    _G.RBTornadoAura = false
    _G.RBTornadoMode = "Aura"  -- "Click" ou "Aura"
    _G.RBTornadoTarget = 3  -- 1=Players, 2=Objects, 3=Both
    _G.RBTornadoRadius = 28  -- Rayon de détection (comme RealBlitz)
    _G.RBTornadoSpeed = 2
    _G.RBTornadoHeight = 5
    _G.RBTornadoRespectPlots = true  -- Respecte la propriété des plots
    _G.RBLastTheta = 0
    _G.RBTornadoBodies = {}
    
    -- Variables de détection avancée
    local RBDetectedObjects = {}
    local RBActiveTornados = {}
    local RBFilterParams = nil
    
    -- =====================================================================
    -- SYSTÈME DE FILTRAGE AVANCÉ (comme RealBlitz)
    -- =====================================================================
    function InitializeFilterParams()
        if not RBFilterParams then
            RBFilterParams = OverlapParams.new()
            RBFilterParams.FilterType = Enum.RaycastFilterType.Exclude
        end
        
        -- Mise à jour dynamique des filtres
        RBFilterParams.FilterDescendantsInstances = {
            Player.Character,  -- Exclut le joueur
            workspace.Map,     -- Exclut la map
            workspace.Plots,   -- Exclut les plots eux-mêmes
            workspace.Waypoints, -- Exclut les waypoints
            workspace.Slots,   -- Exclut les slots
        }
    end
    
    -- =====================================================================
    -- FONCTION DE DÉTECTION DES PLOTS (inspirée de RealBlitz)
    -- =====================================================================
    function IsItemInPlayerPlot(item)
        if not item then return false end
        
        -- Si l'objet n'est pas dans PlotItems, il est autorisé
        if not item:IsDescendantOf(workspace.PlotItems) then
            return true
        end
        
        -- Vérifie si on est dans un plot
        local plotIndicator = workspace:FindFirstChild("PlayersInPlots")
        if not plotIndicator or not plotIndicator:FindFirstChild(Player.Name) then
            return true  -- Pas dans un plot = autorisé
        end
        
        -- Trouve notre plot
        for i = 1, 5 do
            local plot = workspace.Plots:FindFirstChild("Plot" .. i)
            if plot then
                local sign = plot:FindFirstChild("PlotSign")
                local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                
                if owners then
                    for _, owner in ipairs(owners:GetChildren()) do
                        if owner.Value == Player.Name then
                            -- C'est notre plot, vérifie si l'item est dedans
                            local plotFolder = workspace.PlotItems:FindFirstChild("Plot" .. i)
                            if plotFolder and item:IsDescendantOf(plotFolder) then
                                return true  -- Dans notre plot = autorisé
                            end
                        end
                    end
                end
            end
        end
        
        return false  -- Dans le plot d'un autre = refusé
    end
    
    -- =====================================================================
    -- FONCTION DE DÉTECTION D'OBJETS AUTOUR DU JOUEUR (comme RealBlitz)
    -- =====================================================================
    function CheckObjectsAroundPlayer()
        local playerRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not playerRoot then return {} end
        
        InitializeFilterParams()
        
        local detectedObjects = {}
        local partsInRadius = workspace:GetPartBoundsInRadius(playerRoot.Position, _G.RBTornadoRadius, RBFilterParams)
        
        for _, part in ipairs(partsInRadius) do
            local parentModel = part.Parent
            
            if parentModel and parentModel:IsA("Model") then
                -- Vérifie que ce n'est pas un joueur
                local isPlayer = game.Players:GetPlayerFromCharacter(parentModel)
                
                if not isPlayer then
                    -- Vérifie les règles de plot si activé
                    if _G.RBTornadoRespectPlots then
                        if IsItemInPlayerPlot(parentModel) then
                            if not table.find(detectedObjects, parentModel) then
                                table.insert(detectedObjects, parentModel)
                            end
                        end
                    else
                        -- Mode sans respect des plots
                        if not table.find(detectedObjects, parentModel) then
                            table.insert(detectedObjects, parentModel)
                        end
                    end
                end
            end
        end
        
        return detectedObjects
    end
    
    -- =====================================================================
    -- FORMULE SPIRALE (comme RealBlitz)
    -- =====================================================================
    function SpiralFormulaCalculation(centerPos, theta, radius, height)
        local x = centerPos.X + math.cos(theta) * radius
        local y = centerPos.Y + height
        local z = centerPos.Z + math.sin(theta) * radius
        return Vector3.new(x, y, z)
    end
    
    -- =====================================================================
    -- FONCTION D'APPLICATION DU TORNADO
    -- =====================================================================
    function ApplyTornadoToObject(obj, objPart)
        if not obj or not objPart or RBActiveTornados[objPart] then return end
        
        -- Crée le BodyPosition pour le tornado
        local bodyPos = Instance.new("BodyPosition")
        bodyPos.Name = "RBTornadoAuraVelocity"
        bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyPos.P = 10000
        bodyPos.D = 1000
        bodyPos.Parent = objPart
        
        -- Désactive les collisions
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        
        -- Marque comme actif
        RBActiveTornados[objPart] = {
            body = bodyPos,
            model = obj,
            theta = math.random() * math.pi * 2  -- Angle aléatoire initial
        }
        
        notify("RealBlitz Tornado", "🌪️ " .. obj.Name .. " ajouté au tornado", 2)
    end
    
    -- =====================================================================
    -- BOUCLE PRINCIPALE DU TORNADO
    -- =====================================================================
    function StartTornadoLoop()
        task.spawn(function()
            while _G.RBTornadoAura do
                local playerRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                
                if playerRoot then
                    -- Mode Aura : détecte automatiquement les objets
                    if _G.RBTornadoMode == "Aura" then
                        
                        -- OBJECTS (Target = 2 ou 3)
                        if _G.RBTornadoTarget == 2 or _G.RBTornadoTarget == 3 then
                            local detectedObjects = CheckObjectsAroundPlayer()
                            
                            for _, obj in ipairs(detectedObjects) do
                                local mainPart = obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")
                                if mainPart and not RBActiveTornados[mainPart] then
                                    ApplyTornadoToObject(obj, mainPart)
                                end
                            end
                        end
                        
                        -- PLAYERS (Target = 1 ou 3)
                        if _G.RBTornadoTarget == 1 or _G.RBTornadoTarget == 3 then
                            for _, targetPlayer in ipairs(game.Players:GetPlayers()) do
                                if targetPlayer ~= Player and targetPlayer.Character then
                                    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if targetRoot and not RBActiveTornados[targetRoot] then
                                        local distance = (playerRoot.Position - targetRoot.Position).Magnitude
                                        if distance <= _G.RBTornadoRadius then
                                            ApplyTornadoToObject(targetPlayer.Character, targetRoot)
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    -- Update des positions des objets en tornado
                    for part, data in pairs(RBActiveTornados) do
                        if part and part.Parent and data.body and data.body.Parent then
                            -- Met à jour l'angle
                            data.theta = data.theta + (_G.RBTornadoSpeed * 0.1)
                            
                            -- Calcule la nouvelle position
                            local newPos = SpiralFormulaCalculation(
                                playerRoot.Position,
                                data.theta,
                                _G.RBTornadoRadius * 0.5,  -- Rayon du tornado plus petit que détection
                                _G.RBTornadoHeight
                            )
                            
                            data.body.Position = newPos
                        else
                            -- Nettoie les objets détruits
                            RBActiveTornados[part] = nil
                        end
                    end
                end
                
                task.wait(0.1)  -- Même fréquence que RealBlitz
            end
        end)
    end
    
    -- =====================================================================
    -- FONCTION D'ARRÊT DU TORNADO
    -- =====================================================================
    function StopTornado()
        -- Nettoie tous les tornados actifs
        for part, data in pairs(RBActiveTornados) do
            if data.body and data.body.Parent then
                data.body:Destroy()
            end
            
            -- Restaure les collisions
            if data.model and data.model.Parent then
                for _, modelPart in ipairs(data.model:GetDescendants()) do
                    if modelPart:IsA("BasePart") then
                        modelPart.CanCollide = true
                    end
                end
            end
        end
        
        table.clear(RBActiveTornados)
        notify("RealBlitz Tornado", "🛑 Tornado arrêté - Objets restaurés", 3)
    end
    
