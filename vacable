                                            end
                                            
                                            -- 🎯 POSITIONNE ce toy sur une position basée sur la DISTANCE parcourue
                                            -- Plus l'espacement est grand, plus le toy est loin dans l'historique
                                            
                                            -- Distance cible pour ce toy (en studs)
                                            -- i * espacement pour que toy 1 soit déjà espacé (pas collé au joueur)
                                            local targetDistance = i * tornadoTrainSpacing
                                            
                                            -- Cherche dans l'historique la position qui correspond à cette distance
                                            local foundPos = nil
                                            local foundIndex = nil
                                            
                                            for idx, entry in ipairs(trainPositionHistory) do
                                                if entry.distanceFromHead and entry.distanceFromHead >= targetDistance then
