        Default = false,
        Callback = function(v)
            _kdActive = v
            if _kdConn then _kdConn:Disconnect(); _kdConn = nil end
            _kdHistory = {}
            if not v then return end

            -- Surveille les RemoteEvents suspects : RagdollRemote, CharacterEvents
            local _charEvents = _RS_KD:FindFirstChild("CharacterEvents")
            local _ragdollRE  = _charEvents and _charEvents:FindFirstChild("RagdollRemote")
            local _grabEvents = _RS_KD:FindFirstChild("GrabEvents")
            local _snoRE      = _grabEvents and _grabEvents:FindFirstChild("SetNetworkOwner")

            -- Surveille les SNO sur notre HRP — si quelqu'un fire SNO sur nous = grab/kick
            local hrp = game:GetService("Players").LocalPlayer.Character
                and game:GetService("Players").LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

            -- Détecte via la vélocité anormale (kick physique)
            _kdConn = game:GetService("RunService").Heartbeat:Connect(function()
                if not _kdActive then return end
                local char = _PS_KD.LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end

                -- Détecte si quelqu'un grab notre HRP (WeldConstraint apparu)
                local grabParts = workspace:FindFirstChild("GrabParts")
                if grabParts then
                    local gp   = grabParts:FindFirstChild("GrabPart")
                    local weld = gp and gp:FindFirstChild("WeldConstraint")
                    local held = weld and weld.Part1
                    if held and held:IsDescendantOf(char) then
                        local owner = held:FindFirstChild("PartOwner")
                        if owner and owner.Value ~= "" and owner.Value ~= _PS_KD.LocalPlayer.Name then
                            local pName = owner.Value
                            _kdHistory[pName] = (_kdHistory[pName] or 0) + 1
                            if _kdHistory[pName] == _kdThresh then
                                notify("Kick Detector", "⚠ " .. pName .. " essaie de te kick !", 5)
                            end
                        end
                    end
                end

                -- Détecte vélocité anormale (kick physique)
                if root.AssemblyLinearVelocity.Magnitude > 150 then
                    -- Cherche qui est proche et a probablement causé ça
                    local closest, closestDist = nil, math.huge
