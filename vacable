                        -- La tête doit être à : sol + hauteur formation + head height offset
                        local targetHeadHeight = groundHeight + formationHeight + figureHeadHeight
                        if _lkY and targetHeadHeight < _lkY then targetHeadHeight = _lkY end            -- 🧗 verrou d'arrivée : jamais sous le rebord
                        targetHeadHeight = _G._FigureDropLimit(targetHeadHeight, dt)                   -- ⬇️ plus de TP instantané vers le bas
                        
                        -- TP la tête à la bonne hauteur pour que les pieds touchent le sol
                        headPos = Vector3.new(bodyRefPos.X, targetHeadHeight, bodyRefPos.Z)
                        formationRefPos = headPos  -- Le corps suit aussi cette hauteur
                        shouldTPHead = true
                    end
                elseif figureGroundSnap then
                    -- 🦘 SAUT LIBRE : sol = plancher, saut simulé (gravité) -> tu peux sauter normalement
                    local _fjY = _G._FigureFreeJumpStep(bodyRefPos, dt)
                    local _landY2 = (_G._ObjCtrlFlying == true) and _G._FigureLandY(bodyRefPos, dt) or nil
                    if _landY2 then _fjY = _landY2 end   -- 🛬 atterrissage automatique en douceur (vol)
                    if _fjY then
                        headPos = Vector3.new(bodyRefPos.X, _fjY, bodyRefPos.Z)
                        formationRefPos = headPos
                        shouldTPHead = true
                    end
                else
                    -- Sans Ground Snap, applique juste le Head Height offset
                    if figureHeadHeight ~= 0 then
                        headPos = bodyRefPos + Vector3.new(0, figureHeadHeight, 0)
                        formationRefPos = headPos  -- Le corps suit aussi
                        shouldTPHead = true
                    end
                end
                
                -- 🧗 ESCALADE AUTO : colle-toi à un mur -> grimpe le mur, puis traction par-dessus le rebord (toggle "Escalade automatique")
                do
                    local _okC, _cp = pcall(_G._FigureClimbStep, headPos, 18 * figureScale, figureScale * figureCompactness, dt)
                    if _okC and _cp then
                        headPos, formationRefPos, shouldTPHead = _cp, _cp, true
                        if _G._FigureGS then _G._FigureGS.y, _G._FigureGS.t = _cp.Y, os.clock() end
                    end
                end

                -- 🕷️ RAMPER SUR LES SURFACES : sol / murs / toits (toggle "Ramper sur les surfaces") ; remplace la position de la formation
                do
                    local _okR, _cO = pcall(_G._FigureCrawlStep, dt, figureScale * figureCompactness, headPos)
                    if _okR and _cO then
                        headPos, formationRefPos, shouldTPHead = _cO, _cO, true
                    end
                end

                -- 🍑 Twerk / Dab / Disco / ... : la tête se déplace avec le buste
                local headWritePos = headPos  -- où le toy de tête est envoyé (le corps, lui, reste ancré sur headPos)
                -- 🔗 TÊTE RACCORDÉE AU TORSE (toggle) : pour toutes les autres animations, la tête suit le cou réel (position + inclinaison)
                -- (le toggle est prioritaire : la tete suit le cou reel meme pendant les emotes / poses gerees par HeadOffset)
                local _headAtt = _animBlend.headAttach and figureFormation == "Stick Man" and #figureBodyCache >= 13
                    and _EmoteX.atOff ~= nil and (os.clock() - (_EmoteX.atT or -9)) < 0.25 and _EmoteX.atOff.Magnitude > 0.02 and not _G._FigureIsSuperman()
                if _headEmote or _headAtt then
                    _EmoteX.lastBase = bodyRefPos
                    local off
                    if _headAtt then
                        off = _EmoteX.atOff
                    elseif _headEmote then
                        off = _EmoteX.HeadOffset((_G._FigureCrawl.act and "Ramper") or _EmoteX.poseActive or ((figureAnimationMode == "Auto" and (_EmoteX.curAnim == "Chute" or _EmoteX.curAnim == "Saut" or _EmoteX.curAnim == "Vol" or _EmoteX.curAnim == "Coucou" or _EmoteX.curAnim == "Escalade")) and _EmoteX.curAnim or figureAnimationMode), walkPhase, figureLimbSwing, bodyRight, bodyFwd, figureScale * figureCompactness)
                    end
                    if off then
                        headWritePos = headPos + off
                        shouldTPHead = true
                        _EmoteX.lastWritten = headWritePos
                        _EmoteX.lastOff = off
                        _EmoteX.fadeT = nil
                    end
                elseif _EmoteX.lastWritten then
                    -- 🧍 Mise à plat progressive : juste après un vol, la tête revient doucement à sa position debout
                    local _sd = _G._FigureStandDur or 0.9
                    if (_G._FigureStandUp ~= false) and _EmoteX.lastOff and (os.clock() - (_EmoteX.volT or -9)) < 2 and _EmoteX.lastOff.Magnitude > 0.3 then
                        _EmoteX.fadeT = _EmoteX.fadeT or os.clock()
                        local _fw = math.clamp((os.clock() - _EmoteX.fadeT) / math.max(_sd, 0.05), 0, 1)
                        _fw = _fw * _fw * (3 - 2 * _fw)
                        shouldTPHead = true
                        if _fw < 1 then
                            headWritePos = headPos + _EmoteX.lastOff * (1 - _fw)
                            _EmoteX.lastWritten = headWritePos
                            _EmoteX.lastBase = bodyRefPos
                        else
                            _EmoteX.lastWritten, _EmoteX.lastBase, _EmoteX.lastOff, _EmoteX.fadeT = nil, nil, nil, nil
                        end
                    else
                        -- fin de l'emote : remet la tête à sa position debout (une fois)
                        shouldTPHead = true
                        _EmoteX.lastWritten, _EmoteX.lastBase, _EmoteX.lastOff, _EmoteX.fadeT = nil, nil, nil, nil
                    end
                end

                -- 🦴 cou fixe / 🎭 geste en cours : la tête doit être écrite même sans Ground Snap
                -- 🫁 Idle vivant : fondu d'entrée / sortie (actif seulement en Idle, Stick Man 13+ toys)
                do
                    local _idleOn = _animBlend.idleAlive and _EmoteX.curAnim == "Idle" and figureFormation == "Stick Man"
                        and #figureBodyCache >= 13 and not _G._FigureIsSuperman()
                    _animBlend.idleW = math.clamp((_animBlend.idleW or 0) + (_idleOn and dt or -dt) * 2.5, 0, 1)
                end
                if (_animBlend.neckPivot or _animBlend.gest or (_animBlend.idleW or 0) > 0.001) and not _G._FigureIsSuperman() then shouldTPHead = true end

                -- 🧗 escalade : le corps reste ancré sur la position d'escalade (évite tout retour à l'ancienne position)
                if (_G._FigureClimb.active or _G._FigureClimb.justEnded or _G._FigureCrawl.act or _G._FigureCrawl.justEnded) and _EmoteX.lastWritten then _EmoteX.lastBase = headPos end
                _G._FigureClimb.justEnded = false
                _G._FigureCrawl.justEnded = false

                -- 🏃 RECUL RÉALISTE du bras qui tient le joueur : vitesse horizontale lissée de la formation -> le bras est tiré vers l'arrière
                do
                    local _FGl = _G._FigGrab
                    if _FGl and _FGl.lagOn then
                        local hp = Vector3.new(headPos.X, 0, headPos.Z)
                        local v = Vector3.zero
                        if _FGl.lagLast and dt > 0 then v = (hp - _FGl.lagLast) / math.max(dt, 0.001) end
                        _FGl.lagLast = hp
                        if v.Magnitude > 150 then v = Vector3.zero end   -- téléportation : pas de recul
                        _FGl.lagV = (_FGl.lagV or Vector3.zero):Lerp(v, 1 - math.exp(-10 * dt))
                        local amt = (_FGl.lagAmt or 50) / 50
                        local tgt = -_FGl.lagV * (0.1 * amt)
                        local maxL = math.min(4.5 * amt, 0.85 * (_FGl.reach or 4.4))   -- le bras ne repasse jamais derrière l'épaule
                        if tgt.Magnitude > maxL then tgt = tgt.Unit * maxL end
                        _FGl.lag = (_FGl.lag or Vector3.zero):Lerp(tgt, 1 - math.exp(-7 * dt))
                    elseif _FGl then
                        _FGl.lag, _FGl.lagV, _FGl.lagLast = nil, nil, nil
                    end
                end

                if _G.HelperDebug and _G._FigureClimb and (_G._FigureClimb.active or os.clock() - (_G._FigureClimb.endT or -9) < 1.5) then
                    local _dj = (headWritePos - (_G._FigureDbgLast or headWritePos)).Magnitude
                    if _dj > 6 then
                        warn("[ESCALADE-DBG] saut de", math.floor(_dj), "studs | etat", _G._FigureClimb.state, "| toy", originalHeadPos, "| bodyRef", bodyRefPos, "| headPos", headPos, "| ecrit", headWritePos, "| sol touche :", _G._FigureDbgHit and _G._FigureDbgHit:GetFullName() or "rien")
                    end
                    _G._FigureDbgLast = headWritePos
                end

                -- 🛫 ANTI-SOUS-MAP (décollage / vol) : voir _FigureAntiVoid
                do
                    local _okAV, _dyAV = pcall(_G._FigureAntiVoid, headPos, headWritePos, shouldTPHead)
                    if _okAV and _dyAV and _dyAV ~= 0 and shouldTPHead then
                        local _dv = Vector3.new(0, _dyAV, 0)
                        headWritePos, headPos, formationRefPos = headWritePos + _dv, headPos + _dv, formationRefPos + _dv
                        if _EmoteX.lastWritten then _EmoteX.lastWritten = headWritePos end
                        if _EmoteX.lastBase then _EmoteX.lastBase = headPos end
                    end
                end

                -- 🚀 TP LA TÊTE avec position ajustée (Ground Snap + Head Height) + ROTATION CAMÉRA
                if shouldTPHead then
                    local RS = game:GetService("ReplicatedStorage")
                    local SNO = RS:FindFirstChild("GrabEvents") and RS.GrabEvents:FindFirstChild("SetNetworkOwner")
                    
                    if SNO then
                        -- 🦸 MODE SUPERMAN : Détecte si on vole en mode Face Camera
                        local isSupermanMode = _G._FigureIsSuperman()
                        
                        local cam = workspace.CurrentCamera
                        local camLook = cam.CFrame.LookVector
                        local headTargetCF
                        
                        if isSupermanMode then
                            -- ✈️ Superman: La tête suit la rotation COMPLÈTE de la caméra
                            local cam = workspace.CurrentCamera
                            local camCF = cam.CFrame
                            local camRotation = camCF - camCF.Position
                            
                            -- Applique rotation complète + inclinaison Superman
                            headTargetCF = CFrame.new(headWritePos) * camRotation * CFrame.Angles(math.rad(-90), 0, 0)
                            -- 🛫/🛬 décollage en arc + redressement près du sol : la tête passe en douceur de "debout" à "couchée"
                            local _vw = _EmoteX.VolW()
                            if _vw < 0.999 then
                                local _cf0 = CFrame.new(headWritePos, headWritePos + camLook)
                                headTargetCF = CFrame.new(headWritePos) * (_cf0 - _cf0.Position):Lerp(headTargetCF - headTargetCF.Position, _vw)
                            end
                        elseif _G._FigureCrawl.act then
                            -- 🕷️ Ramper : la tête regarde vers l'avant de la surface (haut = normale de la surface)
                            headTargetCF = _G._FigureCrawlHeadCF(headWritePos)
                        else
                            -- Mode normal : La tête suit la direction de la caméra
                            if _animBlend.neckPivot and _animBlend.ClampLook then camLook = _animBlend.ClampLook(camLook) end   -- 🦴 limite humaine
                            -- ⚰️ ENTERREMENT : la tête fixe le joueur (indépendante de la caméra), puis se relève quand il a disparu.
                            do
                                local _BY = _G._FigureBury
                                if _BY and _BY.vp then
                                    -- ⚰️ regard simple : la tête fixe le joueur (cap horizontal stable, pitch limité à -45° / +20°) ;
                                    -- quand il a disparu sous le sol (sunk -> 1) elle se relève et regarde droit devant.
                                    local _to = _BY.vp - headWritePos
                                    local _hh = Vector3.new(_to.X, 0, _to.Z)
                                    local _hf
                                    if _hh.Magnitude > 1.5 then
                                        _hf = _hh.Unit
                                        _BY.gz = _hf
                                    else
                                        _hf = _BY.gz or ((_BY.fwd and _BY.fwd.Magnitude > 0.05) and _BY.fwd.Unit) or Vector3.new(0, 0, -1)
                                    end
                                    local _pp = (_to.Magnitude > 1e-3) and math.asin(math.clamp(_to.Unit.Y, -1, 1)) or 0
                                    _pp = math.clamp(_pp, math.rad(-45), math.rad(20))
                                    local _look = _hf * math.cos(_pp) + Vector3.yAxis * math.sin(_pp)
                                    local _w = math.clamp(((_BY.sunk or 0) - 0.8) / 0.2, 0, 1)
                                    _w = _w * _w * (3 - 2 * _w)
                                    camLook = (_look * (1 - _w) + _hf * _w).Unit
                                end
                            end
                            if _EmoteX.poseActive == "Allongé" or figureAnimationMode == "Allongé" then
                                -- 😊 Allongé : la tête reste relevée (regard à l'horizontale = tête un peu levée) et limitée à une plage
                                -- confortable : elle ne plonge plus dans le sol quand tu regardes en bas, ni ne se renverse en regardant en haut
                                local _hl = Vector3.new(camLook.X, 0, camLook.Z)
                                if _hl.Magnitude > 1e-3 then
                                    local _pn = math.clamp(math.asin(math.clamp(camLook.Y, -1, 1)) + math.rad(14), math.rad(-12), math.rad(60))
                                    camLook = _hl.Unit * math.cos(_pn) + Vector3.yAxis * math.sin(_pn)
                                end
                            end
                            if figureHeadFullRotation then
                                -- 🎯 ROTATION COMPLÈTE : haut/bas + gauche/droite
                                headTargetCF = CFrame.new(headWritePos, headWritePos + camLook)
                            else
                                -- 🎯 ROTATION HORIZONTALE SEULEMENT : gauche/droite uniquement
                                local horizontalLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
                                headTargetCF = CFrame.new(headWritePos, headWritePos + horizontalLook)
                            end
                        end
                        
                        -- 🔗 Tête raccordée : elle s'incline avec le torse (60 % de l'inclinaison, comme une vraie nuque)
                        -- 😊 Allongé / Pompes : la tête ne s'incline PAS avec le torse (qui est couché) : elle pivote de 90° par rapport au corps et regarde vers l'avant
                        local _isLie = (_EmoteX.poseActive == "Allongé" or figureAnimationMode == "Allongé" or _EmoteX.poseActive == "Pompes" or figureAnimationMode == "Pompes")
                        if _animBlend.headAttach and not isSupermanMode and not _isLie and _EmoteX.atUp and (os.clock() - (_EmoteX.atT or -9)) < 0.25 then
                            local _up = _EmoteX.atUp
                            local _ang = math.acos(math.clamp(_up.Y, -1, 1))
                            if _ang > 0.01 and _ang < 1.9 then
                                local _ax = Vector3.yAxis:Cross(_up)
                                if _ax.Magnitude > 1e-4 then
                                    local _tilt = CFrame.fromAxisAngle(_ax.Unit, _ang * (_animBlend.headTilt or 0.6))
                                    headTargetCF = CFrame.new(headWritePos) * _tilt * (headTargetCF - headTargetCF.Position)
                                end
                            end
                        end

                        -- 🦴 COU FIXE + 🎭 GESTES DE TÊTE (Oui / Non / Haussement / Incliner)
                        -- Le cou reste fixe sous la tête : la tête tourne AUTOUR du cou (pas autour de son propre centre),
                        -- donc quand elle penche vers l'avant elle avance et descend au lieu de s'enfoncer dans le torse (double menton).
                        if not isSupermanMode and not _G._FigureCrawl.act and (_animBlend.neckPivot or _animBlend.gest or (_animBlend.idleW or 0) > 0.001) then
                            pcall(function()
                                local _gp, _gy, _gr, _gdip = 0, 0, 0, 0
                                if _animBlend.GestureEval then _gp, _gy, _gr, _gdip = _animBlend.GestureEval() end
                                local _cs = figureScale * figureCompactness
                                -- 🫁 Idle vivant : micro-mouvements de la tête + respiration + poids qui passe d'un côté à l'autre
                                local _iw = (_animBlend.idleW or 0) * (_animBlend.idleAmt or 1)
                                local _idleOff = Vector3.zero
                                if _iw > 0.001 then
                                    local _t = os.clock()
                                    _gp = _gp + math.rad(2.5) * math.sin(_t * 0.9) * _iw
                                    _gy = _gy + math.rad(6) * (math.sin(_t * 0.37) + 0.4 * math.sin(_t * 1.1)) * _iw
                                    _gr = _gr + math.rad(2) * math.sin(_t * 0.53 + 0.8) * _iw
                                    _idleOff = Vector3.new(0, math.sin(_t * 1.5) * 0.14 * _cs * _iw, 0)
                                        + bodyRight * (_animBlend.IdleSway(_t) * 0.35 * _cs * _iw)
                                end
                                local _rot = headTargetCF - headTargetCF.Position
                                if _gp ~= 0 or _gy ~= 0 or _gr ~= 0 then
                                    _rot = _rot * CFrame.Angles(_gp, _gy, _gr)
                                end
                                local _base = headTargetCF.Position
                                local _pos = _base - Vector3.new(0, _gdip * _cs, 0)
                                if _animBlend.neckPivot then
                                    local _L = (_animBlend.neckLen or 1.0) * 1.5 * _cs
                                    local _bu = Vector3.yAxis
                                    if _animBlend.headAttach and not _isLie and _EmoteX.atUp and (os.clock() - (_EmoteX.atT or -9)) < 0.25 then
                                        _bu = _EmoteX.atUp
                                    end
                                    -- pivot = sommet du cou ; la tête = pivot + (haut de la tête) * longueur
                                    _pos = _base - _bu * _L + _rot.UpVector * _L - Vector3.new(0, _gdip * _cs, 0)
                                end
                                _pos = _pos + _idleOff
                                headTargetCF = CFrame.new(_pos) * _rot
                                -- 🦴 le cou se plie vers la tête : on mémorise l'inclinaison (par rapport au cap) et le décalage de la tête
                                _animBlend.nkTilt = nil
                                if _animBlend.neckPivot and (_animBlend.neckBend or 0) > 0 then
                                    local _lk = _rot.LookVector
                                    local _fl = Vector3.new(_lk.X, 0, _lk.Z)
                                    if _fl.Magnitude > 1e-3 then
                                        local _yo = CFrame.lookAt(Vector3.zero, _fl.Unit)
                                        _animBlend.nkTilt = CFrame.new():Lerp(_rot * _yo:Inverse(), _animBlend.neckBend)
                                        _animBlend.nkShift = (_pos - _base) * _animBlend.neckBend * 0.9
                                        _animBlend.nkT = os.clock()
                                    end
                                end
                                -- le corps reste ancré : on mémorise où la tête a été envoyée (même système que les emotes)
                                _EmoteX.lastBase = bodyRefPos
                                _EmoteX.lastWritten = _pos
                            end)
                        end

                        -- 🧍 Mise à plat progressive : à la fin du vol, la tête passe de la rotation "couchée" à la rotation debout en douceur
                        if _G._FigureStandUp ~= false then
                            if isSupermanMode then
                                _EmoteX.supRot, _EmoteX.supT = headTargetCF - headTargetCF.Position, nil
                            elseif _EmoteX.supRot then
                                _EmoteX.supT = _EmoteX.supT or os.clock()
                                local _rw = math.clamp((os.clock() - _EmoteX.supT) / math.max(_G._FigureStandDur or 0.9, 0.05), 0, 1)
                                _rw = _rw * _rw * (3 - 2 * _rw)
                                if _rw >= 1 then
                                    _EmoteX.supRot, _EmoteX.supT = nil, nil
                                else
                                    local _rotN = headTargetCF - headTargetCF.Position
                                    headTargetCF = CFrame.new(headTargetCF.Position) * _EmoteX.supRot:Lerp(_rotN, _rw)
                                end
                            end
                        end

                        pcall(function()
                            if _G._FigureNoclip then _G._FigureNoclipApply(headToy, true) end
                            headToy.CFrame = headTargetCF
                            _G._FigureHeadCF, _G._FigureHeadToy, _G._FigureHeadT = headTargetCF, headToy, os.clock()   -- 👁️ vue 1re personne
                            headToy.AssemblyLinearVelocity = Vector3.zero
                            if _G._FigureHeadNetOk(headToy) then   -- 🛠️ FIX GRAB : plus de spam réseau à chaque frame
                                SNO:FireServer(headToy, headTargetCF)
                            end
                        end)
                    end
                end
                
                -- 🪑 RIDE HEAD : TP le personnage sur la tête de la formation
                if figureRideHead then
                    local char = Player.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    local humanoid = char and char:FindFirstChild("Humanoid")
                    
                    if root and humanoid and headToy then
                        -- Position RELATIVE au toy (offset fixe au-dessus)
                        -- Utilise le CFrame du toy directement pour maintenir la position relative
                        local headToyCF = headToy.CFrame
                        local offsetAboveHead = Vector3.new(0, figureRideHeight, 0)
                        
                        -- Crée un CFrame qui est locké au toy avec offset
                        -- Le personnage suit la rotation complète du toy
                        local rideCF = headToyCF * CFrame.new(offsetAboveHead)
                        
                        -- TP le personnage avec rotation lockée au toy
                        if _G._RideCharNoclip and _G._RideNCApply then pcall(_G._RideNCApply, char, headToy) end
                        pcall(function()
                            root.CFrame = rideCF
                            root.AssemblyLinearVelocity = Vector3.zero
                            
                            -- Joue l'animation Sit si pas déjà en train de s'asseoir
                            if humanoid.Sit ~= true then
                                humanoid.Sit = true
                            end
                        end)
                    end
                else
                    -- Si désactivé, retire l'animation Sit
                    if _G._RideNCClear then _G._RideNCClear() end
                    local char = Player.Character
                    local humanoid = char and char:FindFirstChild("Humanoid")
                    if humanoid and humanoid.Sit then
                        humanoid.Sit = false
                    end
                end
                
                -- Détecte le mouvement et la vitesse
                local isMoving = false
                local moveSpeed = 0
                local currentAnimation = "Idle"
                
                if lastHeadPos then
                    local moveDist = (headPos - lastHeadPos).Magnitude
                    moveSpeed = moveDist / dt  -- Vitesse en studs/sec
                    isMoving = moveSpeed > 0.5  -- Seuil de détection de mouvement
                    -- Vitesse horizontale lissée, en unités du bonhomme (sert à Walk v2 / Run v2)
                    local _hv = Vector3.new(headPos.X - lastHeadPos.X, 0, headPos.Z - lastHeadPos.Z).Magnitude / math.max(dt, 1e-3)
                    local _csU = math.max(figureScale * figureCompactness, 0.05)
                    _EmoteX.speedU = (_EmoteX.speedU or 0) + (_hv / _csU - (_EmoteX.speedU or 0)) * math.min(1, dt * 10)
                    -- Vitesse décomposée droite / avant (repère du corps = direction caméra), pour pencher le Stick Man
                    local _fl = _TwerkFlat(bodyFwd)
                    local _rt = Vector3.new(bodyRight.X, 0, bodyRight.Z)
                    _rt = (_rt.Magnitude > 0.01) and _rt.Unit or Vector3.new(-_fl.Z, 0, _fl.X)
                    local _hvec = Vector3.new(headPos.X - lastHeadPos.X, 0, headPos.Z - lastHeadPos.Z) / math.max(dt, 1e-3)
                    local _kv = math.min(1, dt * 10)
                    _EmoteX.velR = (_EmoteX.velR or 0) + (_hvec:Dot(_rt) / _csU - (_EmoteX.velR or 0)) * _kv
                    _EmoteX.velF = (_EmoteX.velF or 0) + (_hvec:Dot(_fl) / _csU - (_EmoteX.velF or 0)) * _kv
                    -- 🛠️ Inclinaison PROGRESSIVE : la direction d'inclinaison (droite / avant) n'est plus recalculée d'un coup,
                    -- elle rejoint sa cible à la vitesse du slider "Vitesse d'inclinaison" (bas = lent et progressif, haut = direct)
                    do
                        local _lr, _lf = _EmoteX.velR or 0, _EmoteX.velF or 0
                        local _lsp = math.sqrt(_lr * _lr + _lf * _lf)
                        local _tdx, _tdz = 0, 1
                        if _lsp > 0.3 then _tdx, _tdz = _lr / _lsp, _lf / _lsp end
                        local _lk = math.min(1, dt * (_G._FigureLeanRate or 4))
                        _EmoteX.leanDx = (_EmoteX.leanDx or 0) + (_tdx - (_EmoteX.leanDx or 0)) * _lk
                        _EmoteX.leanDz = (_EmoteX.leanDz or 1) + (_tdz - (_EmoteX.leanDz or 1)) * _lk
                    end
                    
                    -- Détection auto de l'animation selon la vitesse
                    if figureAnimationMode == "Auto" then
                        -- 🍂 Chute : on retombe (Stick Man uniquement ; les autres formations gardent "Jump")
                        local _fj = _G._FigureFJ
                        local _sautLibre = figureGroundSnap and _G._FigureGroundMethod == "Saut Libre"
                        local _airFJ = _sautLibre and _fj and _fj.air
                        local _falling = false
                        _EmoteX.airVy = 0
                        if _airFJ then
                            if _fj.vy < -4 then _falling, _EmoteX.airVy = true, _fj.vy end
                        elseif not _sautLibre then
                            local _ch = Player.Character
                            local _hrp = _ch and _ch:FindFirstChild("HumanoidRootPart")
                            local _hum = _ch and _ch:FindFirstChildOfClass("Humanoid")
                            if _hrp and _hum and _hum:GetState() == Enum.HumanoidStateType.Freefall and _hrp.AssemblyLinearVelocity.Y < -8 then
                                _falling, _EmoteX.airVy = true, _hrp.AssemblyLinearVelocity.Y
                            end
                        end
                        -- 🦘 Saut libre (Stick Man complet) : animation de saut pilotée par l'état réel du saut
                        local _jumpAnim = false
                        if _sautLibre and _fj and figureFormation == "Stick Man" and #figureBodyCache >= 13 then
                            if _airFJ then
                                -- seule une chute bien plus rapide qu'un saut (grosse descente) repasse en "Chute"
                                _jumpAnim = _fj.jumped and (_fj.vy or 0) > -((_fj.vy0 or 0) + 25)
                            else
                                _jumpAnim = (_fj.landT or 99) < 0.32 and (_fj.landV or 0) > 8 and _hv < 22   -- réception (pas en pleine course)
                            end
                        end
                        -- 🦸 Vol (Stick Man complet) : "Vol" = Superman en mode "Face Camera", sinon pose de flottement
                        local _flyAnim = nil
                        if figureFormation == "Stick Man" and #figureBodyCache >= 13 then
                            if _sautLibre and _fj and _fj.flying then
                                _flyAnim = (figureFlightMode == "Face Camera") and "Vol" or "Saut"
                            elseif figureFlightMode == "Face Camera" and (not figureGroundSnap or _G._ObjCtrlFlying == true) then
                                _flyAnim = "Vol"
                            end
                        end
                        if _flyAnim ~= "Vol" then _EmoteX.inVol = false; _G._FigureHoverW = 0 end
                        -- 🛠️ FIX REPRISE DU VOL : à chaque (re)démarrage du vol (R), on oublie l'ancien vol -> les toys sont replacés tout de suite
                        -- sur TA position actuelle (pas de glissade depuis l'endroit où le dernier vol s'est arrêté) et resynchronisés au serveur
                        do
                            local _nf = (_G._ObjCtrlFlying == true)
                            if _nf and not _EmoteX.wasFly then
                                _G._FigureFlyBoost = os.clock()
                                _G._FigureFlyNet = {}
                                _EmoteX.lastBase, _EmoteX.lastWritten, _EmoteX.lastOff, _EmoteX.fadeT = nil, nil, nil, nil
                                _EmoteX.supRot, _EmoteX.supT = nil, nil
                                _G._FigureFlyStaleLerp = true
                            end
                            _EmoteX.wasFly = _nf
                        end
                        -- 🐕 Chien : saut / chute automatiques (Saut Libre = vraie simulation ; sinon état du Humanoid)
                        local _dogAir = nil
                        if figureFormation == "Chien" then
                            if _sautLibre and _fj then
                                if _fj.air then _dogAir = ((_fj.vy or 0) > -3) and "Jump" or "Chute" end
                            else
                                local _ch2 = Player.Character
                                local _hrp2 = _ch2 and _ch2:FindFirstChild("HumanoidRootPart")
                                local _hum2 = _ch2 and _ch2:FindFirstChildOfClass("Humanoid")
                                if _hrp2 and _hum2 then
                                    local _st2, _vy2 = _hum2:GetState(), _hrp2.AssemblyLinearVelocity.Y
                                    if _st2 == Enum.HumanoidStateType.Jumping then
                                        _dogAir = "Jump"
                                    elseif _st2 == Enum.HumanoidStateType.Freefall then
                                        _dogAir = (_vy2 > -6) and "Jump" or "Chute"
                                    end
                                end
                            end
                        end
                        if _flyAnim then
                            currentAnimation = _flyAnim
                            if _flyAnim == "Vol" then
                                -- 🏊 NAGE À L'ARRÊT : quand tu ne bouges presque plus en vol, le poids passe en douceur de 0 à 1 (et inversement)
                                local _hwT = (_G._FigureSwimHover ~= false and moveSpeed < (_G._FigureHoverThr or 3)) and 1 or 0
                                _G._FigureHoverW = (_G._FigureHoverW or 0) + (_hwT - (_G._FigureHoverW or 0)) * math.min(1, dt * 2.2)
                                _EmoteX.volT = os.clock()
                                if not _EmoteX.inVol then
                                    _EmoteX.inVol, _EmoteX.volStart, _G._FigureLandKs = true, os.clock(), ((_G._FigureLevitate ~= false) and 1 or 0)   -- début du vol (lévitation : on démarre droit)
                                    if _G._FigureLevitate ~= false then _G._FigureLevK, _G._FigureBackK = 1, 0 end
                                end
                            end
                        elseif _dogAir then
                            currentAnimation = _dogAir
                        elseif _jumpAnim then
                            currentAnimation = "Saut"
                        elseif _falling and figureFormation == "Stick Man" then
                            currentAnimation = "Chute"
                        elseif _airFJ then
                            currentAnimation = "Jump"   -- en l'air (Saut Libre)
                        else
                            -- 🛠️ FIX : vitesse LISSÉE + hystérésis. Avant, la vitesse brute (frame par frame) faisait osciller
                            -- Idle/Walk/Run quand on restait appuyé : la clé de transition fluide changeait en boucle, le corps
                            -- restait bloqué sur l'ancienne pose (figé) et la Sync Rotation n'était plus appliquée.
                            local _prevMs = _EmoteX.msSm or moveSpeed
                            _EmoteX.msSm = _prevMs + (moveSpeed - _prevMs) * math.min(1, dt * 8)
                            local _ms, _st = _EmoteX.msSm, _EmoteX.gaitState or "Idle"
                            if _st == "Idle" then
                                if _ms > 1.2 then _st = "Walk" end
                            elseif _st == "Walk" then
                                if _ms < 0.4 then _st = "Idle" elseif _ms > (_G._FigureRunThresh or 45) then _st = "Run" end   -- 🏃 seuil de course réglable (slider)
                            else
                                if _ms < (_G._FigureRunThresh or 45) * 0.75 then _st = "Walk" end
                            end
                            _EmoteX.gaitState = _st
                            currentAnimation = _st
                        end
                        -- 🎛️ Dropdowns Marche / Course : un style autre que "Classique" utilise le squelette v2 (Stick Man complet)
                        if figureFormation == "Stick Man" and #figureBodyCache >= 13 and _G._FigStyle then
                            if currentAnimation == "Walk" and _G._FigStyle.Walk ~= "Classique" then
                                currentAnimation = "Walk v2"
                            elseif currentAnimation == "Run" and _G._FigStyle.Run ~= "Classique" then
                                currentAnimation = "Run v2"
                            end
                        end
                    else
                        -- Force l'animation choisie
                        currentAnimation = figureAnimationMode
                    end
                    
                    -- 👋 COUCOU AUTO : à l'arrêt (mode Auto), salue tout seul quand un joueur est proche (< 30 studs) ou après 8 s d'idle
                    do
                        local _ca = _EmoteX.cAuto
                        if not _ca then _ca = { idle = 0, endT = 0, nextT = 0, chk = 0 }; _EmoteX.cAuto = _ca end
                        local _now = os.clock()
                        -- 💬 chat ouvert (une zone de texte a le focus) -> plus de pose idle / coucou auto si le toggle est actif
                        _EmoteX.chatTyping = _animBlend.noPoseChat and game:GetService("UserInputService"):GetFocusedTextBox() ~= nil
                        if _animBlend.coucouAuto and not _EmoteX.chatTyping and figureAnimationMode == "Auto" and figureFormation == "Stick Man" and #figureBodyCache >= 13 then
                            if currentAnimation == "Idle" then
                                _ca.idle = _ca.idle + dt
                                if _now < _ca.endT then
                                    currentAnimation = "Coucou"
                                elseif _ca.idle > 1 and _now >= _ca.nextT and _now >= _ca.chk then
                                    _ca.chk = _now + 0.5
                                    local _near = false
                                    for _, _pl in ipairs(game:GetService("Players"):GetPlayers()) do
                                        if _pl ~= Player then
                                            local _c = _pl.Character
                                            local _r = _c and _c:FindFirstChild("HumanoidRootPart")
                                            if _r and (_r.Position - headPos).Magnitude < 30 then _near = true break end
                                        end
                                    end
                                    if _near or _ca.idle > 8 then
                                        _ca.endT = _now + 3.5
                                        _ca.nextT = _now + 12
                                        currentAnimation = "Coucou"
                                    end
                                end
                            else
                                _ca.idle, _ca.endT = 0, 0
                            end
                        else
                            _ca.idle, _ca.endT = 0, 0
                        end
                    end
                    
                    -- 🧗 ESCALADE : pendant l'accroche / la traction, l'animation est forcée (mode Auto, Stick Man complet)
                    if _G._FigureClimb.active and figureAnimationMode == "Auto" and figureFormation == "Stick Man" and #figureBodyCache >= 13 then
                        currentAnimation = "Escalade"
                    end

                    -- 🕷️ RAMPER : l'animation est forcée tant que la rampe est active (Stick Man complet)
                    if _G._FigureCrawl.act and figureFormation == "Stick Man" and #figureBodyCache >= 13 then
                        currentAnimation = "Ramper"
                    end

                    -- Update de la phase d'animation
                    if isMoving or currentAnimation == "Dance" or currentAnimation == "Jump"
                        or currentAnimation == "Floss" or currentAnimation == "Jumping Jack"
                        or currentAnimation == "Floss v2" or currentAnimation == "Jumping Jack v2"
                        or currentAnimation == "Floss v3" or _EmoteX.skelAnims[currentAnimation]
                        or currentAnimation == "Twerk" or _StickDanceAnims[currentAnimation] then
                        -- Vitesse d'animation basée sur le slider et le type d'animation
                        local animSpeed = figureAnimationSpeed
                        if currentAnimation == "Run" then
                            animSpeed = animSpeed * 1.5  -- Course = plus rapide
                        elseif currentAnimation == "Dance" then
                            animSpeed = animSpeed * 0.8  -- Danse = plus lent
                        elseif currentAnimation == "Floss" then
                            animSpeed = animSpeed * 2.0  -- Floss = rythme rapide
                        elseif currentAnimation == "Jumping Jack" or currentAnimation == "Jumping Jack v2" then
                            animSpeed = animSpeed * 1.5
                        elseif currentAnimation == "Floss v2" then
                            animSpeed = animSpeed * 2.0
                        elseif currentAnimation == "Floss v3" then
                            animSpeed = animSpeed * 2.0
                        elseif currentAnimation == "Twerk" then
                            animSpeed = animSpeed * 4.0  -- Twerk = rebond rapide
                        end
                        
                        if currentAnimation == "Walk v2" or currentAnimation == "Run v2" then
                            -- cadence calée sur la vitesse réelle (le slider Animation Speed la multiplie)
                            -- ⏱️ vitesse par animation (bloc "Vitesse par animation" ; Run v2 = 60 % par défaut)
                            local _as = (_animBlend.animSpd and _animBlend.animSpd[currentAnimation]) or 1
                            -- 🧭 MARCHE DIRECTIONNELLE : la phase de marche avance toujours ; c'est la DIRECTION des pas qui change.
                            -- (gDx, gDz) = direction du déplacement dans le repère du corps (x = droite, z = avant), lissée VITE (~0,07 s) :
                            --   D = (1, 0) -> pas chassés vers la droite · S = (0, -1) -> pas en arrière · S+D = (0.7, -0.7) -> recul en diagonale.
                            -- Passer de D à S+D tourne la direction des pas en un clin d'œil ; un demi-tour complet (W <-> S) passe par une foulée
                            -- qui se raccourcit un instant puis repart dans l'autre sens. Quasi à l'arrêt on garde la dernière direction ;
                            -- au départ arrêté elle est appliquée tout de suite. Désactivable : toggle « Marche directionnelle ».
                            do
                                local _BOk = _G._FigBodyOrient
                                local _vf, _vr = _EmoteX.velF or 0, _EmoteX.velR or 0
                                local _vm = math.sqrt(_vf * _vf + _vr * _vr)
                                local _su = _EmoteX.speedU or 0
                                local _tx, _tz = 0, 1
                                if not (_BOk and _BOk.back == false) then
                                    if _vm > 1.0 and _su > 1.0 then _EmoteX.gTx, _EmoteX.gTz = _vr / _vm, _vf / _vm end
                                    _tx, _tz = _EmoteX.gTx or 0, _EmoteX.gTz or 1
                                end
                                local _gx, _gz = _EmoteX.gDx or 0, _EmoteX.gDz or 1
                                local _kk = (_su < 1.6) and 1 or math.min(1, dt * 14)
                                _gx, _gz = _gx + (_tx - _gx) * _kk, _gz + (_tz - _gz) * _kk
                                _EmoteX.gDx, _EmoteX.gDz = _gx, _gz
                                local _gm = math.sqrt(_gx * _gx + _gz * _gz)
                                local _ux, _uz = 0, 1
                                if _gm > 0.2 then _ux, _uz = _gx / _gm, _gz / _gm end
                                -- longueur de pas effective le long de la direction (le pas latéral est plus court) -> cadence plus rapide pour ne pas glisser
                                _EmoteX.gaitF = math.max(0.3, math.sqrt((0.45 * _ux) ^ 2 + _uz ^ 2))
                            end
                            walkPhase = walkPhase + dt * _as * math.min(24, _EmoteX.GaitOmega(currentAnimation, _EmoteX.speedU or 0, figureLimbSwing, figureAnimationSpeed) / (_EmoteX.gaitF or 1))
                        else
                            local _as = (_animBlend.animSpd and _animBlend.animSpd[currentAnimation]) or 1
                            walkPhase = walkPhase + dt * 4 * animSpeed * _as
                        end
                    end
                end
                lastHeadPos = headPos
                _EmoteX.curAnim = currentAnimation
                -- 🧍 Pose idle active ? (Stick Man, à l'arrêt, une pose choisie dans le dropdown)
                _EmoteX.poseActive = (figureFormation == "Stick Man" and currentAnimation == "Idle" and not _EmoteX.chatTyping) and _EmoteX.ResolveIdlePose() or nil
                
                -- Collecte les toys du corps (utilise bodyRefPos pour les positions)
                local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                if not inv then return end
                
                local bodyToys = {}
                
                -- 📦 MODE INVENTAIRE : Toys de l'inventaire
                if figureSourceMode == "Inventaire" or figureSourceMode == "Plot+Inventaire" then
                    for _, toy in ipairs(inv:GetChildren()) do
                        -- 💥 la pallet « ragdoll » du Grab Figure n'est jamais prise dans la formation (même pendant son spawn)
                        local _ragSkip = (_G._FigureExclude and _G._FigureExclude[toy])
                            or (_G._FigRagBusy and toy.Name == "PalletLightBrown" and _G._FigRagSnap and not _G._FigRagSnap[toy])
                            or (_G._FigMissBusy and toy.Name == "BombMissile" and _G._FigMissSnap and not _G._FigMissSnap[toy])
                            or (_G._FigDiceBusy and toy.Name == "DiceSmall" and _G._FigDiceSnap and not _G._FigDiceSnap[toy])
                        if toy:IsA("Model") and not _ragSkip and ((figureFormation ~= "Araignée Flippante" and figureFormation ~= "Oiseau Réaliste") or toy.Name == "DiceSmall" or toy.Name == "DiceBig") and (not _G._FigToyOK or figureFormation ~= "Stick Man" or _G._FigToyOK(toy.Name)) then
                            local part = toy:FindFirstChild("SoundPart")
                                    or toy:FindFirstChild("HoldPart")
                                    or toy:FindFirstChild("Main")

                            if part and part:IsA("BasePart") then
                                -- Exclut la tête
                                local isHead = (part == headToy) 
                                            or (part.Parent == headToy.Parent)
                                            or (part:IsDescendantOf(headToy.Parent))
                                
                                if not isHead then
                                    table.insert(bodyToys, part)
                                end
                            end
                        end
                    end
                end
                
                -- 🏠 MODE PLOT : Toys du plot
                if figureSourceMode == "Plot" or figureSourceMode == "Plot+Inventaire" then
                    local plots = workspace:FindFirstChild("Plots")
                    local plotItems = workspace:FindFirstChild("PlotItems")
                    
                    if plots and plotItems then
                        -- Trouve dans quel plot tu es owner
                        local myPlotName = nil
                        
                        for i = 1, 5 do
                            local plot = plots:FindFirstChild("Plot" .. i)
                            if plot then
                                local sign = plot:FindFirstChild("PlotSign")
                                local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                                
                                if owners then
                                    for _, ownerValue in ipairs(owners:GetChildren()) do
                                        if ownerValue.Value == Player.Name then
                                            myPlotName = "Plot" .. i
                                            _dbg("[FIGURE DEBUG] Plot trouvé:", myPlotName)
                                            break
                                        end
                                    end
                                end
                            end
                            if myPlotName then break end
                        end
                        
                        -- Collecte les toys du plot
                        if myPlotName then
                            local myPlotFolder = plotItems:FindFirstChild(myPlotName)
                            if myPlotFolder then
                                _dbg("[FIGURE DEBUG] Dossier plot trouvé:", myPlotFolder.Name, "avec", #myPlotFolder:GetChildren(), "enfants")
                                for _, toyModel in ipairs(myPlotFolder:GetChildren()) do
                                    if toyModel:IsA("Model") and ((figureFormation ~= "Araignée Flippante" and figureFormation ~= "Oiseau Réaliste") or toyModel.Name == "DiceSmall" or toyModel.Name == "DiceBig") and (not _G._FigToyOK or figureFormation ~= "Stick Man" or _G._FigToyOK(toyModel.Name)) then
                                        local mainPart = toyModel:FindFirstChild("Main", true) 
                                                    or toyModel:FindFirstChild("SoundPart", true)
                                                    or toyModel:FindFirstChild("HoldPart", true)
                                                    or toyModel.PrimaryPart
                                        
                                        if mainPart and mainPart:IsA("BasePart") and mainPart ~= headToy then  -- Exclut seulement la tête directement
                                            table.insert(bodyToys, mainPart)
                                            _dbg("[FIGURE DEBUG] Toy ajouté:", toyModel.Name)
                                        end
                                    end
                                end
                            else
                                _dbg("[FIGURE DEBUG] Dossier plot non trouvé:", myPlotName)
                            end
                        else
                            _dbg("[FIGURE DEBUG] Aucun plot trouvé pour", Player.Name)
                        end
                    else
                        _dbg("[FIGURE DEBUG] Plots ou PlotItems non trouvés dans workspace")
                    end
                end
                
                if #bodyToys == 0 then return end
                if figureFormation == "Araignée Flippante" and _G._Spooky and _G._Spooky.sort then _G._Spooky.sort(bodyToys) end   -- 🕷️ DiceBig en 1er (abdomen) + rôles des DiceSmall
                if figureFormation == "Oiseau Réaliste" and _G._Bird and _G._Bird.sort then _G._Bird.sort(bodyToys) end   -- 🦅 DiceBig en 1er (corps) + rôles des DiceSmall
                
                -- 📦 MET À JOUR LE CACHE POUR LES FORMATIONS
                figureBodyCache = bodyToys
                
                -- Print une fois quand on commence à positionner
                if debugTimer < dt * 2 then
                    -- Silencieux pour éviter spam console
                end
                
                -- ========================
                -- SYSTÈME DE TP SMOOTH (comme Toy Tornado)
                -- ========================
                local RS = game:GetService("ReplicatedStorage")
                local SNO = RS:FindFirstChild("GrabEvents") and RS.GrabEvents:FindFirstChild("SetNetworkOwner")
                
                if not SNO then return end
                
                -- 🛡️ REPRISE AUTO : si un autre joueur attrape un de mes toys (tête incluse), je le reprends tout de suite
                if _animBlend.guard then
                    local _g, _gnow = _animBlend.guardT, os.clock()
                    -- budget de requêtes (anti-lag) : ~guardMax demandes/s au total pour toute la formation, réparties équitablement
                    _animBlend.guardTok = math.min(_animBlend.guardMax, _animBlend.guardTok + dt * _animBlend.guardMax)
                    local _gch = Player.Character
                    local _ghrp = _gch and _gch:FindFirstChild("HumanoidRootPart")
                    local _PL = game:GetService("Players")
                    local function _guardCheck(_gp)
                        if not (_gp and _gp.Parent) then return end
                        local _po = _gp:FindFirstChild("PartOwner")
                        local _who = _po and _po.Value
                        if _who and _who ~= "" and _who ~= Player.Name and _PL:FindFirstChild(_who) then
                            if not _animBlend.guardStolen[_gp] then
                                _animBlend.guardStolen[_gp] = true
                                _g[_gp] = 0                                   -- reprise immediate, sans attendre l'ancien delai
                                _animBlend.guardTry = _animBlend.guardTry or {}
                                _animBlend.guardTry[_gp] = 0
                                if _gnow - _animBlend.guardNote > 1.5 then
                                    _animBlend.guardNote = _gnow
                                    notify("Animated Figure", "⚠️ " .. _who .. " a attrapé un toy : reprise", 2)
                                end
                            end
                            if _gnow >= (_g[_gp] or 0) then
                                if _ghrp and (_ghrp.Position - _gp.Position).Magnitude <= 20 then
                                    if _animBlend.guardTok >= 1 then
                                        _animBlend.guardTok = _animBlend.guardTok - 1
                                        -- à portée : 3 essais rapprochés (1 par frame, vérifiés à chaque frame via PartOwner), puis 1 demande / 0.1 s tant que le toy n'est pas repris
                                        _animBlend.guardTry = _animBlend.guardTry or {}
                                        local _tr = (_animBlend.guardTry[_gp] or 0) + 1
                                        _animBlend.guardTry[_gp] = _tr
                                        _g[_gp] = _gnow + ((_tr < 3) and 0 or 0.1)
                                        pcall(function() SNO:FireServer(_gp, _gp.CFrame) end)
                                    end
                                elseif _animBlend.guardTP and _G._AnchFetch then
                                    _animBlend.guardTry = _animBlend.guardTry or {}
                                    local _tr = (_animBlend.guardTry[_gp] or 0) + 1
                                    _animBlend.guardTry[_gp] = _tr
                                    _g[_gp] = _gnow + ((_tr < 3) and 0.35 or 1)      -- trop loin : aller-retour rapide, re-vérifié 3 fois de suite puis 1 fois par seconde
                                    pcall(_G._AnchFetch, _gp:FindFirstAncestorOfClass("Model") or _gp)
                                else
                                    _g[_gp] = _gnow + 0.25
                                end
                            end
                        elseif _animBlend.guardStolen[_gp] then
                            _animBlend.guardStolen[_gp] = nil   -- le toy est de nouveau à moi
                            if _animBlend.guardTry then _animBlend.guardTry[_gp] = nil end
                        end
                    end
                    _guardCheck(headToy)   -- la tête en priorité
                    local _gn = #bodyToys
                    _animBlend.guardRot = (_animBlend.guardRot + 1) % math.max(_gn, 1)   -- départ tournant : tous les toys passent à tour de rôle
                    for _k = 1, _gn do _guardCheck(bodyToys[((_k + _animBlend.guardRot - 1) % _gn) + 1]) end
                end
                
                -- Reclaim ownership périodique (toutes les 2s)
                ownershipTimer = ownershipTimer + dt
                if ownershipTimer >= 2 and not _G._FigureGripBusy() then
                    ownershipTimer = 0
                    for _, part in ipairs(bodyToys) do
                        pcall(function() SNO:FireServer(part, part.CFrame) end)
                    end
                end
                
                -- Update réseau limité à 1x toutes les 0.5s (comme Tornado ligne 11705)
                local currentTime = tick()
                local shouldUpdateNetwork = (currentTime - lastNetworkUpdate) >= 0.5
                if shouldUpdateNetwork then
                    lastNetworkUpdate = currentTime
                end
                
                -- 🎞️ TRANSITION FLUIDE : détecte un changement d'animation / de pose idle (une fois par frame)
                local _ab = _animBlend
                do
                    local now = os.clock()
                    local on = _ab.enabled and figureFormation == "Stick Man"
                    local key = tostring(currentAnimation) .. "|" .. tostring(_EmoteX.poseActive or "")
                    _ab.on = on
                    _ab.fresh = false
                    if key ~= _ab.key then
                        local _oldKey = _ab.key
                        _ab.key = key
                        _dbg("[AnimKey]", _oldKey, "->", key, math.floor(moveSpeed))
                        -- 🛫 Décollage en arc : on entre dans la pose "Vol" -> le corps se couche en arc autour de la tête
                        _ab.takeoff = (_G._FigureTakeoffArc ~= false) and currentAnimation == "Vol"
                            and _oldKey ~= nil and string.sub(_oldKey, 1, 4) ~= "Vol|"
                        _ab.fast = (not _ab.takeoff) and ((currentAnimation == "Saut") or (_oldKey ~= nil and string.sub(_oldKey, 1, 5) == "Saut|"))
                        -- 🧍 Mise à plat progressive : on sort de la pose "Vol" -> le corps se redresse en arc, plus lentement
                        _ab.stand = (not _ab.fast) and (_G._FigureStandUp ~= false) and not _EmoteX.wAnim[currentAnimation]
                            and _oldKey ~= nil and string.sub(_oldKey, 1, 4) == "Vol|"
                        -- on ne fond que si on avait des poses récentes à partir desquelles partir
                        if on and (now - _ab.lastFrame) < 0.5 then
                            _ab.fresh = true
                            _ab.t0 = now
                        end
                    end
                    local _abD = _ab.fast and (_G._FigureJumpBlend or 0.3)   -- 🦘 transition du saut (entrée + redressement), réglable
                        or (_ab.takeoff and (_G._FigureTakeoffDur or 0.7))
                        or ((_ab.stand and math.max(_ab.dur, _G._FigureStandDur or 0.9)) or _ab.dur)
                    local w = on and math.clamp((now - _ab.t0) / math.max(_abD, 0.05), 0, 1) or 1
                    _ab.k = 1 - w * w * (3 - 2 * w)   -- 1 = ancienne pose, 0 = nouvelle pose
                    if on then _ab.lastFrame = now end
                end
                
                -- Applique la formation
                local numToys = #bodyToys
                -- 🌊 Vague : active seulement pendant que tu ecris (chat / zone de texte), + 1.2 s apres l'envoi
                local _waveOn = false
                if _animBlend.wave then
                    local _wnow = os.clock()
                    if game:GetService("UserInputService"):GetFocusedTextBox() ~= nil then
                        _animBlend.waveUntil = _wnow + 1.2
                    end
