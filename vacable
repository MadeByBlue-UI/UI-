                end
            elseif input.KeyCode == unAnchorToysKey then
                -- Dsancre tous les objets ancrs directement
                local count = 0
                for model, data in pairs(AnchoredObjects) do
                    for _, obj in ipairs(data.Parts or {}) do
                        if obj and obj.Parent then
                            obj.Anchored = false
                        end
                    end
                    model:SetAttribute("IsAnchored", false)
                    AnchoredObjects[model] = nil
                    count = count + 1
                end
                if count > 0 then
                    notify("Toys", count .. " objet(s) dsancr(s).", 2)
                end
            end
