        function ChangeSBstate() end

        -- Network ownership helper
        function lookAt(from, to)
            local unit = (to - from).Unit
            local right = unit:Cross(Vector3.new(0, 1, 0))
            local up    = right:Cross(unit)
            return CFrame.fromMatrix(from, right, up)
        end

        function SNOWshipOnce(part)
            local dist = LocalPlayer:DistanceFromCharacter(part.Position)
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                if part:FindFirstChild("PartOwner") and part.PartOwner.Value == LocalPlayer.Name then
                    return true
                end
                if dist <= 30 then
                    _SetNetworkOwner:FireServer(part, lookAt(char.HumanoidRootPart.Position, part.Position))
                end
            end
        end

        -- Auto ownership heartbeat
        local _autoOwnConn = nil
        function startAutoOwnership()
            if _autoOwnConn then return end
            _autoOwnConn = _RunService.Heartbeat:Connect(function()
                for model, data in pairs(AnchoredObjects) do
                    if typeof(data.PartAnchored) == "Instance" and not model:GetAttribute("AnchorOwnership") then
                        local part = data.PartAnchored
                        if model:FindFirstChildOfClass("Humanoid") then
                            part = model:FindFirstChild("Head") or part
                        end
                        if part and SNOWshipOnce(part) then
                            model:SetAttribute("AnchorOwnership", true)
                        end
                    end
                end
            end)
        end

        function unAnchorObject(part)
            if not (typeof(part) == "Instance" and part.Parent) then return end
            local parent = part.Parent
            if not (parent:IsA("Model") or parent:IsA("Folder")) then return end
            if parent:IsA("Folder") or parent == workspace then parent = part end

            if AnchoredObjects[parent] then
                local data = AnchoredObjects[parent]
                for _, obj in ipairs(data.Parts or {}) do
                    if obj and obj.Parent then
                        obj.Anchored = false
                    end
                end
                parent:SetAttribute("IsAnchored", false)
                AnchoredObjects[parent] = nil
            end
        end

        function setanchorObject(part)
            if not (typeof(part) == "Instance" and part.Parent) then return end
            local parent = part.Parent
            if not (parent:IsA("Model") or parent:IsA("Folder")) then return end
            if parent:IsA("Folder") or parent == workspace then parent = part end

            if parent:GetAttribute("IsAnchored") then
                unAnchorObject(part)
                return
            end

            -- Ancre toutes les parts du modele
            local anchoredParts = {}
            for _, obj in ipairs(parent:GetDescendants()) do
                if obj:IsA("BasePart") and not obj.Anchored then
                    obj.Anchored = true
                    table.insert(anchoredParts, obj)
                end
            end

            AnchoredObjects[parent] = {
                Parts    = anchoredParts,
                Model    = parent,
            }

            anchorobjecteffect(part)
            parent:SetAttribute("IsAnchored", true)
        end

        -- Ancre le toy qu'on tient en main (GrabParts)
        function anchorfunc()
            local grabParts = workspace:FindFirstChild("GrabParts")
            local part = grabParts
                and grabParts:FindFirstChild("GrabPart")
                and grabParts.GrabPart:FindFirstChild("WeldConstraint")
                and grabParts.GrabPart.WeldConstraint.Part1

            if part then
                -- On tient quelque chose
                local parent = part.Parent
                if parent and (parent:IsA("Model") or parent:IsA("Folder")) then
                    if parent:IsA("Folder") or parent == workspace then parent = part end
                else
                    parent = part
                end

                if AnchoredObjects[parent] then
                    unAnchorObject(part)
                    notify("Toys", "Dsancr.", 2)
                elseif not part.Anchored then
                    setanchorObject(part)
                end
            else
                -- On ne tient rien  dsancre le dernier objet ancr
                local lastModel, _ = next(AnchoredObjects)
                if lastModel then
                    local anyPart = lastModel:IsA("BasePart") and lastModel
                        or lastModel:FindFirstChildOfClass("BasePart")
                    if anyPart then
                        unAnchorObject(anyPart)
                        notify("Toys", "Dsancr.", 2)
                    end
                end
            end
        end

        -- Keybind listener (désactivé si Tab Anchor actif)
        _TrackConn(_UIS.InputBegan:Connect(function(input, gpe)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end -- ignore clic souris (KeyCode Unknown)
            if _G.AnchorTabOverride then return end  -- Le nouveau Tab Anchor gère les keybinds
            if gpe or _UIS:GetFocusedTextBox() then return end
            if input.KeyCode == anchorToysKey then
