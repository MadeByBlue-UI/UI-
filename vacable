            local rs = Instance.new("UIStroke", ring); rs.Color = Color3.new(1, 1, 1); rs.Thickness = 1.5; rs.Transparency = 0.82
            local hub = Instance.new("Frame")   -- disque central
            hub.AnchorPoint = Vector2.new(0.5, 0.5)
