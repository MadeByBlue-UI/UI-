    -- 🧍 Noclip perso <-> toy de tête (Ride Head) : ton perso ne collisionne plus qu'avec le toy qui sert de tête
    --    (NoCollisionConstraint entre les pièces du perso et celles de la tête ; le reste du monde reste solide)
    _G._RideCharNoclip = false
    local _rideNC = { head = nil, char = nil, list = {} }
    _G._RideNCClear = function()
        for _, c in ipairs(_rideNC.list) do pcall(function() c:Destroy() end) end
        _rideNC.list, _rideNC.head, _rideNC.char = {}, nil, nil
    end
    _G._RideNCApply = function(char, headToy)
        if not char or not headToy or not headToy.Parent then return end
        local now = os.clock()
        if _rideNC.head == headToy and _rideNC.char == char and now - (_rideNC.t or 0) < 1 then return end
        _G._RideNCClear()
        _rideNC.head, _rideNC.char, _rideNC.t = headToy, char, now
        local toyModel = headToy:FindFirstAncestorOfClass("Model") or headToy
        local toyParts = (toyModel == headToy) and { headToy } or toyModel:GetDescendants()
        for _, cp in ipairs(char:GetDescendants()) do
            if cp:IsA("BasePart") then
                for _, tp in ipairs(toyParts) do
                    if tp:IsA("BasePart") then
                        local c = Instance.new("NoCollisionConstraint")
                        c.Name = "HelperRideNC"
                        c.Part0, c.Part1 = cp, tp
                        c.Parent = cp
                        table.insert(_rideNC.list, c)
                    end
                end
            end
        end
    end
