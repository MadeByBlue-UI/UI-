                                                    local p1 = trainPositionHistory[#trainPositionHistory]
                                                    local p2 = trainPositionHistory[#trainPositionHistory - 1]
                                                    local p3 = trainPositionHistory[#trainPositionHistory - 2]
                                                    
                                                    -- Calcule la courbure (direction change)
                                                    local dir1 = (p1.pos - p2.pos).Unit
                                                    local dir2 = (p2.pos - p3.pos).Unit
                                                    
                                                    -- Distance manquante
                                                    local existingDistance = p1.distanceFromHead or 0
                                                    local missingDistance = targetDistance - existingDistance
                                                    
                                                    -- Extrapole en suivant la courbure
                                                    -- Moyenne des directions pour smooth curve
                                                    local avgDirection = (dir1 + dir2).Unit
                                                    targetPos = p1.pos - (avgDirection * missingDistance) + Vector3.new(0, tornadoHeight, 0)
                                                    
                                                elseif #trainPositionHistory >= 2 then
