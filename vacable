    -- -----------------------------------------------------------------------
    function FX_ShadowClones()
        local char = Player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local COUNT  = 4
        local clones  = {}
        local history = {}  -- historique de CFrames du HRP
        for i = 1, COUNT do
            local clone = newPart(char, Vector3.new(2, 2.5, 1),
                Color3.fromRGB(0, 0, 30), Enum.Material.Neon)
            clone.Transparency = 0.3 + i * 0.13
            table.insert(clones, clone)
        end
        local conn = R2.Heartbeat:Connect(function(dt)
            local h = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not h then return end
            table.insert(history, 1, h.CFrame)
            if #history > 80 then table.remove(history) end
            for i, clone in ipairs(clones) do
                local idx = math.min(i * 18, #history)
                if idx >= 1 then
                    clone.CFrame        = history[idx]
                    clone.Transparency  = 0.25 + i * 0.15
                    local v             = (1 - i/COUNT)
                    clone.Color         = Color3.fromRGB(0, 0, math.floor(v * 120))
                end
            end
        end)
        table.insert(FX.Connections, conn)
    end

