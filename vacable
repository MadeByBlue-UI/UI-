                if not _G.ToyDestroyerTarget or not _G.ToyDestroyerTarget.Parent then
                    _G.ToyDestroyerActive = false
                    notify("Toy Destroyer", "❌ Cible déconnectée", 2)
                    break
                end
                
                -- Refresh character
                myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if not myRoot then break end
                
                -- Trouve le dossier toys
                local targetFolder = workspace:FindFirstChild(_G.ToyDestroyerTarget.Name .. "SpawnedInToys")
                
                if targetFolder and #targetFolder:GetChildren() > 0 then
                    local destroyed = 0
                    
                    for _, toy in ipairs(targetFolder:GetChildren()) do
