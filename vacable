        -- =====================================================================================================================
        -- 🎬 INTRO DE FORMATION (style Transformers) : au moment où les toys rejoignent la formation, ils apparaissent sur une trajectoire
        -- autour du corps (anneau / spirale / éclosion / pluie), bien visibles, puis rejoignent la pose choisie UN PAR UN.
        -- La formation lit DS.intro (via _G._FigIntro) : calc(i, n, temps, échelle) -> u (0 = sur la trajectoire, 1 = en pose), décalage.
        -- =====================================================================================================================
        _G._FigIntro = _G._FigIntro or {}
        DS.intro = _G._FigIntro
        DS.intro.enabled = DS.intro.enabled or false
        DS.intro.style   = DS.intro.style or "Anneau"
        DS.intro.speed   = DS.intro.speed or 1
        DS.intro.styles  = { "Anneau", "Spirale", "Éclosion", "Pluie", "Transformers" }
        function DS.intro.start() DS.intro.t0 = os.clock() end
        function DS.intro.calc(i, n, el, S)
            local I = DS.intro
            local sp = math.max(I.speed or 1, 0.2)
            local ringDur, stag, fly = 1.6 / sp, math.min(0.14, 1.8 / n) / sp, 0.75 / sp
            local u = math.clamp((el - (ringDur + (i - 1) * stag)) / fly, 0, 1)
            u = u * u * (3 - 2 * u)
            local k = math.clamp(el * sp / 0.6, 0, 1); k = 1 - (1 - k) ^ 3     -- la trajectoire s'ouvre depuis le centre
            local f, st, off = i / n, I.style, nil
            if st == "Transformers" then
                -- 🤖 chaque pièce arrive de LOIN (haut + extérieur) en spirale serrée, s'aligne sur l'anneau, puis se VERROUILLE
                -- dans la pose avec un petit rebond (easeOutBack : elle dépasse sa place d'un poil puis se cale)
                local t = math.clamp((el * sp - (i - 1) * 0.045) / 0.95, 0, 1)
                local arr = 1 - (1 - t) ^ 3
                local inv = 1 - arr
                local a = f * math.pi * 2 + el * 2.2 * sp + inv * 5
                local rad = (9 + inv * inv * 26) * S
                off = Vector3.new(math.cos(a) * rad, (inv * inv * 20 + math.sin(el * 5 + i) * 0.35) * S, math.sin(a) * rad)
                local tt = math.clamp((el - (ringDur + 0.25 / sp + (i - 1) * stag)) / (0.65 / sp), 0, 1)
                local c1 = 1.70158
                u = (tt >= 1) and 1 or (1 + (c1 + 1) * (tt - 1) ^ 3 + c1 * (tt - 1) ^ 2)
                return u, off
            end
            if st == "Spirale" then
                local a = f * math.pi * 4 + el * 3 * sp
                off = Vector3.new(math.cos(a) * 6 * S * k, (f - 0.5) * 16 * S * k, math.sin(a) * 6 * S * k)
            elseif st == "Éclosion" then
                local yy = 1 - 2 * (i - 0.5) / n
                local rr = math.sqrt(math.max(0, 1 - yy * yy))
                local th = i * 2.39996 + el * 1.2 * sp
                off = Vector3.new(math.cos(th) * rr, yy, math.sin(th) * rr) * (11 * S * k)
            elseif st == "Pluie" then
                local a = f * math.pi * 2 + el * 1.5 * sp
                off = Vector3.new(math.cos(a) * 7 * S, (22 + math.sin(el * 3 + i) * 1.2) * S * k, math.sin(a) * 7 * S)
            else   -- Anneau
                local a = f * math.pi * 2 + el * 2.2 * sp
                off = Vector3.new(math.cos(a) * 9 * S * k, math.sin(el * 2 + i) * 0.7 * S, math.sin(a) * 9 * S * k)
            end
            return u, off
        end

