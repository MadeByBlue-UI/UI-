            TS:Create(self.scale, TweenInfo.new(0), { Scale = 1 }):Play()
        end

        function Radial:Close(select)
            if not self.isOpen then return end
            self.isOpen = false
            self:_freezeView(false)
            local pg = self.Pages[self.page]
            local it = select and self.sel and pg and pg.Items[self.sel]
            self.fadeId = self.fadeId + 1
