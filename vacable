    local AGV2_HeldConn   = nil

    function AGV2_Stop()
        AGV2_Enabled = false
        if AGV2_HeldConn then AGV2_HeldConn:Disconnect(); AGV2_HeldConn = nil end
        local char = plr_AGV2.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
