                                            segments = allSegments,
                                            totalLength = totalLength
                                        }
                                        end
                                        
                                        -- ⚡ UTILISE le cache (rapide, pas de recalcul)
                                        local allSegments = textSegmentsCache and textSegmentsCache.segments or {}
