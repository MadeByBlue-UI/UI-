_TrackConn(_PS2.PlayerRemoving:Connect(function() task.wait(0.5); poseTargetDrop:Refresh(getPosePlayers()) end))

-- -- Pose membres via Motor6D -----------------------------------------
local JOINTS = {
    Head        = { part = "Head",      joint = "Neck" },
    ["Bras G"]  = { part = "Left Arm",  joint = "Left Shoulder" },
    ["Bras D"]  = { part = "Right Arm", joint = "Right Shoulder" },
    ["Jambe G"] = { part = "Left Leg",  joint = "Left Hip" },
    ["Jambe D"] = { part = "Right Leg", joint = "Right Hip" },
}

local poseValues = {}
for name, _ in pairs(JOINTS) do
    poseValues[name] = { X = 0, Y = 0, Z = 0 }
end

local poseConn  = nil
local poseActive = false

function applyPose()
    if not poseTarget or not poseTarget.Character then return end
    local char   = poseTarget.Character
    local torso  = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not torso then return end

    for limbName, info in pairs(JOINTS) do
        local joint = torso:FindFirstChild(info.joint)
        if not joint then
            -- cherche dans toute la map
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("Motor6D") and p.Name == info.joint then
                    joint = p; break
                end
            end
        end
        if joint and joint:IsA("Motor6D") then
            local v = poseValues[limbName]
            joint.C0 = joint.C0 * CFrame.Angles(
                math.rad(v.X), math.rad(v.Y), math.rad(v.Z)
            )
        end
    end
end

local selectedLimb = "Head"

PoseBlock:CreateDropdown({
    Name    = "Membre",
    Flag    = "PoseLimb",
    Items   = { "Head", "Bras G", "Bras D", "Jambe G", "Jambe D" },
    Default = "Head",
    Callback = function(v) selectedLimb = v end,
})

function makePoseSlider(axis, label)
    PoseBlock:CreateSlider({
        Name    = label,
        Flag    = "Pose_" .. axis,
        Min     = -180,
        Max     = 180,
        Default = 0,
        Callback = function(v)
            if poseValues[selectedLimb] then
                poseValues[selectedLimb][axis] = v
                if poseActive then applyPose() end
            end
        end,
    })
end

makePoseSlider("X", "Rotation X (Haut/Bas)")
makePoseSlider("Y", "Rotation Y (Gauche/Droite)")
makePoseSlider("Z", "Rotation Z (Penche)")

PoseBlock:CreateToggle({
    Name    = "Activer Pose",
    Flag    = "PoseActive",
    Default = false,
    Callback = function(v)
        poseActive = v
        if v then
            if not poseTarget or not poseTarget.Character then
                notify("Pose", "Selectionne une cible.", 3); return
            end
            -- Applique en boucle via Heartbeat
            poseConn = game:GetService("RunService").Heartbeat:Connect(function()
                if not poseActive then poseConn:Disconnect(); return end
                applyPose()
            end)
        else
            if poseConn then poseConn:Disconnect(); poseConn = nil end
        end
    end,
})

PoseBlock:CreateButton({
    Name = "Reset Pose",
    Callback = function()
        for name, _ in pairs(poseValues) do
            poseValues[name] = { X = 0, Y = 0, Z = 0 }
        end
        notify("Pose", "Pose reinitialise.", 2)
    end,
})

-- -- Asseoir sur BombMissile ------------------------------------------
PoseBlock:CreateButton({
    Name = "Asseoir sur BombMissile",
    Callback = function()
        if not poseTarget or not poseTarget.Character then
            notify("Seat", "Selectionne une cible.", 3); return
        end
        local inv = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not inv then notify("Seat", "Aucun toy spawn.", 3); return end

        local missile = inv:FindFirstChild("BombMissile")
        if not missile then notify("Seat", "Aucun BombMissile.", 3); return end

        local hum = poseTarget.Character:FindFirstChildOfClass("Humanoid")
        if not hum then notify("Seat", "Cible introuvable.", 3); return end

        task.spawn(function()
            -- Cree un VehicleSeat temporaire sur le missile
            local root = missile:FindFirstChildWhichIsA("BasePart")
                or missile:FindFirstChild("PartHitDetector")
            if not root then notify("Seat", "Part missile introuvable.", 3); return end

            local seat = Instance.new("VehicleSeat")
