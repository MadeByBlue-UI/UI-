    for _, code in pairs(_trLangs) do table.insert(_trLangCodes, code) end

    -- ── Helper : envoie dans le chat ──
    function _trSend(text)
        task.spawn(function()
            local chan = _TCS.TextChannels:FindFirstChild("RBXGeneral")
                or _TCS.TextChannels:FindFirstChild("General")
            if chan then pcall(function() chan:SendAsync(text) end) end
        end)
    end

    -- ── UI ──
    FunTranslator:CreateToggle({
        Name    = "Traduire Mes Messages",
        Flag    = "TrOutToggle",
        Default = false,
        Callback = function(v) _trOutActive = v end,
    })

    FunTranslator:CreateToggle({
        Name    = "Mode Jumble",
        Flag    = "TrJumbleToggle",
        Default = false,
        Callback = function(v) _trJumble = v end,
    })

    FunTranslator:CreateDropdown({
        Name    = "Langue Cible (sortant)",
        Flag    = "TrTargetLang",
        Items   = _trLangNames,
        Default = "Anglais",
        Callback = function(v)
            _trTargetLang = _trLangs[v] or "en"
        end,
    })

    FunTranslator:CreateToggle({
        Name    = "Traduire Messages Reçus",
        Flag    = "TrInToggle",
        Default = false,
        Callback = function(v)
            _trInActive = v
            if v and not _trInConn then
                _trInConn = _TCS.MessageReceived:Connect(function(msg)
                    if not _trInActive then return end
                    if not msg.TextSource then return end
                    if msg.TextSource.UserId == game:GetService("Players").LocalPlayer.UserId then return end
                    local originalText = msg.Text
                    if originalText == "" then return end
                    task.spawn(function()
                        local translated = translate(originalText, _trYourLang, "auto")
                        if translated and translated ~= "" and translated ~= originalText then
                            local player = game:GetService("Players"):GetPlayerByUserId(msg.TextSource.UserId)
                            local name = player and player.Name or "?"
                            -- Affiche dans le chat via DisplaySystemMessage
                            local chans = _TCS:FindFirstChild("TextChannels")
                            local chan = chans and (chans:FindFirstChild("RBXGeneral") or chans:FindFirstChild("General") or chans:FindFirstChild("RBXSystem") or chans:GetChildren()[1])
                            if chan and chan.DisplaySystemMessage then
                                pcall(function() chan:DisplaySystemMessage("[" .. name .. "]: " .. translated) end)
                            end
                        end
                    end)
                end)
            elseif not v and _trInConn then
                _trInConn:Disconnect(); _trInConn = nil
            end
        end,
    })

    FunTranslator:CreateDropdown({
        Name    = "Ta Langue (entrant)",
        Flag    = "TrYourLang",
        Items   = _trLangNames,
        Default = "Français",
        Callback = function(v)
            _trYourLang = _trLangs[v] or "fr"
        end,
    })

    -- ── Hook sur le chat pour intercepter les messages sortants ──
    task.spawn(function()
        local CoreGui = game:GetService("CoreGui")
        local hookedBoxes = {}

        function hookBox(obj)
            if not obj:IsA("TextBox") then return end
            local chatRoot = CoreGui:FindFirstChild("ExperienceChat")
            if not chatRoot or not obj:IsDescendantOf(chatRoot) then return end
            if hookedBoxes[obj] then return end
            hookedBoxes[obj] = true
            _TrackConn(obj.FocusLost:Connect(function(enterPressed)
                if not enterPressed then return end
                if not _trOutActive and not _trJumble then return end
                local text = obj.Text
                if not text or text == "" or text:sub(1,1) == "/" then return end
                obj.Text = ""
                task.spawn(function()
                    local result
                    if _trJumble then
                        local words = {}
                        for w in text:gmatch("%S+") do table.insert(words, w) end
                        local translated = {}
                        for _, w in ipairs(words) do
                            local randCode = _trLangCodes[math.random(#_trLangCodes)]
                            table.insert(translated, translate(w, randCode, "auto") or w)
                        end
                        result = table.concat(translated, " ")
                    else
                        result = translate(text, _trTargetLang, "auto") or text
                    end
                    _trSend(result)
                end)
            end))
        end

        repeat task.wait(0.5) until CoreGui:FindFirstChild("ExperienceChat")
        local chatRoot = CoreGui:FindFirstChild("ExperienceChat")
        for _, obj in ipairs(chatRoot:GetDescendants()) do hookBox(obj) end
        _TrackConn(chatRoot.DescendantAdded:Connect(function(obj) task.defer(function() hookBox(obj) end) end))
    end)
end

