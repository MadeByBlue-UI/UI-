                                                        -- > Deuxième rangée (3 toys)
                                                        local row2Index = textIndex - 3  -- 1, 2, 3
                                                        arrowX = (row2Index - 2) * letterWidth * 0.5
                                                        arrowY = standardHeight
                                                        arrowZ = forwardDistance + letterWidth * 0.4
                                                    else
                                                        -- > Corps EN LIGNE VERTICALE (vers le texte)
                                                        local corpIndex = textIndex - 6
                                                        arrowX = 0  -- Centré
                                                        arrowY = standardHeight
                                                        arrowZ = forwardDistance - letterWidth * 0.6 - (corpIndex - 1) * letterWidth * 0.3  -- Espacés en Z
                                                    end
                                                else
                                                    -- 🔺 TRIANGLE SIMPLE (3-5 toys) - Alignement parfait
                                                    if textIndex == 1 then
                                                        -- > Pointe
                                                        arrowX = 0
                                                        arrowY = standardHeight
                                                        arrowZ = forwardDistance + letterWidth * 0.8
                                                    elseif textIndex == 2 then
