    -- =========================================================================
    -- =====================================================================================================================
    -- 🕷️ ARAIGNÉE FLIPPANTE : 1 DiceBig (abdomen) + 39 DiceSmall
    --   · 24 dés = 8 pattes articulées (hanche -> genou en hauteur -> pied au sol), 3 dés par patte
    --   · 5 dés = thorax · 4 dés = yeux · 4 dés = mandibules (2 par croc) · 2 dés = pédipalpes
    --   · tout est lissé par des paramètres (cabrage, bond, rage, crocs...) : AUCUNE coupure entre deux animations
    --   · apparition : tous les dés sortent de la tête et se déploient patte après patte (avec léger rebond)
    --   · menace (se cabre, pattes avant en l'air, crocs qui claquent), JUMP SCARE (recul -> bond -> hurlement -> retraite)
    --   · idle vivant : respiration, battement de l'abdomen, spasmes nerveux des pattes, crocs et yeux qui bougent
    --   · course saccadée façon insecte (phases décalées par patte) + tremblement quand la rage monte
    -- Tout est dans la table _G._Spooky (aucune variable locale en plus pour le reste du script).
    -- =====================================================================================================================
    _G._Spooky = _G._Spooky or {}
    do
        local SK = _G._Spooky
        SK.cfg = SK.cfg or {
            stance = 1, bodyH = 0, twitch = 1, shake = 1, skitter = 1,
            breathe = true, fangs = true, eyes = true,
            autoThreat = true, autoScare = false, scareEvery = 20,
            unfurl = true, unfurlDur = 1.8,
        }
        SK.s = SK.s or {}
        for _, k in ipairs({ "rise", "crouch", "fang", "rage", "lunge", "abd", "amp", "air", "fo" }) do SK.s[k] = SK.s[k] or 0 end
        SK.s.stance = SK.s.stance or 1
        SK.kind, SK.idx, SK.seqCache = SK.kind or {}, SK.idx or {}, SK.seqCache or {}
        SK.lastTick, SK.t0 = -99, 0
        SK.nextThreat, SK.nextScare = os.clock() + 6, os.clock() + 15

        local function clamp(x, a, b) if x < a then return a elseif x > b then return b end return x end
        local function noise(a, b, c) return math.noise(a, b + 0.31, c + 0.17) end
        local function easeOutBack(u)       -- 0 -> 1 avec un petit dépassement (effet ressort)
            local t = u - 1
            return 1 + 2.2 * t * t * t + 1.2 * t * t
        end

        -- ===== déclencheurs =====
        function SK.scare(kind) SK.sc = { t0 = os.clock(), kind = kind or "full" } end
        function SK.replay() SK.t0 = os.clock() end

        -- ===== TRI + RÔLES : le(s) DiceBig d'abord (abdomen), puis les DiceSmall répartis par rôle =====
        function SK.sort(list)
            local bigs, smalls = {}, {}
            for _, p in ipairs(list) do
                local m = p:FindFirstAncestorOfClass("Model")
                local nm = m and m.Name or p.Name
                if nm == "DiceBig" then bigs[#bigs + 1] = p else smalls[#smalls + 1] = p end
            end
            for j = #list, 1, -1 do list[j] = nil end
            for _, p in ipairs(bigs) do list[#list + 1] = p end
            for _, p in ipairs(smalls) do list[#list + 1] = p end

            local nB = #bigs
            local seq = SK.seqCache[nB]
            if not seq then
                seq = {}
                for b = 1, nB do seq[#seq + 1] = { "abd", b } end
                if nB == 0 then for b = 1, 3 do seq[#seq + 1] = { "abd", b } end end   -- pas de DiceBig : mini-abdomen de 3 dés
                for j = 1, 5 do seq[#seq + 1] = { "th", j } end
                for j = 1, 24 do seq[#seq + 1] = { "leg", j } end
                for j = 1, 4 do seq[#seq + 1] = { "fang", j } end
                for j = 1, 2 do seq[#seq + 1] = { "palp", j } end
                for j = 1, 4 do seq[#seq + 1] = { "eye", j } end
                SK.seqCache[nB] = seq
            end
            SK.abdSmall = (nB == 0)
            for i = 1, #list do
                local r = seq[i]
                if r then SK.kind[i], SK.idx[i] = r[1], r[2]
                else SK.kind[i], SK.idx[i] = "extra", i - #seq end
            end
        end

        -- ===== SCÉNARIO DU JUMP SCARE : écrit les cibles (tg) et la vitesse de lissage (rate) =====
        local KEYS = { "rise", "crouch", "fang", "rage", "lunge", "abd" }
        local function setP(tg, rate, tv, rv)
            for j = 1, 6 do tg[KEYS[j]] = tv[j]; rate[KEYS[j]] = rv[j] end
        end
        local function scenario(now, tg, rate)
            local sc = SK.sc
            if not sc then return false end
            local t, full = now - sc.t0, (sc.kind == "full")
            if t < 0.55 then                                   -- 1) il se cabre / recule
                setP(tg, rate, { 1, 0.7, 0.5, 0.5, full and -0.5 or 0, 1 }, { 7, 7, 6, 5, 8, 6 })
            elseif full and t < 0.82 then                      -- 2) BOND (très rapide)
                setP(tg, rate, { 0.75, 0, 1, 1, 1, 0.6 }, { 26, 20, 20, 12, 30, 12 })
            elseif t < (full and 2.4 or 1.9) then              -- 3) hurlement : crocs qui claquent, tremblement
                setP(tg, rate, { 1, 0.2, 1, 1, full and 0.85 or 0, 1 }, { 8, 6, 10, 6, 5, 6 })
            elseif t < (full and 3.6 or 2.9) then              -- 4) retraite en douceur
                setP(tg, rate, { 0, 0, 0, 0, 0, 0 }, { 3.5, 3.5, 3.5, 3, 3.5, 3.5 })
            else
                return false
            end
            return true
        end

        -- ===== ÉTAT LISSÉ (appelé 1 fois par frame) =====
        function SK.tick(dt, anim, now)
            local s, cfg = SK.s, SK.cfg
            dt = math.min(dt or 0.016, 0.1)
            if now - SK.lastTick > 0.6 then                     -- formation (ré)activée : remise à zéro + apparition
                for k in pairs(s) do s[k] = 0 end
                s.stance = 1
                SK.sc, SK.t0 = nil, now
                SK.nextThreat, SK.nextScare = now + 5, now + cfg.scareEvery
            end
            SK.lastTick = now

            local a = tostring(anim or "Idle")
            local run  = a:find("Run") ~= nil
            local walk = run or a:find("Walk") ~= nil or a == "Escalade" or a == "Ramper"
            local air  = (a == "Jump" or a == "Saut" or a == "Chute" or a == "Vol")
            local tg   = { rise = 0, crouch = 0, fang = 0, rage = 0, lunge = 0, abd = 0, amp = 0, air = 0, stance = cfg.stance }
            local rate = { rise = 5, crouch = 5, fang = 7, rage = 4, lunge = 6, abd = 5, amp = 6, air = 7, stance = 4 }
            tg.amp = run and 1.7 or (walk and 1 or 0)
            if run then tg.crouch = 0.25 end                    -- course ras du sol
            if a == "Dance" then tg.amp, tg.rise, tg.fang = 0.7, 0.5 + 0.5 * math.sin(now * 2.2), 0.4 end
            if air then tg.air, tg.rise = 1, 0.25 end

            if not SK.sc then
                if cfg.autoThreat and a == "Idle" and now > SK.nextThreat then
                    SK.scare("mild"); SK.nextThreat = now + 7 + math.random() * 8
                end
                if cfg.autoScare and now > SK.nextScare then
                    SK.scare("full"); SK.nextScare = now + cfg.scareEvery
                end
            end
            if SK.sc and not scenario(now, tg, rate) then SK.sc = nil end

            for k, v in pairs(tg) do s[k] = s[k] + (v - s[k]) * (1 - math.exp(-(rate[k] or 5) * dt)) end

            -- ouverture des crocs : claquement rapide quand la rage monte + petit spasme aléatoire au repos
            local snap = 0.65 + 0.35 * math.sin(now * (7 + s.rage * 16))
            local idleTw = clamp(noise(now * 0.9, 7.7, 0) * 3 - 0.8, 0, 0.5)
            s.fo = cfg.fangs and clamp(s.fang * snap + idleTw, 0, 1) or 0
        end

        -- point sur une patte à la fraction t (0..1) de sa longueur (hanche -> genou -> pied) + sa direction locale
        local function onLeg(h, k, f, t)
            local L1, L2 = (k - h).Magnitude, (f - k).Magnitude
            local d = t * (L1 + L2)
            if d <= L1 then return h + (k - h) * (d / math.max(L1, 1e-3)), (k - h) end
            return k + (f - k) * ((d - L1) / math.max(L2, 1e-3)), (f - k)
        end

        local ZH = { 1.5, 0.5, -0.6, -1.7 }       -- hanche le long du corps (avant -> arrière)
        local ZK = { 2.7, 1.5, -1.1, -3.0 }       -- genou
        local ZF = { 4.6, 2.4, -2.4, -4.8 }       -- pied
        local XF = { 5.4, 6.6, 6.6, 5.6 }         -- écartement latéral du pied
        local TH = { { 0, 0.2, 0.9 }, { -0.8, 0, 0.1 }, { 0.8, 0, 0.1 }, { 0, 0.8, -0.3 }, { 0, -0.2, -1.0 } }
        local EX = { -0.4, 0.4, -1.0, 1.0 }
        local EY = { 0.35, 0.35, 0.8, 0.8 }

        -- ===== POSE d'un dé : retourne (position, rotation monde) =====
        function SK.pose(i, n, headPos, fwdIn, scale, spread, comp, hgt, ph0, T)
            local s, cfg = SK.s, SK.cfg
            local kind, idx = SK.kind[i] or "extra", SK.idx[i] or 1
            local cs = scale * comp
            local fwd = Vector3.new(fwdIn.X, 0, fwdIn.Z)
            fwd = (fwd.Magnitude < 0.05) and Vector3.new(0, 0, -1) or fwd.Unit
            local right, up = fwd:Cross(Vector3.yAxis), Vector3.yAxis

            local breathe = cfg.breathe and math.sin(T * 1.7) * 0.14 * cs or 0
            local bodyY = -1.7 * cs + hgt + cfg.bodyH * scale - s.crouch * 2.0 * cs + breathe + s.air * 1.2 * cs
            local c0 = headPos + up * bodyY
            local lungeV = fwd * (s.lunge * 5.5 * cs)
            local sh = cfg.shake * (0.03 + s.rage * 0.16) * cs
            local jit = Vector3.new(noise(T * 33, i, 0), noise(T * 33, i, 4.3), noise(T * 33, i, 8.9)) * (2 * sh)
            local pos, rot = c0, CFrame.lookAt(Vector3.zero, fwd)
            local lw = 1                                         -- poids du bond pour ce dé

            if kind == "abd" then
                -- 🔴 ABDOMEN (DiceBig) : derrière, se soulève quand il se cabre, ondule en marchant, battement de coeur
                local back = -4.3 * cs - s.rise * 0.9 * cs
                pos = c0 + fwd * back + up * ((0.35 + s.rise * 1.1 + s.abd * 0.4) * cs)
                    + right * (math.sin(ph0) * 0.35 * cs * math.min(s.amp, 1.7))
                if idx > 1 then pos = pos + fwd * (-(idx - 1) * 2.4 * cs) + up * ((idx - 1) * 0.3 * cs) end
                if SK.abdSmall then pos = pos + right * ((idx - 2) * 1.0 * cs) end
                if cfg.breathe then pos = pos + up * (math.max(0, math.sin(T * 3.1)) ^ 8 * 0.25 * cs) end
                rot = rot * CFrame.Angles(math.rad(-s.rise * 35 + math.sin(T * 1.3) * 3), 0, 0)

            elseif kind == "th" then
                -- thorax : 5 dés serrés, basculent en arrière quand il se cabre
                local o = TH[idx] or TH[1]
                pos = c0 + right * (o[1] * cs) + up * (o[2] * cs + s.rise * 0.7 * cs) + fwd * (o[3] * cs - s.rise * 0.9 * cs)
                lw = 0.6

            elseif kind == "leg" then
                local k0 = idx - 1
                local ln = math.floor(k0 / 3)                    -- patte 0..7
                local sg = (k0 % 3) + 1                          -- dé 1..3 sur la patte (3 = le pied)
                local p  = math.floor(ln / 2)                    -- paire 0 (avant) .. 3 (arrière)
                local sd = (ln % 2 == 0) and -1 or 1
                local st = s.stance * spread
                local amp = s.amp

                -- démarche en tétrapodes + irrégularité d'insecte (phase décalée par patte)
                local jitterPh = cfg.skitter * 0.7 * noise(T * 4.5, ln * 3.7, 1.3) * math.min(1, amp)
                local ph = ph0 + (((p + ((sd > 0) and 1 or 0)) % 2) * math.pi) + jitterPh
                local swing = math.sin(ph) * 1.5 * cs * amp
                local lift  = math.max(0, math.cos(ph)) * 2.0 * scale * math.min(amp, 1.5)

                -- spasmes nerveux au repos (pics aléatoires par patte)
                local tw = clamp(noise(T * 1.1, ln * 5.1, 2.2) * 3 - 0.7, 0, 1) * cfg.twitch * (1 - math.min(amp, 1))
                lift = lift + tw * 1.8 * scale + s.air * 2.4 * scale

                -- pattes avant levées en menace (paire 1 un peu aussi), avec tremblement
                local rz = s.rise * ((p == 0) and 1 or ((p == 1) and 0.3 or 0))
                local quiver = math.sin(T * 22 + ln * 1.7) * 0.25 * cs * (rz + s.rage * 0.5)

                local hip  = c0 + right * (sd * 0.7 * cs) + fwd * (ZH[p + 1] * cs - s.rise * 0.9 * cs)
                local knee = c0 + right * (sd * (3.4 + p * 0.2) * cs * st * (1 + rz * 0.25))
                    + fwd * (ZK[p + 1] * cs + swing * 0.5 + rz * 1.8 * cs)
                    + up * ((2.2 + rz * 4.5 + s.air) * cs + lift * 0.8)
                local foot = headPos + right * (sd * XF[p + 1] * cs * st * (1 - rz * 0.35 + s.air * 0.2))
                    + fwd * (ZF[p + 1] * cs + swing + rz * 3.0 * cs)
                    + up * (-7.4 * scale + hgt + lift + rz * 10.2 * scale + quiver)

                local pt, dir = onLeg(hip, knee, foot, ({ 0.30, 0.64, 1.0 })[sg])
                pos = pt
                if dir.Magnitude > 0.05 then rot = CFrame.lookAt(Vector3.zero, dir.Unit) * CFrame.Angles(math.rad(-90), 0, 0) end

            elseif kind == "fang" then
                -- mandibules : 2 dés par croc (base + pointe) ; fermées = pointes croisées, ouvertes = écartées en avant
                local sd  = (((idx - 1) % 2) == 0) and -1 or 1
                local seg = math.floor((idx - 1) / 2) + 1
                local fo = s.fo
                local base = headPos + fwd * (1.0 * cs) + right * (sd * 0.5 * cs) + up * (-0.7 * cs)
                local tip  = base + right * (sd * (-0.2 + fo * 1.1) * cs) + fwd * ((0.4 + fo * 0.6) * cs) + up * (-1.2 * cs - fo * 0.1)
                pos = (seg == 1) and base or tip
                lw = 1.0 + 0.3 * s.lunge                          -- les crocs partent un peu plus loin que le reste (morsure)

            elseif kind == "palp" then
                local sd = (idx == 1) and -1 or 1
                pos = headPos + fwd * ((1.7 + math.max(0, math.sin(T * 5 + idx * 2)) * 0.4 * (1 - s.rise)) * cs)
                    + right * (sd * 1.5 * cs) + up * ((-0.5 + s.rise * 1.6 + math.sin(T * 2.6 + idx) * 0.25) * cs)
                lw = 0.6

            elseif kind == "eye" then
                -- yeux : clignent, pulsent, s'écartent et ressortent quand il enrage
                local e = cfg.eyes and 1 or 0
                local blink = clamp(math.sin(T * 1.9 + idx * 2.1) * 14 - 12.5, 0, 1) * e
                local zE = 1.25 + math.sin(T * (3 + s.rage * 18) + idx * 1.3) * 0.2 * e * (0.3 + s.rage)
                pos = headPos + fwd * (zE * cs) + right * (EX[idx] * cs * (1 + s.rage * 0.45) + noise(T * 2, idx, 5) * 0.2 * cs * e)
                    + up * ((EY[idx] + s.rage * 0.25 - blink * 0.5) * cs)
                lw = 0.4

            else
                -- dés en trop : anneau de soie qui tourne derrière l'abdomen
                local a = T * 2.2 + idx * 1.57
                pos = c0 + fwd * (-6.8 * cs) + up * (0.3 * cs) + right * (math.cos(a) * 1.2 * cs) + up * (math.sin(a) * 1.2 * cs)
            end

            pos = pos + lungeV * lw + jit

            -- 🎬 APPARITION : les dés sortent de la tête l'un après l'autre (retardés par l'indice) avec un léger rebond
            if cfg.unfurl then
                local span = math.max(cfg.unfurlDur, 0.4)
                local u = clamp((T - SK.t0 - ((i - 1) / math.max(n, 1)) * span * 0.5) / (span * 0.5), 0, 1)
                if u < 1 then
                    local _oa = i * 2.399963
                    local _or = (1.5 + 0.35 * math.sqrt(i)) * cs
                    local _o0 = headPos + Vector3.new(math.cos(_oa) * _or, ((i % 5) - 2) * 0.9 * cs, math.sin(_oa) * _or)   -- départ étalé (jamais tous au même point : anti-suppression)
                    pos = _o0:Lerp(pos, easeOutBack(u))
                    rot = rot * CFrame.Angles((1 - u) * math.rad(540), (1 - u) * math.rad(270), 0)
                end
            end
            return pos, rot
        end
    end

    -- =========================================================================
    -- 🕷️ BLOC « ARAIGNÉE FLIPPANTE » : tous les réglages dans un nouveau bloc
    -- (choisis la formation « Araignée Flippante » dans le menu « Formation Figure » puis active 🚶 Animated Figure)
    -- =========================================================================
    do
        local SK = _G._Spooky
        local SB = Tabs.Fun:CreateBlock({ Name = "🕷️ Araignée Flippante (39 DiceSmall + 1 DiceBig)", Side = "Right" })

        local function toggle(name, flag, def, key)
            SB:CreateToggle({ Name = name, Flag = flag, Default = def, Callback = function(v) SK.cfg[key] = v end })
        end
        local function slider(name, flag, min, max, def, key)
            SB:CreateSlider({ Name = name, Flag = flag, Min = min, Max = max, Default = def, Callback = function(v) SK.cfg[key] = v end })
        end

        SB:CreateSection("🎲 Dés")
        SB:CreateButton({
            Name = "🎲 Spawn 39 DiceSmall (le DiceBig se spawn à la main, 1 seul)",
            Callback = function()
                local DS = _G._FigDice
                if DS and DS.start then
                    DS.want = 39
                    DS.start()
                    notify("Araignée Flippante", "🎲 39 DiceSmall en cours · pense aussi à spawn 1 DiceBig (abdomen)", 5)
                else
                    notify("Araignée Flippante", "❌ DiceSmall Spawner introuvable", 3)
                end
            end
        })

        SB:CreateSection("👹 Frayeur")
        SB:CreateButton({ Name = "👹 JUMP SCARE (recul → bond → hurlement)", Callback = function() SK.scare("full") end })
        SB:CreateButton({ Name = "😠 Menace (se cabre, crocs qui claquent)", Callback = function() SK.scare("mild") end })
        SB:CreateButton({ Name = "🎬 Rejouer l'apparition (les dés sortent de la tête)", Callback = function() SK.replay() end })
        toggle("😠 Menace automatique à l'arrêt (toutes les 7-15 s)", "SpiderAutoThreat", true, "autoThreat")
        SB:CreateToggle({
            Name = "👹 Jump scare automatique",
            Flag = "SpiderAutoScare",
            Default = false,
            Callback = function(v)
                SK.cfg.autoScare = v
                if v then SK.nextScare = os.clock() + SK.cfg.scareEvery end
            end
        })
        slider("⏱️ Délai entre deux jump scares (s)", "SpiderScareEvery", 5, 60, 20, "scareEvery")

        SB:CreateSection("🎬 Apparition")
        toggle("🎬 Apparition animée (déploiement patte après patte)", "SpiderUnfurl", true, "unfurl")
        slider("⏱️ Durée de l'apparition (s)", "SpiderUnfurlDur", 0.5, 4, 1.8, "unfurlDur")

        SB:CreateSection("🫀 Vie / mouvement")
        toggle("🫁 Respiration + battement de l'abdomen", "SpiderBreathe", true, "breathe")
        toggle("🦷 Mandibules vivantes (spasmes + claquements)", "SpiderFangs", true, "fangs")
        toggle("👁️ Yeux vivants (clignent, pulsent, s'écarquillent)", "SpiderEyes", true, "eyes")
        slider("⚡ Spasmes des pattes (repos)", "SpiderTwitch", 0, 3, 1, "twitch")
        slider("🪳 Course saccadée (irrégularité des pattes)", "SpiderSkitter", 0, 3, 1, "skitter")
        slider("📳 Tremblement (monte avec la rage)", "SpiderShake", 0, 3, 1, "shake")

        SB:CreateSection("📐 Forme")
        slider("↔️ Envergure des pattes", "SpiderStance", 0.7, 1.8, 1, "stance")
        slider("↕️ Hauteur du corps", "SpiderBodyH", -2, 3, 0, "bodyH")
    end

    -- =====================================================================================================================
    -- 🦅 OISEAU RÉALISTE : 1 DiceBig (corps) + 39 DiceSmall  (mêmes dés que l'araignée, rien à re-spawn)
    --   · 24 dés = 2 ailes (3 rangées x 4 : bord d'attaque, milieu, plumes de fuite) · 5 = queue en éventail
    --   · 2 = cou · 2 = bec (haut / bas) · 4 = pattes (2 par patte) · 2 = poitrail + croupion
    --   · l'état est DÉDUIT de ton vrai mouvement (vitesse, montée, descente, virage) : rien à régler pour voler
    --   · battement asymétrique (descente plus puissante), onde qui se propage vers le bout de l'aile (le bout retarde),
    --     ailes qui se replient à la remontée, balayage des ailes vers l'arrière en vol rapide
    --   · alternance battements / vol plané (comme un vrai oiseau en croisière), vol stationnaire (corps redressé, ailes à plat),
    --     piqué (ailes plaquées, corps profilé), virages inclinés (la tête reste à l'horizontale, la queue fait gouvernail)
    --   · décollage (coup d'ailes puissant) et atterrissage (flare : ailes relevées, queue en frein, pattes en avant)
    --   · au sol : respiration, marche / course, picorage, pépiement, ébrouement, queue qui remue
    -- Tout est dans la table _G._Bird (aucune variable locale en plus pour le reste du script).
    -- =====================================================================================================================
    _G._Bird = _G._Bird or {}
    do
        local BD = _G._Bird
        BD.cfg = BD.cfg or {
            species = "Aigle", span = 1, flapSpeed = 1, bank = 1,
            autoGlide = true, forceGlide = false, idleActs = true, spread = false,
            startSpread = 1.8, startHold = 4, foldSpread = 1.6,
            unfurl = true, unfurlDur = 1.6,
        }
        BD.SP = {
            ["Aigle"]   = { span = 1.25, hz = 2.3, amp = 0.62, glide = 2.0, fan = 0.55 },
            ["Corbeau"] = { span = 1.0,  hz = 3.3, amp = 0.78, glide = 1.0, fan = 0.40 },
            ["Mouette"] = { span = 1.15, hz = 2.7, amp = 0.55, glide = 1.6, fan = 0.45 },
            ["Colibri"] = { span = 0.7,  hz = 6.0, amp = 0.95, glide = 0.0, fan = 0.30 },
        }
        local N = 12                                   -- échantillons par aile
        BD.st = BD.st or {
            lastTick = -99, t0 = 0, hv = Vector3.new(0, 0, -1), vel = Vector3.zero,
            pitch = 0, bank = 0, omega = 0, phi = 0, hzS = 3,
            g = 0, fly = 0, wing = 0, flare = 0, dive = 0, hov = 0, burst = 0, flareKick = 0,
            tailUp = 0, fan = 0.12, tailYaw = 0, peck = 0, beak = 0, puff = 0, shake = 0, wag = 0,
            gateOn = true, gateT = 0, nextAct = 0, wasAir = false, anim = "Idle",
            walk = false, run = false, dance = false, curves = {}, bob = 0,
            B = CFrame.new(), H = CFrame.new(), Yaw = CFrame.new(), Rc = CFrame.new(), c0 = Vector3.zero,
        }
        BD.kind, BD.idx, BD.seqCache = BD.kind or {}, BD.idx or {}, BD.seqCache or {}

        local function clamp(x, a, b) if x < a then return a elseif x > b then return b end return x end
        local function noise(a, b, c) return math.noise(a, b + 0.31, c + 0.17) end
        local function approach(cur, target, rate, dt) return cur + (target - cur) * (1 - math.exp(-rate * dt)) end
        local function smooth(x) x = clamp(x, 0, 1) return x * x * (3 - 2 * x) end
        local function easeOutBack(u) local t = u - 1 return 1 + 2.2 * t * t * t + 1.2 * t * t end

        local ACT_DUR = { peck = 1.3, chirp = 1.5, ruffle = 1.1, wag = 1.4, flap = 2.4, cry = 1.6 }
        function BD.act(name) BD.st.act = { name = name, t0 = os.clock(), dur = ACT_DUR[name] or 1.5 } end
        function BD.replay() BD.st.t0 = os.clock() end

        -- ===== TRI + RÔLES : le DiceBig d'abord (corps), puis les DiceSmall par priorité =====
        function BD.sort(list)
            local bigs, smalls = {}, {}
            for _, p in ipairs(list) do
                local m = p:FindFirstAncestorOfClass("Model")
                local nm = m and m.Name or p.Name
                if nm == "DiceBig" then bigs[#bigs + 1] = p else smalls[#smalls + 1] = p end
            end
            for j = #list, 1, -1 do list[j] = nil end
            if bigs[1] then list[1] = bigs[1] end
            for _, p in ipairs(smalls) do list[#list + 1] = p end
            for b = 2, #bigs do list[#list + 1] = bigs[b] end      -- DiceBig en trop : à la fin (plumes flottantes)

            local nB = math.min(#bigs, 1)
            local seq = BD.seqCache[nB]
            if not seq then
                seq = { { "body", 1 } }
                local function wingRow(row) for col = 0, 3 do for side = 0, 1 do seq[#seq + 1] = { "wing", side * 100 + row * 10 + col } end end end
                wingRow(0)
                for j = 1, 2 do seq[#seq + 1] = { "neck", j } end
                for j = 1, 2 do seq[#seq + 1] = { "beak", j } end
                for j = 1, 5 do seq[#seq + 1] = { "tail", j } end
                wingRow(1)
                for j = 1, 4 do seq[#seq + 1] = { "leg", j } end
                wingRow(2)
                for j = 1, 2 do seq[#seq + 1] = { "torso", j } end
                BD.seqCache[nB] = seq
            end
            for i = 1, #list do
                local r = seq[i]
                if r then BD.kind[i], BD.idx[i] = r[1], r[2]
                else BD.kind[i], BD.idx[i] = "extra", i - #seq end
            end
        end

        -- ===== ÉTAT (1 fois par frame) : déduit l'état de vol du mouvement réel de la tête =====
        function BD.tick(dt, anim, now, headPos, flyFlag, scale, comp, hgt, wp)
            local st, cfg = BD.st, BD.cfg
            local sp = BD.SP[cfg.species] or BD.SP["Aigle"]
            dt = clamp(dt or 0.016, 0.001, 0.1)
            local cs = scale * comp
            local cam = workspace.CurrentCamera
            local cl = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
            local ch = Vector3.new(cl.X, 0, cl.Z)
            ch = (ch.Magnitude > 0.05) and ch.Unit or Vector3.new(0, 0, -1)

            if now - st.lastTick > 0.6 then                       -- formation (ré)activée : remise à zéro + apparition
                st.t0, st.prev, st.vel, st.hv = now, nil, Vector3.zero, ch
                st.pitch, st.bank, st.omega, st.burst, st.flareKick, st.act = 0, 0, 0, 0, 0, nil
                st.g, st.fly, st.wing, st.flare, st.dive, st.hov = 0, 0, 0, 0, 0, 0
                st.fan, st.tailUp, st.wasAir, st.nextAct = 0.25, 0, false, now + 4
                st.wing = 1
            end
            st.lastTick = now

            -- 📏 DÉBUT : ailes très écartées (et tenues un moment) pour que les dés ne soient jamais entassés au même endroit
            local sS, sH, fS = cfg.startSpread or 1.8, cfg.startHold or 4, cfg.foldSpread or 1.6
            local startK = (sS > 1) and clamp(1 - (now - st.t0 - sH) / 1.5, 0, 1) or 0
            st.startK = startK

            -- vitesse lissée (les téléportations du Ground Snap sont ignorées)
            if st.prev then
                local v = (headPos - st.prev) / dt
                if v.Magnitude > 150 then v = st.vel end
                st.vel = st.vel + (v - st.vel) * (1 - math.exp(-8 * dt))
            end
            st.prev = headPos
            local vel = st.vel
            local hs, vy = Vector3.new(vel.X, 0, vel.Z).Magnitude, vel.Y

            local a = tostring(anim or "Idle")
            st.anim = a
            st.run   = a:find("Run") ~= nil
            st.walk  = st.run or a:find("Walk") ~= nil
            st.dance = (a == "Dance")
            local air = (flyFlag == true) or a == "Jump" or a == "Saut" or a == "Chute" or a == "Vol"

            -- décollage / atterrissage
            if air and not st.wasAir then st.burst = 1 end
            if (not air) and st.wasAir then st.flareKick = 1 end
            st.wasAir = air
            st.burst = math.max(0, st.burst - dt / 0.9)
            st.flareKick = math.max(0, st.flareKick - dt / 0.7)

            -- actions (au sol : picorage, pépiement, ébrouement, queue ; partout : cri, battement au sol)
            if st.act then
                local nm = st.act.name
                if air and (nm == "flap" or nm == "ruffle" or nm == "peck" or nm == "wag") then st.act = nil end
            end
            local env = 0
            if st.act then
                local u = (now - st.act.t0) / st.act.dur
                if u >= 1 then st.act = nil else env = math.sin(math.pi * u) end
            end
            if (not st.act) and (not air) and cfg.idleActs and a == "Idle" and now > st.nextAct then
                BD.act(({ "peck", "chirp", "ruffle", "wag" })[math.random(1, 4)])
                st.nextAct = now + 3 + math.random() * 4
            end
            local nm = st.act and st.act.name or ""
            local peck, beak, puff, shake, wag = 0, 0, 0, 0, 0
            if nm == "peck" then peck = math.max(0, math.sin(((now - st.act.t0) / st.act.dur) * math.pi * 3)) ^ 1.4
            elseif nm == "chirp" then beak, puff = (0.5 + 0.5 * math.sin(now * 20)) * env, 0.4 * env
            elseif nm == "cry" then beak, puff = (0.6 + 0.4 * math.sin(now * 13)) * math.min(1, env * 2), env
            elseif nm == "ruffle" then shake = env
            elseif nm == "wag" then wag = math.sin(now * 14) * env end
            st.peck, st.beak, st.puff, st.shake, st.wag = peck, beak, puff, shake, wag

            -- cibles
            local climb = air and clamp(vy / 18, 0, 1) or 0
            local hovT  = (air and hs < 3.5 and vy > -6) and 1 or 0
            local diveT = (air and vy < -18 and hs > 8) and clamp((-vy - 18) / 22, 0, 1) or 0
            local flareT = math.max(st.flareKick, (air and vy < -4 and hs < 12 and hovT == 0) and clamp((-vy - 4) / 10, 0, 1) * 0.8 or 0)
            if nm == "cry" then flareT = math.max(flareT, 0.35 * env) end

            local gT
            if nm == "flap" or st.dance then gT = 1
            elseif not air then gT = 0
            elseif cfg.forceGlide or diveT > 0.3 then gT = 0
            elseif hovT > 0.5 or climb > 0.25 or flareT > 0.3 or st.burst > 0.2 then gT = 1
            elseif vy < -3 and hs > 6 then gT = 0.05
            elseif cfg.autoGlide and sp.glide > 0 then
                if now > st.gateT then
                    st.gateOn = not st.gateOn
                    st.gateT = now + (st.gateOn and (1.8 + math.random() * 1.4) or ((0.9 + math.random() * 1.1) * sp.glide))
                end
                gT = st.gateOn and 1 or 0.05
            else gT = 1 end

            if startK > 0 and not air then gT = 0 end                      -- au début au sol : ailes tendues à plat, sans battre
            local wingT = (air or cfg.spread or nm == "flap" or flareT > 0.2 or startK > 0) and 1 or 0
            if st.dance then wingT = math.max(wingT, 0.7) end
            if nm == "cry" then wingT = math.max(wingT, 0.65 * env) end
            if nm == "ruffle" then wingT = math.max(wingT, 0.3 * env) end

            st.fly   = approach(st.fly, air and 1 or 0, air and 7 or 4, dt)
            st.wing  = approach(st.wing, wingT, wingT > st.wing and 6 or 3.5, dt)
            st.g     = approach(st.g, gT, 3.2, dt)
            st.flare = approach(st.flare, flareT, 8, dt)
            st.dive  = approach(st.dive, diveT, 4, dt)
            st.hov   = approach(st.hov, hovT, 3, dt)

            -- fréquence et amplitude des battements
            local hz = sp.hz * cfg.flapSpeed * (air and (1 + 0.35 * climb + 0.55 * st.hov + 0.4 * st.burst + 0.5 * st.flare) or 0.9)
            st.hzS = approach(st.hzS, hz, 4, dt)
            st.phi = st.phi + 2 * math.pi * st.hzS * dt
            st.A = sp.amp * (1 + 0.25 * climb + 0.3 * st.hov + 0.35 * st.burst)
            if not air then st.A = sp.amp * 0.9 end

            -- cap (direction du vol = direction de la vitesse ; sinon la caméra) et vitesse de rotation
            local target = ch
            if air and hs > 4 then target = Vector3.new(vel.X, 0, vel.Z).Unit end
            local old = st.hv
            local nh = old:Lerp(target, 1 - math.exp(-(air and 4.5 or 9) * dt))
            if nh.Magnitude < 0.05 then nh = old:Cross(Vector3.yAxis) end
            nh = nh.Unit
            local om = math.asin(clamp(old:Cross(nh).Y, -1, 1)) / dt
            st.omega = approach(st.omega, clamp(om, -6, 6), 6, dt)
            st.hv = nh

            -- inclinaison dans les virages (virage coordonné) + dérapage en stationnaire ; tête et corps restent lisses
            local right = nh:Cross(Vector3.yAxis)
            local bankT = 0
            if air then
                bankT = -math.atan(hs * st.omega / 55) * cfg.bank + clamp(vel:Dot(right) * 0.02, -0.35, 0.35) * st.hov
                bankT = clamp(bankT, -0.95, 0.95)
            end
            st.bank = approach(st.bank, bankT, 5, dt)

            -- tangage : suit l'angle de montée, se redresse en stationnaire, se cabre à l'atterrissage
            local pitchT
            if air then
                pitchT = clamp(math.atan2(vy, math.max(hs, 3)) * 0.75, -1.0, 0.9) + 0.55 * st.flare
                pitchT = pitchT + (0.9 - pitchT) * st.hov
            else
                pitchT = 0.10 + (st.run and -0.22 or 0) - 0.45 * peck + 0.15 * puff
            end
            st.pitch = approach(st.pitch, pitchT, air and 4 or 7, dt)

            -- queue : éventail + relevée en frein d'atterrissage, gouvernail dans les virages
            st.tailUp  = approach(st.tailUp, 0.15 * (1 - st.fly) + 0.9 * st.flare - 0.15 * st.dive + 0.5 * st.hov, 6, dt)
            st.fan     = approach(st.fan, clamp(0.12 * fS * 1.2 + 0.3 * startK + sp.fan * 0.5 * (1 - st.g) * st.fly * (1 - st.dive) + 0.7 * st.flare
                            + 0.25 * math.abs(st.bank) + 0.5 * (nm == "cry" and env or 0), 0, 0.85), 5, dt)
            st.tailYaw = approach(st.tailYaw, -st.bank * 0.3, 6, dt)

            -- repères du corps
            local Yaw = CFrame.lookAt(Vector3.zero, st.hv)
            local flapPitch = math.cos(st.phi) * 0.05 * st.g + math.sin(now * 38) * 0.03 * shake
            local Bm = Yaw * CFrame.Angles(st.pitch + flapPitch, 0, 0) * CFrame.Angles(0, 0, -st.bank + math.sin(now * 41) * 0.05 * shake)
            local bob = math.sin(st.phi) * 0.22 * cs * st.g * st.A + math.sin(now * 1.9) * 0.06 * cs * (1 - st.fly)
            if st.walk and not air then bob = bob + math.sin(wp * 2) * 0.10 * cs end
            local d = (2.0 + 0.7 * st.fly - 1.3 * st.hov) * cs
            local yOff = (-3.0 + 1.2 * st.fly - 1.0 * st.hov) * cs
            st.Yaw, st.B = Yaw, Bm
            st.c0 = headPos + Yaw * Vector3.new(0, yOff, d) + Vector3.yAxis * (bob + hgt)
            local headPitch = -st.pitch * 0.6 - peck * 1.1 - st.dive * 0.35 + 0.1
            st.H = Yaw * CFrame.Angles(headPitch, 0, 0) * CFrame.Angles(0, 0, st.bank * 0.8)
            st.Rc = CFrame.Angles(-st.pitch * 0.8 * st.hov, 0, 0)    -- en stationnaire, le plan de battement reste horizontal

            -- ===== COURBES DES AILES (3 rangées x 2 côtés), dans le repère du corps =====
            local Ls = 8.2 * cs * cfg.span * sp.span * (1 + startK * (sS - 1))
            local chord = 0.85 * cs * (1 + startK * 0.8)
            local g, A = st.g, st.A
            local mean   = 0.10 + 0.14 * (1 - g) + 0.55 * st.flare - 0.25 * st.dive + 0.15 * st.hov
            local sweep0 = 0.10 + 0.30 * (1 - g) * (1 - st.hov) + 1.1 * st.dive - 0.35 * st.flare - 0.2 * st.hov
            local sweepA = 0.45 * st.hov
            local lagK   = 1.0 + 0.5 * st.hov
            mean = mean + (0.04 - mean) * startK
            sweep0 = sweep0 * (1 - startK * 0.8)
            local Aeff   = math.max(A * (1 - 0.85 * st.dive), 0.9 * st.flare)
            for side = 0, 1 do
                local sd = (side == 0) and -1 or 1
                local S = Vector3.new(sd * 0.9 * cs, 0.5 * cs, -0.7 * cs)
                for row = 0, 2 do
                    local cv = st.curves[side * 3 + row + 1]
                    if not cv then cv = {}; st.curves[side * 3 + row + 1] = cv end
                    local P = S
                    cv[0] = S + Vector3.new(0, 0, row * chord)
                    for k = 1, N do
                        local uk = k / N
                        local ph = st.phi - lagK * uk ^ 1.2 - row * 0.28
                        local ampU = Aeff * (0.55 + 0.75 * uk)
                        local wave = math.cos(ph) + 0.15 * math.sin(2 * ph)
                        local beta = mean + ampU * g * wave - 0.16 * uk * uk * (1 - g) * (1 - st.dive)
                            + math.sin(now * 37 + k) * 0.04 * shake
                        local psi = sweep0 + sweepA * math.sin(ph)
                        local upS = math.max(0, -math.sin(ph))
                        local ds = (Ls / N) * (1 - 0.38 * upS * uk * g) * (1 - 0.65 * st.dive * uk)
                        local cb = math.cos(beta)
                        P = P + Vector3.new(sd * cb * math.cos(psi), math.sin(beta), math.sin(psi) * cb) * ds
                        cv[k] = P + Vector3.new(0, -0.12 * row * cs * uk, row * chord * (1 - 0.55 * uk))
                    end
                end
            end
        end

        local function sampleCurve(cv, u)
            local f = clamp(u, 0, 1) * N
            local i0 = math.min(math.floor(f), N - 1)
            local p0, p1 = cv[i0], cv[i0 + 1]
            return p0:Lerp(p1, f - i0), (p1 - p0)
        end

        local U = { { 0.20, 0.45, 0.70, 0.95 }, { 0.28, 0.52, 0.76, 0.96 }, { 0.38, 0.60, 0.80, 1.00 } }

        -- ===== POSE d'un dé : retourne (position, rotation monde) =====
        function BD.pose(i, n, headPos, scale, comp, hgt, wp, T)
            local st, cfg = BD.st, BD.cfg
            local kind, idx = BD.kind[i] or "extra", BD.idx[i] or 1
            local cs = scale * comp
            local Bm, c0, Yaw, H = st.B, st.c0, st.Yaw, st.H
            local function W(v) return c0 + Bm * v end                 -- repère du corps -> monde
            local pos, rot = c0, Bm

            if kind == "body" then
                pos = c0

            elseif kind == "torso" then
                if idx == 1 then pos = W(Vector3.new(0, (0.15 + st.puff * 0.25) * cs, -(1.35 + st.puff * 0.35) * cs))   -- poitrail
                else pos = W(Vector3.new(0, 0.05 * cs, 1.5 * cs)) end                                                   -- croupion

            elseif kind == "neck" then
                local base = W(Vector3.new(0, 0.7 * cs, -1.5 * cs))
                local t = idx / 3
                local s = math.sin(math.pi * t)
                pos = base:Lerp(headPos, t) + Vector3.yAxis * (s * (0.45 + 0.35 * (1 - st.fly)) * cs) - st.hv * (s * 0.35 * cs * (1 - st.fly * 0.6))

            elseif kind == "beak" then
                if idx == 1 then pos = headPos + H * Vector3.new(0, -0.02 * cs, -1.3 * cs)
                else pos = headPos + H * Vector3.new(0, (-0.5 - st.beak * 0.5) * cs, -(1.05 - st.beak * 0.1) * cs) end
                rot = H

            elseif kind == "wing" then
                local side = math.floor(idx / 100)
                local row = math.floor(idx / 10) % 10
                local col = idx % 10
                local sd = (side == 0) and -1 or 1
                local cv = st.curves[side * 3 + row + 1]
                if cv then
                    local L, d = sampleCurve(cv, U[row + 1][col + 1])
                    local S = Vector3.new(sd * 0.9 * cs, 0.5 * cs, -0.7 * cs)
                    L = S + st.Rc * (L - S)
                    local fS = cfg.foldSpread or 1.6
                    local Lf = Vector3.new(sd * (1.0 + 0.5 * row * fS) * cs, (0.6 + 0.25 * row * fS) * cs, (-1.0 + 0.85 * fS * col + 0.2 * row) * cs)   -- ailes repliées
                    local wd = smooth(st.wing * 1.5 - (col / 3) * 0.5)                  -- l'aile se déploie de l'épaule vers le bout
                    pos = W(Lf:Lerp(L, wd))
                    if d.Magnitude > 0.05 then rot = Bm * CFrame.lookAt(Vector3.zero, d.Unit) end
                end

            elseif kind == "tail" then
                local a = ((idx - 3) / 2) * st.fan
                local r = 1.9 * cs * (1 - 0.10 * math.abs(idx - 3))
                local tl = CFrame.Angles(-st.tailUp, st.tailYaw + st.wag * 0.35, 0) * Vector3.new(math.sin(a) * r, 0, math.cos(a) * r)
                pos = W(Vector3.new(0, 0.1 * cs, 1.9 * cs) + tl + Vector3.new(0, math.sin(T * 9 + idx) * 0.04 * cs * st.g, 0))

            elseif kind == "leg" then
                local sd = (idx > 2) and 1 or -1
                local seg = (idx % 2 == 1) and 1 or 2                              -- 1 = genou, 2 = pied
                local hip = W(Vector3.new(sd * 0.55 * cs, -0.75 * cs, 0.2 * cs))
                local ph = wp + ((sd > 0) and math.pi or 0)
                if st.dance then ph = wp end
                local swing, lift = 0, 0
                if st.walk then
                    swing = math.sin(ph) * (st.run and 1.5 or 1.0) * cs
                    lift  = math.max(0, math.cos(ph)) * (st.run and 1.4 or 0.9) * scale
                elseif st.dance then
                    lift = math.abs(math.sin(wp)) * 1.2 * scale
                end
                local footG = Vector3.new(c0.X, headPos.Y - 6.3 * scale + hgt + lift, c0.Z) + Yaw * Vector3.new(sd * 0.62 * cs, 0, -(0.1 * cs + swing))
                local tuck  = W(Vector3.new(sd * 0.35 * cs, -0.55 * cs, 1.7 * cs))      -- vol : pattes repliées sous la queue
                local reach = W(Vector3.new(sd * 0.5 * cs, -1.7 * cs, -0.8 * cs))       -- atterrissage : pattes en avant et en bas
                local foot = footG:Lerp(tuck:Lerp(reach, st.flare), st.fly)
                if seg == 2 then pos = foot
                else pos = hip:Lerp(foot, 0.5) + Bm * Vector3.new(0, 0, 0.35 * cs) * (1 - st.fly * 0.5) end

            else
                -- dés en trop : plumes flottantes qui ondulent derrière
                pos = W(Vector3.new(math.sin(T * 2.4 + idx * 0.9) * 0.8 * cs, math.sin(T * 1.7 + idx) * 0.4 * cs, (3.8 + idx * 1.3) * cs))
            end

            -- ébrouement : tremblement rapide
            if st.shake > 0.01 then
                local sh = st.shake * 0.12 * cs * 2
                pos = pos + Vector3.new(noise(T * 33, i, 0), noise(T * 33, i, 4.3), noise(T * 33, i, 8.9)) * sh
            end

            -- 🎬 APPARITION : les dés sortent de la tête l'un après l'autre avec un léger rebond
            if cfg.unfurl then
                local span = math.max(cfg.unfurlDur, 0.4)
                local u = clamp((T - st.t0 - ((i - 1) / math.max(n, 1)) * span * 0.5) / (span * 0.5), 0, 1)
                if u < 1 then
                    local _oa = i * 2.399963
                    local _or = (1.5 + 0.35 * math.sqrt(i)) * cs
                    local _o0 = headPos + Vector3.new(math.cos(_oa) * _or, ((i % 5) - 2) * 0.9 * cs, math.sin(_oa) * _or)   -- départ étalé (jamais tous au même point : anti-suppression)
                    pos = _o0:Lerp(pos, easeOutBack(u))
                    rot = rot * CFrame.Angles((1 - u) * math.rad(540), (1 - u) * math.rad(270), 0)
                end
            end
            return pos, rot
        end
    end

