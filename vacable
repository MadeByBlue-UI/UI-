        end

        -- Sons intégrés à Roblox (comme dans le panel Catalogue)
        local function snd(self, id, speed, vol)
            if not self.Sounds then return end
            pcall(function()
                local sd = Instance.new("Sound")
                sd.SoundId = id
                sd.PlaybackSpeed = speed
                sd.Volume = vol * (self.Volume or 0.7)
                sd.Parent = self.gui
                sd:Play()
                task.delay(2, function() sd:Destroy() end)
            end)
        end

        local SHINE = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(200, 200, 200)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(200, 200, 200)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.6, Color3.fromRGB(200, 200, 200)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(200, 200, 200)),
        })

        function Radial.New(cfg)
            local self = setmetatable({}, Radial)
            self.Name = cfg.Name or "Palette"
            self.Pages = cfg.Pages or { { Name = "Page 1", Items = cfg.Items or {} } }
