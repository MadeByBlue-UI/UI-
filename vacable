-- STRETCH PANEL (haut gauche, à droite des boutons Roblox)
-- Même style que le HUD pièces / TP panel (noir, particules, shine blanc)
-- Colle ce bloc À LA FIN de ton script (après le HUD / TP panel)
-- =========================================================================
do
    local TS      = game:GetService("TweenService")
    local UIS     = game:GetService("UserInputService")
    local RS      = game:GetService("RunService")
    local Plrs    = game:GetService("Players")
    local lp      = Plrs.LocalPlayer
    local pg      = lp:WaitForChild("PlayerGui")

    -- ⚙️ AJUSTE ICI si le panel est mal placé par rapport aux boutons Roblox
    local OFFSET_X = 220   -- distance depuis la gauche (augmente pour décaler vers la droite)
    local OFFSET_Y = 11     -- distance depuis le haut
    local PANEL_W  = 250
    local PANEL_H  = 44

    local MIN, MAX, NORMAL = 30, 150, 100   -- 100 = résolution normale
    local value = NORMAL
    local BIND_NAME = "StretchPanelRes"

    -- Nettoyage d'une ancienne instance
    local old = pg:FindFirstChild("StretchPanelGUI")
    if old then old:Destroy() end
    pcall(function() RS:UnbindFromRenderStep(BIND_NAME) end)

    local gui = Instance.new("ScreenGui")
    gui.Name           = "StretchPanelGUI"
    gui.ResetOnSpawn   = false
    gui.DisplayOrder   = 8002
    gui.IgnoreGuiInset = true
    gui.Parent         = pg

    -- ---------- Particules fluides (même effet que les autres panels) ----------
    function addParticles(parent, count)
        local box = Instance.new("Frame")
        box.Size = UDim2.fromScale(1, 1)
        box.BackgroundTransparency = 1
        box.ClipsDescendants = true
        box.ZIndex = parent.ZIndex
        box.Parent = parent
        local cornerBox = Instance.new("UICorner")
        cornerBox.CornerRadius = UDim.new(0, 30)
        cornerBox.Parent = box

        local list = {}
        for _ = 1, count do
            local s = math.random(2, 4)
            local p = Instance.new("Frame")
            p.Size = UDim2.fromOffset(s, s)
            p.Position = UDim2.fromScale(math.random(0, 100) / 100, math.random(0, 100) / 100)
            p.AnchorPoint = Vector2.new(0.5, 0.5)
            p.BackgroundColor3 = Color3.new(1, 1, 1)
            p.BackgroundTransparency = math.random(80, 94) / 100
            p.BorderSizePixel = 0
            p.ZIndex = parent.ZIndex + 1
            p.Parent = box
            Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
            table.insert(list, { f = p, v = Vector2.new(math.random(-15, 15) / 100, math.random(-15, 15) / 100) })
        end

        task.spawn(function()
            while box.Parent do
                local m  = UIS:GetMouseLocation()
                local ap = parent.AbsolutePosition
                local as = parent.AbsoluteSize
                local mx = (m.X - ap.X) / math.max(as.X, 1)
                local my = (m.Y - ap.Y) / math.max(as.Y, 1)
                for _, d in ipairs(list) do
                    if d.f.Parent then
                        local x, y = d.f.Position.X.Scale, d.f.Position.Y.Scale
                        local dx, dy = x - mx, y - my
                        local dist = math.sqrt(dx * dx + dy * dy)
                        if dist < 0.2 and dist > 0 then
                            local force = (0.2 - dist) / 0.2 * 0.015
                            d.v = d.v + Vector2.new(dx / dist * force, dy / dist * force)
                        end
                        local nx, ny = x + d.v.X * 0.016, y + d.v.Y * 0.016
                        if nx <= 0 or nx >= 1 then d.v = Vector2.new(-d.v.X, d.v.Y); nx = math.clamp(nx, 0, 1) end
                        if ny <= 0 or ny >= 1 then d.v = Vector2.new(d.v.X, -d.v.Y); ny = math.clamp(ny, 0, 1) end
                        d.v = d.v * 0.99
                        d.f.Position = UDim2.fromScale(nx, ny)
                    end
                end
                task.wait(0.016)
            end
        end)
    end

    -- ---------- Panel ----------
    local panel = Instance.new("Frame")
    panel.Name = "StretchPanel"
    panel.Size = UDim2.new(0, PANEL_W, 0, PANEL_H)
    panel.Position = UDim2.new(0, OFFSET_X, 0, OFFSET_Y)
    panel.BackgroundColor3 = Color3.new(0, 0, 0)
    panel.BackgroundTransparency = 0.05
    panel.BorderSizePixel = 0
    panel.Parent = gui
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 30)
    addParticles(panel, 6)

    -- Petit label "STRETCH" (cliquable = reset à 100%)
    local title = Instance.new("TextButton")
    title.Size = UDim2.new(0, 70, 0, 14)
    title.Position = UDim2.new(0, 16, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = "STRETCH"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 10
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.AutoButtonColor = false
    title.ZIndex = panel.ZIndex + 3
    title.Parent = panel

    -- Valeur en gros avec effet shine
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 70, 0, 20)
    valueLabel.Position = UDim2.new(0, 14, 0, 18)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = "100%"
    valueLabel.TextColor3 = Color3.new(1, 1, 1)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 17
    valueLabel.TextXAlignment = Enum.TextXAlignment.Left
    valueLabel.ZIndex = panel.ZIndex + 3
    valueLabel.Parent = panel

    local shine = Instance.new("UIGradient")
    shine.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(200, 200, 200)),
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(200, 200, 200)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(200, 200, 200)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(200, 200, 200)),
    })
    shine.Rotation = 45
    shine.Offset = Vector2.new(-1, 0)
    shine.Parent = valueLabel

    task.spawn(function()
        while valueLabel.Parent do
            TS:Create(shine, TweenInfo.new(3, Enum.EasingStyle.Linear), { Offset = Vector2.new(1, 0) }):Play()
            task.wait(3)
            shine.Offset = Vector2.new(-1, 0)
            task.wait(1.5)
        end
    end)

    -- Séparateur
    local sep = Instance.new("Frame")
    sep.Size = UDim2.new(0, 1, 0, 28)
    sep.Position = UDim2.new(0, 92, 0.5, -14)
    sep.BackgroundColor3 = Color3.new(1, 1, 1)
    sep.BackgroundTransparency = 0.7
    sep.BorderSizePixel = 0
    sep.ZIndex = panel.ZIndex + 2
    sep.Parent = panel

    -- Zone cliquable du slider (plus haute que la piste pour attraper facilement)
    local hit = Instance.new("TextButton")
    hit.Size = UDim2.new(0, 136, 0, 30)
    hit.Position = UDim2.new(0, 104, 0.5, -15)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.ZIndex = panel.ZIndex + 4
    hit.Parent = panel

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0.5, -3)
    track.BackgroundColor3 = Color3.new(1, 1, 1)
    track.BackgroundTransparency = 0.8
    track.BorderSizePixel = 0
    track.ZIndex = panel.ZIndex + 3
    track.Parent = hit
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.new(1, 1, 1)
    fill.BorderSizePixel = 0
    fill.ZIndex = panel.ZIndex + 4
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.ZIndex = panel.ZIndex + 5
    knob.Parent = track
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    -- ---------- Logique stretch ----------
    function stopStretch()
        pcall(function() RS:UnbindFromRenderStep(BIND_NAME) end)
    end

    function startStretch()
        stopStretch()
        RS:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 2, function()
            local cam = workspace.CurrentCamera
            if not cam then return end
            local s = value / 100
            cam.CFrame = cam.CFrame * CFrame.new(
                0, 0, 0,
                1, 0, 0,
                0, s, 0,
                0, 0, 1
            )
        end)
    end

    local function setValue(v)
        value = math.clamp(math.floor(v + 0.5), MIN, MAX)
        local rel = (value - MIN) / (MAX - MIN)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLabel.Text = value .. "%"
        if value == NORMAL then stopStretch() else startStretch() end
    end

    -- ---------- Drag du slider ----------
    local dragging = false

    local function setFromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local v = MIN + rel * (MAX - MIN)
        -- petit "aimant" sur 100% (résolution normale)
        if math.abs(v - NORMAL) <= 2 then v = NORMAL end
        setValue(v)
    end

    _TrackConn(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end))

    _TrackConn(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end))

    _TrackConn(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    -- Clic sur "STRETCH" = reset à 100%
    _TrackConn(title.MouseButton1Click:Connect(function() setValue(NORMAL) end))

    setValue(NORMAL)

    -- Animation d'entrée (glisse depuis la gauche)
    panel.Position = UDim2.new(0, -PANEL_W, 0, OFFSET_Y)
    TS:Create(panel, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, OFFSET_X, 0, OFFSET_Y)
    }):Play()

    -- Cleanup propre quand le script est relancé / fermé
    local previousCleanup = _G.HelperOtherCleanup
    _G.HelperOtherCleanup = function()
        stopStretch()
        if gui and gui.Parent then gui:Destroy() end
        if previousCleanup then pcall(previousCleanup) end
    end
end

