                                                        local corpIndex = textIndex - 8
                                                        arrowX = 0  -- Tous alignés au centre
                                                        arrowY = standardHeight  -- Même hauteur
                                                        arrowZ = forwardDistance - letterWidth * 0.8 - (corpIndex - 1) * letterWidth * 0.4  -- Espacés en Z = ligne verticale
                                                    end
                                                    
