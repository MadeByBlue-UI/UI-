        -- rend le missile inoffensif : sans ça il peut exploser tout seul au contact du sol / de toi dès son spawn
        local function gsDefuse(model)
            local function fix(p)
                if GS.armed then return end
                if p:IsA("BasePart") then p.CanCollide = false; p.CanTouch = false end
            end
            for _, p in ipairs(model:GetDescendants()) do fix(p) end
            model.DescendantAdded:Connect(fix)
            task.delay(0.15, function() if model.Parent then for _, p in ipairs(model:GetDescendants()) do fix(p) end end end)
        end

        -- spawn un BombMissile (jusqu'à 3 essais) ; il est exclu de la formation dès son apparition (jamais pris comme toy du corps)
        local function gsSpawnMissile(cf)
            local inv = gsInv()
            if not inv then return nil end
            _G._FigureExclude = _G._FigureExclude or setmetatable({}, { __mode = "k" })
            _G._FigMissBusy = true
            for _ = 1, 3 do
                local before, found = {}, nil
                for _, c in ipairs(inv:GetChildren()) do before[c] = true end
                _G._FigMissSnap = before
                local conn = inv.ChildAdded:Connect(function(c)
                    if c.Name == "BombMissile" and not before[c] then
                        _G._FigureExclude[c] = true
                        gsDefuse(c); found = c
                    end
                end)
                local cs = LocalPlayer:FindFirstChild("CanSpawnToy")
                if cs and not cs.Value then
                    local t0 = tick()
                    repeat task.wait(0.05) until cs.Value or tick() - t0 > 3
                end
                task.spawn(function()
                    pcall(function()
                        RS_GS:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction"):InvokeServer("BombMissile", cf, Vector3.zero)
                    end)
                end)
                local t0 = tick()
                while not found and tick() - t0 < 2.5 do task.wait() end
                conn:Disconnect()
                if found then
                    local root = found:FindFirstChild("PartHitDetector", true) or found:FindFirstChildWhichIsA("BasePart", true)
                    if root then _G._FigMissBusy = false; return found, root end
                end
                task.wait(0.2)
            end
            _G._FigMissBusy = false
            return nil
        end

        -- explosion avec 3 variantes de secours si le missile est toujours là
        local function gsExplode(missile, root, pos, hrp)
            task.spawn(function()
                for variant = 1, 3 do
                    if not missile.Parent then return end
                    pcall(function() missile:PivotTo(CFrame.new(pos + Vector3.new(0, 0.3, 0))) end)
                    pcall(function()
                        RS_GS:WaitForChild("BombEvents"):WaitForChild("BombExplode"):FireServer({
                            Hitbox                 = root,
                            PositionPart           = (variant == 2) and hrp or root,
                            Radius                 = GS.radius,
                            TimeLength             = 0.1,
                            ExplodesByFire         = (variant ~= 3),
                            MaxForcePerStudSquared = -100,
                            DestroysModel          = true,
                            Model                  = missile,
                        }, pos)
                    end)
                    task.wait(0.35)
                end
                if missile.Parent then
                    pcall(function() RS_GS.MenuToys.DestroyToy:FireServer(missile) end)
                end
            end)
        end

        -- onde de choc visuelle (locale) + petit tremblement de caméra
        local function gsImpactFx(pos)
            pcall(function()
                local r = Instance.new("Part")
                r.Anchored, r.CanCollide, r.CanQuery, r.CanTouch = true, false, false, false
                r.Material, r.Color, r.Shape, r.Transparency = Enum.Material.Neon, Color3.fromRGB(255, 170, 60), Enum.PartType.Cylinder, 0.15
                r.Size = Vector3.new(0.4, 2, 2)
                r.CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
                r.Parent = workspace
                local d = math.max(GS.radius, 8) * 2.6
                TWN_GS:Create(r, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { Size = Vector3.new(0.4, d, d), Transparency = 1 }):Play()
                DEB_GS:AddItem(r, 0.6)
            end)
            pcall(function()
                local cam, t0, conn = workspace.CurrentCamera, os.clock(), nil
                conn = RUN_GS.RenderStepped:Connect(function()
                    local e = os.clock() - t0
                    if e > 0.3 or not cam then conn:Disconnect() return end
                    local k = (1 - e / 0.3) * 0.7
                    cam.CFrame = cam.CFrame * CFrame.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
                end)
            end)
        end

        local function gsRun()
            if GS.busy then return end
            if not animatedFigureActive then
                notify("Ground Smash", "Active d'abord Animated Figure", 3)
                return
            end
            local char = LocalPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then return end
            local st = GS_STYLES[GS.style] or GS_STYLES["Classique (saut + claque)"]

            GS.busy = true
            GS.armed = false
            GS.pose = st.pose
            task.spawn(function()
                local missile, root, followConn, pinPos
                local savedMethod = _G._FigureGroundMethod
                local function alive() return animatedFigureActive and hrp.Parent and hum.Parent and hum.Health > 0 end

                local okRun, err = pcall(function()
                    -- "Saut Libre" simulerait son propre saut et ignorerait le nôtre : on le coupe le temps du smash
                    if savedMethod == "Saut Libre" then
                        _G._FigureGroundMethod = "Ground Offset/Snap"
                        if _G._FigureFreeJumpReset then _G._FigureFreeJumpReset() end
                    end

                    local p0 = hrp.Position
                    local x0, z0, y0 = p0.X, p0.Z, p0.Y
                    local rot0 = hrp.CFrame - hrp.CFrame.Position

                    -- 1) CHARGE : accroupi, bras en arrière ; pendant ce temps on spawn le missile (en l'air, inoffensif)
                    GS.phase, GS.rot, GS.t0, GS.dur = "charge", 0, os.clock(), st.charge
                    figureAnimationMode = "Smash"
                    local spawnDone = false
                    task.spawn(function()
                        missile, root = gsSpawnMissile(hrp.CFrame * CFrame.new(0, 30, 0))
                        if missile then
                            pcall(function()
                                RS_GS:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner"):FireServer(root, root.CFrame)
                            end)
                            followConn = RUN_GS.Heartbeat:Connect(function()
                                if not missile.Parent then return end
                                -- en attente tout là-haut (hauteur réglable) jusqu'à ce que tu tapes le sol
                                local p = pinPos or Vector3.new(x0, y0 + (GS.mHeight or 1000), z0)
                                missile:PivotTo(CFrame.new(p))
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                            end)
                        end
                        spawnDone = true
                    end)
                    local tc = os.clock()
                    while os.clock() - tc < st.charge and alive() do RUN_GS.Heartbeat:Wait() end
                    local tw = tick()
                    while not spawnDone and tick() - tw < 8 and alive() do RUN_GS.Heartbeat:Wait() end
                    if not missile then notify("Ground Smash", "⚠️ Missile non spawné : smash sans explosion", 3) end
                    if not alive() then return end

                    -- 2) MONTÉE + 3) SUSPENSION : position pilotée image par image (vraie hauteur, trajectoire propre)
                    local stand = hum.HipHeight + hrp.Size.Y / 2
                    local function place(y, yaw)
                        hrp.CFrame = CFrame.new(x0, y, z0) * rot0 * CFrame.Angles(0, yaw or 0, 0)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hum:ChangeState(Enum.HumanoidStateType.Freefall)   -- le Ground Snap te considère "en l'air" : la formation te suit
                    end
                    local apex = y0 + st.H
                    local tUp = st.up + st.hang
                    local t1, yaw = os.clock(), 0
                    GS.phase, GS.t0 = "rise", os.clock()
                    while alive() do
                        local dt = RUN_GS.Heartbeat:Wait()
                        local e = os.clock() - t1
                        if e >= tUp then break end
                        yaw = yaw + st.spin * dt
                        local k = math.clamp(e / tUp, 0, 1)
                        GS.rot = st.flips * math.pi * 2 * (k * k * (3 - 2 * k))
                        if e < st.up then
                            local t = e / st.up
                            place(y0 + st.H * (1 - (1 - t) * (1 - t)), yaw)
                        else
                            if GS.phase ~= "hang" then GS.phase, GS.t0 = "hang", os.clock() end
                            place(apex + 0.6 * math.sin((e - st.up) * 6), yaw)
                        end
                    end
                    if not alive() then return end

                    -- 4) PLONGÉE : accélération + raycast anti-traversée
                    GS.phase, GS.rot, GS.t0 = "fall", 0, os.clock()
                    local rp = RaycastParams.new()
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    local ign = { char }
                    if missile then table.insert(ign, missile) end
                    local inv = gsInv()
                    if inv then table.insert(ign, inv) end
                    rp.FilterDescendantsInstances = ign
                    local y, vy, impactPos = apex, 40, nil
                    local t2 = os.clock()
                    while alive() and os.clock() - t2 < 8 do
                        local dt = RUN_GS.Heartbeat:Wait()
                        vy = vy + st.a * dt
                        local ny = y - vy * dt
                        local hit = workspace:Raycast(Vector3.new(x0, y, z0), Vector3.new(0, -((y - ny) + stand + 1), 0), rp)
                        if hit then
                            impactPos = hit.Position
                            place(hit.Position.Y + stand, yaw)
                            break
                        end
                        y = ny
                        place(y, yaw)
                    end
                    if not impactPos then return end

                    -- 5) IMPACT : pose "poing au sol", onde de choc, explosion du missile
                    GS.phase, GS.t0 = "impact", os.clock()
                    gsImpactFx(impactPos)
                    if missile and root then
                        GS.armed = true
                        if followConn then followConn:Disconnect(); followConn = nil end
                        pcall(function()
                            for _, p in ipairs(missile:GetDescendants()) do
                                if p:IsA("BasePart") then p.CanCollide = true; p.CanTouch = true end
                            end
                            missile:PivotTo(CFrame.new(impactPos + Vector3.new(0, 6, 0)))
                            root.AssemblyAngularVelocity = Vector3.zero
                            root.AssemblyLinearVelocity = Vector3.new(0, -450, 0)   -- fling vers tes pieds
                        end)
                        task.delay(0.12, function() gsExplode(missile, root, impactPos, hrp) end)   -- secours si rien n'a explosé
                    end
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed) end)
                    task.wait(st.hold)
                end)
                if not okRun then warn("[Ground Smash] " .. tostring(err)) end

                -- nettoyage (toujours exécuté)
                _G._FigureGroundMethod = savedMethod
                if followConn then
                    task.delay(1.6, function() followConn:Disconnect() end)
                end
                if missile then
                    task.delay(2, function()
                        if missile.Parent then pcall(function() RS_GS.MenuToys.DestroyToy:FireServer(missile) end) end
                    end)
                end
                GS.phase = nil
                GS.armed, GS.pose = false, nil
                _G._FigMissBusy = false
                figureAnimationMode = "Auto"
                GS.busy = false
            end)
        end

        ExtraFun:CreateDropdown({
            Name = "💥 Style de Ground Smash",
            Flag = "FigureSmashStyle",
            Default = "Classique (saut + claque)",
            Items = { "Classique (saut + claque)", "Météore (très haut)", "Plongeon rapide", "Tornade + claque", "Salto + écrasement", "Suspendu puis écrasement",
                      "Justicier (poing armé + piqué)", "Aigle (ailes écartées)", "Boulet de canon (en boule)", "Deux poings (jointes + écrasement)", "Zen (méditation en vol)" },
            Callback = function(v) GS.style = v end
        })

        ExtraFun:CreateSlider({
            Name = "🚀 Hauteur d'attente du missile (studs)",
            Flag = "FigureSmashMissileH",
            Min = 100, Max = 2000, Default = 1000,
            Callback = function(v) GS.mHeight = v end
        })

        ExtraFun:CreateButton({
            Name = "💥 Ground Smash (saut + missile qui explose au sol)",
            Callback = function() gsRun() end
        })

        ExtraFun:CreateKeybind({
            Name = "⌨️ Touche Ground Smash",
            Flag = "FigureSmashKey",
            Default = Enum.KeyCode.Unknown,
            Callback = function(k) GS.key = k end
        })

        _TrackConn(UIS_GS.InputBegan:Connect(function(input, gpe)
            if gpe or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if GS.key == Enum.KeyCode.Unknown or input.KeyCode ~= GS.key then return end
            if UIS_GS:GetFocusedTextBox() then return end
            gsRun()
        end))
    end

