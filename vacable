    function startView()
        if viewConn then return end
        tickAcc, lastSig, lastChar, lastWorn = 0.5, "", nil, nil
        if S.previewSrc ~= "Jeu" then loadBase() end
        viewConn = RunS.Heartbeat:Connect(function(dt)
            tickAcc += dt
            if tickAcc >= 0.2 then
                tickAcc = 0
                local char = lp.Character
                if S.previewSrc == "Jeu" or X.baseFailed then
                    -- ancien mode : on reconstruit la copie quand ton perso change
                    local sig = char and buildSig(char) or nil
                    if sig and (sig ~= lastSig or char ~= lastChar) then
                        lastSig, lastChar = sig, char
                        local okR, errR = pcall(rebuildModel)
                        if not okR then
                            setStatus("Erreur aperçu : " .. tostring(errR))
                            warn("[Catalogue] erreur aperçu :", errR)
                        end
                    end
                elseif X.base then
                    -- mode Compte : avatar construit une fois, puis on ne touche qu'aux objets qui changent
                    if lastSig ~= "compte" then
                        lastSig = "compte"
                        local okR, errR = pcall(rebuildModel)
                        if not okR then warn("[Catalogue] erreur aperçu :", errR) end
                    else
                        local okS, errS = pcall(X.syncAcc)
                        if not okS then warn("[Catalogue] erreur aperçu :", errS) end
                    end
                end
                local key, ids = wornKey()
                if key ~= lastWorn then
                    lastWorn = key
                    rebuildList(ids)
                end
            end
            if autoRot and not dragging3d and not X.rdrag and not X.mdrag then angle += dt * 0.7 end
            if X.pose > 1 and model then
                pcall(poseStep, X.joints)
                if X.joints2 then pcall(poseStep, X.joints2) end
            end
            pcall(X.sideStep)
            updateCam()
        end)
    end

    function stopView()
        if viewConn then viewConn:Disconnect(); viewConn = nil end
        X.joints, X.joints2 = nil, nil
        X.pv = {}
        if model then model:Destroy(); model = nil end
        if X.model2 then X.model2:Destroy(); X.model2 = nil end
        if X.sideLbl1 then X.sideLbl1.Visible = false end
        if X.sideLbl2 then X.sideLbl2.Visible = false end
    end

    -- ----- Contrôles : glisser / molette / boutons -----
    _TrackConn(vp.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton3
            or (t == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftShift)) then
            -- clic molette (ou Shift + clic) : déplacer l'avatar
            X.mdrag = true
            X.lastMX, X.lastMY = input.Position.X, input.Position.Y
        elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            dragging3d = true
            lastX = input.Position.X
        elseif t == Enum.UserInputType.MouseButton2 then
            -- clic droit maintenu : orbite complète (gauche/droite + haut/bas)
            X.rdrag = true
            lastX, X.lastY = input.Position.X, input.Position.Y
        end
    end))
    _TrackConn(vp.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            zoom = math.clamp(zoom - input.Position.Z * 0.08, 0.4, 1.8)
        end
    end))
    _TrackConn(UIS.InputChanged:Connect(function(input)
        if X.mdrag and input.UserInputType == Enum.UserInputType.MouseMovement then
            local h = math.max(vp.AbsoluteSize.Y, 1)
            X.panX = math.clamp(X.panX - (input.Position.X - X.lastMX) / h, -0.8, 0.8)
            X.panY = math.clamp(X.panY + (input.Position.Y - X.lastMY) / h, -0.8, 0.8)
            X.lastMX, X.lastMY = input.Position.X, input.Position.Y
        elseif dragging3d and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            angle -= (input.Position.X - lastX) * 0.012
            lastX = input.Position.X
        elseif X.rdrag and input.UserInputType == Enum.UserInputType.MouseMovement then
            angle -= (input.Position.X - lastX) * 0.012
            X.pitch = math.clamp(X.pitch + (input.Position.Y - X.lastY) * 0.008, -1.2, 1.2)
            lastX, X.lastY = input.Position.X, input.Position.Y
        end
    end))
    _TrackConn(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging3d = false
            X.mdrag = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
            X.mdrag = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            X.rdrag = false
        end
    end))
    _TrackConn(autoBtn.MouseButton1Click:Connect(function()
