                        elseif PZ == "Aigle" then lean = (ph == "fall") and 50 or -16
                        elseif PZ == "Boulet" then lean = 50
                        elseif PZ == "Deux poings" then lean = (ph == "fall") and 38 or -10
                        elseif PZ == "Zen" then lean = (ph == "fall") and 6 or 0 end
                        local phi = rad(lean)
                        local dT = V(0, cos(phi), sin(phi))
                        local h0 = V(0, -9, (ph == "fall") and 0.3 or 0)
                        hip = rp(h0)
                        neck = rp(h0 + dT * 7.5)
                        head = rp(h0 + dT * 9)
                        armFn = function(side, S)
                            if PZ == "Zen" then
                                local tgt = V(0, S.Y - 2.2, S.Z + 2.0)
                                return _EmoteX.IK(S, tgt, 3.4, 2.1, V(side, -0.3, -0.4)), tgt
                            end
                            local d
                            if PZ == "Justicier" then
                                if ph == "fall" then d = (side > 0) and V(0.1, -0.25, 0.95) or V(-0.25, -0.9, -0.4)    -- poing devant, comme Superman
                                else d = (side > 0) and V(0.1, 1, 0.25) or V(-0.3, -0.5, -0.85) end
                            elseif PZ == "Aigle" then
                                if ph == "fall" then d = V(side * 0.4, -0.9, -0.3)                                      -- ailes repliées vers l'arrière
                                else d = V(side, 0.35, 0) end                                                           -- ailes grandes ouvertes
                            elseif PZ == "Boulet" then d = V(side * 0.3, -0.55, 0.8)
                            elseif PZ == "Deux poings" then
                                if ph == "rise" then d = V(side * 0.2, 1, 0.1)
                                elseif ph == "hang" then d = V(-side * 0.12, 1, 0.08)                                   -- mains jointes au-dessus de la tête
                                else d = V(-side * 0.1, -0.75, 0.55) end                                                -- les deux poings vers le sol
                            elseif ph == "rise" then d = V(side * 0.18, 1, 0.1)
                            elseif ph == "hang" then d = (side > 0) and V(0.2, 1, -0.25) or V(-0.6, 0.45, -0.85)
                            else d = (side > 0) and V(0.15, -1, 0.55) or V(-0.6, -0.15, -0.9) end
                            return straightArm(S, rx(d, phiR))
                        end
                        legFn = function(side, H)
                            if PZ == "Zen" then
                                local F = V(side * 0.3, -9.8, 1.6)                                                      -- jambes croisées (lotus)
                                return _EmoteX.IK(H, F, 2.6, 2.6, V(side, 0.1, 0.4)), F, nil
                            elseif PZ == "Boulet" then
                                local F = rp(V(side * 0.9 * spread, -10, 2.4))                                          -- genoux remontés contre la poitrine
                                return _EmoteX.IK(H, F, 2.6, 2.6, rx(V(0, 0.3, 1), phiR)), F, nil
                            elseif PZ == "Justicier" or PZ == "Aigle" then
                                local z = (ph == "fall") and -3.0 or -2.2                                               -- jambes tendues derrière
                                local F = rp(V(side * ((PZ == "Aigle") and 0.5 or 0.8) * spread, YF + 1.6, z))
                                return _EmoteX.IK(H, F, 2.6, 2.6, rx(V(0, 0.2, 1), phiR)), F, nil
                            end
                            local lift = (ph == "rise") and 1.2 or ((ph == "hang") and 3.0 or 1.0)
                            local fz = (ph == "fall") and ((side > 0) and 0.8 or -1.4) or -1.0
                            local F = rp(V(side * 0.95 * spread, YF + lift, fz))
                            return _EmoteX.IK(H, F, 2.6, 2.6, rx(V(0, 0.2, 1), phiR)), F, nil
                        end
                    end

                elseif anim == "Assis" then
                    -- Assis par terre : bassin posé, genoux relevés, mains sur les genoux, légère respiration
                    local br = sin(os.clock() * 1.8) * 0.08
                    local phi = rad(6)
                    local dT = V(0, cos(phi), sin(phi))
                    hip = V(0, YF + 1.5, -0.6)
                    neck = hip + dT * 7.5 + V(0, br, 0)
                    head = hip + dT * 9 + V(0, br * 1.5, 0)
                    local footZ, kPole = 3.0, V(0, 1, 0.3)
                    armFn = function(side, S)
                        local Hh = hip + V(side * 0.8 * spread, 0, 0)
                        local K = _EmoteX.IK(Hh, V(side * 1.4 * spread, YF, footZ), 2.6, 2.6, kPole)
                        local hand = K + V(side * 0.2, 0.9, 0.2)
                        return _EmoteX.IK(S, hand, 3.4, 2.1, V(side * 1, -0.2, -0.6)), hand
                    end
                    legFn = function(side, H)
                        local F = V(side * 1.4 * spread, YF, footZ)
                        return _EmoteX.IK(H, F, 2.6, 2.6, kPole), F, (_animBlend.flatFeet and 0 or nil)
                    end

                elseif anim == "Walk v2" or anim == "Run v2" then
                    -- Marche / course V2 : pieds posés au sol (IK), bassin qui rebondit, buste penché, bras en opposition.
                    -- Amplitude et cadence suivent la vitesse réelle (voir _EmoteX.GaitParams / GaitOmega).
                    local G = _EmoteX.GaitParams(anim, _EmoteX.speedU or 0, swing)
                    -- 🧭 direction du déplacement dans le repère du corps (voir la boucle principale) : (gx, gz) = (droite, avant)
                    local gx, gz = _EmoteX.gDx or 0, _EmoteX.gDz or 1
                    local gax, gaz = abs(gx), abs(gz)
                    local isRun, L, duty = G.isRun, G.L, G.duty
                    -- 🎛️ Style choisi dans le dropdown (Marche / Course). "Classique" / "Naturelle" = le v2 d'origine.
                    local sty = (_G._FigStyle or {})[isRun and "Run" or "Walk"]
                    local o = { lean = 0, drop = 0, armBase = 0, ab = nil, elbow = 0 }
                    if sty == "Cool" then            -- démarche chaloupée : bassin qui roule, bras mous, buste un peu en arrière
                        G.sway, G.bob, G.armAmp = G.sway * 2.6, G.bob * 1.4, G.armAmp * 0.55
                        o.elbow, o.lean = 28, -3
                    elseif sty == "Soldat" then      -- pas militaire : genoux hauts, bras raides, très peu de balancement
                        G.sway, G.bob, G.lift, G.armAmp = G.sway * 0.2, G.bob * 0.35, G.lift * 1.9, G.armAmp * 1.5
                        G.elbow, G.elbowSwing = 4 * G.a, 0
                    elseif sty == "Zombie" then      -- bras tendus devant, penché, pieds qui traînent
                        G.sway, G.bob, G.lift, G.armAmp = G.sway * 1.6, G.bob * 0.5, G.lift * 0.3, G.armAmp * 0.2
                        G.elbow, G.elbowSwing = 6 * G.a, 0
                        o.lean, o.armBase, o.ab = 14, 82, 0.28
                    elseif sty == "Furtive" then     -- accroupi, bras repliés, pas feutrés
                        G.bob, G.armAmp, G.lift = G.bob * 0.4, G.armAmp * 0.4, G.lift * 0.7
                        o.elbow, o.drop, o.lean = 42, 2.4, 16
                    elseif sty == "Sprint" then      -- très penché, bras qui pompent fort
                        G.bob, G.armAmp, G.elbow = G.bob * 1.1, G.armAmp * 1.25, 92 * G.a
                        o.lean = 12
                    elseif sty == "Naruto" then      -- bras tendus en arrière, buste très penché
                        G.armAmp, G.elbow, G.elbowSwing, G.sway = G.armAmp * 0.08, 6 * G.a, 0, G.sway * 0.5
                        o.lean, o.armBase, o.ab = 26, -72, 0.22
                    elseif sty == "Panique" then     -- bras en l'air qui s'agitent, genoux hauts
                        G.bob, G.lift, G.armAmp = G.bob * 1.8, G.lift * 1.6, G.armAmp * 0.45
                        G.elbow, G.elbowSwing = 70 * G.a, 28 * G.a
                        o.armBase, o.ab, o.lean = 150, 0.85, -4
                    end
                    local TAU = 2 * math.pi
                    local reach = 5.2 * 0.97
                    local hd2 = (L * gaz) ^ 2 + (gax * (0.9 + 0.45 * L)) ^ 2                 -- distance horizontale max des pieds (avant/arrière + côté)
                    local d0 = max(0, 5.2 - math.sqrt(max(0.25, reach * reach - hd2)))   -- flexion mini pour atteindre les pieds
                    local m = cos(2 * fp - TAU * duty)
                    -- marche : bassin le plus haut à mi-appui ; course : le plus bas à mi-appui (amorti), haut en vol
                    local drop = d0 + G.bob * (isRun and (0.5 + 0.5 * m) or (0.5 - 0.5 * m)) + o.drop * G.a
                    local sway = G.sway * cos(fp - math.pi * duty)                          -- bassin au-dessus de la jambe d'appui
                    shX = 1.25                                                              -- épaules plus écartées du corps
                    -- 🧭 Inclinaison selon la direction de déplacement (repère caméra) :
                    -- avant = penché devant, arrière = penché derrière, gauche/droite = penché sur le côté (Z+D = avant-droite)
                    local dx, dz = _EmoteX.leanDx or 0, _EmoteX.leanDz or 1   -- direction lissée (voir la boucle principale)
                    local tx = rad(dx * G.leanSide)
                    local phi = rad(dz * (dz >= 0 and G.lean or G.leanBack)) + rad(o.lean) * G.a
                    local dT = V(math.tan(tx), 1, math.tan(phi)).Unit
                    hip = V(sway, -9 - drop, 0)
                    neck = hip + dT * 7.5
                    head = hip + dT * 9
                    armFn = function(side, S)
                        local sa = sin(fp + (side > 0 and math.pi or 0))                    -- bras opposé à la jambe du même côté
                        local th = rad(G.armAmp * (0.3 + 0.7 * gaz)) * sa + phi * 0.4 + rad(o.armBase) * G.a   -- bras qui balancent moins en pas chassé
                        local bend = rad(max(0, G.elbow + o.elbow * G.a + G.elbowSwing * max(0, sa)))
                        local ab = o.ab or (G.isRun and 0.6 or 0.45)                        -- écart latéral des bras (0 = collés au corps)
                        local u = V(side * ab, -cos(th), sin(th))
                        local f = V(side * ab * 0.7, -cos(th + bend), sin(th + bend))
                        local E = S + u.Unit * 3.4
                        return E, E + f.Unit * 2.1
                    end
                    legFn = function(side, H)
                        local ph = ((fp + (side > 0 and 0 or math.pi)) % TAU) / TAU
                        local z, lift, pitch
                        if ph < duty then
                            z, lift = lerp(L, -L, ph / duty), 0                             -- appui : le pied recule avec le sol
                            pitch = -0.5 * smooth((ph / duty - 0.78) / 0.22)                -- fin d'appui : le talon se décolle, la pointe reste au sol
                        else
                            local q = (ph - duty) / (1 - duty)
                            z, lift = lerp(-L, L, smooth(q)), G.lift * sin(math.pi * q)     -- retour : le pied se lève et repart devant
                            -- pointe vers le bas au décollage, puis pointe relevée avant l'attaque du talon, pied plat à la pose
                            pitch = -0.5 * (1 - smooth(q / 0.35)) + 0.35 * sin(math.pi * smooth((q - 0.6) / 0.4))
                        end
                        -- pas dans la direction du déplacement : z = avance/recul, x = pas chassés ; écartement plus large en latéral (les pieds ne se croisent pas)
                        local F = V(side * (1.0 + 0.9 * gax) * spread + z * 0.45 * gx, YF + lift, z * gz)
                        if not _animBlend.flatFeet then
                            return _EmoteX.IK(H, F, 2.6, 2.6, V(0, 0.1, 1)), F
                        end
                        pitch = pitch * G.a * (isRun and 0.6 or 1) * max(0, gz)
                        F = F + V(0, 0.9 * max(0, -sin(pitch)), 0)                          -- talon levé : la cheville monte, la pointe reste sur le sol
                        return _EmoteX.IK(H, F, 2.6, 2.6, V(0, 0.1, 1)), F, pitch
                    end

                elseif anim == "Coucou" then
                    -- 👋 Coucou : un bras (droit) ou deux bras (toggle "Coucou à 2 mains") levés sur le côté, avant-bras qui salue
                    local both = _animBlend.coucou2
                    local cspd = _animBlend.coucouSpeed or 1
                    local ang = rad(32) * sin(fp * 1.75 * cspd)           -- balancement de l'avant-bras
                    local angL = (both and _animBlend.coucouAlt) and (rad(32) * sin(fp * 1.75 * cspd + math.pi)) or ang   -- main gauche (déphasée si "alternance")
                    local sway = 0.12 * sin(fp * 0.875 * cspd)            -- léger balancement du corps
                    local b = 0.1 * sin(fp * 0.45)                        -- respiration
                    hip = V(sway * 0.5, -9, 0)
                    neck = V(sway * 0.4, -1.5 + b * 0.5, 0.05)
                    head = V(sway * 0.6 + (both and 0 or 0.25), b, 0.1)  -- 1 main : la tête penche un peu vers la main qui salue
                    armFn = function(side, S)
                        if side > 0 or both then
                            -- bras écarté sur le côté (~65° de l'axe vertical), avant-bras qui salue au-dessus du coude (miroir à gauche)
                            local E = S + V(side * 1.0, 0.45, 0.15).Unit * 3.4
                            local a2 = (side < 0) and angL or ang
                            local f = V(side * (sin(a2) + 0.35), cos(a2), 0.1).Unit
                            return E, E + f * 2.1
                        end
                        return straightArm(S, V(-0.22, -1, 0.05))
                    end
                    legFn = plantedLegs(1.2, 0)

                elseif anim == "Allongé" then
                    -- 😊 Allongé : à plat ventre, coudes au sol, mains sur les joues ; les jambes sont pliées et font des
                    -- va-et-vient en alternance (une monte quand l'autre descend). Vitesse : bloc "Vitesse par animation".
                    local sw = min(swing, 1.5)
                    local bd = V(0, 0.42, 1).Unit                                          -- direction du corps (à plat ventre, appuyé sur les coudes : poitrine relevée)
                    hip = V(0, YF + 1.0, -4.0)
                    neck = hip + bd * 7.5 + V(0, 0.12 * sin(fp * 0.4), 0)                  -- respiration
                    head = neck + V(0.22 * sin(fp * 0.3), 2.3 + 0.05 * sin(fp * 0.4), 1.0) -- la tête se balance doucement
                    armFn = function(side, S)
                        local F = V(side * 1.4 * spread, head.Y - 0.3, head.Z)             -- main posée sur la joue, coude au sol
                        return _EmoteX.IK(S, F, 3.4, 2.1, V(side * 0.5, -1, 0)), F
                    end
                    legFn = function(side, H)
                        local s = sin(fp * 1.2 + (side > 0 and math.pi or 0))              -- jambes en opposition de phase
                        local beta = rad(12) + rad(8) * sw * s                              -- cuisse, à peine levée
                        local alpha = rad(55) + rad(40) * min(sw, 1.2) * s                  -- jambe : presque à plat -> à la verticale
                        local K = H + V(0, sin(beta), -cos(beta)) * 2.6
                        return K, K + V(0, sin(alpha), -cos(alpha)) * 2.6
                    end

                elseif anim == "Escalade" then
                    -- 🧗 Escalade : (1) escalade du mur = bras ET jambes bien écartés qui alternent en diagonale (main droite + pied gauche,
                    -- puis l'inverse) pendant que le corps monte ; (2) accroche du rebord, traction, genou sur le rebord, redressement.
                    -- Repère local : x = droite, y = haut, z = vers le MUR. Les valeurs hy/hz/ly/ph/wallW viennent du suivi du mur (_G._FigureClimb).
                    local C = _G._FigureClimb or {}
                    local climbing = (C.state == "climb")
                    local c = climbing and math.clamp(C.c or 0, 0, 1) or 0
                    local m  = smooth((c - 0.38) / 0.30)          -- mantle : un genou monte sur le rebord, buste penché
                    local sd = smooth((c - 0.68) / 0.32)          -- on se redresse sur le rebord
                    local rel = 1 - (C.grip or 1)                 -- 0 = mains agrippées, 1 = mains relâchées
                    local ww = C.wallW or 0                       -- 1 = escalade du mur (membres écartés)
                    local ph = C.ph or 0                          -- phase de grimpe (avance avec la hauteur gagnée)
                    local wz = C.wzNow or 1.7                     -- plan du mur dans le repère local
                    local sty = C.sty or {}                       -- style choisi dans le dropdown "Style d'escalade"
                    local swx = (sty.sway or 0.45) * sin(ph) * ww                       -- le bassin se déporte vers le côté qui pousse
                    local lean = rad(26) * m * (1 - sd) + rad(sty.lean or 9) * ww
                    local dT = V(0, cos(lean), sin(lean))
                    hip = V(0.12 * sin(fp * 1.6) * (1 - m) * (1 - ww) + swx, -9 + 0.3 * ww * sin(2 * ph + 1.0), 0.35 * m * (1 - sd) + 0.45 * ww)
                    neck = hip + dT * 7.5 + V(-0.55 * swx, 0, 0)                        -- épaules en contre-rotation (le buste se tord un peu)
                    head = hip + dT * 9 + V(-0.75 * swx, 0.5 * ww, 0.5 * (1 - m) - 0.3 * ww)   -- la tête se lève vers le haut du mur
                    -- 🧗 Cycle d'un membre (0 -> 1 = tendu vers le haut) : il monte vite et en douceur pour chercher une prise (42 % du cycle),
                    -- puis redescend lentement par rapport au corps PENDANT que le corps monte (c'est l'appui / la traction).
                    local function _cyc(u)
                        u = u - math.floor(u)
                        if u < 0.42 then return smooth(u / 0.42) end
                        return 1 - (u - 0.42) / 0.58
                    end
                    -- le membre qui change de prise se décolle du mur (0 = posé, 1 = décollé au maximum), les autres restent plaqués
                    local function _lift(u)
                        u = u - math.floor(u)
                        if u < 0.42 then return sin(math.pi * u / 0.42) end
                        return 0
                    end
                    local pc = ph / (2 * math.pi)
                    armFn = function(side, S)
                        local ua = pc + (side > 0 and 0 or 0.5)                           -- bras en opposition
                        local Fg = V(side * 1.3 * spread + 0.2 * sin(fp * 2.2 + side) * (1 - m), C.hy or 1.7, C.hz or (wz - 0.3))
                        local Fw = V(side * (sty.armX or 3.1) * spread, (sty.armLo or 0.65) + (sty.armAmp or 1.15) * (2 * _cyc(ua) - 1), wz - 0.3 - 0.9 * _lift(ua))
                        local Fd = V(side * 1.2 * spread, -8.2, 0.2)
                        local F = Fg:Lerp(Fw, ww):Lerp(Fd, rel)
                        local pole = V(side * 1.0, -0.6, -0.7):Lerp(V(side * 1.0, -0.1, -0.4), ww):Lerp(V(side * 0.6, 0, -1), rel)
                        return _EmoteX.IK(S, F, 3.4, 2.1, pole), F
                    end
                    legFn = function(side, H)
                        local ul = pc + (side > 0 and 0.7 or 0.2)                         -- diagonale : le pied gauche suit la main droite (et inversement)
                        local scr = sin(fp * 2.2 + (side > 0 and 0 or math.pi))
                        local Fa = V(side * 0.95 * spread, -12.2 + 1.0 * scr * (1 - m), wz - 0.5)
                        local Fsp = V(side * (sty.legX or 3.0) * spread, -12.0 + (sty.legAmp or 1.3) * (2 * _cyc(ul) - 1), wz - 0.5 - 0.7 * _lift(ul))
                        local Fm
                        if side > 0 then
                            Fm = V(0.9 * spread, C.ly or -9.5, wz + 1.1)                  -- le pied monte se poser sur le rebord
                        else
                            Fm = V(-0.9 * spread, -13.0, wz - 0.5)                        -- l'autre pousse encore contre le mur
                        end
                        local Fs = V(side * 0.9 * spread, YF, 0)
                        local F = Fa:Lerp(Fsp, ww):Lerp(Fm, m):Lerp(Fs, sd)
                        return _EmoteX.IK(H, F, 2.6, 2.6, V(side * 0.7 * ww, 0.3, 1)), F   -- genoux vers le mur, légèrement écartés
                    end

                elseif anim == "Assis chaise" then
                    -- 🪑 Assis sur une chaise (pas par terre) : bassin surélevé, cuisses à l'horizontale, pieds au sol,
                    -- mains sur les cuisses, légère respiration, un pied qui tape doucement
                    local br = sin(os.clock() * 1.8) * 0.08
                    local phi = rad(4)
                    local dT = V(0, cos(phi), sin(phi))
                    hip = V(0, YF + 2.7, -1.0)
                    neck = hip + dT * 7.5 + V(0, br, 0)
                    head = hip + dT * 9 + V(0, br * 1.5, 0)
                    local footZ, kPole = 1.8, V(0, 1, 0.3)
                    local tap = max(0, sin(fp * 1.6)) * 0.6 * min(swing, 1.5)
                    legFn = function(side, H)
                        local F = V(side * 1.2 * spread, YF + (side > 0 and tap or 0), footZ)
                        return _EmoteX.IK(H, F, 2.6, 2.6, kPole), F, (_animBlend.flatFeet and 0 or nil)
                    end
                    armFn = function(side, S)
                        local Hh = hip + V(side * 0.8 * spread, 0, 0)
                        local K = _EmoteX.IK(Hh, V(side * 1.2 * spread, YF, footZ), 2.6, 2.6, kPole)
                        local hand = K + V(side * 0.1, 0.9, -1.0)
                        return _EmoteX.IK(S, hand, 3.4, 2.1, V(side * 1, -0.2, -0.6)), hand
                    end

                elseif anim == "Révérence" then
                    -- 🙇 Révérence : le buste s'incline vers l'avant (pause en bas) puis se redresse, les bras suivent
                    local a = smooth(min(1, max(0, (1 - cos(fp * 0.5)) * 0.75)))
                    local phi = rad(62) * a
                    local dT = V(0, cos(phi), sin(phi))
                    hip = V(0, -9, -0.3 * a)
                    neck = hip + dT * 7.5
                    head = hip + dT * 9 + V(0, -0.4 * a, 0.3 * a)
                    armFn = function(side, S)
                        return straightArm(S, V(side * 0.1, -cos(phi * 0.45), 0.12 + sin(phi * 0.75) * 0.9))
                    end
                    legFn = plantedLegs(0.9, 0)

                elseif anim == "Boxe" then
                    -- 🥊 Boxe : garde, jambes décalées, petit rebond, les deux poings frappent en alternance
                    local bounce = sin(fp * 2.2) * 0.12
                    hip = V(0, -9.8 + bounce, 0)
                    neck = V(0, -2.3 + bounce, 0.5)
                    head = V(0, -0.8 + bounce, 0.7)
                    armFn = function(side, S)
                        local e = smooth(max(0, sin(fp * 1.6 + (side > 0 and 0 or math.pi))))
                        local F = V(side * 1.0, -2.0, 2.8):Lerp(V(side * 0.5, -2.9, 5.3), e)
                        return _EmoteX.IK(S, F, 3.4, 2.1, V(side * 0.4, -1, -0.1)), F
                    end
                    legFn = function(side, H)
                        local F = V(side * 1.5 * spread, YF, side > 0 and 1.8 or -1.8)
                        return _EmoteX.IK(H, F, 2.6, 2.6, V(0, 0.2, 1)), F, (_animBlend.flatFeet and 0 or nil)
                    end

                elseif anim == "Jogging sur place" then
                    -- 🏃 Jogging sur place : genoux qui montent en alternance, bras qui pompent, petit rebond
                    local sw = min(swing, 1.5)
                    local w = fp * 1.5
                    hip = V(0, -9.45 + 0.3 * abs(sin(w)), 0)
                    local phi = rad(7)
                    local dT = V(0, cos(phi), sin(phi))
                    neck = hip + dT * 7.5
                    head = hip + dT * 9
                    armFn = function(side, S)
