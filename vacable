    -- 💾 SAUVEGARDE DES RÉGLAGES (Animated Figure) : tous les réglages "Figure..." en un preset nommé
    -- =========================================================================
    do
        local FPBlock = Tabs.Fun:CreateBlock({ Name = "💾 Réglages Animated Figure", Side = "Right" })
        local HSP = game:GetService("HttpService")
        local FP_FOLDER = "HelperOther_FigurePresets"
        local fpName, fpSel, fpDrop = "MonStickMan", nil, nil
        pcall(function() if not isfolder(FP_FOLDER) then makefolder(FP_FOLDER) end end)

        local function fpClean(n)
            n = tostring(n or ""):gsub("[^%w%-_ ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
            if n:sub(1, 1) == "_" then n = n:sub(2) end
            return n
        end

        local function fpList()
            local list = {}
            pcall(function()
                if isfolder(FP_FOLDER) then
                    for _, f in ipairs(listfiles(FP_FOLDER)) do
                        local name = f:match("([^/\\]+)%.json$")
                        if name and name:sub(1, 1) ~= "_" then table.insert(list, name) end
                    end
                end
            end)
            table.sort(list)
            return list
        end

        -- seuls les flags "Figure..." sont concernés (les touches / keybinds sont exclues : non sérialisables)
        local function fpIsFlag(flag)
            return type(flag) == "string" and flag:sub(1, 6) == "Figure" and not flag:find("Key", 1, true)
        end

        local function fpSave(name)
            local data, n = {}, 0
            for flag, value in pairs(Library.Flags) do
                local tv = type(value)
                if fpIsFlag(flag) and (tv == "number" or tv == "string" or tv == "boolean") then
                    data[flag] = value
                    n = n + 1
                end
            end
            local ok = pcall(function()
                if not isfolder(FP_FOLDER) then makefolder(FP_FOLDER) end
                writefile(FP_FOLDER .. "/" .. name .. ".json", HSP:JSONEncode(data))
            end)
            return ok, n
        end

        local function fpLoad(name)
            local ok, data = pcall(function() return HSP:JSONDecode(readfile(FP_FOLDER .. "/" .. name .. ".json")) end)
            if not ok or type(data) ~= "table" then return false, 0 end
            local n = 0
            for flag, value in pairs(data) do
                if fpIsFlag(flag) and Library.Items and Library.Items[flag] then
                    if pcall(function() Library.Items[flag].Set(value) end) then n = n + 1 end
                end
            end
            return true, n
        end

        FPBlock:CreateInput({ Name = "Nom du preset", Flag = "Settings_FPName", Default = "MonStickMan", Placeholder = "ex: MonStickMan",
            Callback = function(v) fpName = fpClean(v) end })
        FPBlock:CreateButton({ Name = "💾 Sauvegarder les réglages",
            Callback = function()
                local name = fpClean(fpName)
                if name == "" then notify("Réglages Figure", "Entre un nom valide.", 3) return end
                local ok, n = fpSave(name)
                if not ok then notify("Réglages Figure", "Écriture impossible (writefile ?).", 3) return end
                fpSel = name
                notify("Réglages Figure", name .. " sauvegardé (" .. n .. " réglages).", 3)
                if fpDrop then fpDrop:Refresh(fpList(), false) end
            end })
        fpDrop = FPBlock:CreateDropdown({ Name = "Presets", Flag = "Settings_FPSel", Items = fpList(), Default = nil,
            UpdateList = function() return fpList() end,
            Callback = function(v) if v and v ~= "" then fpSel = v end end })
        FPBlock:CreateButton({ Name = "📂 Charger le preset",
            Callback = function()
                local sel = fpSel or (fpDrop and fpDrop:Get())
                if not sel then notify("Réglages Figure", "Sélectionne un preset.", 3) return end
                local ok, n = fpLoad(sel)
                if not ok then notify("Réglages Figure", "Fichier introuvable ou corrompu.", 3) return end
                notify("Réglages Figure", sel .. " chargé (" .. n .. " réglages).", 3)
            end })
        FPBlock:CreateButton({ Name = "🗑️ Supprimer le preset",
            Callback = function()
                local sel = fpSel or (fpDrop and fpDrop:Get())
                if not sel then notify("Réglages Figure", "Sélectionne un preset.", 3) return end
                local path = FP_FOLDER .. "/" .. sel .. ".json"
                if isfile(path) then
                    delfile(path)
                    if fpSel == sel then fpSel = nil end
                    notify("Réglages Figure", sel .. " supprimé.", 2)
                    if fpDrop then fpDrop:Refresh(fpList(), false) end
                end
            end })
    end

