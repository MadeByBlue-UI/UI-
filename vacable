                                            -- Vérifie si ce toy fait partie de la flèche
                                            if useArrow and textIndex <= arrowToys then
                                                -- 🏹 FORMATION TRIANGLE ÉLARGI : ------>
                                                
                                                local forwardDistance = letterWidth * 4  -- Distance devant le texte (plus loin)
                                                local arrowX, arrowY, arrowZ
                                                
                                                -- Hauteur standardisée pour éviter le bancal
                                                local standardHeight = letterHeight * 0.5
                                                
                                                if arrowToys >= 12 then
                                                    -- 🔺 TRIANGLE COMPLET (12-15 toys)
                                                    if textIndex == 1 then
