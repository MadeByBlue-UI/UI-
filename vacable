                                                    foundSeg = allSegments[1]
                                                    foundT = 0
                                                end
                                                
                                                if foundSeg then
                                                    local x = foundSeg.x1 + (foundSeg.x2 - foundSeg.x1) * foundT
                                                    local y = foundSeg.y1 + (foundSeg.y2 - foundSeg.y1) * foundT
                                                    
                                                    -- 🎢 EFFET BOUNCE (2 types : Individual ou Letter)
                                                    local bounceOffset = 0
                                                    if tornadoTextBounce and tornadoTextBounceSpeed > 0 then
                                                        local waveTime = tick() * tornadoTextBounceSpeed
                                                        
                                                        if tornadoTextBounceType == "Individual" then
                                                            -- Bounce individual : chaque toy bounce indépendamment
                                                            local wavePhase = waveTime + (textIndex * 0.3)  -- Décalage par toy
                                                            bounceOffset = math.abs(math.sin(wavePhase)) * letterHeight * 0.3
                                                        elseif tornadoTextBounceType == "Letter" then
                                                            -- Bounce par lettre : utilise l'index de caractère du segment
                                                            local letterPhase = waveTime + ((foundSeg.charIndex or 1) * 0.8)  -- Phase par lettre réelle
                                                            bounceOffset = math.abs(math.sin(letterPhase)) * letterHeight * 0.4  -- Bounce plus marqué
                                                        end
                                                    end
                                                    
                                                    -- 🔄 CALCUL DE LA ROTATION du toy selon l'angle du segment (SIMPLIFIÉ)
                                                    local segmentAngle = 0
                                                    local dx = foundSeg.x2 - foundSeg.x1
                                                    local dy = foundSeg.y2 - foundSeg.y1
                                                    local distSq = dx * dx + dy * dy
                                                    
                                                    if distSq > 0.000001 then  -- Évite atan2 si segment trop petit
                                                        segmentAngle = math.atan2(dy, dx)
                                                    end
                                                    
                                                    local localPos = Vector3.new(x, y + textOffsetY + bounceOffset, 0)
                                                    targetPos = centerPos + (rotCFrame * localPos)
                                                    
                                                    -- 🎯 APPLIQUE LA ROTATION du segment au toy
                                                    targetCF = CFrame.new(targetPos) * CFrame.Angles(0, segmentAngle, 0)
                                                else
                                                    -- Fallback : cache le toy
                                                    local localPos = Vector3.new(0, -1000, 0)
                                                    targetPos = centerPos + (rotCFrame * localPos)
                                                    targetCF = CFrame.new(targetPos)
                                                end
                                            end
                                        else
                                            -- Pas de segments (espace ou caractère invalide)
                                            local localPos = Vector3.new(0, -1000, 0)
                                            targetPos = centerPos + (rotCFrame * localPos)
                                            targetCF = CFrame.new(targetPos)
                                        end
                                        
                                        end  -- Fin du else (texte vide vs texte normal)
                                    
                                    elseif tornadoFormation == "Dragon" then
                                        -- 🐉 FORMATION DRAGON - Tête + Corps serpentin + Ailes + Queue
                                        local dragonLength = 60
                                        local numToys = #toys
                                        
                                        -- Répartition: 15% tête, 15% ailes, 70% corps+queue
                                        local headToys = math.floor(numToys * 0.15)
                                        local wingToys = math.floor(numToys * 0.15)
                                        local bodyToys = numToys - headToys - wingToys
                                        
                                        if i <= headToys then
                                            -- 🐲 TÊTE DU DRAGON (grosse et intimidante)
                                            local headProgress = (i - 1) / headToys
                                            local headSize = 8
                                            
                                            -- Forme pyramidale pour la tête
                                            local layer = math.floor(headProgress * 3)
                                            local inLayer = (headProgress * 3) % 1
                                            
                                            local x = math.cos(inLayer * math.pi * 2) * (headSize * (1 - layer / 3))
                                            local y = tornadoHeight + dragonLength * 0.8 + layer * 3
                                            local z = dragonLength * 0.9 + math.sin(inLayer * math.pi * 2) * (headSize * (1 - layer / 3))
                                            
                                            targetPos = centerPos + (rotCFrame * Vector3.new(x, y, z))
                                        
                                        elseif i <= headToys + wingToys then
                                            -- 🦅 AILES DU DRAGON (déployées sur les côtés)
                                            local wingIndex = i - headToys
                                            local wingProgress = (wingIndex - 1) / wingToys
                                            local isLeftWing = wingIndex <= wingToys / 2
                                            local wingLocalProgress = isLeftWing and (wingProgress * 2) or ((wingProgress - 0.5) * 2)
                                            
                                            local wingSpan = 25  -- Envergure
                                            local wingHeight = 15
                                            
                                            -- Forme d'aile courbe
                                            local side = isLeftWing and -1 or 1
                                            local x = side * (5 + wingLocalProgress * wingSpan)
                                            local y = tornadoHeight + dragonLength * 0.6 + math.sin(wingLocalProgress * math.pi) * wingHeight
                                            local z = dragonLength * 0.7 - wingLocalProgress * 10
                                            
