    local function startAntiGucci_Apex()
        if not AntiGucciState.autoGucciActive then return end
        if AntiGucciState.isRespawning then return end
        if tick() - AntiGucciState.respawnCooldown < 0.5 then return end
        
        AntiGucciState.isRespawning = true
        AntiGucciState.respawnCooldown = tick()
        AntiGucciState.char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        AntiGucciState.hum = FWC_Apex(AntiGucciState.char, 'Humanoid')
        AntiGucciState.hrp = FWC_Apex(AntiGucciState.char, 'HumanoidRootPart')
        
        if not AntiGucciState.hum or not AntiGucciState.hrp then
            AntiGucciState.isRespawning = false
            return
        end
        
        AntiGucciState.safePosition = AntiGucciState.hrp.Position
        AntiGucciState.folder = workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
        
        if AntiGucciState.folder then
            for _, toy in ipairs(AntiGucciState.folder:GetChildren()) do
                if toy.Name == 'CreatureBlobman' or toy.Name == 'Gucci' then
                    pcall(function()
                        if DestroyToy then DestroyToy:FireServer(toy) end
                    end)
                end
            end
            task.wait(0.05)
        end
        
        local struggleEvent = ReplicatedStorage:FindFirstChild('CharacterEvents') and ReplicatedStorage.CharacterEvents:FindFirstChild('Struggle')
        if struggleEvent then
            for i = 1, 5 do
                pcall(function()
                    struggleEvent:FireServer()
                end)
                task.wait(0.02)
            end
        end
        
        AntiGucciState.Blob = toy_spawn_Apex()
        if not AntiGucciState.Blob then
            AntiGucciState.isRespawning = false
            return
        end
        
        AntiGucciState.Seat = FWC_Apex(AntiGucciState.Blob, 'VehicleSeat')
        
        task.spawn(function()
            AntiGucciState.BHead = FWC_Apex(AntiGucciState.Blob, 'Head')
            AntiGucciState.HitBox = FWC_Apex(AntiGucciState.Blob, 'GrabbableHitbox')
            
            if AntiGucciState.BHead and AntiGucciState.HitBox then
                while AntiGucciState.autoGucciActive and AntiGucciState.Blob and AntiGucciState.Blob.Parent do
                    local partOwner = AntiGucciState.BHead:FindFirstChild('PartOwner')
                    if not partOwner or (partOwner and partOwner.Value ~= LocalPlayer.Name) then
                        task.spawn(grab_Apex, AntiGucciState.HitBox)
                    else
                        break
                    end
                    task.wait()
                end
            end
        end)
        
        AntiGucciState.autoGucciT = true
        
        task.defer(function()
            if not (AntiGucciState.char or AntiGucciState.hum) then return end
            local startTime = tick()
            
            while AntiGucciState.autoGucciT and AntiGucciState.autoGucciActive and (tick() - startTime < 0.175) do
                if AntiGucciState.Blob and AntiGucciState.Seat and AntiGucciState.Seat.Occupant ~= AntiGucciState.hum then
                    AntiGucciState.Seat:Sit(AntiGucciState.hum)
                end
                
                task.wait(0.35)
                
                if AntiGucciState.char and AntiGucciState.hum then
                    AntiGucciState.hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
                
                task.wait(0.35)
            end
            
            AntiGucciState.autoGucciT = false
        end)
        
        if AntiGucciState.antiGucciConnection then
            AntiGucciState.antiGucciConnection:Disconnect()
        end
        
        AntiGucciState.antiGucciConnection = RunService.Heartbeat:Connect(function()
            if not AntiGucciState.hrp or not AntiGucciState.hum or not AntiGucciState.autoGucciActive then
                return
            end
            
            pcall(function()
                if Ragdoll then
                    Ragdoll:FireServer(AntiGucciState.hrp, 0)
                end
            end)
            
            if AntiGucciState.restoreFrames > 0 then
                AntiGucciState.hrp.CFrame = CFrame.new(AntiGucciState.safePosition)
                AntiGucciState.restoreFrames = AntiGucciState.restoreFrames - 1
            end
        end)
        
        task.wait(0.5)
        
        if AntiGucciState.hum and AntiGucciState.Blob then
            AntiGucciState.oldPosition = AntiGucciState.safePosition
            AntiGucciState.hum.Sit = false
            AntiGucciState.Blob.Name = 'Gucci'
            
            if AntiGucciState.antiGucciConnection then
                AntiGucciState.antiGucciConnection:Disconnect()
                AntiGucciState.antiGucciConnection = nil
            end
            
            task.wait(0.1)
            
            local seat = AntiGucciState.Blob:FindFirstChild('VehicleSeat')
            if seat then
                seat:Destroy()
            end
            
            AntiGucciState.BlobHRP = AntiGucciState.Blob:FindFirstChild('HumanoidRootPart')
            
            if AntiGucciState.BlobHRP then
                AntiGucciState.grabEvent = ReplicatedStorage:FindFirstChild('GrabEvents') and ReplicatedStorage.GrabEvents:FindFirstChild('SetNetworkOwner')
                
                if AntiGucciState.grabEvent then
                    pcall(function()
                        AntiGucciState.grabEvent:FireServer(AntiGucciState.BlobHRP, AntiGucciState.BlobHRP.CFrame)
                    end)
                end
                
                task.wait(0.1)
                
                if AntiGucciState.blobFlyConnection then
                    AntiGucciState.blobFlyConnection:Disconnect()
                end
                
                AntiGucciState.blobFlyConnection = RunService.Heartbeat:Connect(function()
                    if not AntiGucciState.autoGucciActive or not AntiGucciState.BlobHRP or not AntiGucciState.BlobHRP.Parent then
                        if AntiGucciState.BlobHRP and AntiGucciState.BlobHRP.Parent then
                            AntiGucciState.BlobHRP.AssemblyLinearVelocity = Vector3.zero
                            AntiGucciState.BlobHRP.AssemblyAngularVelocity = Vector3.zero
                        end
                        return
                    end
                    
                    AntiGucciState.BlobHRP.CFrame = AntiGucciState.hrp.CFrame * CFrame.new(0, 9e9, 0)
                    AntiGucciState.BlobHRP.AssemblyLinearVelocity = Vector3.new(0, 9e9, 0)
                    AntiGucciState.BlobHRP.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
        
        AntiGucciState.isRespawning = false
    end
    
