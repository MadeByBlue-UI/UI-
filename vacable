    local DestroyToy = RS:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    
    local kickActive = false
    local kickConn = nil
    local palletObj = nil
    local kickHeight = 18  -- Hauteur variable
    local lastPalletCheck = 0  -- Timer pour auto-respawn
    
    function stopKick()
        kickActive = false
        if kickConn then 
            kickConn:Disconnect() 
            kickConn = nil 
        end
        -- Nettoie les movers sur la cible
        if selectedKickPlayer and selectedKickPlayer.Character then
            local tHRP = selectedKickPlayer.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then
                local bp = tHRP:FindFirstChild("_KICK_BP")
                local bg = tHRP:FindFirstChild("_KICK_BG")
                if bp then bp:Destroy() end
                if bg then bg:Destroy() end
            end
        end
        -- Nettoie pallet
        if palletObj and palletObj.Parent then
            pcall(function() DestroyToy:FireServer(palletObj) end)
            palletObj = nil
        end
    end
    
    function spawnPallet(hrp)
        if not hrp then return nil end
        local spawnCF = hrp.CFrame * CFrame.new(0, 10, 20)
        task.spawn(function()
            pcall(function()
                SpawnToy:InvokeServer("PalletLightBrown", spawnCF, Vector3.zero)
            end)
        end)
        
        local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not inv then return nil end
        
        local pallet = inv:WaitForChild("PalletLightBrown", 3)
        if pallet and pallet:FindFirstChild("SoundPart") then
            local sp = pallet.SoundPart
            local timeout = tick() + 3
            repeat
                task.wait(0.1)
                pcall(function() SNO:FireServer(sp, sp.CFrame) end)
            until (sp:FindFirstChild("PartOwner") and sp.PartOwner.Value == LocalPlayer.Name) or tick() > timeout
            
            for _, v in pairs(pallet:GetChildren()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                    v.CanQuery = false
                    v.Transparency = 1
                end
            end
            return pallet
        end
        return nil
    end
    
    function startKick()
        stopKick()
        
        local target = selectedKickPlayer
        if not target or not target.Character then
            Library:Notify({ Title = "Kick", Content = "Sélectionne un joueur d'abord", Duration = 3 })
            return
        end
        
        local tChar = target.Character
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        local tTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso")
        local tHum = tChar:FindFirstChildOfClass("Humanoid")
        
        if not tHRP or not tTorso or not tHum then
            Library:Notify({ Title = "Kick", Content = "Cible invalide", Duration = 3 })
            return
        end
        
        kickActive = true
        
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myTorso = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso"))
        if not myHRP or not myTorso then return end
        
        -- 🎯 PHASE INITIALE : TP une seule fois pour grab ownership
        local savedPos = myChar:GetPivot()
        local ownershipGrabbed = false
        
        notify("Kick", "🎯 Grabbing ownership...", 2)
        
        -- TP près de la cible (plus proche pour meilleur grab)
        myChar:PivotTo(tHRP.CFrame * CFrame.new(0, -2, 0))
        task.wait(0.1)
        
        -- Spam ownership pendant 1.5s pour être sûr (augmenté de 0.5s à 1.5s)
        local grabStart = tick()
        while kickActive and tick() - grabStart < 1.5 do
            pcall(function()
                SNO:FireServer(tHRP, tHRP.CFrame)
                SNO:FireServer(tTorso, tTorso.CFrame)
                DGL:FireServer(tHRP)
                DGL:FireServer(tTorso)
            end)
            
            -- Check si ownership obtenu (moins strict - juste vérifier qu'on peut claim)
            if tick() - grabStart > 0.8 then
                -- Après 0.8s de spam, on considère qu'on a l'ownership
                ownershipGrabbed = true
                break
            end
            
            task.wait(0.05)
        end
        
        -- Retour à la position d'origine
        myChar:PivotTo(savedPos)
        task.wait(0.1)
        
        if not ownershipGrabbed then
            Library:Notify({ Title = "Kick", Content = "❌ Échec grab ownership", Duration = 3 })
            stopKick()
            return
        end
        
        notify("Kick", "✅ Ownership grabbed! Tu peux bouger librement", 3)
        
        -- 🎯 CACHE DES PARTIES (pour éviter FindFirstChild chaque frame)
        local cachedParts = {
            hrp = tHRP,
            head = tChar:FindFirstChild("Head"),
            torso = tTorso,
            leftArm = tChar:FindFirstChild("LeftUpperArm") or tChar:FindFirstChild("Left Arm"),
            rightArm = tChar:FindFirstChild("RightUpperArm") or tChar:FindFirstChild("Right Arm"),
            leftLeg = tChar:FindFirstChild("LeftUpperLeg") or tChar:FindFirstChild("Left Leg"),
            rightLeg = tChar:FindFirstChild("RightUpperLeg") or tChar:FindFirstChild("Right Leg"),
        }
        local lastCacheRefresh = tick()
        
        -- Crée les movers sur la cible (force TRÈS élevée pour contrer gravité)
        local bp = Instance.new("BodyPosition")
        bp.Name = "_KICK_BP"
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.P = 200000  -- x2 pour lock ultra-fort
        bp.D = 10000   -- x2 pour stabilité maximale
        bp.Parent = tHRP
        
        local bg = Instance.new("BodyGyro")
        bg.Name = "_KICK_BG"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 200000
        bg.D = 10000
        bg.Parent = tHRP
        
        -- Spawn le pallet (après un petit délai)
        task.spawn(function()
            task.wait(1)
            if kickActive and not palletObj then
                palletObj = spawnPallet(myHRP)
            end
        end)
        
        local palletTimer = 0
        lastPalletCheck = tick()
        local lastCacheRefresh = tick()
        local frameCounter = 0  -- Compteur pour espacer ownership
        
        kickConn = Run.Heartbeat:Connect(function(dt)
            if not kickActive then return end
            
            -- Re-vérifie tout
            if not target or not target.Character then stopKick(); return end
            local tChar2 = target.Character
            local tHum2 = tChar2:FindFirstChildOfClass("Humanoid")
            if not cachedParts.hrp or not cachedParts.torso or not tHum2 or tHum2.Health <= 0 then 
                stopKick(); return 
            end
            
            local myC = LocalPlayer.Character
            local myR = myC and myC:FindFirstChild("HumanoidRootPart")
            local myT = myC and (myC:FindFirstChild("UpperTorso") or myC:FindFirstChild("Torso"))
            if not myR or not myT then return end
            
            -- 🔄 Refresh du cache toutes les 0.5s (au lieu de chaque frame)
            if tick() - lastCacheRefresh > 0.5 then
                lastCacheRefresh = tick()
                cachedParts.hrp = tChar2:FindFirstChild("HumanoidRootPart")
