            pcldOutlineSize = v / 100
            for _, d in pairs(pcldItems) do
                if d.outline then d.outline.LineThickness = pcldOutlineSize end
            end
        end,
    })

    PCLDBlock:CreateSlider({
        Name     = "Smooth (1=lent, 20=rapide)",
        Flag     = "PCLDSmooth",
        Min      = 1, Max = 20, Default = 10,
