        local AnchoredObjects = {}
        local anchorToysKey   = Enum.KeyCode.G
        local unAnchorToysKey = Enum.KeyCode.H

        -- Effet visuel + son quand on ancre
        local _Attachment      = Instance.new("Attachment")
