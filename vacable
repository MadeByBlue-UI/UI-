        -- appelé à chaque frame par FG.buryStep (style « Grande cérémonie » seulement)
        function FG.buryBigStep(B, e, tA, tHit)
            local fx = B.fx
            if not fx then return end
            local base = Vector3.new(B.x, B.gy, B.z)
            if e >= tA and not fx.cStarted then
                fx.cStarted = true
                FG.buryCircle(B)
                FG.camShake(0.18, math.max(tHit - tA, 0.3))      -- grondement pendant le regard
            end
            if fx.circle and fx.circle.Parent and not fx.began then
                fx.circle.Transparency = 0.4 + 0.2 * math.sin(e * 9)
            end
            if e >= tHit and not fx.began then
                fx.began = true
                FG.buryBigBegin(B)
            end
            if not fx.began then return end
            local k, ez = B.k or 0, B.ez or 0
            if k < 1 then
                if fx.em then fx.em.Rate = 70 * (1 - ez) + 25 end
                if e - (fx.lastRing or 0) > 0.7 then
                    fx.lastRing = e
                    FG.ringFx(base, fx.col, 14 + 10 * (1 - ez), 0.7)
                    FG.camShake(0.35 * (1 - ez) + 0.1, 0.2)
                    FG.debrisFx(base, fx.col, 5)
                end
            end
            if ez >= 0.97 and not fx.tomb then FG.buryTomb(B) end
            if k >= 1 and fx.em and fx.em.Enabled then fx.em.Enabled = false end
        end

        -- nettoyage (la tombe reste quelques secondes après la fin, puis s'efface)
