-- OBJECT WALLWALK SYSTEM (Système complet depuis Objectwallwalk)
-- =========================================================================
function _OWWProject(v, n) 
    return v - n * v:Dot(n) 
end

function _OWWSafeUnit(v, fallback)
    if v.Magnitude > 1e-4 then return v.Unit end
    return fallback
end

local _ObjectWallWalkCFG = {
    ToggleKey     = Enum.KeyCode.G,
    ProbeLength   = 8,
    ForwardProbe  = 5,
    EdgeReach     = 5,
    StickGain     = 12,
    TurnSpeed     = 10,
    FaceSpeed     = 12,
    JumpPower     = 45,
    DetachTime    = 0.25,
    MouseSens     = 0.004,
    CamDist       = 16,
    CamHeight     = 3,
    AirControl    = 0.6,
}

local _OWWClass = {}
_OWWClass.__index = _OWWClass

function _OWWClass.new(targetPart, ctrlState)
    local self = setmetatable({}, _OWWClass)
    self.part = targetPart
    self.ctrl = ctrlState
    self.enabled = false
    self.up = Vector3.yAxis
    self.fwd = Vector3.zAxis
    self.face = Vector3.zAxis
    self.pitch = 0.35
    self.dist = _ObjectWallWalkCFG.CamDist
    self.detach = 0
    self.grounded = false
    self.vel = Vector3.zero
    self.hover = math.max(targetPart.Size.X, targetPart.Size.Y, targetPart.Size.Z) * 0.5 + 0.3
    self.conns = {}
    self.params = nil
    return self
end

function _OWWClass:_params()
    local filter = { self.part }
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    local parent = self.part.Parent
    if parent and parent:IsA("Model") then table.insert(filter, parent) end

    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.RespectCanCollide = true
    p.FilterDescendantsInstances = filter
    return p
end

function _OWWClass:enable()
    if self.enabled then return end
    self.enabled = true
    self.up = Vector3.yAxis
    self.vel = Vector3.zero
    self.detach = 0

    local cam = workspace.CurrentCamera
    local look = _OWWProject(cam.CFrame.LookVector, self.up)
    self.fwd = _OWWSafeUnit(look, Vector3.zAxis)
    self.face = self.fwd
    cam.CameraType = Enum.CameraType.Scriptable
end

function _OWWClass:disable()
    if not self.enabled then return end
    self.enabled = false
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom
    self.up = Vector3.yAxis
end

function _OWWClass:destroy()
    self:disable()
    for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end
    table.clear(self.conns)
end

function _OWWClass:_probe(pos, moveDir)
    local up = self.up
    local moving = moveDir.Magnitude > 0.1

    if moving then
        local r = Workspace:Raycast(pos, moveDir * _ObjectWallWalkCFG.ForwardProbe, self.params)
        if r and r.Normal:Dot(up) < 0.9 then
            return r.Normal, r.Distance, "inner"
        end
    end

    local down = Workspace:Raycast(pos, -up * _ObjectWallWalkCFG.ProbeLength, self.params)
    if down then
        return down.Normal, down.Distance, "ground"
    end

    if moving then
        local origin = pos - up * (self.hover + 1.5)
        local r = Workspace:Raycast(origin, -moveDir * _ObjectWallWalkCFG.EdgeReach, self.params)
        if r then
            return r.Normal, r.Distance, "outer"
        end
    end

    return nil, nil, nil
end

function _OWWClass:step(dt, bv, bg, speed)
    local part = self.part
    local cam = workspace.CurrentCamera
    local pos = part.Position
    local up = self.up
    self.params = self:_params()

    local rmb = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    UserInputService.MouseBehavior = rmb and Enum.MouseBehavior.LockCurrentPosition
        or Enum.MouseBehavior.Default
    local d = UserInputService:GetMouseDelta()
    if rmb then
        self.fwd = CFrame.fromAxisAngle(up, -d.X * _ObjectWallWalkCFG.MouseSens):VectorToWorldSpace(self.fwd)
        self.pitch = math.clamp(self.pitch + d.Y * _ObjectWallWalkCFG.MouseSens, -0.2, 1.3)
    end

    function key(k) return UserInputService:IsKeyDown(k) and 1 or 0 end
    local x = key(Enum.KeyCode.D) - key(Enum.KeyCode.A)
    local z = key(Enum.KeyCode.W) - key(Enum.KeyCode.S)

    local fwd = _OWWSafeUnit(_OWWProject(self.fwd, up), self.face)
    self.fwd = fwd
    local right = fwd:Cross(up)

    local moveDir = fwd * z + right * x
    if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end

    local normal, dist, kind = self:_probe(pos, moveDir)
    if self.detach > 0 then
        self.detach -= dt
        normal, dist, kind = nil, nil, nil
    end
    self.grounded = normal ~= nil

    local velocity
    if kind == "ground" then
        self.vel = Vector3.zero
        local stick = -up * ((dist - self.hover) * _ObjectWallWalkCFG.StickGain)
        velocity = moveDir * speed + stick
    elseif kind == "inner" then
        self.vel = Vector3.zero
        local climb = _OWWSafeUnit(_OWWProject(up, normal), up)
        velocity = climb * speed - normal * 4
    elseif kind == "outer" then
        self.vel = Vector3.zero
        velocity = -up * speed - normal * 4
    else
        self.vel += Vector3.new(0, -Workspace.Gravity * dt, 0)
        velocity = self.vel + moveDir * speed * _ObjectWallWalkCFG.AirControl
    end

    if self.grounded and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        self.vel = up * _ObjectWallWalkCFG.JumpPower
        self.detach = _ObjectWallWalkCFG.DetachTime
        velocity = self.vel
    end

    bv.Velocity = velocity

    local targetUp = normal or Vector3.yAxis
    local alpha = 1 - math.exp(-_ObjectWallWalkCFG.TurnSpeed * dt)
    local newUp = _OWWSafeUnit(up:Lerp(targetUp, alpha), up)

    local axis = up:Cross(newUp)
    if axis.Magnitude > 1e-4 then
        local ang = math.acos(math.clamp(up:Dot(newUp), -1, 1))
        local rot = CFrame.fromAxisAngle(axis.Unit, ang)
        self.fwd = rot:VectorToWorldSpace(self.fwd)
        self.face = rot:VectorToWorldSpace(self.face)
    end
    self.up = newUp
    up = newUp

    local face = _OWWSafeUnit(_OWWProject(self.face, up), _OWWSafeUnit(_OWWProject(self.fwd, up), Vector3.zAxis))
    if moveDir.Magnitude > 0.1 then
        local md = _OWWSafeUnit(_OWWProject(moveDir, up), face)
        face = _OWWSafeUnit(face:Lerp(md, 1 - math.exp(-_ObjectWallWalkCFG.FaceSpeed * dt)), face)
    end
    self.face = face

    local faceRight = face:Cross(up)
    local aligned = CFrame.fromMatrix(pos, faceRight, up, -face)
    bg.CFrame = aligned * CFrame.Angles(
        math.rad(self.ctrl.rotX), math.rad(self.ctrl.rotY), math.rad(self.ctrl.rotZ)
    )

    local fwdCam = _OWWSafeUnit(_OWWProject(self.fwd, up), face)
    local focus = pos + up * _ObjectWallWalkCFG.CamHeight
    local camDir = fwdCam * math.cos(self.pitch) - up * math.sin(self.pitch)
    local camDist = self.dist
    local hit = Workspace:Raycast(focus, -camDir * camDist, self.params)
    if hit then camDist = math.max(1.5, hit.Distance - 0.5) end
    cam.CFrame = CFrame.lookAt(focus - camDir * camDist, focus, up)
end

