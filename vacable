do
    local notifiesEnabled = true
    local enabledEvents = {
        ["New Account"] = true,    -- Par défaut activé
        ["Friend Joined"] = true,
        ["Player Joined"] = false,
        ["Player Left"] = false,
    }
    local playerLeaveTracker = {}

    function SendPlayerNotification(title, description)
        if not notifiesEnabled then return end
        Library:Notify({
            Title = title,
            Content = description,
            Duration = 4
        })
    end

    -- Surveillance des joueurs qui rejoignent
    _TrackConn(game:GetService("Players").PlayerAdded:Connect(function(plr)
        if not notifiesEnabled then return end

        local displayName = plr.DisplayName or plr.Name
        local username = plr.Name
        local formatted = displayName .. " (@" .. username .. ")"

        task.wait(0.5)

        -- Check si c'est un joueur qui revient
        if playerLeaveTracker[plr.UserId] then
            if enabledEvents["Player Rejoined"] then
                SendPlayerNotification("🔄 Rejoined", formatted .. " has rejoined")
            end
            playerLeaveTracker[plr.UserId] = nil
            return
        end

        -- Check ami
        local ok, isFriend = pcall(function()
            return LocalPlayer:IsFriendsWith(plr.UserId)
        end)
        if ok and isFriend and enabledEvents["Friend Joined"] then
            SendPlayerNotification("👥 Friend Joined", formatted .. " is a friend")
        end

        -- Check nouveau compte (< 30 jours)
        if enabledEvents["New Account"] and plr.AccountAge < 30 then
            SendPlayerNotification("👶 New Account", formatted .. " is " .. plr.AccountAge .. " days old")
        end

        -- Notification générale de join
        if enabledEvents["Player Joined"] then
            SendPlayerNotification("➕ Player Joined", formatted .. " has joined")
        end
    end))

    -- Surveillance des joueurs qui partent
    _TrackConn(game:GetService("Players").PlayerRemoving:Connect(function(plr)
        if not notifiesEnabled then return end

        local displayName = plr.DisplayName or plr.Name
        local username = plr.Name
        local formatted = displayName .. " (@" .. username .. ")"

        playerLeaveTracker[plr.UserId] = true

        if enabledEvents["Player Left"] then
            SendPlayerNotification("➖ Player Left", formatted .. " has left")
        end
    end))

    -- Interface dans l'onglet Config
    local NotifBlock = Tabs.Config:CreateBlock({ Name = "🔔 Player Notifications", Side = "Left" })

    NotifBlock:CreateSection("General")

    NotifBlock:CreateToggle({
        Name = "Enable Notifications",
        Flag = "PlayerNotifEnabled",
        Default = true,
        Callback = function(v)
            notifiesEnabled = v
        end
    })

    NotifBlock:CreateSection("Events")

    NotifBlock:CreateToggle({
        Name = "New Account (< 30 days)",
        Flag = "NotifNewAccount",
        Default = true,
        Callback = function(v)
            enabledEvents["New Account"] = v
        end
    })

    NotifBlock:CreateToggle({
        Name = "Friend Joined",
        Flag = "NotifFriendJoined",
        Default = true,
        Callback = function(v)
            enabledEvents["Friend Joined"] = v
        end
    })

    NotifBlock:CreateToggle({
        Name = "Player Joined",
        Flag = "NotifPlayerJoined",
        Default = false,
        Callback = function(v)
            enabledEvents["Player Joined"] = v
        end
    })

    NotifBlock:CreateToggle({
        Name = "Player Left",
        Flag = "NotifPlayerLeft",
        Default = false,
        Callback = function(v)
            enabledEvents["Player Left"] = v
        end
    })
end

