    local palette = {
        Color3.fromRGB(255, 90, 90),   Color3.fromRGB(90, 200, 255),
        Color3.fromRGB(120, 255, 120), Color3.fromRGB(255, 220, 70),
        Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 150, 60),
        Color3.fromRGB(80, 255, 220),  Color3.fromRGB(255, 120, 200),
    }
    local groupCounter = 0

    local function findLink(a, b)
        for _, l in ipairs(adj[a] or {}) do
            if l.a == b or l.b == b then return l end
        end
        return nil
    end

    local function groupMembers(g)
        local seen, out = {}, {}
        for _, l in ipairs(g.links) do
            if not seen[l.a] then seen[l.a] = true table.insert(out, l.a) end
            if not seen[l.b] then seen[l.b] = true table.insert(out, l.b) end
        end
        return out
    end

    local function leaveGroup(t)
        for _, l in ipairs(table.clone(adj[t] or {})) do
            if l.group then removeLink(l) end
        end
    end

    local function createGroup(toys, mode)
        if #toys < 2 then return nil, "Sélectionne au moins 2 toys" end
        for _, t in ipairs(toys) do leaveGroup(t) end
        groupCounter += 1
        local g = {
            name  = "Groupe " .. groupCounter,
            color = S.groupAuto and palette[(groupCounter - 1) % #palette + 1] or S.groupColor,
            links = {},
            soft  = not S.groupRigid,
        }
        table.insert(groups, g)

        local function connect(a, b)
            if a == b then return end
            local ex = findLink(a, b)
            if ex then removeLink(ex) end
            createLink(a, b, g)
        end

        local n = #toys
        if mode == "Étoile" then
            for i = 2, n do connect(toys[1], toys[i]) end
        elseif mode == "Maillage" then
            local cap = math.min(n, 10)
            for i = 1, cap do
                for j = i + 1, cap do connect(toys[i], toys[j]) end
            end
            for i = cap + 1, n do connect(toys[1], toys[i]) end
        else
            for i = 2, n do connect(toys[i - 1], toys[i]) end
        end

        if #g.links == 0 then
            for i, x in ipairs(groups) do
                if x == g then table.remove(groups, i) break end
            end
            refreshGroups()
            return nil, "Impossible de relier ces toys"
        end
        refreshGroups()
        if S.groupFetch then
            for _, t in ipairs(toys) do
                if isMyToy(t) and ownerNameOf(t) ~= LP.Name then fetchOwnership(t) end
            end
        end
        return g
    end

    local function dissolveGroup(g)
        for _, l in ipairs(table.clone(g.links)) do removeLink(l) end
        refreshGroups()
    end

    local function linkSelection()
        local g, err = createGroup(selList(), S.groupMode)
        if g then
            say(g.name .. " créé (" .. #groupMembers(g) .. " toys · " .. S.groupMode .. ")")
        else
            say(err)
        end
    end

    local function unlinkSelection()
