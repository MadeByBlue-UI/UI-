        local e = Instance.new("ParticleEmitter")
        e.Texture       = st.tex
        e.Rate          = S.rate
        e.Lifetime      = st.life
        e.Speed         = st.speed
        e.Acceleration  = st.accel
        e.SpreadAngle   = Vector2.new(180, 180)
        e.Size          = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.4 * S.size),
            NumberSequenceKeypoint.new(0.5, 0.8 * S.size),
            NumberSequenceKeypoint.new(1, 0),
        })
        e.Transparency  = NumberSequence.new({
            NumberSequenceKeypoint.new(0, st.trans0),
            NumberSequenceKeypoint.new(1, 1),
        })
        e.LightEmission = st.emission
        e.Color         = ColorSequence.new(S.color)
        e.Parent        = att
        table.insert(fx.emitters, e)
        return e
    end

    -- ---------------------------------------------------------------
    -- CONSTRUCTION DES EFFETS
    -- ---------------------------------------------------------------
    local function buildFX()
        clearFX()
        local model, main = S.pallet, S.part
        if not model or not model.Parent or not main then return end

        -- Parts du pallet
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(fx.parts, d)
                originals[d] = { Material = d.Material, Color = d.Color, Transparency = d.Transparency }
            end
        end

        -- 1) Forcefield
        if S.forcefield then
            for _, p in ipairs(fx.parts) do
                p.Material = Enum.Material.ForceField
                p.Color    = S.color
            end
        end
        
        -- 1.5) Effet Verre
        if S.glass then
            for _, p in ipairs(fx.parts) do
                -- Si pas déjà en ForceField, applique le verre
                if not S.forcefield then
                    p.Material = Enum.Material.Glass
                end
                -- Rendre semi-transparent pour effet verre
                p.Transparency = 0.3
            end
        end
        
        -- 1.6) Effet Neon 💎
        if S.neon then
            for _, p in ipairs(fx.parts) do
                if not S.forcefield then
                    p.Material = Enum.Material.Neon
                end
                p.Color = S.color
                p.Transparency = 0
            end
        end
        
        -- 1.7) Effet Cristal ✨
        if S.crystal then
            for _, p in ipairs(fx.parts) do
                if not S.forcefield then
                    p.Material = Enum.Material.Glass
                end
                p.Color = Color3.fromRGB(150, 200, 255)
                p.Transparency = 0.2
                p.Reflectance = 0.4
            end
        end
        
        -- 1.8) Effet Métal 🔩
        if S.metal then
            for _, p in ipairs(fx.parts) do
                if not S.forcefield then
                    p.Material = Enum.Material.Metal
                end
                p.Color = Color3.fromRGB(180, 180, 200)
                p.Reflectance = 0.6
            end
        end
        
        -- 1.9) Effet Hologramme 🌐
        if S.hologram then
            for _, p in ipairs(fx.parts) do
                if not S.forcefield then
                    p.Material = Enum.Material.Neon
                end
                p.Color = Color3.fromRGB(0, 255, 255)
                p.Transparency = 0.5
            end
        end
        
        -- 1.10) Effet Glace ❄️
        if S.ice then
            for _, p in ipairs(fx.parts) do
                if not S.forcefield then
                    p.Material = Enum.Material.Ice
                end
                p.Color = Color3.fromRGB(200, 240, 255)
                p.Transparency = 0.25
                p.Reflectance = 0.3
            end
        end

        -- 2) Glow (contour + remplissage)
        if S.highlight then
            local h = Instance.new("Highlight")
            h.Adornee = model
            h.FillTransparency = 0.8
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.FillColor = S.color
            h.OutlineColor = S.color
            h.Parent = model
            table.insert(fx.extras, h)
        end
        
        -- 2.5) Outline Verre/Bulle (SelectionBox avec effet brillant)
        if S.glassOutline then
            local box = Instance.new("SelectionBox")
            box.Adornee = model
            box.LineThickness = 0.04
            box.Transparency = 0.3
            -- Couleur cyan/blanc pour effet bulle
            box.Color3 = Color3.fromRGB(100, 200, 255)
            box.SurfaceColor3 = Color3.fromRGB(180, 220, 255)
            box.SurfaceTransparency = 0.7
            box.Parent = model
            table.insert(fx.extras, box)
        end

        -- 3) Particules dans les 8 coins
        local cornerAtts = {}
        if S.corners or S.trail then
            local ok, bcf, bsize = pcall(function() return model:GetBoundingBox() end)
            if ok then
                local st = STYLES[S.style] or STYLES["Etincelles"]
                for _, sx in ipairs({ -1, 1 }) do
                    for _, sy in ipairs({ -1, 1 }) do
                        for _, sz in ipairs({ -1, 1 }) do
                            local att = Instance.new("Attachment")
                            att.Name = "_PFX_Corner"
                            att.Parent = main
                            att.WorldCFrame = bcf * CFrame.new(sx * bsize.X / 2, sy * bsize.Y / 2, sz * bsize.Z / 2)
                            table.insert(fx.attachments, att)
                            table.insert(cornerAtts, att)
                            if S.corners then makeEmitter(att, st) end
                        end
                    end
                end
            end
        end

        -- 4) Lumière
        if S.light then
            local l = Instance.new("PointLight")
            l.Brightness = 3
            l.Range = 18
            l.Color = S.color
            l.Parent = main
            table.insert(fx.extras, l)
        end

        -- 5) Traînée (entre deux coins opposés)
        if S.trail and #cornerAtts >= 8 then
            local t = Instance.new("Trail")
            t.Attachment0 = cornerAtts[1]
            t.Attachment1 = cornerAtts[8]
            t.Lifetime = 0.6
            t.LightEmission = 1
            t.Transparency = NumberSequence.new(0, 1)
            t.Color = ColorSequence.new(S.color)
            t.Parent = main
            table.insert(fx.extras, t)
        end
    end

    local function refresh()
        if S.pallet and S.pallet.Parent then buildFX() end
    end

