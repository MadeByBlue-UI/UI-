                local airW = math.clamp(jump + fall, 0, 1)
                local stride = 1.5 + 1.1 * run
                local YF = -9.0
                local per = (numToys >= 19) and 3 or 2
                local legLen = (per == 3) and 3.4 or 3.2

                -- corps : rebond à la course, respiration à l'arrêt, nez levé au saut / piqué à la chute, flexion à la réception
                local bob = (sin(2 * ph - 0.6) * (0.14 + 0.25 * run) + 0.18 * run * cos(ph)) * gait * (1 - airW)
