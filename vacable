DefenseExtra:CreateToggle({
    Name = "Anti-Projectiles (Oven)",
    Flag = "AntiProjectiles",
    Default = false,
    Callback = function(Value)
        _G.AntiProjectilesEnabled = Value

        if not Value then return end

        task.spawn(function()
            local Me = game:GetService("Players").LocalPlayer
            local RS_AP = game:GetService("ReplicatedStorage")
            local SetNetworkOwner = RS_AP.GrabEvents.SetNetworkOwner
            local SpawnToy = RS_AP.MenuToys.SpawnToyRemoteFunction
            local DestroyToy = RS_AP.MenuToys.DestroyToy
            
            -- MÉTHODE GROS SCRIPT : Setup position fixe et ReturnY très haut
            local SetupCoordinate = Vector3.new(484, 134, 207)
            local ReturnYCoordinate = 70000
            
            -- Liste des projectiles à détruire (copié de Gros script)
            local TargetBombNames = {
                BombMissile = true,
                BombDarkMatter = true,
                BombBalloon = true,
                BallSnowball = true,
            }

            -- 1. Sauvegarde position originale du joueur
            local Character = Me.Character
            local Root = Character and Character:FindFirstChild("HumanoidRootPart")
            local Humanoid = Character and Character:FindFirstChild("Humanoid")
            
            if not Root or not Humanoid or Humanoid.Health <= 0 then 
                _G.AntiProjectilesEnabled = false
                return 
            end
            
            local OriginalCFrame = Root.CFrame

            -- 2. TP joueur vers position de setup
            Root.CFrame = CFrame.new(SetupCoordinate)
            
            -- 3. Spawn le four devant le joueur
            local spawnPos = Root.CFrame * CFrame.new(0, 1, 5)
            task.spawn(function()
                SpawnToy:InvokeServer("OvenDarkGray", spawnPos, Vector3.zero)
            end)
            
            -- 4. Trouve le toy folder
            local myToyFolder = workspace:WaitForChild(Me.Name .. "SpawnedInToys", 5)
            if not myToyFolder then
                _G.AntiProjectilesEnabled = false
                return
            end
            
            -- 5. Trouve le four
            local oven = myToyFolder:WaitForChild("OvenDarkGray", 5)
            if not oven then
                _G.AntiProjectilesEnabled = false
                return
            end
            
            -- 6. Trouve la part Main (part principale du four)
            local ovenMain = oven:WaitForChild("Main", 3)
            if not ovenMain then
                _G.AntiProjectilesEnabled = false
                return
            end
            
            task.wait(0.12)
            
            -- 7. TP joueur près du four
            if Root and Humanoid.Health > 0 then
                Root.CFrame = ovenMain.CFrame * CFrame.new(0, 0, 5)
            end
            
            -- 8. Trouve les parts importantes
            local soundPart = oven:WaitForChild("SoundPart", 3)
            
            -- 9. Claim le four (network ownership)
            if soundPart then
                SetNetworkOwner:FireServer(soundPart, soundPart.CFrame)
            end
            
            -- 10. Appuie sur ButtonOven pour allumer
            local buttonOven = oven:FindFirstChild("ButtonOven") or oven:WaitForChild("ButtonOven", 1)
            if buttonOven then
                SetNetworkOwner:FireServer(buttonOven, buttonOven.CFrame)
            end
            
            -- 11. TP joueur à position originale
            if Root and Humanoid.Health > 0 then
                Root.CFrame = OriginalCFrame
            end
            
            -- 12. Attends que le four soit prêt (PartOwner apparaît)
            local partOwnerFound = false
            local searchStart = tick()
            while tick() - searchStart < 0.5 do
                function SearchForPartOwner(parent)
                    for _, child in pairs(parent:GetChildren()) do
                        if child.Name == "PartOwner" then
                            return true
                        end
                        if SearchForPartOwner(child) then
                            return true
                        end
                    end
                    return false
                end
                
                if SearchForPartOwner(oven) then
                    partOwnerFound = true
                    break
                end
                
                task.wait(0.05)
            end
            
            if not partOwnerFound then
                task.wait(0.3)
            end

            -- 13. BOUCLE PRINCIPALE - Méthode exacte de Gros script
            while _G.AntiProjectilesEnabled do
                Character = Me.Character
                Humanoid = Character and Character:FindFirstChild("Humanoid")
                
                if not Character or not Humanoid or Humanoid.Health <= 0 then
                    task.wait(1)
                    continue
                end
                
                if not oven or not oven.Parent or not ovenMain or not ovenMain.Parent then
                    break
                end
                
                -- Cherche un projectile cible
                local foundTarget = nil
                local targetCFrame = nil
                
                -- Cherche dans tous les SpawnedInToys folders
                for _, folder in pairs(workspace:GetChildren()) do
                    if string.sub(folder.Name, -13) == "SpawnedInToys" then
                        if folder.Name == myToyFolder.Name then
                            continue
                        end
                        
                        for _, toy in pairs(folder:GetChildren()) do
                            if TargetBombNames[toy.Name] then
                                foundTarget = toy
                                break
                            end
                        end
                    end
                    if foundTarget then
                        break
                    end
                end
                
                -- Cherche aussi dans workspace.Balloons
                if not foundTarget then
                    local balloonsFolder = workspace:FindFirstChild("Balloons")
                    if balloonsFolder then
                        for _, toy in pairs(balloonsFolder:GetChildren()) do
                            if TargetBombNames[toy.Name] then
                                foundTarget = toy
                                break
                            end
                        end
                    end
                end
                
                -- Ignore si c'est notre propre projectile
                if foundTarget and foundTarget.Parent and foundTarget.Parent.Name == myToyFolder.Name then
                    foundTarget = nil
                end
                
                -- Si on a trouvé un projectile, TP le four 15 FOIS
                if foundTarget then
                    if foundTarget.Name == "BombBalloon" then
                        targetCFrame = foundTarget:GetPivot()
                    elseif foundTarget:FindFirstChild("Main") then
                        targetCFrame = foundTarget.Main.CFrame
                    end
                    
                    if targetCFrame then
                        -- TP LE FOUR 15 FOIS ULTRA RAPIDE (méthode Gros script)
                        for i = 1, 15 do
                            if not foundTarget or not foundTarget.Parent then
                                break
                            end
                            if not oven or not oven.Parent or not ovenMain or not ovenMain.Parent then
                                break
                            end
                            
                            -- Recalcule targetCFrame au cas où il bouge
                            if foundTarget.Name == "BombBalloon" then
                                targetCFrame = foundTarget:GetPivot()
                            elseif foundTarget:FindFirstChild("Main") then
                                targetCFrame = foundTarget.Main.CFrame
                            end
                            
                            if not targetCFrame then
                                break
                            end
                            
                            local targetPos = targetCFrame.Position
                            local returnPos = Vector3.new(targetPos.X, ReturnYCoordinate, targetPos.Z)
                            
                            -- TP vers projectile
                            ovenMain.CFrame = CFrame.new(targetPos)
                            ovenMain.Velocity = Vector3.zero
                            ovenMain.RotVelocity = Vector3.zero
                            
                            task.wait() -- Pas de délai (ultra rapide)
                            
                            -- TP retour très haut
                            ovenMain.CFrame = CFrame.new(returnPos)
                            ovenMain.Velocity = Vector3.zero
                            ovenMain.RotVelocity = Vector3.zero
                            
                            task.wait() -- Pas de délai (ultra rapide)
                        end
                    else
                        task.wait()
                    end
                else
                    -- Pas de projectile : animation idle en cercle
                    if ovenMain and ovenMain.Parent then
                        local fastTick = tick() * 30
                        local idleX = math.sin(fastTick) * 150
                        local idleZ = math.cos(fastTick) * 150
                        
                        ovenMain.CFrame = CFrame.new(idleX, ReturnYCoordinate, idleZ)
                        ovenMain.Velocity = Vector3.zero
                        ovenMain.RotVelocity = Vector3.zero
                    end
                    
                    task.wait()
                end
            end

            -- Nettoie le four à la fin
            _G.AntiProjectilesEnabled = false
            if oven and oven.Parent then
                DestroyToy:FireServer(oven)
            end
        end)
    end
})

