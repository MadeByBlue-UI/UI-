function _TrackConn(conn)
    if conn then
        table.insert(_Connections, conn)
        _G.HelperConnAdds = (_G.HelperConnAdds or 0) + 1
        -- toutes les 200 connexions ajoutées, on retire celles déjà déconnectées (évite une liste infinie)
        if _G.HelperConnAdds >= 200 then
            _G.HelperConnAdds = 0
            local n = 0
            for i = 1, #_Connections do
                local c = _Connections[i]
                local ok, alive = _G.HelperRawPcall(function() return c.Connected end)
                if not ok or alive ~= false then
                    n = n + 1
                    _Connections[n] = c
                end
            end
            for i = #_Connections, n + 1, -1 do _Connections[i] = nil end
        end
    end
    return conn
end

function _TrackItem(itemName)
    _SpawnedItems[itemName] = true
end

function _TrackPart(part)
    if part then table.insert(_VisualParts, part) end
    return part
end

function _SetFlag(key, val)
    _ActiveFlags[key] = val
end

_G.HelperOtherCleanup = function()
    -- Arrête toutes les boucles liées à cette exécution
    _G.HelperOtherRunId = nil

    -- Ramper : rendre la caméra
    pcall(function() if _G._FigureCrawlStop then _G._FigureCrawlStop() end end)
    pcall(function() if _G._FigTranspStop then _G._FigTranspStop() end end)   -- rend leurs toys / ton personnage visibles

    -- WallWalk : éteindre avant cleanup
    if _WallWalkState.enabled then
        pcall(function() _WallWalkDisable() end)
    end
    
    -- Object WallWalk : éteindre avant cleanup
    if _ObjectWallWalk and _ObjectWallWalk.enabled then
        pcall(function() _ObjectWallWalk:destroy() end)
    end
    
    -- Coupe tous les flags actifs
    for k in pairs(_ActiveFlags) do _ActiveFlags[k] = false end
    _G.InstantLagActive = false
    _G.CoconutPenisEnabled = false
    _G.CoconutBoobsEnabled = false
    _G.CoconutAssEnabled   = false

    -- Déconnecte toutes les connexions
    for _, conn in ipairs(_Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(_Connections)

    -- Détruit les parts visuelles
    for _, part in ipairs(_VisualParts) do
        pcall(function() if part and part.Parent then part:Destroy() end end)
    end
    table.clear(_VisualParts)

    -- Détruit les items spawns dans l'inventaire
    local inv = workspace:FindFirstChild(game.Players.LocalPlayer.Name .. "SpawnedInToys")
    if inv then
        for itemName in pairs(_SpawnedItems) do
            local item = inv:FindFirstChild(itemName)
            if item then
                pcall(function()
                    game:GetService("ReplicatedStorage").MenuToys.DestroyToy:FireServer(item)
                end)
            end
            -- Cherche aussi les tags V2_
            local tagged = inv:FindFirstChild("V2_" .. itemName)
            if tagged then
                pcall(function()
                    game:GetService("ReplicatedStorage").MenuToys.DestroyToy:FireServer(tagged)
                end)
            end
        end
    end
    table.clear(_SpawnedItems)

    -- Supprime les GUIs visuels
    local pg = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        local gui = pg:FindFirstChild("StretchedResGUI")
        if gui then gui:Destroy() end
        local animeGui = pg:FindFirstChild("AnimeImageGui")
        if animeGui then animeGui:Destroy() end
    end

    -- Restore la caméra
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            cam.FieldOfView = 70
            cam.CameraType  = Enum.CameraType.Custom
        end
    end)

    _dbg("[Helper-Other] Cleanup effectué.")
end

