                        return _EmoteX.IK(S, Hd, 3.4, 2.1, V(side * 1, 0.6, -0.5)), Hd
                    end
                    legFn = function(side, H) return _EmoteX.IK(H, V(side * 0.8 * spread, YF, zF), 2.6, 2.6, V(0, 1, 0)), V(side * 0.8 * spread, YF, zF) end
                end

                local sk = { neck = neck, hip = hip, head = head }
                for _, side in ipairs({ -1, 1 }) do
                    local key = side < 0 and "L" or "R"
                    local S = neck:Lerp(hip, 0.2) + V(side * shX * spread, 0, 0)
                    local aE, aF = armFn(side, S)
                    sk["arm" .. key] = { S = S, E = aE, F = aF }
                    local H = hip + V(side * 0.8 * spread, 0, 0)
                    local lE, lF, lP = legFn(side, H)
                    sk["leg" .. key] = { S = H, E = lE, F = lF, pitch = lP }
                end
                return sk
            end

            function _EmoteX.SkelPose(anim, i, headPos, bodyRight, bodyFwd, cs, spread, height, fp, swing)
                if anim == "Coeur" then
                    -- ❤️ POSE COEUR : TOUS les toys du corps (16 ou plus) sont répartis sur le contour d'un coeur, face à la caméra
                    -- (la tête reste dans le creux du haut ; chaque toy est orienté le long de la courbe)
                    local N = math.max(#figureBodyCache, 16)
                    local t = ((i - 0.5) / N) * math.pi * 2
                    local sn, cn = math.sin, math.cos
                    local sc = 0.5
                    local hx = 16 * sn(t) ^ 3
                    local hy = 13 * cn(t) - 5 * cn(2 * t) - 2 * cn(3 * t) - cn(4 * t)
                    local tx = 48 * sn(t) ^ 2 * cn(t)
                    local ty = -13 * sn(t) + 10 * sn(2 * t) + 6 * sn(3 * t) + 4 * sn(4 * t)
                    local lx, ly = hx * sc, (hy - 5) * sc - 2.2
                    local pos = headPos + bodyRight * (lx * cs) + Vector3.new(0, ly * cs + height, 0)
                    return pos, _EmoteX.AlignY(bodyRight * tx + Vector3.new(0, ty, 0))
                end
                if i > 16 then return nil end
                local sk = _EmoteX.Skel(anim, fp, swing, spread)
                local flat = _TwerkFlat(bodyFwd)
                local function W(v) return headPos + bodyRight * (v.X * cs) + Vector3.new(0, v.Y * cs + height, 0) + flat * (v.Z * cs) end
                local function Rot(d) return _EmoteX.AlignY(bodyRight * d.X + Vector3.new(0, d.Y, 0) + flat * d.Z) end

                if i <= 4 then
                    local t = (i == 1) and 0 or ({ 0.2, 0.533, 0.867 })[i - 1]
                    return W(sk.neck:Lerp(sk.hip, t)), Rot(sk.hip - sk.neck)
                elseif i <= 10 then
                    local isLeft = i <= 7
                    local k = isLeft and (i - 5) or (i - 8)
                    local a = isLeft and sk.armL or sk.armR
                    local u, f = (a.E - a.S).Unit, (a.F - a.E).Unit
                    if k == 0 then return W(a.S + u * 1.5), Rot(u)
                    elseif k == 1 then return W(a.E), Rot(u)
                    else return W(a.E + f * 2.1), Rot(f) end
                else
                    local legIdx = i - 10
                    local isLeft = legIdx <= 3
                    local k = isLeft and (legIdx - 1) or (legIdx - 4)
                    local l = isLeft and sk.legL or sk.legR
                    local u, f = (l.E - l.S).Unit, (l.F - l.E).Unit
                    if k == 0 then return W(l.S), Rot(u)
                    elseif k == 1 then return W(l.E), Rot(u)
                    elseif l.pitch then
                        -- 🦶 pied à plat : le toy du pied est couché à l'horizontale (pointe devant), légèrement décalé devant la cheville
                        local fd = Vector3.new(0, math.sin(l.pitch), math.cos(l.pitch))
                        return W(l.E + f * 2.6 + fd * 0.9), Rot(fd)
                    else return W(l.E + f * 2.6), Rot(f) end
                end
            end

            -- 🦸 REPÈRE DE VOL : r = droite caméra, f = direction de vol (regard complet, haut/bas inclus), d = "ventre" (vers le bas)
            -- Le squelette "Vol" est défini debout ; on le couche en envoyant son axe vertical (y) sur f et son axe avant (z) sur d.
            function _EmoteX.FlyBasis()
                local t = os.clock()
                local B = _EmoteX._flyB
                if B and B.t == t then return B end
                local cf = workspace.CurrentCamera.CFrame
                local f = cf.LookVector
                local r = f:Cross(Vector3.new(0, 1, 0))
                if r.Magnitude < 0.05 then r = cf.RightVector end
                r = r.Unit
                local u = r:Cross(f).Unit
                -- 🛬 redressement à l'approche du sol : le repère pivote autour de l'axe droite (r) pour que l'axe du corps passe de f à "haut"
                local lk = _G._FigureLandKs or 0
                if lk > 1e-3 then
                    local rotL = CFrame.fromAxisAngle(r, math.acos(math.clamp(f.Y, -1, 1)) * lk)
                    f, u = rotL * f, rotL * u
                end
                local bank = (_G._formBankAngle or 0) * 0.6 * (1 - lk)  -- roulis dans les virages (si "banking" est activé)
                if math.abs(bank) > 1e-3 then
                    local rot = CFrame.fromAxisAngle(f, bank)
                    r, u = rot * r, rot * u
                end
                B = { t = t, r = r, f = f, d = -u }
                _EmoteX._flyB = B
                return B
            end

            -- 🛫 poids du décollage (0 = debout -> 1 = couché) : suit la même durée que l'arc du corps
            function _EmoteX.TakeW()
                if _G._FigureTakeoffArc == false then return 1 end
                if not _EmoteX.inVol then return 0 end
                local d = math.max(_G._FigureTakeoffDur or 0.7, 0.05)
                local w = math.clamp((os.clock() - (_EmoteX.volStart or 0)) / d, 0, 1)
                return w * w * (3 - 2 * w)
            end

            -- Poids global de la pose couchée (décollage en arc x redressement près du sol). Sert à la rotation de la tête.
            function _EmoteX.VolW()
                if figureAnimationMode ~= "Auto" or figureFormation ~= "Stick Man" or #figureBodyCache < 13 then return 1 end
                return _EmoteX.TakeW() * (1 - (_G._FigureLandKs or 0))
            end

            function _EmoteX.FlyPose(i, headPos, cs, spread, height, fp, swing)
                if i > 16 then return nil end
                local sk = _EmoteX.Skel("Vol", fp, swing, spread)
                local B = _EmoteX.FlyBasis()
                local off = Vector3.new(0, height, 0)
                local function W(v) return headPos + off + B.r * (v.X * cs) + B.f * (v.Y * cs) + B.d * (v.Z * cs) end
                -- 🛠️ FIX VOL « les toys tournent / pas synchro » : avant, chaque toy était orienté par rapport à l'axe Y du MONDE (rotation minimale) :
                -- son roulis changeait dès que la caméra tournait, donc les toys « tournaient sur eux-mêmes » en vol. Maintenant l'orientation est
                -- calculée dans le repère DEBOUT du squelette (comme les autres poses), puis toute la formation subit la MÊME rotation que le corps
                -- (repère de vol B) : bloc rigide, chaque toy garde le même côté face au corps quoi que fasse la caméra.
                local _FM = CFrame.fromMatrix(Vector3.zero, B.r, B.f, -B.d)
                local function Rot(d)
                    local ra = _EmoteX.AlignY(Vector3.new(d.X, d.Y, -d.Z))
                    return ra and (_FM * ra) or _FM
                end

                if i <= 4 then
                    local t = (i == 1) and 0 or ({ 0.2, 0.533, 0.867 })[i - 1]
                    return W(sk.neck:Lerp(sk.hip, t)), Rot(sk.hip - sk.neck)
                elseif i <= 10 then
                    local isLeft = i <= 7
                    local k = isLeft and (i - 5) or (i - 8)
                    local a = isLeft and sk.armL or sk.armR
                    local u, f = (a.E - a.S).Unit, (a.F - a.E).Unit
                    if k == 0 then return W(a.S + u * 1.5), Rot(u)
                    elseif k == 1 then return W(a.E), Rot(u)
                    else return W(a.E + f * 2.1), Rot(f) end
                else
                    local legIdx = i - 10
                    local isLeft = legIdx <= 3
                    local k = isLeft and (legIdx - 1) or (legIdx - 4)
                    local l = isLeft and sk.legL or sk.legR
                    local u, f = (l.E - l.S).Unit, (l.F - l.E).Unit
                    if k == 0 then return W(l.S), Rot(u)
                    elseif k == 1 then return W(l.E), Rot(u)
                    elseif l.pitch then
                        local fd = Vector3.new(0, math.sin(l.pitch), math.cos(l.pitch))
                        return W(l.E + f * 2.6 + fd * 0.9), Rot(fd)
                    else return W(l.E + f * 2.6), Rot(f) end
                end
            end

            -- 🕷️ RAMPER : squelette du Stick Man couché sur une surface. Repère local : x = droite, y = normale de la surface, z = devant ;
            -- tête = (0, hauteur, 0), le corps part vers l'arrière (z < 0), sol = -14.2 (le point de la surface est relevé de 14.2 par _FigureCrawlStep).
            function _EmoteX.CrawlSkel()
                local K = _G._FigureCrawl
                local t0 = os.clock()
                if K.skC == K.skN and K.sk then return K.sk end
                local V = Vector3.new
                local sin, cos, max = math.sin, math.cos, math.max
                local YF = -14.2
                local ph, m = K.ph or 0, K.mvK or 0
                local name = K.styleName
                local b = 0.12 * sin(t0 * 1.8)                         -- respiration
                local neck, hip, head
                local armF, legF, armPole, legPole
                local sw = 1                                            -- amplitude des foulées (x m)
                if name == "Rampant (à plat ventre)" then
                    neck = V(0, YF + 2.0 + b, -1.4)
                    hip = V(0.25 * m * sin(ph), YF + 1.5, -8.6)
                    head = V(0.15 * sin(t0 * 0.7), YF + 2.6 + b, 0)
                    armF = function(side, a)
                        local lift = 0.8 * m * max(0, cos(a))
                        return V(side * 2.2, YF + 0.5 + lift, -2.0 + 2.0 * m * sin(a))
                    end
                    legF = function(side, a)
                        local lift = 0.7 * m * max(0, cos(a))
                        return V(side * 1.4, YF + 0.5 + lift, -11.6 + 1.5 * m * sin(a))
                    end
                    armPole = function(side) return V(side * 1.0, 0.8, -0.2) end
                    legPole = function(side) return V(side * 1.0, 0.8, 0.2) end
                elseif name == "Araignée" then
                    neck = V(0, YF + 3.2 + b, -1.5)
                    hip = V(0.2 * m * sin(ph), YF + 3.0, -8.6)
                    head = V(0.15 * sin(t0 * 0.7), YF + 3.9 + b, 0)
                    armF = function(side, a)
                        local lift = 1.4 * m * max(0, cos(a))
                        return V(side * 3.6, YF + 0.5 + lift, -2.0 + 1.6 * m * sin(a))
                    end
                    legF = function(side, a)
                        local lift = 1.4 * m * max(0, cos(a))
                        return V(side * 3.8, YF + 0.5 + lift, -8.4 + 1.6 * m * sin(a))
                    end
                    armPole = function(side) return V(side * 0.8, 1.0, -0.2) end
                    legPole = function(side) return V(side * 0.8, 1.0, 0.4) end
                else -- "À quatre pattes"
                    neck = V(0.15 * m * sin(ph), YF + 4.6 + b + 0.15 * m * sin(2 * ph), -1.6)
                    hip = V(-0.15 * m * sin(ph), YF + 4.2 + b, -9.0)
                    head = V(0.2 * sin(t0 * 0.7), YF + 5.6 + b + 0.2 * m * sin(2 * ph), 0)
                    armF = function(side, a)
                        local lift = 1.5 * m * max(0, cos(a))
                        return V(side * 1.3, YF + 0.5 + lift, -2.3 + 1.9 * m * sin(a))
                    end
                    legF = function(side, a)
                        local lift = 1.5 * m * max(0, cos(a))
                        return V(side * 1.3, YF + 0.4 + lift, -8.4 + 1.9 * m * sin(a))
                    end
                    armPole = function(side) return V(side * 0.6, 0.1, -1.0) end
                    legPole = function(side) return V(side * 0.4, 0.4, 1.0) end
                end
                local sk = { neck = neck, hip = hip, head = head }
                for _, side in ipairs({ -1, 1 }) do
                    local key = side < 0 and "L" or "R"
                    local S = neck:Lerp(hip, 0.2) + V(side * 0.8, 0, 0)
                    local aF = armF(side, ph + (side > 0 and 0 or math.pi))            -- diagonale : bras droit + jambe gauche
                    sk["arm" .. key] = { S = S, E = _EmoteX.IK(S, aF, 3.4, 2.1, armPole(side)), F = aF }
                    local H = hip + V(side * 0.8, 0, 0)
                    local lF = legF(side, ph + (side > 0 and math.pi or 0))
                    sk["leg" .. key] = { S = H, E = _EmoteX.IK(H, lF, 2.6, 2.6, legPole(side)), F = lF }
                end
                K.sk, K.skC = sk, K.skN
                return sk
            end

            -- offset du toy de tête par rapport à l'origine du squelette (repère de la surface)
            function _EmoteX.CrawlHeadOffset(cs)
                local K = _G._FigureCrawl
                if not K.r then return nil end
                local h = _EmoteX.CrawlSkel().head
                return K.r * (h.X * cs) + K.u * (h.Y * cs) + K.f * (h.Z * cs)
            end

            -- position / rotation (repère MONDE) du toy i : 1 cou, 2-4 torse, 5-7 bras gauche, 8-10 bras droit, 11-13 jambe gauche, 14-16 jambe droite
            function _EmoteX.CrawlPose(i, O, cs, spread, fp, swing)
                local K = _G._FigureCrawl
                if i > 16 or not K.r then return nil end
                local sk = _EmoteX.CrawlSkel()
                local r, u, f = K.r, K.u, K.f
                local function W(v) return O + r * (v.X * cs) + u * (v.Y * cs) + f * (v.Z * cs) end
                local function Rot(d) return _EmoteX.AlignY(r * d.X + u * d.Y + f * d.Z) end
                if i <= 4 then
                    local t = (i == 1) and 0 or ({ 0.2, 0.533, 0.867 })[i - 1]
                    return W(sk.neck:Lerp(sk.hip, t)), Rot(sk.hip - sk.neck)
                elseif i <= 10 then
                    local isLeft = i <= 7
                    local k = isLeft and (i - 5) or (i - 8)
                    local a = isLeft and sk.armL or sk.armR
                    local uu, ff = (a.E - a.S).Unit, (a.F - a.E).Unit
                    if k == 0 then return W(a.S + uu * 1.5), Rot(uu)
                    elseif k == 1 then return W(a.E), Rot(uu)
                    else return W(a.E + ff * 2.1), Rot(ff) end
                else
                    local legIdx = i - 10
                    local isLeft = legIdx <= 3
                    local k = isLeft and (legIdx - 1) or (legIdx - 4)
                    local l = isLeft and sk.legL or sk.legR
                    local uu, ff = (l.E - l.S).Unit, (l.F - l.E).Unit
                    if k == 0 then return W(l.S), Rot(uu)
                    elseif k == 1 then return W(l.E), Rot(uu)
                    else return W(l.E + ff * 2.6), Rot(ff) end
                end
            end

            -- 🧍 POSES IDLE (Stick Man, 13+ toys) : chaque pose renvoie neck, hip, head, armFn, legFn
            -- (mêmes conventions que _EmoteX.Skel : x = droite, y = haut, z = devant ; tête = 0, cou = -1.5, bassin = -9, sol = -14.2)
            _EmoteX.IdlePoses = {}
            _EmoteX.IdlePoseList = {"Bras croisés", "Mains sur les hanches", "Bras relâchés", "Mains dans le dos", "Mains derrière la tête",
                                    "Coucou", "Garde (poings)", "Bras en V (victoire)", "Penseur", "Étirement", "Genou à terre", "Assis en tailleur", "Arbre (yoga)", "Arabesque", "Position du cavalier", "Fente avant", "Titanic (bras écartés)", "Accroupi (guet)", "Agrippé au mur", "Suspendu (une main)", "Conquérant (pied sur rocher)", "Superhéros"}

            -- Nom de la pose choisie ("Pose:xxx") ou nil si aucune. "Aléatoire" change de pose toutes les 8 secondes.
            function _EmoteX.ResolveIdlePose()
                local p = _G._FigureIdlePose
                if not p or p == "Aucune" then return nil end
                if p == "Aléatoire" then
                    local L = _EmoteX.IdlePoseList
                    p = L[(math.floor(os.clock() / 8) % #L) + 1]
                end
                return "Pose:" .. p
            end

            function _EmoteX.BuildIdlePoses()
                local V = Vector3.new
                local sin, cos, rad = math.sin, math.cos, math.rad
                local YF = -14.2
                local IK = _EmoteX.IK
                local function breath() return sin(os.clock() * 1.8) * 0.1 end
                -- bras tendu dans une direction
                local function straight(S, dir)
                    dir = dir.Unit
                    local E = S + dir * 3.4
                    return E, E + dir * 2.1
                end
                -- bras plié : la main va à `hand`, le coude part vers `pole`
                local function armTo(S, hand, pole)
                    return IK(S, hand, 3.4, 2.1, pole), hand
                end
                -- jambes plantées au sol (écart footX, décalage avant/arrière footZ)
                local function legs(footX, footZ, pole)
                    return function(side, H)
                        local F = V(side * footX, YF, footZ or 0)
                        return IK(H, F, 2.6, 2.6, pole or V(0, 0.2, 1)), F
                    end
                end
                local function reg(name, fn)
                    _EmoteX.IdlePoses["Pose:" .. name] = fn
                    _EmoteX.skelAnims["Pose:" .. name] = true   -- pour que la tête suive (HeadOffset)
                end
                -- même chose, mais enregistrée comme ANIMATION (dropdown Animation, keybinds, roue, vitesse) et non comme pose idle
                local function regA(name, fn)
                    _EmoteX.IdlePoses[name] = fn
                    _EmoteX.skelAnims[name] = true
                end

                -- 🙅 Bras croisés sur la poitrine
                reg("Bras croisés", function(fp, swing, spread)
                    local b = breath()
                    local armFn = function(side, S)
                        local hand = V(-side * 1.9, -4.7, side > 0 and 1.5 or 1.0)
                        return armTo(S, hand, V(side * 0.3, -1, 0.8))
                    end
                    return V(0, -1.5 + b * 0.5, 0.1), V(0, -9, 0), V(0, b, 0.2), armFn, legs(1.2 * spread, 0)
                end)

                -- 🕴️ Mains sur les hanches
                reg("Mains sur les hanches", function(fp, swing, spread)
                    local b = breath()
                    local armFn = function(side, S)
                        return armTo(S, V(side * 1.6, -7.2, 0.3), V(side, 0, -0.2))
                    end
                    return V(0, -1.5 + b * 0.5, 0), V(0, -9, 0), V(0, b, 0), armFn, legs(1.6 * spread, 0)
                end)

                -- 😌 Bras relâchés (léger transfert de poids d'une jambe à l'autre)
                reg("Bras relâchés", function(fp, swing, spread)
                    local b = breath()
                    local sh = sin(os.clock() * 0.7) * 0.35
                    local armFn = function(side, S)
                        return straight(S, V(side * 0.12, -1, 0.05 + 0.04 * sin(os.clock() * 1.1 + side)))
                    end
                    return V(sh * 0.4, -1.5 + b * 0.5, 0), V(sh, -9, 0), V(sh * 0.5, b, 0), armFn, legs(1.0 * spread, 0)
                end)

                -- 🤫 Mains dans le dos
                reg("Mains dans le dos", function(fp, swing, spread)
                    local b = breath()
                    local armFn = function(side, S)
                        return armTo(S, V(side * 0.5, -7.4, -1.3), V(side * 0.6, 0, -1))
                    end
                    return V(0, -1.5 + b * 0.5, 0.2), V(0, -9, 0), V(0, b, 0.3), armFn, legs(1.3 * spread, 0)
                end)

                -- 😎 Mains derrière la tête
                reg("Mains derrière la tête", function(fp, swing, spread)
                    local b = breath()
                    local armFn = function(side, S)
                        return armTo(S, V(side * 0.4, -0.2, -1.0), V(side, 0, -0.1))
                    end
                    return V(0, -1.5 + b * 0.5, -0.2), V(0, -9, 0), V(0, b, -0.3), armFn, legs(1.4 * spread, 0)
                end)

                -- 👋 Coucou (bras droit qui salue)
                reg("Coucou", function(fp, swing, spread)
                    local b = breath()
                    local ang = rad(32) * sin(os.clock() * 7)
                    local armFn = function(side, S)
                        if side > 0 or _animBlend.coucou2 then
                            -- bras plus écarté sur le côté (≈65° de l'axe vertical) + léger vers l'avant, avant-bras qui salue au-dessus du coude
                            local E = S + V(side * 1.0, 0.45, 0.15).Unit * 3.4
                            local f = V(side * (sin(ang) + 0.35), cos(ang), 0.1).Unit
                            return E, E + f * 2.1
                        end
                        return straight(S, V(-0.22, -1, 0.05))
                    end
                    return V(0, -1.5 + b * 0.5, 0), V(0, -9, 0), V(0, b, 0), armFn, legs(1.2 * spread, 0)
                end)

                -- 🥊 Garde de combat (poings levés, jambes décalées, petit rebond)
                reg("Garde (poings)", function(fp, swing, spread)
                    local bounce = sin(os.clock() * 5) * 0.12
                    local armFn = function(side, S)
                        return armTo(S, V(side * 1.0, -2.0, 2.8), V(side * 0.4, -1, -0.1))
                    end
                    local legFn = function(side, H)
                        local F = V(side * 1.5 * spread, YF, side > 0 and 1.8 or -1.8)
                        return IK(H, F, 2.6, 2.6, V(0, 0.2, 1)), F
                    end
                    return V(0, -2.3 + bounce, 0.5), V(0, -9.8 + bounce, 0), V(0, -0.8 + bounce, 0.7), armFn, legFn
                end)

                -- 🙌 Bras en V (victoire)
                reg("Bras en V (victoire)", function(fp, swing, spread)
                    local b = breath()
                    local armFn = function(side, S)
                        return straight(S, V(side * 0.55, 1, 0))
                    end
                    return V(0, -1.5 + b * 0.5, 0), V(0, -9, 0), V(0, b, 0), armFn, legs(1.6 * spread, 0)
                end)

                -- 🤔 Penseur (main au menton, l'autre bras soutient le coude)
                reg("Penseur", function(fp, swing, spread)
                    local b = breath()
                    local armFn = function(side, S)
                        if side > 0 then
                            return armTo(S, V(0.2, -1.3, 0.9), V(0.3, -1, 0.5))
                        end
                        return armTo(S, V(1.2, -4.6, 1.0), V(-0.3, -1, 0.6))
                    end
                    return V(0, -1.5 + b * 0.5, 0.1), V(0, -9, 0), V(0.2, b - 0.2, 0.5), armFn, legs(1.1 * spread, 0)
                end)

                -- 🙆 Étirement (mains jointes au-dessus de la tête, léger arrière)
                reg("Étirement", function(fp, swing, spread)
                    local r = 0.5 + 0.5 * sin(os.clock() * 1.2)
                    local armFn = function(side, S)
                        return armTo(S, V(side * 0.25, 1.2 + 1.4 * r, 0), V(side, 0, 0.3))
                    end
