    end
    
    -- Loop Kick Blob Function
    function LoopKickBlobFunction(targetName)
        local blobLoop = true
        local REMOTE_DELAY = 0.002
        local lastRemote = 0

        function BlobGrabKickHard()
            local target = Players:FindFirstChild(targetName)
            if not target then 
                notify("Combat", "❌ Target not found!", 3)
                return 
            end

            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
