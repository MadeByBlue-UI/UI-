    end

    -- ---------- Chargement d'un personnage (bundle) : plusieurs méthodes de secours ----------
    X.bodyErr = {}

    -- requête HTTP via l'exécuteur (si dispo)
    function X.httpJson(url)
        local req = (syn and syn.request) or http_request or request or (http and http.request) or (fluxus and fluxus.request)
        if type(req) ~= "function" then return nil end
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if not ok or type(res) ~= "table" then return nil end
        local body = res.Body
        if type(body) ~= "string" or body == "" then return nil end
        local ok2, data = pcall(function() return HttpS:JSONDecode(body) end)
        if ok2 then return data end
        return nil
    end

    -- cherche dans une table (peu importe sa forme) l'entrée { Type = "UserOutfit", Id = ... }
    function X.findOutfitId(t, depth)
        if type(t) ~= "table" or depth > 5 then return nil end
        local ty = t.Type or t.type
        if ty ~= nil and tostring(ty) == "UserOutfit" then
            local oid = tonumber(t.Id or t.id)
            if oid then return oid end
        end
        for _, v in pairs(t) do
            if type(v) == "table" then
                local r = X.findOutfitId(v, depth + 1)
                if r then return r end
            end
        end
        return nil
    end

    function X.bundleOutfitId(id)
        local det
        pcall(function() det = AES:GetItemDetails(id, Enum.AvatarItemType.Bundle) end)
        local oid = X.findOutfitId(det, 0)
        if oid then return oid end
        for _, url in ipairs({
            "https://catalog.roblox.com/v1/bundles/" .. id .. "/details",
            "https://catalog.roproxy.com/v1/bundles/" .. id .. "/details",
        }) do
            oid = X.findOutfitId(X.httpJson(url), 0)
            if oid then return oid end
        end
        return nil
    end

    function X.bundleDesc(oid)
        for i = 1, 3 do
            local ok, d = pcall(function() return Plrs:GetHumanoidDescriptionFromOutfitId(oid) end)
            if ok and d then return d end
            task.wait(0.4 * i)
        end
        return nil
    end

    -- Crée (si besoin) le corps R6 ou R15 du personnage
    function X.bodyRig(e, rg)
        if e[rg] then return e[rg] end
        if not e.desc then return nil end
        for _ = 1, 2 do
            local ok, m = pcall(function()
                return Plrs:CreateHumanoidModelFromDescription(e.desc, Enum.HumanoidRigType[rg])
            end)
            if ok and m then
                for _, d in ipairs(m:GetDescendants()) do
                    if d:IsA("LuaSourceContainer") then d:Destroy() end
                end
                e[rg] = m
                return m
            end
            X.lastErr = tostring(m)
            task.wait(0.3)
        end
        return nil
    end

    function X.myRigName()
        return (X.baseRig() == Enum.HumanoidRigType.R15) and "R15" or "R6"
    end

    -- Charge un personnage : renvoie (entrée) ou (nil, raison de l'échec)
    -- =====================================================================
    -- Analyse d'un personnage, PARTIE PAR PARTIE (pour ton rig)
    --   "native"  : ton jeu est en R15, tout marche tel quel
    --   "r6"      : le personnage a une vraie pièce R6 pour cette partie -> échange direct
    --   "r15"     : pièce R15 -> convertie : collée + mise à l'échelle sur ta pièce R6
    --   nil       : impossible (le modèle R15 n'a pas pu être créé)
    -- =====================================================================
    X.defRig = X.defRig or {}
    function X.defaultRig(rg)
        if X.defRig[rg] then return X.defRig[rg] end
        local ok, m = pcall(function()
            return Plrs:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType[rg])
        end)
        if ok and m then X.defRig[rg] = m end
        return X.defRig[rg]
    end

    -- "empreinte" d'une pièce : type + meshs + textures (pour savoir si elle diffère d'un corps de base)
    function X.partSig(m, nm)
        local part = m and m:FindFirstChild(nm)
        if not (part and part:IsA("BasePart")) then return "none" end
        local sig = part.ClassName .. "|T" .. tostring(math.floor(part.Transparency * 10 + 0.5))
        if part:IsA("MeshPart") then sig = sig .. "|" .. part.MeshId .. "|" .. part.TextureID end
        local nd = 0
        for _, c in ipairs(part:GetChildren()) do
            if c:IsA("SpecialMesh") then sig = sig .. "|" .. c.MeshId .. "|" .. c.TextureId end
            if c:IsA("SurfaceAppearance") then sig = sig .. "|SA" .. c.ColorMap end
            if c:IsA("Decal") then
                nd += 1
                sig = sig .. "|D" .. tostring(c.Texture) .. "|DT" .. tostring(math.floor(c.Transparency * 10 + 0.5))
            end
        end
        sig = sig .. "|nd" .. nd
        return sig
    end

    function X.analyse(e)
        if e.mode then return e.mode end
        local mode = {}
        local rg = X.myRigName()
        if rg == "R15" then
            for _, g in ipairs(X.GROUPS_ALL) do mode[g] = "native" end
        else
            local d6 = X.defaultRig("R6")
            local m6 = X.bodyRig(e, "R6")
            for _, g in ipairs(X.GROUPS_ALL) do
                local differs = false
                if d6 and m6 then
                    for _, nm in ipairs(X.GROUPS.R6[g]) do
                        if X.partSig(m6, nm) ~= X.partSig(d6, nm) then differs = true end
                    end
                else
                    differs = true   -- impossible de comparer : on laisse essayer
                end
                if differs then
                    mode[g] = "r6"          -- vraie pièce R6 : échange direct
                    if g == "head" then mode.headWhy = "R6 direct" end
                else
                    -- pièce R15 convertie automatiquement (collée + mise à l'échelle sur ton corps R6)
                    local m15 = X.bodyRig(e, "R15")
                    if m15 and g ~= "head" and m6 then
                        -- v7.15 : si les pièces R15 de ce groupe sont les pièces de BASE (aucun mesh spécial),
                        -- on utilise le vrai corps R6 du personnage (+ ses vêtements) au lieu de coller du R15
                        local d15c = X.defaultRig("R15")
                        local classic = d15c ~= nil
                        if classic then
                            for _, nm in ipairs(X.GROUPS.R15[g]) do
                                if X.partSig(m15, nm) ~= X.partSig(d15c, nm) then classic = false end
                            end
                        end
                        if classic then
                            mode[g] = "r6"
                            mode.nClassic = (mode.nClassic or 0) + 1
                        else
                            mode[g] = "r15"
                        end
                    elseif m15 then
                        if g == "head" then
                            local d15 = X.defaultRig("R15")
                            if d15 and X.partSig(m15, "Head") == X.partSig(d15, "Head") then
                                mode.head = "r6"   -- tête de base : l'échange R6 suffit
                                mode.headWhy = "tête de base"
                            else
                                mode.head = "r15"
                                mode.headWhy = "R15 converti"
                            end
                        else
                            mode[g] = "r15"
                        end
                    elseif g == "head" then
                        mode.head = "r6"
                    end
                end
            end
        end
        mode.classic = (mode.nClassic or 0) >= 5
        e.mode = mode
        dprint("analyse", e.name, mode.head, mode.torso, mode.larm, mode.rarm, mode.lleg, mode.rleg)
        return mode
    end

    -- Mode d'une partie (sans rien charger : si l'analyse n'est pas faite, on tente l'échange direct)
    function X.groupMode(e, g)
        if not e then return nil end
        if e.mode then return e.mode[g] end
        return (X.myRigName() == "R15") and "native" or "r6"
    end

    -- Applique la partie g du personnage e sur char (la bonne méthode selon l'analyse)
    function X.applyGroupTo(char, g, e, tint)
        local rg = X.rigOf(char)
        local mode = X.groupMode(e, g)
        if not mode then return false end
        if rg == "R6" then pcall(X.unswapGroupR6, char, g) end
        if mode == "r15" then
            return X.swapGroupR6(char, g, X.bodyRig(e, "R15"))
        end
        local src = e[rg]
        local names = X.GROUPS[rg][g]
        if not (src and names) then return false end
        local n = 0
        for _, nm in ipairs(names) do
            local ok, did = pcall(X.swapPart, char, nm, src, tint)
            if ok and did then n += 1 end
        end
        return n > 0
    end

    function X.loadBundle(id, name)
        if X.bodies[id] then return X.bodies[id] end
        if X.bodyLoading[id] then
            while X.bodyLoading[id] do task.wait() end
            return X.bodies[id], X.bodyErr[id]
        end
        X.bodyLoading[id] = true
        local entry, err
        local ok, e = pcall(function()
            local oid = X.bundleOutfitId(id)
            if not oid then err = "infos du personnage introuvables" return end
            local desc = X.bundleDesc(oid)
            if not desc then err = "apparence du personnage introuvable" return end
            local en = { name = name, desc = desc }
            if not X.bodyRig(en, X.myRigName()) then
                err = "modèle impossible à créer (" .. tostring(X.lastErr or "?") .. ")"
                return
            end
            entry = en
        end)
        if not ok then err = tostring(e) end
        X.bodies[id] = entry
        X.bodyErr[id] = (not entry) and (err or "inconnu") or nil
        X.bodyLoading[id] = nil
        dprint("personnage", id, entry and "ok" or ("échec : " .. tostring(X.bodyErr[id])))
        return entry, X.bodyErr[id]
    end

    -- Remplace UNE pièce du corps (char) par la même pièce prise dans le modèle src
    -- v7.3 : les joints (Motor6D) qui vivaient DANS l'ancienne pièce sont déménagés vers la nouvelle
    --        (avant, ils étaient détruits avec l'ancienne pièce => le membre restait figé / bizarre)
    function X.swapPart(char, name, src, tint)
        -- Nettoyer d'abord les restes d'un ancien échange de cette même pièce
        local prefix = "_OldPart_" .. name .. "_"
        for _, child in ipairs(char:GetChildren()) do
            if child.Name:sub(1, #prefix) == prefix then
                pcall(function() child:Destroy() end)
            end
        end

        local old = char:FindFirstChild(name)
        local from = src:FindFirstChild(name)
        if not (old and from and old:IsA("BasePart") and from:IsA("BasePart")) then
            dprint("swapPart: part not found", name, "old:", tostring(old), "from:", tostring(from))
            return false
        end

        dprint("swapPart: replacing", name)

        -- 1) Repérer TOUS les joints / soudures / contraintes liés à l'ancienne pièce
        --    (y compris ceux qui sont rangés À L'INTÉRIEUR de l'ancienne pièce)
        local links = {}
        for _, d in ipairs(char:GetDescendants()) do
            pcall(function()
                if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
                    if d.Part0 == old or d.Part1 == old then table.insert(links, d) end
                elseif d:IsA("Constraint") then
                    local a0, a1 = d.Attachment0, d.Attachment1
                    if (a0 and a0.Parent == old) or (a1 and a1.Parent == old) then table.insert(links, d) end
                end
            end)
        end

        -- 2) Préparer la nouvelle pièce (clone de celle du personnage choisi)
        local new = from:Clone()
        new.Name = name
        new.Anchored = old.Anchored
        new.CanCollide = old.CanCollide
        pcall(function() new.Massless = old.Massless end)
        pcall(function() new.CollisionGroup = old.CollisionGroup end)
        new.CFrame = old.CFrame
        if tint then X.recolor(new, old.Color) end
        for _, c in ipairs(new:GetDescendants()) do
            pcall(function()
                if c:IsA("LuaSourceContainer") or c:IsA("JointInstance") then c:Destroy() end
            end)
        end

        -- 3) Cacher l'ancienne pièce et la mettre de côté
        pcall(function() old.Transparency = 1 end)
        for _, c in ipairs(old:GetDescendants()) do
            pcall(function()
                if c:IsA("Decal") or c:IsA("Texture") then c.Transparency = 1 end
            end)
        end
        old.Name = prefix .. tostring(math.floor(os.clock() * 1000))

        -- 4) Poser la nouvelle pièce
        new.Parent = char

        -- 5) Rebrancher tous les joints sur la nouvelle pièce ET sortir ceux qui étaient dans l'ancienne
        for _, d in ipairs(links) do
            pcall(function()
                if d:IsA("Constraint") then
                    local a0, a1 = d.Attachment0, d.Attachment1
                    if a0 and a0.Parent == old then d.Attachment0 = new:FindFirstChild(a0.Name) end
                    if a1 and a1.Parent == old then d.Attachment1 = new:FindFirstChild(a1.Name) end
                else
                    if d.Part0 == old then d.Part0 = new end
                    if d.Part1 == old then d.Part1 = new end
                end
                if d:IsDescendantOf(old) then d.Parent = new end  -- << le correctif important
            end)
        end

        -- 6) Copier les réglages Motor6D (C0 / C1) du modèle source
        local srcMotors = {}
        for _, d in ipairs(src:GetDescendants()) do
            if d:IsA("Motor6D") then srcMotors[d.Name] = d end
        end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Motor6D") and srcMotors[d.Name] then
                pcall(function()
                    if d.Part1 == new then d.C1 = srcMotors[d.Name].C1 end
                    if d.Part0 == new then d.C0 = srcMotors[d.Name].C0 end
                end)
            end
        end

        -- 7) Attachments manquants
        for _, srcAtt in ipairs(from:GetChildren()) do
            if srcAtt:IsA("Attachment") and not new:FindFirstChild(srcAtt.Name) then
                pcall(function() srcAtt:Clone().Parent = new end)
            end
        end

        -- 8) Couleur de peau (BodyColors)
        local bc = char:FindFirstChildOfClass("BodyColors")
        local prop = X.COLORPROP[name]
        if bc and prop then
            pcall(function() bc[prop] = from.Color end)
        end

        -- 9) Supprimer l'ancienne pièce (plus rien d'important dedans)
        task.delay(0.05, function()
            pcall(function()
                if old and old.Parent then old:Destroy() end
            end)
        end)

        dprint("swapPart: success", name)
        return true
    end

    -- =====================================================================
    -- R6 : les parties R15 du personnage sont COLLÉES sur ton corps R6
    -- (la pièce R6 d'origine est cachée, les pièces R15 la suivent à chaque mouvement)
    -- =====================================================================
    X.R6PART = {
        head = "Head", torso = "Torso",
        larm = "Left Arm", rarm = "Right Arm",
        lleg = "Left Leg", rleg = "Right Leg",
    }

    -- position de repos des pièces R6 par rapport au centre du torse (corps R6 standard)
    X.R6REST = {
        torso = Vector3.new(0, 0, 0),
        larm = Vector3.new(-1.5, 0, 0), rarm = Vector3.new(1.5, 0, 0),
        lleg = Vector3.new(-0.5, -2, 0), rleg = Vector3.new(0.5, -2, 0),
    }

    -- Donne à une pièce la couleur de peau de TON corps (sauf si elle a une texture / un skin à elle)
    function X.recolor(part, color)
        if not (S.bodyMyColor and part and part:IsA("BasePart") and color) then return end
        if X.isFullBody and X.isFullBody() then return end   -- v7.15 : personnage complet = ses propres couleurs
        if part:IsA("MeshPart") then
            local okT, tex = pcall(function() return part.TextureID end)
            if okT and tex ~= "" then return end
        end
        for _, c in ipairs(part:GetChildren()) do
            if c:IsA("SurfaceAppearance") then return end
            if c:IsA("SpecialMesh") and c.TextureId ~= "" then return end
        end
        part.Color = color
    end

    -- v7.15 : personnage COMPLET choisi (les 6 parties viennent du même personnage) ?
    function X.isFullBody()
        local bid = X.bodyMap.torso
        if not bid then return false end
        for _, g in ipairs(X.GROUPS_ALL) do
            if X.bodyMap[g] ~= bid then return false end
        end
        return true
    end

    -- v7.15 : vêtements classiques (T-shirt / pantalon / graphique) du personnage choisi
    X.CLOTH = { "Shirt", "Pants", "ShirtGraphic" }
    function X.applyClothes(char, src)
        for _, cn in ipairs(X.CLOTH) do
            for _, c in ipairs(char:GetChildren()) do
                if c.ClassName == cn then pcall(function() c:Destroy() end) end
            end
            local from = src:FindFirstChildOfClass(cn)
            if from then
                local n = from:Clone()
                n:SetAttribute("CatCloth", true)
                n.Parent = char
            end
        end
    end
    function X.restoreClothes(char)
        local had = false
        for _, c in ipairs(char:GetChildren()) do
            if c:GetAttribute("CatCloth") then had = true end
        end
        if not had then return end
        for _, cn in ipairs(X.CLOTH) do
            for _, c in ipairs(char:GetChildren()) do
                if c.ClassName == cn then pcall(function() c:Destroy() end) end
            end
            local from = X.snap and X.snap:FindFirstChildOfClass(cn)
            if from then from:Clone().Parent = char end
        end
    end
    -- v7.17 : ACCESSOIRES du personnage (casque, cornes, cheveux...) qui font partie de sa "tête" / de son corps
    X.ATT_GROUP = {
        HatAttachment = "head", HairAttachment = "head", FaceFrontAttachment = "head", FaceCenterAttachment = "head",
        NeckAttachment = "torso", BodyFrontAttachment = "torso", BodyBackAttachment = "torso",
        WaistFrontAttachment = "torso", WaistBackAttachment = "torso", WaistCenterAttachment = "torso",
        LeftShoulderAttachment = "larm", RightShoulderAttachment = "rarm",
        LeftFootAttachment = "lleg", RightFootAttachment = "rleg",
    }
    function X.accGroup(acc)
        local h = acc:FindFirstChild("Handle")
        if not (h and h:IsA("BasePart")) then return nil end
        for _, a in ipairs(h:GetChildren()) do
            if a:IsA("Attachment") and X.ATT_GROUP[a.Name] then return X.ATT_GROUP[a.Name], a.Name end
        end
        return nil
    end
    function X.syncBodyAcc(char)
        X.accCount, X.accFail, X.accSeen, X.accWrap = 0, 0, 0, 0
        -- 1) nettoyer ce qu'on avait ajouté + ré-afficher tes accessoires cachés
        for _, c in ipairs(char:GetChildren()) do
            if c:GetAttribute("CatBodyAcc") then pcall(function() c:Destroy() end) end
        end
        for _, d in ipairs(char:GetDescendants()) do
            local t = d:IsA("BasePart") and d:GetAttribute("CatHidT")
            if t ~= nil and t ~= false then
                pcall(function() d.Transparency = t; d:SetAttribute("CatHidT", nil) end)
            end
        end
        -- 2) ajouter les accessoires des parties choisies
        local rg = X.rigOf(char)
        local hidHead = false
        for g, bid in pairs(X.bodyMap) do
            local e = X.bodies[bid]
            -- v7.19 : on prend le modèle R15 en priorité (c'est celui de l'aperçu, qui montre bien le casque)
            local model = e and (e.R15 or e[rg] or e.R6)
            if model then
                for _, acc in ipairs(model:GetChildren()) do
                    if acc:IsA("Accessory") then
                        X.accSeen = (X.accSeen or 0) + 1
                        if acc:FindFirstChildWhichIsA("WrapLayer", true) then X.accWrap = (X.accWrap or 0) + 1 end
                    end
                    if acc:IsA("Accessory") and not acc:FindFirstChildWhichIsA("WrapLayer", true) then
                        local ag, attName = X.accGroup(acc)
                        if ag == g then
                            local handle = acc:FindFirstChild("Handle")
                            local target, tc1
                            for _, part in ipairs(char:GetChildren()) do
                                -- v7.20 : on ignore les anciennes pièces cachées (_OldPart_...) : elles sont détruites juste après
                                --         l'échange, et l'accessoire tombait dans le vide avec elles
                                local okPart = part:IsA("BasePart") and part.Name:sub(1, 9) ~= "_OldPart_"
                                local ca = okPart and part:FindFirstChild(attName)
                                if ca and ca:IsA("Attachment") then target, tc1 = part, ca.CFrame break end
                            end
                            -- v7.18 : ton perso en jeu n'a pas forcément ces points d'attache -> on reprend ceux du modèle source
                            if not target then
                                local wd = handle and handle:FindFirstChild("AccessoryWeld")
                                local p1 = wd and wd.Part1
                                local cand = p1 and char:FindFirstChild(p1.Name)
                                if cand and cand:IsA("BasePart") then
                                    local sa = p1:FindFirstChild(attName)
                                    target, tc1 = cand, (sa and sa.CFrame or wd.C1)
                                end
                            end
                            if not target then
                                X.accFail = (X.accFail or 0) + 1
                            else
                                local clone = acc:Clone()
                                for _, d in ipairs(clone:GetDescendants()) do
                                    if d.Name == "AccessoryWeld" or d:IsA("LuaSourceContainer") then
                                        pcall(function() d:Destroy() end)
                                    elseif d:IsA("BasePart") then
                                        d.Anchored = false
                                        ghostPart(d)
                                    end
                                end
                                local h = clone:FindFirstChild("Handle")
                                local c0 = h:FindFirstChild(attName).CFrame
                                local c1 = tc1
                                h.CFrame = target.CFrame * c1 * c0:Inverse()
                                local w = Instance.new("Weld")
                                w.Name, w.Part0, w.Part1, w.C0, w.C1 = "AccessoryWeld", h, target, c0, c1
                                w.Parent = h
                                clone:SetAttribute("CatBodyAcc", g)
                                clone.Parent = char
                                X.accCount = (X.accCount or 0) + 1
                                if g == "head" then hidHead = true end
                            end
                        end
                    end
                end
            end
        end
        -- 3) tête du personnage choisie : on cache TES accessoires de tête (cheveux, chapeaux de ton avatar)
        if X.bodyMap.head then
            for _, acc in ipairs(char:GetChildren()) do
                if acc:IsA("Accessory") and not acc:GetAttribute("CatBodyAcc") and not acc:GetAttribute("CatId") then
                    if X.accGroup(acc) == "head" then
                        for _, d in ipairs(acc:GetDescendants()) do
                            if d:IsA("BasePart") then
                                if d:GetAttribute("CatHidT") == nil then d:SetAttribute("CatHidT", d.Transparency) end
                                d.Transparency = 1
                            end
                        end
                    end
                end
            end
        end
    end

    -- v7.21 : CharacterMesh (forme des bras / jambes / torse d'un corps R6)
    X.CMPART = {
        head = Enum.BodyPart.Head, torso = Enum.BodyPart.Torso,
        larm = Enum.BodyPart.LeftArm, rarm = Enum.BodyPart.RightArm,
        lleg = Enum.BodyPart.LeftLeg, rleg = Enum.BodyPart.RightLeg,
    }
    function X.syncCharMesh(char)
        -- 1) retirer ce qu'on avait ajouté
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("CharacterMesh") and c:GetAttribute("CatCM") then pcall(function() c:Destroy() end) end
        end
        for _, g in ipairs(X.GROUPS_ALL) do
            local bp = X.CMPART[g]
            local bid = X.bodyMap[g]
            if bid then
                -- 2) partie remplacée : on retire TES formes d'origine et on met celles du personnage
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("CharacterMesh") and c.BodyPart == bp then pcall(function() c:Destroy() end) end
                end
                local e = X.bodies[bid]
                if e and e.R6 then
                    for _, cm in ipairs(e.R6:GetChildren()) do
                        if cm:IsA("CharacterMesh") and cm.BodyPart == bp then
                            local n = cm:Clone()
                            n:SetAttribute("CatCM", true)
                            n.Parent = char
                        end
                    end
                end
            elseif X.snap then
                -- 3) partie d'origine : on remet TES formes si elles ont disparu
                local has = false
                for _, c in ipairs(char:GetChildren()) do
                    if c:IsA("CharacterMesh") and c.BodyPart == bp then has = true end
                end
                if not has then
                    for _, cm in ipairs(X.snap:GetChildren()) do
                        if cm:IsA("CharacterMesh") and cm.BodyPart == bp then cm:Clone().Parent = char end
                    end
                end
            end
        end
    end

    -- v7.23 : anti-doublons : une seule pièce collée par (groupe, nom de pièce) + compte affiché
    function X.dedupePasted(char)
        local seen, cnt, dups = {}, {}, 0
        for _, c in ipairs(char:GetChildren()) do
            local g = c:GetAttribute("CatR6Group")
            if g then
                local key = tostring(g) .. "|" .. tostring(c:GetAttribute("CatR6Name") or c.Name)
                if seen[key] or not X.bodyMap[g] then
                    pcall(function() c:Destroy() end)
                    dups += 1
                else
                    seen[key] = true
                    cnt[g] = (cnt[g] or 0) + 1
                end
            end
        end
        local parts = {}
        for _, g in ipairs(X.GROUPS_ALL) do
            if cnt[g] then table.insert(parts, g .. "=" .. cnt[g]) end
        end
        X.pasteInfo = (#parts > 0 or dups > 0)
            and ("collées : " .. table.concat(parts, " ") .. (dups > 0 and (" (" .. dups .. " doublon(s) retiré(s))") or ""))
            or nil
        -- v7.24 : DIAGNOSTIC jambes : liste (aussi dans la console F9) de TOUT ce qui est visible sur ton perso et ressemble à une jambe
        local legs, all = {}, {}
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.95 then
                local acc = d:FindFirstAncestorWhichIsA("Accessory")
                local label = (acc and ("ACC:" .. acc.Name .. "/") or "") .. d.Name .. " [" .. d.ClassName .. "] parent=" .. d.Parent.Name
                    .. " T=" .. string.format("%.2f", d.Transparency) .. " size=" .. tostring(d.Size)
                table.insert(all, label)
                local lo = d.Name:lower()
                if lo:find("leg") or lo:find("foot") or tostring(d:GetAttribute("CatR6Group") or ""):find("leg") then
                    table.insert(legs, (acc and "ACC:" or "") .. d.Name)
                end
            end
        end
        -- print("[CATALOG] pièces visibles (" .. #all .. ") :\n" .. table.concat(all, "\n"))
        if #legs > 0 then
            X.pasteInfo = (X.pasteInfo and (X.pasteInfo .. " · ") or "") .. "jambes visibles : " .. table.concat(legs, ", ")
        end
    end

    function X.syncClothes(char)
        if not char then return end
        if X.rigOf(char) == "R6" then pcall(X.dedupePasted, char) end
        local okA, errA = pcall(X.syncBodyAcc, char)
        if not okA then
            X.accInfo = "accessoires : erreur " .. tostring(errA)
        elseif (X.accCount or 0) > 0 or (X.accFail or 0) > 0 then
            X.accInfo = tostring(X.accCount or 0) .. " accessoire(s) du personnage"
                .. ((X.accFail or 0) > 0 and (", " .. X.accFail .. " non placé(s)") or "")
        elseif X.bodyMap.head or X.bodyMap.torso then
            X.accInfo = "aucun accessoire posé (" .. tostring(X.accSeen or 0) .. " dans le modèle, "
                .. tostring(X.accWrap or 0) .. " en couches)"
        else
            X.accInfo = nil
        end
        if X.rigOf(char) ~= "R6" then return end
        pcall(X.syncCharMesh, char)
        local e = X.bodyMap.torso and X.bodies[X.bodyMap.torso]
        if X.isFullBody() and e and e.R6 and e.mode and e.mode.classic then
            pcall(X.applyClothes, char, e.R6)
        else
            pcall(X.restoreClothes, char)
        end
    end

    -- Retire les pièces collées d'un groupe et ré-affiche la pièce R6 d'origine
    function X.unswapGroupR6(char, g)
        if not char then return end
        for _, c in ipairs(char:GetChildren()) do
            if c:GetAttribute("CatR6Group") == g then pcall(function() c:Destroy() end) end
        end
        local tp = char:FindFirstChild(X.R6PART[g] or "")
        if tp and tp:IsA("BasePart") then
            tp:SetAttribute("CatHideOn", false)
            local ot = tp:GetAttribute("CatOrigT")
            if ot ~= nil then tp.Transparency = ot end
            for _, d in ipairs(tp:GetChildren()) do
                if d:IsA("Decal") or d:IsA("Texture") then
                    local dt = d:GetAttribute("CatOrigT")
                    if dt ~= nil then d.Transparency = dt end
                end
            end
        end
    end

    -- Colle le groupe g (pièces R15 du modèle src) sur la pièce R6 correspondante de char.
    -- v7.14 : le groupe est MIS À L'ÉCHELLE pour avoir exactement la hauteur de la pièce R6
    --         (les corps R15 ont leurs propres proportions : c'était la cause des trous / bras trop longs)
    --         puis centré sur la pièce R6, qui est déjà bien placée par le squelette R6.
    function X.swapGroupR6(char, g, src)
        local r6name = X.R6PART[g]
        local names = X.GROUPS.R15[g]
        if not (char and src and r6name and names) then return false end
        local tp = char:FindFirstChild(r6name)
        if not (tp and tp:IsA("BasePart")) then return false end

        X.unswapGroupR6(char, g)

        local root = src:FindFirstChild("HumanoidRootPart")
        local rc = root and root.CFrame or CFrame.new()

        -- pièces R15 du groupe (repère du modèle) + boîte englobante (rotations prises en compte)
        local items = {}
        local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, nm in ipairs(names) do
            local part = src:FindFirstChild(nm)
            if part and part:IsA("BasePart") then
                local lc = rc:ToObjectSpace(part.CFrame)
                local h = part.Size / 2
                for sx = -1, 1, 2 do
                    for sy = -1, 1, 2 do
                        for sz = -1, 1, 2 do
                            local c = (lc * CFrame.new(h.X * sx, h.Y * sy, h.Z * sz)).Position
                            lo = Vector3.new(math.min(lo.X, c.X), math.min(lo.Y, c.Y), math.min(lo.Z, c.Z))
                            hi = Vector3.new(math.max(hi.X, c.X), math.max(hi.Y, c.Y), math.max(hi.Z, c.Z))
                        end
                    end
                end
                table.insert(items, { part = part, lc = lc })
            end
        end
        if #items == 0 then return false end
        local center, bsz = (lo + hi) / 2, hi - lo

        -- v7.16 : AUCUNE mise à l'échelle : chaque pièce garde sa taille d'origine (celle du personnage choisi)
        local scale = 1

        -- cacher la pièce R6 d'origine
        if tp:GetAttribute("CatOrigT") == nil then tp:SetAttribute("CatOrigT", tp.Transparency) end
        tp.Transparency = 1
        tp:SetAttribute("CatHideOn", true)
        if not tp:GetAttribute("CatGuard") then
            tp:SetAttribute("CatGuard", true)
            _TrackConn(tp:GetPropertyChangedSignal("Transparency"):Connect(function()
                if tp:GetAttribute("CatHideOn") and tp.Transparency < 1 then tp.Transparency = 1 end
            end))
        end
        pcall(function() tp.LocalTransparencyModifier = 0 end)
        for _, d in ipairs(tp:GetChildren()) do
            if d:IsA("Decal") or d:IsA("Texture") then
                if d:GetAttribute("CatOrigT") == nil then d:SetAttribute("CatOrigT", d.Transparency) end
                d.Transparency = 1
            end
        end

        local n = 0
        for i, it in ipairs(items) do
            local new = it.part:Clone()
            new.Name = "CatR6_" .. g .. "_" .. i
            for _, c in ipairs(new:GetDescendants()) do
                if c:IsA("LuaSourceContainer") or c:IsA("JointInstance") or c:IsA("Attachment") then
                    pcall(function() c:Destroy() end)
                end
            end
            new:SetAttribute("CatR6Group", g)
            new:SetAttribute("CatR6Name", it.part.Name)
            X.recolor(new, tp.Color)   -- même couleur de peau que ton corps
            new.Anchored = false
            ghostPart(new)
            if scale ~= 1 then
                if new:IsA("MeshPart") then
                    new.Size = it.part.Size * scale
                else
                    new.Size = it.part.Size * scale
                    for _, c in ipairs(new:GetChildren()) do
                        if c:IsA("SpecialMesh") then c.Scale = c.Scale * scale end
                    end
                end
            end
            -- position de la pièce par rapport au centre du groupe (mise à l'échelle), orientation conservée
            -- v7.25 : placement D'ORIGINE du personnage : toutes les pièces gardent leur position les unes par rapport
            --         aux autres (ancrage commun = centre du torse), au lieu d'être centrées chacune sur sa pièce R6.
            --         (jambes courtes cachées sous la robe, bras à leur place...). Désactivable dans les réglages.
            local rel
            local utp = src:FindFirstChild("UpperTorso")
            local rest = X.R6REST[g]
            if g == "head" then
                -- v7.26 : la tête est posée par son COU (et non plus centrée sur la tête R6) :
                --         une tête plus grande / plus haute que la normale ne s'enfonce plus dans le corps
                local neckPos = Vector3.new(0, -tp.Size.Y / 2, 0)
                local nj = char:FindFirstChild("Neck", true)
                if nj and nj:IsA("Motor6D") and nj.Part1 == tp then neckPos = nj.C1.Position end
                local na = it.part:FindFirstChild("NeckRigAttachment")
                if na and na:IsA("Attachment") then
                    rel = CFrame.new(neckPos - na.CFrame.Position) * (it.lc - it.lc.Position)
                else
                    -- pas de point d'attache : on aligne le BAS de la tête sur le cou
                    rel = CFrame.new(it.lc.Position.X - center.X, neckPos.Y + (it.lc.Position.Y - lo.Y), it.lc.Position.Z - center.Z)
                        * (it.lc - it.lc.Position)
                end
            elseif S.bodyNativeLayout and rest and utp and utp:IsA("BasePart") and scale == 1 then
                local anchor = rc:ToObjectSpace(utp.CFrame).Position - Vector3.new(0, 0.2, 0)
                rel = CFrame.new((it.lc.Position - anchor) - rest) * (it.lc - it.lc.Position)
            else
                rel = CFrame.new((it.lc.Position - center) * scale) * (it.lc - it.lc.Position)
            end
            local w = Instance.new("Weld")
            w.Name = "CatR6Weld"
            w.Part0 = tp
            w.Part1 = new
            w.C0 = rel
            w.C1 = CFrame.new()
            new.CFrame = tp.CFrame * rel
            w.Parent = new
            new.Parent = char
            n += 1
        end
        return n > 0
    end

    -- Aperçu : applique les parties choisies sur la copie de ton avatar
    function X.applyBodyOps(char)
        local n = 0
        for g, bid in pairs(X.bodyMap) do
            local e = X.bodies[bid]
            if e then
                local okS, did = pcall(X.applyGroupTo, char, g, e, true)
                if okS and did then n += 1 end
            end
        end
        X.syncClothes(char)
        return n
    end

    -- Ton vrai perso : applique (ou remet) les parties de la liste "groups"
    function X.applyReal(groups)
        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then 
            dprint("applyReal: no character or humanoid")
            return false 
        end
        local rg = X.rigOf(char)

        -- Créer ou recréer le snapshot si nécessaire
        if X.snapChar ~= char or not X.snap then 
            dprint("Creating new snapshot for character")
            X.snap = nil 
        end
        
        if not X.snap then
            local was = char.Archivable
            char.Archivable = true
            local ok, c = pcall(function() return char:Clone() end)
            char.Archivable = was
            if not ok or not c then 
                dprint("applyReal: failed to clone character")
                return false 
            end
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("LuaSourceContainer") then d:Destroy() end
            end
            X.snap, X.snapChar = c, char
            dprint("Snapshot created successfully")
        end

        local rn = hum.RequiresNeck
        pcall(function() hum.RequiresNeck = false end) -- évite de "mourir" pendant l'échange de tête / torse
        
        local success = 0
        for _, g in ipairs(groups) do
            local bid = X.bodyMap[g]
            if bid then
                local e = X.bodies[bid]
                local ok, did = pcall(X.applyGroupTo, char, g, e, true)
                if ok and did then
                    success = success + 1
                else
                    dprint("applyReal: échec pour la partie " .. g .. " du personnage " .. tostring(bid))
                end
            else
                -- remettre ton corps d'origine
                if rg == "R6" then pcall(X.unswapGroupR6, char, g) end
                for _, nm in ipairs(X.GROUPS[rg][g] or {}) do
                    local ok, did = pcall(X.swapPart, char, nm, X.snap, false)
                    if ok and did then success = success + 1 end
                end
            end
        end
        
        X.syncClothes(char)
        pcall(function() hum.RequiresNeck = rn end)
        dprint("applyReal: " .. success .. " parts swapped successfully")
        return success > 0
    end

