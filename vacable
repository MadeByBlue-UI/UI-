    -- 8. Dragon Wings  (SpecialMesh + battement + feu + forcefield)
    -- -----------------------------------------------------------------------
    local _dragonFF = false

    function FX_DragonWings()
        local char = Player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local MESH_ID    = "rbxassetid://215682815"
        local TEXTURE_ID = "rbxassetid://221992309"

        local wings = {}

        for _, side in ipairs({-1, 1}) do
            -- Part principale qui porte le mesh
            local part = Instance.new("Part")
            part.Size        = Vector3.new(1, 1, 1)
            part.Anchored    = true
            part.CanCollide  = false
            part.CanTouch    = false
            part.CanQuery    = false
            part.CastShadow  = false
            part.Transparency = 1   -- la part elle-même invisible, seul le mesh compte
            part.Parent      = char
            table.insert(FX.Parts, part)

            -- SpecialMesh avec tes IDs
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType  = Enum.MeshType.FileMesh
            mesh.MeshId    = MESH_ID
            mesh.TextureId = TEXTURE_ID
            mesh.Scale     = Vector3.new(4, 4, 4) * (side == -1 and Vector3.new(-1,1,1) or Vector3.new(1,1,1))
            mesh.Offset    = Vector3.new(0, 0, 0)
            mesh.Parent    = part
            table.insert(FX.Parts, mesh)

            -- Braises de feu (petites boules Neon)
            local embers = {}
            for i = 1, 10 do
                local em = Instance.new("Part")
                em.Size         = Vector3.new(.2,.2,.2)
                em.Shape        = Enum.PartType.Ball
                em.Material     = Enum.Material.Neon
                em.Color        = Color3.fromRGB(255, 120, 0)
                em.Anchored     = true
                em.CanCollide   = false
                em.CanTouch     = false
                em.CanQuery     = false
                em.CastShadow   = false
                em.Transparency = 0.2
                em.Parent       = char
                table.insert(FX.Parts, em)
                table.insert(embers, {
                    part   = em,
                    angle  = math.random() * math.pi * 2,
                    radius = 1 + math.random() * 3,
                    yOff   = -math.random() * 3,
                    speed  = 0.6 + math.random() * 1.0,
                    drift  = (math.random() - 0.5) * 1.5,
                })
            end

            -- ForceField visuel (SelectionBox)
            local ff = nil
            if _dragonFF then
                ff = Instance.new("SelectionBox")
                ff.Color3         = FXColors.Dragon or Color3.fromRGB(200, 40, 0)
                ff.LineThickness  = 0.05
                ff.SurfaceTransparency = 0.8
                ff.Adornee        = part
                ff.Parent         = char
                table.insert(FX.Parts, ff)
            end

            table.insert(wings, { part=part, mesh=mesh, side=side, embers=embers, ff=ff })
        end

        local t = 0
        local conn = R2.Heartbeat:Connect(function(dt)
            t = t + dt * 1.5
            local h = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not h then return end

            -- Battement : angle entre déployé (haut) et replié (bas)
            local flap = math.sin(t) * math.rad(35)

            for _, w in ipairs(wings) do
                local s = w.side

                -- Attache au dos du perso, côté gauche/droite
                -- L'aile regarde vers l'extérieur + monte/descend avec flap
                local attach = h.CFrame
                    * CFrame.new(s * 1.5, 0.4, 0.2)
                    * CFrame.Angles(0, s * math.rad(-15), s * (math.rad(20) + flap))

                w.part.CFrame = attach

                -- Pulsation couleur du mesh via Transparency légère
                local heat = (math.sin(t * 2.5) + 1) / 2
                w.part.Transparency = 0  -- part toujours invisible

                -- Embers : tombent depuis la position de l'aile
                local basePos = attach.Position
                for _, em in ipairs(w.embers) do
                    em.yOff  = em.yOff - dt * em.speed
                    em.angle = em.angle + dt * em.drift
                    if em.yOff < -4 then
                        em.yOff   = 0
                        em.radius = 0.5 + math.random() * 3
                        em.angle  = math.random() * math.pi * 2
                    end
                    local fade = math.clamp(-em.yOff / 3.5, 0, 1)
                    em.part.CFrame = CFrame.new(
                        basePos.X + math.cos(em.angle) * em.radius,
                        basePos.Y + em.yOff,
                        basePos.Z + math.sin(em.angle) * em.radius
                    )
                    em.part.Color = Color3.fromRGB(255, math.floor(180 - fade * 160), 0)
                    em.part.Size  = Vector3.new(
                        math.max(.05, .2 - fade*.15),
                        math.max(.05, .2 - fade*.15),
                        math.max(.05, .2 - fade*.15)
                    )
                    em.part.Transparency = 0.1 + fade * 0.75
                end
            end
        end)
        table.insert(FX.Connections, conn)
    end

