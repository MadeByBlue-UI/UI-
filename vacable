        -- Restore collisions
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then pcall(function() p.CanCollide = true end) end
            end
        end
    end

    function AGV2_Start()
        local isHeld = plr_AGV2:WaitForChild("IsHeld", 5)
        if not isHeld then return end

        local Struggle  = RS_AGV2:WaitForChild("CharacterEvents"):WaitForChild("Struggle")
        local RagRemote = RS_AGV2:WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

        if AGV2_HeldConn then AGV2_HeldConn:Disconnect() end
        AGV2_HeldConn = isHeld:GetPropertyChangedSignal("Value"):Connect(function()
            if not AGV2_Enabled or not isHeld.Value then return end
            local char = plr_AGV2.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")

            -- Ghosting
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then pcall(function() p.CanCollide = false end) end
            end

            -- Boucle lutte serveur
            task.spawn(function()
                while AGV2_Enabled and isHeld.Value do
                    pcall(function()
                        Struggle:FireServer(plr_AGV2)
                        if hrp then RagRemote:FireServer(hrp, 0) end
                        pcall(function()
                            RS_AGV2.GameCorrectionEvents.StopAllVelocity:FireServer()
                        end)
                    end)
                    task.wait()
                end
            end)

            -- Force physics state
            task.spawn(function()
                while AGV2_Enabled and isHeld.Value do
                    pcall(function()
                        if hum then
                            hum.Sit = false
                            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
