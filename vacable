    local AnimationTime = 0
    
    -- Couleurs rainbow
    function GetRainbowColor(time)
        local r = math.sin(time * 2) * 0.5 + 0.5
        local g = math.sin(time * 2 + 2) * 0.5 + 0.5
        local b = math.sin(time * 2 + 4) * 0.5 + 0.5
        return Color3.new(r, g, b)
    end
    
    -- =====================================================================
    -- FONCTION: Nettoyer les animations
    -- =====================================================================
    function CleanupAnimations()
        for toy, data in pairs(AnimatedToys) do
            if data.bodyPos and data.bodyPos.Parent then
                data.bodyPos:Destroy()
            end
            if data.bodyGyro and data.bodyGyro.Parent then
                data.bodyGyro:Destroy()
            end
            if data.light and data.light.Parent then
                data.light:Destroy()
            end
            if data.particles then
                for _, particle in ipairs(data.particles) do
                    if particle.Parent then
                        particle:Destroy()
                    end
                end
            end
        end
        
        for _, particle in ipairs(AnimationParticles) do
            if particle.Parent then
                particle:Destroy()
            end
        end
        
        for _, conn in ipairs(AnimationConnections) do
            if conn.Connected then
                conn:Disconnect()
            end
        end
        
        AnimatedToys = {}
        AnimationConnections = {}
        AnimationParticles = {}
        AnimationTime = 0
    end
    
    -- =====================================================================
    -- FONCTION: Créer particules pour un toy
    -- =====================================================================
    function CreateParticlesForToy(part)
        if not _G.ToyAnimationParticles then return {} end
        
        local particles = {}
        
        -- Particule principale
        local particle1 = Instance.new("ParticleEmitter", part)
        particle1.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        particle1.Rate = 30
        particle1.Lifetime = NumberRange.new(0.5, 1)
        particle1.Speed = NumberRange.new(2, 5)
        particle1.SpreadAngle = Vector2.new(180, 180)
        particle1.Size = NumberSequence.new(0.5, 0)
        particle1.Transparency = NumberSequence.new(0, 1)
        particle1.LightEmission = 1
        particle1.Color = ColorSequence.new(Color3.fromRGB(255, 255, 0))
        table.insert(particles, particle1)
        
        -- Particule secondaire (fumée/traînée)
        local particle2 = Instance.new("ParticleEmitter", part)
        particle2.Texture = "rbxasset://textures/particles/smoke_main.dds"
        particle2.Rate = 10
        particle2.Lifetime = NumberRange.new(1, 2)
        particle2.Speed = NumberRange.new(1, 2)
        particle2.SpreadAngle = Vector2.new(90, 90)
        particle2.Size = NumberSequence.new(1, 2)
        particle2.Transparency = NumberSequence.new(0.5, 1)
        particle2.Color = ColorSequence.new(Color3.fromRGB(100, 200, 255))
        table.insert(particles, particle2)
        
        return particles
    end
    
    -- =====================================================================
    -- FONCTION: Créer lumière pour un toy
    -- =====================================================================
    function CreateLightForToy(part)
