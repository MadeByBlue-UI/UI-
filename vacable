        -- sélection
        selectMode   = false,
        clearSelKey  = Enum.KeyCode.Backspace,
        -- touches
        anchorKey    = Enum.KeyCode.G,
        aimKey       = Enum.KeyCode.T,
        unAnchorKey  = Enum.KeyCode.H,
        lastKey      = Enum.KeyCode.K,
        linkKey      = Enum.KeyCode.L,
        unlinkKey    = Enum.KeyCode.U,
    }

    local entries = {}   -- [target] = { parts, hl, bb, tl, conns, name, snapOld, snapNew, snapT, busy, cool }
    local order   = {}   -- liste ordonnée des targets (ancien -> récent)
    local selectedIdx = nil
    local refreshList = function() end
    local refreshLinkCount = function() end
    local refreshSel    = function() end
    local refreshGroups = function() end
    local fetchOwnership = function() end   -- défini plus bas (file d'attente + téléportation)
    _G._AnchFetch = function(t) return fetchOwnership(t) end   -- utilisé par la reprise auto d'Animated Figure

    -- États partagés (contours, liens, sélection, groupes, vols)
    local adj         = {}   -- [toy] = { liens }
    local hlMap       = {}   -- [sujet] = Highlight unique (contour d'état)
    local sel         = {}   -- [toy] = true (sélection multiple)
    local selOrder    = {}   -- ordre de sélection
    local stolenState = {}   -- [toy] = { thief, flashUntil, gone }
    local lifted      = {}   -- [toy] = true : toys du groupe décrochés pendant que je tiens l'un d'eux
    local forceMovers = {}   -- [toy] = { bp, bg } : forces qui font suivre les toys liés (comme Apex)
    local collideMem  = {}   -- [part] = CanCollide d'origine
    local noclipMem   = {}   -- [part] = CanCollide d'origine (noclip des toys ancrés)
    local setNoclip   = function() end   -- défini plus bas
    local semiPending = {}   -- [toy] = true : toy ancré libéré, à réancrer quand l'autre joueur le lâche
    local groups      = {}   -- liste de { name, color, links, soft }
    local ignoreHeld  = nil  -- toy qu'on vient d'ancrer en le tenant (on ne le décroche pas)

    -- Dossier local pour les visuels (highlights / traits)
    local fxFolder = Instance.new("Folder")
    fxFolder.Name = "AnchorFX_" .. tostring(math.random(1000, 9999))
    fxFolder.Parent = workspace
    pcall(function() Mouse.TargetFilter = fxFolder end)

    -- ---------------------------------------------------------------
    -- EFFET (son + particules) quand on ancre
    -- ---------------------------------------------------------------
    local fxAttachment = Instance.new("Attachment")
    local fxSound      = Instance.new("Sound", fxAttachment)
    local fxParticle   = Instance.new("ParticleEmitter", fxAttachment)
    fxSound.SoundId          = "rbxassetid://1091083826"
    fxSound.Name             = "soundeffect"
    fxParticle.Name          = "particle"
    fxParticle.LightInfluence = 1
    fxParticle.Lifetime      = NumberRange.new(2, 3)
    fxParticle.Texture       = "rbxassetid://15668608167"
    fxParticle.Transparency  = NumberSequence.new(0, 1)
    fxParticle.Speed         = NumberRange.new(6, 6)
    fxParticle.Size          = NumberSequence.new(0, 1)
    fxParticle.SpreadAngle   = Vector2.new(360, 360)
    fxParticle.Rate          = 20
    fxParticle.Enabled       = false

    local function playEffect(part)
        if not S.effects or not part or not part.Parent then return end
        local clone = fxAttachment:Clone()
        clone.Parent = part
        pcall(function() clone.soundeffect:Play() end)
        pcall(function() clone.particle:Emit(25) end)
        Debris:AddItem(clone, 4)
    end

    -- ---------------------------------------------------------------
    -- HELPERS
    -- ---------------------------------------------------------------
    local function say(msg)
        if S.notif then notify("Anchor", msg, 2) end
    end

    local function isOwnChar(inst)
        local ch = LP.Character
        return ch ~= nil and (inst == ch or inst:IsDescendantOf(ch))
    end

    local function getHRP()
        local ch = LP.Character
        return ch and ch:FindFirstChild("HumanoidRootPart")
    end

    local function getPrimary(target)
        if not target or not target.Parent then return nil end
        if target:IsA("BasePart") then return target end
        if target:IsA("Model") then
            return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
        end
        return nil
    end

    -- Remonte jusqu'au toy (enfant direct d'un dossier "<Joueur>SpawnedInToys")
    local function toyRootOf(inst)
        local cur = inst
        while cur and cur.Parent do
            local par = cur.Parent
            if par.Name:match("SpawnedInToys$") then return cur end
            cur = par
        end
        return nil
    end

    -- Le toy m'appartient-il ? (dans mon dossier de toys)
    local function isMyToy(target)
        local root = toyRootOf(target)
        return root ~= nil and root.Parent ~= nil and root.Parent.Name == (LP.Name .. "SpawnedInToys")
    end

    -- Cible d'ancrage : toy uniquement (réglable), sinon ancien comportement
    local function resolveTarget(part)
        if typeof(part) ~= "Instance" or not part.Parent then return nil end
        if not part:IsA("BasePart") or part:IsA("Terrain") then return nil end
        if isOwnChar(part) then return nil end
        if S.toysOnly then
            local root = toyRootOf(part)
            if not root then return nil end
            if S.wholeModel then return root end
            return part
        end
        if not S.wholeModel then return part end
        local cur = part
        while cur.Parent and cur.Parent ~= workspace and not cur.Parent:IsA("Folder") do
            cur = cur.Parent
        end
        return cur
    end

    -- Part tenue en main via la grab line du jeu
    local function getHeldPart()
        local gp = workspace:FindFirstChild("GrabParts")
        local g  = gp and gp:FindFirstChild("GrabPart")
        local w  = g and g:FindFirstChild("WeldConstraint")
        return w and w.Part1
    end

    local function aimedPart()
        local p = Mouse.Target
        if not p then return nil end
        local hrp = getHRP()
        if hrp and (hrp.Position - p.Position).Magnitude > S.aimRange then return nil end
        return p
    end

    local function aimedTarget()
        local p = aimedPart()
        if not p then return nil end
        return resolveTarget(p)
    end

    -- ---------------------------------------------------------------
    -- OUTLINE (Highlight) + LABEL (Billboard)
    -- ---------------------------------------------------------------
    local function depthMode()
        return S.throughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    end

    local function groupOfToy(t)
        for _, l in ipairs(adj[t] or {}) do
            if l.group then return l.group end
        end
        return nil
    end

    -- Un seul Highlight par toy ; couleur selon l'état :
    --   volé (rouge, flash) > sélectionné (remplissage vert) > lié (couleur du groupe) > ancré
    local function styleSubject(s, h, now)
        local d, st, isSel = entries[s], stolenState[s], sel[s]
        local oc, fc, ft, show
        local ot = S.outlineTrans
        if d then
            oc, fc, ft = S.outlineColor, S.fillColor, S.fillTrans
            show = S.outline
            if S.rainbow then
                local col = Color3.fromHSV((now * S.rainbowSpeed * 0.1) % 1, 1, 1)
                oc, fc = col, col
            end
            if S.pulse then
                local pul = 0.5 + 0.5 * math.sin(now * 4)
                ft = math.clamp(S.fillTrans + (1 - S.fillTrans) * pul * 0.6, 0, 1)
            end
        end
        if adj[s] and S.linkOutline then
            local g = groupOfToy(s)
            oc = g and g.color or S.linkColor
            if not d then fc, ft = oc, 1 end
            show = true
        end
        if isSel then
            fc, ft = S.selColor, 0.5
            if not oc then oc = S.selColor end
            show = true
        end
        if S.flash and st and st.show and (now < st.flashUntil or not st.gone) then
            oc, fc = S.colStolen, S.colStolen
            ot = 0
            if now < st.flashUntil then
                ft = (math.floor(now * 8) % 2 == 0) and 0.05 or 0.65
            else
                ft = 0.6
            end
            show = true
        end
        if not oc then
            show = false
            oc, fc, ft = S.outlineColor, S.fillColor, 1
        end
        h.OutlineColor        = oc
        h.FillColor           = fc or oc
        h.FillTransparency    = ft or 1
        h.OutlineTransparency = ot
        h.DepthMode           = depthMode()
        h.Enabled             = show and true or false
    end

    local function refreshVisual(s)
        if not s then return end
        local need = s.Parent and (entries[s] or adj[s] or sel[s] or stolenState[s])
        local h = hlMap[s]
        if need then
            if not h then
                h = Instance.new("Highlight")
                h.Name    = "AnchorOutline"
                h.Adornee = s
                h.Parent  = fxFolder
                hlMap[s]  = h
            end
            styleSubject(s, h, os.clock())
        elseif h then
            pcall(function() h:Destroy() end)
            hlMap[s] = nil
        end
    end

    local function restyleAll()
        local now = os.clock()
        for s, h in pairs(hlMap) do styleSubject(s, h, now) end
    end

    local function makeBillboard(target, name)
        local adornee = getPrimary(target)
        if not adornee then return nil, nil end
        local bb = Instance.new("BillboardGui")
