        for _, t in ipairs(selList()) do n += unlinkToy(t) end
        say(n .. " lien(s) retiré(s)")
    end

    -- ---------------------------------------------------------------
    -- DÉPLACER UN TOY ANCRÉ : on l'attrape, on le bouge, on le lâche -> il se réancre
    -- ---------------------------------------------------------------
    local function resnap(set)
        for t in pairs(set) do
            local d = entries[t]
            if d then
                d.snapNew = takeSnap(d)
                d.snapOld = d.snapNew
            end
            if adj[t] then lastPivot[t] = pivotOf(t) end
        end
    end

    -- Après un changement de disposition : les liens gardent la nouvelle pose relative
    local function rebaseLinks(set)
        for _, l in ipairs(links) do
            if (set[l.a] or set[l.b]) and l.a.Parent and l.b.Parent then
                l.rel = pivotOf(l.a):ToObjectSpace(pivotOf(l.b))
            end
        end
    end

    -- Principe :
    --   1) j'attrape un toy ancré  -> ses parts sont "désancrées" tant que je le tiens
    --      (il se déplace normalement avec la grab line du jeu)
    --   2) les toys LIÉS le suivent (propagate() dans la boucle principale)
    --   3) je le lâche               -> tout est réancré à sa nouvelle position
    -- (lifted : déclaré en haut)
    local lastGroupClaim = 0

    -- Tous les toys reliés (liens rigides) à "root", root compris
    local function linkedSet(root)
        local seen, queue, i = { [root] = true }, { root }, 1
        while queue[i] do
            local cur = queue[i]
            i += 1
            for _, l in ipairs(adj[cur] or {}) do
                if not l.soft then
                    local o = (l.a == cur) and l.b or l.a
                    if not seen[o] then
                        seen[o] = true
                        table.insert(queue, o)
                    end
                end
            end
        end
        return seen
    end

    local function liftToy(t)
        local d = entries[t]
        if not d then return end
        d.lifted = true
        for _, p in ipairs(d.parts) do
            if p.Parent then p.Anchored = false end
        end
    end

    local function dropToy(t)
        local d = entries[t]
        if not d or not d.lifted then return end
        d.lifted = false
        for _, p in ipairs(d.parts) do
            if p.Parent then
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
                p.Anchored = true
            end
        end
        -- les toys liés se calent sur la position finale, puis on mémorise tout
        local set = { [t] = true }
        if adj[t] then
            for v in pairs(propagate(t)) do set[v] = true end
        end
        resnap(set)
    end

    -- ---------------------------------------------------------------
    -- FORMATIONS (ligne, cercle, mur, pile) sur la sélection
    -- ---------------------------------------------------------------
    local lastLayout = nil

    -- centre de la boîte (en repère du pivot) + taille alignée sur le monde
    local function extentsOf(t)
        local cf, size
        if t:IsA("Model") then
            cf, size = t:GetBoundingBox()
        else
            cf, size = t.CFrame, t.Size
        end
        local off = pivotOf(t):ToObjectSpace(cf).Position
        local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
        local w = Vector3.new(
            math.abs(r.X) * size.X + math.abs(u.X) * size.Y + math.abs(l.X) * size.Z,
            math.abs(r.Y) * size.X + math.abs(u.Y) * size.Y + math.abs(l.Y) * size.Z,
            math.abs(r.Z) * size.X + math.abs(u.Z) * size.Y + math.abs(l.Z) * size.Z)
        return off, w, cf.Position
    end

    local KIND_NAME = { line = "alignés", circle = "en cercle", wall = "en mur", pile = "en pile" }

    local function formation(kind)
        local list = selList()
        if #list < 2 then say("Sélectionne au moins 2 toys") return end

        local infos, center, minBottom = {}, Vector3.zero, math.huge
        for i, t in ipairs(list) do
            local off, w, pos = extentsOf(t)
            infos[i] = { t = t, off = off, w = w }
            center += pos
            minBottom = math.min(minBottom, pos.Y - w.Y / 2)
        end
        center /= #list
        center = Vector3.new(center.X, 0, center.Z)

        local cam = workspace.CurrentCamera
        local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
        look = Vector3.new(look.X, 0, look.Z)
        look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
        local right = Vector3.new(-look.Z, 0, look.X)

        local n, gap = #infos, S.formSpacing
        local function widthOf(i) return math.max(infos[i].w.X, infos[i].w.Z) end
        local plan = {}

        if kind == "line" then
            local total = gap * (n - 1)
            for i = 1, n do total += widthOf(i) end
            local cur = -total / 2
            for i = 1, n do
                local wd = widthOf(i)
                local p = center + right * (cur + wd / 2)
                plan[i] = { pos = Vector3.new(p.X, minBottom + infos[i].w.Y / 2, p.Z) }
                cur += wd + gap
            end
        elseif kind == "circle" then
            local circ = 0
            for i = 1, n do circ += widthOf(i) + gap end
            local r = math.max(circ / (2 * math.pi), 2)
            local cum = 0
            for i = 1, n do
                local wd = widthOf(i)
                local a = (cum + wd / 2) / circ * 2 * math.pi
                cum += wd + gap
                local dir = right * math.cos(a) + look * math.sin(a)
                local p = center + dir * r
                local orient = S.formFace and CFrame.lookAt(Vector3.zero, -dir) or nil
                plan[i] = { pos = Vector3.new(p.X, minBottom + infos[i].w.Y / 2, p.Z), orient = orient }
            end
        elseif kind == "wall" then
            local cols = S.formCols > 0 and S.formCols or math.max(1, math.ceil(math.sqrt(n * 1.6)))
            cols = math.min(cols, n)
            local cw, ch = 0, 0
            for i = 1, n do
                cw = math.max(cw, widthOf(i))
                ch = math.max(ch, infos[i].w.Y)
            end
            cw += gap
            ch += math.min(gap, 0.1)
            local orient = S.formFace and CFrame.lookAt(Vector3.zero, -look) or nil
            for i = 1, n do
                local c = (i - 1) % cols
                local rw = math.floor((i - 1) / cols)
                local p = center + right * ((c - (cols - 1) / 2) * cw)
                plan[i] = { pos = Vector3.new(p.X, minBottom + rw * ch + infos[i].w.Y / 2, p.Z), orient = orient }
            end
        else -- pile
            local y = minBottom
            local vgap = math.min(gap, 0.1)
            for i = 1, n do
                plan[i] = { pos = Vector3.new(center.X, y + infos[i].w.Y / 2, center.Z) }
                y += infos[i].w.Y + vgap
            end
        end

        if S.formAnchor then
            for _, t in ipairs(list) do
                if not entries[t] then anchorTarget(t) end
            end
        end

        lastLayout = {}
        local set = {}
        for i, inf in ipairs(infos) do
            local piv = pivotOf(inf.t)
            lastLayout[inf.t] = piv
            local rot = plan[i].orient or (piv - piv.Position)
            setPivot(inf.t, CFrame.new(plan[i].pos) * rot * CFrame.new(-inf.off))
            zeroVel(inf.t)
            set[inf.t] = true
        end
        rebaseLinks(set)
        resnap(set)
        say(n .. " toys " .. (KIND_NAME[kind] or ""))
    end

    local function undoLayout()
        if not lastLayout then say("Rien à annuler") return end
        local set = {}
        for t, cf in pairs(lastLayout) do
            if t.Parent then
                setPivot(t, cf)
                zeroVel(t)
                set[t] = true
            end
        end
        lastLayout = nil
        rebaseLinks(set)
        resnap(set)
        say("Formation annulée")
    end

    -- ---------------------------------------------------------------
    -- BOUCLE PRINCIPALE
    -- ---------------------------------------------------------------
    local acc, guardAcc = 0, 0
    local mainConn = RunService.Heartbeat:Connect(function(dt)
        local t = os.clock()

        -- Liens (chaque frame)
        pcall(updateLinks)

        -- Contours d'état (ancré / lié / sélectionné / volé) + animations
        for s, h in pairs(hlMap) do
            if s.Parent then
                styleSubject(s, h, t)
            else
                pcall(function() h:Destroy() end)
                hlMap[s] = nil
            end
        end

        -- Rectangle de sélection par zone
        if zone.active then
            local p = UIS:GetMouseLocation()
            if not zone.moved and (p - zone.start).Magnitude > 6 then zone.moved = true end
            if zone.moved then
                zoneFrame.Position = UDim2.fromOffset(math.min(p.X, zone.start.X), math.min(p.Y, zone.start.Y))
                zoneFrame.Size = UDim2.fromOffset(math.abs(p.X - zone.start.X), math.abs(p.Y - zone.start.Y))
                zoneFrame.Visible = true
            end
        end

        -- Saisie d'un toy ancré / d'un groupe lié :
        --   tout le groupe est décroché (simulé par moi) tant que je tiens un de ses toys,
        --   sinon les autres joueurs ne verraient bouger que le toy tenu.
        do
            local want, driver = {}, nil
            if S.grabMove then
                local held = getHeldPart()
                local ht = held and resolveTarget(held) or nil
                if ht and not entries[ht] then ht = nil end
                if ignoreHeld then
                    if ht == ignoreHeld then ht = nil else ignoreHeld = nil end
                end
                if ht then want[ht] = true end
                local hroot = held and toyRootOf(held) or nil
                driver = hroot or ht
                if hroot and adj[hroot] and isMyToy(hroot) then
                    for v in pairs(linkedSet(hroot)) do
                        if v ~= ignoreHeld and v.Parent and isMyToy(v) then want[v] = true end
                    end
                end
            end
            for tt in pairs(want) do
                if not lifted[tt] then
                    lifted[tt] = true
                    if entries[tt] then liftToy(tt) end
                    if tt ~= driver then prepFollower(tt) end   -- les autres : sans collision, tirés par forces
                end
            end
            for tt in pairs(lifted) do
                if not want[tt] then
                    lifted[tt] = nil
                    releaseFollower(tt)
                    dropToy(tt)
                end
            end
            -- ownership des toys du groupe (sans téléportation : seulement à portée)
            if next(want) and t - lastGroupClaim > 0.25 then
                lastGroupClaim = t
                for tt in pairs(want) do
                    if ownerNameOf(tt) ~= LP.Name then
                        local op = ownershipPart(tt)
                        if op then claimOwnership(op) end
                    end
                end
            end
        end

        -- Preview au survol
        if S.enabled and S.hover then
            local ok, tgt = pcall(aimedTarget)
            if ok and tgt then
                hoverHL.Adornee = tgt
                if entries[tgt] then
                    hoverHL.FillColor = Color3.fromRGB(255, 60, 60)
                    hoverHL.OutlineColor = Color3.fromRGB(255, 60, 60)
                else
                    hoverHL.FillColor = Color3.fromRGB(255, 255, 255)
                    hoverHL.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
                hoverHL.Enabled = true
            else
                hoverHL.Enabled = false
                hoverHL.Adornee = nil
            end
        else
            hoverHL.Enabled = false
        end

        -- Garde d'ownership (10x / seconde)
        guardAcc = guardAcc + dt
        if guardAcc >= 0.05 then
            guardAcc = 0
            pcall(runGuard)
        end

        -- Tâches lentes (4x / seconde)
        acc = acc + dt
        if acc < 0.25 then return end
        acc = 0

        local hrp = getHRP()
        for _, target in ipairs(order) do
            local d = entries[target]
            if d then
                if S.persist and not d.lifted then
                    for _, p in ipairs(d.parts) do
                        if p.Parent and not p.Anchored then p.Anchored = true end
                    end
                end
                if d.bb then
                    d.bb.Enabled = S.label
                    if S.label and d.tl then
                        local txt = "⚓ " .. d.name
                        if S.showDist and hrp then
                            local pp = getPrimary(target)
                            if pp then
                                txt = txt .. "  ·  " .. math.floor((hrp.Position - pp.Position).Magnitude) .. "m"
                            end
                        end
                        d.tl.Text = txt
                    end
                end
            end
        end

        for i = #selOrder, 1, -1 do
            local st = selOrder[i]
            if not st.Parent then
                sel[st] = nil
                table.remove(selOrder, i)
                refreshVisual(st)
                refreshSel()
            end
        end

        hookFolder()   -- (ré)accroche la détection de vol si le dossier de toys a changé

        -- Noclip des toys ancrés (désactivé le temps qu'on tient le toy)
        for target, d in pairs(entries) do
            local wantNoclip = S.noclipAnchored and not d.lifted
            if wantNoclip ~= (d.noclipOn or false) then
                d.noclipOn = wantNoclip
                pcall(setNoclip, target, wantNoclip)
            end
        end
    end)

