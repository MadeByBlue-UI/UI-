-- NINJA KATANA  logique partagée (utilisée par le toggle Defense)
-- =========================================================================
local RS_KT      = game:GetService("ReplicatedStorage")
local setOwnerKT = RS_KT:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
local stickyKT   = RS_KT:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
local spawnKT    = RS_KT:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local destroyKT  = RS_KT:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
local canSpawnKT = LocalPlayer:WaitForChild("CanSpawnToy")

local KT_Active = false
local KT_CF = {
    [1] = { x=2.5,  y=-1.2, z=-3.2, rx=86, ry=-10, rz=110 },
    [2] = { x=-2.5, y=-1.2, z=-3.2, rx=86, ry=10,  rz=70  },
}

function KT_GetCF(slot)
    local o = KT_CF[slot]
    return CFrame.new(o.x, o.y, o.z)
        * CFrame.Angles(math.rad(o.rx), math.rad(o.ry), math.rad(o.rz))
end
function KT_GetInv()
    return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end
function KT_GetFirePart()
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    return h and h:FindFirstChild("FirePlayerPart")
end
function KT_IsAlive()
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChild("Humanoid")
    return h and h.Health > 0
end
function KT_FindSticky(item)
    if not item then return nil end
    local sp = item:FindFirstChild("StickyPart")
    if sp then return sp end
    for _, v in pairs(item:GetDescendants()) do
        if v:IsA("BasePart") and v.Name:lower():find("sticky") then return v end
    end
end
function KT_IsStuck(item)
    local sp = KT_FindSticky(item)
    local w  = sp and sp:FindFirstChild("StickyWeld")
    if not w or not w.Part1 then return false end
    local fp = KT_GetFirePart()
    return fp ~= nil and w.Part1 == fp
end
function KT_CleanVisuals(item)
    if not item then return end
    for _, p in pairs(item:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanTouch = false; p.CanCollide = false
            p.CanQuery = false; p.CastShadow = false
        end
    end
end
function KT_Stick(item, slot)
    local sp = KT_FindSticky(item)
    local fp = KT_GetFirePart()
    if not sp or not fp then return false end
    pcall(function() setOwnerKT:FireServer(sp, sp.CFrame) end)
    task.wait()
    stickyKT:FireServer(sp, fp, KT_GetCF(slot))
    KT_CleanVisuals(item)
    return true
end
function KT_StickGuaranteed(item, slot)
    while item and item.Parent and KT_Active do
        KT_Stick(item, slot)
        task.wait(0.13)
        if KT_IsStuck(item) then return true end
    end
    return false
end
function KT_Clear(tag)
    local inv = KT_GetInv()
    if not inv then return end
    for _, v in pairs(inv:GetChildren()) do
        if v.Name == tag or v.Name == "NinjaKatana" then
            pcall(function() destroyKT:FireServer(v) end)
        end
    end
end
function KT_Spawn(tag)
    local t = tick()
    while not canSpawnKT.Value do
        if not KT_Active or tick()-t > 5 then return nil end
        task.wait(0.01)
    end
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChild("HumanoidRootPart")
    if not h then return nil end
    task.spawn(function()
        pcall(function()
            spawnKT:InvokeServer("NinjaKatana", h.CFrame * CFrame.new(0,12,20), Vector3.zero)
        end)
    end)
    local inv = KT_GetInv()
    if not inv then return nil end
    local item = inv:WaitForChild("NinjaKatana", 6)
    if item then
        local t2 = tick()
        while not KT_FindSticky(item) do
            if tick()-t2 > 3 then break end
            task.wait(0.05)
        end
    end
    return item
end
function KT_RunLoop(tag, slot)
    task.spawn(function()
        while KT_Active do
            task.wait(0.15)
            if not KT_IsAlive() then
                repeat task.wait(0.2) until KT_IsAlive() or not KT_Active
                task.wait(0.3); continue
            end
            local inv  = KT_GetInv()
            local item = inv and (inv:FindFirstChild(tag) or inv:FindFirstChild("NinjaKatana"))
            if not item or not item.Parent then
                KT_Clear(tag); item = KT_Spawn(tag)
                if not item then continue end
                item.Name = tag; KT_CleanVisuals(item)
            end
            if not KT_IsStuck(item) then
                KT_StickGuaranteed(item, slot)
                if item and item.Parent then item.Name = tag end
            end
            while KT_Active and item and item.Parent and KT_IsAlive() do
                if not KT_IsStuck(item) then KT_StickGuaranteed(item, slot) end
                task.wait(0.3)
            end
        end
        KT_Clear(tag)
    end)
end
function KT_Start()
    KT_Active = true
    task.spawn(function()
        local slots = { {tag="KT_Right", slot=1}, {tag="KT_Left", slot=2} }
        for _, s in ipairs(slots) do
            if not KT_Active then break end
            local inv  = KT_GetInv()
            local item = inv and inv:FindFirstChild(s.tag)
            if not item then item = KT_Spawn(s.tag) end
            if item then
                item.Name = s.tag
                local ref, sl = item, s.slot
                task.spawn(function()
                    KT_CleanVisuals(ref)
                    KT_StickGuaranteed(ref, sl)
                end)
            end
            task.wait(0.5)
        end
        if KT_Active then
            KT_RunLoop("KT_Right", 1)
            KT_RunLoop("KT_Left",  2)
        end
    end)
end
function KT_Stop()
    KT_Active = false
    task.wait(0.5)
    KT_Clear("KT_Right")
    KT_Clear("KT_Left")
end
_TrackConn(LocalPlayer.CharacterAdded:Connect(function()
    if not KT_Active then return end
    KT_Active = false; task.wait(1); KT_Start()
end))

