-- KILL ALL (Loop Kill constant sur tous les joueurs) - Méthode Apex Blobman
-- =========================================================================
do
    local BKLA = false  -- BlobKillAll flag
    local BKLAWL = true  -- Respect whitelist/friends
    local blob = nil
    local blobbin = false
    local expectingblob = false
    
    local RS_Blob = game:GetService("ReplicatedStorage")
    local GrabEvents = RS_Blob:WaitForChild("GrabEvents")
    local SNO_Blob = GrabEvents:WaitForChild("SetNetworkOwner")
    local DGL_Blob = GrabEvents:WaitForChild("DestroyGrabLine")
    local SpawnToy_Blob = RS_Blob:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local DestroyToy_Blob = RS_Blob:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    
    function checkgrab(itm, safe)
        safe = safe or false
        if safe then
            for _, prt in pairs(itm:GetChildren()) do
                if prt:FindFirstChild('PartOwner') and prt.PartOwner.Value == Player.Name then
                    return true
                end
            end
            return false
        else
            if itm:FindFirstAncestor('Plots') or itm:FindFirstAncestor('Slots') or itm:FindFirstAncestor('Map') then
                return false
            end
            local prt = itm:FindFirstChild('SoundPart') or itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('Main')
            if itm:FindFirstChild('Humanoid') then
                if not itm.Humanoid.SeatPart then
                    if prt and prt.ReceiveAge ~= 0 then return false end
                elseif itm.Humanoid.SeatPart.Parent then
                    return checkgrab(itm.Humanoid.SeatPart.Parent)
                end
            elseif prt and prt.ReceiveAge ~= 0 then
                return false
            end
            return true
        end
    end
    
    function IsInPlot_Blob(targetPlayer)
        if not targetPlayer then return false end
        
        local inPlot = targetPlayer:FindFirstChild("InPlot")
        if not inPlot then return false end
        
        return inPlot.Value == true
    end
    
    function BlobKickLoop()
        task.spawn(function()
            local __rid = _G.HelperOtherRunId; while _G.HelperOtherRunId == __rid do
                task.wait()
                
                blobbin = false
                
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= Player and BKLA then
                        -- Skip si dans un plot
                        if IsInPlot_Blob(plr) then continue end
                        
                        local continue1 = "Kill"
                        local continue = false
                        
                        if plr.Character and plr.Character:FindFirstChild('HumanoidRootPart') then
                            if plr.Character.HumanoidRootPart.Massless then
                                if plr.Character.Humanoid.SeatPart then
                                    continue = true
                                end
                            else
                                continue = true
                            end
                        end
                        
                        local smegma = true
                        
                        while smegma and Player.Character and Player.Character:FindFirstChild('HumanoidRootPart') and plr and plr.Character and plr.Character:FindFirstChild('HumanoidRootPart') and plr.Character.HumanoidRootPart.CFrame.Position.Magnitude < 1000000 and plr.Character:FindFirstChild('Humanoid') and plr.Character.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead and continue and BKLA do
                            
                            if IsInPlot_Blob(plr) then
                                smegma = false
                                break
                            end
                            
                            if not BKLA then smegma = false break end
                            
                            blobbin = true
                            
                            if smegma and Player.Character and Player.Character:FindFirstChild('Humanoid') and plr.Character.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead and Player.Character.Humanoid.SeatPart and Player.Character.Humanoid.SeatPart.Parent and Player.Character.Humanoid.SeatPart.Parent.Name == 'CreatureBlobman' then
                                expectingblob = true
                                blob = Player.Character.Humanoid.SeatPart.Parent
                                
                                if blob:FindFirstChild('HumanoidCreature') then
                                    blob.HumanoidCreature.PlatformStand = true
                                end
                                
                                if blob:WaitForChild('RightDetector', 0.5) and blob.RightDetector:WaitForChild('RightWeld', 0.5) then
                                    Player.Character.HumanoidRootPart.CFrame = (plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, -20, 10)) + (plr.Character.HumanoidRootPart.AssemblyLinearVelocity / math.pi)
                                    Player.Character.HumanoidRootPart.AssemblyLinearVelocity = plr.Character.HumanoidRootPart.AssemblyLinearVelocity
                                    
                                    if plr.Character and plr.Character:FindFirstChild('HumanoidRootPart') then
                                        if plr.Character:FindFirstChild('Humanoid') and plr.Character.Humanoid.Health ~= 0 then
                                            plr.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Dead)
                                            blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(blob.RightDetector, plr.Character.HumanoidRootPart, blob.RightDetector.RightWeld)
                                            blob.BlobmanSeatAndOwnerScript.CreatureRelease:FireServer(blob.RightDetector.RightWeld, plr.Character.HumanoidRootPart)
                                        end
                                    end
                                else
                                    DestroyToy_Blob:FireServer(workspace:FindFirstChild(Player.Name .. 'SpawnedInToys'):FindFirstChild('CreatureBlobman'))
                                end
                            else
                                expectingblob = true
                                
                                if Player.Character:FindFirstChild('Humanoid') and Player.Character.Humanoid.SeatPart and (Player.Character.Humanoid.SeatPart.Parent and Player.Character.Humanoid.SeatPart.Parent.Name ~= 'CreatureBlobman' or not Player.Character.Humanoid.SeatPart.Parent) then
                                    Player.Character.Humanoid.Sit = false
                                end
                                
                                if blob and blob:FindFirstChild('VehicleSeat') then
                                    if Player.Character and Player.Character:FindFirstChild('Humanoid') and plr.Character.Humanoid:GetState() ~= Enum.HumanoidStateType.Dead then
                                        blob.VehicleSeat:Sit(Player.Character.Humanoid)
                                    end
                                else
                                    if Player.Character and Player.Character:FindFirstChild('HumanoidRootPart') then
                                        while smegma and not blob and BKLA do
                                            if IsInPlot_Blob(plr) then
                                                smegma = false
                                                break
                                            end
                                            
                                            if not BKLA then smegma = false break end
                                            
                                            if workspace:FindFirstChild(Player.Name .. 'SpawnedInToys'):FindFirstChild('CreatureBlobman') then
                                                blob = workspace:FindFirstChild(Player.Name .. 'SpawnedInToys'):FindFirstChild('CreatureBlobman')
                                                
                                                if not (blob:WaitForChild('RightDetector', 0.5) and blob:FindFirstChild('RightDetector') and blob.RightDetector:WaitForChild('RightWeld', 0.5)) then
                                                    DestroyToy_Blob:FireServer(blob)
                                                    blob = nil
                                                end
                                            end
                                            
                                            if not blob then
                                                task.spawn(function()
                                                    SpawnToy_Blob:InvokeServer('CreatureBlobman', CFrame.new(Player.Character.HumanoidRootPart.CFrame.Position) + Vector3.new(0, 0, 15), Vector3.new(0, 0, 0))
                                                end)
                                            end
                                            
                                            task.wait()
                                        end
                                    end
                                end
                            end
                            
                            task.wait()
                        end
                    end
                end
                
                if not blobbin and blob then
                    if Player.Character and Player.Character:FindFirstChild('Humanoid') and Player.Character.Humanoid.SeatPart and Player.Character.Humanoid.SeatPart.Parent == blob then
                        Player.Character.Humanoid.Sit = false
                    end
                    
                    task.wait()
                    
                    if blob and blob:FindFirstChild('HumanoidRootPart') then
                        blob.HumanoidRootPart.CFrame = CFrame.new(0, 1e15, 0)
                    end
                    
                    blob = nil
                end
            end
        end)
    end
    
    BlobKickLoop()
    
    DefenseExtra:CreateToggle({
        Name     = "Kill All (Blobman)",
        Flag     = "KillAllBlobman",
        Default  = false,
