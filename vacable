    -- 👻 Noclip Formation : MES toys de la formation ne se collisionnent pas ENTRE EUX (NoCollisionConstraint par paire),
    --    ils gardent leurs collisions avec le sol, la map, les joueurs et les toys des autres. Rien n'est modifié sur CanCollide.
    _G._FigureNoclip = false
    _G._FigureNC      = {}   -- [modèle] = { t = dernier passage, p = dernier balayage, parts = { BasePart } }
    _G._FigureNCList  = {}   -- { { c = constraint, a = modèleA, b = modèleB } }

    local function _ncMyFolder() return workspace:FindFirstChild(Player.Name .. "SpawnedInToys") end

    -- TOUTES les pièces du toy (aucune limite)
    local function _ncParts(model)
        local list = {}
        if model:IsA("BasePart") then list[1] = model end
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then list[#list + 1] = d end
        end
        return list
    end

    local function _ncLink(mA, eA, mB, eB)
        for _, pa in ipairs(eA.parts) do
            for _, pb in ipairs(eB.parts) do
                local c = Instance.new("NoCollisionConstraint")
                c.Name = "HelperFigureNC"
                c.Part0, c.Part1 = pa, pb
                c.Parent = pa
                _G._FigureNCList[#_G._FigureNCList + 1] = { c = c, a = mA, b = mB }
            end
        end
    end

    local function _ncRemove(model)
        local keep = {}
        for _, r in ipairs(_G._FigureNCList) do
            if r.a == model or r.b == model then
                pcall(function() r.c:Destroy() end)
            elseif r.c and r.c.Parent then
                keep[#keep + 1] = r
            end
        end
        _G._FigureNCList = keep
        _G._FigureNC[model] = nil
    end

    -- appelé à chaque frame pour chaque toy de la formation (tête + corps)
    -- force = true pour le toy de tête (toy contrôlé) : toujours inclus, même si c'est une pièce / un clone hors du dossier
    _G._FigureNoclipApply = function(part, force)
        if not _G._FigureNoclip or not part or not part.Parent then return end
        local model = part:FindFirstAncestorOfClass("Model")
        local inv = _ncMyFolder()
        if force then
            -- remonte jusqu'au toy dans mon dossier si possible, sinon la pièce elle-même
            local cur = part
            while cur and cur.Parent and cur.Parent ~= inv and cur.Parent ~= workspace do cur = cur.Parent end
            model = (inv and cur and cur.Parent == inv) and cur or model or part
        elseif not model or not inv or model.Parent ~= inv then
            -- uniquement MES toys (enfants directs de mon dossier SpawnedInToys)
            return
        end
        local now = os.clock()
        local e = _G._FigureNC[model]
        if e then
            e.t = now
            return
        end
        e = { t = now, p = now, parts = _ncParts(model) }
        for other, oe in pairs(_G._FigureNC) do
            if other.Parent then _ncLink(model, e, other, oe) end
        end
        _G._FigureNC[model] = e
    end

    -- retire les contraintes (tous les toys, ou seulement ceux qui ne sont plus dans la formation)
    _G._FigureNoclipRestore = function(onlyStale)
        local now = os.clock()
        for model, e in pairs(_G._FigureNC) do
            if not onlyStale or (now - e.t) > 1 or not model.Parent then
                _ncRemove(model)
            end
        end
    end

