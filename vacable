            tween(track, 0.2, { BackgroundTransparency = on and 0.1 or 0.8 })
            tween(knob, 0.2, {
                Position = on and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = on and Color3.new(0, 0, 0) or Color3.new(1, 1, 1),
            })
        end
        _TrackConn(track.MouseButton1Click:Connect(function()
            S[key] = not S[key]
            refresh()
            if onChange then onChange(S[key]) end
            saveState()
        end))
        table.insert(rows, { key = key, refresh = refresh, apply = onChange })
