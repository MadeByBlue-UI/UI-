        function Radial:_freezeView(on)
            local CAS = game:GetService("ContextActionService")
            local RunS = game:GetService("RunService")
            local nm = "RadialFreeze_" .. tostring(self.gui and self.gui.Name or "x")
            pcall(function() CAS:UnbindAction(nm) end)
            pcall(function() RunS:UnbindFromRenderStep(nm) end)
            if not on then return end
            pcall(function()
                CAS:BindActionAtPriority(nm, function() return Enum.ContextActionResult.Sink end, false, 3000,
                    Enum.UserInputType.MouseMovement, Enum.UserInputType.MouseWheel)
            end)
            local cam0 = workspace.CurrentCamera
            if cam0 then
                local frozenRot = cam0.CFrame - cam0.CFrame.Position
                pcall(function()
                    RunS:BindToRenderStep(nm, Enum.RenderPriority.Camera.Value + 1, function()
                        local c = workspace.CurrentCamera
                        if c then c.CFrame = CFrame.new(c.CFrame.Position) * frozenRot end
                    end)
                end)
            end
        end

