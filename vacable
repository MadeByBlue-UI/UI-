    -- Fonction principale de kick avec OWNERSHIP GRAB
    function executeKickSequence()
        _dbg("[KICK DEBUG] kickTargetPlayer =", kickTargetPlayer)
        
        local targetPlayer = Players:FindFirstChild(kickTargetPlayer)
        
        if not targetPlayer then
            notify("Kick Ownership", "❌ Joueur non trouvé: " .. tostring(kickTargetPlayer), 3)
            return
        end
        
        notify("Kick Ownership", "🎯 Début séquence kick sur " .. targetPlayer.DisplayName, 2)
        
        kickOwnershipActive = true
        
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then 
            notify("Kick Ownership", "❌ Pas de HRP local", 2)
            return 
        end
        
        local savedPos = myRoot.CFrame
        local ownershipGrabbed = false
        
        -- PHASE 1: GRAB OWNERSHIP en TP sous le joueur
        local tChar = targetPlayer.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then
            notify("Kick Ownership", "❌ Cible sans HRP", 2)
            return
        end
        
        notify("Kick Ownership", "📡 Grab ownership...", 2)
        
        local tpStart = tick()
        while kickOwnershipActive and tick() - tpStart < 1.5 do
            myChar = LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then break end
            
            -- TP 2 studs sous la cible pour grab
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, -2, 0)
            
            pcall(function()
                SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
                if grabEvents then
                    local destroyLine = grabEvents:FindFirstChild("DestroyGrabLine")
                    if destroyLine then
                        destroyLine:FireServer(tRoot)
                    end
                end
            end)
            
            -- Check ownership
            local po = tRoot:FindFirstChild("PartOwner")
            if po and po.Value == LocalPlayer.Name then
                ownershipGrabbed = true
                break
            end
            
            task.wait(0.05)
        end
        
        -- Retour position d'origine
        if myRoot and myRoot.Parent then
            myRoot.CFrame = savedPos
        end
        
        if not ownershipGrabbed then
            notify("Kick Ownership", "❌ Échec grab ownership", 3)
            kickOwnershipActive = false
            return
        end
        
        notify("Kick Ownership", "✅ Ownership grabbed!", 2)
        
        -- PHASE 2: LOCK AU-DESSUS + SPAM RAGDOLL
        notify("Kick Ownership", "  Lock au-dessus + ragdoll spam...", 2)
        
        local lockHeight = 15
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.P = 100000
        bp.D = 5000
        
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 100000
        bg.D = 5000
        
        bp.Parent = tRoot
        bg.Parent = tRoot
        
        -- Loop de maintien jusqu'à ce que le joueur parte
        task.spawn(function()
            local charEvents = ReplicatedStorage:FindFirstChild("CharacterEvents")
            local ragdollRE = charEvents and charEvents:FindFirstChild("RagdollRemote")
            local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
            
            while kickOwnershipActive do
                local currentTarget = Players:FindFirstChild(kickTargetPlayer)
                if not currentTarget or not currentTarget.Character then
                    notify("Kick Ownership", "✅ " .. kickTargetPlayer .. " a quitté!", 3)
                    break
                end
                
                tChar = currentTarget.Character
                tRoot = tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar:FindFirstChild("Humanoid")
                
                if not tRoot or not tHum or tHum.Health <= 0 then break end
                
                myChar = LocalPlayer.Character
                myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then break end
                
                -- Position au-dessus du local player
                local lockPos = myRoot.Position + Vector3.new(0, lockHeight, 0)
                
                if bp and bp.Parent then
                    bp.Position = lockPos
                end
                if bg and bg.Parent then
                    bg.CFrame = CFrame.new(lockPos)
                end
                
                -- Spam ownership + ragdoll + cancel velocity
                pcall(function()
                    tRoot.AssemblyLinearVelocity = Vector3.zero
                    tHum.PlatformStand = true
                    SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                    
                    if grabEvents then
                        local destroyLine = grabEvents:FindFirstChild("DestroyGrabLine")
                        if destroyLine then
                            destroyLine:FireServer(tRoot)
                        end
                    end
                    
                    if ragdollRE then
                        ragdollRE:FireServer(tChar, true)
                    end
                end)
                
                task.wait(0.05)
            end
            
            -- Cleanup
            pcall(function()
                if bp then bp:Destroy() end
                if bg then bg:Destroy() end
            end)
            
            kickOwnershipActive = false
            notify("Kick Ownership", "🛑 Séquence terminée", 2)
        end)
    end
    
