    function findCoinLabels()
        coinLabels = {}
        local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
        
        -- Cherche dans tous les GUI possibles
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                for _, desc in ipairs(gui:GetDescendants()) do
                    if desc:IsA("TextLabel") then
                        local text = desc.Text
                        -- Cherche les patterns de coins
                        if text:match("^%d+$") or text:match("Coins?%s*:%s*%d+") or text:match("%d+%s*Coins?") then
                            table.insert(coinLabels, desc)
                            
                            -- Stocke la valeur initiale des vrais coins
                            local coinValue = tonumber(text:match("%d+"))
                            if coinValue and lastRealCoins == 0 then
                                lastRealCoins = coinValue
                            end
                        end
                    end
                end
            end
        end
    end
    
    function updateFakeCoins()
        if not fakeCoinsEnabled then return end
        
        -- Met à jour la liste des labels de coins
        findCoinLabels()
        
        -- Applique les fake coins
        for _, label in ipairs(coinLabels) do
            if label and label.Parent then
                -- Récupère la vraie valeur actuelle
                local currentRealText = label.Text:match("%d+")
                local currentRealCoins = tonumber(currentRealText) or 0
                
                -- Si les coins ont augmenté, ajoute la différence aux fake coins
                if currentRealCoins > lastRealCoins then
                    local gained = currentRealCoins - lastRealCoins
                    fakeCoinsAmount = fakeCoinsAmount + gained
                    lastRealCoins = currentRealCoins
                    notify("Fake Coins", "✨ Gained: +" .. gained .. " | Total: " .. fakeCoinsAmount, 2)
                end
                
                -- Affiche les fake coins
                label.Text = tostring(fakeCoinsAmount)
            end
        end
    end
    
