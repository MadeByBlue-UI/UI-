                                            local backIndex = i - frontToys - middleToys
                                            local backProgress = (backIndex - 1) / backToys
                                            
                                            -- Demi-cercle arrière
                                            local angle = math.pi + backProgress * math.pi
                                            local x = math.cos(angle) * shieldRadius * 0.7
                                            local y = shieldHeight + math.sin(backProgress * math.pi) * shieldRadius * 0.3
                                            local z = math.sin(angle) * shieldRadius * 0.7
                                            
                                            -- Garde l'arrière (z < 5)
                                            if z > 5 then z = 5 end
                                            
                                            targetPos = centerPos + (rotCFrame * Vector3.new(x, y, z))
                                        end
                                    
                                    elseif tornadoFormation == "Train" then
                                        -- Formation Train : VRAI SERPENT qui suit l'historique des positions
                                        -- Chaque toy suit exactement où était le toy précédent (ou le joueur pour le premier)
                                        
                                        local char = Player.Character
                                        local root = char and char:FindFirstChild("HumanoidRootPart")
                                        
                                        if root then
                                            -- 🐍 ENREGISTRE la position actuelle du joueur dans l'historique
                                            -- On enregistre seulement si le joueur a bougé (pour éviter spam)
                                            local shouldRecord = true
                                            if #trainPositionHistory > 0 then
                                                local lastPos = trainPositionHistory[1].pos
                                                local distance = (centerPos - lastPos).Magnitude
                                                -- Enregistre seulement si déplacement > 0.2 studs (réduit pour plus de précision)
                                                shouldRecord = distance > 0.2
                                            end
                                            
                                            if shouldRecord then
                                                table.insert(trainPositionHistory, 1, {
                                                    pos = centerPos,
                                                    cf = root.CFrame,
                                                    time = tick(),
                                                    distanceFromHead = 0  -- Distance cumulée (0 pour la tête)
                                                })
                                                
                                                -- Calcule les distances cumulées pour chaque position
                                                for idx = 2, #trainPositionHistory do
                                                    local prev = trainPositionHistory[idx - 1]
                                                    local curr = trainPositionHistory[idx]
                                                    local dist = (prev.pos - curr.pos).Magnitude
                                                    curr.distanceFromHead = prev.distanceFromHead + dist
                                                end
                                                
                                                -- Debug: affiche la taille de l'historique toutes les 60 frames
                                                if #trainPositionHistory % 60 == 0 then
                                                    _dbg("[TRAIN DEBUG] Historique:", #trainPositionHistory, "positions, Distance totale:", trainPositionHistory[#trainPositionHistory].distanceFromHead or 0)
                                                end
