-- =========================================================================
-- ANTI-KICK [PICKAXE] ALL - Spawn une fois puis surveille détachements
-- =========================================================================
do
    local RS2 = game:GetService("ReplicatedStorage")
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    
    local setOwnerAK = RS2:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
    local stickyEvent = RS2:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
    local spawnRemoteAK = RS2:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local destroyRemAK = RS2:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    local canSpawnAK = Player:WaitForChild("CanSpawnToy")
    
    local AK_ALL_Active = false
    local STICK_CFRAME = CFrame.new(0.3, 0.5, 0.7) * CFrame.Angles(math.rad(90), 15, 0)
    
    -- Fonction pour vérifier si une pioche est attachée
    function IsAttached(pickaxe)
        if not pickaxe or not pickaxe:FindFirstChild("StickyPart") then return false end
        local stickyWeld = pickaxe.StickyPart:FindFirstChild("StickyWeld")
        return stickyWeld and stickyWeld.Part1 ~= nil
    end
    
    -- Fonction pour vérifier si un joueur est dans un plot
    function IsPlayerInPlot(targetPlayer)
        if not targetPlayer then return false end
        
        local inPlot = targetPlayer:FindFirstChild("InPlot")
        if not inPlot then return false end
        
        return inPlot.Value == true
    end
    
    -- Fonction pour spawn et attacher une pioche sur un joueur
    function SpawnAndAttachPickaxe(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return nil end
        
        -- VÉRIFICATION : Si le joueur est dans un plot, skip
        if IsPlayerInPlot(targetPlayer) then
            -- notify("Anti-Kick", "⚠️ " .. targetPlayer.Name .. " est dans un plot → skip", 1)
            return nil
        end
        
        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local firePart = targetHRP and targetHRP:FindFirstChild("FirePlayerPart")
        if not firePart then return nil end
        
        local myChar = Player.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return nil end
        
        local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
        if not inv then return nil end
        
        -- Attendre CanSpawn
        if not canSpawnAK.Value then
            local t = tick()
            repeat task.wait(0.05) until canSpawnAK.Value or tick() - t > 3
        end
        
        -- Spawn visible au-dessus et devant TOI (méthode Anti-Kick ITEM)
        task.spawn(function()
            pcall(function()
                spawnRemoteAK:InvokeServer("ToolPickaxe", myHRP.CFrame * CFrame.new(0, 9, 20), Vector3.zero)
            end)
        end)
        
        -- Attendre le spawn
        task.wait(0.08)
        local pickaxe = inv:FindFirstChild("ToolPickaxe")
        if not pickaxe then return nil end
        
        pickaxe.Name = "AK_Pickaxe_" .. targetPlayer.Name
        
        -- Désactiver les collisions mais garder visible
        for _, obj in pairs(pickaxe:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanTouch = false
                obj.CanCollide = false
                obj.CanQuery = false
                -- obj.Transparency = 1  -- Commenté pour garder visible
            end
        end
        
        -- Claim ownership
        local stickyPart = pickaxe:FindFirstChild("StickyPart")
        if stickyPart then
            pcall(function()
                setOwnerAK:FireServer(stickyPart, stickyPart.CFrame)
            end)
            
            -- Colle sur le joueur
            pcall(function()
                stickyEvent:FireServer(stickyPart, firePart, STICK_CFRAME)
            end)
            
            -- Vérifier après 2 secondes si l'attachement a réussi
            task.delay(2, function()
                if pickaxe and pickaxe.Parent and not IsAttached(pickaxe) then
                    -- Pioche non attachée après 2s → détruire
                    pcall(function()
                        destroyRemAK:FireServer(pickaxe)
                    end)
                    notify("Anti-Kick", "⚠️ Pioche non attachée sur " .. targetPlayer.Name .. " → détruite", 2)
                end
            end)
        end
        
        notify("Anti-Kick", "⛏️ Pioche attachée sur " .. targetPlayer.Name, 2)
        return pickaxe
    end
    
    -- Toggle UI
    DefenseExtra:CreateToggle({
        Name     = "Anti-Kick [Pickaxe] ALL",
        Flag     = "AntiKickPickaxeAll",
        Default  = false,
        Callback = function(Value)
            AK_ALL_Active = Value
            
            if Value then
                notify("Anti-Kick", "⛏️ Système Pioche activé!", 3)
                
                task.spawn(function()
                    -- 1. Spawn initial sur tous les joueurs
                    for _, targetPlayer in pairs(Players:GetPlayers()) do
                        if targetPlayer ~= Player and AK_ALL_Active then
                            SpawnAndAttachPickaxe(targetPlayer)
                            task.wait(0.5)  -- Délai entre chaque spawn
                        end
                    end
                    
                    -- 2. Surveille les détachements ET respawn si manquant (5 fois par seconde)
                    local lastCheck = 0
                    local checkInterval = 0.2  -- 5 fois par seconde (1/5 = 0.2)
                    local reattachCooldowns = {}  -- Cooldown par pioche pour éviter spam
                    local expectedPickaxes = {}  -- Liste des joueurs qui doivent avoir une pioche
                    
                    -- Initialiser la liste des joueurs attendus
                    for _, targetPlayer in pairs(Players:GetPlayers()) do
                        if targetPlayer ~= Player then
                            expectedPickaxes[targetPlayer.Name] = true
                        end
                    end
                    
                    local monitorConn = RunService.Heartbeat:Connect(function()
                        if not AK_ALL_Active then return end
                        
                        -- Limiter à 5 vérifications par seconde
                        local now = tick()
                        if now - lastCheck < checkInterval then
                            return  -- Skip cette frame
                        end
                        lastCheck = now
                        
                        local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                        if not inv then return end
                        
                        -- Vérifier les pioches existantes
                        local foundPickaxes = {}
                        for _, pickaxe in pairs(inv:GetChildren()) do
                            if pickaxe.Name:match("^AK_Pickaxe_") and AK_ALL_Active then
                                local playerName = pickaxe.Name:gsub("^AK_Pickaxe_", "")
                                local targetPlayer = Players:FindFirstChild(playerName)
                                
                                if targetPlayer and targetPlayer.Character then
                                    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    
                                    if targetHRP then
                                        foundPickaxes[playerName] = true
                                        
                                        -- VÉRIFICATION : Si le joueur est dans un plot, détruire la pioche
                                        if IsPlayerInPlot(targetPlayer) then
                                            local pickaxeName = pickaxe.Name
                                            pcall(function() destroyRemAK:FireServer(pickaxe) end)
                                            reattachCooldowns[pickaxeName] = nil
                                            -- notify("Anti-Kick", "🏠 " .. playerName .. " dans plot → pioche détruite", 1)
                                            continue
                                        end
                                        
                                        -- Vérifier la distance entre la pioche et le joueur
                                        local pickaxePos = pickaxe:FindFirstChild("StickyPart") and pickaxe.StickyPart.Position or pickaxe:GetPivot().Position
                                        local distance = (pickaxePos - targetHRP.Position).Magnitude
                                        
                                        -- Si la pioche est trop loin (> 15 studs), la détruire et respawn
                                        if distance > 2 then
                                            local pickaxeName = pickaxe.Name
                                            local lastRespawn = reattachCooldowns[pickaxeName] or 0
                                            if now - lastRespawn >= 0.45 then
                                                -- Détruire l'ancienne pioche
                                                pcall(function() destroyRemAK:FireServer(pickaxe) end)
                                                
                                                -- Respawn une nouvelle
                                                task.spawn(function()
                                                    task.wait(0.15)
                                                    SpawnAndAttachPickaxe(targetPlayer)
                                                    reattachCooldowns[pickaxeName] = tick()
                                                end)
                                                
                                                notify("Anti-Kick", "🔄 " .. playerName .. " trop loin → respawn", 2)
                                            end
                                            continue
                                        end
                                        
                                        -- Vérifier le cooldown (0.45 seconde entre chaque réattachement)
                                        local lastReattach = reattachCooldowns[pickaxe.Name] or 0
                                        if now - lastReattach < 0.45 then
                                            continue  -- Skip si cooldown actif
                                        end
                                        
                                        -- Si détachée, réattacher
                                        if not IsAttached(pickaxe) then
                                            local firePart = targetHRP:FindFirstChild("FirePlayerPart")
                                            local stickyPart = pickaxe:FindFirstChild("StickyPart")
                                            
                                            if firePart and stickyPart then
                                                -- Claim ownership
                                                pcall(function()
                                                    setOwnerAK:FireServer(stickyPart, stickyPart.CFrame)
                                                end)
                                                
                                                -- Réattacher
                                                pcall(function()
                                                    stickyEvent:FireServer(stickyPart, firePart, STICK_CFRAME)
                                                end)
                                                
                                                -- Enregistrer le cooldown
                                                reattachCooldowns[pickaxe.Name] = now
                                            end
                                        end
                                    end
                                else
                                    -- Joueur parti, détruire la pioche et nettoyer
                                    pcall(function() destroyRemAK:FireServer(pickaxe) end)
                                    reattachCooldowns[pickaxe.Name] = nil
                                    expectedPickaxes[playerName] = nil
                                end
                            end
                        end
                        
                        -- Vérifier les joueurs sans pioche et respawn si nécessaire
                        for playerName, _ in pairs(expectedPickaxes) do
                            if not foundPickaxes[playerName] then
                                local targetPlayer = Players:FindFirstChild(playerName)
                                if targetPlayer and targetPlayer.Character then
                                    -- VÉRIFICATION : Si le joueur est dans un plot, skip le respawn
                                    if IsPlayerInPlot(targetPlayer) then
                                        -- Ne pas respawn pour les joueurs dans un plot
                                        continue
                                    end
                                    
                                    -- Cooldown pour respawn aussi (évite spam)
                                    local pickaxeName = "AK_Pickaxe_" .. playerName
                                    local lastRespawn = reattachCooldowns[pickaxeName] or 0
                                    if now - lastRespawn >= 0.45 then
                                        task.spawn(function()
                                            SpawnAndAttachPickaxe(targetPlayer)
                                            reattachCooldowns[pickaxeName] = tick()
                                        end)
                                    end
                                else
                                    -- Joueur parti, retirer de la liste
                                    expectedPickaxes[playerName] = nil
                                end
                            end
                        end
                    end)
                    
                    -- 3. Gère les nouveaux joueurs
                    local playerAddedConn = Players.PlayerAdded:Connect(function(newPlayer)
                        if not AK_ALL_Active or newPlayer == Player then return end
                        expectedPickaxes[newPlayer.Name] = true  -- Ajouter à la liste attendue
                        task.wait(1)  -- Attend que le personnage spawn
                        if AK_ALL_Active then
                            SpawnAndAttachPickaxe(newPlayer)
                        end
                    end)
                    
                    -- 4. Gère les joueurs qui quittent
                    local playerRemovingConn = Players.PlayerRemoving:Connect(function(leavingPlayer)
                        expectedPickaxes[leavingPlayer.Name] = nil
                        reattachCooldowns["AK_Pickaxe_" .. leavingPlayer.Name] = nil
                    end)
                    
                    -- Attendre désactivation
                    repeat task.wait(1) until not AK_ALL_Active
                    
                    -- Nettoyage des connexions
                    if monitorConn then monitorConn:Disconnect() end
                    if playerAddedConn then playerAddedConn:Disconnect() end
                    if playerRemovingConn then playerRemovingConn:Disconnect() end
                end)
            else
                notify("Anti-Kick", "Système désactivé", 2)
                AK_ALL_Active = false
                
                -- Nettoyer toutes les pioches
                task.wait(0.3)
                local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                if inv then
                    for _, item in pairs(inv:GetChildren()) do
                        if item.Name:match("^AK_Pickaxe_") then
                            pcall(function() destroyRemAK:FireServer(item) end)
                        end
                    end
                end
            end
        end,
    })
end

