-- =========================================================================
-- INFRASTRUCTURE (debug, pcall, chargement sécurisé)
-- _G.HelperDebug = true  -> affiche les erreurs avalées par pcall et les messages _dbg()
-- =========================================================================
_G.HelperDebug = _G.HelperDebug or false

function _dbg(...)
    if _G.HelperDebug then print(...) end
end

if not _G.HelperRawPcall then _G.HelperRawPcall = pcall end
function _HelperPcallCheck(ok, ...)
    if not ok and _G.HelperDebug then warn("[pcall]", ...) end
    return ok, ...
end
pcall = function(f, ...) return _HelperPcallCheck(_G.HelperRawPcall(f, ...)) end

-- Chargement d'un script distant avec gestion d'erreur (retourne nil si échec)
function _SafeLoad(url, label)
    local okGet, body = _G.HelperRawPcall(function() return game:HttpGet(url) end)
    if not okGet or type(body) ~= "string" or body == "" then
        warn("[Helper] Téléchargement impossible : " .. tostring(label or url))
        return nil
    end
    local fn, err = loadstring(body)
    if not fn then
        warn("[Helper] Script invalide (" .. tostring(label or url) .. ") : " .. tostring(err))
        return nil
    end
    local okRun, res = _G.HelperRawPcall(fn)
    if not okRun then
        warn("[Helper] Erreur d'exécution (" .. tostring(label or url) .. ") : " .. tostring(res))
        return nil
    end
    return res
end

