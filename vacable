        pcall(function()                                                                  -- nouveau chat (TextChatService)
            _TrackConn(game:GetService("TextChatService").MessageReceived:Connect(function(m)
                local src = m.TextSource
                if src and src.UserId == Player.UserId then onChat(m.Text) end
            end))
        end)

