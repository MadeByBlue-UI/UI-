    -- =====================================================================
    -- COCONUT SNAKE (Formation serpent smooth avec Object Control)
    -- =====================================================================
    do
        local snakeLength = 10
        local snakeSmooth = 8
        local snakeSpacing = 2.5
        local snakeMethod = "CFrame Direct"  -- Méthode par défaut
        local snakeMode = "Normal"  -- Normal ou Bigger

        TrollExtra:CreateDropdown({
            Name = "Snake Mode",
            Flag = "SnakeMode",
            Items = {
                "Normal",
                "Bigger"
            },
