        -- 🔒 VERROU : pendant l'enterrement tu ne peux plus rien faire (ni marcher, ni sauter, ni te tourner) : ton perso est figé, donc
        -- l'animation se joue en entier depuis un point de départ fixe, sans que le perso, la caméra ou la tête ne puissent la perturber.
        function FG.buryLock(on)
            local CAS = game:GetService("ContextActionService")
            if on and not FG._bLock then
                local ch  = LP.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                local L = { hum = hum, hrp = hrp }
                if hum then
                    L.ws, L.jp, L.jh, L.ar = hum.WalkSpeed, hum.JumpPower, hum.JumpHeight, hum.AutoRotate
                    hum.WalkSpeed, hum.JumpPower, hum.JumpHeight, hum.AutoRotate = 0, 0, 0, false
                end
                if hrp then
                    L.anch = hrp.Anchored
                    hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                    hrp.Anchored = true
                end
                pcall(function()
                    CAS:BindActionAtPriority("FigureBuryLock", function() return Enum.ContextActionResult.Sink end, false,
                        Enum.ContextActionPriority.High.Value + 500,
                        Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
                        Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right,
                        Enum.KeyCode.Space, Enum.KeyCode.Thumbstick1, Enum.KeyCode.ButtonA)
                end)
                FG._bLock = L
            elseif not on and FG._bLock then
                local L = FG._bLock
                FG._bLock = nil
                pcall(function() CAS:UnbindAction("FigureBuryLock") end)
                if L.hum and L.hum.Parent then
                    pcall(function()
                        L.hum.WalkSpeed, L.hum.JumpPower, L.hum.JumpHeight, L.hum.AutoRotate = L.ws, L.jp, L.jh, L.ar
                    end)
                end
                if L.hrp and L.hrp.Parent then L.hrp.Anchored = (L.anch == true) end
            end
        end
        -- (re-exécution du script : on libère un éventuel verrou / enterrement resté d'avant)
        _G._FigureBury = nil
        FG.buryLock(false)

        -- 👻 NOCLIP DU JOUEUR ENTERRÉ — même méthode que « Noclip Grab » d'Apex : le Humanoid remet CanCollide = true en permanence,
        -- donc un noclip posé UNE fois ne tient pas. On force CanCollide = false sur TOUTES les parts du perso tenu à chaque
        -- Stepped (avant la physique) ET à chaque Heartbeat (après), tant que l'enterrement dure (nouvelles parts incluses : accessoires...).
        -- Les valeurs d'origine sont mémorisées dans B.saved et restaurées par FG.buryEnd. Les toys de la formation restent noclip aussi.
        function FG.buryNoclipTick()
            for _, C in ipairs({ FG.captured or false, FG.captured2 or false }) do
                local B = C and C.bury
                if B and B.saved and C.root and C.root.Parent then
                    for _, q in ipairs(C.root.Parent:GetDescendants()) do
                        if q:IsA("BasePart") and not q.Anchored then
                            if B.saved[q] == nil then B.saved[q] = { q.CanCollide, q.Massless } end
                            if q.CanCollide then q.CanCollide = false end
                            if not q.Massless then q.Massless = true end
                        end
                    end
                    if FG._tnc then
                        for q in pairs(FG._tnc) do
                            if q.Parent and q.CanCollide then q.CanCollide = false end
                        end
                    end
                end
            end
        end
        _TrackConn(game:GetService("RunService").Stepped:Connect(function() pcall(FG.buryNoclipTick) end))
        _TrackConn(game:GetService("RunService").Heartbeat:Connect(function() pcall(FG.buryNoclipTick) end))

