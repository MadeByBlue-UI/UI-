            -- entrées
            local function add(c) table.insert(self.conns, c); _TrackConn(c) end
            add(UIS.InputBegan:Connect(function(input, gpe)
                if gpe or input.KeyCode ~= self.Key or not self.Enabled or self.isOpen then return end
                if UIS:GetFocusedTextBox() then return end
                self:Open()
