        FG.drop  = FG.drop  or -2.2        -- hauteur de la main par rapport à l'épaule (studs)
        -- 🤲 FORME DU BRAS QUI TIENT : le bras (3 toys) suit une courbe (arc) entre l'épaule et la main au lieu d'être tendu droit.
        -- k = bombement (0 = droit, 0.5 = vrai demi-cercle) · side = vers l'extérieur · up = vers le haut (négatif = passe en dessous)
        FG.armShape  = FG.armShape or "Demi-cercle"
        FG.armShapes = {
            ["Droit"]       = { k = 0,    side = 0,   up = 0 },
            ["Arc léger"]   = { k = 0.22, side = 1,   up = 0.2 },
            ["Demi-cercle"] = { k = 0.45, side = 1,   up = 0.3 },
            ["Berceau"]     = { k = 0.40, side = 0.7, up = -0.9 },   -- le bras passe sous le joueur, comme pour le porter
        }
        function FG.armOut(side, right, shape)      -- direction du bombement + valeur k de la forme choisie
            local S = FG.armShapes[shape or FG.armShape] or FG.armShapes["Droit"]
            return right * (side * S.side) + Vector3.new(0, S.up, 0), S.k
        end
        function FG.armCurve(sh, arm, seg, out, k, n)  -- position + tangente du segment seg (1..3, 3 = la main) sur la courbe ; n = nb de segments du bras (3 par défaut, 4 = avec le DiceSmall)
            local nn = n or 3
            local len = arm.Magnitude
            if k <= 0.001 or len < 0.05 then return sh + arm * (seg / nn), arm end
            local au = arm.Unit
            out = out - au * out:Dot(au)             -- bombement toujours perpendiculaire au bras
            out = (out.Magnitude < 0.01) and Vector3.yAxis or out.Unit
            local H = sh + arm
            local C = sh + arm * 0.5 + out * (len * k * 2)
            local t = seg / nn
            local p = sh * ((1 - t) ^ 2) + C * (2 * (1 - t) * t) + H * (t * t)
            local tg = (C - sh) * (2 * (1 - t)) + (H - C) * (2 * t)
            return p, tg
        end
