-- BLACK BUCKET PAINT (Troll avec seau noir retourné)
-- =========================================================================
do
    local blackBucketActive = false
    local bucketConnection = nil
    local currentBucket = nil
    local currentPlayerIndex = 1
    local switchInterval = 2  -- Change de joueur toutes les 2 secondes
    local lastSwitchTime = 0
    
    Tabs.Fun:CreateToggle({
        Name = "🪣 Black Bucket Paint (Troll)",
        Flag = "BlackBucketToggle",
        Default = false,
        Callback = function(v)
            blackBucketActive = v
            
            if bucketConnection then
                bucketConnection:Disconnect()
                bucketConnection = nil
            end
            
            if not v then
                notify("Black Bucket", "❌ Désactivé", 2)
                currentBucket = nil
                currentPlayerIndex = 1
                return
            end
            
            notify("Black Bucket", "🪣 Recherche d'un seau noir...", 2)
            
            -- Fonction pour trouver le BucketPaint
            function findBucket()
                for _, folder in pairs(workspace:GetChildren()) do
                    if folder.Name:find("SpawnedInToys") then
                        for _, item in pairs(folder:GetChildren()) do
                            if item.Name == "BucketPaint" then
                                return item
                            end
                        end
                    end
                end
                return nil
            end
            
            -- Fonction pour spawner un nouveau seau
            function spawnNewBucket()
                pcall(function()
                    game:GetService("ReplicatedStorage").MenuToys.SpawnToy:FireServer("BucketPaint")
                end)
                task.wait(0.5)  -- Attend que le seau spawn
            end
            
            -- Boucle pour obtenir un seau NOIR
            local maxAttempts = 20  -- Maximum 20 essais
            local attempts = 0
            local bucket = nil
            local isBlack = false
            
            repeat
                attempts = attempts + 1
                
                -- Cherche un seau existant
                bucket = findBucket()
                
                if bucket then
                    local fluid = bucket:FindFirstChild("Fluid", true)
                    if fluid then
                        -- Vérifie si le fluid est noir
                        local color = fluid.BrickColor
                        if color == BrickColor.new("Really black") or color == BrickColor.new("Black") then
                            isBlack = true
                            notify("Black Bucket", "✅ Seau NOIR trouvé !", 2)
                        else
                            -- Pas noir → détruit et respawn
                            notify("Black Bucket", "❌ Seau " .. tostring(color) .. " → Destruction...", 1)
                            pcall(function()
                                game:GetService("ReplicatedStorage").MenuToys.DestroyToy:FireServer(bucket)
                            end)
                            task.wait(0.3)
                            spawnNewBucket()
                        end
                    else
                        -- Pas de fluid → respawn
                        pcall(function()
                            game:GetService("ReplicatedStorage").MenuToys.DestroyToy:FireServer(bucket)
                        end)
                        task.wait(0.3)
                        spawnNewBucket()
                    end
                else
                    -- Aucun seau → spawn un nouveau
                    spawnNewBucket()
                end
                
            until isBlack or attempts >= maxAttempts
            
            if not isBlack or not bucket then
                notify("Black Bucket", "❌ Impossible de trouver un seau noir après " .. attempts .. " essais", 5)
                return
            end
            
            currentBucket = bucket
            notify("Black Bucket", "✅ Seau NOIR obtenu après " .. attempts .. " essai(s)", 2)
            
            -- Prend l'ownership du seau
            local success = pcall(function()
                game:GetService("ReplicatedStorage").MenuToys.UnequipToy:FireServer(bucket)
                task.wait(0.1)
                game:GetService("ReplicatedStorage").MenuToys.EquipToy:FireServer(bucket)
            end)
            
            if not success then
                notify("Black Bucket", "⚠️ Erreur ownership", 2)
            end
            
            -- Force le Fluid en Really black pour être sûr
            local fluid = bucket:FindFirstChild("Fluid", true)
            if fluid then
                pcall(function()
                    fluid.BrickColor = BrickColor.new("Really black")
                    fluid.Color = Color3.fromRGB(17, 17, 17)
                end)
            end
            
            -- Boucle de contrôle du seau (fait le tour de TOUS les joueurs)
            bucketConnection = RunService.Heartbeat:Connect(function()
                if not blackBucketActive or not currentBucket or not currentBucket.Parent then
                    return
                end
                
                -- Récupère tous les joueurs sauf toi
                local players = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        table.insert(players, p)
                    end
                end
                
                if #players == 0 then
                    return  -- Aucun joueur à troller
                end
                
                -- Change de joueur toutes les X secondes
                local currentTime = tick()
                if currentTime - lastSwitchTime >= switchInterval then
                    currentPlayerIndex = currentPlayerIndex + 1
                    if currentPlayerIndex > #players then
                        currentPlayerIndex = 1
                    end
                    lastSwitchTime = currentTime
                    
                    local targetPlayer = players[currentPlayerIndex]
                    if targetPlayer then
                        notify("Black Bucket", "🎯 Cible: " .. targetPlayer.Name, 1)
                    end
                end
                
                -- Récupère le joueur cible actuel
                local targetPlayer = players[currentPlayerIndex]
                if not targetPlayer or not targetPlayer.Character then
                    return
                end
                
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not targetRoot then return end
                
                local main = currentBucket:FindFirstChild("Main") or currentBucket:FindFirstChild("PaintPlayerPart")
                if not main then return end
                
                -- Position au-dessus du joueur cible
                local targetPos = targetRoot.Position + Vector3.new(0, 8, 0)
                
                -- Rotation à 180° (retourné)
                local targetCF = CFrame.new(targetPos) * CFrame.Angles(math.rad(180), 0, 0)
                
                -- Applique la position et rotation
                pcall(function()
                    main.CFrame = targetCF
                end)
                
                -- Vérifie que le fluid est toujours noir (force si besoin)
                local fluid = currentBucket:FindFirstChild("Fluid", true)
                if fluid and fluid.BrickColor ~= BrickColor.new("Really black") then
                    pcall(function()
                        fluid.BrickColor = BrickColor.new("Really black")
                        fluid.Color = Color3.fromRGB(17, 17, 17)
                    end)
                end
            end)
            
            notify("Black Bucket", "✅ Seau noir activé (rotation sur tous les joueurs)", 3)
        end
    })
    
    -- Slider pour ajuster la vitesse de changement de cible
    Tabs.Fun:CreateSlider({
        Name = "⏱️ Vitesse changement cible (sec)",
        Flag = "BlackBucketSpeed",
        Min = 1,
        Max = 10,
        Default = 2,
        Callback = function(v)
            switchInterval = v
        end
    })
end
