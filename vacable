    -- Fonction pour appliquer les effets sur un toy
    local function applyFXToToy(toy)
        if not S.globalFXEnabled then return end
        
        for _, part in ipairs(toy:GetDescendants()) do
            if part:IsA("BasePart") then
                -- Sauvegarde les propriétés originales si pas déjà fait
                if not part:GetAttribute("EffectApplied") then
                    part:SetAttribute("OriginalMaterial", part.Material.Name)
                    part:SetAttribute("OriginalColor", tostring(part.Color))
                    part:SetAttribute("OriginalTransparency", part.Transparency)
                    part:SetAttribute("OriginalReflectance", part.Reflectance)
                    part:SetAttribute("EffectApplied", true)
                end
                
                -- Forcefield (seulement si activé dans les toggles)
                if S.forcefield and not part:FindFirstChild("ForceFieldFX") then
                    local ff = Instance.new("ForceField")
                    ff.Name = "ForceFieldFX"
                    ff.Visible = true
                    ff.Parent = part
                end
                
                -- Highlight (seulement si activé dans les toggles)
                if S.highlight and not part:FindFirstChild("HighlightFX") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "HighlightFX"
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.FillColor = S.color
                    hl.OutlineColor = S.color
                    hl.Parent = part
                end
                
                -- Effet Verre
                if S.glass then
                    if not S.forcefield then
                        part.Material = Enum.Material.Glass
                    end
                    part.Transparency = 0.3
                end
                
                -- Effet Neon 💎
                if S.neon then
                    if not S.forcefield then
                        part.Material = Enum.Material.Neon
                    end
                    part.Color = S.color
                    part.Transparency = 0
                end
                
                -- Effet Cristal ✨
                if S.crystal then
                    if not S.forcefield then
                        part.Material = Enum.Material.Glass
                    end
                    part.Color = Color3.fromRGB(150, 200, 255)
                    part.Transparency = 0.2
                    part.Reflectance = 0.4
                end
                
                -- Effet Métal 🔩
                if S.metal then
                    if not S.forcefield then
                        part.Material = Enum.Material.Metal
                    end
                    part.Color = Color3.fromRGB(180, 180, 200)
                    part.Reflectance = 0.6
                end
                
                -- Effet Hologramme 🌐
                if S.hologram then
                    if not S.forcefield then
                        part.Material = Enum.Material.Neon
                    end
                    part.Color = Color3.fromRGB(0, 255, 255)
                    part.Transparency = 0.5
                end
                
                -- Effet Glace ❄️
                if S.ice then
                    if not S.forcefield then
                        part.Material = Enum.Material.Ice
                    end
                    part.Color = Color3.fromRGB(200, 240, 255)
                    part.Transparency = 0.25
                    part.Reflectance = 0.3
                end
            end
        end
        
        -- Outline Verre/Bulle (sur le modèle entier)
        if S.glassOutline and not toy:FindFirstChild("GlassOutlineFX") then
            local box = Instance.new("SelectionBox")
            box.Name = "GlassOutlineFX"
            box.Adornee = toy
            box.LineThickness = 0.04
            box.Transparency = 0.3
            box.Color3 = Color3.fromRGB(100, 200, 255)
            box.SurfaceColor3 = Color3.fromRGB(180, 220, 255)
            box.SurfaceTransparency = 0.7
            box.Parent = toy
        end
    end
    
    -- Fonction pour retirer les effets d'un toy
    local function removeFXFromToy(toy)
        for _, part in ipairs(toy:GetDescendants()) do
            local ff = part:FindFirstChild("ForceFieldFX")
            if ff then ff:Destroy() end
            local hl = part:FindFirstChild("HighlightFX")
            if hl then hl:Destroy() end
            
            -- Restaure les propriétés originales si des effets étaient appliqués
            if part:GetAttribute("EffectApplied") then
                local origMat = part:GetAttribute("OriginalMaterial")
                local origColor = part:GetAttribute("OriginalColor")
                local origTrans = part:GetAttribute("OriginalTransparency")
                local origRefl = part:GetAttribute("OriginalReflectance")
                
                if origMat then
                    pcall(function()
                        part.Material = Enum.Material[origMat]
                    end)
                end
                if origColor then
                    pcall(function()
                        -- Parse la couleur depuis le string "r, g, b"
                        local r, g, b = origColor:match("([%d.]+),%s*([%d.]+),%s*([%d.]+)")
                        if r and g and b then
                            part.Color = Color3.new(tonumber(r), tonumber(g), tonumber(b))
                        end
                    end)
                end
                if origTrans then
                    part.Transparency = origTrans
                end
                if origRefl then
                    part.Reflectance = origRefl
                end
                
                part:SetAttribute("EffectApplied", nil)
                part:SetAttribute("OriginalMaterial", nil)
                part:SetAttribute("OriginalColor", nil)
                part:SetAttribute("OriginalTransparency", nil)
                part:SetAttribute("OriginalReflectance", nil)
            end
        end
        
        -- Retire l'outline verre/bulle
        local glassBox = toy:FindFirstChild("GlassOutlineFX")
        if glassBox then glassBox:Destroy() end
    end
    
    -- Fonction pour rafraîchir les effets sur tous les toys
