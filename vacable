    -- Type de rig de ton perso : l'aperçu utilise le même (R6 ou R15)
    function X.baseRig()
        local c = lp.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h and h.RigType == Enum.HumanoidRigType.R15 then return Enum.HumanoidRigType.R15 end
        return Enum.HumanoidRigType.R6
    end

    function X.rigOf(char)
        local h = char and char:FindFirstChildOfClass("Humanoid")
        return (h and h.RigType == Enum.HumanoidRigType.R15) and "R15" or "R6"
    end

    function X.mappedGroups()
        local l = {}
        for _, g in ipairs(X.GROUPS_ALL) do
            if X.bodyMap[g] then table.insert(l, g) end
        end
