        ["Ventre"] = { part = "torso", cf = CFrame.new(-0.3, -0.2, -0.6) * CFrame.Angles(math.rad(90), 0, math.rad(-30)) },
        ["Tête"]   = { part = "head",  cf = CFrame.new(0, 0.6, 0)      * CFrame.Angles(0, 0, math.rad(90)) },
        ["Epaule"] = { part = "torso", cf = CFrame.new(1.1, 0.8, 0)    * CFrame.Angles(0, 0, math.rad(-20)) },
    }

    -- ---------------------------------------------------------------
    -- OUTILS
    -- ---------------------------------------------------------------
    local function playerItems()
        local items = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                table.insert(items, p.Name .. " (" .. p.DisplayName .. ")")
            end
        end
        table.sort(items)
        return items
    end

    local function selectedItems()
        local items = {}
        for name in pairs(selected) do table.insert(items, name) end
        table.sort(items)
        return items
    end

    local function extractName(v)
        return tostring(v):match("^([^%s]+)")
    end

    local function isTargeted(p)
        return p ~= LP and (allPlayers or selected[p.Name] == true)
    end

    local RIGHT_LEG_NAMES = { "Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot" }

    -- Cache / montre la jambe droite sur TON écran (LocalTransparencyModifier = local only)
    local origTrans = setmetatable({}, { __mode = "k" })
    local function setLeg(char, hide)
        for _, n in ipairs(RIGHT_LEG_NAMES) do
            local part = char:FindFirstChild(n)
            if part and part:IsA("BasePart") then
                if hide then
                    if origTrans[part] == nil then origTrans[part] = part.Transparency end
                    part.Transparency = 1
                    part.LocalTransparencyModifier = 1
                else
                    part.LocalTransparencyModifier = 0
                    if origTrans[part] ~= nil then
                        part.Transparency = origTrans[part]
                        origTrans[part] = nil
                    end
                end
            end
        end
    end

    local function getTorso(char)
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end

    -- Kunai purement décoratif, créé localement
    local function addKunai(char)
        local old = char:FindFirstChild("_LocalKunai")
        if old then old:Destroy() end

        local spot = KUNAI_SPOTS[kunaiSpot] or KUNAI_SPOTS["Dos"]
        local base = (spot.part == "head") and char:FindFirstChild("Head") or getTorso(char)
        if not base then return end

        local model = Instance.new("Model")
        model.Name = "_LocalKunai"

        local function mk(size, color, material)
            local p = Instance.new("Part")
            p.Size = size
            p.Color = color
            p.Material = material
            p.Massless = true
            p.CanCollide = false
            p.CanQuery = false
            p.CanTouch = false
            p.Parent = model
            return p
        end

        local handle = mk(Vector3.new(0.18, 0.6, 0.18), Color3.fromRGB(35, 35, 40), Enum.Material.Fabric)
        local blade  = mk(Vector3.new(0.12, 1.3, 0.45), Color3.fromRGB(200, 200, 210), Enum.Material.Metal)
        local ring   = mk(Vector3.new(0.35, 0.08, 0.35), Color3.fromRGB(170, 170, 180), Enum.Material.Metal)

        local w1 = Instance.new("Weld")
        w1.Part0, w1.Part1, w1.C0 = base, handle, spot.cf
        w1.Parent = handle

        local w2 = Instance.new("Weld")
        w2.Part0, w2.Part1, w2.C0 = handle, blade, CFrame.new(0, 0.95, 0)
        w2.Parent = blade

        local w3 = Instance.new("Weld")
        w3.Part0, w3.Part1, w3.C0 = handle, ring, CFrame.new(0, -0.35, 0)
        w3.Parent = ring

        model.Parent = char
    end

    local function removeKunai(char)
        local k = char:FindFirstChild("_LocalKunai")
        if k then k:Destroy() end
    end

    -- ---------------------------------------------------------------
    -- BOUCLE D'APPLICATION (idempotente, toutes les 0.5 s)
    -- ---------------------------------------------------------------
    local lastSpot = kunaiSpot
    task.spawn(function()
        local __rid = _G.HelperOtherRunId; while _G.HelperOtherRunId == __rid do
            task.wait(0.5)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local char = p.Character
                    if char then
                        local targeted = isTargeted(p)

                        -- Jambe
                        if legHidden and targeted then
                            setLeg(char, true)
                            appliedLeg[p.Name] = true
                        elseif appliedLeg[p.Name] then
                            setLeg(char, false)
                            appliedLeg[p.Name] = nil
                        end

                        -- Kunai
                        local has = char:FindFirstChild("_LocalKunai") ~= nil
                        if kunaiOn and targeted then
                            if not has or lastSpot ~= kunaiSpot then
                                addKunai(char)
                            end
                        elseif has then
                            removeKunai(char)
                        end
                    end
                end
            end
            lastSpot = kunaiSpot
        end
    end)

    local function undoAll()
        legHidden, kunaiOn = false, false
        for _, p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            if char then
                if appliedLeg[p.Name] then setLeg(char, false) end
                removeKunai(char)
            end
        end
        table.clear(appliedLeg)
    end

    local prevCleanup = _G.HelperOtherCleanup
    _G.HelperOtherCleanup = function()
        pcall(undoAll)
        if prevCleanup then pcall(prevCleanup) end
    end

    -- ---------------------------------------------------------------
    -- INTERFACE
    -- ---------------------------------------------------------------
    local ListBlock  = PTab:CreateBlock({ Name = "👥 Liste de joueurs",        Side = "Left"  })
    local LegBlock   = PTab:CreateBlock({ Name = "🦵 Jambe droite (visuel)",   Side = "Right" })
    local KunaiBlock = PTab:CreateBlock({ Name = "🗡️ Kunai décoratif (visuel)", Side = "Right" })

    local PickDropdown, InListDropdown
    local inListPick = nil

    PickDropdown = ListBlock:CreateDropdown({
        Name = "Joueur",
        Items = playerItems(), Options = playerItems(),
        Callback = function(v) pending = extractName(v) end,
    })

    ListBlock:CreateButton({
        Name = "➕ Ajouter à la liste",
        Callback = function()
            if not pending then notify("Joueurs FX", "Choisis un joueur d'abord", 2) return end
            selected[pending] = true
            pcall(function() InListDropdown:Refresh(selectedItems(), false) end)
            notify("Joueurs FX", pending .. " ajouté (" .. #selectedItems() .. " dans la liste)", 2)
        end,
    })

    InListDropdown = ListBlock:CreateDropdown({
        Name = "Dans la liste",
        Items = selectedItems(), Options = selectedItems(),
        Callback = function(v) inListPick = extractName(v) end,
    })

    ListBlock:CreateButton({
        Name = "➖ Retirer celui-ci de la liste",
        Callback = function()
            if not inListPick or not selected[inListPick] then return end
            selected[inListPick] = nil
            inListPick = nil
            pcall(function() InListDropdown:Refresh(selectedItems(), false) end)
        end,
    })

    ListBlock:CreateButton({
        Name = "🗑️ Vider la liste",
        Callback = function()
            table.clear(selected)
            inListPick = nil
            pcall(function() InListDropdown:Refresh({}, false) end)
        end,
    })

    ListBlock:CreateToggle({
        Name = "Tous les joueurs", Flag = "PLFX_All", Default = false,
        Callback = function(v) allPlayers = v end,
    })

    -- Rafraîchit la liste des joueurs présents
    task.spawn(function()
        local __rid = _G.HelperOtherRunId; while _G.HelperOtherRunId == __rid do
            task.wait(3)
            pcall(function() PickDropdown:Refresh(playerItems(), false) end)
        end
    end)

    LegBlock:CreateToggle({
        Name = "Cacher la jambe droite (liste)", Flag = "PLFX_Leg", Default = false,
        Callback = function(v)
            legHidden = v
            if v and not allPlayers and next(selected) == nil then
                notify("Joueurs FX", "Liste vide : ajoute un joueur ou active « Tous les joueurs »", 4)
            end
        end,
    })

    KunaiBlock:CreateToggle({
        Name = "Kunai planté (liste)", Flag = "PLFX_Kunai", Default = false,
        Callback = function(v)
            kunaiOn = v
            if v and not allPlayers and next(selected) == nil then
                notify("Joueurs FX", "Liste vide : ajoute un joueur ou active « Tous les joueurs »", 4)
            end
        end,
    })
    KunaiBlock:CreateDropdown({
        Name = "Emplacement",
        Items = { "Dos", "Ventre", "Tête", "Epaule" },
        Options = { "Dos", "Ventre", "Tête", "Epaule" },
        Default = "Dos",
        Callback = function(v) kunaiSpot = v end,
    })
    
    end)
    if not __ok then
        warn("[Joueurs FX] " .. tostring(__err))
        pcall(function() notify("Joueurs FX", "Erreur : " .. tostring(__err), 10) end)
    end
end

