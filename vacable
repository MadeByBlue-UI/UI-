-- TRACTOR SWAPPER (remplace TractorGreen par un modèle custom)
-- =====================================================================
do
    local FunSwap      = Tabs.Toys:CreateBlock({ Name = "Tractor Swap", Side = "Right" })
    local _swapAssetId = 5387983239
    local _swapActive  = false
    local _swapConn    = nil
    local _swapModel   = nil
    local _swapOrig    = {}

    function findTractor()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "TractorGreen" and obj:IsA("Model") then return obj end
        end
        return nil
    end

    function stopSwap()
        if _swapConn then _swapConn:Disconnect(); _swapConn = nil end
        if _swapModel and _swapModel.Parent then _swapModel:Destroy(); _swapModel = nil end
        for p, v in pairs(_swapOrig) do
            if p and p.Parent then p.LocalTransparencyModifier = v end
        end
        _swapOrig = {}
    end

    function startSwap()
        local tractor = findTractor()
        if not tractor then notify("Tractor Swap", "TractorGreen introuvable.", 3); _swapActive = false; return end

        -- Cache le tracteur côté client
        _swapOrig = {}
        for _, p in ipairs(tractor:GetDescendants()) do
            if p:IsA("BasePart") then
                _swapOrig[p] = p.LocalTransparencyModifier
                p.LocalTransparencyModifier = 1
            end
        end

        notify("Tractor Swap", "Chargement...", 2)
        task.spawn(function()
            local ok, res = pcall(function()
                return game:GetObjects("rbxassetid://" .. _swapAssetId)
            end)
            if not ok or not res or not res[1] then
                notify("Tractor Swap", "Erreur : " .. tostring(res), 4)
                for p, v in pairs(_swapOrig) do if p and p.Parent then p.LocalTransparencyModifier = v end end
                _swapActive = false
                return
            end

            local model = res[1]
            if not model then return end

            -- Désactive collisions sans ancrer
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.Massless   = true
                    p.Anchored   = true
                end
            end

            model.Parent = workspace
            _swapModel   = model

            local anchor = tractor.PrimaryPart or tractor:FindFirstChildWhichIsA("BasePart")
            if not anchor then notify("Tractor Swap", "Ancre introuvable.", 3); return end

            -- Calcule l'offset AVANT tout placement
            local pivot  = model:GetPivot()
            local minY   = math.huge
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    local by = p.Position.Y - p.Size.Y / 2
                    if by < minY then minY = by end
                end
            end
            local heightOffset = pivot.Position.Y - minY

            -- Sauvegarde les CFrames relatives au pivot du modèle
            local relativeCFs = {}
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    relativeCFs[p] = pivot:ToObjectSpace(p.CFrame)
                end
            end

            -- Fonction de placement : applique chaque part individuellement
            function placeCar()
                local targetCF = anchor.CFrame * CFrame.new(0, heightOffset, 0)
                for p, relCF in pairs(relativeCFs) do
                    if p and p.Parent then
                        p.CFrame = targetCF * relCF
                    end
                end
            end
            placeCar()
            notify("Tractor Swap", "Swap actif !", 2)

            -- Suit le tracteur à 20fps
            local _t = 0
            _swapConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
                if not _swapActive or not anchor.Parent or not _swapModel or not _swapModel.Parent then return end
                _t = _t + dt
                if _t < 0.05 then return end
                _t = 0
                placeCar()
            end)
        end)
    end

    FunSwap:CreateToggle({
        Name    = "Tractor Swap",
        Flag    = "TractorSwapToggle",
        Default = false,
        Callback = function(v)
            _swapActive = v
            if v then startSwap() else stopSwap() end
        end,
    })

    FunSwap:CreateInput({
        Name        = "Asset ID",
        Flag        = "TractorSwapAssetID",
        Placeholder = "ex: 5387983239",
        Callback    = function(v)
            local n = tonumber(v)
            if n then _swapAssetId = n end
        end,
    })
end

