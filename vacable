                                                    local lastHistoryEntry = trainPositionHistory[#trainPositionHistory]
                                                    local beforeLast = trainPositionHistory[#trainPositionHistory - 1]
                                                    
                                                    local existingDistance = lastHistoryEntry.distanceFromHead or 0
                                                    local missingDistance = targetDistance - existingDistance
                                                    
                                                    local direction = (lastHistoryEntry.pos - beforeLast.pos).Unit
                                                    targetPos = lastHistoryEntry.pos - (direction * missingDistance) + Vector3.new(0, tornadoHeight, 0)
                                                    
