do
    local ANTI_KICK_ITEMS    = { "ToolPickaxe", "NinjaKunai", "NinjaShuriken" }
    local STICK_CFRAMES = {
        ToolPickaxe = CFrame.new(0.3, 0.5, 0.7) * CFrame.Angles(math.rad(90), 15, 0),
        NinjaKunai  = CFrame.new(0, -0.875, 0)  * CFrame.Angles(0, math.rad(90), math.rad(90)),
        default     = CFrame.new(0, -0.2,   0)  * CFrame.Angles(0, math.rad(90), math.rad(90)),
    }
    local STICKY_PART_NAMES = { default = "StickyPart" }

    local RS2          = game:GetService("ReplicatedStorage")
    local setOwnerAK   = RS2:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
    local stickyEvent  = RS2:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
    local spawnRemoteAK= RS2:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local destroyRemAK = RS2:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    local canSpawnAK   = LocalPlayer:WaitForChild("CanSpawnToy")

    local AK_Active = false

    -- Son bulles (seul son gard)
    function PlayAttacheSound()
        local s = Instance.new("Sound")
        s.SoundId = _G.GetCustomPalletSound and _G.GetCustomPalletSound() or "rbxassetid://132948338000932"
        s.Volume  = 0.63
        s.Parent  = workspace
        s:Play()
        game:GetService("Debris"):AddItem(s, 3)
    end

    -- Helpers
    function AK_GetInv()
        return workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    end

    function AK_GetFirePart()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        return h and h:FindFirstChild("FirePlayerPart")
    end

    function AK_IsAlive()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("Humanoid")
        return h and h.Health > 0
    end

    function AK_FindStickyPart(item)
        if not item then return nil end
        local n  = item.Name:gsub("AK_", "")
        local sn = STICKY_PART_NAMES[n]
        if sn then local f = item:FindFirstChild(sn) if f then return f end end
        local sp = item:FindFirstChild("StickyPart")
        if sp then return sp end
        for _, v in pairs(item:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():find("sticky") or v.Name:lower():find("hitbox") or v.Name:lower():find("stick")) then
                return v
            end
        end
        return nil
    end

    function AK_IsProperlyStuck(item)
        if not item or not item.Parent then return false end
        local sp = AK_FindStickyPart(item)
        local w  = sp and sp:FindFirstChild("StickyWeld")
        if not w or not w.Part1 then return false end
        local fp = AK_GetFirePart()
        return fp ~= nil and w.Part1 == fp
    end

    function AK_CleanVisuals(item)
        if not item or not item.Parent then return end
        for _, obj in pairs(item:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanTouch   = false
                obj.CanCollide = false
                obj.CanQuery   = false
                obj.CastShadow = false
            end
        end
    end

    function AK_StickItem(item)
        if not item or not item.Parent then return false end
        local sp = AK_FindStickyPart(item)
        local fp = AK_GetFirePart()
        if not sp or not fp then return false end
        pcall(function() setOwnerAK:FireServer(sp, sp.CFrame) end)
        if item:FindFirstChild("SoundPart") then
            pcall(function() setOwnerAK:FireServer(item.SoundPart, item.SoundPart.CFrame) end)
        end
        task.wait()
        local n  = item.Name:gsub("AK_", "")
        local cf = STICK_CFRAMES[n] or STICK_CFRAMES.default
        stickyEvent:FireServer(sp, fp, cf)
        AK_CleanVisuals(item)
        return true
    end

    function AK_StickGuaranteed(item)
        while item and item.Parent and AK_Active do
            AK_StickItem(item)
            task.wait(0.1)
            if AK_IsProperlyStuck(item) then return true end
        end
        return false
    end

    function AK_ClearItem(name)
        local inv = AK_GetInv()
        if not inv or not destroyRemAK then return end
        for _, v in pairs(inv:GetChildren()) do
            if v.Name == name or v.Name == "AK_" .. name then
                pcall(function() destroyRemAK:FireServer(v) end)
            end
        end
    end

    function AK_SpawnItem(name)
        local t = tick()
        while not canSpawnAK.Value do
            if not AK_Active or tick() - t > 5 then return nil end
            task.wait(0.01)
        end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return nil end
        task.spawn(function()
            pcall(function()
                spawnRemoteAK:InvokeServer(name, h.CFrame * CFrame.new(0, 12, 20), Vector3.zero)
            end)
        end)
        local inv = AK_GetInv()
        if not inv then return nil end
        local item = inv:WaitForChild(name, 6)
        if item then
            local t2 = tick()
            while not AK_FindStickyPart(item) do
                if tick() - t2 > 3 then break end
                task.wait(0.05)
            end
        end
        return item
    end

    function AK_RunLoop(name)
        task.spawn(function()
            while AK_Active do
                task.wait(0.15)
                if not AK_IsAlive() then
                    repeat task.wait(0.01) until AK_IsAlive() or not AK_Active
                    task.wait(0.05)
                    continue
                end
                local inv  = AK_GetInv()
                local item = inv and (inv:FindFirstChild("AK_" .. name) or inv:FindFirstChild(name))
                if not item or not item.Parent then
                    AK_ClearItem(name)
                    item = AK_SpawnItem(name)
                    if not item then continue end
                    item.Name = "AK_" .. name
                    AK_CleanVisuals(item)
                end
                if not AK_IsProperlyStuck(item) then
                    AK_StickGuaranteed(item)
                    if item and item.Parent then item.Name = "AK_" .. name end
                end
                while AK_Active and item and item.Parent and AK_IsAlive() do
                    if not AK_IsProperlyStuck(item) then
                        Library:Notify({ Title = "Anti-Kick", Content = name .. "  Detachee, reattachee...", Duration = 3 })
                        AK_StickGuaranteed(item)
                        if item and item.Parent and AK_IsProperlyStuck(item) then
                            Library:Notify({ Title = "Anti-Kick", Content = name .. "  Reattachee ", Duration = 2 })
                            PlayAttacheSound()
                        end
                    end
                    task.wait(0.3)
                end
            end
            AK_ClearItem(name)
        end)
    end

    function AK_Start()
        AK_Active = true
        -- Spawn en sequence, attachee en parallele
        task.spawn(function()
            for _, name in ipairs(ANTI_KICK_ITEMS) do
                if not AK_Active then break end
                local inv  = AK_GetInv()
                local item = inv and (inv:FindFirstChild("AK_" .. name) or inv:FindFirstChild(name))
                if not item then
                    item = AK_SpawnItem(name)
                end
                if item then
                    item.Name = "AK_" .. name
                    local ref = item
                    local n   = name
                    task.spawn(function()
                        AK_CleanVisuals(ref)
                        AK_StickGuaranteed(ref)
                        if ref and ref.Parent then
                            Library:Notify({ Title = "Anti-Kick", Content = n .. "  Attache ", Duration = 2 })
                            PlayAttacheSound()
                        end
                    end)
                end
            end
            -- Lance les loops de surveillance
            if AK_Active then
                for _, name in ipairs(ANTI_KICK_ITEMS) do
                    AK_RunLoop(name)
                end
            end
        end)
    end

    function AK_Stop()
        AK_Active = false
        task.wait(0.5)
        for _, name in ipairs(ANTI_KICK_ITEMS) do
            AK_ClearItem(name)
        end
    end

    -- Redémarre automatiquement après respawn
