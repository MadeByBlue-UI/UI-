    -- Helper functions for TOP1
    local function FWD(parent, part, time) return parent:FindFirstChild(part) or parent:WaitForChild(part, time or 1) end
    local function CFP(parent, part) return parent:FindFirstChild(part) ~= nil end
    local function CheckNetworkOwnerOnPart(Part) return CFP(Part, "PartOwner") and Part["PartOwner"].Value == LocalPlayer.Name end
    local function ChangeCollision(obj, val)
        for _, v in pairs(obj:GetChildren()) do
            if v:IsA("BasePart") and v.Name ~= "GrabParts" then v.CanCollide = val end
        end
    end
    local function RenameInShop(Instance_obj, OriginalName, ToRename)
        local index = nil
        local ToCheckName = Instance_obj.Name or Instance_obj
        local inv = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not inv then return end
        for i, v in pairs(inv:GetChildren()) do if v.Name == ToCheckName then index = i end end
        if index == nil then return end
        local contents = LocalPlayer.PlayerGui.MenuGui.Menu.TabContents.ToyDestroy.Contents
        for i, v in ipairs(contents:GetChildren()) do
            if v.Name == OriginalName and i == index then
                local view = v.ViewItemButton
                view.Text = ToRename
                view.TextScaled = true
                view.LowResImage.Image = ""
            end
        end
    end
    local function GetMagnitude(Part1, Part2) return (Part1.Position - Part2.Position).Magnitude end
    local function SpawnToyTop1(ToyName)
        local inv = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not inv then return nil end
        local InPlot = LocalPlayer.InPlot
        local InOwnedPlot = LocalPlayer.InOwnedPlot
        local CanSpawnToy = LocalPlayer.CanSpawnToy
        if InPlot.Value and not InOwnedPlot.Value then InPlot:GetPropertyChangedSignal("Value"):Wait() end
        if not CanSpawnToy.Value then CanSpawnToy:GetPropertyChangedSignal("Value"):Wait() end
        local char = LocalPlayer.Character
        local HRP = char and char:FindFirstChild("HumanoidRootPart")
        if not HRP then return nil end
        local SpawnCF = HRP.CFrame * CFrame.new(0,14,20)
        local spawnedObject = nil
        local connection = inv.ChildAdded:Connect(function(child) if child.Name == ToyName then spawnedObject = child end end)
        task.spawn(function() pcall(function() SpawnToy:InvokeServer(ToyName, SpawnCF, Vector3.new(0,0,0)) end) end)
        local start = tick()
        repeat task.wait() until spawnedObject or (tick() - start) > 2.5
        connection:Disconnect()
        return spawnedObject
    end
    
