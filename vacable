    -- Fonction pour obtenir la liste des joueurs avec format @username (DisplayName)
    function getPlayersList()
        local playersList = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local displayText = "@" .. player.Name .. " (" .. player.DisplayName .. ")"
                table.insert(playersList, displayText)
            end
        end
        return playersList
    end
    
    -- Fonction pour extraire le username depuis le format @username (DisplayName)
    function extractUsername(formattedText)
        -- Format attendu: @username (DisplayName)
        local username = formattedText:match("@([^%s%(]+)")
        _dbg("[KICK DEBUG] extractUsername input:", formattedText, "-> output:", username)
        return username or formattedText
    end
    
    -- Fonction pour spawn la pallet ragdoll
    function spawnKickPallet(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then
            return false
        end
        
        -- Position 15 studs au-dessus du joueur cible
        local targetPos = targetPlayer.Character.HumanoidRootPart.Position
        local spawnPos = targetPos + Vector3.new(0, 15, 0)
        
        -- Spawn la pallet
        local success, result = pcall(function()
            return SpawnToyRF:InvokeServer('Pallet', CFrame.new(spawnPos))
        end)
        
        if success and result then
            kickPalletToy = result
            _dbg("[KICK DEBUG] Pallet spawnée:", result.Name)
            return true
        else
            _dbg("[KICK DEBUG] Erreur spawn pallet")
            return false
        end
    end
    
    -- Fonction pour téléporter derrière le joueur
    function teleportBehindPlayer(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return end
        
        -- Sauvegarde position actuelle
        originalPosition = LocalPlayer.Character.HumanoidRootPart.CFrame
        
        -- Position derrière le joueur cible
        local targetCFrame = targetPlayer.Character.HumanoidRootPart.CFrame
        local behindPos = targetCFrame.Position - (targetCFrame.LookVector * 5)
        local behindCFrame = CFrame.new(behindPos, targetCFrame.Position)
        
        -- TP derrière
        LocalPlayer.Character.HumanoidRootPart.CFrame = behindCFrame
        _dbg("[KICK DEBUG] TP derrière", targetPlayer.Name)
    end
    
