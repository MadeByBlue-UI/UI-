        ["♥"] = ".5,.15 .15,.55 .1,.8 .3,.95 .5,.75 .7,.95 .9,.8 .85,.55 .5,.15",
        ["⭐"] = ".5,1 .62,.65 1,.65 .7,.42 .8,.05 .5,.28 .2,.05 .3,.42 0,.65 .38,.65 .5,1",
    }
    local GLYPHS = {}
    for ch, src in pairs(GLYPH_SRC) do
        local strokes = {}
        for stroke in src:gmatch("[^/]+") do
            local pts = {}
            for x, y in stroke:gmatch("(-?[%d%.]+),(-?[%d%.]+)") do
                pts[#pts + 1] = Vector2.new(tonumber(x), tonumber(y))
            end
            if #pts >= 2 then strokes[#strokes + 1] = pts end
        end
        GLYPHS[ch] = strokes
    end

    -- Accents -> lettre de base (le texte tapé en français marche)
    local ACCENTS = {
        ["à"]="A", ["â"]="A", ["ä"]="A", ["á"]="A", ["À"]="A", ["Â"]="A",
        ["é"]="E", ["è"]="E", ["ê"]="E", ["ë"]="E", ["É"]="E", ["È"]="E", ["Ê"]="E",
        ["î"]="I", ["ï"]="I", ["í"]="I", ["Î"]="I",
        ["ô"]="O", ["ö"]="O", ["ó"]="O", ["Ô"]="O",
        ["ù"]="U", ["û"]="U", ["ü"]="U", ["ú"]="U", ["Ù"]="U", ["Û"]="U",
        ["ç"]="C", ["Ç"]="C", ["ñ"]="N",
    }

    -- Découpe une ligne en caractères (UTF-8), en ignorant les sélecteurs d'emoji
    local function charList(line)
        local out = {}
        local ok = pcall(function()
            for _, cp in utf8.codes(line) do
                if cp ~= 0xFE0F and cp ~= 0x200D then
                    local ch = utf8.char(cp)
                    out[#out + 1] = ACCENTS[ch] or ch:upper()
                end
            end
        end)
        if not ok then
            out = {}
            for k = 1, #line do out[#out + 1] = line:sub(k, k):upper() end
        end
        return out
    end

    -- Segments du texte courant : { {x1,y1,x2,y2,len}, ... } + longueurs cumulées
    local textData = { segs = {}, cum = {}, total = 0 }

    local function rebuildText()
        local size    = cfg.textSize
        local width   = size * 0.6
        local gap     = size * 0.3 * cfg.textSpacing
        local advance = width + gap
        local lineH   = size * 1.5

        local lines = {}
        for line in (cfg.text .. "|"):gmatch("([^|]*)|") do
            lines[#lines + 1] = line
        end

        local segs, cum, total = {}, {}, 0
        for li, line in ipairs(lines) do
            local chars = charList(line)
            local lineW = (#chars > 0) and (#chars * advance - gap) or 0
            local x0 = -lineW / 2
            local y0 = ((#lines - 1) / 2 - (li - 1)) * lineH - size / 2
            for ci, ch in ipairs(chars) do
                local strokes = GLYPHS[ch]
                if strokes then
                    local ox = x0 + (ci - 1) * advance
                    for _, pts in ipairs(strokes) do
                        for k = 1, #pts - 1 do
                            local a, b = pts[k], pts[k + 1]
                            local x1, y1 = ox + a.X * width, y0 + a.Y * size
                            local x2, y2 = ox + b.X * width, y0 + b.Y * size
                            local len = math.sqrt((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
                            if len > 1e-4 then
                                total += len
                                segs[#segs + 1] = { x1, y1, x2, y2, len }
                                cum[#cum + 1] = total
                            end
                        end
                    end
                end
            end
        end
        textData = { segs = segs, cum = cum, total = total }
    end

    -- Point situé à la distance d le long de tous les traits (recherche dichotomique)
    local function sampleText(d)
        local cum, segs, total = textData.cum, textData.segs, textData.total
        if total <= 0 then return 0, 0 end
        d = d % total
        local lo, hi = 1, #cum
        while lo < hi do
            local mid = math.floor((lo + hi) / 2)
            if cum[mid] >= d then hi = mid else lo = mid + 1 end
        end
        local s = segs[lo]
        local t = (d - (cum[lo] - s[5])) / s[5]
        return s[1] + (s[3] - s[1]) * t, s[2] + (s[4] - s[2]) * t
    end

    -- ---------------------------------------------------------------------
    -- FORMATIONS : fn(i, n, angle, R, H) -> Vector3 (repère local de la formation)
    -- ---------------------------------------------------------------------
    local FORMATIONS = {}

    FORMATIONS["Circle"] = function(i, n, a, R, H)
        local ang = a + TAU * i / n
        return Vector3.new(math.cos(ang) * R, H, math.sin(ang) * R)
    end

    FORMATIONS["Tornade"] = function(i, n, a, R, H)
        local k = i / n
        local ang = a * 2 + i * 0.7
        local r = R * (0.25 + 0.75 * k)
        return Vector3.new(math.cos(ang) * r, H + k * R * 1.5, math.sin(ang) * r)
    end

    FORMATIONS["Spiral"] = function(i, n, a, R, H)
        local k = i / n
        local ang = a + k * TAU * 3
        local r = R * (0.15 + 0.85 * k)
        return Vector3.new(math.cos(ang) * r, H, math.sin(ang) * r)
    end

    FORMATIONS["Heart"] = function(i, n, a, R, H)
        local u = a + TAU * i / n
        local s = R / 16
        local x = 16 * math.sin(u) ^ 3
        local y = 13 * math.cos(u) - 5 * math.cos(2 * u) - 2 * math.cos(3 * u) - math.cos(4 * u)
        return Vector3.new(x * s, H + y * s, 0)
    end

    FORMATIONS["Helix"] = function(i, n, a, R, H)
        local k = i / n
        local ang = a * 2 + k * TAU * 2 + (i % 2) * math.pi
        return Vector3.new(math.cos(ang) * R * 0.6, H + (k * 2 - 1) * R, math.sin(ang) * R * 0.6)
    end

    local function starVertex(k, a, R)
        local ang = a + k * TAU / 10
        local r = (k % 2 == 0) and R or R * 0.45
        return Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
    end
    FORMATIONS["Star"] = function(i, n, a, R, H)
        local t = (i - 1) / n * 10
        local k = math.floor(t)
        local v = starVertex(k, a, R):Lerp(starVertex(k + 1, a, R), t - k)
        return v + Vector3.new(0, H, 0)
    end

    FORMATIONS["Sphere"] = function(i, n, a, R, H)
        local y = 1 - 2 * (i - 0.5) / n            -- toujours dans ]-1 ; 1[, même avec 1 seul toy
        local r = math.sqrt(math.max(0, 1 - y * y))
        local th = GOLDEN * i + a
        return Vector3.new(math.cos(th) * r * R, H + y * R, math.sin(th) * r * R)
    end

    FORMATIONS["Cube"] = function(i, n, a, R, H)
        local side = math.max(1, math.ceil(n ^ (1 / 3)))
        local idx = i - 1
        local gx = idx % side
        local gy = math.floor(idx / side) % side
        local gz = math.floor(idx / (side * side))
        local step = (2 * R) / math.max(1, side - 1)
        local half = (side - 1) / 2
        local px, pz = (gx - half) * step, (gz - half) * step
        local c, s = math.cos(a), math.sin(a)
        return Vector3.new(px * c - pz * s, H + (gy - half) * step, px * s + pz * c)
    end

    FORMATIONS["Torus"] = function(i, n, a, R, H)
        local u = a + TAU * i / n
        local v = i * GOLDEN
        local tube = R * 0.35
        local rr = R + tube * math.cos(v)
        return Vector3.new(math.cos(u) * rr, H + tube * math.sin(v), math.sin(u) * rr)
    end

    FORMATIONS["Wave"] = function(i, n, a, R, H)
        local k = (i - 0.5) / n
        return Vector3.new((k * 2 - 1) * R * 1.5, H + math.sin(a * 2 + k * TAU * 2) * R * 0.3, 0)
    end

    -- Texte : posé verticalement à R studs devant (lisible si "Suivre ma direction" est actif)
    FORMATIONS["Text"] = function(i, n, a, R, H)
        local total = textData.total
        if total <= 0 then                           -- texte vide : cercle qui tourne
            local ang = a * 3 + TAU * i / n
            return Vector3.new(math.cos(ang) * R * 0.8, H, math.sin(ang) * R * 0.8)
        end
        local d = (i - 0.5) / n * total
        if cfg.textScroll then d += os.clock() * cfg.textScrollSpeed end
        local x, y = sampleText(d)
        return Vector3.new(x, H + y, -R)
    end

    local FORMATION_NAMES = { "Circle", "Tornade", "Spiral", "Heart", "Helix", "Star", "Sphere", "Cube", "Torus", "Wave", "Text" }

    -- ---------------------------------------------------------------------
    -- SOURCES : quels toys on utilise (scan toutes les 0.5 s, jamais dans le Heartbeat)
    -- ---------------------------------------------------------------------
    local INV_NAMES  = { "SoundPart", "HoldPart" }
    local PLOT_NAMES = { "Main", "SoundPart", "HoldPart" }

    local function mainPartOf(obj, names)
        if obj:IsA("BasePart") then return obj end
        for _, name in ipairs(names) do
            local p = obj:FindFirstChild(name, true)
            if p and p:IsA("BasePart") then return p end
        end
        if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
        return nil
    end

    local function findMyPlotName()
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil end
        for _, plot in ipairs(plots:GetChildren()) do
            local sign = plot:FindFirstChild("PlotSign")
            local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
            if owners then
                for _, v in ipairs(owners:GetChildren()) do
                    if v:IsA("ValueBase") and v.Value == LP.Name then return plot.Name end
                end
            end
        end
        return nil
    end

    local function controlledPart()
        local st = _G._ObjCtrlState
        if st and st.active then return st.part or st.object or st.target end
        return nil
    end

    local function collectEntries()
        local list, seen = {}, {}
        local ctrl = controlledPart()

        local function add(part)
            if not part or seen[part] then return end
            if ctrl and (part == ctrl or part.Parent == ctrl.Parent) then return end
            seen[part] = true
            list[#list + 1] = { part = part, owner = part:FindFirstChild("PartOwner") }
        end

        if cfg.source == "Inventaire" or cfg.source == "Plot+Inventaire" then
            local inv = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
            if inv then
                for _, toy in ipairs(inv:GetChildren()) do add(mainPartOf(toy, INV_NAMES)) end
            end
        end
        if cfg.source == "Plot" or cfg.source == "Plot+Inventaire" then
            local plotName = findMyPlotName()
            local plotItems = workspace:FindFirstChild("PlotItems")
            local folder = plotName and plotItems and plotItems:FindFirstChild(plotName)
            if folder then
                for _, toy in ipairs(folder:GetChildren()) do
                    if toy:IsA("Model") then add(mainPartOf(toy, PLOT_NAMES)) end
                end
            end
        end

        for k = #list, cfg.maxToys + 1, -1 do list[k] = nil end   -- limite de toys
        return list
    end

    -- ---------------------------------------------------------------------
    -- THREADS : scan des toys + récupération d'ownership (un seul de chaque, jamais en parallèle)
    -- ---------------------------------------------------------------------
    local function scanLoop(token)
        while alive(token) do
            local ok, list = pcall(collectEntries)
            if ok and type(list) == "table" then state.entries = list end
            task.wait(0.5)
        end
    end

    local function claimLoop(token)
        while alive(token) do
            task.wait(0.4)
            if not alive(token) then break end
            if cfg.claim then
                local ge = RS:FindFirstChild("GrabEvents")
                local remote = ge and ge:FindFirstChild("SetNetworkOwner")
                local char = LP.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local budget, now = 6, os.clock()
                for _, e in ipairs(state.entries) do
                    if budget <= 0 or not alive(token) then break end
                    local part, owner = e.part, e.owner
                    if remote and part.Parent and owner and owner.Value ~= LP.Name
                        and (state.claimAt[part] or 0) <= now then
                        state.claimAt[part] = now + 1
                        budget -= 1
                        local far = cfg.autoTP and root and (root.Position - part.Position).Magnitude > 80
                        local saved = root and root.CFrame
                        if far then
                            root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                            task.wait(0.1)
                        end
                        for _ = 1, 3 do
                            pcall(function() remote:FireServer(part, part.CFrame) end)
                            task.wait(0.03)
                            if owner.Value == LP.Name then break end
                        end
                        if far and saved then root.CFrame = saved end
                    end
                end
            end
        end
    end

    -- ---------------------------------------------------------------------
    -- BOUCLE PRINCIPALE (Heartbeat) : aucun task.wait ici, donc aucun chevauchement
    -- ---------------------------------------------------------------------
    local function getCenter(root)
        if cfg.center == "Spawn" then return SPAWN_POS end
        if cfg.center == "Target" then
            local t = cfg.target
            local tr = t and t.Character and t.Character:FindFirstChild("HumanoidRootPart")
            return tr and tr.Position or SPAWN_POS
        end
        if _G.ToySeatActive and _G.ToySeatGroundPos then return _G.ToySeatGroundPos end
        return root.Position
    end

    local function getBase(center, root)
        local cf = CFrame.new(center)
        if cfg.followLook then
            local look = root.CFrame.LookVector
            cf = cf * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
        end
        if cfg.tilt ~= 0 then cf = cf * CFrame.Angles(math.rad(cfg.tilt), 0, 0) end
        return cf
    end

    local function step(dt)
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local list = state.entries
        local n = #list
        if n == 0 then return end

        state.angle += cfg.speed * dt
        local center = getCenter(root)
        local base = getBase(center, root)
        local fn = FORMATIONS[cfg.formation] or FORMATIONS["Circle"]
        local a, R, H = state.angle, cfg.radius, cfg.height
        local alpha = cfg.smooth and (1 - math.exp(-cfg.smoothRate * dt)) or 1
        local me = LP.Name

        for i = 1, n do
            local e = list[i]
            local part, owner = e.part, e.owner
            if part.Parent and (not owner or owner.Value == me) then
                local pos = base * fn(i, n, a, R, H)
                if pos.X == pos.X and pos.Y == pos.Y and pos.Z == pos.Z then   -- ignore NaN
                    local target
                    if cfg.orient == "Face centre" then
                        if (center - pos).Magnitude > 0.05 then
                            target = CFrame.lookAt(pos, center)
                        else
                            target = CFrame.new(pos)
                        end
                    elseif cfg.orient == "Spin" then
                        target = CFrame.new(pos) * CFrame.Angles(0, a * 3 + i, 0)
                    else
                        target = CFrame.new(pos)
                    end
                    if alpha < 1 then target = part.CFrame:Lerp(target, alpha) end
                    part.CFrame = target
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end

    -- ---------------------------------------------------------------------
    -- START / STOP (start() coupe toujours l'ancienne instance : pas de doublon possible)
    -- ---------------------------------------------------------------------
    local function stop()
        state.active = false
        state.token += 1
        if state.conn then
            state.conn:Disconnect()
            state.conn = nil
        end
        state.entries = {}
    end

    local function start()
        stop()
        state.active = true
        state.angle = 0
        local token = state.token
        rebuildText()
        state.conn = _TrackConn(RunService.Heartbeat:Connect(function(dt)
            if _G.HelperOtherRunId ~= runId then stop() return end
            if not alive(token) then return end
            local ok, err = pcall(step, dt)
            if not ok then _dbg("[TornadoV2] " .. tostring(err)) end
        end))
        task.spawn(scanLoop, token)
        task.spawn(claimLoop, token)
    end

