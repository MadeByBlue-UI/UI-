-- PCLD ESP  (PlayerCharacterLocationDetector)
-- =========================================================================
do
    local RS_PCLD = game:GetService("RunService")

    local pcldBoxColor     = Color3.fromRGB(255, 255, 255)
    local pcldOutlineColor = Color3.fromRGB(255, 255, 255)
    local pcldBoxTrans     = 1.0
    local pcldOutlineTrans = 0.0
    local pcldOutlineSize  = 0.01
    local pcldSmooth       = 10

    local pcldItems = {}
    local pcldConn1 = nil
    local pcldConn2 = nil

    function createPCLD(original)
        if pcldItems[original] then return end
        pcall(function() original.Transparency = 1 end)

        local LP = game:GetService("Players").LocalPlayer

        local box = Instance.new("Part")
        box.Name         = "_PCLD_Box"
        box.Size         = original.Size
        box.CFrame       = original.CFrame
        box.Anchored     = true
        box.CanCollide   = false
        box.CanTouch     = false
        box.CanQuery     = false
        box.CastShadow   = false
        box.Material     = Enum.Material.Neon
        box.Color        = pcldBoxColor
        box.Transparency = pcldBoxTrans
        box.Parent       = workspace

        local outline = Instance.new("SelectionBox")
        outline.Adornee             = box
        outline.LineThickness       = pcldOutlineSize
        outline.Color3              = pcldOutlineColor
        outline.Transparency        = pcldOutlineTrans
        outline.SurfaceTransparency = 1
        outline.Parent              = box

        -- Détecte si c'est MON PCLD : PartOwner ou proximité < 5 studs
        local myChar0 = LP.Character
        local myHRP0  = myChar0 and myChar0:FindFirstChild("HumanoidRootPart")
        local po      = original:FindFirstChild("PartOwner")
        local isMine  = (po and po.Value == LP.Name)
                    or (myHRP0 and (myHRP0.Position - original.Position).Magnitude < 5)

        -- BillboardGui "Moi" toujours créé, visible seulement si isMine et loin
        local bb = Instance.new("BillboardGui")
        bb.Size        = UDim2.new(0, 120, 0, 40)
        bb.AlwaysOnTop = true
        bb.Adornee     = box
        bb.Parent      = workspace

        local lbl = Instance.new("TextLabel", bb)
        lbl.Size                   = UDim2.new(1,0,1,0)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3             = Color3.fromRGB(255, 255, 255)
        lbl.TextStrokeColor3       = Color3.new(0,0,0)
        lbl.TextStrokeTransparency = 0.2
        lbl.Font                   = Enum.Font.GothamBold
        lbl.TextScaled             = false
        lbl.TextSize               = 18
        lbl.Text                   = "Moi"
        lbl.TextTransparency       = 1

        local conn = RS_PCLD.Heartbeat:Connect(function(dt)
            if not original.Parent then return end
            local alpha = 1 - math.exp(-pcldSmooth * dt)
            box.CFrame = box.CFrame:Lerp(original.CFrame, alpha)

            if isMine then
                local myChar = LP.Character
                local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHRP and myHRP.Parent then
                    local dist = (myHRP.Position - box.Position).Magnitude
                    if dist > 20 then
                        lbl.TextSize         = math.clamp(math.floor(18 + dist * 0.1), 18, 36)
                        lbl.TextTransparency = 0
                    else
                        lbl.TextTransparency = 1
                    end
                end
            end
        end)

        pcldItems[original] = { box=box, outline=outline, bb=bb, lbl=lbl, conn=conn }
    end

    function removePCLD(original)
        local d = pcldItems[original]
        if not d then return end
        pcall(function() d.conn:Disconnect() end)
        if d.box and d.box.Parent then d.box:Destroy() end
        if d.bb  and d.bb.Parent  then d.bb:Destroy()  end
        pcldItems[original] = nil
    end

    function clearAllPCLD()
        for orig in pairs(pcldItems) do
            local d = pcldItems[orig]
            pcall(function() d.conn:Disconnect() end)
            if d.box and d.box.Parent then d.box:Destroy() end
            if d.bb  and d.bb.Parent  then d.bb:Destroy()  end
        end
        pcldItems = {}
    end

    PCLDBlock:CreateToggle({
        Name     = "PCLD ESP",
        Flag     = "PCLDEspToggle",
        Default  = false,
        Callback = function(v)
            if v then
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj.Name == "PlayerCharacterLocationDetector" then
                        createPCLD(obj)
                    end
                end
