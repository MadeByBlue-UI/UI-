do
    local CmdBlock = Tabs.Config:CreateBlock({ Name = "Commandes Chat", Side = "Right" })
    local CMD_Active = false
    local CMD_Conn   = nil
    local CMD_Silent = false

    function CMD_Notify(title, content)
        Library:Notify({ Title = title, Content = content, Duration = 4 })
    end

    local CMD_LIEUX = {
        spawn=CFrame.new(4,-7,-3), greenhouse=CFrame.new(-352,99,354),
        farmhouse=CFrame.new(-234,83,-324), chinese=CFrame.new(579,124,-94),
        blue=CFrame.new(538,96,-372), witch=CFrame.new(296,-4,494),
        red=CFrame.new(-516,-6,-162), green=CFrame.new(-584,-6,93),
        cave=CFrame.new(17,-7,539), traincave=CFrame.new(500,62,-307),
        mine=CFrame.new(-254,-7,518),
    }
    local CMD_lastPos = nil

    function CMD_findPlayer(input)
        if not input or input=="" then return nil end
        input = input:lower()
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
            if p.Name:lower():sub(1,#input)==input or p.DisplayName:lower():sub(1,#input)==input then
                return p
            end
        end
    end

    function CMD_bring(targetPlayer)
        local RS_CMD = game:GetService("ReplicatedStorage")
        local GE_CMD = RS_CMD:WaitForChild("GrabEvents")
        local SNO_CMD = GE_CMD:WaitForChild("SetNetworkOwner")
        local DL_CMD  = GE_CMD:WaitForChild("DestroyGrabLine")
        local myChar = LocalPlayer.Character
        local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myHRP or not myHum then return end
        local tChar = targetPlayer.Character
        local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHead = tChar and tChar:FindFirstChild("Head")
        local tHum  = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not tHRP or not tHead or not tHum then
            CMD_Notify(".b", targetPlayer.Name .. " introuvable.")
            return
        end
        if tHum.Health <= 0 then return end
        local inPlot = targetPlayer:FindFirstChild("InPlot") and targetPlayer.InPlot.Value
        if inPlot then CMD_Notify(".b", targetPlayer.Name .. " dans un plot, tentative...") end
        local backupCF = myHRP.CFrame
        local lastPos  = tHRP.Position
        local timer    = 0
        while not (tHead:FindFirstChild("PartOwner") and tHead.PartOwner.Value == LocalPlayer.Name) do
            if not tHRP.Parent or myHum.Health<=0 or tHum.Health<=0 then break end
            if timer > 74 then break end
            timer = timer + 1
            myHRP.CFrame = CFrame.new(tHRP.Position + Vector3.new(0,-3.5,0))
            lastPos = tHRP.Position
            pcall(function() SNO_CMD:FireServer(tHRP, tHRP.CFrame) end)
            task.wait()
        end
        myHRP.CFrame = backupCF
        local owned = tHead:FindFirstChild("PartOwner") and tHead.PartOwner.Value == LocalPlayer.Name
        if owned then
            CMD_Notify(".b", targetPlayer.DisplayName .. " amené devant toi (hold 10s)")
            -- Maintient le joueur devant pendant 10 secondes (augmenté de 3s)
            local holdEnd = tick() + 10
            while tick() < holdEnd do
                if not tHRP.Parent or not myHRP.Parent or (myHum.Health and myHum.Health <= 0) then break end
                -- Position devant toi
                tHRP.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3)
                tHRP.AssemblyLinearVelocity  = Vector3.zero
                tHRP.AssemblyAngularVelocity = Vector3.zero
                -- Ownership + DGL pour maintenir le grab
                pcall(function() 
                    SNO_CMD:FireServer(tHRP, tHRP.CFrame)
                    SNO_CMD:FireServer(tHead, tHead.CFrame)
                end)
                task.wait(0.03)  -- Plus rapide (0.03 au lieu de 0.05)
            end
            -- Lâche le joueur proprement
            pcall(function() DL_CMD:FireServer(tHRP) end)
            CMD_Notify(".b", targetPlayer.DisplayName .. " relâché")
        else
            local reason = inPlot and " (dans son plot)" or ""
            CMD_Notify(".b", "Echec" .. reason)
        end
    end

    function CMD_handle(message)
        message = message:lower():match("^%s*(.-)%s*$")
        if message:sub(1,3)=="/e " then message=message:sub(4) end
        local args={}
        for w in message:gmatch("%S+") do table.insert(args,w) end
        if #args<1 then return end
        local cmd=args[1]

        if cmd==".b" then
            if not args[2] then CMD_Notify("Commandes",".b <nom1> <nom2>..."); return end
            for i=2,#args do
                local t=CMD_findPlayer(args[i])
                if t then task.spawn(CMD_bring,t)
                else CMD_Notify(".b","Introuvable : "..args[i]) end
            end
        elseif cmd==".tp" then
            if not args[2] then CMD_Notify(".tp",".tp <lieu/nom>"); return end
            local char=LocalPlayer.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            CMD_lastPos=hrp.CFrame
            local lieu=CMD_LIEUX[args[2]:lower()]
            if lieu then
                hrp.CFrame=lieu
                CMD_Notify(".tp","-> "..args[2])
            else
                local t=CMD_findPlayer(args[2])
                if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
                    hrp.CFrame=t.Character.HumanoidRootPart.CFrame*CFrame.new(0,0,-3)
                    CMD_Notify(".tp","-> "..t.DisplayName)
                else
                    CMD_Notify(".tp","Introuvable : "..args[2])
                end
            end
        elseif cmd==".back" then
            local char=LocalPlayer.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            if hrp and CMD_lastPos then
                local cur=hrp.CFrame; hrp.CFrame=CMD_lastPos; CMD_lastPos=cur
                CMD_Notify(".back","Retour position precedente")
            else
                CMD_Notify(".back","Aucune position sauvegardee")
            end
        elseif cmd==".al" then
            local cb=LocalPlayer.PlayerScripts:FindFirstChild("CharacterAndBeamMove")
            if cb then
                cb.Enabled=not cb.Enabled
                CMD_Notify(".al","Anti-Lag : "..(cb.Enabled and "OFF" or "ON"))
            end
        elseif cmd==".ag" then
            local v=not GetToggleState("AntiGrabV2Toggle")
            SetToggleState("AntiGrabV2Toggle",v)
            pcall(function() local f=Library.Items["AntiGrabV2Toggle"]; if f then f.Set(v) end end)
            CMD_Notify(".ag","Anti-Grab : "..(v and "ON" or "OFF"))
        elseif cmd==".ak" then
            local v=not GetToggleState("AntiKickItem")
            SetToggleState("AntiKickItem",v)
            pcall(function() local f=Library.Items["AntiKickItem"]; if f then f.Set(v) end end)
            CMD_Notify(".ak","Anti-Kick : "..(v and "ON" or "OFF"))
        elseif cmd==".tr" then
            CMD_Silent=not CMD_Silent
            CMD_Notify(".tr","Mode silencieux : "..(CMD_Silent and "ON" or "OFF"))
        elseif cmd==".aide" then
            CMD_Notify("Commandes",".b .tp .back .al .ag .ak .tr")
        end
    end

    CmdBlock:CreateToggle({
        Name="Activer commandes chat", Flag="ChatCmdsToggle", Default=false,
        Callback=function(v)
            CMD_Active=v
            if v then
                pcall(function()
                    _TrackConn(game:GetService("TextChatService").SendingMessage:Connect(function(msg)
                        if not CMD_Active then return end
                        local t=msg.Text or ""
                        local c=t:lower():match("^%s*(.-)%s*$")
                        if c:sub(1,3)=="/e " then c=c:sub(4) end
                        if c:sub(1,1)=="." then task.spawn(CMD_handle,t) end
                    end))
                end)
                CMD_Conn=LocalPlayer.Chatted:Connect(function(msg)
                    if not CMD_Active then return end
                    local c=msg:lower():match("^%s*(.-)%s*$")
                    if c:sub(1,3)=="/e " then c=c:sub(4) end
                    if c:sub(1,1)=="." then CMD_handle(msg) end
                end)
                CMD_Notify("Commandes","Actives. Tape .aide")
            else
                if CMD_Conn then CMD_Conn:Disconnect(); CMD_Conn=nil end
                CMD_Notify("Commandes","Desactivees.")
            end
        end
    })

    CmdBlock:CreateButton({ 
        Name="Aide (commandes)",
        Callback=function()
            CMD_Notify("Commandes disponibles",".b .tp .back .al .ag .ak .tr")
        end
    })
end

-- =========================================================================
-- HUD PANEL (pièces + MS - design moderne & compact avec effets)
-- =========================================================================
do
    local _TS      = game:GetService("TweenService")
    local _Stats   = game:GetService("Stats")
    local _Players = game:GetService("Players")
    local _UIS     = game:GetService("UserInputService")
    
    -- Fonction pour ajouter l'effet de particules fluides (comme l'UI principale)
    function AddFluidParticles(parentFrame, particleCount)
        local particleContainer = Instance.new("Frame")
        particleContainer.Size = UDim2.fromScale(1, 1)
        particleContainer.BackgroundTransparency = 1
        particleContainer.ClipsDescendants = true
        particleContainer.ZIndex = parentFrame.ZIndex
        particleContainer.Parent = parentFrame
        
        local particles = {}
        
        -- Crée les particules
        for i = 1, particleCount or 8 do
            local size = math.random(2, 4)
            local particle = Instance.new("Frame")
            particle.Size = UDim2.fromOffset(size, size)
            particle.Position = UDim2.fromScale(math.random(0, 100) / 100, math.random(0, 100) / 100)
            particle.AnchorPoint = Vector2.new(0.5, 0.5)
            particle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            particle.BackgroundTransparency = math.random(80, 94) / 100
            particle.BorderSizePixel = 0
            particle.ZIndex = parentFrame.ZIndex + 1
            particle.Parent = particleContainer
            
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = particle
            
            table.insert(particles, {
                frame = particle,
                velocity = Vector2.new(math.random(-15, 15) / 100, math.random(-15, 15) / 100)
            })
        end
        
        -- Animation fluide avec évitement du curseur
        task.spawn(function()
            while particleContainer.Parent do
                local mousePos = _UIS:GetMouseLocation()
                local framePos = parentFrame.AbsolutePosition
                local frameSize = parentFrame.AbsoluteSize
                
                local relMouseX = (mousePos.X - framePos.X) / frameSize.X
                local relMouseY = (mousePos.Y - framePos.Y) / frameSize.Y
                
                for _, pData in ipairs(particles) do
                    if pData.frame and pData.frame.Parent then
                        local pos = pData.frame.Position
                        local x, y = pos.X.Scale, pos.Y.Scale
                        
                        -- Répulsion du curseur
                        local dx, dy = x - relMouseX, y - relMouseY
                        local dist = math.sqrt(dx * dx + dy * dy)
                        
                        if dist < 0.2 and dist > 0 then
                            local force = (0.2 - dist) / 0.2 * 0.015
                            pData.velocity = pData.velocity + Vector2.new(dx / dist * force, dy / dist * force)
                        end
                        
                        -- Applique vélocité
                        local newX = x + pData.velocity.X * 0.016
                        local newY = y + pData.velocity.Y * 0.016
                        
                        -- Rebond
                        if newX <= 0 or newX >= 1 then
                            pData.velocity = Vector2.new(-pData.velocity.X, pData.velocity.Y)
                            newX = math.clamp(newX, 0, 1)
                        end
                        if newY <= 0 or newY >= 1 then
                            pData.velocity = Vector2.new(pData.velocity.X, -pData.velocity.Y)
                            newY = math.clamp(newY, 0, 1)
                        end
                        
                        pData.velocity = pData.velocity * 0.99
                        pData.frame.Position = UDim2.fromScale(newX, newY)
                    end
                end
                
                task.wait(0.016)
            end
        end)
        
        return particleContainer
