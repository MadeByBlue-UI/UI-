        function DS.hudParticles(parent, count)
            local box = Instance.new("Frame")
            box.Size = UDim2.fromScale(1, 1)
            box.BackgroundTransparency = 1
            box.ClipsDescendants = true
            box.ZIndex = parent.ZIndex
            box.Parent = parent
            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 30)
            local list = {}
            for _ = 1, count do
                local sz = math.random(2, 4)
                local pt = Instance.new("Frame")
                pt.Size = UDim2.fromOffset(sz, sz)
                pt.Position = UDim2.fromScale(math.random(0, 100) / 100, math.random(0, 100) / 100)
                pt.AnchorPoint = Vector2.new(0.5, 0.5)
                pt.BackgroundColor3 = Color3.new(1, 1, 1)
                pt.BackgroundTransparency = math.random(80, 94) / 100
                pt.BorderSizePixel = 0
                pt.ZIndex = parent.ZIndex + 1
                pt.Parent = box
                Instance.new("UICorner", pt).CornerRadius = UDim.new(1, 0)
                list[#list + 1] = { f = pt, v = Vector2.new(math.random(-15, 15) / 100, math.random(-15, 15) / 100) }
            end
            task.spawn(function()
                while box.Parent do
                    for _, d in ipairs(list) do
                        if d.f.Parent then
                            local nx, ny = d.f.Position.X.Scale + d.v.X * 0.03, d.f.Position.Y.Scale + d.v.Y * 0.03
                            if nx <= 0 or nx >= 1 then d.v = Vector2.new(-d.v.X, d.v.Y); nx = math.clamp(nx, 0, 1) end
                            if ny <= 0 or ny >= 1 then d.v = Vector2.new(d.v.X, -d.v.Y); ny = math.clamp(ny, 0, 1) end
                            d.f.Position = UDim2.fromScale(nx, ny)
                        end
                    end
                    task.wait(0.03)
                end
            end)
        end

