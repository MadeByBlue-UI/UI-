-- NINJA KUNAI STICK TARGET (Multi-Joueurs)
-- Colle des kunai sur plusieurs joueurs sélectionnés
-- =========================================================================
do
    local NK_TARGET_Active = false
    local NK_TARGET_Players = {}  -- Liste des joueurs sélectionnés {[nom] = true}
    
    local setOwner_NK = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
    local stickyEvt_NK = ReplicatedStorage:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
    local spawnToy_NK = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local destroyToy_NK = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    local canSpawn_NK = LocalPlayer:WaitForChild("CanSpawnToy")
    
    local TOY_NAME_NK = "NinjaKunai"
    local STICK_CFRAME_NK = CFrame.new(0.5, -0.9, 0) * CFrame.Angles(math.rad(0), math.rad(90), math.rad(90))
    
    -- Fonction pour vérifier si kunai est attaché
    function IsAttached_NK(kunai)
        if not kunai or not kunai:FindFirstChild("StickyPart") then return false end
        local stickyWeld = kunai.StickyPart:FindFirstChild("StickyWeld")
        return stickyWeld and stickyWeld.Part1 ~= nil
    end
    
    -- Fonction pour vérifier si joueur dans plot
    function IsPlayerInPlot_NK(targetPlayer)
        if not targetPlayer then return false end
        local inPlot = targetPlayer:FindFirstChild("InPlot")
        if not inPlot then return false end
        return inPlot.Value == true
    end
    
    -- Fonction spawn kunai sur un joueur cible
    function SpawnAndAttachKunaiTarget(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return nil end
        if IsPlayerInPlot_NK(targetPlayer) then return nil end
        
        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local firePart = targetHRP and targetHRP:FindFirstChild("FirePlayerPart")
        if not firePart then return nil end
        
        local myChar = Player.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return nil end
        
        local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
        if not inv then return nil end
        
        -- Attendre CanSpawn
        if not canSpawn_NK.Value then
            local t = tick()
            repeat task.wait(0.05) until canSpawn_NK.Value or tick() - t > 3
        end
        
        -- Spawn visible au-dessus
        task.spawn(function()
            pcall(function()
                spawnToy_NK:InvokeServer(TOY_NAME_NK, myHRP.CFrame * CFrame.new(0, 9, 20), Vector3.zero)
            end)
        end)
        
        task.wait(0.15)
        local kunai = inv:FindFirstChild(TOY_NAME_NK)
        if not kunai then return nil end
        
        kunai.Name = "NK_Target_" .. targetPlayer.Name
        
        -- Désactiver les collisions
        for _, obj in pairs(kunai:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanTouch = false
                obj.CanCollide = false
                obj.CanQuery = false
            end
        end
        
        local stickyPart = kunai:FindFirstChild("StickyPart")
        if stickyPart then
            pcall(function()
                setOwner_NK:FireServer(stickyPart, stickyPart.CFrame)
            end)
            
            pcall(function()
                stickyEvt_NK:FireServer(stickyPart, firePart, STICK_CFRAME_NK)
            end)
            
            -- Vérifier après 2 secondes
            task.delay(2, function()
                if kunai and kunai.Parent and not IsAttached_NK(kunai) then
                    pcall(function() destroyToy_NK:FireServer(kunai) end)
                end
            end)
        end
        
        notify("Ninja Kunai", "🗡️ Kunai collé sur " .. targetPlayer.Name, 2)
        return kunai
    end
    
    DefenseExtra:CreateToggle({
        Name     = "Ninja Kunai Stick TARGET",
        Flag     = "NinjaKunaiTargetToggle",
        Default  = false,
        Callback = function(Value)
            NK_TARGET_Active = Value
            
            if Value then
                local count = 0
                for _ in pairs(NK_TARGET_Players) do count = count + 1 end
                
