        if K.inConn then pcall(function() K.inConn:Disconnect() end); K.inConn = nil end
        pcall(function() game:GetService("RunService"):UnbindFromRenderStep("FigureCrawlCamera") end)
        if K.act then
            K.act, K.justEnded = false, true
            pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
            pcall(function() game:GetService("UserInputService").MouseIconEnabled = true end)
        end
    end

    -- caméra : derrière le corps, "haut" = normale de la surface (la caméra pivote avec le mur / le toit)
    function _G._FigureCrawlCamera()
        local K = _G._FigureCrawl
        if not (K.act and K.pv) then return end
        local cam = workspace.CurrentCamera
        local UIS = game:GetService("UserInputService")
        UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        UIS.MouseIconEnabled = false
        local up = K.up
        local focus = K.pv + up * (K.hh * K.cs + 1.5)
        local desired = focus - K.camLook * K.camDist
        local pos = desired
        if K.rp then
            local hit = workspace:Raycast(focus, desired - focus, K.rp)
            if hit then pos = hit.Position + hit.Normal * 0.3 end
        end
        if (pos - focus).Magnitude < 0.1 then
            cam.CFrame = CFrame.lookAt(focus, focus + K.camLook, up)
        else
            cam.CFrame = CFrame.lookAt(pos, focus, up)
        end
    end

    -- orientation de la tête : elle regarde vers l'avant de la surface, suit la caméra (±75°) et reste un peu levée
    function _G._FigureCrawlHeadCF(pos)
        local K = _G._FigureCrawl
        local up, face = K.up, K.face
        local right = face:Cross(up)
        local cl = K.camLook
        local flat = cl - up * cl:Dot(up)
        local yaw = 0
        if flat.Magnitude > 0.05 then
            flat = flat.Unit
            yaw = math.clamp(math.atan2(flat:Dot(right), flat:Dot(face)), -math.rad(75), math.rad(75))
        end
        local fl = face * math.cos(yaw) + right * math.sin(yaw)
        local pit = math.clamp(math.asin(math.clamp(cl:Dot(up), -1, 1)) + math.rad(15), math.rad(-10), math.rad(55))
        local look = fl * math.cos(pit) + up * math.sin(pit)
        return CFrame.lookAt(pos, pos + look, up)
    end

    -- Renvoie l'origine du squelette (point de la surface relevé de 14.2 unités le long de la normale) ou nil quand on ne rampe pas.
    -- dt = delta temps, cs = échelle du bonhomme, headPos = position debout de la tête (sert seulement au démarrage).
    function _G._FigureCrawlStep(dt, cs, headPos)
        local K = _G._FigureCrawl
        dt = math.clamp(dt or 0.016, 0.001, 0.1)
        local ok = K.on and figureFormation == "Stick Man" and #figureBodyCache >= 13 and _G._ObjCtrlFlying ~= true
        if not ok then
            if K.act then _G._FigureCrawlStop() end
            return nil
        end
        local UIS = game:GetService("UserInputService")
        local now = os.clock()
        local function proj(v, n) return v - n * v:Dot(n) end
        local function unit(v, fb) if v.Magnitude > 1e-4 then return v.Unit end return fb end

        -- filtre des rayons : ton perso, les persos des autres, tous les toys
        if not K.rp then
            K.rp = RaycastParams.new()
            K.rp.FilterType = Enum.RaycastFilterType.Exclude
            K.rp.RespectCanCollide = true
        end
        if not K.filter or now - K.filterT > 1 then
            K.filterT = now
            local list = {}
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr.Character then list[#list + 1] = plr.Character end
            end
            for _, ch in ipairs(workspace:GetChildren()) do
                if string.sub(ch.Name, -13) == "SpawnedInToys" then list[#list + 1] = ch end
            end
            K.filter = list
            K.rp.FilterDescendantsInstances = list
        end

        local sty = K.styles[K.styleName] or K.styles["À quatre pattes"]
        K.hh, K.cs = sty.hh, cs
        local hh = sty.hh * cs
        local cam = workspace.CurrentCamera

        -- ▶️ démarrage : on cherche la surface sous la tête
        if not K.act then
            local hit = workspace:Raycast(headPos + Vector3.new(0, 2, 0), Vector3.new(0, -400, 0), K.rp)
            if not hit then
                K.on = false
                if K.tg then pcall(function() K.tg:Set(false) end) end
                pcall(notify, "Animated Figure", "🕷️ Aucune surface sous toi : rampe impossible", 3)
                return nil
            end
            K.p, K.pv, K.lastP = hit.Position, hit.Position, hit.Position
            K.up = hit.Normal
            K.camLook = cam.CFrame.LookVector
            K.face = unit(proj(K.camLook, K.up), unit(proj(cam.CFrame.RightVector, K.up), Vector3.zAxis))
            K.camDist = math.clamp((cam.CFrame.Position - headPos).Magnitude, 6, 40)
            K.pend, K.mv, K.mvK = Vector2.zero, 0, 0
            K.act = true
            cam.CameraType = Enum.CameraType.Scriptable
            pcall(function() game:GetService("RunService"):UnbindFromRenderStep("FigureCrawlCamera") end)
            game:GetService("RunService"):BindToRenderStep("FigureCrawlCamera", Enum.RenderPriority.Camera.Value + 1, function() _G._FigureCrawlCamera() end)
            if K.inConn then pcall(function() K.inConn:Disconnect() end) end
            K.inConn = UIS.InputChanged:Connect(function(input)
                if not K.act then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    K.pend = K.pend + Vector2.new(input.Delta.X, input.Delta.Y)
                elseif input.UserInputType == Enum.UserInputType.MouseWheel then
                    K.camDist = math.clamp(K.camDist - input.Position.Z * 1.5, 3, 60)
                end
            end)
            pcall(notify, "Animated Figure", "🕷️ Rampe activée : ZQSD pour avancer sur toute surface (mur, toit), souris = caméra", 4)
        end

        local up, p = K.up, K.p

        -- 🖱️ caméra (la souris tourne autour de la normale de la surface)
        local d = K.pend
        K.pend = Vector2.zero
        if d.X ~= 0 or d.Y ~= 0 then
            K.camLook = CFrame.fromAxisAngle(up, -d.X * K.sens):VectorToWorldSpace(K.camLook)
            local fl = unit(proj(K.camLook, up), K.face)
            local el = math.asin(math.clamp(K.camLook:Dot(up), -1, 1))
            el = math.clamp(el - d.Y * K.sens, -1.4, 1.4)
            K.camLook = fl * math.cos(el) + up * math.sin(el)
        end

        -- ⌨️ direction voulue (relative à la caméra, dans le plan de la surface)
        local x, z = 0, 0
        if not UIS:GetFocusedTextBox() then
            local function kd(k) return UIS:IsKeyDown(k) and 1 or 0 end
            x = math.clamp(kd(Enum.KeyCode.D) + kd(Enum.KeyCode.Right) - kd(Enum.KeyCode.A) - kd(Enum.KeyCode.Left), -1, 1)
            z = math.clamp(kd(Enum.KeyCode.W) + kd(Enum.KeyCode.Up) - kd(Enum.KeyCode.S) - kd(Enum.KeyCode.Down), -1, 1)
        end
        local look = unit(proj(K.camLook, up), K.face)
        local right = look:Cross(up)
        local moveDir = look * z + right * x
        local moving = moveDir.Magnitude > 0.01
        if moving then
            moveDir = moveDir.Unit
            K.face = unit(K.face:Lerp(moveDir, 1 - math.exp(-14 * dt)), moveDir)
        end

        -- 🧲 déplacement collé à la surface
        local newUp = up
        local ch = math.max(1.0, hh * 0.45)            -- hauteur du rayon "poitrine" au-dessus de la surface
        if moving then
            local step = K.speed * dt
            local clr = 1.8 * cs + 0.8
            local hitF = workspace:Raycast(p + up * ch, moveDir * (step + clr), K.rp)
            if hitF then
                -- obstacle devant : mur / angle intérieur (on bascule dessus) ou simple pente (on la suit)
                p, newUp = hitF.Position, hitF.Normal
            else
                local np = p + moveDir * step
                local hitD = workspace:Raycast(np + up * (ch + 0.5), -up * (ch + 4.5), K.rp)
                if hitD then
                    p, newUp = hitD.Position, hitD.Normal
                else
                    -- plus de surface : angle extérieur (bord de toit) -> on passe sur la face qui descend
                    local hitE = workspace:Raycast(np - up * 1.2, -moveDir * (step + 2.5), K.rp)
                    if hitE and hitE.Normal:Dot(up) < 0.5 then
                        p, newUp = hitE.Position, hitE.Normal
                    end
                end
            end
        else
            local hs = workspace:Raycast(p + up * (ch + 0.5), -up * (ch + 3), K.rp)
            if hs and hs.Normal:Dot(up) > 0.5 then p = hs.Position end
        end
        K.p = p

        -- 🔄 la normale tourne en douceur ; la caméra et le corps tournent avec elle
        if newUp ~= up then
            local nu = unit(up:Lerp(newUp, 1 - math.exp(-14 * dt)), newUp)
            local ax = up:Cross(nu)
            if ax.Magnitude > 1e-5 then
                local rot = CFrame.fromAxisAngle(ax.Unit, math.acos(math.clamp(up:Dot(nu), -1, 1)))
                K.camLook = rot:VectorToWorldSpace(K.camLook)
                K.face = rot:VectorToWorldSpace(K.face)
            end
            up = nu
            K.up = up
        end
        K.face = unit(proj(K.face, up), unit(proj(look, up), Vector3.zAxis))

        -- 🐾 vitesse réelle -> cadence des pattes
        K.pv = K.pv:Lerp(p, 1 - math.exp(-35 * dt))
        local sp = K.lastP and ((p - K.lastP).Magnitude / dt) or 0
        K.lastP = p
        K.mv = K.mv + (sp - K.mv) * math.min(1, dt * 10)
        K.mvK = math.clamp(K.mv / 3, 0, 1)
        K.ph = K.ph + dt * math.clamp(2 * math.pi * K.mv / (6 * math.max(cs, 0.2)), 0, 16)

        K.r, K.u, K.f = K.face:Cross(up), up, K.face
        K.skN = (K.skN or 0) + 1                      -- nouvelle frame : le squelette est recalculé une seule fois
        K.O = K.pv + up * (14.2 * cs)
        return K.O
    end

    -- Renvoie la position (ancre de la tête) à imposer à la formation, ou nil quand il n'y a pas d'escalade.
    -- pos = position du toy de tête, fh = hauteur du bonhomme (sol -> tête), cs = échelle de la formation.
    function _G._FigureClimbStep(pos, fh, cs, dt)
        local C = _G._FigureClimb
        dt = math.clamp(dt or 0.016, 0.001, 0.1)
        local now = os.clock()
        local UIS = game:GetService("UserInputService")

        local blocked = (not C.on) or figureFormation ~= "Stick Man" or #figureBodyCache < 13
            or figureAnimationMode ~= "Auto" or (not figureGroundSnap)
            or (_WallWalkState and _WallWalkState.enabled)
            or (_ObjectWallWalk and _ObjectWallWalk.enabled)
            or _G._ObjCtrlFlying == true or _G._FigureIsSuperman()
        if blocked then
            -- 🧗 dit pourquoi l'escalade ne démarre pas (une seule fois par cause)
            if not (C.on and not C.active) then C.blockT = 0 end
            if C.on and not C.active then
                C.blockT = (C.blockT or 0) + dt
                local why
                if figureFormation ~= "Stick Man" or #figureBodyCache < 13 then why = "il faut la formation « Stick Man » complète (13+ toys)"
                elseif figureAnimationMode ~= "Auto" then why = "mets l'animation de la figure sur « Auto »"
                elseif not figureGroundSnap then why = "active le Ground Snap"
                end
                if why and C.warned ~= why and C.blockT > 2 then
                    C.warned = why
                    pcall(notify, "Animated Figure", "🧗 Escalade bloquée : " .. why, 4)
                end
            end
            if C.active then _G._FigureClimbEnd(0.3) end
            C.lastPos = pos
            return nil
        end
        C.warned, C.blockT = nil, 0

        -- filtre des rayons : ton perso, les persos des autres, tous les toys
        if not C.filter or now - C.filterT > 1 then
            C.filterT = now
            local list = {}
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr.Character then list[#list + 1] = plr.Character end
            end
            for _, ch in ipairs(workspace:GetChildren()) do
                if string.sub(ch.Name, -13) == "SpawnedInToys" then list[#list + 1] = ch end
            end
            C.filter = list
        end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = C.filter
        rp.RespectCanCollide = true

        -- hauteur des pieds au-dessus du sol (0 = au sol)
        local function feetHeight(p)
            local h = workspace:Raycast(p, Vector3.new(0, -400, 0), rp)
            if not h then return 99 end
            return p.Y - (h.Position.Y + figureGroundOffset + fh + figureHeadHeight)
        end
        local function sm(t) t = math.clamp(t, 0, 1); return t * t * (3 - 2 * t) end

        -- rebord à portée ? (sol / dessus de mur un peu plus haut, avec la place de se tenir debout) -> hauteur Y du dessus
        local function findLedge(Wp, n, refY)
            local minTop = refY - 4 * cs
            local startY = refY + C.ledgeReach + 1
            for _, d in ipairs({ 1.5, 1.0, 0.7, 2.6 }) do
                local o = Vector3.new(Wp.X, startY, Wp.Z) - n * d
                local hit = workspace:Raycast(o, Vector3.new(0, -(startY - minTop), 0), rp)
                if hit and hit.Normal.Y > 0.85 and hit.Position.Y >= minTop and hit.Position.Y <= refY + C.ledgeReach then
                    local free = workspace:Raycast(hit.Position + Vector3.new(0, 0.6, 0), Vector3.new(0, fh * 0.95, 0), rp)
                    if not free then return hit.Position.Y, d end   -- 🛠️ renvoie aussi la colonne validée (point d'arrivée)
                end
            end
            return nil
        end

        -- Saut Libre : la simulation de saut suit la hauteur imposée (sinon elle te ramènerait au sol sous le mur)
        local function syncJump(y)
            local fj = _G._FigureFJ
            if fj and _G._FigureGroundMethod == "Saut Libre" then
                fj.y, fj.vy, fj.air, fj.jumped, fj.flying = y, 0, true, false, false
            end
        end

        ------------------------------------------------------------------
        -- ESCALADE EN COURS
        ------------------------------------------------------------------
        if C.active then
            local typing = UIS:GetFocusedTextBox() ~= nil
            local sp = (not typing) and UIS:IsKeyDown(Enum.KeyCode.Space)
            local down = (not typing) and UIS:IsKeyDown(Enum.KeyCode.S)
            local shift = (not typing) and UIS:IsKeyDown(Enum.KeyCode.LeftShift)
            local released = (sp and not C.spaceWas and now - C.t0 > 0.12) or shift
            C.spaceWas = sp
            local n, fwd, px, wz = C.n, C.fwd, C.px, C.wz
            C.wallW = (C.wallW or 0) + (((C.state == "wall") and 1 or 0) - (C.wallW or 0)) * (1 - math.exp(-8 * dt))

            if C.state ~= "climb" then
                -- le mur est toujours là ? sinon (ou Espace / Maj) on lâche
                local o = Vector3.new(C.pos.X, C.pos.Y - 0.3 * fh, C.pos.Z)
                local wall = workspace:Raycast(o, fwd * (wz * cs + 2.5), rp)
                -- tolérance : une fenêtre / un trou dans le mur ne fait plus lâcher tout de suite (0.3 s max)
                if wall then C.lost = 0 else C.lost = (C.lost or 0) + dt end
                if released or C.lost > 0.3 then
                    _G._FigureClimbEnd(0.6)
                    return nil
                end
                -- suivi du mur : la normale / la position se recalent sur la surface réelle (murs légèrement courbes ou désaxés)
                if wall and C.state == "wall" and wall.Normal.Y > -0.3 and wall.Normal.Y < 0.35 then
                    local nn = Vector3.new(wall.Normal.X, 0, wall.Normal.Z)
                    if nn.Magnitude > 0.5 then
                        nn = nn.Unit
                        if nn:Dot(n) > 0.7 then
                            local kw = 1 - math.exp(-10 * dt)
                            local m2 = n:Lerp(nn, kw)
                            if m2.Magnitude > 1e-3 then
                                n = m2.Unit
                                C.n, C.fwd, C.right = n, -n, (-n):Cross(Vector3.yAxis)
                                fwd = C.fwd
                                C.px = Vector3.new(wall.Position.X, 0, wall.Position.Z) + n * (wz * cs)
                                px = C.px
                            end
                        end
                    end
                end

                local k = 1 - math.exp(-16 * dt)
                local py
                if C.state == "wall" then
                    -- on grimpe : la hauteur monte, la phase des bras / jambes avance avec
                    local ramp = math.clamp((now - C.t0) / 0.25, 0, 1)
                    local sty = C.sty or {}
                    local surge = 1 + 0.28 * math.sin(C.ph * 2 - 0.8)   -- 🧗 le corps monte par poussées, calées sur le cycle des membres
                    -- 🚀 Boost Ctrl gauche (comme dans le contrôle de toy) : x1 -> x4 en 5 s en maintenant Ctrl, retombe 2x plus vite au relâchement
                    local _UISb = game:GetService("UserInputService")
                    if _UISb:IsKeyDown(Enum.KeyCode.LeftControl) and _UISb:GetFocusedTextBox() == nil then
                        C.boostT = math.min((C.boostT or 0) + dt, 5)
                    else
                        C.boostT = math.max((C.boostT or 0) - dt * 2, 0)
                    end
                    local boostMult = 1 + ((C.boostT or 0) / 5) * 3
                    local vy = C.climbSpeed * (sty.speed or 1) * figureScale * ramp * surge * boostMult * (down and -0.6 or 1)
                    -- surplomb / plafond au-dessus de la tête : on ne le traverse plus (on s'arrête, puis on lâche après 0.5 s)
                    if vy > 0 then
                        local ch = workspace:Raycast(C.pos, Vector3.new(0, 1.5 * cs + vy * dt, 0), rp)
                        if ch and ch.Normal.Y < -0.5 then
                            vy = 0
                            C.stuck = (C.stuck or 0) + dt
                            if C.stuck > 0.5 then _G._FigureClimbEnd(0.6); return nil end
                        else
                            C.stuck = 0
                        end
                    end
                    py = C.pos.Y + vy * dt
                    C.ph = C.ph + vy * dt * (2 * math.pi / (6.4 * math.max(cs, 0.3))) * (sty.cad or 1)
                    if down then
                        if feetHeight(C.pos) <= 0.15 then _G._FigureClimbEnd(0.6); return nil end   -- redescendu au sol
                    elseif now >= C.tChk then
                        C.tChk = now + 0.05
                        local Wp = Vector3.new(px.X, 0, px.Z) - n * (wz * cs)
                        local top, landD = findLedge(Wp, n, C.pos.Y)
                        if top and (top - 0.3 - figureHeight - 1.7 * cs) <= C.pos.Y + 1.0 then
                            C.top, C.landD, C.state, C.t0 = top, landD, "hang", now                                    -- rebord atteint : on enchaîne
                        end
                    end
                else
                    C.boostT = 0   -- le boost Ctrl repart de zéro hors du mur
                    -- accroche du rebord : la tête se place pour que les mains soient sur le rebord
                    py = C.pos.Y + ((C.top - 0.3 - figureHeight - 1.7 * cs) - C.pos.Y) * k
                end
                C.pos = Vector3.new(C.pos.X + (px.X - C.pos.X) * k, py, C.pos.Z + (px.Z - C.pos.Z) * k)
                C.wzNow = wz
                if C.state == "hang" then
                    local top = C.top
                    C.hy = (top - 0.3 - figureHeight - C.pos.Y) / cs
                    C.hz = wz + 0.3
                    C.ly = (top + 0.3 - figureHeight - C.pos.Y) / cs
                    local goal = top - 0.3 - figureHeight - 1.7 * cs
                    if now - C.t0 > 0.2 and math.abs(C.pos.Y - goal) < 0.7 then
                        C.state, C.t0, C.c, C.dur = "climb", now, 0, 1.4
                    elseif now - C.t0 > 1.5 then
                        _G._FigureClimbEnd(0.6); return nil     -- bloqué à l'accroche : on lâche plutôt que de rester figé
                    end
                end
                syncJump(C.pos.Y)
                return C.pos
            end

            -- ---- traction : accroche -> menton au rebord -> genou sur le rebord -> debout ----
            local top = C.top
            local c = math.clamp((now - C.t0) / C.dur, 0, 1)
            C.c = c
            local H0 = top - 0.3 - figureHeight
            local Pg = Vector3.new(px.X, H0 - 1.7 * cs, px.Z)
            local Pu = Vector3.new(px.X, H0 + 2.6 * cs, px.Z)
            local Pm = Vector3.new(px.X, H0 + 6.0 * cs, px.Z) - n * (0.8 * cs)
            local Wface = Vector3.new(px.X, 0, px.Z) - n * (wz * cs)          -- point sur la face du mur
            local Ld = C.landD or 1.5                                          -- 🛠️ distance derrière la face où le rebord a été VALIDÉ
            local Ps = Vector3.new(Wface.X - n.X * Ld, top + fh + figureGroundOffset + figureHeadHeight, Wface.Z - n.Z * Ld)
            local P
            if c < 0.38 then P = Pg:Lerp(Pu, sm(c / 0.38))
            elseif c < 0.68 then P = Pu:Lerp(Pm, sm((c - 0.38) / 0.30))
            else P = Pm:Lerp(Ps, sm((c - 0.68) / 0.32)) end
            C.pos = P
            local sFwd = (P - Pg):Dot(-n)                      -- avance vers le mur / le rebord
            C.wzNow = wz - sFwd / cs
            C.grip = 1 - sm((c - 0.66) / 0.08)                 -- les mains lâchent le rebord quand on se redresse
            C.hy = (top - 0.3 - figureHeight - P.Y) / cs
            C.hz = C.wzNow + 0.5
            C.ly = (top + 0.3 - figureHeight - P.Y) / cs
            syncJump(P.Y)
            if c >= 1 then
                -- 🛠️ re-vérifie le sol sous le point d'arrivée avec le MÊME filtre que l'escalade, puis fixe la hauteur dessus
                local gy = workspace:Raycast(Vector3.new(Ps.X, top + fh + 2, Ps.Z), Vector3.new(0, -(fh + 6), 0), rp)
                if gy and gy.Normal.Y > 0.7 then
                    Ps = Vector3.new(Ps.X, gy.Position.Y + fh + figureGroundOffset + figureHeadHeight, Ps.Z)
                end
                C.land = { pos = Ps, t = now }
                C.landKeep = { pos = Ps, t = now }   -- 🛠️ verrou d'arrivée du Ground Snap (voir _FigureLandLock)
                syncJump(Ps.Y)
                _G._FigureClimbEnd(1.0)
                return Ps
            end
            return P
        end

        ------------------------------------------------------------------
        -- DÉTECTION (au repos) : on se colle / on marche vers un mur
        ------------------------------------------------------------------
        -- 🛡️ Garde post-arrivée : 0.6 s après la traction, si la formation est envoyée loin du rebord (vide, sous la map...), on la remet dessus
        local L = C.land
        if L then
            if now - L.t > 0.6 then
                C.land = nil
            else
                local dh = Vector3.new(pos.X - L.pos.X, 0, pos.Z - L.pos.Z).Magnitude
                if dh > 20 or pos.Y < L.pos.Y - 4 or pos.Y > L.pos.Y + 30 then
                    _dbg("[ESCALADE] arrivée corrigée :", pos, "->", L.pos)
                    syncJump(L.pos.Y)
                    C.lastPos = L.pos
                    return L.pos
                end
            end
        end

        C.cool = math.max(0, C.cool - dt)
        if C.lastPos then
            local v = (pos - C.lastPos) / dt
            C.vel = C.vel:Lerp(Vector3.new(v.X, 0, v.Z), math.min(1, dt * 10))
        end
        C.lastPos = pos
        if C.cool > 0 then return nil end

        local dir
        local spd = C.vel.Magnitude
        -- 🧭 Direction voulue : touches de déplacement (relatives à la caméra : marche aussi en ZQSD / flèches), sinon la vitesse réelle.
        -- (avant : une fois collé au mur la vitesse tombe à 0 et seule la touche "tout droit" regardant pile le mur était reconnue)
        local cam0 = workspace.CurrentCamera
        if cam0 and UIS:GetFocusedTextBox() == nil then
            local iz = ((UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up)) and 1 or 0)
                - ((UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down)) and 1 or 0)
            local ix = ((UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right)) and 1 or 0)
                - ((UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left)) and 1 or 0)
            if ix ~= 0 or iz ~= 0 then
                local lk, rt = cam0.CFrame.LookVector, cam0.CFrame.RightVector
                local mv = Vector3.new(lk.X, 0, lk.Z) * iz + Vector3.new(rt.X, 0, rt.Z) * ix
                if mv.Magnitude > 0.1 then dir = mv.Unit end
            end
        end
        if not dir and spd > 2.5 then dir = C.vel.Unit end
        if not dir then return nil end

        -- 4 rayons (au-dessus de la tête / tête / poitrine / genoux) : le mur doit être DEVANT toi, vertical, plein sur la hauteur du corps
        -- et monter au moins jusqu'au niveau de la tête. (avant : il fallait un mur plus haut que la tête + 22 % de la taille du bonhomme,
        -- donc la plupart des murs ne déclenchaient rien ; maintenant le rayon "au-dessus" peut rater si celui de la tête touche)
        local len = C.reach * cs + math.clamp(spd * 0.06, 0, 2.5)
        local function cast(f) return workspace:Raycast(Vector3.new(pos.X, pos.Y + f * fh, pos.Z), dir * len, rp) end
        local hU, h0, h1, h2 = cast(0.22), cast(-0.05), cast(-0.30), cast(-0.65)
        if not (h1 and h2 and (h0 or hU)) then return nil end
        if h1.Normal.Y < -0.3 or h1.Normal.Y > 0.35 then return nil end                                         -- mur vertical
        local function samePlane(h)
            return (not h) or (h1.Normal:Dot(h.Normal) >= 0.8 and math.abs((h.Position - h1.Position):Dot(dir)) <= 2.5 * cs)
        end
        if not (samePlane(hU) and samePlane(h0) and samePlane(h2)) then return nil end                          -- même plan du haut en bas
        local n = Vector3.new(h1.Normal.X, 0, h1.Normal.Z)
        if n.Magnitude < 0.5 then return nil end
        n = n.Unit
        if dir:Dot(-n) < 0.45 then return nil end                                                           -- on va vers le mur

        local W = h1.Position
        local wz = 1.7
        C.n, C.fwd, C.right, C.wz = n, -n, (-n):Cross(Vector3.yAxis), wz
        C.px = Vector3.new(W.X, 0, W.Z) + n * (wz * cs)
        C.pos, C.top = pos, nil
        C.state = "wall"
        C.t0, C.c, C.grip, C.wzNow, C.ph, C.wallW, C.tChk = now, 0, 1, wz, 0, 0, 0
        C.hy, C.hz, C.ly, C.lost, C.stuck = 1.7, 1.4, -12, 0, 0      -- reset des valeurs de la grimpe précédente (évite des membres tordus au départ)
        C.spaceWas = (UIS:GetFocusedTextBox() == nil) and UIS:IsKeyDown(Enum.KeyCode.Space)
        C.active = true
        return pos
    end

    -- =========================================================================
    -- 🛠️ FIX ESCALADE (fin de montée) : le Ground Snap lançait son rayon depuis la position du toy de tête. Juste après la traction,
    -- ce toy pouvait être poussé DANS le rebord / le mur par la collision -> le rayon partait de l'intérieur du bloc, traversait le
    -- bloc et touchait le sol tout en bas -> la formation était recollée au pied du mur (ou dans le mur) = "téléportation".
    -- 1) VERROU D'ARRIVÉE : pendant 1.5 s après la traction (et tant que tu restes à < 10 studs du point d'arrivée), le rayon part
    --    d'au moins la hauteur d'arrivée et la tête ne peut pas descendre plus bas que le rebord.
    -- 2) LIMITEUR DE CHUTE : le Ground Snap ne peut plus faire descendre la tête de plus de 150 studs/s (plus de téléportation
    --    instantanée vers le bas ; une vraie descente de marche / de pente passe sans problème).
    -- =========================================================================
    function _G._FigureLandLock(pos)
        local C = _G._FigureClimb
        local K = C and C.landKeep
        if not K or _G._ObjCtrlFlying == true or (os.clock() - K.t) > 1.5 then return pos, nil end
        local dh = Vector3.new(pos.X - K.pos.X, 0, pos.Z - K.pos.Z).Magnitude
        if dh > 10 then return pos, nil end
        return Vector3.new(pos.X, math.max(pos.Y, K.pos.Y + 1), pos.Z), K.pos.Y - 1.5 * figureScale
    end

    function _G._FigureDropLimit(y, dt)
        local S = _G._FigureGS
        if not S then S = { y = nil, t = -9 }; _G._FigureGS = S end
        local now = os.clock()
        if S.y and (now - S.t) < 0.5 then
            local maxDrop = math.max(150 * math.clamp(dt or 0.016, 0.001, 0.1), 0.5)
            if y < S.y - maxDrop then y = S.y - maxDrop end
        end
        S.y, S.t = y, now
        return y
    end

    -- =========================================================================
    -- 🛠️ FIX VOL (sous la map) : au décollage (R) puis pendant le vol, la tête ne doit jamais passer sous le sol.
    --  - 2 premières secondes de vol : plancher = sol sous la tête (rayon lancé depuis la hauteur de départ, donc il ne
    --    peut pas partir de sous la map) + 3 studs.
    --  - ensuite (toutes les 0.1 s) : si rien de solide sous la tête ET une face de dessous juste au-dessus (= on est sous
    --    la map / sous le sol), la formation est remontée au-dessus du sol, au dernier endroit sûr.
    -- Renvoie le décalage vertical (studs) à ajouter à la formation (0 = rien à faire).
    -- =========================================================================
    function _G._FigureAntiVoid(headPos, writePos, canWrite)
        local AV = _G._FigureAV
        if not AV then AV = { fly = false, t0 = -9, endT = -9, safe = nil, chk = 0, under = false }; _G._FigureAV = AV end
        local now = os.clock()
        local flying = _G._ObjCtrlFlying == true
        if flying and not AV.fly then AV.t0 = now end
        if AV.fly and not flying then AV.endT = now end
        AV.fly = flying
        local climbing = _G._FigureClimb and _G._FigureClimb.active
        if (not flying) and (now - AV.endT) > 1 and not climbing then AV.safe = headPos end   -- dernier endroit sûr (au sol)
        if not canWrite or not AV.safe then return 0 end
        if not (flying or (now - AV.endT) < 1) then return 0 end

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = _G._FigureGroundFilter()
        rp.RespectCanCollide = true
        local p = writePos
        local clear = 3 * figureScale

        if flying and (now - AV.t0) < 2 then
            local g = workspace:Raycast(Vector3.new(p.X, AV.safe.Y + 3, p.Z), Vector3.new(0, -600, 0), rp)
            if g and p.Y < g.Position.Y + clear then return g.Position.Y + clear - p.Y end
            return 0
        end

        if now >= AV.chk then
            AV.chk = now + 0.1
            AV.under = false
            local dn = workspace:Raycast(p, Vector3.new(0, -300, 0), rp)
            if not dn then
                local up = workspace:Raycast(p, Vector3.new(0, 60, 0), rp)
                if up and up.Normal.Y < -0.5 then AV.under = true end
            end
        end
        if AV.under then
            AV.under = false
            local g = workspace:Raycast(Vector3.new(p.X, AV.safe.Y + 5, p.Z), Vector3.new(0, -600, 0), rp)
            local newY = g and (g.Position.Y + clear) or AV.safe.Y
            if newY > p.Y then return newY - p.Y end
        end
        return 0
    end

    -- 🛠️ FIX : le "Flight Mode : Face Camera" de l'Animated Figure ne changeait que la POSE du corps, pas le déplacement.
    -- Le Contrôle Objet gardait son "Mode Vol" = Normal (horizontal + Espace/Maj). Cette fonction permet au vol de suivre
    -- la caméra complète (Z en regardant le ciel = monter) quand l'Animated Figure est actif en Face Camera.
    function _G._FigureFaceCamFly()
        return (animatedFigureActive and figureFlightMode == "Face Camera") and true or false
    end

    -- 🛬 ATTERRISSAGE AUTOMATIQUE : en vol (R), quand tu descends (Maj, ou W en regardant vers le bas) à moins de X studs du sol,
    -- la formation se rapproche du sol en douceur puis le Ground Snap reprend. Monter (Espace, ou W en regardant le ciel) annule tout.
    -- Renvoie la hauteur Y à donner à la tête, ou nil (= on ne touche à rien).
    function _G._FigureLandY(pos, dt)
        if not _G._FigureAutoLand or _G._ObjCtrlFlying ~= true then _G._FigureLandActive = false return nil end
        local UIS = game:GetService("UserInputService")
        local typing = UIS:GetFocusedTextBox() ~= nil
        local cam = workspace.CurrentCamera
        local lookY = cam and cam.CFrame.LookVector.Y or 0
        local wHeld = (not typing) and (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up))
        local up = (not typing) and (UIS:IsKeyDown(Enum.KeyCode.Space) or (wHeld and lookY > 0.15))
        local down = (not typing) and (UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift) or (wHeld and lookY < -0.15))
        if up then _G._FigureLandActive = false return nil end
        if not (down or _G._FigureLandActive) then return nil end

        local list = { Player.Character, workspace:FindFirstChild(Player.Name .. "SpawnedInToys") }
        for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
            if plr ~= Player and plr.Character then list[#list + 1] = plr.Character end
        end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = list
        local hit = workspace:Raycast(pos, Vector3.new(0, -1000, 0), rp)
        if not hit then _G._FigureLandActive = false return nil end

        local fh = 0
        if figureFormation == "Bonhomme V2" or figureFormation == "Bonhomme Classic" or figureFormation == "Stick Man" then
            fh = 18 * figureScale
        elseif figureFormation == "Géant" then
            fh = 25 * figureScale
        elseif figureFormation == "Robot" then
            fh = 16 * figureScale
        elseif figureFormation == "T-Pose" or figureFormation == "Croix" then
            fh = 15 * figureScale
        elseif figureFormation == "Oiseau Réaliste" then
            fh = 7 * figureScale
        elseif figureFormation == "Araignée" or figureFormation == "Araignée à 8 pattes" or figureFormation == "Araignée Flippante" then
            fh = 8 * figureScale
        elseif figureFormation == "Chien" then
            fh = 13 * figureScale
        end
        local floorY = hit.Position.Y + figureGroundOffset + fh + figureHeadHeight
        local above = pos.Y - floorY
        if above > (_G._FigureAutoLandDist or 12) then _G._FigureLandActive = false return nil end   -- encore trop haut : descente libre
        if above <= 0.3 then return floorY end                                                        -- au sol : le Ground Snap reprend
        _G._FigureLandActive = true
        return pos.Y + (floorY - pos.Y) * (1 - math.exp(-5 * math.min(dt or 0.016, 0.1)))             -- approche douce
    end

    -- 🛬 REDRESSEMENT À L'APPROCHE DU SOL (vol Superman) : quand tu descends (Maj, ou W en regardant vers le bas) près du sol,
    -- le corps passe progressivement de la pose couchée à la pose debout. _G._FigureLandKs : 0 = couché, 1 = debout (lissé).
    -- Appelée une fois par frame. Monter (Espace, ou W en regardant le ciel) annule : le corps se recouche.
    function _G._FigureFlareStep(pos, dt)
        local tgt = 0
        if _G._FigureFlare ~= false and _G._ObjCtrlFlying == true and _G._FigureIsSuperman() then
            local UIS = game:GetService("UserInputService")
            local typing = UIS:GetFocusedTextBox() ~= nil
            local cam = workspace.CurrentCamera
            local lookY = cam and cam.CFrame.LookVector.Y or 0
            local wHeld = (not typing) and (UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up))
            local up = (not typing) and (UIS:IsKeyDown(Enum.KeyCode.Space) or (wHeld and lookY > 0.15))
            local down = (not typing) and (UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift) or (wHeld and lookY < -0.15))
            if up then
                _G._FigureFlareActive = false
            elseif down or _G._FigureFlareActive then
                local list = { Player.Character, workspace:FindFirstChild(Player.Name .. "SpawnedInToys") }
                for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                    if plr ~= Player and plr.Character then list[#list + 1] = plr.Character end
                end
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = list
                local hit = workspace:Raycast(pos, Vector3.new(0, -1000, 0), rp)
                if hit then
                    local floorY = hit.Position.Y + figureGroundOffset + 18 * figureScale + figureHeadHeight
                    local above = pos.Y - floorY
                    local dist = math.max(_G._FigureFlareDist or 14, 1)
                    if above <= dist then
                        _G._FigureFlareActive = true
                        local x = math.clamp(1 - above / dist, 0, 1)
                        tgt = x * x * (3 - 2 * x)
                    else
                        _G._FigureFlareActive = false
                    end
                else
                    _G._FigureFlareActive = false
                end
            end
        else
            _G._FigureFlareActive = false
        end
        -- 🧍 LÉVITATION EN VOL : à l'arrêt (aucune touche de déplacement) le corps se met DROIT et flotte (bras / jambes qui dérivent) ;
        -- W / A / D -> il se recouche (Superman) ; S (reculer) -> transition rapide vers la pose droite penchée en arrière, et DÈS que tu
        -- lâches S il commence à se redresser (_G._FigureBackK retombe tout de suite). Espace / Maj = montée / descente en restant droit.
        -- _G._FigureLevK = part de la pose droite qui est de la lévitation (le reste = redressement d'atterrissage, pieds posés).
        local levT, backT = 0, 0
        local landT = tgt
        if _G._FigureLevitate ~= false and _G._ObjCtrlFlying == true and _G._FigureIsSuperman() then
            local UIS2 = game:GetService("UserInputService")
            local typing2 = UIS2:GetFocusedTextBox() ~= nil
            local function kd(a, b) return (not typing2) and (UIS2:IsKeyDown(a) or UIS2:IsKeyDown(b)) end
            local fwdK = kd(Enum.KeyCode.W, Enum.KeyCode.Up) or kd(Enum.KeyCode.A, Enum.KeyCode.Left) or kd(Enum.KeyCode.D, Enum.KeyCode.Right)
            local backK = kd(Enum.KeyCode.S, Enum.KeyCode.Down)
            if backK then levT, backT = 1, 1
            elseif not fwdK then levT = 1 end
        end
        tgt = math.max(tgt, levT)
        local d2 = math.min(dt or 0.016, 0.1)
        local lev = _G._FigureLevK or 0
        local levTgt = (levT > 0 and landT < 0.5) and 1 or 0
        _G._FigureLevK = lev + (levTgt - lev) * (1 - math.exp(-6 * d2))
        local bk = _G._FigureBackK or 0
        _G._FigureBackK = bk + (backT - bk) * (1 - math.exp(-((backT > bk) and 9 or 8) * d2))   -- monte vite avec S, retombe aussitôt qu'on lâche
        local ks = _G._FigureLandKs or 0
        if tgt == 0 and _G._ObjCtrlFlying ~= true then
            ks = 0   -- plus en vol : on repart propre pour le prochain vol
            _G._FigureLevK, _G._FigureBackK = 0, 0
        else
            local rate = 7
            if tgt > ks then rate = (backT > 0) and 10 or 5 end   -- S : transition rapide · à l'arrêt : redressement doux
            ks = ks + (tgt - ks) * (1 - math.exp(-rate * d2))
        end
        if ks < 0.002 then ks = 0 end
        _G._FigureLandKs = ks
    end

    -- Renvoie la hauteur Y (absolue) à donner à la tête, ou nil s'il n'y a pas de sol sous la formation.
    -- Règle d'or : la formation n'est JAMAIS téléportée au sol. Elle ne descend que par la gravité, et ne monte que
    -- par un saut, un relief (marches) ou une montée rapide mais progressive.
    -- L'état du saut est publié dans _G._FigureFJ (air, vy, vy0, airT, landT, landV, jumped) : l'animation "Saut" le lit.
    function _G._FigureFreeJumpStep(pos, dt)
        local UIS = game:GetService("UserInputService")
        local fj = _G._FigureFJ
        if not fj or fj.runId ~= _G.HelperOtherRunId then
            fj = { y = nil, vy = 0, air = false, req = false, t = 0, runId = _G.HelperOtherRunId,
                   jumped = false, vy0 = 0, airT = 0, landT = 99, landV = 0, noHitT = 0, bufT = nil, filter = nil, filterT = 0 }
            _G._FigureFJ = fj
            _TrackConn(UIS.JumpRequest:Connect(function() fj.req = true end))   -- clavier / manette / mobile
        end

        -- Si la méthode n'a pas tourné depuis un moment (toggle coupé, autre méthode...), on repart propre.
        -- (1.5 s au lieu de 0.25 s : un lag ou une frame sautée ne remet plus la formation au sol en plein saut)
        local now = tick()
        if now - fj.t > 1.5 then _G._FigureFreeJumpReset() end
        fj.t = now
        fj.landT = (fj.landT or 99) + dt

        -- 🦸 VOL : la touche de vol du Contrôle Objet (R) est active -> on ne force plus le sol, le toy de tête garde son altitude.
        -- L'état du saut suit l'altitude : quand le vol s'arrête, la formation tombe naturellement (jamais de TP au sol).
        if _G._ObjCtrlFlying then
            fj.y, fj.vy, fj.air, fj.jumped, fj.airT = pos.Y, 0, true, false, 0
            fj.req, fj.bufT, fj.flying = false, nil, true
            return pos.Y
        end
        fj.flying = false

        -- Hauteur du bonhomme (identique à l'ancienne méthode)
        local fh = 0
        if figureFormation == "Bonhomme V2" or figureFormation == "Bonhomme Classic" or figureFormation == "Stick Man" then
            fh = 18 * figureScale
        elseif figureFormation == "Géant" then
            fh = 25 * figureScale
        elseif figureFormation == "Robot" then
            fh = 16 * figureScale
        elseif figureFormation == "T-Pose" or figureFormation == "Croix" then
            fh = 15 * figureScale
        elseif figureFormation == "Oiseau Réaliste" then
            fh = 7 * figureScale
        elseif figureFormation == "Araignée" or figureFormation == "Araignée à 8 pattes" or figureFormation == "Araignée Flippante" then
            fh = 8 * figureScale
        elseif figureFormation == "Chien" then
            fh = 13 * figureScale
        end

        -- Raycast vers le bas depuis la tête. On ignore ton perso, les toys, ET les autres joueurs / leurs toys
        -- (sinon un joueur ou un toy qui passe sous la formation la "téléporte" dessus). Les parts sans collision sont ignorées.
        if not fj.filter or now - fj.filterT > 1 then
            fj.filterT = now
            local list = {}
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr.Character then list[#list + 1] = plr.Character end
            end
            for _, c in ipairs(workspace:GetChildren()) do
                if string.sub(c.Name, -13) == "SpawnedInToys" then list[#list + 1] = c end
            end
            fj.filter = list
        end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = fj.filter
        rp.RespectCanCollide = true
        local origin = Vector3.new(pos.X, (fj.y or pos.Y) + 2, pos.Z)
        local hit = workspace:Raycast(origin, Vector3.new(0, -1000, 0), rp)
        if not hit then
            rp.RespectCanCollide = false     -- rien de solide : on retente en comptant aussi les parts sans collision
            hit = workspace:Raycast(origin, Vector3.new(0, -1000, 0), rp)
        end

        local floorY
        if hit then
            fj.noHitT = 0
            floorY = hit.Position.Y + figureGroundOffset + fh + figureHeadHeight
        else
            -- Pas de sol (vide, bord de map...) : si on est en l'air on CONTINUE de tomber au lieu de se téléporter
            fj.noHitT = (fj.noHitT or 0) + dt
            if fj.y == nil or fj.noHitT > 2.5 or fj.y < workspace.FallenPartsDestroyHeight + 30 then
                fj.y, fj.vy, fj.air = nil, 0, false
                return nil
            end
            if not fj.air then fj.air, fj.vy, fj.airT, fj.jumped = true, 0, 0, false end
            floorY = -1e9
        end

        if fj.y == nil then
            -- Départ : si le toy de tête est déjà nettement au-dessus du sol, on tombe naturellement depuis là
            if pos.Y > floorY + 1.5 and pos.Y < floorY + 150 then
                fj.y, fj.vy, fj.air, fj.jumped, fj.airT = pos.Y, 0, true, false, 0
            else
                fj.y, fj.vy, fj.air = floorY, 0, false
            end
        end

        local g = workspace.Gravity * math.clamp((_G._FigureFreeJumpG or 65) / 100, 0.2, 1.5)
        local step = math.min(dt, 0.05)

        -- Montée progressive : petite marche = instantané, grosse marche = rapide mais jamais un TP
        local function riseTo(y, fl)
            local d = fl - y
            if d <= 3 then return fl end
            return y + math.min(d, 140 * step)
        end
        local function land(v)
            fj.y, fj.vy, fj.air = floorY, 0, false
            fj.landT, fj.landV = 0, v
        end

        -- Demande de saut : Espace maintenu = rebondit dès qu'on touche le sol, comme un saut Roblox normal.
        -- + tampon (appui un poil trop tôt = le saut part à l'atterrissage) + "coyote" (0.12 s après avoir quitté un bord)
        local wantJump = fj.req
        fj.req = false
        if not wantJump and not UIS:GetFocusedTextBox() and UIS:IsKeyDown(Enum.KeyCode.Space) then
            wantJump = true
        end
        if wantJump and fj.air and (fj.jumped or fj.airT >= 0.12) then
            fj.bufT = now + 0.12
            wantJump = false
        end
        if not wantJump and fj.bufT then
            if now > fj.bufT then
                fj.bufT = nil
            elseif not fj.air then
                wantJump, fj.bufT = true, nil
            end
        end
        if wantJump then
            fj.vy0 = math.sqrt(2 * g * math.max(_G._FigureFreeJumpH or 8, 0.5))
            fj.vy, fj.air, fj.jumped, fj.airT = fj.vy0, true, true, 0
        end

        if fj.air then
            fj.airT = fj.airT + step
            fj.vy = fj.vy - g * step
            local ny = fj.y + fj.vy * step
            if fj.vy <= 0 and ny <= floorY then
                land(-fj.vy)                                   -- atterrissage
            elseif ny < floorY then
                -- le sol monte plus vite que nous (marche haute, bord de plateforme) : montée progressive, pas de TP
                fj.y = riseTo(ny, floorY)
                if fj.y >= floorY then land(math.max(0, -fj.vy)) end
            else
                fj.y = ny
            end
        else
            local d = fj.y - floorY
            if d < 0 then
                fj.y = riseTo(fj.y, floorY)                    -- relief qui monte
            elseif d <= 2.5 then
                fj.y = floorY                                  -- petites descentes : on suit le sol
            else
                fj.air, fj.vy, fj.airT, fj.jumped = true, 0, 0, false   -- grosse descente : on tombe naturellement
            end
        end
        return fj.y
    end

    ExtraFun:CreateToggle({
        Name = "🛬 Atterrissage automatique (vol : le Ground Snap reprend en douceur près du sol)",
        Flag = "FigureAutoLand",
        Default = true,
        Callback = function(v)
            _G._FigureAutoLand = v
            if not v then _G._FigureLandActive = false end
        end
