                                                        local lookVector = direction.Unit
                                                        local upVector = Vector3.new(0, 1, 0)
                                                        local rightVector = lookVector:Cross(upVector).Unit
                                                        local realUpVector = rightVector:Cross(lookVector).Unit
                                                        
                                                        -- Construit le CFrame manuellement
                                                        targetCF = CFrame.fromMatrix(targetPos, rightVector, realUpVector, -lookVector)
                                                    else
                                                        -- Direction nulle, utilise l'orientation du joueur
                                                        local _, rootY, _ = root.CFrame:ToEulerAnglesXYZ()
                                                        targetCF = CFrame.new(targetPos) * CFrame.Angles(0, rootY, 0)
                                                    end
                                                else
                                                    -- Pas de position suivante, regarde dans la direction du joueur
                                                    local _, rootY, _ = root.CFrame:ToEulerAnglesXYZ()
                                                    targetCF = CFrame.new(targetPos) * CFrame.Angles(0, rootY, 0)
                                                end
                                            else
                                                -- Début, regarde vers le joueur (méthode simple)
                                                local direction = (centerPos - targetPos)
                                                if direction.Magnitude > 0.1 then
                                                    local lookVector = direction.Unit
                                                    local upVector = Vector3.new(0, 1, 0)
                                                    local rightVector = lookVector:Cross(upVector).Unit
                                                    local realUpVector = rightVector:Cross(lookVector).Unit
                                                    targetCF = CFrame.fromMatrix(targetPos, rightVector, realUpVector, -lookVector)
                                                else
                                                    targetCF = CFrame.new(targetPos)
                                                end
                                            end
                                        else
                                            targetCF = CFrame.new(targetPos)
                                        end
                                    elseif tornadoSyncPlayerRotation then
                                        -- Mode SYNC PLAYER ROTATION : toys ont exactement la même rotation que le joueur
                                        local char = Player.Character
                                        local root = char and char:FindFirstChild("HumanoidRootPart")
                                        if root then
