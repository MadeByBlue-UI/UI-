        -- Fonction locale pour ajouter des particules fluides (copie de AddFluidParticles)
        function AddTPFluidParticles(parentFrame, particleCount)
            local particleContainer = Instance.new("Frame")
            particleContainer.Size = UDim2.fromScale(1, 1)
            particleContainer.BackgroundTransparency = 1
            particleContainer.ClipsDescendants = true
            particleContainer.ZIndex = parentFrame.ZIndex
            particleContainer.Parent = parentFrame
            
            local particles = {}
            
            for i = 1, particleCount or 8 do
                local size = math.random(2, 4)
                local particle = Instance.new("Frame")
                particle.Size = UDim2.fromOffset(size, size)
                particle.Position = UDim2.fromScale(math.random(0, 100) / 100, math.random(0, 100) / 100)
                particle.AnchorPoint = Vector2.new(0.5, 0.5)
                particle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                particle.BackgroundTransparency = math.random(80, 94) / 100
                particle.BorderSizePixel = 0
                particle.ZIndex = parentFrame.ZIndex + 1
                particle.Parent = particleContainer
                
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = particle
                
                table.insert(particles, {
                    frame = particle,
                    velocity = Vector2.new(math.random(-15, 15) / 100, math.random(-15, 15) / 100)
                })
            end
            
            task.spawn(function()
                while particleContainer.Parent do
                    local mousePos = _UIS:GetMouseLocation()
                    local framePos = parentFrame.AbsolutePosition
                    local frameSize = parentFrame.AbsoluteSize
                    
                    local relMouseX = (mousePos.X - framePos.X) / frameSize.X
                    local relMouseY = (mousePos.Y - framePos.Y) / frameSize.Y
                    
                    for _, pData in ipairs(particles) do
                        if pData.frame and pData.frame.Parent then
                            local currentPos = pData.frame.Position
                            local currentX = currentPos.X.Scale
                            local currentY = currentPos.Y.Scale
                            
                            local dx = currentX - relMouseX
                            local dy = currentY - relMouseY
                            local distance = math.sqrt(dx * dx + dy * dy)
                            
                            local repulsionRadius = 0.15
                            if distance < repulsionRadius and distance > 0 then
                                local repulsionForce = (repulsionRadius - distance) / repulsionRadius * 0.02
                                pData.velocity = pData.velocity + Vector2.new(dx / distance * repulsionForce, dy / distance * repulsionForce)
                            end
                            
                            local newX = currentX + pData.velocity.X * 0.016
                            local newY = currentY + pData.velocity.Y * 0.016
                            
                            if newX <= 0 or newX >= 1 then
                                pData.velocity = Vector2.new(-pData.velocity.X, pData.velocity.Y)
                                newX = math.clamp(newX, 0, 1)
                            end
                            if newY <= 0 or newY >= 1 then
                                pData.velocity = Vector2.new(pData.velocity.X, -pData.velocity.Y)
                                newY = math.clamp(newY, 0, 1)
                            end
                            
                            pData.velocity = pData.velocity * 0.99
                            pData.frame.Position = UDim2.fromScale(newX, newY)
                        end
                    end
                    
                    task.wait(0.016)
                end
            end)
