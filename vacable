        -- =====================================================================================================================
        -- 📡 PRISE FIABLE (ownership vérifiée côté serveur + distance max + TOUS les membres même en ragdoll)
        --   · Avant : la formation écrivait la position du joueur en local sans savoir si le serveur lui avait donné l'ownership.
        --     Trop loin -> la demande était refusée, le joueur « tenu » chez toi continuait sa vie côté serveur.
        --   · Maintenant : le serveur met un « PartOwner » = ton pseudo sur la part dont tu as l'ownership. La prise ne démarre que
        --     si ce PartOwner est là ET si le joueur est à FG.maxDist studs max (25 par défaut). Tant que ce n'est pas confirmé, on ne
        --     déplace PAS le joueur (on redemande vite) ; si l'ownership est perdue > 1.2 s -> relâché proprement.
        --   · En ragdoll, les membres sont des assemblages SÉPARÉS du HumanoidRootPart (chacun a son propre owner) : on demande
        --     l'ownership de chaque membre, et on recolle ceux qui partent trop loin du corps (FG.limbPinDist).
        --   (tout est dans la table FG : aucune nouvelle variable locale au niveau du script)
        -- =====================================================================================================================
        FG.maxDist     = FG.maxDist or 25          -- distance max (studs) entre moi et le joueur pour le prendre
        if FG.strict == nil then FG.strict = true end      -- exiger la confirmation PartOwner du serveur
        if FG.limbsOn == nil then FG.limbsOn = true end    -- prendre aussi tous les membres
        if FG.limbPinDist == nil then FG.limbPinDist = 0 end   -- 0 = membres TOUJOURS collés au corps tant que la prise dure ; sinon recollés au-delà de X studs
        FG.limbBurst   = FG.limbBurst or 8         -- nb max de membres demandés par « tick » d'ownership (tous d'un coup)
        FG.r6rel = {                               -- position par défaut des membres R6 par rapport au HumanoidRootPart
            ["Head"] = CFrame.new(0, 1.5, 0), ["Torso"] = CFrame.new(0, 0, 0),
            ["Left Arm"] = CFrame.new(-1.5, 0, 0), ["Right Arm"] = CFrame.new(1.5, 0, 0),
            ["Left Leg"] = CFrame.new(-0.5, -2, 0), ["Right Leg"] = CFrame.new(0.5, -2, 0),
        }

        function FG.ownedBy(part)                  -- cette part porte-t-elle PartOwner = moi ?
            local po = part and part:FindFirstChild("PartOwner")
            return po ~= nil and po.Value == LP.Name
        end

        function FG.myRoot()
            local c = LP.Character
            return c and c:FindFirstChild("HumanoidRootPart")
        end

        -- le CORPS du joueur (assemblage du HumanoidRootPart) est-il à moi côté serveur ?
        function FG.rootOwned(char, root)
            if not (char and root and root.Parent) then return false end
            if FG.ownedBy(root) then return true end
            local asm = root.AssemblyRootPart
            for _, p in ipairs(char:GetChildren()) do
                if p:IsA("BasePart") and p.AssemblyRootPart == asm and FG.ownedBy(p) then return true end
            end
            return false
        end

        -- liste (en cache 1 s) des parts du perso autres que le HumanoidRootPart
        function FG.limbList(C)
            local now = os.clock()
            if C.limbs and now - (C.limbsT or 0) < 1 then return C.limbs end
            local l, ch = {}, C.root and C.root.Parent
            if ch then
                for _, p in ipairs(ch:GetChildren()) do
                    if p:IsA("BasePart") and p ~= C.root then l[#l + 1] = p end
                end
            end
            C.limbs, C.limbsT = l, now
            return l
        end

        -- demande l'ownership des membres qui ne sont pas à moi (round-robin, FG.limbBurst par appel)
        function FG.limbRequest(C, sno, bodyOwned)
            if not (FG.limbsOn and sno and C.root and C.root.Parent) then return end
            local asm = C.root.AssemblyRootPart
            local list = FG.limbList(C)
            local n = #list
            if n == 0 then return end
            local sent = 0
            C.limbMissing = false
            local i = C.limbI or 0
            for _ = 1, n do
                i = i % n + 1
                local p = list[i]
                if p and p.Parent then
                    local covered = (bodyOwned and p.AssemblyRootPart == asm) or FG.ownedBy(p)
                    if not covered then
                        pcall(function() sno:FireServer(p, p.CFrame) end)
                        sent = sent + 1
                        if sent >= (FG.limbBurst or 3) then break end
                    end
                end
            end
            C.limbI = i
            C.limbMissing = sent > 0
        end

        -- recolle les membres (à moi, mais dans un assemblage séparé = ragdoll) qui sont partis trop loin du corps
        function FG.limbPin(C)
            if not (FG.limbsOn and C.limbs and C.root and C.root.Parent) then return end
            local root = C.root
            local asm = root.AssemblyRootPart
            local lim = FG.limbPinDist or 5
            C.rel = C.rel or {}
            for _, p in ipairs(C.limbs) do
                if p.Parent and p.AssemblyRootPart ~= asm and FG.ownedBy(p) then
                    local d = (p.Position - root.Position).Magnitude
                    if lim <= 0.05 then
                        -- 📌 TOUJOURS COLLÉ : pose relative mémorisée à la 1re vue (si le membre est près du corps, sinon pose R6 par défaut),
                        -- puis le membre est replacé à CHAQUE frame tant que la formation tient le joueur
                        if not C.rel[p] then
                            C.rel[p] = (d <= 6) and root.CFrame:ToObjectSpace(p.CFrame) or FG.r6rel[p.Name] or CFrame.new()
                        end
                        p.CFrame = root.CFrame * C.rel[p]
                        p.AssemblyLinearVelocity  = Vector3.zero
                        p.AssemblyAngularVelocity = Vector3.zero
                    elseif d <= lim * 0.9 then
                        C.rel[p] = root.CFrame:ToObjectSpace(p.CFrame)      -- dernière « bonne » pose du membre
                    elseif d > lim then
                        local rel = C.rel[p] or FG.r6rel[p.Name] or CFrame.new()
                        p.CFrame = root.CFrame * rel
                        p.AssemblyLinearVelocity  = Vector3.zero
                        p.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
        end

        -- 🦴🤲 BRAS RALLONGÉ : un bras qui tient un joueur utilise FG.armToys toys (3 à 6) au lieu de 3 -> plus de gros trous dans le bras.
        -- Les toys EXTRAS viennent du stockage (toys 17+ du Stick Man, normalement posés devant les pieds) : bras gauche = 17-19, bras droit = 20-22.
        -- Les 3 toys de base gardent leur rôle (le dernier = la main) ; les extras comblent les vides entre l'épaule et la main.
        -- Sans assez de toys en stockage (< 17), le bras reste à 3 toys comme avant.
        -- Renvoie (position du toy sur le bras 1..N, N) ou nil si ce toy ne fait pas partie de ce bras.
        FG.armToys = FG.armToys or 6
        function FG.armMap(i, side, nTot, toysOpt)
            local first = (side < 0) and 5 or 8
            local ex0   = (side < 0) and 16 or 19
            local want  = math.max(0, math.min(3, (toysOpt or FG.armToys or 6) - 3))
            local E = 0
            for k = 1, want do
                if ex0 + k <= nTot then E = k else break end
            end
            local N = 3 + E
            if i >= first and i <= first + 2 then
                return math.floor((i - first + 1) * N / 3 + 0.5), N
            end
            if E > 0 and i > ex0 and i <= ex0 + E then
                local used = {}
                for k = 1, 3 do used[math.floor(k * N / 3 + 0.5)] = true end
                local c, j = 0, i - ex0
                for pos = 1, N do
                    if not used[pos] then
                        c = c + 1
                        if c == j then return pos, N end
                    end
                end
            end
            return nil
        end

        -- 🧲🧲 état du mode « 2 joueurs à la fois » et de l'extension du bras avant la prise
        FG.captured2 = nil
        if FG.dual == nil then FG.dual = true end                 -- activé par défaut
        if FG.reachOn == nil then FG.reachOn = true end           -- le bras s'étend vers le joueur avant de le ramener
        FG.reachDur = FG.reachDur or 0.25                          -- durée de l'extension (s)
        FG.handHold = {}                                           -- [index de main] = { p = point de prise, t = date }

        -- relâche un seul joueur (l'autre reste tenu)
function FG.releaseOne(C, msg)
if C and C.bury and FG.buryEnd then FG.buryEnd(C, false) end
if msg then notify("Grab Figure", msg, 2) end
            if FG.captured == C then FG.captured = nil elseif FG.captured2 == C then FG.captured2 = nil end
        end

        -- phase d'attrapage d'un joueur : 1 = le bras s'étend vers lui (il ne bouge pas), 2 = il glisse jusqu'à la main, 3 = tenu
        function FG.capPhase(C)
            local t  = os.clock() - C.since
            local rd = FG.reachOn and (FG.reachDur or 0.25) or 0
            if t < rd then return 1, t / rd end
            local pd = FG.pullDur or 0
            if pd > 0 and t < rd + pd then return 2, (t - rd) / pd end
            return 3, 1
        end

        -- ✨ HALO DE PRISE : un contour qui apparaît en fondu autour du joueur tenu par la formation, pulse doucement,
        -- puis s'efface en douceur au lâcher / lancer (visible seulement chez toi)
        local TweenSvc = game:GetService("TweenService")
        local function fadeOutHalo(h)
            if not h then return end
            local ok = pcall(function()
                local tw = TweenSvc:Create(h, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { FillTransparency = 1, OutlineTransparency = 1 })
                tw.Completed:Connect(function() pcall(function() h:Destroy() end) end)
                tw:Play()
            end)
            if not ok then pcall(function() h:Destroy() end) end
        end
        local function styleUpdate()
            -- 🧲🧲 un halo par joueur tenu (slot 1 = FG.captured, slot 2 = FG.captured2)
            for slot = 1, 2 do
                local key = (slot == 1) and "halo" or "halo2"
                local C  = FG.ownOn and ((slot == 1) and FG.captured or FG.captured2)
                local ch = C and FG.styleOn and C.plr and C.plr.Character
                local h  = FG[key]
                if h and not (ch and h.Parent and h.Adornee == ch) then
                    FG[key] = nil
                    fadeOutHalo(h)
                    h = nil
                end
                if ch then
                    if not h then
                        h = Instance.new("Highlight")
                        h.Name = "FigGrabHalo"
                        h.FillColor = Color3.fromRGB(150, 110, 255)
                        h.OutlineColor = Color3.fromRGB(235, 225, 255)
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        h.FillTransparency, h.OutlineTransparency = 1, 1
                        h.Adornee = ch
                        h.Parent = ch
                        FG[key] = h
                    end
                    local now = os.clock()
                    local k = math.clamp((now - C.since) / 0.3, 0, 1)
                    k = 1 - (1 - k) ^ 3                                   -- apparition en fondu (ease out)
                    local pulse = 0.5 + 0.5 * math.sin(now * 4)
                    h.FillColor = (C.own == false) and Color3.fromRGB(255, 170, 60) or Color3.fromRGB(150, 110, 255)   -- 🟠 ownership pas confirmée · 🟣 tenu
                    h.FillTransparency    = 1 - 0.28 * k * (0.8 + 0.2 * pulse)
                    h.OutlineTransparency = 1 - 0.90 * k * (0.75 + 0.25 * pulse)
                end
            end
        end

        -- 💥 RAGDOLL PAR PALLET : spawn une pallet ~1 s (hors formation), elle tape le joueur pour le mettre en ragdoll, puis elle est détruite
        FG.ragPower = FG.ragPower or 500
        FG.autoRag  = FG.autoRag or false
        local ragBusy = false
        local function ragdollPallet(tChar)
            if ragBusy then return end
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local mt      = REP:FindFirstChild("MenuToys")
            local rSpawn  = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
            local rDestroy = mt and mt:FindFirstChild("DestroyToy")
            local ge      = REP:FindFirstChild("GrabEvents")
            local sno     = ge and ge:FindFirstChild("SetNetworkOwner")
            local inv     = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
            if not (tRoot and myRoot and rSpawn and rDestroy and sno and inv) then
                notify("Ragdoll Pallet", "Impossible (cible, toys ou remotes introuvables)", 2)
                return
            end
            ragBusy = true
            task.spawn(function()
                -- instantané des pallets déjà présentes : la nouvelle sera exclue de la formation dès son apparition
                local snap = {}
                for _, m in ipairs(inv:GetChildren()) do snap[m] = true end
                _G._FigRagSnap, _G._FigRagBusy = snap, true
                _G._FigureExclude = _G._FigureExclude or setmetatable({}, { __mode = "k" })

                local can = LP:FindFirstChild("CanSpawnToy")
                if can and not can.Value then
                    local t0 = os.clock()
                    repeat task.wait(0.1) until can.Value or (os.clock() - t0) > 2
                end

                task.spawn(function()
                    pcall(function() rSpawn:InvokeServer("PalletLightBrown", myRoot.CFrame * CFrame.new(0, 5, 0), Vector3.zero) end)
                end)

                local pallet
                local t0 = os.clock()
                repeat
                    task.wait(0.05)
                    for _, m in ipairs(inv:GetChildren()) do
                        if m.Name == "PalletLightBrown" and not snap[m] then pallet = m; break end
                    end
                until pallet or (os.clock() - t0) > 3

                if not pallet then
                    _G._FigRagBusy = false
                    ragBusy = false
                    notify("Ragdoll Pallet", "La pallet n'a pas spawn", 2)
                    return
                end
                _G._FigureExclude[pallet] = true
                _G._FigRagBusy = false

                local pp = pallet:FindFirstChild("SoundPart") or pallet:FindFirstChildWhichIsA("BasePart")
                if pp then
                    -- 🕊️ pas de collision pendant la prise d'ownership : la pallet ne te pousse / ne gêne plus ta formation
                    for _, p in ipairs(pallet:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                    -- prend l'ownership de la pallet
                    local to = os.clock() + 1.5
                    repeat
                        pcall(function() sno:FireServer(pp, pp.CFrame) end)
                        task.wait(0.05)
                    until (pp:FindFirstChild("PartOwner") and pp.PartOwner.Value == LP.Name) or os.clock() > to

                    for _, p in ipairs(pallet:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = true; p.Massless = false end
                    end

                    -- 🔨 MÉTHODE "PALLET KICK" (celle du bloc Target, qui marche) : la pallet est envoyée de TRÈS haut au-dessus du joueur par segments
                    -- (vitesse énorme pendant la descente), puis frappe avec la force réglée ; ~1,2 s de marteau, puis elle est détruite.
                    local segN, seg, down = 8, 0, true
                    local tStart, lastOwn = os.clock(), os.clock()
                    while os.clock() - tStart < (FG.ragDur or 1.2) do
                        local r = tChar and tChar:FindFirstChild("HumanoidRootPart")
                        if not (r and pp.Parent) then break end
                        if os.clock() - lastOwn > 1 then
                            lastOwn = os.clock()
                            pcall(function() sno:FireServer(pp, pp.CFrame) end)
                        end
                        local startPos = r.Position + Vector3.new(0, 50000, 0)
                        local endPos   = r.Position + Vector3.new(0, 1.5, 0)
                        pcall(function()
                            if down then
                                seg = seg + 1
                                pp.CFrame = CFrame.new(startPos:Lerp(endPos, seg / segN))
                                pp.AssemblyLinearVelocity  = Vector3.new(0, -50000, 0)
                                pp.AssemblyAngularVelocity = Vector3.zero
                                if seg >= segN then
                                    pp.AssemblyLinearVelocity = Vector3.new(0, -(FG.ragPower or 500), 0)
                                    down = false
                                end
                            else
                                pp.CFrame = CFrame.new(startPos)
                                pp.AssemblyLinearVelocity = Vector3.zero
                                seg, down = 0, true
                            end
                        end)
                        task.wait()
                    end
                end

                pcall(function() rDestroy:FireServer(pallet) end)
                _G._FigureExclude[pallet] = nil
                ragBusy = false
            end)
        end
        FG.ragdollPallet = ragdollPallet

        -- =====================================================================================================================
        -- 🪵 PALLET(S) EN MAIN : la pallet spawn direct (comme les DiceSmall : décalage depuis le PCLD, capture instantanée),
        -- puis se cale au-dessus de ta main pendant que le bras fait un arc par en dessous (voir la boucle de formation).
        --   · 🎲 AVANT la pallet, un DiceSmall spawn et se RAJOUTE au bras (4e segment) : le bras est plus long / étiré, la main est plus
        --     loin du corps et la grande pallet ne colle plus à ta tête. La pallet se pose sur ce DiceSmall.
        --   · 🪵🪵 « Une pallet dans chaque main » : 2e pallet + 2e DiceSmall sur l'autre bras (même système, écartés l'un de l'autre).
        --   · 🧊 La pallet est stabilisée : plus de « respiration », filtre anti-vibration sur sa position et son orientation
        --     (elle ne bouge que si la main bouge vraiment).
        -- Tout passe par la table FG (FG.pal = main choisie, FG.pal2 = l'autre main).
        -- =====================================================================================================================
        FG.pal  = FG.pal  or {}
        FG.pal2 = FG.pal2 or {}
        FG.palT1, FG.palT2 = false, false
        if FG.palDice == nil then FG.palDice = true end    -- 🎲 DiceSmall au bout du bras
        FG.palArmToys = FG.palArmToys or 6                 -- 🦴 toys par bras qui porte la pallet (3 à 6) : découpent le bras long en segments courts
        FG.palStretch = FG.palStretch or 1.0               -- 🎲 segments ajoutés au bras (1 = un DiceSmall de plus)
        FG.palSpread  = FG.palSpread  or 2.5               -- 🪵🪵 écartement latéral des 2 bras quand les 2 mains tiennent une pallet (studs)
        FG.palKey     = FG.palKey     or Enum.KeyCode.G
        FG.palPower   = FG.palPower   or 110
        FG.palLock    = false                              -- un seul spawn à la fois (les 2 mains passent l'une après l'autre)

        function FG.buildPal(PH, second)
            PH.on, PH.spawning, PH.model, PH.pp = false, false, nil, nil
            PH.dice, PH.dp, PH.dRaw, PH.dE, PH.diceFails = nil, nil, 0, 0, 0
            PH.hand  = second and 7 or (PH.hand or 10)    -- 10 = main droite, 7 = main gauche (la 2e pallet prend toujours l'autre main)
            PH.lift  = PH.lift or 1.0         -- hauteur de la pallet au-dessus de la main (studs)
            PH.reach = PH.reach or 8.0        -- avancée du bras (avant la rallonge du DiceSmall) — 8 = 2x l'ancien défaut (4)
            PH.drop  = PH.drop or -1.8        -- hauteur de la main par rapport à l'épaule
            PH.ext, PH.e, PH.retryAt, PH.handT = 0, 0, 0, -9
            PH.rel, PH.k = CFrame.new(), 3
            PH.arrive = 0.2                   -- durée du petit glissement final (s)
            PH.thr, PH.fly, PH.tilt = nil, nil, 0
            PH.stretch, PH.spreadX = FG.palStretch, 0
            PH.sm, PH.fwS = nil, nil

            local function snoEv()
                local ge = REP:FindFirstChild("GrabEvents")
                return ge and ge:FindFirstChild("SetNetworkOwner")
            end
            local function rootOf(m)
                return m:FindFirstChild("SoundPart") or m:FindFirstChild("HoldPart") or m:FindFirstChild("Main") or m:FindFirstChildWhichIsA("BasePart", true)
            end
            local function noclip(m)
                for _, p in ipairs(m:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
            local function kill(m)
                if not m then return end
                local mt = REP:FindFirstChild("MenuToys")
                local rd = mt and mt:FindFirstChild("DestroyToy")
                if rd and m.Parent then pcall(function() rd:FireServer(m) end) end
                if _G._FigureExclude then _G._FigureExclude[m] = nil end
            end

            -- supprime la pallet (et le DiceSmall du bras sauf si keepDice)
            function PH.clear(keepDice)
                PH.thr = nil
                local m = PH.model
                PH.model, PH.pp = nil, nil
                kill(m)
                if not keepDice then
                    local d = PH.dice
                    PH.dice, PH.dp = nil, nil
                    kill(d)
                end
            end
            function PH.dropDice()
                local d = PH.dice
                PH.dice, PH.dp = nil, nil
                kill(d)
            end

            -- spawn d'un toy : il est exclu de la formation DÈS son apparition (capture instantanée, pas de polling)
            local function spawnCapture(name)
                local mt     = REP:FindFirstChild("MenuToys")
                local rSpawn = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
                local inv    = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
                if not (rSpawn and inv) then return nil end
                local DS   = _G._FigDice
                local home = DS and DS.home and DS.home() or nil     -- dans ton plot, le toy apparaît dans PlotItems
                local snap = {}
                for _, m in ipairs(inv:GetChildren()) do snap[m] = true end
                if home then for _, m in ipairs(home:GetChildren()) do snap[m] = true end end
                local isDice = (name == "DiceSmall")
                if isDice then _G._FigDiceSnap, _G._FigDiceBusy = snap, true
                else _G._FigRagSnap, _G._FigRagBusy = snap, true end
                _G._FigureExclude = _G._FigureExclude or setmetatable({}, { __mode = "k" })

                local found
                local function onAdd(c)
                    if c.Name == name and not snap[c] and not found then
                        found = c
                        _G._FigureExclude[c] = true
                    end
                end
                local c1 = inv.ChildAdded:Connect(onAdd)
                local c2 = home and home.ChildAdded:Connect(onAdd)

                local can = LP:FindFirstChild("CanSpawnToy")
                if can and not can.Value then
                    local w0 = os.clock()
                    repeat task.wait() until can.Value or (os.clock() - w0) > 1.5
                end

                -- spawn comme pour les DiceSmall : (PCLD ou HRP).CFrame * offset ; si ça échoue, offset suivant (3 essais rapides)
                local offs = (DS and DS.offsets) or { Vector3.new(0, 14, 20), Vector3.new(0, 20, 15), Vector3.new(5, 10, 20) }
                for try = 1, 3 do
                    if found then break end
                    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then break end
                    local ref = (DS and DS.pcld and DS.pcld(hrp)) or hrp
                    local cf = ref.CFrame * CFrame.new(offs[((try - 1) % #offs) + 1])
                    task.spawn(function() pcall(function() rSpawn:InvokeServer(name, cf, Vector3.zero) end) end)
                    local t0 = os.clock()
                    while not found and (os.clock() - t0) < 1.2 do task.wait() end
                end
                c1:Disconnect()
                if c2 then c2:Disconnect() end
                if isDice then _G._FigDiceBusy = false else _G._FigRagBusy = false end
                return found
            end

            -- ownership : une demande par frame, sans attente fixe
            local function mineP(p)
                local po = p and p:FindFirstChild("PartOwner")
                return po ~= nil and po.Value == LP.Name
            end
            -- 📡 même système que le stockage des dés : à portée (20 studs) -> demandes d'ownership ; trop loin -> aller-retour éclair (_AnchFetch)
            local function own(pp)
                local sno = snoEv()
                local to = os.clock() + 2.5
                local fetchT = -9
                repeat
                    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and pp.Parent and (hrp.Position - pp.Position).Magnitude > 20 then
                        if _G._AnchFetch and os.clock() - fetchT > 1 then
                            fetchT = os.clock()
                            pcall(_G._AnchFetch, pp:FindFirstAncestorOfClass("Model") or pp)
                        end
                    elseif sno then
                        pcall(function() sno:FireServer(pp, pp.CFrame) end)
                    end
                    task.wait()
                until mineP(pp) or os.clock() > to or not pp.Parent
                return mineP(pp)
            end
            -- 👻 tant que la pallet / le dé n'est pas à moi côté serveur, il reste invisible chez moi (plus de pallet « fantôme » qui saute)
            local function ghost(m, on)
                if not (m and m.Parent) then return end
                for _, q in ipairs(m:GetDescendants()) do
                    if q:IsA("BasePart") then pcall(function() q.LocalTransparencyModifier = on and 1 or 0 end) end
                end
            end
            -- demande d'ownership d'un toy tenu : à portée -> demande (limitée) ; trop loin -> aller-retour éclair (1 / s)
            local function claim(p, holder, key)
                local now = os.clock()
                local sno = snoEv()
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - p.Position).Magnitude > 20 then
                    if _G._AnchFetch and now - (holder[key .. "F"] or 0) > 1 then
                        holder[key .. "F"] = now
                        pcall(_G._AnchFetch, p:FindFirstAncestorOfClass("Model") or p)
                    end
                elseif sno and now - (holder[key] or 0) > 0.05 then
                    holder[key] = now
                    pcall(function() sno:FireServer(p, p.CFrame) end)
                end
            end

            function PH.spawn()
                if PH.spawning or ragBusy then return end
                local needDice = FG.palDice and figureFormation == "Stick Man" and (PH.diceFails or 0) < 3 and not (PH.dice and PH.dice.Parent)
                local needPal  = not PH.model
                if not (needDice or needPal) then return end
                local DS0 = _G._FigDice
                if FG.palLock or (DS0 and DS0.busy) then PH.retryAt = os.clock() + 0.2 return end   -- un spawn à la fois
                local mt     = REP:FindFirstChild("MenuToys")
                local rSpawn = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
                local inv    = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
                local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not (rSpawn and inv and myRoot) then PH.retryAt = os.clock() + 3 return end
                PH.spawning, FG.palLock = true, true
                task.spawn(function()
                    local ok, err = pcall(function()
                        -- 1) 🎲 le DiceSmall d'abord : il rejoint le bras (4e segment) avant que la pallet n'arrive
                        if needDice and PH.on and animatedFigureActive then
                            local d  = spawnCapture("DiceSmall")
                            local dp = d and rootOf(d)
                            if dp then
                                noclip(d)
                                ghost(d, true)
                                own(dp)
                                if PH.on and animatedFigureActive then
                                    PH.dice, PH.dp, PH.diceFails, PH.dLastOwn, PH.dGhost = d, dp, 0, 0, true
                                else
                                    kill(d)
                                end
                            else
                                if d then kill(d) end
                                PH.diceFails = (PH.diceFails or 0) + 1
                                notify("Pallet en main", "Le DiceSmall du bras n'a pas spawn", 2)
                            end
                        end

                        -- 2) 🪵 la pallet
                        if needPal and PH.on and animatedFigureActive then
                            local pallet = spawnCapture("PalletLightBrown")
                            local pp = pallet and (pallet:FindFirstChild("SoundPart") or pallet:FindFirstChildWhichIsA("BasePart"))
                            if not pp then
                                if pallet then kill(pallet) end
                                PH.retryAt = os.clock() + 2
                                notify("Pallet en main", "La pallet n'a pas spawn", 2)
                                return
                            end
                            noclip(pallet)
                            ghost(pallet, true)
                            own(pp)

                            local rel, k = CFrame.new(), 3
                            local okb, bcf, bsz = pcall(function() return pallet:GetBoundingBox() end)
                            if okb and bcf and bsz then
                                rel = pp.CFrame:ToObjectSpace(bcf)
                                k = (bsz.X <= bsz.Y and bsz.X <= bsz.Z) and 1 or ((bsz.Y <= bsz.Z) and 2 or 3)
                            end

                            if not (PH.on and animatedFigureActive) then
                                kill(pallet)
                                return
                            end
                            PH.model, PH.pp, PH.rel, PH.k = pallet, pp, rel, k
                            PH.from, PH.t0, PH.lastOwn = pp.Position, os.clock(), 0
                            PH.everOwned, PH.ghosted = false, true      -- l'arrivée vers la main ne démarre que quand le serveur confirme l'ownership
                            PH.sm, PH.fwS = nil, nil
                        end
                    end)
                    FG.palLock, PH.spawning = false, false
                    if not ok then
                        PH.retryAt = os.clock() + 2
                        warn("[Pallet en main] " .. tostring(err))
                    end
                end)
            end

            -- 🎯 LANCER : armement (bras en arrière, coude en haut) -> swing rapide -> lâcher -> suivi du geste -> nouvelle pallet
            local T_WIND, T_SWING, T_FOLLOW = 0.32, 0.13, 0.30
            function PH.throw()
                if PH.thr or not (PH.on and PH.model and PH.pp and PH.pp.Parent) then return end
                if (os.clock() - (PH.t0 or 0)) < PH.arrive then return end
                PH.thr = { t0 = os.clock() }
            end

            local function release()
                local m, pp = PH.model, PH.pp
                PH.model, PH.pp = nil, nil
                if not (m and pp and pp.Parent) then return end
                local cam = workspace.CurrentCamera
                local dir = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
                dir = (dir + Vector3.new(0, 0.12, 0)).Unit
                local pw   = FG.palPower or 110
                local spin = Vector3.new(0, 16, 0)
                -- 🛠️ FIX « pas côté serveur / elle s'arrête au début du lancer » : avant, la pallet perdait son ownership dès le lâcher et la
                -- vitesse n'était imposée que 0,25 s. Maintenant : vitesse imposée plus longtemps (selon la puissance), ownership redemandée
                -- tant qu'elle vole (comme pour un joueur lancé), collisions réactivées après 0,12 s (sinon elle se cogne dans le bras / le dé).
                pcall(function()
                    pp.AssemblyLinearVelocity  = dir * pw
                    pp.AssemblyAngularVelocity = spin
                end)
                PH.flyList = PH.flyList or {}
                PH.flyList[#PH.flyList + 1] = { pp = pp, m = m, vel = dir * pw, spin = spin, t0 = os.clock(),
                    force = math.clamp(0.45 + pw / 350, 0.5, 1.4), solid = false, lastSno = 0 }
                task.delay(4, function() kill(m) end)
            end

            local function ease(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end

            -- 🧠 état (spawn, lancer, extension du bras) : une fois par frame
            _TrackConn(RunSvc.Heartbeat:Connect(function(dt)
                local now = os.clock()
                if second then PH.hand = (FG.pal.hand == 7) and 10 or 7 end
                PH.stretch = FG.palStretch
                PH.spreadX = (FG.pal.on and FG.pal2.on and animatedFigureActive) and FG.palSpread or 0

                if not animatedFigureActive then PH.thr = nil end
                if not animatedFigureActive and (PH.model or PH.dice) then PH.clear() end
                if PH.model and not (PH.pp and PH.pp.Parent) then PH.model, PH.pp = nil, nil; PH.retryAt = now + 0.5 end
                -- 🛠️ « côté serveur » : si on n'a pas l'ownership de la pallet tenue pendant 1,5 s, elle n'existe que chez nous -> on la refait
                if PH.model and PH.pp and PH.pp.Parent and not PH.thr and (now - (PH.t0 or now)) > 0.6 then
                    local poW = PH.pp:FindFirstChild("PartOwner")
                    if poW and poW.Value == LP.Name then
                        PH.ownLost, PH.ownFails = nil, 0
                    else
                        PH.ownLost = PH.ownLost or now
                        if now - PH.ownLost > (PH.everOwned and 1.5 or 5) then
                            PH.ownLost = nil
                            PH.ownFails = (PH.ownFails or 0) + 1
                            PH.clear(true)
                            if PH.ownFails >= 4 then
                                PH.ownFails = 0
                                PH.retryAt = now + 6
                                notify("Pallet en main", "Ownership refusée : la pallet restait locale (nouvel essai dans 6 s)", 3)
                            else
                                PH.retryAt = now + 0.3
                            end
                        end
                    end
                else
                    PH.ownLost = nil
                end
                if PH.dice and not (PH.dp and PH.dp.Parent) then PH.dice, PH.dp = nil, nil; PH.retryAt = math.max(PH.retryAt, now + 0.5) end
                if PH.dice and not FG.palDice then PH.dropDice() end
                local needDice = FG.palDice and figureFormation == "Stick Man" and (PH.diceFails or 0) < 3 and not PH.dice
                if PH.on and animatedFigureActive and (not PH.model or needDice) and not PH.spawning and now >= PH.retryAt then PH.spawn() end

                -- 🎲 le DiceSmall « s'ajoute » au bras en douceur (0 = bras normal, 1 = bras rallongé)
                local wantD = (FG.palDice and PH.dice and PH.dp and PH.dp.Parent) and 1 or 0
                if wantD > PH.dRaw then PH.dRaw = math.min(1, PH.dRaw + dt * 5) else PH.dRaw = math.max(0, PH.dRaw - dt * 5) end
                PH.dE = PH.dRaw * PH.dRaw * (3 - 2 * PH.dRaw)

                -- pose du bras pendant le lancer (nil = pose normale "pallet en main")
                PH.cReach, PH.cDrop, PH.cOutY, PH.cK, PH.tilt = nil, nil, nil, nil, 0
                local T = PH.thr
                if T then
                    local t = now - T.t0
                    local endR, endD = PH.reach + 1.6, -0.3
                    if t < T_WIND then                                    -- 1) armement
                        local a = ease(t / T_WIND)
                        PH.cReach = PH.reach + (-2.2 - PH.reach) * a
                        PH.cDrop  = PH.drop + (1.6 - PH.drop) * a
                        PH.cOutY  = -1 + 1.5 * a
                        PH.cK     = 0.5 + 0.1 * a
                        PH.tilt   = 0.9 * a
                    elseif t < T_WIND + T_SWING then                      -- 2) swing rapide (accélère)
                        local a = (t - T_WIND) / T_SWING
                        a = a * a
                        PH.cReach = -2.2 + (endR + 2.2) * a
                        PH.cDrop  = 1.6 + (endD - 1.6) * a
                        PH.cOutY  = 0.5 - 0.8 * a
                        PH.cK     = 0.6 - 0.2 * a
                        PH.tilt   = 0.9 - 1.3 * a
                        if a >= 0.8 and PH.model then release() end       -- 3) lâcher
                    else                                                  -- 4) le bras finit le geste
                        PH.cReach, PH.cDrop, PH.cOutY, PH.cK = endR, endD, -0.3, 0.4
                        if PH.model then release() end
                        if t >= T_WIND + T_SWING + T_FOLLOW then
                            PH.thr = nil
                            PH.retryAt = now + 0.05                       -- nouvelle pallet direct après le geste (le DiceSmall reste au bras)
                        end
                    end
                    if PH.thr and not PH.model then PH.retryAt = now + 9 end   -- pas de respawn pendant le geste
                end

                -- pallet(s) lancée(s) : vitesse imposée un moment + ownership gardée (sinon elle s'arrête net ou reste locale)
                local FLs = PH.flyList
                if FLs and #FLs > 0 then
                    local snoF = snoEv()
                    for i = #FLs, 1, -1 do
                        local FL  = FLs[i]
                        local age = now - FL.t0
                        if not (FL.pp and FL.pp.Parent) or age > 3 then
                            table.remove(FLs, i)
                        else
                            if not FL.solid and age > 0.12 then
                                FL.solid = true
                                pcall(function()
                                    for _, q in ipairs(FL.m:GetDescendants()) do
                                        if q:IsA("BasePart") then q.CanCollide = true end
                                    end
                                end)
                            end
                            if age < FL.force then
                                pcall(function()
                                    FL.pp.AssemblyLinearVelocity  = FL.vel
                                    FL.pp.AssemblyAngularVelocity = FL.spin
                                end)
                            end
                            local poF = FL.pp:FindFirstChild("PartOwner")
                            if snoF and not (poF and poF.Value == LP.Name) and (now - FL.lastSno) > 0.1 then
                                FL.lastSno = now
                                pcall(function() snoF:FireServer(FL.pp, FL.pp.CFrame) end)
                            end
                        end
                    end
                end

                -- le bras reste tendu tant qu'il porte la pallet OU le DiceSmall (pas d'aller-retour entre deux pallets)
                local want = (PH.on and animatedFigureActive and (PH.model or PH.thr or PH.dice)) and 1 or 0
                if want > PH.ext then PH.ext = math.min(1, PH.ext + dt * 6) else PH.ext = math.max(0, PH.ext - dt * 4) end
                PH.e = PH.ext * PH.ext * (3 - 2 * PH.ext)

                -- sécurité : si la boucle de formation n'a pas placé la pallet / le dé récemment, on le fait ici
                if (PH.model or PH.dice) and (now - (FG.palPostT or -9)) > 0.15 then PH.place(dt) end
            end))

            -- 📍 placement du DiceSmall (bout du bras) puis de la pallet : appelé par la boucle de formation JUSTE APRÈS l'écriture des toys
            -- (même frame -> aucun décalage entre la main et la pallet)
            function PH.place(dt)
                local now = os.clock()
                dt = math.clamp(dt or 0.016, 0.001, 0.1)
                local sno    = snoEv()
                local hbPart = figureBodyCache[_G._FigHandIdx(PH.hand)]
                local fresh  = (now - PH.handT) < 0.3

                -- 🎲 le DiceSmall EST le bout du bras (même courbe, même orientation que les autres segments)
                local dp = PH.dp
                if PH.dice and dp and dp.Parent then
                    local dpos, dtg
                    if fresh and PH.diceP and (PH.e or 0) > 0.001 then
                        dpos, dtg = PH.diceP, PH.diceTg
                    elseif hbPart then
                        dpos = hbPart.Position
                    end
                    -- 🔒 on ne déplace JAMAIS un dé qui n'est pas à moi côté serveur (sinon il n'existe qu'ici) : on le reprend d'abord
                    if mineP(dp) then
                        if PH.dGhost then PH.dGhost = false; ghost(PH.dice, false) end
                        if dpos then
                            local cf = CFrame.new(dpos)
                            if dtg and dtg.Magnitude > 0.01 then
                                cf = CFrame.lookAt(dpos, dpos + dtg.Unit) * CFrame.Angles(math.rad(-90), 0, 0)
                            end
                            pcall(function()
                                dp.CFrame = cf
                                dp.AssemblyLinearVelocity  = Vector3.zero
                                dp.AssemblyAngularVelocity = Vector3.zero
                            end)
                        end
                    else
                        if not PH.dGhost then PH.dGhost = true; ghost(PH.dice, true) end
                        claim(dp, PH, "dLastOwn")
                    end
                end

                -- 🪵 la pallet, posée sur la main (= sur le DiceSmall quand il est là)
                local pp = PH.pp
                if not (PH.model and pp and pp.Parent) then return end
                local hb = (fresh and PH.handPos) or (hbPart and hbPart.Position)
                if not hb then return end

                -- 🔒 PALLET CÔTÉ SERVEUR : tant que le serveur ne confirme pas que la pallet est à moi (PartOwner), on ne la déplace pas
                -- (avant : elle était posée dans la main chez moi seulement) ; on la reprend (demandes / aller-retour éclair) et elle reste invisible.
                if not mineP(pp) then
                    if not PH.ghosted then PH.ghosted = true; ghost(PH.model, true) end
                    claim(pp, PH, "lastOwn")
                    return
                end
                if PH.ghosted then PH.ghosted = false; ghost(PH.model, false) end
                if not PH.everOwned then
                    PH.everOwned = true
                    PH.from, PH.t0, PH.sm, PH.fwS = pp.Position, now, nil, nil   -- l'arrivée vers la main démarre MAINTENANT (propre, sans saut)
                end

                local cs   = (figureScale or 1) * (figureCompactness or 1)
                local rest = hb + Vector3.new(0, PH.lift * cs, 0)           -- plus de « respiration » : la pallet reste en place
                -- arrivée rapide : la pallet glisse de son point de spawn jusqu'à la main (rebond léger)
                local k = math.clamp((now - PH.t0) / math.max(PH.arrive, 0.05), 0, 1)
                local c1 = 1.70158
                local u = (k >= 1) and 1 or (1 + (c1 + 1) * (k - 1) ^ 3 + c1 * (k - 1) ^ 2)
                local pos = PH.from:Lerp(rest, u)

                -- 🧊 ANTI-VIBRATION : zone morte de 1,2 cm + filtre passe-bas (fort sur les micro-mouvements, rapide sur les vrais déplacements)
                if k < 1 or not PH.sm then
                    PH.sm = pos
                else
                    local err = pos - PH.sm
                    local d = err.Magnitude
                    if d > 0.012 then
                        local rate = 16 + 70 * math.clamp((d - 0.25) / 1.2, 0, 1)
                        PH.sm = PH.sm + err * (1 - math.exp(-rate * dt))
                    end
                end
                pos = PH.sm

                -- orientation : cap de la caméra LISSÉ (un petit tremblement de souris ne fait plus vibrer la pallet)
                local cam = workspace.CurrentCamera
                local fw = cam and Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) or Vector3.new(0, 0, -1)
                if fw.Magnitude < 0.01 then fw = PH.fwS or Vector3.new(0, 0, -1) else fw = fw.Unit end
                local fs = PH.fwS and PH.fwS:Lerp(fw, 1 - math.exp(-9 * dt)) or fw
                if fs.Magnitude < 0.05 then fs = fw else fs = fs.Unit end
                PH.fwS = fs
                fw = fs
                local rot = CFrame.lookAt(Vector3.zero, Vector3.yAxis, fw)
                if PH.k == 2 then rot = rot * CFrame.Angles(math.pi / 2, 0, 0)
                elseif PH.k == 1 then rot = rot * CFrame.Angles(0, -math.pi / 2, 0) end
                if PH.tilt ~= 0 then rot = CFrame.fromAxisAngle(fw:Cross(Vector3.yAxis), PH.tilt) * rot end   -- inclinaison pendant le lancer
                rot = CFrame.Angles(0, (1 - k) * 4, 0) * rot

                pcall(function()
                    pp.CFrame = CFrame.new(pos) * rot * PH.rel:Inverse()
                    pp.AssemblyLinearVelocity  = Vector3.zero
                    pp.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
        FG.buildPal(FG.pal, false)
        FG.buildPal(FG.pal2, true)

        -- appelé par la boucle de formation après l'écriture des toys
        function FG.palPost(dt)
            FG.palPostT = os.clock()
            FG.pal.place(dt)
            FG.pal2.place(dt)
        end

        -- (ré)applique les 2 toggles : la 1re pallet est active si l'un OU l'autre est coché, la 2e seulement avec « chaque main »
        function FG.palRefresh()
            local a = FG.palT1 or FG.palT2
            FG.pal.on, FG.pal2.on = a, FG.palT2
            if not a then FG.pal.clear() end
            if not FG.palT2 then FG.pal2.clear() end
            if a then FG.pal.diceFails = 0 end
            if FG.palT2 then FG.pal2.diceFails = 0 end
            if animatedFigureActive then
                if a then FG.pal.spawn() end
                if FG.palT2 then FG.pal2.spawn() end
            elseif a then
                notify("Pallet en main", "Active d'abord l'Animated Figure : la pallet apparaîtra toute seule", 3)
            end
        end

        do
            local function both(fn) fn(FG.pal); fn(FG.pal2) end

            -- ===== UI =====
            ExtraFun:CreateToggle({
                Name = "🪵 Pallet en main (spawn direct + bras en arc par en dessous)",
                Flag = "FigurePalletHold",
                Default = false,
                Callback = function(v)
                    FG.palT1 = v
                    FG.palRefresh()
                end
            })
            ExtraFun:CreateToggle({
                Name = "🪵🪵 Une pallet dans chaque main",
                Flag = "FigurePalletBoth",
                Default = false,
                Callback = function(v)
                    FG.palT2 = v
                    FG.palRefresh()
                end
            })
            ExtraFun:CreateToggle({
                Name = "🎲 DiceSmall au bout du bras (spawn avant la pallet, rallonge le bras)",
                Flag = "FigurePalletDice",
                Default = true,
                Callback = function(v)
                    FG.palDice = v
                    if v then
                        both(function(P) P.diceFails = 0; P.retryAt = 0 end)   -- la boucle d'état fait spawn le dé tout seule
                    else
                        both(function(P) if P.dropDice then P.dropDice() end end)
                    end
                end
            })
            ExtraFun:CreateSlider({
                Name = "🎲 Rallonge du bras par le DiceSmall (x0.1 segment)",
                Flag = "FigurePalletStretch",
                Min = 0, Max = 30, Default = 10,
                Callback = function(v) FG.palStretch = v / 10 end
            })
            ExtraFun:CreateSlider({
                Name = "🪵🪵 Écartement des 2 pallets (x0.1 stud)",
                Flag = "FigurePalletSpread",
                Min = 0, Max = 80, Default = 25,
                Callback = function(v) FG.palSpread = v / 10 end
            })
            ExtraFun:CreateDropdown({
                Name = "🪵 Main qui porte la pallet",
                Flag = "FigurePalletHand",
                Default = "Droite",
                Items = { "Droite", "Gauche" },
                Search = false,
                Callback = function(v) FG.pal.hand = (v == "Gauche") and 7 or 10 end   -- la 2e pallet (« chaque main ») prend l'autre
            })
            ExtraFun:CreateSlider({
                Name = "🪵 Hauteur de la pallet au-dessus de la main (x0.1 stud)",
                Flag = "FigurePalletLift",
                Min = 0, Max = 40, Default = 10,
                Callback = function(v) both(function(P) P.lift = v / 10 end) end
            })
            ExtraFun:CreateSlider({
                Name = "🪵 Avancée du bras (x0.1 stud) — 80 = 8 studs (2x l'ancien défaut), jusqu'à 25 studs",
                Flag = "FigurePalletReach",
                Min = 10, Max = 250, Default = 80,
                Callback = function(v) both(function(P) P.reach = v / 10 end) end
            })
            ExtraFun:CreateSlider({
                Name = "🦴 Toys par bras qui porte la pallet (3 = comme avant · 6 = bras long sans trous, extras 17-22 du stockage)",
                Flag = "FigurePalletArmToys",
                Min = 3, Max = 6, Default = 6,
                Callback = function(v) FG.palArmToys = v end
            })
            ExtraFun:CreateSlider({
                Name = "🪵 Hauteur de la main (x0.1 stud, négatif = plus bas)",
                Flag = "FigurePalletDrop",
                Min = -50, Max = 20, Default = -18,
                Callback = function(v) both(function(P) P.drop = v / 10 end) end
            })
            ExtraFun:CreateKeybind({
                Name = "🪵 Touche pour lancer la pallet",
                Flag = "FigurePalletThrowKey",
                Default = Enum.KeyCode.G,
                Callback = function(k) FG.palKey = k end
            })
            ExtraFun:CreateSlider({
                Name = "🪵 Puissance du lancer",
                Flag = "FigurePalletPower",
                Min = 30, Max = 300, Default = 110,
                Callback = function(v) FG.palPower = v end
            })
            ExtraFun:CreateButton({
                Name = "🪵 Lancer la pallet",
                Callback = function() FG.pal.throw(); FG.pal2.throw() end
            })
            ExtraFun:CreateButton({
                Name = "🪵 Respawn la pallet",
                Callback = function()
                    FG.pal.clear(true); FG.pal2.clear(true)
                    task.delay(0.15, function()
                        if FG.pal.on then FG.pal.spawn() end
                        if FG.pal2.on then FG.pal2.spawn() end
                    end)
                end
            })

            local UISp = game:GetService("UserInputService")
            _TrackConn(UISp.InputBegan:Connect(function(input, gp)
                if input.KeyCode ~= FG.palKey or UISp:GetFocusedTextBox() ~= nil then return end
                FG.pal.throw()
                FG.pal2.throw()
            end))
        end


        -- =====================================================================================================================
        -- ⚰️ ENTERRER : au lieu de lancer, le clic droit enfonce de force le joueur tenu dans le sol (animation de 5 s minimum).
        -- Pendant l'enterrement : les toys de la formation passent en noclip (le bras peut s'enfoncer dans le sol) et les parts du joueur
        -- passent en noclip + massless (on garde son ownership, on pilote sa position). Clic droit de nouveau = on arrête / on libère.
        -- Tout passe par la table FG (pas de nouvelle variable locale : le bloc est déjà gros).
        -- =====================================================================================================================
        FG.action   = FG.action or "Lancer"
        FG.buryDur  = FG.buryDur or 6            -- durée totale de l'animation (s), 5 minimum
        FG.buryKeep = FG.buryKeep or false       -- true : le joueur reste enterré (et tenu) jusqu'au prochain clic droit
        FG.buryStare = FG.buryStare or 2         -- secondes où la formation, un genou à terre, regarde le joueur avant de l'enfoncer
        FG.burySink  = FG.burySink or 20         -- ⬇️ profondeur finale : le joueur finit ~20 studs SOUS le sol / sous la formation
        FG.buryStyles = {
            ["Enterrer debout (jusqu'au cou)"] = { rot = "up",   rest = nil, sink = 4.6 },   -- rest = hauteur du root au repos (nil = calculée)
            ["Planter tête en bas"]            = { rot = "inv",  rest = nil, sink = 4.0 },
            ["Écraser à plat (tout enfoncé)"]  = { rot = "flat", rest = 1.0, sink = 3.6 },
            -- 🆕 autres façons d'enterrer · dRel = profondeur finale fixe (relative à la hauteur au repos, le joueur reste visible)
            --    hold = le joueur reste tenu enterré jusqu'au prochain clic droit (sinon il serait éjecté du sol dès la fin)
            ["Jusqu'à la taille (reste visible)"] = { rot = "up",   rest = nil, dRel = 0.0, hold = true },
            ["Jusqu'au cou (tête dehors)"]        = { rot = "up",   rest = nil, dRel = 1.6, hold = true },
            ["Sur le dos (cercueil)"]             = { rot = "back", rest = 1.0 },
            ["Sur le côté"]                       = { rot = "side", rest = 1.0 },
            ["Tire-bouchon (vrille)"]             = { rot = "spin", rest = nil },
            -- 🎆 la plus visible : cercle rouge au sol, bras levé puis abattu, trou, anneaux, poussière, éclats, tremblements, tombe « R.I.P »
            ["Grande cérémonie (tombe + terre)"]  = { rot = "up",   rest = nil, big = true },
        }

        -- toys de la formation : noclip pendant l'enterrement, collisions d'origine restaurées ensuite
        function FG.toyNoclip(on)
            if on and not FG._tnc then
                local inv = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
                if not inv then return end
                local saved = {}
                local function add(q)
                    if q:IsA("BasePart") and saved[q] == nil then saved[q] = q.CanCollide; q.CanCollide = false end
                end
                for _, t in ipairs(figureBodyCache) do
                    if t and t.Parent then
                        local m = t
                        while m.Parent and m.Parent ~= inv and m.Parent ~= workspace do m = m.Parent end
                        pcall(function()
                            add(m)
                            for _, q in ipairs(m:GetDescendants()) do add(q) end
                        end)
                    end
                end
                FG._tnc = saved
            elseif not on and FG._tnc then
                for q, v in pairs(FG._tnc) do pcall(function() if q.Parent then q.CanCollide = v end end) end
                FG._tnc = nil
            end
        end

        -- onde de choc + petit tremblement de caméra quand le joueur est claqué au sol
        function FG.buryFx(pos)
            pcall(function()
                local r = Instance.new("Part")
                r.Anchored, r.CanCollide, r.CanQuery, r.CanTouch = true, false, false, false
                r.Material, r.Color, r.Shape, r.Transparency = Enum.Material.Neon, Color3.fromRGB(150, 110, 70), Enum.PartType.Cylinder, 0.2
                r.Size = Vector3.new(0.4, 2, 2)
