            local function fmt(n) return tostring(math.floor(n * 10 + 0.5) / 10) end

            local function listPositions()
                local list = {}
                pcall(function()
                    if isfolder(POS_FOLDER) then
                        for _, f in ipairs(listfiles(POS_FOLDER)) do
                            local name = f:match("([^/\\]+)%.json$")
                            if name and name:sub(1, 1) ~= "_" then table.insert(list, name) end
                        end
                    end
                end)
                table.sort(list); return list
            end

            local function cleanName(n)
                n = tostring(n or ""):gsub("[^%w%-_ ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
                if n:sub(1, 1) == "_" then n = n:sub(2) end
                return n
            end

