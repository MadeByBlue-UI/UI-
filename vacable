        function Radial:_build(animate)
            for _, b in ipairs(self.buttons) do b:Destroy() end
            self.buttons = {}
            local pg = self.Pages[self.page]
            local items = pg and pg.Items or {}
            local n = #items
            local R = math.max(150, n * 88 / (2 * math.pi))
            self.radius = R
            self.ring.Size = UDim2.fromOffset(R * 2, R * 2)
            self.sub.Text = pg and ((pg.Name or "") .. (#self.Pages > 1 and ("  " .. self.page .. "/" .. #self.Pages .. " · molette") or "")) or ""
            for i, it in ipairs(items) do
                local a = (i - 1) * 2 * math.pi / math.max(n, 1)
                local target = UDim2.fromOffset(math.sin(a) * R, -math.cos(a) * R)
                local b = Instance.new("TextLabel")
                b.AnchorPoint = Vector2.new(0.5, 0.5)
                b.Size = UDim2.fromOffset(80, 36)
                b.BackgroundColor3 = Color3.new(0, 0, 0)
                b.BackgroundTransparency = 0.05
                b.BorderSizePixel = 0
                b.Text = it.Label or "?"
                b.TextColor3 = Color3.new(1, 1, 1)
                b.Font = Enum.Font.GothamBold
                b.TextScaled = true
                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 16)
                local st = Instance.new("UIStroke", b); st.Color = Color3.new(1, 1, 1); st.Thickness = 1.2; st.Transparency = 0.6
                local pad = Instance.new("UIPadding", b)
                pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6)
                pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 7), UDim.new(0, 7)
                local sh = Instance.new("UIGradient", b)   -- reflet "shine" (actif seulement sur l'emote visée)
                sh.Color = SHINE
                sh.Rotation = 45
                sh.Offset = Vector2.new(-1, 0)
                sh.Enabled = false
                b.Parent = self.root
                if animate then
                    b.Position = UDim2.fromOffset(math.sin(a) * R * 0.55, -math.cos(a) * R * 0.55)
                    b.TextTransparency, b.BackgroundTransparency, st.Transparency = 1, 1, 1
                    task.delay(i * 0.012, function()
                        if not b.Parent then return end
                        TS:Create(b, TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = target, TextTransparency = 0, BackgroundTransparency = 0.05 }):Play()
                        TS:Create(st, TweenInfo.new(0.24), { Transparency = 0.6 }):Play()
                    end)
                else
                    b.Position = target
                end
                self.buttons[i] = b
            end
        end

        function Radial:_update()
            local pg = self.Pages[self.page]
            local items = pg and pg.Items or {}
            local n = #items
            local o = self.offset
            self.dot.Position = UDim2.fromOffset(o.X, o.Y)
            local sel = nil
            if n > 0 and o.Magnitude > 40 then
                local ang = math.atan2(o.X, -o.Y) % (2 * math.pi)
                sel = (math.floor(ang / (2 * math.pi / n) + 0.5) % n) + 1
            end
            self.sel = sel
            if sel == self._lastSel then return end
            self._lastSel = sel

            local quick = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            for i, b in ipairs(self.buttons) do
                local on = (i == sel)
                local st = b:FindFirstChildOfClass("UIStroke")
                local sh = b:FindFirstChildOfClass("UIGradient")
                TS:Create(b, quick, {
                    BackgroundColor3 = on and Color3.new(1, 1, 1) or Color3.new(0, 0, 0),
                    TextColor3 = on and Color3.new(0, 0, 0) or Color3.new(1, 1, 1),
                    Size = on and UDim2.fromOffset(96, 44) or UDim2.fromOffset(80, 36),
                }):Play()
                if st then TS:Create(st, quick, { Transparency = on and 0 or 0.6, Thickness = on and 2 or 1.2 }):Play() end
                if sh then
                    sh.Enabled = on
                    if on then
                        sh.Offset = Vector2.new(-1, 0)
                        TS:Create(sh, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Offset = Vector2.new(1, 0) }):Play()
                    end
                end
            end

            if sel then
                local a = (sel - 1) * 2 * math.pi / n
                local R = self.radius
                local pos = UDim2.fromOffset(math.sin(a) * R, -math.cos(a) * R)
