            local stickyPart = shuriken:FindFirstChild("StickyPart")
            if stickyPart then
                local args = {
                    stickyPart,
                    Part,
                    CFrame.new(1e30, 1e30, 1e30)
                }
                StickyPartEvent:FireServer(unpack(args))
                success = success + 1
            end
        end
        
        if success > 0 then
            local partInfo = Part.Name
            if Part.Parent then
                partInfo = partInfo .. " (from " .. Part.Parent.Name .. ")"
            end
            notify("Combat", "💥 Broke: " .. partInfo .. " with " .. success .. " shuriken(s)", 3)
