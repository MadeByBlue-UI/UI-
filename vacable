    -- =====================================================================
    -- LOGIQUE SKIN
    -- =====================================================================
    function setStatus(txt)
        if statusLabel and statusLabel.Parent then statusLabel.Text = txt end
    end

    function say(msg)
        if typeof(notify) == "function" then pcall(notify, "Skin", msg, 3) end
    end

    -- Appel réseau avec retries (les endpoints Roblox échouent souvent au 1er essai)
    function retry(fn, tries, ...)
        for i = 1, tries do
            local ok, res = pcall(fn, ...)
            if ok and res ~= nil then return res end
            if i < tries then task.wait(0.4 * i) end
        end
        return nil
    end

    -- ---------- Anti-collision sur TOUT ce qui est ajouté ----------
    function ghostPart(part)
        if not part:IsA("BasePart") then return end
        part.CanCollide = false
        part.CanTouch   = false
        part.CanQuery   = false
        part.Massless   = true
        if not guarded[part] then
            guarded[part] = true
            _TrackConn(part:GetPropertyChangedSignal("CanCollide"):Connect(function()
                if part.CanCollide then part.CanCollide = false end
            end))
        end
    end

    function ghostAllAccessories(char)
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Accessory") then
                for _, d in ipairs(child:GetDescendants()) do ghostPart(d) end
            end
        end
    end

    -- Tout nouvel accessoire (appliqué par nous OU par le jeu) devient non-collidable
    function hookCharacter(char)
        if charConn then charConn:Disconnect() end
        charConn = char.DescendantAdded:Connect(function(d)
            if d:IsA("BasePart") and d:FindFirstAncestorOfClass("Accessory") then
                ghostPart(d)
            end
        end)
        ghostAllAccessories(char)
    end

    function waitHumanoid(char, timeout)
        if not char then return nil end
        return char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", timeout or 8)
    end

    -- ---------- Construction / copie du skin ----------
    local KEEP_NAMES   = { OriginalSize = true, AvatarPartScaleType = true }
    local KEEP_CLASSES = { SurfaceAppearance = true, WrapTarget = true, FaceControls = true, Decal = true }
    local LOOK_CLASSES = { "Shirt", "Pants", "ShirtGraphic", "CharacterMesh", "BodyColors" }

    function isLook(inst)
        for _, cn in ipairs(LOOK_CLASSES) do
            if inst:IsA(cn) then return true end
        end
        return false
    end

    -- Enlève l'ancien skin (accessoires, vêtements, couleurs...)
    function clearLooks(char)
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Accessory") or isLook(c) then c:Destroy() end
        end
    end

    -- Copie SurfaceAppearance / WrapTarget / FaceControls / visage d'une pièce à l'autre
    function syncExtras(dst, src)
        for _, c in ipairs(dst:GetChildren()) do
            if KEEP_CLASSES[c.ClassName] or KEEP_NAMES[c.Name] then c:Destroy() end
        end
        for _, c in ipairs(src:GetChildren()) do
            if KEEP_CLASSES[c.ClassName] or KEEP_NAMES[c.Name] then c:Clone().Parent = dst end
        end
    end

    -- Remplace entièrement une pièce (si MeshId n'est pas modifiable)
    function swapPart(char, name, mp)
        local old = char:FindFirstChild(name)
        if not old then return end
        local new = mp:Clone()
        new.CFrame = old.CFrame
        for _, mo in ipairs(new:GetChildren()) do
            if mo:IsA("Motor6D") then
                local om = old:FindFirstChild(mo.Name)
                mo.Part0 = om and om.Part0 or nil
                mo.Part1 = new
            end
        end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Motor6D") and d.Part0 == old then d.Part0 = new end
        end
        new.Parent = char
        old:Destroy()
    end

    function copyR15Body(char, hum, model)
        local mh = model:FindFirstChildOfClass("Humanoid")
        if not mh then return end

        -- 1) meshs / textures / tailles / couleurs de chaque membre
        for _, mp in ipairs(model:GetChildren()) do
            if mp:IsA("MeshPart") then
                local p = char:FindFirstChild(mp.Name)
                if p and p:IsA("MeshPart") then
                    pcall(function() p.MeshId = mp.MeshId end)
                    if p.MeshId ~= mp.MeshId then
                        pcall(swapPart, char, mp.Name, mp)
                        p = char:FindFirstChild(mp.Name)
                    end
                    if p then
                        pcall(function() p.TextureID = mp.TextureID end)
                        pcall(function() p.Size = mp.Size end)
                        pcall(function() p.Color = mp.Color end)
                        syncExtras(p, mp)
                        -- attachments (positions des accessoires, cages...)
                        for _, att in ipairs(mp:GetChildren()) do
                            if att:IsA("Attachment") then
                                local a = p:FindFirstChild(att.Name)
                                if a and a:IsA("Attachment") then
                                    a.CFrame = att.CFrame
                                elseif not a then
                                    att:Clone().Parent = p
                                end
                            end
                        end
                    end
                end
            end
        end

        -- 2) articulations = vraies proportions du joueur
        for _, mo in ipairs(model:GetDescendants()) do
            if mo:IsA("Motor6D") then
                local mine = char:FindFirstChild(mo.Name, true)
                if mine and mine:IsA("Motor6D") then
                    mine.C0 = mo.C0
                    mine.C1 = mo.C1
                end
            end
        end

        -- 3) racine + hauteur au sol
        local mroot, root = model:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("HumanoidRootPart")
        if mroot and root then pcall(function() root.Size = mroot.Size end) end
        pcall(function() hum.HipHeight = mh.HipHeight end)
    end

    function copyR6Body(char, model)
        local head, mhead = char:FindFirstChild("Head"), model:FindFirstChild("Head")
        if head and mhead then
            local ms = mhead:FindFirstChildOfClass("SpecialMesh")
            if ms then
                local old = head:FindFirstChildOfClass("SpecialMesh")
                if old then old:Destroy() end
                ms:Clone().Parent = head
            end
            syncExtras(head, mhead)
        end
        for _, mp in ipairs(model:GetChildren()) do
            if mp:IsA("BasePart") and mp.Name ~= "HumanoidRootPart" then
                local p = char:FindFirstChild(mp.Name)
                if p then pcall(function() p.Color = mp.Color end) end
            end
        end
    end

    -- Attache un accessoire à la main (sans AddAccessory, bloqué/peu fiable côté client)
    function addAccessory(char, hum, acc)
        local clone  = acc:Clone()
        local handle = clone and clone:FindFirstChild("Handle")
        if not handle then return end

        -- placement d'origine (weld du modèle du joueur)
        local c0, c1, target
        local ow = acc:FindFirstChild("Handle") and acc.Handle:FindFirstChild("AccessoryWeld")
        if ow and ow:IsA("JointInstance") and ow.Part1 then
            local t = char:FindFirstChild(ow.Part1.Name)
            if t and t:IsA("BasePart") then
                target, c0, c1 = t, ow.C0, ow.C1
            end
        end

        -- sinon : on cherche l'attachment du Handle qui existe sur ton perso
        if not target then
            for _, att in ipairs(handle:GetChildren()) do
                if att:IsA("Attachment") then
                    for _, part in ipairs(char:GetChildren()) do
                        local ca = part:IsA("BasePart") and part:FindFirstChild(att.Name)
                        if ca and ca:IsA("Attachment") then
                            target, c0, c1 = part, att.CFrame, ca.CFrame
                            break
                        end
                    end
                end
                if target then break end
            end
        end

        if not target then
            target = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            c0, c1 = CFrame.new(), CFrame.new()
        end
        if not target then return end

        -- nettoyage + anti-collision AVANT de parenter
        for _, d in ipairs(clone:GetDescendants()) do
            if d.Name == "AccessoryWeld" then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.Anchored = false
                ghostPart(d)
            end
        end

        handle.CFrame = target.CFrame * c1 * c0:Inverse()

        local w = Instance.new("Weld")
        w.Name  = "AccessoryWeld"
        w.Part0 = handle
        w.Part1 = target
        w.C0    = c0
        w.C1    = c1
        w.Parent = handle

        clone.Parent = char
    end

    -- Construit le modèle du joueur (même rig que le tien) ; fallback = modèle d'apparence
    function makeModel(userId, desc, rig)
        local m = retry(function() return Plrs:CreateHumanoidModelFromDescription(desc, rig) end, 2)
        if m then return m, true end
        m = retry(function() return Plrs:GetCharacterAppearanceAsync(userId) end, 2)
        return m, false
    end

    -- Applique le skin sur ton perso. Retourne ok, corpsComplet
    function applyAvatar(userId, desc, myToken)
        local char = lp.Character
        local hum  = waitHumanoid(char, 8)
        if not hum then return false end

        -- toggles K / H : on force ces parties du corps (sur une copie)
        desc = desc:Clone()
        if kOn then desc.RightLeg = K_LEG_ID end
        if hOn then desc.Head = H_HEAD_ID end

        local model, full = makeModel(userId, desc, hum.RigType)
        if not model then return false end
        if myToken ~= token then model:Destroy(); return false end

        local neck = hum.RequiresNeck
        pcall(function() hum.RequiresNeck = false end) -- évite la mort si une pièce est remplacée

        local ok, err = pcall(function()
            clearLooks(char)
            if full then
                if hum.RigType == Enum.HumanoidRigType.R15 then
                    copyR15Body(char, hum, model)
                else
                    copyR6Body(char, model)
                end
            end
            for _, c in ipairs(model:GetChildren()) do
                if isLook(c) then
                    c:Clone().Parent = char
                elseif c:IsA("Accessory") then
                    addAccessory(char, hum, c)
                end
            end
            -- visage du modèle d'apparence (fallback)
            local head = char:FindFirstChild("Head")
            if head and not head:FindFirstChildOfClass("Decal") then
                local face = model:FindFirstChild("face", true)
                if face and face:IsA("Decal") then face:Clone().Parent = head end
            end
        end)

        pcall(function() hum.RequiresNeck = neck end)
        model:Destroy()
        if not ok then warn("[Skin] erreur : " .. tostring(err)); return false end
        if myToken ~= token then return false end

        hookCharacter(char)
        for _ = 1, 3 do
            task.wait(0.25)
            if lp.Character ~= char then break end
            ghostAllAccessories(char)
        end
        return true, full
    end

    function targetRigType(userId)
        local info = retry(function() return Plrs:GetCharacterAppearanceInfoAsync(userId) end, 2)
        return info and info.playerAvatarType
    end

    function applyUser(userId)
        token += 1
        local myToken = token
        setStatus("Chargement")

        local hum = waitHumanoid(lp.Character, 8)
        if not hum then setStatus("Pas de perso"); return end

        local desc = retry(Plrs.GetHumanoidDescriptionFromUserId, 3, Plrs, userId)
        if myToken ~= token then return end
        if not desc then
            setStatus("Introuvable")
            say("Avatar introuvable pour cet ID.")
            return
        end

        local theirRig = targetRigType(userId)
        local myRig    = hum.RigType.Name

        local ok, full = applyAvatar(userId, desc, myToken)
        if myToken ~= token then return end
        if not ok then
            setStatus("Échec")
            say("Impossible d'appliquer ce skin (voir console F9).")
            return
        end

        lastDesc, lastUserId = desc, userId
        if not full then
            setStatus("Appliqué ~")
            say("Corps non copiable ici : vêtements, couleurs, visage et accessoires appliqués.")
        elseif theirRig and theirRig ~= myRig then
            setStatus("Appliqué ~")
            say(("Rig différent (jeu : %s, joueur : %s) : corps adapté au rig du jeu."):format(myRig, theirRig))
        else
            setStatus("Appliqué ✓")
            say("Skin appliqué !")
        end
    end

    function resolveUserId(text)
        text = (text or ""):match("^%s*(.-)%s*$")
        if text == "" then return nil end
        local n = tonumber(text)
        if n then return n end
        return retry(Plrs.GetUserIdFromNameAsync, 2, Plrs, text)
    end

    function submit()
        local text = box.Text
        task.spawn(function()
            setStatus("Recherche")
            local id = resolveUserId(text)
            if not id then
                setStatus("ID invalide")
                say("ID ou pseudo invalide.")
                return
            end
            applyUser(id)
            if lastUserId == id then saveState() end
        end)
    end

    _TrackConn(box.FocusLost:Connect(function(enterPressed)
        if enterPressed then submit() end
    end))
    _TrackConn(goBtn.MouseButton1Click:Connect(submit))

    -- ---------- Toggles K / H (à droite de GO) ----------
    function makeToggle(label, x)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 26, 0, 26)
        b.Position = UDim2.new(0, x, 0.5, -13)
        b.BackgroundColor3 = Color3.new(1, 1, 1)
        b.BackgroundTransparency = 0.88
        b.BorderSizePixel = 0
        b.Text = label
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.AutoButtonColor = false
        b.ZIndex = panel.ZIndex + 4
        b.Parent = panel
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 13)
        return b
    end

    local kBtn = makeToggle("K", 248)
    local hBtn = makeToggle("H", 278)

    function paintToggle(b, on)
        TS:Create(b, TweenInfo.new(0.15), { BackgroundTransparency = on and 0.15 or 0.88 }):Play()
        b.TextColor3 = on and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
    end

    function refreshToggles()
        paintToggle(kBtn, kOn)
        paintToggle(hBtn, hOn)
    end

    -- Ré-applique le skin actif (ou ton avatar) avec les toggles à jour
    function reapplyWithToggles()
        task.spawn(function()
            local keepId = lastUserId
            applyUser(keepId or lp.UserId)
            if not keepId and not kOn and not hOn then
                lastDesc, lastUserId = nil, nil
            end
            saveState()
        end)
    end

    _TrackConn(kBtn.MouseButton1Click:Connect(function()
        kOn = not kOn
        refreshToggles()
        reapplyWithToggles()
    end))
    _TrackConn(hBtn.MouseButton1Click:Connect(function()
        hOn = not hOn
        refreshToggles()
        reapplyWithToggles()
    end))

    -- Clic sur "SKIN" = remet ton propre avatar (toggles K/H coupés aussi)
    _TrackConn(title.MouseButton1Click:Connect(function()
        box.Text = ""
        kOn, hOn = false, false
        refreshToggles()
        task.spawn(function()
            applyUser(lp.UserId)
            lastDesc, lastUserId = nil, nil -- pas de réapplication au respawn
            saveState()
        end)
    end))

    -- ---------- Respawn ----------
    if lp.Character then hookCharacter(lp.Character) end

    local respawnConn = lp.CharacterAdded:Connect(function(char)
        hookCharacter(char)
        if not lastDesc then return end
        token += 1
        local myToken = token
        local hum = waitHumanoid(char, 10)
        char:WaitForChild("HumanoidRootPart", 10)
        if not hum then return end

        local t0 = os.clock()
        while not lp:HasAppearanceLoaded() and os.clock() - t0 < 5 do task.wait(0.1) end
        task.wait(0.4)

        if myToken ~= token or not lastDesc or lp.Character ~= char then return end
        setStatus("Chargement")
        local ok = applyAvatar(lastUserId, lastDesc, myToken)
        if myToken == token then setStatus(ok and "Appliqué ✓" or "Échec") end
    end)

    -- ---------- Restauration au lancement ----------
    task.spawn(function()
        local data = loadState()
        if not data then return end
        local startToken = token

        kOn, hOn = data.k == true, data.h == true
        refreshToggles()
        if not data.userId and not kOn and not hOn then return end

        local char = lp.Character or lp.CharacterAdded:Wait()
        waitHumanoid(char, 10)
        local t0 = os.clock()
        while not lp:HasAppearanceLoaded() and os.clock() - t0 < 5 do task.wait(0.1) end
        task.wait(0.5)
        if token ~= startToken then return end -- tu as déjà fait une action entre-temps

        if data.userId then
            box.Text = tostring(data.userId)
            applyUser(data.userId)
        else
            reapplyWithToggles()
        end
    end)

    -- Animation d'entrée
    panel.Position = UDim2.new(0, -PANEL_W, 0, OFFSET_Y)
    TS:Create(panel, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, OFFSET_X, 0, OFFSET_Y)
    }):Play()

    -- Cleanup
    local previousCleanup = _G.HelperOtherCleanup
    _G.HelperOtherCleanup = function()
        token += 1
        if respawnConn then respawnConn:Disconnect() end
        if charConn then charConn:Disconnect() end
        if gui and gui.Parent then gui:Destroy() end
        if previousCleanup then pcall(previousCleanup) end
    end
end
