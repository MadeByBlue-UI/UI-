            add(UIS.InputChanged:Connect(function(input)
                if not self.isOpen then return end
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local o = self.offset + Vector2.new(input.Delta.X, input.Delta.Y)
                    local lim = (self.radius or 150) * 1.25
                    if o.Magnitude > lim then o = o.Unit * lim end
                    self.offset = o
                    self:_update()
                elseif input.UserInputType == Enum.UserInputType.MouseWheel and #self.Pages > 1 then
                    local d = input.Position.Z > 0 and -1 or 1
                    self.page = ((self.page - 1 + d) % #self.Pages) + 1
                    self.sel, self._lastSel = nil, nil
                    self:_build(false)
                    self:_update()
                    snd(self, "rbxasset://sounds/switch.wav", 1.1, 0.5)
