                        if not toyRoot then continue end

                        -- D cale l g rement chaque instance pour  viter qu'elles se superposent
                        local offset = Vector3.new((i - 1) * 2.5, 0, 0)
                        local myTarget = targetPos + offset

                        -- BodyVelocity XZ only   Y laiss    la physique pour coller au sol
                        local bv = toyRoot:FindFirstChild("_TrackerBV")
                        if not bv then
                            bv = Instance.new("BodyVelocity")
                            bv.Name     = "_TrackerBV"
                            bv.MaxForce = Vector3.new(math.huge, 0, math.huge)  -- Y = 0 : physique normale
                            bv.Parent   = toyRoot
                        end

                        local id = tostring(toyRoot)
                        local smoothF = 1 - math.exp(-5 * dt)

                        if trackerMode == "Direct" then
                            local dir  = myTarget - toyRoot.Position
                            dir = Vector3.new(dir.X, 0, dir.Z)  -- ignore Y
                            local dist = dir.Magnitude
                            if dist > 0.3 then
                                bv.Velocity = dir.Unit * math.min(trackerSpeed, dist * 15)
                            else
                                bv.Velocity = Vector3.zero
                            end
                        else
                            -- Mode Chien : position liss e par instance
                            if not _dogPositions[id] then
                                _dogPositions[id] = toyRoot.Position
                            end
                            local flat = Vector3.new(myTarget.X, toyRoot.Position.Y, myTarget.Z)
                            _dogPositions[id] = _dogPositions[id]:Lerp(flat, smoothF)
                            local dir  = _dogPositions[id] - toyRoot.Position
                            local dist = dir.Magnitude
                            if dist > 0.2 then
                                bv.Velocity = dir.Unit * math.min(trackerSpeed, dist * 10)
                            else
                                bv.Velocity = Vector3.zero
                            end
                        end
                    end

                    -- SNO throttl  toutes les 2 secondes
                    _trackerSNOTimer = _trackerSNOTimer + dt
                    if _trackerSNOTimer >= 2 and _trackerSNO then
                        _trackerSNOTimer = 0
                        for _, toy in ipairs(toys) do
                            local toyRoot = toy:FindFirstChild("HoldPart")
                                or toy:FindFirstChildWhichIsA("BasePart")
                            if toyRoot then
                                pcall(function() _trackerSNO:FireServer(toyRoot, toyRoot.CFrame) end)
                            end
                        end
                    end
                end)
            end,
        })
    end
