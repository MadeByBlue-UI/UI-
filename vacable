                    for playerName, _ in pairs(AK_TARGET_Players) do
                        expectedPickaxes_T[playerName] = true
                    end
                    
                    -- Spawn initial
                    for playerName, _ in pairs(AK_TARGET_Players) do
                        local targetPlayer = Players:FindFirstChild(playerName)
                        if targetPlayer and AK_TARGET_Active then
                            SpawnAndAttachPickaxeTarget(targetPlayer)
                            task.wait(0.5)  -- Délai entre chaque spawn
                        end
                    end
                    
                    -- Monitoring
                    local lastCheck_T = 0
                    local checkInterval_T = 0.2
                    
                    local monitorConn_T = RunService.Heartbeat:Connect(function()
                        if not AK_TARGET_Active then return end
                        
                        local now = tick()
                        if now - lastCheck_T < checkInterval_T then return end
                        lastCheck_T = now
                        
                        local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                        if not inv then return end
                        
                        local foundPickaxes_T = {}
                        for _, pickaxe in pairs(inv:GetChildren()) do
                            if pickaxe.Name:match("^AK_Target_") and AK_TARGET_Active then
                                local playerName = pickaxe.Name:gsub("^AK_Target_", "")
                                
                                if not AK_TARGET_Players[playerName] then
                                    pcall(function() destroyRemAK_T:FireServer(pickaxe) end)
                                    continue
                                end
                                
                                local targetPlayer = Players:FindFirstChild(playerName)
                                
                                if targetPlayer and targetPlayer.Character then
                                    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    
                                    if targetHRP then
                                        foundPickaxes_T[playerName] = true
                                        
                                        if IsPlayerInPlot_T(targetPlayer) then
                                            pcall(function() destroyRemAK_T:FireServer(pickaxe) end)
                                            reattachCooldowns_T[pickaxe.Name] = nil
                                            continue
                                        end
                                        
                                        local pickaxePos = pickaxe:FindFirstChild("StickyPart") and pickaxe.StickyPart.Position or pickaxe:GetPivot().Position
                                        local distance = (pickaxePos - targetHRP.Position).Magnitude
                                        
                                        if distance > 15 then
                                            local pickaxeName = pickaxe.Name
                                            local lastRespawn = reattachCooldowns_T[pickaxeName] or 0
                                            if now - lastRespawn >= 0.45 then
                                                pcall(function() destroyRemAK_T:FireServer(pickaxe) end)
                                                task.spawn(function()
                                                    task.wait(0.1)
                                                    SpawnAndAttachPickaxeTarget(targetPlayer)
                                                    reattachCooldowns_T[pickaxeName] = tick()
                                                end)
                                            end
                                            continue
                                        end
                                        
                                        local lastReattach = reattachCooldowns_T[pickaxe.Name] or 0
                                        if now - lastReattach < 0.45 then continue end
                                        
                                        if not IsAttached_T(pickaxe) then
                                            local firePart = targetHRP:FindFirstChild("FirePlayerPart")
                                            local stickyPart = pickaxe:FindFirstChild("StickyPart")
                                            
                                            if firePart and stickyPart then
                                                pcall(function()
                                                    setOwnerAK_T:FireServer(stickyPart, stickyPart.CFrame)
                                                end)
                                                
                                                pcall(function()
                                                    stickyEvent_T:FireServer(stickyPart, firePart, STICK_CFRAME_T)
                                                end)
                                                
                                                reattachCooldowns_T[pickaxe.Name] = now
                                            end
                                        end
                                    end
                                else
                                    pcall(function() destroyRemAK_T:FireServer(pickaxe) end)
                                    reattachCooldowns_T[pickaxe.Name] = nil
                                    expectedPickaxes_T[playerName] = nil
                                    AK_TARGET_Players[playerName] = nil
                                end
                            end
                        end
                        
                        for playerName, _ in pairs(expectedPickaxes_T) do
                            if not foundPickaxes_T[playerName] and AK_TARGET_Players[playerName] then
                                local targetPlayer = Players:FindFirstChild(playerName)
                                if targetPlayer and targetPlayer.Character then
                                    if IsPlayerInPlot_T(targetPlayer) then continue end
                                    
                                    local pickaxeName = "AK_Target_" .. playerName
                                    local lastRespawn = reattachCooldowns_T[pickaxeName] or 0
                                    if now - lastRespawn >= 0.45 then
                                        task.spawn(function()
                                            SpawnAndAttachPickaxeTarget(targetPlayer)
                                            reattachCooldowns_T[pickaxeName] = tick()
                                        end)
                                    end
                                else
                                    expectedPickaxes_T[playerName] = nil
                                    AK_TARGET_Players[playerName] = nil
                                end
                            end
                        end
                    end)
                    
                    repeat task.wait(0.5) until not AK_TARGET_Active
                    
                    if monitorConn_T then monitorConn_T:Disconnect() end
                end)
            else
                notify("Anti-Kick", "Système CIBLE désactivé", 2)
                AK_TARGET_Active = false
                
                task.wait(0.15)
                local inv = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                if inv then
                    for _, item in pairs(inv:GetChildren()) do
                        if item.Name:match("^AK_Target_") then
                            pcall(function() destroyRemAK_T:FireServer(item) end)
                        end
                    end
                end
            end
        end,
    })
    
    -- Dropdown pour sélectionner un joueur
    function getPlayerListAK()
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player then
                table.insert(list, plr.DisplayName .. " (@" .. plr.Name .. ")")
