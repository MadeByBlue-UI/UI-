    ExtraFun:CreateToggle({
        Name = "🚶 Animated Figure",
        Flag = "AnimatedFigure",
        Default = false,
        Callback = function(v)
            animatedFigureActive = v
            if _G._FigureFreeJumpReset then _G._FigureFreeJumpReset() end
            
            -- Nettoyage
            if figureUpdateConn then
                figureUpdateConn:Disconnect()
                figureUpdateConn = nil
            end
            figureBodyCache = {}
            
            if not v then
                _G._FigureSpeedMult = 1
                if _G._FigureNoclipRestore then _G._FigureNoclipRestore(false) end   -- les toys retrouvent leurs collisions
                if _G._RideNCClear then _G._RideNCClear() end
                notify("Animated Figure", "❌ Désactivé", 2)
                return
            end
            
            notify("Animated Figure", "✅ Appuie sur F pour contrôler un toy (tête)", 4)
            
            -- Variables d'animation
            local walkPhase = 0
            local lastHeadPos = nil
            local ownershipTimer = 0
            local debugTimer = 0
            local lastNetworkUpdate = 0

            -- 🍑 TWERK (Stick Man) : penché en avant, mains sur les genoux, bassin qui rebondit.
            -- La tête contrôlée est aussi déplacée (penchée vers l'avant et abaissée) pour suivre la posture.
            local _EmoteX = { lastWritten = nil, lastBase = nil }  -- suivi de la tête déplacée par les emotes (Twerk, Dab, Disco, Robot, YMCA, Floss v3)

            local function _TwerkCore(fp, swing)
                local sin, abs = math.sin, math.abs
                local b = sin(fp)
                local hipX = 0.6 * sin(fp * 0.5) * swing                 -- léger balancement latéral
                local hipY = -9 - 1.8 - 0.9 * b * swing                  -- le bassin rebondit
                local hipD = -1.8 + 1.0 * sin(fp + 1.2) * swing          -- le bassin recule / avance (mouvement circulaire)
                local phi  = 52 + 5 * sin(fp + 2.2) * swing              -- inclinaison du buste (degrés, vers l'avant)
                return hipX, hipY, hipD, phi, b
            end

            local function _TwerkFlat(bodyFwd)
                local f = Vector3.new(bodyFwd.X, 0, bodyFwd.Z)
                if f.Magnitude < 0.01 then f = bodyFwd end
                return f.Unit
            end

            -- Décalage de la tête par rapport à sa position debout (monde)
            local function _TwerkHeadOffset(fp, swing, bodyFwd, cs)
                local hipX, hipY, hipD, phi = _TwerkCore(fp, swing)
                local r = math.rad(phi)
                local fwdAmt = hipD + 9 * math.sin(r)
                local yAmt = hipY + 9 * math.cos(r)
                return _TwerkFlat(bodyFwd) * (fwdAmt * cs) + Vector3.new(0, yAmt * cs, 0)
            end

            local function _StickTwerkPose(i, headPos, bodyRight, bodyFwd, cs, spread, height, fp, swing)
                local sin, cos, atan, rad, deg = math.sin, math.cos, math.atan, math.rad, math.deg
                local flat = _TwerkFlat(bodyFwd)
                local function P(lat, y, depth)
                    return headPos + bodyRight * (lat * cs) + Vector3.new(0, y * cs + height, 0) + flat * ((depth or 0) * cs)
                end
                local function RX(a) return CFrame.fromAxisAngle(bodyRight, rad(a)) end  -- + = bas du segment vers l'avant
                if i > 16 then return nil end

                local hipX, hipY, hipD, phi, b = _TwerkCore(fp, swing)
                local pr = rad(phi)
                local function spine(d) -- point du dos à la distance d du bassin
                    return hipX * (1 - d / 9), hipY + d * cos(pr), hipD + d * sin(pr)
                end

                if i == 1 then
                    local lx, ly, ld = spine(7.5)
                    return P(lx, ly, ld), RX(-phi)
                elseif i <= 4 then
                    local lx, ly, ld = spine(6 - (i - 2) * 2)
                    return P(lx, ly, ld), RX(-phi)
                elseif i <= 10 then
                    -- bras tendus des épaules vers les genoux (mains sur les genoux), avec un petit rebond
                    local armIdx = i - 4
                    local isLeft = armIdx <= 3
                    local side = isLeft and -1 or 1
                    local k = isLeft and (armIdx - 1) or (armIdx - 4)
                    local sx, sy, sd = spine(6)
                    sx = sx + side * 0.9 * spread
                    local kx, ky, kd = side * 2.5 * spread + hipX * 0.5, -12.3 + 0.35 * sin(fp + (side > 0 and 0 or math.pi)), 1.6
                    local t = (k + 0.7) / 3
                    local lat, y, depth = sx + (kx - sx) * t, sy + (ky - sy) * t, sd + (kd - sd) * t + 0.3 * sin(fp + k)
                    local dy = math.max(sy - ky, 0.5)
                    local rot = RX(-deg(atan((sd - kd) / dy))) * CFrame.Angles(0, 0, rad(side * deg(atan(math.abs(kx - sx) / dy))))
                    return P(lat, y, depth), rot
                else
                    -- jambes écartées et fléchies : hanche -> genou -> pied (pieds plantés)
                    local legIdx = i - 10
                    local isLeft = legIdx <= 3
                    local side = isLeft and -1 or 1
                    local k = isLeft and (legIdx - 1) or (legIdx - 4)
                    local lat, y, depth
                    if k == 0 then
                        lat, y, depth = hipX + side * 0.9 * spread, hipY, hipD
                    elseif k == 1 then
                        lat, y, depth = side * 2.5 * spread + hipX * 0.5, -12.3 + 0.35 * sin(fp + (side > 0 and 0 or math.pi)), 1.6
                    else
                        lat, y, depth = side * 3.2 * spread, -14, 0
                    end
                    local zr = (k == 0 and 40) or (k == 1 and 25) or 12
                    return P(lat, y, depth), CFrame.Angles(0, 0, rad(side * zr))
                end
            end

            -- 💃 DANSES SUPPLÉMENTAIRES (Stick Man, 13+ toys) : Disco, Robot, Dab, YMCA
            -- Pose décrite par des paramètres (angles en degrés : 0 = vers le bas, 90 = horizontal vers l'extérieur,
            -- 180 = vers le haut, >180 = croise au-dessus de la tête), puis convertie en positions de toys.
            local _StickDanceAnims = { ["Disco"] = true, ["Robot"] = true, ["Dab"] = true, ["YMCA"] = true }

            local function _DanceParams(anim, fp, swing)
                local sin, cos, abs, floor, max, min = math.sin, math.cos, math.abs, math.floor, math.max, math.min
                local function lerp(a, b, t) return a + (b - a) * t end
                local function smooth(t) t = max(0, min(1, t)); return t * t * (3 - 2 * t) end
                local P = { hipX = 0, dip = 0, lean = 0,
                    R = { 8, 8, 0 }, L = { 8, 8, 0 },          -- bras : { angle épaule, angle avant-bras, profondeur }
                    legR = { 10, 4, 0 }, legL = { 10, 4, 0 } } -- jambes : { cuisse, tibia, pied levé }

                if anim == "Disco" then
                    -- Le doigt pointé : bras tendu qui balance de la diagonale haute à la diagonale basse, l'autre main sur la hanche
                    local s1 = sin(fp)
                    -- balance de la diagonale basse (30°) à la diagonale haute (150°) sans jamais repasser dans le corps
                    local a = math.max(30, math.min(172, 90 + 60 * s1 * swing))
                    P.R = { a, a, 0 }
                    P.L = { 60, -50, 0 }
                    P.hipX = -0.9 * s1 * swing
                    P.lean = -P.hipX * 0.8
                    P.dip = 0.8 * abs(s1)
                    local pumpR = 14 + 12 * max(0, s1)
                    local pumpL = 14 + 12 * max(0, -s1)
                    P.legR = { pumpR, pumpR * 0.3, 0 }
                    P.legL = { pumpL, pumpL * 0.3, 0 }

                elseif anim == "Robot" then
                    -- Mouvements saccadés : snap rapide puis pause, angles droits
                    local KF = {
                        { R = { 90, 180 }, L = { 90, 0 } },
                        { R = { 90, 0 },   L = { 90, 180 } },
                        { R = { 90, 90 },  L = { 90, 90 } },
                        { R = { 0, 90 },   L = { 90, 180 } },
                        { R = { 90, 180 }, L = { 0, 90 } },
                        { R = { 0, 0 },    L = { 0, 0 } },
                    }
                    local t = fp * 0.45
                    local n = floor(t)
                    local e = smooth((t - n) * 3)
                    local k1, k2 = KF[(n % #KF) + 1], KF[((n + 1) % #KF) + 1]
                    P.R = { lerp(k1.R[1], k2.R[1], e), lerp(k1.R[2], k2.R[2], e), 0 }
                    P.L = { lerp(k1.L[1], k2.L[1], e), lerp(k1.L[2], k2.L[2], e), 0 }
                    local par = ((n + e) % 2) < 1 and 1 or -1
                    local ph = smooth((((t) % 1) * 3)) -- pas saccadé
                    local sh = ((n % 2 == 0) and 1 or -1)
                    P.hipX = 0.6 * sh * (1 - ph) + 0.6 * -sh * ph
                    P.legR = { 8, 3, (sh > 0) and 0.8 * ph or 0.8 * (1 - ph) }
                    P.legL = { 8, 3, (sh > 0) and 0.8 * (1 - ph) or 0.8 * ph }

                elseif anim == "Dab" then
                    -- Un dab toutes les ~2 secondes, en alternant les côtés
                    local t = fp / (2 * math.pi)
                    local cyc = floor(t)
                    local fr = t - cyc
                    local d = smooth(fr * 4) * smooth(1 - (fr - 0.5) * 5)
                    local ds = (cyc % 2 == 0) and 1 or -1      -- côté du bras tendu
                    local ext = { lerp(8, 138, d), lerp(8, 138, d), 0 }
                    local bent = { lerp(8, 95, d), lerp(8, 225, d), 1.2 * d }
                    if ds > 0 then P.R, P.L = ext, bent else P.L, P.R = ext, bent end
                    P.lean = -ds * 2.0 * d
                    P.headDx = -ds * 1.0 * d   -- la tête va vers le bras plié
                    P.headDy = -1.4 * d        -- et plonge dans le coude
                    P.hipX = ds * 0.4 * d
                    P.dip = 0.8 * d
                    P.legR = { 10 + 6 * d, 4 + 8 * d, 0 }
                    P.legL = { 10 + 6 * d, 4 + 8 * d, 0 }

                elseif anim == "YMCA" then
                    -- Y, M, C, A : une lettre par temps
                    local L = {
                        { R = { 145, 145 }, L = { 145, 145 } },   -- Y
                        { R = { 85, 205 },  L = { 85, 205 } },    -- M
                        { R = { 70, 20 },   L = { 150, 205 } },   -- C
                        { R = { 150, 210 }, L = { 150, 210 } },   -- A
                    }
                    local t = fp / math.pi
                    local n = floor(t)
                    local e = smooth((t - n) * 3.5)
                    local k1, k2 = L[(n % 4) + 1], L[((n + 1) % 4) + 1]
                    P.R = { lerp(k1.R[1], k2.R[1], e), lerp(k1.R[2], k2.R[2], e), 0 }
                    P.L = { lerp(k1.L[1], k2.L[1], e), lerp(k1.L[2], k2.L[2], e), 0 }
                    local bounce = abs(sin(fp * 2))
                    P.dip = 0.7 * bounce
                    P.legR = { 12, 5, 0 }
                    P.legL = { 12, 5, 0 }
                end
                return P
            end

            local function _StickDancePose(anim, i, headPos, bodyRight, bodyFwd, cs, spread, height, fp, swing)
                local sin, cos, atan, rad, deg = math.sin, math.cos, math.atan, math.rad, math.deg
                if i > 16 then return nil end
                local Pm = _DanceParams(anim, fp, swing)
                local function P(lat, y, depth)
                    return headPos + bodyRight * (lat * cs) + Vector3.new(0, y * cs + height, 0) + bodyFwd * ((depth or 0) * cs)
                end
                local hipY = -9 - Pm.dip
                local tiltRot = CFrame.Angles(0, 0, rad(-deg(atan(Pm.lean / 7.5))))
                local function torsoAt(d) return Pm.hipX + Pm.lean * d / 7.5, hipY + d end

                if i == 1 then
                    local lx, ly = torsoAt(7.5)
                    return P(lx, ly), tiltRot
                elseif i <= 4 then
                    local lx, ly = torsoAt(6 - (i - 2) * 2)
                    return P(lx, ly), tiltRot
                elseif i <= 10 then
                    local armIdx = i - 4
                    local isLeft = armIdx <= 3
                    local side = isLeft and -1 or 1
                    local k = isLeft and (armIdx - 1) or (armIdx - 4)
                    local A = isLeft and Pm.L or Pm.R
                    local a1, a2, dep = A[1], A[2], A[3]
                    local sx, sy = torsoAt(6)
                    sx = sx + side * 0.8 * spread
                    local lat, y, rotA
                    if k == 0 then
                        lat, y, rotA = sx + side * 1.5 * sin(rad(a1)), sy - 1.5 * cos(rad(a1)), a1
                    elseif k == 1 then
                        lat, y, rotA = sx + side * 3.4 * sin(rad(a1)), sy - 3.4 * cos(rad(a1)), a1
                    else
                        local ex, ey = sx + side * 3.4 * sin(rad(a1)), sy - 3.4 * cos(rad(a1))
                        lat, y, rotA = ex + side * 2.1 * sin(rad(a2)), ey - 2.1 * cos(rad(a2)), a2
                    end
                    return P(lat, y, dep * (k + 1) / 3), CFrame.Angles(0, 0, rad(side * rotA))
                else
                    local legIdx = i - 10
                    local isLeft = legIdx <= 3
                    local side = isLeft and -1 or 1
                    local k = isLeft and (legIdx - 1) or (legIdx - 4)
                    local Lg = isLeft and Pm.legL or Pm.legR
                    local aT, aS, lift = Lg[1], Lg[2], Lg[3]
                    local hx = Pm.hipX + side * 0.8 * spread
                    local lat, y, rotA
                    if k == 0 then
                        lat, y, rotA = hx, hipY, aT
                    elseif k == 1 then
                        lat, y, rotA = hx + side * 2.6 * sin(rad(aT)), hipY - 2.6 * cos(rad(aT)) + Pm.dip * 0.5 + lift * 0.5, aT
                    else
                        local kx, ky = hx + side * 2.6 * sin(rad(aT)), hipY - 2.6 * cos(rad(aT))
                        lat, y, rotA = kx + side * 2.6 * sin(rad(aS)), ky - 2.6 * cos(rad(aS)) + Pm.dip + lift, aS
                    end
                    return P(lat, y), CFrame.Angles(0, 0, rad(side * rotA))
                end
            end

            -- 🦴 SQUELETTE : nouvelles emotes (Moonwalk, Sprinkler, Squat, Applaudir, Pompes)
            -- Chaque emote décrit des points en coordonnées locales (x = droite, y = haut, z = devant) ; SkelPose convertit
            -- en positions + rotations de toys (1 cou, 3 torse, 2×3 bras, 2×3 jambes). La tête est placée via HeadOffset.
            _EmoteX.skelAnims = { ["Allongé"] = true, ["Moonwalk"] = true, ["Sprinkler"] = true, ["Squat"] = true, ["Applaudir"] = true, ["Pompes"] = true,
                                  ["Walk v2"] = true, ["Run v2"] = true, ["Chute"] = true, ["Assis"] = true, ["Assis chaise"] = true, ["Révérence"] = true, ["Boxe"] = true, ["Jogging sur place"] = true, ["Coups de pied"] = true, ["Tai-chi"] = true, ["Kazatchok"] = true, ["Saut de joie"] = true, ["Escrime"] = true, ["Saut"] = true, ["Vol"] = true, ["Coucou"] = true, ["Escalade"] = true,
                                  ["Grimper corde"] = true, ["Grimper échelle"] = true, ["Traversée (bloc)"] = true, ["Suspendu (barre)"] = true, ["Tractions"] = true, ["Rappel"] = true, ["Funambule"] = true, ["Zombie"] = true, ["Gangnam"] = true, ["Air guitar"] = true, ["Moulin à bras"] = true, ["Muscles"] = true, ["Surf"] = true, ["Ski"] = true, ["Sumo"] = true }
            _EmoteX.skelAnims["Ramper"] = true
            _EmoteX.skelAnims["Smash"] = true   -- 💥 Ground Smash (piloté par _G._FigureSmash.phase)
            _EmoteX.skelAnims["Bury"] = true    -- ⚰️ Enterrement : genou à terre + regard (piloté par _G._FigureBury)
            _EmoteX.wAnim = { ["Vol"] = true, ["Ramper"] = true }   -- poses déjà calculées en repère MONDE (pas de transformation Superman / bras de prise)
            _EmoteX.speedU = 0   -- vitesse horizontale lissée de la formation (en unités du bonhomme, mise à jour dans la boucle)

            -- IK à 2 segments (a -> b, longueurs l1/l2) : renvoie le coude/genou, plié vers `pole`
            function _EmoteX.IK(a, b, l1, l2, pole)
                local v = b - a
                local d = v.Magnitude
                local dir = (d > 1e-4) and (v / d) or Vector3.new(0, -1, 0)
                d = math.clamp(d, math.abs(l1 - l2) * 1.001 + 0.01, (l1 + l2) * 0.999)
                local x = (l1 * l1 - l2 * l2 + d * d) / (2 * d)
                local h = math.sqrt(math.max(l1 * l1 - x * x, 0))
                local pp = pole - dir * pole:Dot(dir)
                if pp.Magnitude < 1e-3 then pp = Vector3.new(0, 0, 1) - dir * dir.Z end
                if pp.Magnitude < 1e-3 then pp = Vector3.new(1, 0, 0) end
                return a + dir * x + pp.Unit * h
            end

            -- 🚶 MARCHE V2 / COURSE V2 : paramètres de démarche calculés à partir de la vitesse réelle (vu = unités/s)
            -- L = demi-longueur de foulée ; la cadence est déduite de L pour que le pied d'appui ne glisse pas au sol.
            function _EmoteX.GaitParams(anim, vu, swing)
                local isRun = (anim == "Run v2")
                local sw = math.min(swing or 1, 1.5)
                local t = math.clamp(vu / (isRun and 32 or 16), 0, 1.15)   -- 0 = arrêt, 1 = vitesse de référence
                local a = math.clamp(vu / 3, 0, 1)
                a = a * a * (3 - 2 * a)                                     -- fondu doux au démarrage / à l'arrêt
                local k = 0.35 + 0.65 * t
                if isRun then
                    return { isRun = true, duty = 0.38, a = a, t = t,
                        L = math.min(3.8 * k * sw * a, 4.2), lift = (1.8 + 2.2 * t) * a, bob = (0.5 + 0.7 * t) * a * (_animBlend.bounce or 1),
                        lean = (6 + 14 * t) * a, leanSide = (9 + 13 * t) * a, leanBack = (7 + 8 * t) * a,
                        sway = 0.2 * a, armAmp = (32 + 22 * t) * sw * a,
                        elbow = 78 * a, elbowSwing = 18 * a }
                end
                return { isRun = false, duty = 0.6, a = a, t = t,
                    L = math.min(3.0 * k * sw * a, 4.2), lift = (0.8 + 0.9 * t) * a, bob = (0.5 + 0.3 * t) * a * (_animBlend.bounce or 1),
                    lean = (3 + 3 * t) * a, leanSide = (7 + 7 * t) * a, leanBack = (5 + 5 * t) * a,
                    sway = 0.45 * a, armAmp = (22 + 10 * t) * sw * a,
                    elbow = 12 * a, elbowSwing = 14 * a }
            end

            -- Vitesse angulaire de la phase (rad/s) : plus tu vas vite, plus la cadence monte (le slider Animation Speed la multiplie)
            function _EmoteX.GaitOmega(anim, vu, swing, mul)
                local G = _EmoteX.GaitParams(anim, vu, swing)
                local w = math.pi * vu * G.duty / math.max(G.L, 0.6)
                return math.clamp(w * (mul or 1), 3, 24)
            end

            function _EmoteX.Skel(anim, fp, swing, spread)
                local V = Vector3.new
                local sin, cos, rad, floor, max, min, abs = math.sin, math.cos, math.rad, math.floor, math.max, math.min, math.abs
                local function smooth(t) t = max(0, min(1, t)); return t * t * (3 - 2 * t) end
                local function lerp(a, b, t) return a + (b - a) * t end
                local YF = -14.2                 -- sol (centre des toys de pied/main)
                local neck, hip, head
                local armFn, legFn
                local shX = 0.8                  -- écart latéral des épaules (Walk v2 / Run v2 l'élargissent)
                local function straightArm(S, dir)
                    dir = dir.Unit
                    local E = S + dir * 3.4
                    return E, E + dir * 2.1
                end
                -- 🌀 rotation d'un vecteur autour de l'axe X (droite) : poses acrobatiques (Salto, Culbute, Parachutiste)
                local function rx(v, p)
                    local c, s = cos(p), sin(p)
                    return V(v.X, v.Y * c - v.Z * s, v.Y * s + v.Z * c)
                end
                local function plantedLegs(footX, footZ, pole)
                    return function(side, H)
                        local F = V(side * footX * spread, YF, footZ or 0)
                        return _EmoteX.IK(H, F, 2.6, 2.6, pole or V(0, 0.2, 1)), F, (_animBlend.flatFeet and 0 or nil)
                    end
                end

                if anim == "Squat" then
                    -- Descente en squat : bassin en bas/arrière, buste penché, genoux devant, bras qui montent à l'horizontale
                    local a = min(swing, 1.5) * smooth((1 - cos(fp * 0.6)) / 2)
                    local drop, back = 3.2 * a, 2.2 * a
                    local phi = rad(min(38 * a, 60))
                    local dT = V(0, cos(phi), sin(phi))
                    hip = V(0, -9 - drop, -back)
                    neck = hip + dT * 7.5
                    head = hip + dT * 9
                    local th = rad(min(90 * a, 95))
                    armFn = function(side, S) return straightArm(S, V(side * 0.12, -cos(th), sin(th))) end
                    legFn = plantedLegs(1.0, 0, V(0, 0.3, 1))

                elseif anim == "Applaudir" then
                    -- Applaudissements devant la poitrine, la tête fait "oui" à chaque claquement
                    local g = (1 + sin(fp * 2)) / 2          -- 0 = mains jointes, 1 = mains écartées
                    local nod = 1 - g
                    hip = V(0, -9 - 0.25 * nod, 0)
                    neck = V(0, -1.5 - 0.45 * nod, 0.3 * nod)
                    head = V(0, -0.95 * nod, 0.8 * nod)
                    armFn = function(side, S)
                        local u = V(side * 0.35, -0.8, 0.45).Unit
                        local E = S + u * 3.4
                        return E, V(side * (-0.5 + 2.6 * g), -4.3, 3.0)
                    end
                    legFn = plantedLegs(0.9, 0)

                elseif anim == "Sprinkler" then
                    -- Sprinkler : une main derrière la tête, l'autre bras tendu qui avance par à-coups d'un côté à l'autre
                    local c = fp * 0.6
                    local n = floor(c)
                    local frac = c - n
                    local e = smooth(frac * 4)
                    local function tri(m) local r = m % 12; return r < 6 and r or 12 - r end
                    local p = lerp(tri(n), tri(n + 1), e) / 6
                    local psi = rad(lerp(5, 105, p))
                    local snap = sin(math.pi * min(1, frac * 4))
                    local dip = 0.45 * snap
                    hip = V(0.3, -9 - dip, 0)
                    neck = V(0.5, -1.5 - dip * 0.6, -0.3)
                    head = V(0.55, -dip * 0.7, -0.4)
                    local jitter = 0.15 * sin(frac * 25) * (1 - frac)
                    armFn = function(side, S)
                        if side > 0 then
                            return straightArm(S, V(sin(psi), 0.03 + jitter, cos(psi)))
                        end
                        local u = V(-0.8, 0.5, 0).Unit
                        return S + u * 3.4, head + V(-0.4, -0.3, -0.9)   -- main derrière la tête
                    end
                    legFn = plantedLegs(1.4, 0)

                elseif anim == "Moonwalk" then
                    -- Moonwalk : un pied glisse à plat vers l'arrière pendant que l'autre se lève et revient devant (alternance)
                    local sl = 1.3 * min(swing, 1.5)
                    local dip = 0.8 + 0.25 * abs(sin(fp))
                    hip = V(0, -9 - dip, 0)
                    neck = V(0, -1.5 - dip * 0.6, -0.6)
                    head = V(0, -dip * 0.6, -0.7)
                    armFn = function(side, S)
                        local th = rad(20) * sin(fp + (side > 0 and 0 or math.pi))
                        local u = V(side * 0.1, -cos(th), sin(th))
                        local f = V(side * 0.1, -cos(th + 0.45), sin(th + 0.45))
                        local E = S + u.Unit * 3.4
                        return E, E + f.Unit * 2.1
                    end
                    legFn = function(side, H)
                        local ph = ((fp + (side > 0 and math.pi or 0)) % (2 * math.pi)) / (2 * math.pi)
                        local z, lift
                        if ph < 0.5 then
                            z, lift = lerp(sl, -sl, ph / 0.5), 0
                        else
                            local q = (ph - 0.5) / 0.5
                            z, lift = lerp(-sl, sl, smooth(q)), 1.2 * sin(math.pi * q)
                        end
                        local F = V(side * 1.0 * spread, YF + lift, z)
                        return _EmoteX.IK(H, F, 2.6, 2.6, V(0, 0.1, 1)), F
                    end

                elseif anim == "Vol" then
                    -- 🦸 Superman : le corps est couché à l'horizontale. Ici l'axe vertical du squelette devient l'axe de vol
                    -- (+y = devant, z = vers le sol) ; voir _EmoteX.FlyPose. Les 2 bras sont tendus devant la tête (poings
                    -- presque joints), les jambes jointes derrière, qui ondulent à peine, et le corps "respire" légèrement.
                    local hov = sin(fp * 0.6)
                    local lk = _G._FigureLandKs or 0                 -- 🛬 0 = couché · 1 = debout (approche du sol)
                    shX = 1.4 - 0.6 * lk
                    -- 🏊 nage à l'arrêt (style vol créatif) : brasse lente, jambes qui ondulent, corps qui ondule
                    local swStyle = _G._FigureSwimStyle or "Brasse"
                    local lev = _G._FigureLevK or 0                  -- 🧍 part de lévitation dans la pose droite
                    local bkk = (_G._FigureBackK or 0) * lk          -- 🔙 S enfoncé : buste penché en arrière
                    local lvf = lk * lev                             -- poids de la lévitation · lk*(1-lev) = redressement d'atterrissage (pieds posés)
                    local tl = os.clock()
                    local phiB = -rad(20) * bkk                       -- inclinaison vers l'arrière (pivot = la tête, ancrée sur le toy de tête)
                    local hw = ((_G._FigureSwimHover ~= false and _G._FigureLevitate == false and swStyle ~= "Aucune") and math.min(_G._FigureHoverW or 0, 1) or 0) * (1 - lk)
                    local cyc = (os.clock() * 0.8 * (_G._FigureSwimSpd or 1)) % 1
                    local sw1 = 0.5 - 0.5 * cos(cyc * 2 * math.pi)                    -- 0 -> 1 -> 0 : mouvement des bras
                    local kc  = 0.5 - 0.5 * cos((cyc - 0.25) * 2 * math.pi)           -- coup de jambes décalé d'un quart de cycle
                    hip = V(0, -9 + 0.2 * sin(tl * 1.6) * lvf, 0.15 * hov * (1 - lk) + hw * 0.55 * sin(cyc * 2 * math.pi - 0.8))
                    neck = V(0, -1.5, 0.05 * hov * (1 - lk) + hw * 0.3 * sin(cyc * 2 * math.pi))
                    head = V(0, 0, 0)
                    if bkk > 0.001 then hip, neck = rx(hip, phiB), rx(neck, phiB) end   -- penché en arrière autour de la tête
                    armFn = function(side, S)
                        local Hd = V(side * 0.75, 2.7, 0.25 + 0.1 * hov)               -- poings devant la tête (vol)
                        if hw > 0.001 then
                            local pull
                            if swStyle == "Crawl" then
                                -- un bras après l'autre : tire sous le ventre vers l'arrière, revient par-dessus
                                local a = (cyc + (side > 0 and 0 or 0.5)) * 2 * math.pi
                                pull = V(side * 0.9, 0.3 + 2.3 * cos(a), 0.25 + 1.6 * sin(a))
                            elseif swStyle == "Flottement" then
                                pull = V(side * (1.7 + 0.5 * sin(cyc * 2 * math.pi)), 1.2, 0.5 + 0.35 * sin(cyc * 2 * math.pi + side))
                            else   -- Brasse
                                pull = V(side * (0.75 + 2.9 * sw1), 2.7 - 3.6 * sw1, 0.25 + 1.5 * sin(sw1 * math.pi))
                            end
                            Hd = Hd:Lerp(pull, hw)
                        end
                        if lk > 0 then
                            Hd = Hd:Lerp(V(side * 1.6, -8.2, 0.2), lk * (1 - lev))      -- atterrissage : bras qui redescendent le long du corps
                            -- 🧍 lévitation : bras détendus, légèrement écartés, qui dérivent comme en apesanteur
                            local Hl = V(side * (2.3 + 0.35 * sin(tl * 1.3 + side)), -6.6 + 0.45 * sin(tl * 1.7 + side * 1.3), 0.3 + 0.25 * sin(tl * 1.1 + side))
                            Hd = Hd:Lerp(Hl, lvf)
                        end
                        if bkk > 0.001 then Hd = rx(Hd, phiB) end
                        return _EmoteX.IK(S, Hd, 3.4, 2.1, V(side * 1, 0, -0.4)), Hd
                    end
                    legFn = function(side, H)
                        local fl = 0.3 * sin(fp * 2.2 + (side > 0 and 0 or math.pi)) * (1 - lk)
                        local F = V(side * 0.55 * spread, YF, fl)
                        if hw > 0.001 then
                            local sF
                            if swStyle == "Crawl" then   -- battements de jambes alternés, rapides
