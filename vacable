    pendingHL.OutlineTransparency = 0
    pendingHL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    pendingHL.Enabled = false
    pendingHL.Parent = fxFolder

    -- ---------------------------------------------------------------
    -- OWNERSHIP (PartOwner / SetNetworkOwner)
    -- ---------------------------------------------------------------
    local setOwnerEvent

    local function ownerValueObj(target)
        if not target or not target.Parent then return nil end
        if target:IsA("BasePart") then return target:FindFirstChild("PartOwner") end
        return target:FindFirstChild("PartOwner", true)
    end

    local function ownerNameOf(target)
        local po = ownerValueObj(target)
        if po and po.Value ~= "" then return po.Value end
        return nil
    end

    -- Part qui porte PartOwner (celle sur laquelle on prend l'ownership)
    local function ownershipPart(target)
        local po = ownerValueObj(target)
        if po and po.Parent and po.Parent:IsA("BasePart") then return po.Parent end
        if target:IsA("Model") then
            if target:FindFirstChildOfClass("Humanoid") then
                return target:FindFirstChild("Head") or getPrimary(target)
            end
            return target:FindFirstChild("SoundPart") or getPrimary(target)
        end
        return getPrimary(target)
    end

    -- Un autre joueur détient-il ce toy ?
    local function stolenBy(target)
        local n = ownerNameOf(target)
        if n and n ~= LP.Name and Players:FindFirstChild(n) then return n end
        return nil
    end

    local function claimOwnership(part)
        if not setOwnerEvent then
            local ge = RepStorage:FindFirstChild("GrabEvents")
            setOwnerEvent = ge and ge:FindFirstChild("SetNetworkOwner")
        end
        local hrp = getHRP()
        if not (setOwnerEvent and hrp and part and part.Parent) then return false end
        local po = part:FindFirstChild("PartOwner")
        if po and po.Value == LP.Name then return true end
        if (hrp.Position - part.Position).Magnitude <= S.claimRange then   -- portée réglable (Apex déclenche son TP à 22)
            pcall(function() setOwnerEvent:FireServer(part, part.CFrame) end)
        end
        return false
    end

    -- ---------------------------------------------------------------
    -- ANCRAGE / DÉSANCRAGE
    -- ---------------------------------------------------------------
    local function takeSnap(d)
        local s = {}
        for _, p in ipairs(d.parts) do
            if p.Parent then s[p] = p.CFrame end
        end
        return s
    end

    local function releaseTarget(target, destroyed)
        local d = entries[target]
        if not d then return end
        entries[target] = nil
        for i, t in ipairs(order) do
            if t == target then table.remove(order, i) break end
        end
        for _, c in ipairs(d.conns) do pcall(function() c:Disconnect() end) end
        if not destroyed then
            for _, p in ipairs(d.parts) do
                if p and p.Parent then p.Anchored = false end
            end
        end
        pcall(refreshVisual, target)
        pcall(setNoclip, target, false)   -- rend les collisions d'origine
        if d.bb then pcall(function() d.bb:Destroy() end) end
        pcall(function()
            if target.Parent then target:SetAttribute("IsAnchored", false) end
        end)
        selectedIdx = nil
        refreshList()
    end

    local function anchorTarget(target, silent)
        if not target or not target.Parent or entries[target] then return false end

        local parts = {}
        local function add(p)
            if p:IsA("BasePart") and not p.Anchored then
                p.Anchored = true
                table.insert(parts, p)
            end
        end
        add(target)
        for _, d in ipairs(target:GetDescendants()) do add(d) end
        if #parts == 0 then return false end

        local name = target.Name
        local data = { parts = parts, conns = {}, name = name, snapT = 0, cool = 0 }
        data.snapNew = takeSnap(data)
        data.snapOld = data.snapNew
        data.bb, data.tl = makeBillboard(target, name)

        -- Nouvelles parts ajoutées au modèle -> ancrées aussi
        table.insert(data.conns, target.DescendantAdded:Connect(function(d)
            if S.persist and d:IsA("BasePart") and not d.Anchored then
                d.Anchored = true
                table.insert(data.parts, d)
            end
        end))
        -- Objet supprimé -> nettoyage
        table.insert(data.conns, target.AncestryChanged:Connect(function(_, parent)
            if not parent then releaseTarget(target, true) end
        end))

        entries[target] = data
        table.insert(order, target)
        pcall(function() target:SetAttribute("IsAnchored", true) end)
        refreshVisual(target)
        if isMyToy(target) and ownerNameOf(target) ~= LP.Name then
            -- prise simple, uniquement si je suis à portée (jamais de téléportation ici)
            local op = ownershipPart(target)
            if op then claimOwnership(op) end
        end
        if not silent then playEffect(getPrimary(target)) end
        refreshList()
        return true
    end

    local function toggleTarget(target)
        if not target then
            say(S.toysOnly and "Ce n'est pas un toy" or "Objet invalide")
            return
        end
        if entries[target] then
            releaseTarget(target)
            say("Désancré : " .. target.Name)
        elseif anchorTarget(target) then
            say("Ancré : " .. target.Name)
        else
            say("Impossible d'ancrer cet objet")
        end
    end

    local function releaseAll()
        local count = #order
        local copy = table.clone(order)
        for _, t in ipairs(copy) do releaseTarget(t) end
        if count > 0 then say(count .. " objet(s) désancré(s)") end
    end

    local function releaseLast()
        local t = order[#order]
        if t then
            local n = t.Name
            releaseTarget(t)
            say("Dernier désancré : " .. n)
        else
            say("Aucun objet ancré")
        end
    end

    local function toggleHeld()
        local part = getHeldPart()
        if not part then say("Tu ne tiens rien") return end
        local t = resolveTarget(part)
        ignoreHeld = t   -- on ancre/désancre volontairement : pas de décrochage automatique
        toggleTarget(t)
    end

    local function toggleAimed()
        local t = aimedTarget()
        if not t then say("Aucun toy visé") return end
        toggleTarget(t)
    end

    -- ---------------------------------------------------------------
    -- REPRISE D'OWNERSHIP (si un joueur attrape mon toy ancré)
    --   1) si je suis à plus de X studs -> je me téléporte à côté
    --   2) je reprends l'ownership
    --   3) je remets le toy exactement comme il était (snapshot)
    --   4) je retourne là où j'étais
    -- ---------------------------------------------------------------
    local guardBusy = false

    -- Prise d'ownership rapide (à lancer dans une coroutine).
    --   * déjà à moi            -> rien à faire
    --   * à portée (réglable)   -> demandes à chaque frame ; si ça ne passe pas -> on passe à l'aller-retour
    --   * plus loin             -> aller-retour très court : la caméra reste figée et mes
    --                              déplacements pendant l'aller-retour sont conservés au retour
    -- (le serveur juge la distance d'après la position de mon perso, que mon client contrôle :
    --  un saut très bref est donc obligatoire, impossible de le faire "côté serveur" seulement)
    local function quickClaim(target)
        local hrp = getHRP()
        local op = target.Parent and ownershipPart(target)
        if not (hrp and op and op.Parent) then return false end
        if ownerNameOf(target) == LP.Name then return true end

        if (hrp.Position - op.Position).Magnitude <= S.claimRange then
            -- à portée : une demande par frame (comme Apex) ; si ça ne passe pas en ~8 frames,
            -- la portée réelle du serveur est plus courte que prévu -> on escalade vers l'aller-retour
            for _ = 1, 8 do
                claimOwnership(op)
                RunService.Heartbeat:Wait()
                if ownerNameOf(target) == LP.Name then return true end
            end
            hrp = getHRP()
            if not (hrp and op.Parent) then return false end
        end

        local cam = workspace.CurrentCamera
        local camType, camCF = cam.CameraType, cam.CFrame
        local home = hrp.Position
        local tpPos = op.Position + Vector3.new(2, 1, 0)
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = camCF
        hrp.CFrame = CFrame.new(tpPos) * (hrp.CFrame - hrp.Position)
        hrp.AssemblyLinearVelocity = Vector3.zero

        local got = false
        pcall(function()
            RunService.Heartbeat:Wait()   -- laisse partir ma nouvelle position vers le serveur
            RunService.Heartbeat:Wait()
            for _ = 1, 40 do
                local o2 = ownershipPart(target)
                if o2 then claimOwnership(o2) end   -- une demande par frame jusqu'à ce que ce soit pris
                RunService.Heartbeat:Wait()
                if ownerNameOf(target) == LP.Name then got = true break end
            end
        end)

        local h2 = getHRP()
        if h2 then
            local moved = h2.Position - tpPos   -- ce que j'ai marché pendant ce temps
            h2.CFrame = CFrame.new(home + moved) * (h2.CFrame - h2.Position)
            h2.AssemblyLinearVelocity = Vector3.zero
        end
        cam.CameraType = camType
        return got
    end
    _G._AnchQuickClaim = quickClaim   -- utilisé par le DiceSmall Spawner (prise d'ownership avec aller-retour éclair)

    local function reclaim(target, d, thief)
        if guardBusy or d.busy then return end
        guardBusy = true
        d.busy = true
        task.spawn(function()
            pcall(function()
                local snap = d.snapOld or d.snapNew
                local got = quickClaim(target)
                if entries[target] ~= d then return end
                if got then
                    if S.restoreSnap and snap then
                        for p, cf in pairs(snap) do
                            if p.Parent then
                                p.AssemblyLinearVelocity = Vector3.zero
                                p.AssemblyAngularVelocity = Vector3.zero
                                p.CFrame = cf
                                p.Anchored = true
                            end
                        end
                    end
                    d.snapNew = takeSnap(d)
                    d.snapOld = d.snapNew
                    say("Toy repris : " .. target.Name .. " (" .. thief .. ")")
                else
                    say("Reprise échouée : " .. target.Name)
                end
            end)
            d.busy = false
            d.cool = os.clock() + 0.4
            guardBusy = false
        end)
    end

    -- Prise d'ownership avec téléportation si besoin.
    -- File d'attente : plusieurs toys à reprendre = un seul aller-retour.
    local fetchQueue, fetchRunning = {}, false

    local function fetchWorker()
        if fetchRunning then return end
        fetchRunning = true
        task.spawn(function()
            while #fetchQueue > 0 do
                local target = table.remove(fetchQueue, 1)
                while guardBusy do task.wait(0.1) end
                pcall(quickClaim, target)
            end
            fetchRunning = false
        end)
    end

    fetchOwnership = function(target)
        if not target or table.find(fetchQueue, target) then return end
        table.insert(fetchQueue, target)
        fetchWorker()
    end

    -- Détecte quand quelqu'un attrape un de MES toys (état « volé » + flash rouge)
    local scanT = 0
    local function scanStolen(now)
        if not (S.flash or S.autoOwn) or now - scanT < 0.2 then return end
        scanT = now
        local subjects
        if S.flashAll or S.autoOwn then   -- tous mes toys, pas seulement les ancrés
            local folder = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
            subjects = folder and folder:GetChildren() or {}
        else
            subjects = table.clone(order)
        end
        for _, toy in ipairs(subjects) do
            local thief = isMyToy(toy) and stolenBy(toy) or nil
            local st = stolenState[toy]
            if thief then
                if not st or st.gone then
                    -- show : flash + notification seulement pour les toys ancrés/liés (ou tous si l'option est activée)
                    local show = S.flashAll or entries[toy] ~= nil or adj[toy] ~= nil
                    stolenState[toy] = { thief = thief, show = show, flashUntil = now + S.flashTime }
                    refreshVisual(toy)
                    if S.autoOwn and not entries[toy] then
                        fetchOwnership(toy)   -- tous les toys non ancrés ; les ancrés sont repris par reclaim()
                    end
                    if S.flash and show then say("⚠️ " .. thief .. " a attrapé " .. toy.Name) end
                end
            elseif st then
                st.gone = true
                if now >= st.flashUntil then
                    stolenState[toy] = nil
                    refreshVisual(toy)
                end
            end
        end
        for toy in pairs(stolenState) do
            if not toy.Parent then
                stolenState[toy] = nil
                refreshVisual(toy)
            end
        end
    end

    -- Semi-auto ownership : quand l'autre joueur lâche le toy -> réancrage + reprise d'ownership
    local function semiCheck()
        for target in pairs(semiPending) do
            if not target.Parent or entries[target] then
                semiPending[target] = nil           -- détruit, ou déjà réancré à la main
            elseif not stolenBy(target) then
                semiPending[target] = nil           -- lâché (ou à moi) : on le remet en place
                if anchorTarget(target, true) then
                    fetchOwnership(target)          -- TP rapide si je suis trop loin
                    say("Toy réancré : " .. target.Name)
                end
            end
        end
    end

    -- Un autre joueur tient un de mes toys ancrés (Auto Ownership coupé) : on le libère
    local function letGo(target, thief)
        releaseTarget(target)
        if S.semiOwn then
            semiPending[target] = true
            say(thief .. " tient " .. target.Name .. " : réancré dès qu'il le lâche")
        else
            say("Toy libéré : " .. target.Name .. " (" .. thief .. ")")
        end
    end

    local function runGuard()
        local now = os.clock()
        scanStolen(now)
        if next(semiPending) then semiCheck() end
        for _, target in ipairs(table.clone(order)) do
            local d = entries[target]
            if d and not d.busy then
                local thief = isMyToy(target) and stolenBy(target) or nil
                if thief then
                    if S.autoOwn then
                        if now >= d.cool then reclaim(target, d, thief) end
                    else
                        -- Auto Ownership coupé : on lâche le toy, l'autre joueur en fait ce qu'il veut
                        letGo(target, thief)
                    end
                elseif now - d.snapT >= 0.25 then
                    d.snapOld = d.snapNew or takeSnap(d)
                    d.snapNew = takeSnap(d)
                    d.snapT = now
                end
            end
        end
    end

    -- ---------------------------------------------------------------
    -- LIENS ENTRE TOYS (ils bougent ensemble, un trait les relie)
    -- ---------------------------------------------------------------
    local links     = {}   -- liste de { a, b, rel, beam, att0, att1 }
    -- adj : déclaré en haut (utilisé par les contours d'état)
    local linkConns = {}   -- [toy] = connexion AncestryChanged
    local lastPivot = {}   -- [toy] = CFrame
    local pending   = nil  -- toy source en attente du 2e

    local function pivotOf(t)
        if t:IsA("Model") then return t:GetPivot() end
        return t.CFrame
    end

    local function setPivot(t, cf)
        if t:IsA("Model") then t:PivotTo(cf) else t.CFrame = cf end
    end

    local function zeroVel(t)
        local p = getPrimary(t)
        if p then
            p.AssemblyLinearVelocity = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local function linkTargetOf(part)
        if typeof(part) ~= "Instance" then return nil end
        return toyRootOf(part)
    end

    local function dropFromAdj(t, l)
        local list = adj[t]
        if not list then return end
        for i, x in ipairs(list) do
            if x == l then table.remove(list, i) break end
        end
        if #list == 0 then
            adj[t] = nil
            lastPivot[t] = nil
            pcall(refreshVisual, t)
            if linkConns[t] then pcall(function() linkConns[t]:Disconnect() end) linkConns[t] = nil end
        end
    end

    local function removeLink(l)
        for i, x in ipairs(links) do
            if x == l then table.remove(links, i) break end
        end
        pcall(function() l.beam:Destroy() end)
        pcall(function() l.att0:Destroy() end)
        pcall(function() l.att1:Destroy() end)
        local g = l.group
        if g then
            for i, x in ipairs(g.links) do
                if x == l then table.remove(g.links, i) break end
            end
            if #g.links == 0 then
                for i, x in ipairs(groups) do
                    if x == g then table.remove(groups, i) break end
                end
            end
            refreshGroups()
        end
        dropFromAdj(l.a, l)
        dropFromAdj(l.b, l)
        refreshLinkCount()
    end

    local function unlinkToy(t)
        local list = adj[t]
        if not list then return 0 end
        local copy = table.clone(list)
        for _, l in ipairs(copy) do removeLink(l) end
        return #copy
    end

    local function unlinkAll()
        local n = #links
        for _, l in ipairs(table.clone(links)) do removeLink(l) end
        return n
    end

    local function ensureMember(t)
        if not linkConns[t] then
            linkConns[t] = t.AncestryChanged:Connect(function(_, parent)
                if not parent then unlinkToy(t) end
            end)
            if isMyToy(t) and ownerNameOf(t) ~= LP.Name then
                local op = ownershipPart(t)
                if op then claimOwnership(op) end   -- uniquement à portée, jamais de TP
            end
        end
        lastPivot[t] = pivotOf(t)
        refreshVisual(t)
    end

    local function createLink(a, b, group)
        if a == b then return false end
        for _, l in ipairs(adj[a] or {}) do
            if l.a == b or l.b == b then return false end
        end
        local pa, pb = getPrimary(a), getPrimary(b)
        if not (pa and pb) then return false end

        local a0 = Instance.new("Attachment")
        a0.Name = "AnchorLinkAtt"
        a0.Parent = pa
        local a1 = Instance.new("Attachment")
        a1.Name = "AnchorLinkAtt"
        a1.Parent = pb

        local bm = Instance.new("Beam")
        bm.Name = "AnchorLinkBeam"
        bm.Attachment0 = a0
        bm.Attachment1 = a1
        bm.FaceCamera = true
        bm.Segments = 1
        bm.Width0 = S.linkWidth
        bm.Width1 = S.linkWidth
        bm.LightEmission = 1
        bm.LightInfluence = 0
        bm.Color = ColorSequence.new(group and group.color or S.linkColor)
        bm.Transparency = NumberSequence.new(0.05)
        bm.Enabled = S.showLinks
        bm.Parent = fxFolder

        local l = { a = a, b = b, rel = pivotOf(a):ToObjectSpace(pivotOf(b)), beam = bm, att0 = a0, att1 = a1,
                    group = group, soft = (group ~= nil and group.soft) or false }
        if group then table.insert(group.links, l) end
        table.insert(links, l)
        adj[a] = adj[a] or {}
        table.insert(adj[a], l)
        adj[b] = adj[b] or {}
        table.insert(adj[b], l)
        ensureMember(a)
        ensureMember(b)
        refreshLinkCount()
        return true
    end

    local function restyleLinks()
        for _, l in ipairs(links) do
            if l.beam then
                l.beam.Color = ColorSequence.new(l.group and l.group.color or S.linkColor)
                l.beam.Width0 = S.linkWidth
                l.beam.Width1 = S.linkWidth
                l.beam.Enabled = S.showLinks
            end
        end
        restyleAll()
    end

    -- Toy tenu en main, sinon toy visé
    local function currentLinkTarget()
        local held = getHeldPart()
        if held then return linkTargetOf(held) end
        local p = aimedPart()
        if p then return linkTargetOf(p) end
        return nil
    end

    local function linkAction()
        local t = currentLinkTarget()
        if not t then say("Aucun toy tenu ou visé") return end
        if not pending or not pending.Parent then
            pending = t
            pendingHL.Adornee = t
            pendingHL.Enabled = true
            say("Lien : " .. t.Name .. " sélectionné. Prends/vise un 2e toy et rappuie.")
        elseif pending == t then
            pending = nil
            pendingHL.Enabled = false
            say("Lien annulé")
        else
            local a = pending
            pending = nil
            pendingHL.Enabled = false
            if createLink(a, t) then
                say("Reliés : " .. a.Name .. " ⇄ " .. t.Name)
            else
                say("Déjà reliés ou impossible")
            end
        end
    end

    local function unlinkAction()
        if pending then
            pending = nil
            pendingHL.Enabled = false
        end
        local t = currentLinkTarget()
        if not t then say("Aucun toy tenu ou visé") return end
        local n = unlinkToy(t)
        say(n > 0 and (n .. " lien(s) retiré(s) : " .. t.Name) or "Ce toy n'a aucun lien")
    end

    -- Propage le mouvement du toy "driver" vers tous les toys reliés
    -- ---- Suivi par forces (idée du script Apex) ----
    -- Un toy ancré/posé chez moi n'est pas simulé : les autres joueurs ne le voient pas bouger.
    -- Pendant qu'on tient un toy du groupe, les AUTRES toys sont donc décrochés et tirés
    -- par un BodyPosition + BodyGyro (pièce simulée par moi, donc répliquée), sans collision.
    local function eachPart(t, fn)
        if t:IsA("BasePart") then fn(t) end
        for _, d in ipairs(t:GetDescendants()) do
            if d:IsA("BasePart") then fn(d) end
        end
    end

    -- Noclip : coupe / rend les collisions de toutes les pièces d'un toy
    setNoclip = function(t, on)
        eachPart(t, function(p)
            if on then
                if noclipMem[p] == nil then noclipMem[p] = p.CanCollide end
                p.CanCollide = false
            elseif noclipMem[p] ~= nil then
                p.CanCollide = noclipMem[p]
                noclipMem[p] = nil
            end
        end)
    end

    local function moveWithForces(t, targetPivot)
        local part = getPrimary(t)
        if not (part and part.Parent) then return false end
        local fm = forceMovers[t]
        if not fm or not fm.bp.Parent then
            fm = {}
            fm.bp = Instance.new("BodyPosition")
            fm.bp.Name = "AnchorBP"
            fm.bp.P = 15000
            fm.bp.D = 200
            fm.bp.MaxForce = Vector3.new(5e6, 5e6, 5e6)
            fm.bp.Parent = part
            fm.bg = Instance.new("BodyGyro")
            fm.bg.Name = "AnchorBG"
            fm.bg.P = 15000
            fm.bg.D = 200
            fm.bg.MaxTorque = Vector3.new(5e6, 5e6, 5e6)
            fm.bg.Parent = part
            forceMovers[t] = fm
        end
        local want = targetPivot * pivotOf(t):ToObjectSpace(part.CFrame)
        fm.bp.Position = want.Position
        fm.bg.CFrame = want
        return true
    end

    local function prepFollower(t)
        eachPart(t, function(p)
            if collideMem[p] == nil then collideMem[p] = p.CanCollide end
            p.CanCollide = false
        end)
    end

    local function releaseFollower(t)
        local fm = forceMovers[t]
        if fm then
            pcall(function() fm.bp:Destroy() end)
            pcall(function() fm.bg:Destroy() end)
            forceMovers[t] = nil
        end
        eachPart(t, function(p)
            if collideMem[p] ~= nil then
                p.CanCollide = collideMem[p]
                collideMem[p] = nil
            end
        end)
    end

    local function propagate(driver)
        local visited = { [driver] = true }
        local queue = { driver }
        local qi = 1
        while qi <= #queue do
            local cur = queue[qi]
            qi = qi + 1
            local curCF = pivotOf(cur)
            for _, l in ipairs(adj[cur] or {}) do
                if l.soft then continue end
                local other, rel
                if l.a == cur then
                    other, rel = l.b, l.rel
                else
                    other, rel = l.a, l.rel:Inverse()
                end
                if other.Parent and not visited[other] then
                    visited[other] = true
                    table.insert(queue, other)
                    local target = curCF * rel
                    if lifted[other] and moveWithForces(other, target) then
                        -- tiré par des forces (visible par les autres joueurs)
                    else
                        setPivot(other, target)
                        zeroVel(other)
                    end
                end
            end
        end
        return visited
    end

    local function updateLinks()
        if next(adj) == nil then return end
        local driver = nil
        local held = getHeldPart()
        if held then
            local ht = toyRootOf(held)
            if ht and adj[ht] then driver = ht end
        end
        if not driver then
            for t in pairs(adj) do
                local lp = lastPivot[t]
                if lp and t.Parent and (pivotOf(t).Position - lp.Position).Magnitude > 0.2 then
                    driver = t
                    break
                end
            end
        end
        if driver then propagate(driver) end
        for t in pairs(adj) do
            if t.Parent then lastPivot[t] = pivotOf(t) end
        end
    end

    -- ---------------------------------------------------------------
    -- DÉTECTION INSTANTANÉE D'UN VOL (évènement, pas de sondage)
    -- Dès que le PartOwner d'un de mes toys prend le nom d'un autre joueur -> reprise tout de suite
    -- ---------------------------------------------------------------
    local theftConns, theftFolder, theftAdded = {}, nil, nil

    local function onTheft(toy)
        if not toy or not toy.Parent then return end
        for _, target in ipairs(order) do
            if toyRootOf(target) == toy then
                local d = entries[target]
                local thief = stolenBy(target)
                if d and thief and not d.busy then
                    if S.autoOwn then
                        if not guardBusy then reclaim(target, d, thief) end
                    else
                        letGo(target, thief)   -- libère tout de suite le toy ancré
                    end
                end
                return
            end
        end
        if S.autoOwn and stolenBy(toy) then fetchOwnership(toy) end
    end

    local function checkOwner(v)
        local val = v.Value
        if val ~= "" and val ~= LP.Name then
            local toy = toyRootOf(v)
            if toy and isMyToy(toy) then onTheft(toy) end
        elseif next(semiPending) then
            semiCheck()   -- le toy vient d'être lâché
        end
    end

    local function hookOwner(v)
        if theftConns[v] or v.Name ~= "PartOwner" or not v:IsA("ValueBase") then return end
        theftConns[v] = v.Changed:Connect(function() checkOwner(v) end)
        checkOwner(v)
    end

    local function hookFolder()
        local folder = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
        for v, c in pairs(theftConns) do
            if not v.Parent then c:Disconnect() theftConns[v] = nil end
        end
        if folder == theftFolder then return end
        if theftAdded then theftAdded:Disconnect() theftAdded = nil end
        for v, c in pairs(theftConns) do c:Disconnect() theftConns[v] = nil end
        theftFolder = folder
        if not folder then return end
        for _, v in ipairs(folder:GetDescendants()) do hookOwner(v) end
        theftAdded = folder.DescendantAdded:Connect(hookOwner)
    end
    hookFolder()

