                                        local numToys = #toys
                                        local shieldRadius = tornadoRadius
                                        local shieldHeight = tornadoHeight
                                        
                                        -- Répartition: 40% dôme avant, 30% cercle milieu, 30% arrière
                                        local frontToys = math.floor(numToys * 0.4)
                                        local middleToys = math.floor(numToys * 0.3)
                                        local backToys = numToys - frontToys - middleToys
                                        
                                        if i <= frontToys then
                                            -- 🛡️ DÔME AVANT (protection frontale dense)
                                            local domeProgress = (i - 1) / frontToys
                                            
                                            -- Grille hémisphérique devant
                                            local rows = 8
                                            local cols = 8
                                            local row = math.floor(domeProgress * rows)
                                            local col = (domeProgress * rows * cols) % cols
                                            
                                            local theta = (row / rows) * (math.pi / 2)  -- 0 à 90°
                                            local phi = (col / cols) * math.pi * 2  -- 0 à 360°
                                            
                                            local x = math.sin(theta) * math.cos(phi) * shieldRadius
                                            local y = shieldHeight + math.cos(theta) * shieldRadius * 0.5
                                            local z = math.sin(theta) * math.sin(phi) * shieldRadius * 0.8
                                            
                                            -- Seulement devant (z > -5)
                                            if z < -5 then z = -5 end
                                            
                                            targetPos = centerPos + (rotCFrame * Vector3.new(x, y, z))
                                        
                                        elseif i <= frontToys + middleToys then
                                            -- ⭕ CERCLE MILIEU (protection latérale)
                                            local circleIndex = i - frontToys
                                            local circleProgress = (circleIndex - 1) / middleToys
                                            
                                            local angle = circleProgress * math.pi * 2
                                            local x = math.cos(angle) * shieldRadius
                                            local y = shieldHeight
                                            local z = math.sin(angle) * shieldRadius * 0.6
                                            
                                            targetPos = centerPos + (rotCFrame * Vector3.new(x, y, z))
                                        
                                        else
