do
    local SBFBlock = Tabs.Toys:CreateBlock({ Name = "Snowball Farm", Side = "Left" })

    local RS_SBF      = game:GetService("ReplicatedStorage")
    local SpawnRemSBF = RS_SBF:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
    local DestroyRemSBF = RS_SBF:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
    local BombEventsSBF = RS_SBF:WaitForChild("BombEvents")

    local SBF_Active      = false
    local SBF_Amount      = 5
    local SBF_MaxSize     = 15
    -- Position de la zone de farm (zone de neige dans la map)
    local SBF_SpawnCF     = CFrame.new(-389, 228, 550,
        -0.309, 0.261, -0.914,
        0,     0.961,  0.274,
        0.950, 0.084, -0.297)
    local SBF_GrownBalls  = {}   -- soundParts des balls  taille max

    function SBF_CountBalls()
        local inv = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not inv then return 0 end
        local count = 0
        for _, v in ipairs(inv:GetChildren()) do
            if v.Name == "BallSnowball" then count = count + 1 end
        end
        return count
    end

    function SBF_Explode(soundPart)
        local model = soundPart.Parent
        if not model or not model.Parent then return end
        pcall(function()
            BombEventsSBF.BombExplode:FireServer({
                Hitbox          = soundPart,
                PositionPart    = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"),
                Radius          = 17.5,
                TimeLength      = 0.1,
                ExplodesByFire  = true,
                MaxForcePerStudSquared = -100,
                DestroysModel   = true,
                Model           = model,
            }, LocalPlayer.Character and LocalPlayer.Character.HumanoidRootPart.Position)
        end)
    end

    function SBF_Loop()
        SBF_GrownBalls = {}
        local inv = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not inv then return end

        -- coute les nouvelles balls pour les surveiller
        local conn = inv.ChildAdded:Connect(function(child)
            if not SBF_Active or child.Name ~= "BallSnowball" then return end
            task.spawn(function()
                -- Attend que la ball grandisse jusqu' SBF_MaxSize
                while SBF_Active and child and child.Parent do
                    local sp = child:FindFirstChild("SoundPart")
                    if sp and sp.Size.X >= SBF_MaxSize then
                        table.insert(SBF_GrownBalls, sp)
                        break
                    end
                    task.wait(0.5)
                end
            end)
        end)

        -- Spawn des balls en boucle jusqu' avoir SBF_Amount balls  taille max
        while SBF_Active do
            local char = LocalPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Nettoie les refs mortes
                for i = #SBF_GrownBalls, 1, -1 do
                    if not SBF_GrownBalls[i].Parent then
                        table.remove(SBF_GrownBalls, i)
                    end
                end

                if SBF_CountBalls() < SBF_Amount then
                    pcall(function()
                        SpawnRemSBF:InvokeServer("BallSnowball", SBF_SpawnCF, Vector3.new(0, 97.69, 0))
                    end)
                end

                if #SBF_GrownBalls >= SBF_Amount then
                    Library:Notify({ Title = "Snowball Farm", Content = SBF_Amount .. " balls prêtes à exploser !", Duration = 3 })
                    -- Explose toutes les balls grown
                    for _, sp in ipairs(SBF_GrownBalls) do
                        SBF_Explode(sp)
                        task.wait(0.05)
                    end
                    SBF_GrownBalls = {}
                    -- Détruit les restes
                    local inv2 = workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                    if inv2 then
                        for _, v in ipairs(inv2:GetChildren()) do
                            if v.Name == "BallSnowball" then
                                pcall(function() DestroyRemSBF:FireServer(v) end)
                            end
                        end
                    end
                    task.wait(1)
                end
            end
            task.wait(0.2)
        end

        conn:Disconnect()
    end

    SBFBlock:CreateSlider({
        Name    = "Nombre de snowballs",
        Flag    = "SBFAmount",
        Min     = 1,
        Max     = 20,
        Default = 5,
        Callback = function(v) SBF_Amount = v end
    })

    SBFBlock:CreateSlider({
        Name    = "Taille max avant explosion",
        Flag    = "SBFMaxSize",
        Min     = 5,
        Max     = 25,
        Default = 15,
        Callback = function(v) SBF_MaxSize = v end
    })

    SBFBlock:CreateToggle({
        Name    = "Auto Snowball Farm",
        Flag    = "SBFToggle",
        Default = false,
        Callback = function(v)
            SBF_Active = v
            if v then
                task.spawn(SBF_Loop)
                Library:Notify({ Title = "Snowball Farm", Content = "Dmarr  " .. SBF_Amount .. " balls cible", Duration = 3 })
            else
                Library:Notify({ Title = "Snowball Farm", Content = "Arrt.", Duration = 2 })
            end
        end
    })

    SBFBlock:CreateButton({
        Name     = "Exploser maintenant",
        Callback = function()
            for _, sp in ipairs(SBF_GrownBalls) do
                SBF_Explode(sp)
                task.wait(0.05)
            end
            SBF_GrownBalls = {}
            Library:Notify({ Title = "Snowball Farm", Content = "Explosion force ", Duration = 2 })
        end
    })
end

