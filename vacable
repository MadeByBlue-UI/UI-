-- TRANSLATOR  (Fun) — traduit tes messages et les messages entrants
-- =========================================================================
do
    local FunTranslator = Tabs.Fun:CreateBlock({ Name = "Translator", Side = "Left" })

    -- ── API Google Translate (même méthode que Translate script) ──
    local _Http = game:GetService("HttpService")
    local _TCS  = game:GetService("TextChatService")
    local _trGv, _trFsid, _trBl = nil, nil, nil
    local _trRid = math.random(1000, 9999)
    local _trRpc = "MkEWBc"
    local _trRoot = "https://translate.google.com/"
    local _trExec = "https://translate.google.com/_/TranslateWebserverUi/data/batchexecute"

    function _trReq(opt)
        local fn = (syn and syn.request) or (http and http.request) or http_request or request
        if fn then return fn(opt) end
        return _Http:RequestAsync(opt)
    end
    function _trQ(data)
        local s = ""
        for k, v in pairs(data) do
            if type(v) == "table" then
                for _, vv in pairs(v) do s = s .. "&" .. _Http:UrlEncode(k) .. "=" .. _Http:UrlEncode(vv) end
            else
                s = s .. "&" .. _Http:UrlEncode(k) .. "=" .. _Http:UrlEncode(v)
            end
        end
        return s:sub(2)
    end
    function _trGot(url, method, body)
        method = method or "GET"
        local res = _trReq({Url=url, Method=method, Headers={cookie="CONSENT=YES+"..(  _trGv or "")}, Body=body})
        return res
    end
    function _trInit()
        local ok, b = pcall(function() return (_trGot(_trRoot).Body or "") end)
        if not ok then return end
        _trFsid = b:match('"FdrFJe":"(.-)"')
        _trBl   = b:match('"cfb2h":"(.-)"')
    end
    task.spawn(_trInit)

    function translate(txt, tgt, src)
        -- Attend que l'init soit terminée (max 5s)
        local t0 = tick()
        while not _trFsid and tick() - t0 < 5 do task.wait(0.1) end
        if not _trFsid then return nil end
        _trRid = _trRid + 10000
        src = src or "auto"
        local data  = {{txt, src, tgt, true}, {nil}}
        local freq  = {{{_trRpc, _Http:JSONEncode(data), nil, "generic"}}}
        local url   = _trExec .. "?" .. _trQ{rpcids=_trRpc, ["f.sid"]=_trFsid, bl=_trBl, hl="en", _reqID=_trRid-10000, rt="c"}
        local body  = _trQ{["f.req"]=_Http:JSONEncode(freq)}
        local ok, res = pcall(function() return _trGot(url, "POST", body) end)
        if not ok then return nil end
        local ok2, out = pcall(function()
            local arr = _Http:JSONDecode((res.Body or ""):match("%[.-%]\n"))
            return _Http:JSONDecode(arr[1][3])
        end)
        if not ok2 then return nil end
        return out[2][1][1][6][1][1]
    end

    -- ── Langues disponibles ──
    local _trLangs = {
        ["Français"]   = "fr", ["Anglais"]    = "en", ["Espagnol"]   = "es",
        ["Allemand"]   = "de", ["Italien"]    = "it", ["Portugais"]  = "pt",
        ["Russe"]      = "ru", ["Japonais"]   = "ja", ["Chinois"]    = "zh-cn",
        ["Coréen"]     = "ko", ["Arabe"]      = "ar", ["Turc"]       = "tr",
        ["Polonais"]   = "pl", ["Néerlandais"]= "nl", ["Suédois"]    = "sv",
        ["Norvégien"]  = "no", ["Danois"]     = "da", ["Finnois"]    = "fi",
        ["Grec"]       = "el", ["Hébreu"]     = "iw", ["Hindi"]      = "hi",
        ["Thaïlandais"]= "th", ["Vietnamien"] = "vi", ["Indonésien"] = "id",
    }
    local _trLangNames = {}
    for k in pairs(_trLangs) do table.insert(_trLangNames, k) end
    table.sort(_trLangNames)

    -- ── État ──
    local _trOutActive  = false  -- traduit tes messages sortants
    local _trInActive   = false  -- traduit les messages entrants
    local _trTargetLang = "en"   -- langue cible pour sortants
    local _trYourLang   = "fr"   -- ta langue pour entrants
    local _trInConn     = nil
    local _trJumble     = false  -- mode jumble
