        for _, x in ipairs(fx.extras) do
            if x:IsA("Highlight") then
                x.FillColor = c
                x.OutlineColor = c
            elseif x:IsA("PointLight") then
                x.Color = c
            elseif x:IsA("Trail") then
                x.Color = ColorSequence.new(c)
            end
        end
    end

