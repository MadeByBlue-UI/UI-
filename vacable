    local function setupVehicleCheck_Apex()
        if AntiGucciState.vehicleCheckConnection then
            AntiGucciState.vehicleCheckConnection:Disconnect()
            AntiGucciState.vehicleCheckConnection = nil
        end
        
        local checkCounter = 0
        
        AntiGucciState.vehicleCheckConnection = RunService.Heartbeat:Connect(function()
            checkCounter = checkCounter + 1
            if checkCounter % 5 ~= 0 then return end
            if not AntiGucciState.autoGucciActive then return end
            if not AntiGucciState.hum then return end
            
            local seat = AntiGucciState.hum.SeatPart
            
            if seat and seat.Parent and seat.Parent.Name ~= 'Gucci' and seat.Parent.Name ~= 'CreatureBlobman' then
                AntiGucciState.hum.Sit = false
                task.wait(0.1)
                AntiGucciState.hum:ChangeState(Enum.HumanoidStateType.Jumping)
                task.wait(0.2)
                
                if AntiGucciState.autoGucciActive and not AntiGucciState.isRespawning then
                    task.spawn(startAntiGucci_Apex)
                end
            end
        end)
    end
    
    local function setupBlobCheck_Apex()
        if AntiGucciState.blobCheckConnection then
            AntiGucciState.blobCheckConnection:Disconnect()
            AntiGucciState.blobCheckConnection = nil
        end
        
        local checkCounter = 0
        
        AntiGucciState.blobCheckConnection = RunService.Heartbeat:Connect(function()
            checkCounter = checkCounter + 1
            if checkCounter % 10 ~= 0 then return end
            if not AntiGucciState.autoGucciActive then return end
            if not AntiGucciState.Blob or not AntiGucciState.Blob.Parent then
                if AntiGucciState.autoGucciActive and not AntiGucciState.isRespawning then
                    task.spawn(startAntiGucci_Apex)
                end
                return
            end
            if AntiGucciState.BHead then
                local partOwner = AntiGucciState.BHead:FindFirstChild('PartOwner')
                if partOwner and partOwner.Value ~= LocalPlayer.Name then
                    if AntiGucciState.autoGucciActive and not AntiGucciState.isRespawning then
                        task.spawn(startAntiGucci_Apex)
                    end
                end
            end
        end)
    end
    
