    -- =========================================================================
    -- 👻 TRANSPARENCE (LOCALE : seulement sur TON écran, via LocalTransparencyModifier -> les autres joueurs ne voient rien de changé)
    --   • Toys du corps  : tous les toys de la formation (sauf la tête)
    --   • Tête           : le toy de tête
    --   • Mon personnage : ton vrai personnage (réglable) ; il devient aussi transparent AUTOMATIQUEMENT en vue 1re personne
    -- =========================================================================
    _G._FigTransp = _G._FigTransp or { body = false, bodyA = 0.5, head = false, headA = 0.5, char = false, charA = 0.7, fpChar = true }
    do
        local TR = _G._FigTransp
        TR.applied = setmetatable({}, { __mode = "k" })   -- part -> dernière valeur appliquée (toys)
        TR.charOn = false
        local lastTick = 0

        local function collect(root, a, out)
            if not root or not root.Parent then return end
            if root:IsA("BasePart") then out[root] = a end
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("BasePart") then out[d] = a end
            end
        end

        -- toys (corps + tête) : 10 fois par seconde suffisent
        local function tickToys()
            local FP = _G._FigureFP
            local want = {}
            if TR.body then
                for _, part in ipairs(figureBodyCache) do
                    if part and part.Parent then
                        collect(part:FindFirstAncestorOfClass("Model") or part, TR.bodyA, want)
                    end
                end
            end
            if TR.head and not (FP and FP.on and FP.lastToy) then   -- en 1re personne la tête est déjà cachée par la vue
                collect(_G._FigureHeadToy, TR.headA, want)
            end
            for part, a in pairs(want) do
                if TR.applied[part] ~= a then
                    if pcall(function() part.LocalTransparencyModifier = a end) then TR.applied[part] = a end
                end
            end
            for part, v in pairs(TR.applied) do
                if want[part] == nil then
                    TR.applied[part] = nil
                    if v ~= 0 and part.Parent then pcall(function() part.LocalTransparencyModifier = 0 end) end
                end
            end
        end

        -- ton personnage : à chaque frame (le script de caméra de Roblox peut remettre la valeur)
        local function tickChar()
            local FP = _G._FigureFP
            local a = 0
            if TR.char then a = math.max(a, TR.charA) end
            if TR.fpChar and FP and FP.on and FP.lastToy then a = 1 end   -- 👁️ vue 1re personne : personnage invisible
            local ch = Player.Character
            if a > 0 and ch then
                TR.charOn = true
                for _, d in ipairs(ch:GetDescendants()) do
                    if d:IsA("BasePart") then d.LocalTransparencyModifier = a end
                end
            elseif TR.charOn then
                TR.charOn = false
                if ch then
                    for _, d in ipairs(ch:GetDescendants()) do
                        if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end
                    end
                end
            end
        end

        pcall(function() if TR.conn then TR.conn:Disconnect() end end)
        TR.conn = RunService.RenderStepped:Connect(function()
            pcall(tickChar)
            local now = os.clock()
            if now - lastTick >= 0.1 then
                lastTick = now
                pcall(tickToys)
            end
        end)
        _TrackConn(TR.conn)

        function _G._FigTranspStop()
            TR.body, TR.head, TR.char, TR.fpChar = false, false, false, false
            pcall(tickToys)
            pcall(tickChar)
            pcall(function() if TR.conn then TR.conn:Disconnect() end end)
        end
    end

