                                -- MODE SMOOTH : Lerp progressif
                                local lerpValue = 1.0 / figureSmoothness
                                if figureFormation == "Chien" or figureFormation == "Araignée Flippante" or figureFormation == "Oiseau Réaliste" or figureAnimationMode == "Twerk" or figureAnimationMode == "Floss v3" or _StickDanceAnims[figureAnimationMode] or _EmoteX.skelAnims[figureAnimationMode] or _EmoteX.poseActive or _EmoteX.curAnim == "Chute" or _EmoteX.curAnim == "Saut" or _EmoteX.curAnim == "Vol" or _EmoteX.curAnim == "Coucou" or _EmoteX.curAnim == "Escalade" or _EmoteX.curAnim == "Walk v2" or _EmoteX.curAnim == "Run v2" then lerpValue = math.max(lerpValue, 0.6) end  -- rebond net
                                if isSupermanMode then lerpValue = 1 end   -- ✈️ en vol : le corps colle à la tête (aucun retard, même à grande vitesse)
                                if _isWave then lerpValue = 1 end   -- vague : placement direct
                                if (os.clock() - (_G._FigureFlyBoost or -9)) < 0.4 then lerpValue = 1 end   -- 🛠️ départ du vol : toys collés à leur place
                                if _holdArm then lerpValue = 1 end   -- bras qui tient un joueur : collé à sa pose (aucun retard)
                                if _G._FigIntro and _G._FigIntro.t0 then lerpValue = math.max(lerpValue, 0.5) end   -- 🎬 intro : les toys suivent leur trajectoire sans traîner
                                part.CFrame = part.CFrame:Lerp(targetCF, lerpValue)
                            else
                                -- MODE LOCK : TP direct (net, pas de smooth)
                                part.CFrame = targetCF
                            end
                            
                            part.AssemblyLinearVelocity = Vector3.zero
                            
                            if _G._FigureNoclip then _G._FigureNoclipApply(part) end
                            
                            -- Claim ownership + sync réseau (seulement toutes les 0.5s)
                            local _wn = false
                            if isSupermanMode then   -- ✈️ vol : on reprend / resynchronise les toys du corps ~8x par seconde pour qu'ils suivent la tête
                                _G._FigureFlyNet = _G._FigureFlyNet or {}
                                local _ft = os.clock()
                                if _ft - (_G._FigureFlyNet[i] or 0) > 0.06 then _G._FigureFlyNet[i] = _ft; _wn = true end
                            end
                            if _isWave then   -- vague : on (re)prend le toy tout de suite puis toutes les 0.1 s
                                local _nt = os.clock()
                                if _nt - (_animBlend.waveNet[i] or 0) > 0.1 then _animBlend.waveNet[i] = _nt; _wn = true end
                            end
                            if (os.clock() - (_G._FigureFlyBoost or -9)) < 0.4 then _wn = true end   -- 🛠️ départ du vol : resynchro réseau immédiate
                            if (shouldUpdateNetwork or _wn) and not _G._FigureGripBusy() then
                                SNO:FireServer(part, part.CFrame)
                            end
                        end)
                    end
                end
                -- 🪵 pallet(s) en main : placées JUSTE APRÈS l'écriture des toys (même frame que la main -> aucun décalage ni vibration)
                do
                    local _FGp = _G._FigGrab
                    if _FGp and _FGp.palPost then pcall(_FGp.palPost, dt) end
                end
            end)
        end
    })
    
    -- =====================================================================================================================
    -- 🎲 DICESMALL SPAWNER + 📋 PANNEAU D'ÉTAT DU STICK MAN
    -- · chaque « DiceSmall » spawn 8 studs AU-DESSUS de toi (le serveur accepte, l'ownership aussi), puis on prend son ownership et il est
    --   téléporté à la position de stockage exacte (104, -8, -510). 16 dés, un par un, très vite, où que tu sois dans la map
    -- · notification « DiceSmall Spawner 16/16 » à la fin
    -- · les dés restent EXCLUS de la formation tant que la tête n'existe pas : tu fais spawn la tête, tu te mets dedans,
    --   et les dés rejoignent le Stick Man tout seuls (la formation prend déjà tous les toys de l'inventaire sauf la tête)
    -- · panneau d'état (déplaçable) + aperçu de la zone (marqueur + dés surlignés) + aperçu caméra
    -- Tout est dans un do...end + la table _G._FigDice (aucune variable locale en plus pour le reste du script).
    -- =====================================================================================================================
    _G._FigDice = _G._FigDice or {}
    do
        local Players = game:GetService("Players")
        local RunSvc  = game:GetService("RunService")
        local REP     = game:GetService("ReplicatedStorage")
        local LP      = Players.LocalPlayer
        local DS      = _G._FigDice
        DS.pos   = Vector3.new(104, -8, -510)
        DS.want  = 25          -- 📦 25 DiceSmall en stockage (16 de base + 9 extras : les bras qui tiennent un joueur s'en servent pour combler les trous)
        DS.name  = "DiceSmall"
        DS.list  = DS.list or {}
        DS.gap   = DS.gap or 0
        if DS.hold == nil then DS.hold = true end
        if DS.panelOn == nil then DS.panelOn = true end
        DS.busy, DS.cancel, DS.state = false, false, "Inactif"
        DS.hl = {}
        DS.stored, DS.cc, DS.ownT = {}, {}, 0
        DS.got, DS.pending = 0, 0          -- dés reçus pendant la session / dés en cours de stockage
        DS.delay = DS.delay or 120         -- ms d'attente entre deux spawns (réglable)

        local function invFolder() return workspace:FindFirstChild(LP.Name .. "SpawnedInToys") end
        local function excl()
            _G._FigureExclude = _G._FigureExclude or setmetatable({}, { __mode = "k" })
            return _G._FigureExclude
        end
        local function headOk() local h = _G._formRefPart; return h ~= nil and h.Parent ~= nil end
        local function rootOf(m)
            return m:FindFirstChild("SoundPart") or m:FindFirstChild("HoldPart") or m:FindFirstChild("Main") or m:FindFirstChildWhichIsA("BasePart", true)
        end

        -- nombre de dés encore présents (nettoie la liste)
        function DS.alive()
            local keep = {}
            for _, m in ipairs(DS.list) do if m and m.Parent then keep[#keep + 1] = m end end
            DS.list = keep
            return #keep
        end

        -- 📦 STOCKAGE : le dé spawn sous toi -> on prend son ownership -> il est téléporté à la position de stockage exacte,
        -- en noclip, et maintenu là jusqu'à ce que la tête arrive
        local function grabEv()
            local ge = REP:FindFirstChild("GrabEvents")
            return ge and ge:FindFirstChild("SetNetworkOwner")
        end

        local function slotOf(m)           -- position de stockage de ce dé (écart vertical optionnel entre les dés)
            return DS.pos + Vector3.new(0, DS.gap * ((table.find(DS.list, m) or 1) - 1), 0)
        end

        local function moveTo(m, r)        -- téléporte le dé (on est owner) si il n'est pas déjà sur son emplacement
            local target = slotOf(m)
            if (r.Position - target).Magnitude > 2 then
                pcall(function()
                    m:PivotTo(CFrame.new(target))
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end

        -- =====================================================================================================================
        -- 🎲 GESTIONNAIRE DES DÉS (même logique que la formation d'Animated Figure : une boucle PAR FRAME sur tous les dés)
        --   · pas à moi + à portée (20 studs) -> SetNetworkOwner (1 demande / 0,05 s)         [= reprise auto du bloc Animated Figure]
        --   · pas à moi + trop loin           -> _G._AnchFetch (aller-retour éclair, caméra figée, retour)
        --   · à moi                           -> part.CFrame posée à l'emplacement + vitesses à zéro (+ ownership entretenue)
        --   · on ne déplace JAMAIS un dé qui n'est pas à moi (sinon le TP serait local seulement et l'aller-retour irait au mauvais endroit)
        -- Contour automatique : 🟡 en attente d'ownership · 🟠 à moi, en route · 🟢 en place · 🔴 ownership refusée (> 6 s)
        -- =====================================================================================================================
        DS.ctl, DS.ol = {}, {}

        function DS.outline(m, col)
            local h = DS.ol[m]
            if not (h and h.Parent) then
                h = Instance.new("Highlight")
                h.Name = "FigDiceOutline"
                h.FillTransparency, h.OutlineTransparency = 0.65, 0
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Adornee = m
                h.Parent = m
                DS.ol[m] = h
            end
            h.FillColor, h.OutlineColor = col, col
        end

        function DS.clearOutlines()
            for _, h in pairs(DS.ol) do pcall(function() h:Destroy() end) end
            DS.ol, DS.ctl = {}, {}
        end

        -- enregistre le dé (appelé dès son apparition) : noclip + contour jaune, le reste est fait par DS.step à chaque frame
        function DS.store(m)
            DS.stored[m] = os.clock()
            for _, q in ipairs(m:GetDescendants()) do
                if q:IsA("BasePart") and DS.cc[q] == nil then DS.cc[q] = q.CanCollide; q.CanCollide = false end
            end
            DS.outline(m, Color3.fromRGB(255, 220, 60))
        end

        function DS.step()
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local ge = REP:FindFirstChild("GrabEvents")
            local sno = ge and ge:FindFirstChild("SetNetworkOwner")
            local now = os.clock()
            DS.tok = math.min(30, (DS.tok or 30) + (now - (DS.tokT or now)) * 30)   -- recharge du budget de demandes (30 / s)
            DS.tokT = now
            local yellow, orange, green, red = Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 140, 30), Color3.fromRGB(70, 230, 100), Color3.fromRGB(255, 70, 70)
            for _, m in ipairs(DS.list) do
                local t0 = DS.stored[m]
                if t0 and m.Parent then
                    local r = rootOf(m)
                    if r then
                        local c = DS.ctl[m]
                        if not c then c = { claimT = 0, fetchT = 0 }; DS.ctl[m] = c end
                        -- 🔒 VÉRIFICATION D'OWNERSHIP des dés déjà en place : s'il n'est plus à moi depuis > 1 s (volé / perdu), il repasse en « reprise »
                        if c.done and now - (c.chkT or 0) > 0.5 then
                            c.chkT = now
                            local po0 = m:FindFirstChild("PartOwner", true)
                            if po0 ~= nil and po0.Value == LP.Name then
                                c.lost = nil
                            else
                                c.lost = c.lost or now
                                if now - c.lost > 1 then
                                    c.done, c.lost = false, nil
                                    c.redo = (c.redo or 0) + 1
                                    DS.stored[m] = now          -- le contour repart de « en attente » (jaune), plus de rouge instantané
                                    t0 = now
                                end
                            end
                        end
                        if not c.done then   -- (déjà arrivé à l'emplacement ET à moi : on le laisse libre, il peut bouger / traîner)
                        local po = m:FindFirstChild("PartOwner", true)
                        local mine = po ~= nil and po.Value == LP.Name
                        local target = slotOf(m)
                        local at = (r.Position - target).Magnitude <= 2
                        if mine and at then c.done = true end   -- 1re arrivée confirmée : plus aucun forçage ensuite
                        if mine then
                            if not at then
                                pcall(function()
                                    r.CFrame = CFrame.new(target)
                                    r.AssemblyLinearVelocity = Vector3.zero
                                    r.AssemblyAngularVelocity = Vector3.zero
                                    m:PivotTo(CFrame.new(target))
                                end)
                            end
                            if sno and now - c.claimT > 0.5 then c.claimT = now; pcall(function() sno:FireServer(r, r.CFrame) end) end
                        else
                            if hrp and (hrp.Position - r.Position).Magnitude <= 20 then
                                -- budget global (30 demandes/s max pour tous les dés) : jamais de spam qui sature la remote de grab
                                if sno and now - c.claimT > 0.05 and (DS.tok or 0) >= 1 then DS.tok = DS.tok - 1; c.claimT = now; pcall(function() sno:FireServer(r, r.CFrame) end) end
                            elseif _G._AnchFetch and now - c.fetchT > 1 then
                                c.fetchT = now
                                pcall(_G._AnchFetch, m)
                            end
                        end
                        DS.outline(m, (mine and at) and green or (mine and orange) or ((now - t0 > 6) and red or yellow))
                        end   -- fin du « if not c.done »
                    end
                end
            end
        end

        function DS.keep() end   -- (remplacé par DS.step, appelé à chaque frame plus bas)

        -- 🔒 RAPPORT D'OWNERSHIP : combien de DiceSmall (stockage + inventaire + plot) sont vraiment à moi côté serveur (PartOwner = mon pseudo) ?
        -- fix = true : les dés qui ne sont pas à moi sont redemandés (à portée) ou ramenés avec l'aller-retour éclair (trop loin)
        function DS.report(fix)
            local seen, all = {}, {}
            local function add(m) if m and m.Parent and not seen[m] and m.Name == DS.name then seen[m] = true; all[#all + 1] = m end end
            for _, m in ipairs(DS.list) do add(m) end
            for _, fld in ipairs({ invFolder(), DS.home() }) do
                if fld then for _, c in ipairs(fld:GetChildren()) do add(c) end end
            end
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            local ge = REP:FindFirstChild("GrabEvents")
            local sno = ge and ge:FindFirstChild("SetNetworkOwner")
            local mine, none, stolen, fixed, fetched = 0, 0, {}, 0, 0
            for _, m in ipairs(all) do
                local r = rootOf(m)
                local po = m:FindFirstChild("PartOwner", true)
                local who = po and po.Value
                if who == LP.Name then
                    mine = mine + 1
                else
                    if who and who ~= "" then stolen[who] = (stolen[who] or 0) + 1 else none = none + 1 end
                    if fix and r then
                        if hrp and sno and (hrp.Position - r.Position).Magnitude <= 20 then
                            pcall(function() sno:FireServer(r, r.CFrame) end); fixed = fixed + 1
                        elseif _G._AnchFetch and fetched < 2 then
                            fetched = fetched + 1; pcall(_G._AnchFetch, m)
                        end
                    end
                end
            end
            local parts = {}
            for who, n in pairs(stolen) do parts[#parts + 1] = n .. " à " .. who end
            local msg = "🔒 " .. mine .. "/" .. #all .. " DiceSmall à toi"
            if none > 0 then msg = msg .. " · " .. none .. " sans owner" end
            if #parts > 0 then msg = msg .. " · " .. table.concat(parts, ", ") end
            if fix and (fixed + fetched) > 0 then msg = msg .. " · reprise de " .. (fixed + fetched) end
            notify("DiceSmall Ownership", msg, 5)
            return mine, #all
        end

        -- fin du stockage : plus d'exclusion, collisions d'origine, la formation les récupère
        function DS.releaseAll()
            local ex = _G._FigureExclude
            local n = 0
            for _, m in ipairs(DS.list) do
                if ex and ex[m] then ex[m] = nil; n = n + 1 end
                DS.stored[m] = nil
            end
            for q, v in pairs(DS.cc) do pcall(function() if q.Parent then q.CanCollide = v end end) end
            DS.cc = {}
            DS.clearOutlines()
            return n
        end

        -- 📍 COMME APEX : le spawn se calcule depuis le PlayerCharacterLocationDetector (PCLD = la position de toi que le serveur connaît),
        -- avec un décalage de 14 studs en haut / 20 studs sur le côté (jamais pile au-dessus de toi).
        function DS.pcld(hrp)
            local p = DS._pcld
            if p and p.Parent and (p.Position - hrp.Position).Magnitude <= 6 then return p end
            DS._pcld = nil
            for _, v in ipairs(workspace:GetChildren()) do
                if v.Name == "PlayerCharacterLocationDetector" and v:IsA("BasePart") and (v.Position - hrp.Position).Magnitude <= 2.5 then
                    DS._pcld = v
                    return v
                end
            end
        end
        -- offsets essayés dans l'ordre (tous tirés d'Apex) : si un spawn échoue, on passe au suivant
        DS.offsets = { Vector3.new(0, 14, 20), Vector3.new(0, 20, 15), Vector3.new(5, 10, 20), Vector3.new(0, 12, 15) }
        -- 🏠 si tu es dans TON plot, le toy apparaît dans workspace.PlotItems.PlotN (et pas dans SpawnedInToys)
        function DS.home()
            local plots, items = workspace:FindFirstChild("Plots"), workspace:FindFirstChild("PlotItems")
            if not (plots and items) then return nil end
            for i = 1, 5 do
                local pl = plots:FindFirstChild("Plot" .. i)
                local sg = pl and pl:FindFirstChild("PlotSign")
                local ow = sg and sg:FindFirstChild("ThisPlotsOwners")
                if ow then
                    for _, v in ipairs(ow:GetChildren()) do
                        if v.Value == LP.Name then return items:FindFirstChild("Plot" .. i) end
                    end
                end
            end
        end

        -- 🔎 VÉRIFICATION : tout dé qui est vraiment loin de sa position (15 studs ou plus) est SUPPRIMÉ, tout doublon DiceSmall dans la zone aussi,
        -- et on rend le nombre de dés manquants pour que le spawn en refasse exactement ce qu'il faut.
        -- grace : les dés stockés depuis moins de `grace` secondes (encore en route) ne sont pas jugés.
        function DS.verify(grace)
            grace = grace or 0
            local now = os.clock()
            local mt = REP:FindFirstChild("MenuToys")
            local rm = mt and mt:FindFirstChild("DestroyToy")
            local keep, bad, extra = {}, {}, 0
            for _, m in ipairs(DS.list) do
                if m and m.Parent then
                    local r = rootOf(m)
                    local c = DS.ctl[m]
                    local young = DS.stored[m] and now - DS.stored[m] < grace and not (c and c.done)
                    if young or (r and (r.Position - slotOf(m)).Magnitude < 15) then keep[#keep + 1] = m else bad[#bad + 1] = m end
                end
            end
            -- doublons : DiceSmall dans la zone de stockage qui ne sont pas dans la liste
            local home = DS.home()
            for _, fld in ipairs({ invFolder(), home }) do
                if fld then
                    for _, c in ipairs(fld:GetChildren()) do
                        if c.Name == DS.name and not table.find(DS.list, c) then
                            local r = rootOf(c)
                            if r and (r.Position - DS.pos).Magnitude <= 10 then bad[#bad + 1] = c; extra = extra + 1 end
                        end
                    end
                end
            end
            -- trop de dés dans la liste : on supprime l'excédent
            while #keep > DS.want do bad[#bad + 1] = table.remove(keep) end
            for _, m in ipairs(bad) do
                if rm then pcall(function() rm:FireServer(m) end) end
                DS.stored[m], DS.ctl[m] = nil, nil
                if _G._FigureExclude then _G._FigureExclude[m] = nil end
                local h = DS.ol[m]; if h then pcall(function() h:Destroy() end); DS.ol[m] = nil end
            end
            DS.list = keep
            return #bad, math.max(DS.want - #keep, 0), extra
        end

        function DS.start(isRepair)
            if not isRepair then DS.round = 0 end
            if DS.busy then notify("DiceSmall Spawner", "Spawn déjà en cours…", 2) return end
            local inv = invFolder()
            local mt = REP:FindFirstChild("MenuToys")
            local remote = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
            if not (inv and remote) then notify("DiceSmall Spawner", "❌ Inventaire ou remote de spawn introuvable", 3) return end
            if DS.alive() >= DS.want then notify("DiceSmall Spawner", DS.want .. "/" .. DS.want .. " ✅ (déjà prêts)", 3) return end
            DS.busy, DS.cancel, DS.said, DS.state = true, false, false, "Spawn en cours"
            -- session : TOUT DiceSmall qui apparaît pendant le spawn est pris en charge (liste + exclusion + stockage), même s'il arrive
            -- en retard. Avant, un dé arrivé après le délai d'attente restait là où il était : c'était le dé « devant toi ».
            local pre, seen = {}, {}
            local home = DS.home()
            for _, c in ipairs(inv:GetChildren()) do pre[c] = true end
            if home then for _, c in ipairs(home:GetChildren()) do pre[c] = true end end
            if DS.hold then _G._FigDiceSnap, _G._FigDiceBusy = pre, true end
            DS.got, DS.pending, DS.ownFail = 0, 0, 0
            local function onAdd(c)
                if c.Name ~= DS.name or pre[c] or seen[c] then return end
                seen[c] = true
                DS.got = DS.got + 1
                DS.list[#DS.list + 1] = c
                if DS.hold then
                    excl()[c] = true
                    DS.pending = DS.pending + 1
                    task.spawn(function()
                        pcall(DS.store, c)
                        DS.pending = DS.pending - 1
                    end)
                end
            end
            local sess = inv.ChildAdded:Connect(onAdd)
            local sess2 = home and home.ChildAdded:Connect(onAdd)
            task.spawn(function()
                pcall(function()
                    local fails = 0
                    while not DS.cancel and DS.alive() < DS.want and fails < 8 do
                        -- dans le plot de quelqu'un d'autre : le spawn est refusé, on attend d'en sortir (max 5 s)
                        local ip, iop = LP:FindFirstChild("InPlot"), LP:FindFirstChild("InOwnedPlot")
                        if ip and iop and ip.Value and not iop.Value then
                            local tp = tick()
                            repeat task.wait(0.1) until not ip.Value or iop.Value or tick() - tp > 5 or DS.cancel
                            if ip.Value and not iop.Value then notify("DiceSmall Spawner", "❌ Sors du plot d'un autre joueur pour spawn", 4) break end
                        end
                        local cs = LP:FindFirstChild("CanSpawnToy")
                        if cs and not cs.Value then
                            local t0 = tick()
                            repeat task.wait(0.03) until cs.Value or tick() - t0 > 3 or DS.cancel
                        end
                        if DS.cancel then break end
                        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                        if not hrp then break end
                        local g0 = DS.got
                        -- spawn comme Apex : (PCLD ou HRP).CFrame * (0, 14, 20) ; si ça échoue, on essaie l'offset suivant
                        local ref = DS.pcld(hrp) or hrp
                        local cf = ref.CFrame * CFrame.new(DS.offsets[(fails % #DS.offsets) + 1])
                        task.spawn(function() pcall(function() remote:InvokeServer(DS.name, cf, Vector3.zero) end) end)
                        local t0 = tick()
                        while DS.got == g0 and tick() - t0 < 2.5 and not DS.cancel do task.wait() end
                        if DS.got > g0 then
                            fails = 0
                            -- les temps : on attend que ce dé soit bien parti au stockage avant d'en spawn un autre
                            local t1 = tick()
                            while DS.pending > 0 and tick() - t1 < 1.6 and not DS.cancel do task.wait(0.03) end
                            task.wait((DS.delay or 120) / 1000)
                        else
                            fails = fails + 1
                        end
                    end
                end)
                -- les retardataires (arrivés après le dernier spawn) sont encore captés un court instant
                task.wait(DS.hold and 1.0 or 0.3)
                sess:Disconnect()
                if sess2 then sess2:Disconnect() end
                local tw = tick()
                while DS.pending > 0 and tick() - tw < 2 do task.wait(0.05) end
                _G._FigDiceBusy = false
                local n = DS.alive()
                DS.busy = false
                DS.state = (n >= DS.want) and "Terminé" or (DS.cancel and "Annulé" or "Incomplet")
                pcall(DS.keep); task.wait(0.4)                         -- remet en place les dés que le serveur aurait placés ailleurs
                -- 🔎 vérification : attend (max 8 s) que chaque dé soit arrivé, supprime ceux qui ne sont pas à la position + les doublons,
                -- puis relance un spawn pour retrouver EXACTEMENT le bon nombre (3 tentatives max)
                if DS.hold and not DS.cancel and not headOk() then
                    local tv = tick()
                    while tick() - tv < 8 do
                        local allDone = true
                        for _, m in ipairs(DS.list) do
                            local c = DS.ctl[m]
                            if m.Parent and not (c and c.done) then allDone = false break end
                        end
                        if allDone then break end
                        task.wait(0.2)
                    end
                    local nbad, nmiss, nextra = DS.verify(0)
                    if nbad > 0 or nmiss > 0 then
                        if (DS.round or 0) < 3 then
                            DS.round = (DS.round or 0) + 1
                            notify("DiceSmall Spawner", "🔎 Vérification : " .. nbad .. " supprimé(s)" .. (nextra > 0 and (" (dont " .. nextra .. " doublon)") or "") .. ", " .. nmiss .. " à refaire (essai " .. DS.round .. "/3)", 4)
                            DS.start(true)
                            return
                        else
                            notify("DiceSmall Spawner", "⚠️ Vérification : impossible d'obtenir exactement " .. DS.want .. " dés en place (3 essais)", 5)
                        end
                    else
                        DS.round = 0
                    end
                    n = DS.alive()
                end
                local off = 0
                for _, m in ipairs(DS.list) do
                    local r = rootOf(m)
                    if r and (r.Position - DS.pos).Magnitude > 8 then off = off + 1 end
                end
                if n >= DS.want then
