        TrollExtra:CreateSlider({
            Name = "Snake Smooth",
            Flag = "SnakeSmooth",
            Min = 1,
            Max = 20,
            Default = 8,
            Callback = function(v)
                snakeSmooth = v
            end,
        })

        TrollExtra:CreateToggle({
            Name = "Coconut Snake",
            Flag = "CoconutSnake",
            Default = false,
            Callback = function(Value)
                _G.CoconutSnakeEnabled = Value

                if not Value then 
                    -- Arrête le contrôle d'objet si actif
                    if _G._OC_State and _G._OC_State.active then
                        -- Appelle la fonction stop du Object Control
                        if OC_Stop then pcall(OC_Stop) end
                    end
                    return 
                end

                task.spawn(function()
                    local Me = game:GetService("Players").LocalPlayer
                    local RS2 = game:GetService("ReplicatedStorage")
                    local SetNetworkOwner = RS2.GrabEvents.SetNetworkOwner
                    local SpawnToy = RS2.MenuToys.SpawnToyRemoteFunction
                    local DestroyToy = RS2.MenuToys.DestroyToy
                    
                    local SnakePositions = {}
                    local MaxHistory = 200
                    local Damping = 100
                    local HeadCoconut = nil
                    local OtherCoconuts = {}

                    -- 1. Spawne la première coconut (la tête)
                    local Character = Me.Character
                    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
                    
                    if not Root then 
                        _G.CoconutSnakeEnabled = false
                        return 
                    end

                    -- MODE BIGGER : Vérifie si on est dans un plot owner
                    function CheckForHome()
                        if not workspace.PlotItems.PlayersInPlots:FindFirstChild(Me.Name) then
                            return false
                        end

                        for _, v in pairs(workspace.Plots:GetChildren()) do
                            local sign = v:FindFirstChild("PlotSign")
                            local owners = sign and sign:FindFirstChild("ThisPlotsOwners")

                            if owners then
                                for _, b in pairs(owners:GetChildren()) do
                                    if b.Value == Me.Name then
                                        local folder = workspace.PlotItems:FindFirstChild(v.Name)
                                        if folder then
                                            return true, folder, v  -- Retourne aussi le Plot model
                                        end
                                    end
                                end
                            end
                        end

                        return false
                    end
                    
                    local isInPlot, plotFolder, plotModel = CheckForHome()
                    local biggerModeActive = (snakeMode == "Bigger" and isInPlot)
                    
                    -- Spawn la coconut tête
                    local spawnCF
                    if biggerModeActive then
                        -- MODE BIGGER : TP HORS du plot pour spawner le leader là-bas
                        local originalPos = Root.CFrame
                        -- Calcule position hors plot (50 studs devant)
                        local outsidePlotPos = Root.CFrame * CFrame.new(0, 0, -50)
                        
                        -- TP temporairement hors plot
                        Root.CFrame = outsidePlotPos
                        task.wait(0.1)
                        
                        -- Spawn leader à cette position (hors plot)
                        spawnCF = Root.CFrame * CFrame.new(0, 2, 0)
                        SpawnToy:InvokeServer("FoodCoconut", spawnCF, Vector3.zero)
                        task.wait(0.3)
                        
                        -- TP de retour dans le plot
                        Root.CFrame = originalPos
                        task.wait(0.2)
                    else
                        -- MODE NORMAL : Spawn près du joueur
                        spawnCF = Root.CFrame * CFrame.new(0, 2, -3)
                        SpawnToy:InvokeServer("FoodCoconut", spawnCF, Vector3.zero)
                        task.wait(0.5)
                    end

                    -- 2. Trouve la coconut et active le contrôle dessus
                    -- Cherche dans SpawnedInToys OU dans PlotItems (pour les plots)
                    function FindMyToyFolder()
                        local boolik, house = CheckForHome()
                        local inv = workspace:FindFirstChild(Me.Name .. "SpawnedInToys")
                        
                        if biggerModeActive then
                            -- MODE BIGGER : Leader toujours dans SpawnedInToys (hors plot)
                            return inv
                        elseif boolik and house then
                            return house
                        elseif not workspace.PlotItems.PlayersInPlots:FindFirstChild(Me.Name) and inv then
                            return inv
                        end
                        
                        return nil
                    end
                    
                    local Folder = FindMyToyFolder()
                    if not Folder then 
                        _G.CoconutSnakeEnabled = false
                        return 
                    end

                    -- Cherche la coconut qu'on vient de spawner
                    local targetCoconut = nil
                    for _, toy in ipairs(Folder:GetChildren()) do
                        if toy.Name == "FoodCoconut" then
                            targetCoconut = toy
                            break
                        end
                    end

                    if not targetCoconut then
                        _G.CoconutSnakeEnabled = false
                        return
                    end

                    -- Récupère la SoundPart de cette coconut
                    local headPart = targetCoconut:FindFirstChild("SoundPart")
                    if not headPart then
                        _G.CoconutSnakeEnabled = false
                        return
                    end

                    -- Active le contrôle sur cette coconut via Object Control
                    if OC_Start then
                        pcall(function() OC_Start(targetCoconut) end)
                        task.wait(0.3)
                    end

                    HeadCoconut = targetCoconut

                    -- 3. Boucle principale
                    while _G.CoconutSnakeEnabled do
                        Character = Me.Character
                        Root = Character and Character:FindFirstChild("HumanoidRootPart")

                        if not Root then
                            task.wait(0.1)
                            continue
                        end

                        Folder = FindMyToyFolder()

                        if not Folder then
                            task.wait(0.1)
                            continue
                        end

                        -- Vérifie que la tête existe toujours
                        if not HeadCoconut or not HeadCoconut.Parent then
                            break
                        end

                        headPart = HeadCoconut:FindFirstChild("SoundPart")
                        if not headPart or not headPart.Parent then
                            break
                        end

                        -- Ajoute la position de la tête à l'historique
                        table.insert(SnakePositions, 1, headPart.CFrame)
                        while #SnakePositions > MaxHistory do
                            table.remove(SnakePositions)
                        end

                        -- Récupère toutes les autres coconuts
                        table.clear(OtherCoconuts)
                        
                        if biggerModeActive then
                            -- MODE BIGGER : Cherche les coconuts DANS LE PLOT
                            if plotFolder then
                                for _, Toy in ipairs(plotFolder:GetChildren()) do
                                    if Toy.Name == "FoodCoconut" and Toy ~= HeadCoconut then
                                        table.insert(OtherCoconuts, Toy)
                                    end
                                end
                            end
                        else
                            -- MODE NORMAL : Cherche dans le même folder que la tête
                            for _, Toy in ipairs(Folder:GetChildren()) do
                                if Toy.Name == "FoodCoconut" and Toy ~= HeadCoconut then
                                    table.insert(OtherCoconuts, Toy)
                                end
                            end
                        end

                        -- Spawne plus de coconuts si nécessaire
                        if #OtherCoconuts < snakeLength - 1 then  -- -1 car la tête compte aussi
                            -- Limite le spawn pour éviter de dépasser la limite du jeu
                            local totalCoconuts = #OtherCoconuts + 1 -- +1 pour la tête
                            if totalCoconuts < snakeLength then
                                task.spawn(function()
                                    if biggerModeActive then
                                        -- MODE BIGGER : Spawn DANS LE PLOT
                                        -- Le joueur est déjà dans le plot, donc spawn directement
                                        if Root and Root.Parent then
                                            -- Spawn au centre du plot (où est le joueur)
                                            local spawnPos = Root.CFrame * CFrame.new(
                                                math.random(-10, 10),  -- Aléatoire X
                                                5,                      -- 5 studs au-dessus
                                                math.random(-10, 10)   -- Aléatoire Z
                                            )
                                            SpawnToy:InvokeServer("FoodCoconut", spawnPos, Vector3.zero)
                                        end
                                    else
                                        -- MODE NORMAL : Spawn sous la coconut leader
                                        if headPart and headPart.Parent then
                                            local spawnPos = headPart.CFrame * CFrame.new(0, -10, 0)
                                            SpawnToy:InvokeServer("FoodCoconut", spawnPos, Vector3.zero)
                                        else
                                            -- Fallback : spawne près du personnage
                                            SpawnToy:InvokeServer("FoodCoconut", Root.CFrame * CFrame.new(-5, 0, 10), Vector3.zero)
                                        end
                                    end
                                end)
                                task.wait(0.2) -- Délai entre chaque spawn (augmenté pour mode Bigger)
                            end
                        end

                        -- Déplace chaque coconut suiveur
                        for i, Coconut in ipairs(OtherCoconuts) do
                            if i > snakeLength then break end

                            local Part = Coconut:FindFirstChild("SoundPart")
                            local HoldPart = Coconut:FindFirstChild("HoldPart")
                            local Rigid = HoldPart and HoldPart:FindFirstChild("RigidConstraint")
                            local PartOwner = Part and Part:FindFirstChild("PartOwner")

                            if Part and HoldPart and Rigid then
                                -- Calcule l'index dans l'historique
                                local historyIndex = math.floor(i * snakeSpacing * 3)
                                historyIndex = math.clamp(historyIndex, 1, #SnakePositions)

                                if SnakePositions[historyIndex] then
                                    if PartOwner and PartOwner.Value == Me.Name then
                                        local targetCF = SnakePositions[historyIndex]
                                        local targetPos = targetCF.Position
                                        
                                        -- Vérifie si la coconut vient de spawner (distance > 20 studs)
                                        local dist = (Part.Position - targetPos).Magnitude
                                        local justSpawned = dist > 20
                                        
                                        -- Si vient de spawner, TP instantanément
                                        if justSpawned then
                                            Part.CFrame = targetCF
                                            Part.Velocity = Vector3.zero
                                            Part.AssemblyLinearVelocity = Vector3.zero
                                        else
                                            -- Sinon utilise la méthode sélectionnée
                                            
                                            -- === MÉTHODE 1: CFrame Direct (DÉFAUT) ===
                                            if snakeMethod == "CFrame Direct" then
                                                -- Supprime BodyVelocity si présent
                                                local bv = Part:FindFirstChild("_SnakeBV")
                                                if bv then bv:Destroy() end
                                                
                                                -- Mini TP avec Lerp rapide pour smooth visuel
                                                Part.CFrame = Part.CFrame:Lerp(targetCF, 0.5)
                                                Part.Velocity = Vector3.zero
                                                Part.AssemblyLinearVelocity = Vector3.zero

                                            -- === MÉTHODE 2: BodyVelocity Fast ===
                                            elseif snakeMethod == "BodyVelocity Fast" then
                                                local bv = Part:FindFirstChild("_SnakeBV")
                                                if not bv then
                                                    bv = Instance.new("BodyVelocity")
                                                    bv.Name = "_SnakeBV"
                                                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                                    bv.Parent = Part
                                                end
                                                local dir = targetPos - Part.Position
                                                if dist > 0.5 then
                                                    bv.Velocity = dir.Unit * 150
                                                else
                                                    bv.Velocity = Vector3.zero
                                                end

                                            -- === MÉTHODE 3: Lerp Position ===
                                            elseif snakeMethod == "Lerp Position" then
                                                local bv = Part:FindFirstChild("_SnakeBV")
                                                if bv then bv:Destroy() end
                                                -- Lerp smooth vers la position
                                                Part.CFrame = Part.CFrame:Lerp(targetCF, 0.15)
                                                Part.Velocity = Vector3.zero
                                            end
                                        end
                                    else
                                        SetNetworkOwner:FireServer(Part, Part.CFrame)
                                    end

                                    if Rigid.Attachment1 then
                                        -- NE PAS détruire les coconuts du snake !
                                        -- Déconnecte juste l'attachment au lieu de destroy
                                        pcall(function()
                                            Rigid.Attachment1 = nil
                                        end)
                                    end

                                    for _, PartObj in ipairs(Coconut:GetChildren()) do
                                        if PartObj:IsA("BasePart") then
                                            PartObj.CanCollide = false
                                            PartObj.CanQuery = false
                                            if PartObj.Transparency ~= 1 then
                                                PartObj.Transparency = 0
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        task.wait(0.01)
                    end

                    -- Nettoie les BodyVelocity à la fin
                    local inv = workspace:FindFirstChild(Me.Name .. "SpawnedInToys")
                    if inv then
                        for _, toy in ipairs(inv:GetChildren()) do
                            if toy.Name == "FoodCoconut" then
                                local part = toy:FindFirstChild("SoundPart")
                                if part then
                                    local bv = part:FindFirstChild("_SnakeBV")
                                    if bv then bv:Destroy() end
                                end
                            end
                        end
                    end
                end)
            end
        })

        -- Toggle Zigzag pour le Snake
        local zigzagActive = false
        local zigzagDelay = 0.6

        TrollExtra:CreateSlider({
            Name = "Zigzag Delay",
            Flag = "ZigzagDelay",
            Min = 0.1,
            Max = 2,
            Default = 0.6,
            Callback = function(v)
                zigzagDelay = v
            end,
        })

        TrollExtra:CreateToggle({
            Name = "Snake Zigzag",
            Flag = "SnakeZigzag",
            Default = false,
            Callback = function(v)
                _G.SnakeZigzagEnabled = v
                _G.SnakeZigzagDelay = zigzagDelay

                if not v then 
                    _G._SnakeZigzagDir = 0
                    return 
                end

                task.spawn(function()
                    local goingRight = true

                    while _G.SnakeZigzagEnabled do
                        -- Alterne droite/gauche
                        _G._SnakeZigzagDir = goingRight and 1 or -1
                        goingRight = not goingRight

                        -- Attend le délai avant de changer
                        task.wait(_G.SnakeZigzagDelay or 0.6)
                    end

                    _G._SnakeZigzagDir = 0
                end)
            end
        })

        -- Bouton pour ramener toutes les coconuts vers le leader
        TrollExtra:CreateButton({
            Name = "Recall Snake",
            Callback = function()
                -- Trouve le leader coconut (celle qui est contrôlée)
                if not _G._OC_State or not _G._OC_State.active or not _G._OC_State.target then
                    return
                end

                local leaderCoconut = _G._OC_State.target
                local leaderPart = leaderCoconut:FindFirstChild("SoundPart")
                
                if not leaderPart or not leaderPart.Parent then
                    return
                end

                local Me = game:GetService("Players").LocalPlayer
                local RS2 = game:GetService("ReplicatedStorage")
                local SetNetworkOwner = RS2.GrabEvents.SetNetworkOwner

                -- Fonction pour trouver les coconuts (plot ou normal)
                function CheckForHome()
                    if not workspace.PlotItems.PlayersInPlots:FindFirstChild(Me.Name) then
                        return false
                    end

                    for _, v in pairs(workspace.Plots:GetChildren()) do
                        local sign = v:FindFirstChild("PlotSign")
                        local owners = sign and sign:FindFirstChild("ThisPlotsOwners")

                        if owners then
                            for _, b in pairs(owners:GetChildren()) do
                                if b.Value == Me.Name then
                                    local folder = workspace.PlotItems:FindFirstChild(v.Name)
                                    if folder then
                                        return true, folder
                                    end
                                end
                            end
                        end
                    end

                    return false
                end

                -- Cherche toutes les coconuts
                local allCoconuts = {}
                
                -- Dans SpawnedInToys
                local inv = workspace:FindFirstChild(Me.Name .. "SpawnedInToys")
                if inv then
                    for _, toy in ipairs(inv:GetChildren()) do
                        if toy.Name == "FoodCoconut" and toy ~= leaderCoconut then
                            table.insert(allCoconuts, toy)
                        end
                    end
                end

                -- TOUJOURS chercher dans ton plot (même si le leader est dehors)
                local isInPlot, plotFolder = CheckForHome()
                if plotFolder then
                    for _, toy in ipairs(plotFolder:GetChildren()) do
                        if toy.Name == "FoodCoconut" and toy ~= leaderCoconut then
                            -- Vérifie qu'on ne l'a pas déjà ajouté
                            local alreadyAdded = false
                            for _, existing in ipairs(allCoconuts) do
                                if existing == toy then
                                    alreadyAdded = true
                                    break
                                end
                            end
                            if not alreadyAdded then
                                table.insert(allCoconuts, toy)
                            end
                        end
                    end
                end
                
                -- Cherche aussi dans TOUS les plots pour trouver les coconuts du joueur
                local plotItems = workspace:FindFirstChild("PlotItems")
                if plotItems then
                    for _, plotFolder in ipairs(plotItems:GetChildren()) do
                        if plotFolder.Name ~= "PlayersInPlots" then
                            for _, toy in ipairs(plotFolder:GetChildren()) do
                                if toy.Name == "FoodCoconut" and toy ~= leaderCoconut then
                                    -- Vérifie si c'est notre coconut (a un PartOwner avec notre nom)
                                    local soundPart = toy:FindFirstChild("SoundPart")
                                    if soundPart then
                                        local partOwner = soundPart:FindFirstChild("PartOwner")
                                        if partOwner and partOwner.Value == Me.Name then
                                            -- Vérifie qu'on ne l'a pas déjà ajouté
                                            local alreadyAdded = false
                                            for _, existing in ipairs(allCoconuts) do
                                                if existing == toy then
                                                    alreadyAdded = true
                                                    break
                                                end
                                            end
                                            if not alreadyAdded then
                                                table.insert(allCoconuts, toy)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                -- TP toutes les coconuts vers le leader
                local targetCF = leaderPart.CFrame
                local count = 0
                
                for _, coconut in ipairs(allCoconuts) do
                    local part = coconut:FindFirstChild("SoundPart")
                    if part and part.Parent then
                        -- Claim la coconut
                        pcall(function()
                            SetNetworkOwner:FireServer(part, part.CFrame)
                        end)
                        
                        -- TP vers le leader avec un petit offset pour éviter overlap
                        local offset = CFrame.new(
                            math.random(-3, 3),
                            math.random(-2, 2),
                            math.random(-3, 3)
                        )
                        part.CFrame = targetCF * offset
                        part.Velocity = Vector3.zero
                        part.AssemblyLinearVelocity = Vector3.zero
                        
                        count = count + 1
                    end
                end

                _dbg("✅ Recalled " .. count .. " coconuts to leader!")
            end
        })


    end
end


