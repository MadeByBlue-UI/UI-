    -- =====================================================================
    -- FONCTION: Générer tous les points d'une forme
    -- =====================================================================
    function GenerateShapePoints(shapeName, size)
        local shape = ShapeDefinitions[shapeName]
        if not shape then return {} end
        
        local allPoints = {}
        
        for _, segment in ipairs(shape) do
            if segment.type == "line" then
                -- Ligne droite : interpolation linéaire
                local steps = 10
                for i = 0, steps do
                    local t = i / steps
                    local point = segment.from:Lerp(segment.to, t) * size
                    table.insert(allPoints, point)
                end
                
            elseif segment.type == "arc" then
                -- Arc : points sur un cercle
                local angleStep = (segment.endAngle - segment.startAngle) / segment.steps
                for i = 0, segment.steps do
                    local angle = math.rad(segment.startAngle + i * angleStep)
                    local x = segment.center.X + math.cos(angle) * segment.radius
                    local y = segment.center.Y + math.sin(angle) * segment.radius
                    local point = Vector3.new(x, y, segment.center.Z) * size
                    table.insert(allPoints, point)
                end
                
            elseif segment.type == "spiral" then
                -- Spirale : rayon croissant
                for i = 0, segment.steps do
                    local t = i / segment.steps
                    local angle = t * segment.turns * math.pi * 2
                    local radius = t * segment.maxRadius
                    local x = segment.center.X + math.cos(angle) * radius
                    local y = segment.center.Y + math.sin(angle) * radius
                    local point = Vector3.new(x, y, segment.center.Z) * size
                    table.insert(allPoints, point)
                end
            end
        end
        
        return allPoints
    end
    
    -- =====================================================================
    -- FONCTION: Créer trail visuel
    -- =====================================================================
    function CreateTrailPart(position, color)
        if not _G.ToyDrawingTrail then return end
        
        local part = Instance.new("Part")
        part.Size = Vector3.new(0.5, 0.5, 0.5)
        part.Position = position
        part.Anchored = true
        part.CanCollide = false
        part.Material = Enum.Material.Neon
        part.Color = color or Color3.fromRGB(255, 100, 255)
        part.Transparency = 0.3
        part.Parent = workspace
        
        -- Effet de disparition progressive
        task.spawn(function()
            for i = 1, 30 do
                if part.Parent then
                    part.Transparency = part.Transparency + 0.023
                    part.Size = part.Size - Vector3.new(0.016, 0.016, 0.016)
                end
                task.wait(0.1)
            end
            if part.Parent then
                part:Destroy()
            end
        end)
        
        table.insert(DrawingTrailParts, part)
    end
    
    -- =====================================================================
    -- FONCTION: Nettoyer le dessin
    -- =====================================================================
    function CleanupDrawing()
        for _, data in pairs(DrawingToys) do
            if data.bodyPos and data.bodyPos.Parent then
                data.bodyPos:Destroy()
            end
            if data.bodyGyro and data.bodyGyro.Parent then
                data.bodyGyro:Destroy()
            end
        end
        
        for _, part in ipairs(DrawingTrailParts) do
            if part.Parent then
                part:Destroy()
            end
        end
        
        for _, conn in ipairs(DrawingConnections) do
            if conn.Connected then
                conn:Disconnect()
            end
        end
        
        DrawingToys = {}
        DrawingConnections = {}
        DrawingTrailParts = {}
        DrawingProgress = 0
    end
    
    -- =====================================================================
    -- BOUCLE PRINCIPALE DE DESSIN
    -- =====================================================================
    function StartDrawingLoop()
        task.spawn(function()
            -- Génère les points de la forme
            local shapePoints = GenerateShapePoints(_G.ToyDrawingShape, _G.ToyDrawingSize)
            
            if #shapePoints == 0 then
                notify("Drawing Animator", "❌ Forme invalide", 2)
                return
            end
            
            while _G.ToyDrawingActive do
                local char = Player.Character
                local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                
                if rootPart then
                    -- Initialise les toys si pas encore fait
                    if next(DrawingToys) == nil then
                        local inventoryFolder = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
                        
                        if inventoryFolder then
                            for _, toy in ipairs(inventoryFolder:GetChildren()) do
                                if toy:IsA("Model") then
                                    local mainPart = toy:FindFirstChild("Main") or toy:FindFirstChild("SoundPart")
                                    if mainPart and mainPart:IsA("BasePart") then
                                        local bodyPos = Instance.new("BodyPosition")
                                        bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                        bodyPos.P = 20000
                                        bodyPos.D = 1000
                                        bodyPos.Parent = mainPart
                                        
                                        local bodyGyro = Instance.new("BodyGyro")
                                        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                                        bodyGyro.P = 20000
                                        bodyGyro.D = 1000
                                        bodyGyro.Parent = mainPart
                                        
                                        DrawingToys[mainPart] = {
                                            part = mainPart,
                                            bodyPos = bodyPos,
                                            bodyGyro = bodyGyro,
                                            index = #DrawingToys + 1
                                        }
                                    end
                                end
                            end
                            
                            notify("Drawing Animator", "✏️ " .. #DrawingToys .. " toys pour dessiner: " .. _G.ToyDrawingShape, 3)
                        end
                    end
                    
                    -- Avance dans le dessin
                    DrawingProgress = DrawingProgress + (_G.ToyDrawingSpeed * 0.5)
                    
                    -- Reset si on a fini et loop activé
                    if DrawingProgress >= #shapePoints then
                        if _G.ToyDrawingLoop then
                            DrawingProgress = 0
                            -- Nettoie les trails
                            for _, part in ipairs(DrawingTrailParts) do
                                if part.Parent then
                                    part:Destroy()
                                end
                            end
                            DrawingTrailParts = {}
                        else
                            DrawingProgress = #shapePoints - 1
                        end
                    end
                    
                    -- Positionne chaque toy sur un point du dessin
                    local toyCount = 0
                    for _ in pairs(DrawingToys) do toyCount = toyCount + 1 end
                    
                    local toyIndex = 0
                    for toy, data in pairs(DrawingToys) do
                        -- Calcule la position de ce toy sur le tracé
                        local pointIndex = math.floor(DrawingProgress - toyIndex * (toyCount / 5))
                        
                        if pointIndex < 1 then
                            pointIndex = #shapePoints + pointIndex
                        end
                        if pointIndex > #shapePoints then
                            pointIndex = pointIndex - #shapePoints
                        end
                        
                        pointIndex = math.clamp(pointIndex, 1, #shapePoints)
                        
                        local point = shapePoints[pointIndex]
                        local worldPos = rootPart.CFrame:PointToWorldSpace(point + Vector3.new(0, 10, 0))
                        
                        data.bodyPos.Position = worldPos
                        data.bodyGyro.CFrame = CFrame.new(worldPos)
                        
                        -- Créer trail au point actuel
                        if toyIndex == 0 and math.random() < 0.3 then
                            CreateTrailPart(worldPos, Color3.fromHSV(DrawingProgress / #shapePoints, 1, 1))
                        end
                        
                        -- Grab ownership
                        pcall(function()
                            RS.GrabEvents.SetNetworkOwner:FireServer(toy, toy.CFrame)
                        end)
                        
                        toyIndex = toyIndex + 1
                    end
                end
                
                task.wait(0.016)  -- ~60 FPS
            end
            
            CleanupDrawing()
        end)
    end
    
