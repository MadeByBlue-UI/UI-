-- HEADLESS + KORBLOX  (Fun)
-- =========================================================================
do
    local FunCosmetics = Tabs.Fun:CreateBlock({ Name = "Fake Cosmetics", Side = "Right" })

    local HEADLESS_MESH = "134082579"
    local HEADLESS_TEX  = "134082627"
    local KORBLOX_MESH  = "101851696"
    local KORBLOX_TEX   = "101851254"

    local cosmeticEnabled  = false
    local cosmeticChoice   = "Both"   -- "Headless" / "Korblox" / "Both"
    local cosmeticRespawn  = false
    local savedHeadData    = nil

    -- ---- Headless ----
    function snapshotHead()
        local char = Player.Character
        local head = char and char:FindFirstChild("Head")
        if not head then return end
        savedHeadData = { Transparency = head.Transparency, BrickColor = head.BrickColor, Material = head.Material, Meshes = {}, Decals = {} }
        for _, obj in ipairs(head:GetChildren()) do
            if obj:IsA("SpecialMesh") then
                table.insert(savedHeadData.Meshes, { MeshType=obj.MeshType, MeshId=obj.MeshId, TextureId=obj.TextureId, Scale=obj.Scale, Offset=obj.Offset, VertexColor=obj.VertexColor, Name=obj.Name })
            elseif obj:IsA("Decal") then
                table.insert(savedHeadData.Decals, { Texture=obj.Texture, Face=obj.Face, Transparency=obj.Transparency, Name=obj.Name })
            end
        end
    end

    function wearHeadless()
        local char = Player.Character
        local head = char and char:FindFirstChild("Head")
        if not head then return end
        snapshotHead()
        for _, obj in ipairs(head:GetChildren()) do
            if obj:IsA("Decal") or obj:IsA("SpecialMesh") then obj:Destroy() end
        end
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType  = Enum.MeshType.FileMesh
        mesh.MeshId    = "rbxassetid://" .. HEADLESS_MESH
        mesh.TextureId = "rbxassetid://" .. HEADLESS_TEX
        mesh.Scale     = Vector3.new(1.25, 1.25, 1.25)
        mesh.Name      = "HeadlessMesh"
        mesh.Parent    = head
        head.Transparency = 0.1
        head.BrickColor   = BrickColor.new("Really black")
        head.Material     = Enum.Material.Plastic
    end

    -- ---- Korblox ----
    function wearKorblox()
        local char = Player.Character
        if not char then return end
        local rleg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
        if not rleg then return end
        local old = char:FindFirstChild("PhantomKorbloxLeg")
        if old then old:Destroy() end
        local fakeLeg = Instance.new("Part")
        fakeLeg.Name       = "PhantomKorbloxLeg"
        fakeLeg.Size       = rleg.Size
        fakeLeg.CFrame     = rleg.CFrame
        fakeLeg.Anchored   = false
        fakeLeg.CanCollide = false
        fakeLeg.Transparency = 0
        fakeLeg.BrickColor = BrickColor.new("Really black")
        fakeLeg.Material   = Enum.Material.Plastic
        fakeLeg.Parent     = char
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType  = Enum.MeshType.FileMesh
        mesh.MeshId    = "rbxassetid://" .. KORBLOX_MESH
        mesh.TextureId = "rbxassetid://" .. KORBLOX_TEX
        mesh.Scale     = Vector3.new(1, 1, 1)
        mesh.Parent    = fakeLeg
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rleg; weld.Part1 = fakeLeg; weld.Parent = rleg
        rleg.Transparency = 1
    end

    -- ---- Apply / Strip ----
    function applyCosmetics()
        if cosmeticChoice == "Headless" then
            wearHeadless()
        elseif cosmeticChoice == "Korblox" then
            wearKorblox()
        else
            wearHeadless(); wearKorblox()
        end
        Library:Notify({ Title = "Cosmetics", Content = cosmeticChoice .. " appliqu ", Duration = 3 })
    end

    function stripCosmetics()
        local char = Player.Character
        if not char then return end
        -- Retire headless
        local head = char:FindFirstChild("Head")
        if head then
            local m = head:FindFirstChild("HeadlessMesh")
            if m then m:Destroy() end
            if savedHeadData then
                head.Transparency = savedHeadData.Transparency
                head.BrickColor   = savedHeadData.BrickColor
                head.Material     = savedHeadData.Material
                for _, d in ipairs(savedHeadData.Meshes) do
                    local mesh = Instance.new("SpecialMesh")
                    mesh.MeshType = d.MeshType; mesh.MeshId = d.MeshId; mesh.TextureId = d.TextureId
                    mesh.Scale = d.Scale; mesh.Offset = d.Offset; mesh.VertexColor = d.VertexColor
                    mesh.Name = d.Name; mesh.Parent = head
                end
                for _, d in ipairs(savedHeadData.Decals) do
                    local decal = Instance.new("Decal")
                    decal.Texture = d.Texture; decal.Face = d.Face
                    decal.Transparency = d.Transparency; decal.Name = d.Name; decal.Parent = head
                end
                savedHeadData = nil
            else
                head.Transparency = 0
            end
        end
        -- Retire korblox
        local rleg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
        if rleg then
            rleg.Transparency = 0
            local w = rleg:FindFirstChildOfClass("WeldConstraint")
            if w then w:Destroy() end
        end
        local fake = char:FindFirstChild("PhantomKorbloxLeg")
        if fake then fake:Destroy() end
    end

    -- Respawn hook
    _TrackConn(Player.CharacterAdded:Connect(function()
        task.wait(1)
        savedHeadData = nil
        if cosmeticEnabled and cosmeticRespawn then
            task.wait(0.5)
            applyCosmetics()
        end
    end))

    -- Boucle de maintien FORCEE : reapplique en permanence a chaque frame
    local _maintainConn = nil
    function startMaintain()
        if _maintainConn then return end
        _maintainConn = game:GetService("RunService").Heartbeat:Connect(function()
            if not cosmeticEnabled then return end
            local char = Player.Character
            if not char then return end

            -- Force Korblox
            if cosmeticChoice == "Korblox" or cosmeticChoice == "Both" then
                local rleg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightLowerLeg")
                local fake = char:FindFirstChild("PhantomKorbloxLeg")
                -- Force transparence de la vraie jambe
                if rleg and rleg.Transparency ~= 1 then
                    rleg.Transparency = 1
                end
                -- Si le fake a disparu ou le weld cass? -> recr?e
                if not fake or not fake.Parent then
                    wearKorblox()
                elseif rleg and not rleg:FindFirstChildOfClass("WeldConstraint") then
                    fake:Destroy()
                    wearKorblox()
                else
                    -- Force la transparence du fake ? 0
                    if fake.Transparency ~= 0 then
                        fake.Transparency = 0
                    end
                end
            end

            -- Force Headless
            if cosmeticChoice == "Headless" or cosmeticChoice == "Both" then
                local head = char:FindFirstChild("Head")
                if head then
                    -- Si le mesh a disparu -> recr?e
                    if not head:FindFirstChild("HeadlessMesh") then
                        wearHeadless()
                    else
                        -- Force la transparence et couleur
                        if head.Transparency < 0.09 or head.Transparency > 0.11 then
                            head.Transparency = 0.1
                        end
                        if head.BrickColor ~= BrickColor.new("Really black") then
                            head.BrickColor = BrickColor.new("Really black")
                        end
                    end
                end
            end
        end)
    end

    function stopMaintain()
        if _maintainConn then _maintainConn:Disconnect(); _maintainConn = nil end
    end

    -- UI
    FunCosmetics:CreateToggle({
        Name    = "Enable Cosmetics",
        Flag    = "CosmeticMaster",
        Default = false,
        Callback = function(v)
            cosmeticEnabled = v
            if v then applyCosmetics(); startMaintain()
            else stripCosmetics(); stopMaintain() end
        end
    })

    FunCosmetics:CreateDropdown({
        Name     = "Style",
        Flag     = "CosmeticType",
        Items    = { "Headless", "Korblox", "Both" },
        Default  = "Both",
        Callback = function(v)
            cosmeticChoice = v
            if cosmeticEnabled then stripCosmetics(); applyCosmetics() end
        end
    })

    FunCosmetics:CreateToggle({
        Name    = "Re-apply on Respawn",
        Flag    = "CosmeticRespawn",
        Default = false,
        Callback = function(v)
            cosmeticRespawn = v
        end
    })
end


