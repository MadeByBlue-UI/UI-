-- LINE LAG FIX
-- =========================================================================

do
    local _restoreBackups = {}
    
    -- Créer des backups permanents des remotes au lancement
    task.spawn(function()
        task.wait(0.5)
        local _grabFolder = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
        if _grabFolder then
            local extend = _grabFolder:FindFirstChild("ExtendGrabLine")
            local create = _grabFolder:FindFirstChild("CreateGrabLine")
            if extend then _restoreBackups.ExtendGrabLine = extend:Clone() end
            if create then _restoreBackups.CreateGrabLine = create:Clone() end
        end
    end)
    
    function restoreGrabLines()
        local _grabFolder = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
        if not _grabFolder then return end
        
        -- Restaure ExtendGrabLine si elle manque
        if not _grabFolder:FindFirstChild("ExtendGrabLine") then
            if _restoreBackups.ExtendGrabLine then
                pcall(function() _restoreBackups.ExtendGrabLine:Clone().Parent = _grabFolder end)
            end
        end
        
        -- Restaure CreateGrabLine si elle manque
        if not _grabFolder:FindFirstChild("CreateGrabLine") then
            if _restoreBackups.CreateGrabLine then
                pcall(function() _restoreBackups.CreateGrabLine:Clone().Parent = _grabFolder end)
            end
        end
    end
    
    -- Fonction globale pour restaurer manuellement
    _G.RestoreGrabLines = restoreGrabLines
    
    -- Restaure quand le joueur quitte
    _TrackConn(game.Players.LocalPlayer.AncestryChanged:Connect(function()
        pcall(restoreGrabLines)
    end))
end
