        local lastMsg, lastT = nil, 0
        local function onChat(msg)
            if not kwOn or type(msg) ~= "string" then return end
            local now = os.clock()
            if msg == lastMsg and now - lastT < 0.6 then return end   -- les 2 systèmes de chat peuvent déclencher le même message
            lastMsg, lastT = msg, now
            local hay = " " .. kwNorm(msg) .. " "
            for _, r in ipairs(kwRules) do
                if r.word ~= "" and hay:find(" " .. r.word .. " ", 1, true) then
                    runRule(r.act)
                    return
                end
            end
        end

