    local lastFPSUpdate = os.clock()
    
    -- Calcul FPS
    _TrackConn(RunService.Heartbeat:Connect(function()
        frameCount = frameCount + 1
        local now = os.clock()
        if now - lastFPSUpdate >= 1 then
            currentFPS = frameCount
            frameCount = 0
            lastFPSUpdate = now
        end
