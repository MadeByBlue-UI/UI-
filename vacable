        if not target or not target.Character then notify("UFO", "Cible "..slotIdx.." introuvable.", 3); return end
        local ufo = getUFO()
        if not ufo then notify("UFO", "Aucun UFO dans l'inventaire.", 3); return end
        local ufoRoot = ufo:FindFirstChildWhichIsA("BasePart") or ufo:FindFirstChild("Hitbox")
        if not ufoRoot then notify("UFO", "Part UFO introuvable.", 3); return end

        local hum = target.Character:FindFirstChildOfClass("Humanoid")
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then return end

        if ufoConns[slotIdx] then ufoConns[slotIdx]:Disconnect() end

        local _SNO4 = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
            and game:GetService("ReplicatedStorage").GrabEvents:FindFirstChild("SetNetworkOwner")

        local offset = UFO_OFFSETS[slotIdx]

        -- SNO sur le HRP avant tout
        if _SNO4 then
            for _ = 1, 3 do
                pcall(function() _SNO4:FireServer(hrp, hrp.CFrame) end)
                task.wait(0.05)
            end
        end
        task.wait(0.1)

        local bp = hrp:FindFirstChild("UFOBP_"..slotIdx) or Instance.new("BodyPosition")
        bp.Name = "UFOBP_"..slotIdx
        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bp.P = 50000; bp.D = 1000
        bp.Position = (ufoRoot.CFrame * CFrame.new(offset.X, offset.Y, offset.Z)).Position
        bp.Parent = hrp

        local bg = hrp:FindFirstChild("UFOBG_"..slotIdx) or Instance.new("BodyGyro")
        bg.Name = "UFOBG_"..slotIdx
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 10000; bg.D = 500
        bg.CFrame = CFrame.new(hrp.Position)
        bg.Parent = hrp

        notify("UFO", target.Name .. " colle sur l'UFO ! (slot "..slotIdx..")", 3)

        local _ufoSnoTimer = 0
        local _ufoFpsTimer = 0
        local _CGL_UFO = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
            and game:GetService("ReplicatedStorage").GrabEvents:FindFirstChild("CreateGrabLine")
        ufoConns[slotIdx] = game:GetService("RunService").Heartbeat:Connect(function(dt)
            _ufoFpsTimer = _ufoFpsTimer + dt
            if _ufoFpsTimer < 0.1 then return end
            _ufoFpsTimer = 0
            if not ufoRoot.Parent then
                ufoConns[slotIdx]:Disconnect(); ufoConns[slotIdx] = nil
                if bp.Parent then bp:Destroy() end
                if bg.Parent then bg:Destroy() end
                return
            end
            bp.Position = (ufoRoot.CFrame * CFrame.new(offset.X, offset.Y, offset.Z)).Position
            local camFlat = workspace.CurrentCamera.CFrame.LookVector
            local camY = math.atan2(camFlat.X, camFlat.Z) + math.rad(180)
            bg.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, camY, 0)
            -- Juste SNO toutes les 10s
            _ufoSnoTimer = _ufoSnoTimer + 0.1
            if _SNO4 and _ufoSnoTimer >= 10 then
                pcall(function()
                    _SNO4:FireServer(hrp, hrp.CFrame)
                end)
                _ufoSnoTimer = 0
            end
            if _SNO4 and _ufoSnoTimer >= 10 then
                pcall(function() _SNO4:FireServer(hrp, hrp.CFrame) end)
                _ufoSnoTimer = 0
            end
        end)
    end

