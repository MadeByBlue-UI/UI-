-- =========================================================================
-- OWNERSHIP KICK  (version XOCU)
-- =========================================================================
do
    local _okActive = false
    local _okTask   = nil
    local _okHeight = 15
    local _okRagd   = 2

    function OwnershipKickFunction(target)
        local GE = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
        if not GE then return end
        local _CE = game:GetService("ReplicatedStorage"):FindFirstChild("CharacterEvents")
        local _RagdollRE = _CE and _CE:FindFirstChild("RagdollRemote")
        
        local myChar = game:GetService("Players").LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        local savedPos = myRoot.CFrame  -- Ta position d'origine
        local ownershipGrabbed = false
        local _bp = nil
        local _bg = nil

        function cleanBodies()
            pcall(function()
                if _bp then _bp:Destroy(); _bp = nil end
                if _bg then _bg:Destroy(); _bg = nil end
            end)
        end

        -- Phase 0 : TP sous la cible pour grab ownership
        local cur = game:GetService("Players"):FindFirstChild(target.Name)
        if not cur or not cur.Character then return end
        
        local tChar = cur.Character
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then return end
        
        Library:Notify({ Title = "Ownership Kick", Content = "Grab ownership...", Duration = 2 })
        
        local tpStart = tick()
        while _okActive and tick() - tpStart < 1.0 do
            myChar = game:GetService("Players").LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then break end
            
            -- TP 2 studs sous la cible
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, -2, 0)
            
            pcall(function()
                GE.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                GE.DestroyGrabLine:FireServer(tRoot)
            end)
            
            -- Check si ownership obtenu
            local po = tRoot:FindFirstChild("PartOwner")
            if po and po.Value == game:GetService("Players").LocalPlayer.Name then
                ownershipGrabbed = true
                break
            end
            
            task.wait(0.05)
        end
        
        -- Retour à ta position
        if myRoot and myRoot.Parent then
            myRoot.CFrame = savedPos
        end
        
        if not ownershipGrabbed then
            Library:Notify({ Title = "Ownership Kick", Content = "Échec ownership", Duration = 2 })
            cleanBodies()
            return
        end
        
        -- Phase 1 : Ramène la cible au-dessus de toi
        Library:Notify({ Title = "Ownership Kick", Content = "Lock au-dessus...", Duration = 2 })
        
        local lockPos = savedPos.Position + Vector3.new(0, _okHeight, 0)
        
        -- Crée les movers
        _bp = Instance.new("BodyPosition")
        _bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        _bp.P = 100000
        _bp.D = 5000
        _bp.Position = lockPos
        _bp.Parent = tRoot
        
        _bg = Instance.new("BodyGyro")
        _bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        _bg.P = 100000
        _bg.D = 5000
        _bg.CFrame = CFrame.new(lockPos)
        _bg.Parent = tRoot
        
        -- Phase 2 : Loop de maintien + ragdoll
        while _okActive do
            cur = game:GetService("Players"):FindFirstChild(target.Name)
            if not cur or not cur.Character then break end
            
            tChar = cur.Character
            tRoot = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChild("Humanoid")
            
            if not tRoot or not tHum or tHum.Health <= 0 then break end
            
            myChar = game:GetService("Players").LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then break end
            
            -- Mise à jour position (au-dessus de ta position actuelle)
            lockPos = myRoot.Position + Vector3.new(0, _okHeight, 0)
            
            if _bp and _bp.Parent then
                _bp.Position = lockPos
            end
            if _bg and _bg.Parent then
                _bg.CFrame = CFrame.new(lockPos)
            end
            
            -- Annule velocity + ragdoll + ownership
            pcall(function()
                tRoot.AssemblyLinearVelocity = Vector3.zero
                tHum.PlatformStand = true
                GE.SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
                GE.DestroyGrabLine:FireServer(tRoot)
                if _RagdollRE then
                    _RagdollRE:FireServer(tChar, true)
                end
            end)
            
            task.wait(0.05)
        end
        
        cleanBodies()
    end

    TargetGroup:CreateToggle({
        Name    = "Ownership Kick (XOCU)",
        Flag    = "OwnershipKickXOCU",
        Default = false,
        Callback = function(v)
            _okActive = v
            if not v then
                if _okTask then task.cancel(_okTask); _okTask = nil end
                return
            end
            if not selectedKickPlayer then
                Library:Notify({ Title = "Ownership Kick", Content = "Selectionne une cible!", Duration = 3 })
                _okActive = false; return
            end
            _okTask = task.spawn(function() OwnershipKickFunction(selectedKickPlayer) end)
        end,
    })
    TargetGroup:CreateSlider({ Name = "Hauteur", Flag = "OKHeight", Min = 5, Max = 200, Default = 15,
        Callback = function(v) _okHeight = v end })
    TargetGroup:CreateSlider({ Name = "Ragdoll", Flag = "OKRagdoll", Min = 0, Max = 10, Default = 2,
        Callback = function(v) _okRagd = v end })
end

