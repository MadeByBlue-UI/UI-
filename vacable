        trail.MinLength = 0
        trail.Transparency = NumberSequence.new(0, 1)
        trail.WidthScale = NumberSequence.new(1, 0)
        
        return trail
    end
    
    -- =====================================================================
    -- FONCTION: Calculer position selon le mode
    -- =====================================================================
    function CalculateAuraPosition(index, total, theta, rootPos, rootCF)
        local angle = (index / total) * math.pi * 2 + theta
        local radius = _G.ToyAuraRadius
        local height = _G.ToyAuraHeight
        local pos
        
        if _G.ToyAuraMode == "Orbit" then
            -- Orbite circulaire horizontale
            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius
            pos = rootPos + Vector3.new(x, height, z)
            
        elseif _G.ToyAuraMode == "Shield" then
            -- Cercle vertical qui tourne
            local x = math.cos(angle) * radius
            local y = math.sin(angle) * radius
            pos = rootPos + Vector3.new(x, y, 0)
            
        elseif _G.ToyAuraMode == "Spiral" then
            -- Spirale ascendante
            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius
            local y = (index / total) * 10 - 5
            pos = rootPos + Vector3.new(x, y, z)
            
        elseif _G.ToyAuraMode == "Dome" then
            -- Dôme sphérique
            local phi = math.acos(1 - 2 * index / total)  -- Angle vertical
            local x = math.cos(angle) * math.sin(phi) * radius
            local y = math.cos(phi) * radius
            local z = math.sin(angle) * math.sin(phi) * radius
            pos = rootPos + Vector3.new(x, y + height, z)
            
        elseif _G.ToyAuraMode == "Wall" then
            -- Mur devant le joueur
            local forward = rootCF.LookVector
            local right = rootCF.RightVector
            local x = (index - total/2) * 3
            local y = math.sin(theta + index) * 2
            pos = rootPos + forward * radius + right * x + Vector3.new(0, y + height, 0)
            
        elseif _G.ToyAuraMode == "Helix" then
            -- Double hélice
            local x = math.cos(angle + index * 0.5) * radius
            local z = math.sin(angle + index * 0.5) * radius
            local y = math.sin(theta * 2 + index) * 3
            pos = rootPos + Vector3.new(x, y + height, z)
            
        elseif _G.ToyAuraMode == "Attack" then
            -- Mode attaque: lance vers l'avant
            local forward = rootCF.LookVector
            local x = math.cos(angle) * (radius * 0.5)
            local z = math.sin(angle) * (radius * 0.5)
            pos = rootPos + forward * (radius + math.sin(theta * 3) * 5) + Vector3.new(x, height, z)
            
        elseif _G.ToyAuraMode == "Follow" then
            -- Formation en V derrière
            local back = -rootCF.LookVector
            local right = rootCF.RightVector
            local side = (index % 2 == 0) and 1 or -1
            local offset = math.floor(index / 2) * 3
            pos = rootPos + back * offset + right * side * 3 + Vector3.new(0, height, 0)
            
        else
            -- Défaut: orbite simple
            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius
            pos = rootPos + Vector3.new(x, height, z)
        end
        
        return pos
    end
    
    -- =====================================================================
    -- FONCTION: Boucle principale d'aura
    -- =====================================================================
    function StartToyAuraMasterLoop()
        local theta = 0
        
        task.spawn(function()
            while _G.ToyAuraMasterActive do
                local char = Player.Character
                local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                
                if rootPart then
                    -- Récupère les toys si pas encore fait
                    if next(ToyAuraObjects) == nil then
                        local toys = GetToysForAura()
                        for i, toy in ipairs(toys) do
                            -- Crée BodyPosition et BodyGyro
                            local bodyPos = Instance.new("BodyPosition")
                            bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bodyPos.P = 10000
                            bodyPos.D = 500
                            bodyPos.Parent = toy
                            
                            local bodyGyro = Instance.new("BodyGyro")
                            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                            bodyGyro.P = 10000
                            bodyGyro.D = 500
                            bodyGyro.Parent = toy
                            
                            local trail = CreateTrailForToy(toy)
                            
                            ToyAuraObjects[toy] = {
                                bodyPos = bodyPos,
                                bodyGyro = bodyGyro,
                                trail = trail,
                                index = i
                            }
                        end
                        
                        notify("Toy Aura Master", "✅ " .. #toys .. " toys activés en mode " .. _G.ToyAuraMode, 3)
                    end
                    
                    -- Update positions
                    theta = theta + (_G.ToyAuraSpeed * 0.016)  -- ~60 FPS
                    
                    local total = 0
                    for _ in pairs(ToyAuraObjects) do total = total + 1 end
                    
                    for toy, data in pairs(ToyAuraObjects) do
                        if toy and toy.Parent and data.bodyPos.Parent then
                            -- Calcule nouvelle position
                            local targetPos = CalculateAuraPosition(
                                data.index, 
                                total, 
                                theta, 
                                rootPart.Position, 
                                rootPart.CFrame
                            )
                            
                            -- Applique
                            data.bodyPos.Position = targetPos
                            
                            -- Rotation vers le centre (optionnel)
                            if _G.ToyAuraMode == "Orbit" or _G.ToyAuraMode == "Shield" then
                                data.bodyGyro.CFrame = CFrame.lookAt(targetPos, rootPart.Position)
                            end
                            
                            -- Grab ownership pour stabilité
                            pcall(function()
                                RS.GrabEvents.SetNetworkOwner:FireServer(toy, toy.CFrame)
                            end)
                        end
                    end
                    
                    -- Mode Auto-Target: détecte les joueurs proches
                    if _G.ToyAuraAutoTarget then
                        for _, plr in ipairs(game.Players:GetPlayers()) do
                            if plr ~= Player and plr.Character then
                                local plrRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                                if plrRoot then
                                    local dist = (plrRoot.Position - rootPart.Position).Magnitude
                                    if dist < _G.ToyAuraRadius * 2 then
                                        -- Lance un toy vers le joueur
                                        for toy, data in pairs(ToyAuraObjects) do
                                            if data.bodyPos.Parent then
                                                data.bodyPos.Position = plrRoot.Position
                                                break  -- Un seul toy à la fois
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                
                task.wait(0.016)  -- ~60 FPS
            end
            
            -- Cleanup à la fin
            CleanupToyAura()
        end)
    end
    
